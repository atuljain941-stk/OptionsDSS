// ── helpers ────────────────────────────────────────────────────
async function api(url, opts={}) {
  const fetchOpts = Object.assign({}, opts || {});
  const method = String(fetchOpts.method || 'GET').toUpperCase();
  if (method === 'GET' && fetchOpts.cache === undefined) fetchOpts.cache = 'no-store';
  const r = await fetch(url, fetchOpts);
  if (!r.ok) {
    let errBody = '';
    try {
      const j = await r.clone().json();
      errBody = (j.error || j.message || j.detail || '');
    } catch {
      try { errBody = (await r.clone().text()).slice(0, 300); } catch {}
    }
    if (r.status===500 && errBody) addNotif('error', 'Server error (500)', errBody.slice(0,300), url.split('?')[0].split('/').slice(-2).join('/'));
    throw new Error(`${r.status} ${r.statusText}${errBody ? ': ' + errBody : ''}`);
  }
  return r.json();
}
function fmt(v, dec=0) {
  if (v===null||v===undefined) return '—';
  if (typeof v==='boolean') return v?'✔':'';
  if (typeof v==='number') return dec===0?Math.round(v).toLocaleString():v.toFixed(dec);
  return String(v);
}
function fmtMoney2(v) {
  const n = Number.parseFloat(v);
  if (!Number.isFinite(n)) return '—';
  return n.toFixed(2);
}
function fmt2(v) {
  const n = Number(v);
  return Number.isFinite(n) ? n.toFixed(2) : '—';
}

function _edgeScoreBits(r) {
  const fin = r.final_score ?? r.score ?? '—';
  const nat = r.native_score ?? '—';
  const comp = r.composite_score ?? r.edge_score ?? '—';
  const rs = r.rs_score ?? '—';
  const vol = r.vol_score ?? '—';
  const sec = r.sector_score ?? '—';
  const inst = r.institutional_score ?? '—';
  const em = r.expected_move_score ?? '—';
  const age = r.trend_age ?? r.days_ago ?? '—';
  const earn = r.earn_days != null ? ` · Earn <b>${r.earn_days}d</b>` : '';
  return `<div style="display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center">
    <span>Final <b style="color:#22c55e">${fin}</b></span>
    <span>Native <b>${nat}</b></span>
    <span>Comp <b>${comp}</b></span>
    <span>RS <b>${rs}</b></span>
    <span>Vol <b>${vol}</b></span>
    <span>Sector <b>${sec}</b></span>
    <span>Inst <b>${inst}</b></span>
    <span>EM <b>${em}</b></span>
    <span>Age <b>${age}</b>${earn}</span>
  </div>`;
}
function _edgeScoreCell(r) {
  return `<div style="font-size:12px;color:var(--muted);line-height:1.45;white-space:normal">${_edgeScoreBits(r)}</div>`;
}
function _edgeScoreBlock(r) {
  return `<div style="margin-top:4px;font-size:12px;color:var(--muted);line-height:1.45;white-space:normal">${_edgeScoreBits(r)}</div>`;
}
function clr(v) { return (!v&&v!==0)?'':v>0?'c-green':v<0?'c-red':''; }
function uc(el) {
  el?.addEventListener('input',e=>{
    const i=e.target.selectionStart;
    e.target.value=e.target.value.toUpperCase();
    e.target.setSelectionRange(i,i);
  });
}

// ── Scanner result pane visibility ───────────────────────────────────────
function _toggleScannerResultPanes(showRegular) {
  ['scanner-results','rmt-results','mr-results','sr-results','inst-results','regime-table'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = showRegular ? '' : 'none';
  });
}


function _setActiveTab(tab) {
  document.querySelectorAll('[data-tab]').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll(`[data-tab="${tab}"]`).forEach(b => b.classList.add('active'));
  document.getElementById('tab-' + tab)?.classList.add('active');
}

// ── Tab router ─────────────────────────────────────────────────


// Smart compact navigation with editable local favorites.
const _SMART_NAV_KEY = 'oiapp.smartNav.favorites.v1';
const _SMART_NAV_DEFAULT_FAVORITES = [
  'dashboard', 'aggregate', 'intraday', 'gexplan', 'scanner-builder',
  'trade-scanner', 'uae-trade-scanner', 'ai-hub', 'agentic-ai-scanner', 'backtest', 'alerts', 'scheduler'
];
let _smartNavLabels = {};
let _smartNavReady = false;
let _smartNavDraggedTab = null;

function _smartNavText(s) {
  return String(s || '').replace(/\s+/g, ' ').trim();
}

function _smartNavCurrentTab() {
  const sec = document.querySelector('.section.active[id^="tab-"]');
  if (sec && sec.id) return sec.id.replace(/^tab-/, '');
  const btn = document.querySelector('#tab-bar .nav-item.active[data-tab], #nav-favorites .nav-pill.active[data-tab]');
  return btn ? btn.dataset.tab : 'dashboard';
}

function _smartNavCloseAllGroups() {
  document.querySelectorAll('#tab-bar .nav-group[open]').forEach(g => { g.open = false; });
}

function _smartNavBuildLabels() {
  const labels = {};
  document.querySelectorAll('#nav-favorites .nav-pill[data-tab]').forEach(btn => {
    const tab = btn.dataset.tab;
    const txt = _smartNavText(btn.dataset.navLabel || btn.textContent);
    if (tab && txt && !labels[tab]) labels[tab] = txt;
  });
  document.querySelectorAll('#tab-bar .nav-item[data-tab]').forEach(btn => {
    const tab = btn.dataset.tab;
    const txt = _smartNavText(btn.dataset.navLabel || btn.textContent);
    if (tab && txt) labels[tab] = txt;
  });
  _smartNavLabels = labels;
  return labels;
}

function _smartNavCleanList(list) {
  const labels = _smartNavLabels || {};
  const out = [];
  (Array.isArray(list) ? list : []).forEach(tab => {
    tab = String(tab || '').trim();
    if (tab && labels[tab] && !out.includes(tab)) out.push(tab);
  });
  return out;
}

function _smartNavReadFavorites() {
  try {
    const raw = localStorage.getItem(_SMART_NAV_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      const cleaned = _smartNavCleanList(parsed);
      if (cleaned.length) return cleaned;
    }
  } catch {}
  return _smartNavCleanList(_SMART_NAV_DEFAULT_FAVORITES);
}

function _smartNavWriteFavorites(favs) {
  try { localStorage.setItem(_SMART_NAV_KEY, JSON.stringify(_smartNavCleanList(favs))); } catch {}
}

function _smartNavPrimaryButton(tab) {
  return Array.from(document.querySelectorAll('#tab-bar .nav-item[data-tab]')).find(b => b.dataset.tab === tab)
      || Array.from(document.querySelectorAll('[data-tab]')).find(b => b.dataset.tab === tab && !b.closest('#nav-favorites'));
}

function _smartNavOpenTab(tab) {
  _smartNavCloseAllGroups();
  const target = _smartNavPrimaryButton(tab);
  if (target) target.click();
  else _setActiveTab(tab);
  _smartNavRenderFavorites();
}

function _smartNavRefreshStars() {
  const favs = _smartNavReadFavorites();
  document.querySelectorAll('#tab-bar .nav-item[data-tab]').forEach(btn => {
    const star = btn.querySelector('.nav-star');
    if (!star) return;
    const isFav = favs.includes(btn.dataset.tab);
    star.textContent = isFav ? '\u2605' : '\u2606';
    star.classList.toggle('is-favorite', isFav);
    star.title = isFav ? 'Remove from favorites' : 'Add to favorites';
    star.setAttribute('aria-label', star.title);
  });
}

function _smartNavToggleFavorite(tab) {
  const favs = _smartNavReadFavorites();
  const idx = favs.indexOf(tab);
  if (idx >= 0) favs.splice(idx, 1);
  else favs.push(tab);
  _smartNavWriteFavorites(favs);
  _smartNavRenderFavorites();
  _smartNavInitFavoriteReorder();
  _smartNavRefreshStars();
}

function _smartNavFavoriteAfterElement(container, x) {
  const pills = Array.from(container.querySelectorAll('.nav-pill[data-tab]:not(.is-dragging)'));
  return pills.reduce((closest, pill) => {
    const box = pill.getBoundingClientRect();
    const offset = x - box.left - box.width / 2;
    if (offset < 0 && offset > closest.offset) return { offset, element: pill };
    return closest;
  }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
}

function _smartNavSaveFavoriteOrderFromDom() {
  const wrap = document.getElementById('nav-favorites');
  if (!wrap) return;
  const ordered = Array.from(wrap.querySelectorAll('.nav-pill[data-tab]')).map(btn => btn.dataset.tab);
  if (ordered.length) _smartNavWriteFavorites(ordered);
}

function _smartNavInitFavoriteReorder() {
  const wrap = document.getElementById('nav-favorites');
  if (!wrap || wrap.dataset.reorderReady === '1') return;
  wrap.dataset.reorderReady = '1';
  wrap.addEventListener('dragover', ev => {
    const dragging = wrap.querySelector('.nav-pill.is-dragging');
    if (!dragging) return;
    ev.preventDefault();
    const after = _smartNavFavoriteAfterElement(wrap, ev.clientX);
    if (after == null) wrap.appendChild(dragging);
    else wrap.insertBefore(dragging, after);
  });
  wrap.addEventListener('drop', ev => {
    if (!_smartNavDraggedTab) return;
    ev.preventDefault();
    _smartNavSaveFavoriteOrderFromDom();
    _smartNavRenderFavorites();
    _smartNavRefreshStars();
  });
}

function _smartNavRenderFavorites() {
  const wrap = document.getElementById('nav-favorites');
  if (!wrap) return;
  const activeTab = _smartNavCurrentTab();
  const favs = _smartNavReadFavorites();
  wrap.innerHTML = '';
  const label = document.createElement('span');
  label.className = 'nav-label';
  label.textContent = '\u2605 Favorites';
  wrap.appendChild(label);
  if (!favs.length) {
    const empty = document.createElement('span');
    empty.className = 'nav-empty';
    empty.textContent = 'Click a star on any menu item to add it here';
    wrap.appendChild(empty);
    return;
  }
  favs.forEach(tab => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'nav-pill' + (tab === activeTab ? ' active' : '');
    btn.dataset.tab = tab;
    btn.draggable = true;
    btn.title = 'Open ' + (_smartNavLabels[tab] || tab) + ' · drag left/right to reorder favorites';
    const star = document.createElement('span');
    star.textContent = '\u2605';
    star.setAttribute('aria-hidden', 'true');
    const txt = document.createElement('span');
    txt.textContent = _smartNavLabels[tab] || tab;
    btn.appendChild(star);
    btn.appendChild(txt);
    btn.addEventListener('click', () => _smartNavOpenTab(tab));
    btn.addEventListener('dragstart', ev => {
      _smartNavDraggedTab = tab;
      btn.classList.add('is-dragging');
      try { ev.dataTransfer.effectAllowed = 'move'; ev.dataTransfer.setData('text/plain', tab); } catch {}
    });
    btn.addEventListener('dragend', () => {
      btn.classList.remove('is-dragging');
      if (_smartNavDraggedTab) {
        _smartNavDraggedTab = null;
        _smartNavSaveFavoriteOrderFromDom();
        _smartNavRenderFavorites();
        _smartNavRefreshStars();
      }
    });
    wrap.appendChild(btn);
  });
}

function _smartNavDecorateItems() {
  document.querySelectorAll('#tab-bar .nav-item[data-tab]').forEach(btn => {
    if (btn.dataset.smartNavDecorated === '1') return;
    const label = _smartNavText(btn.dataset.navLabel || btn.textContent);
    btn.dataset.navLabel = label;
    btn.textContent = '';
    const star = document.createElement('span');
    star.className = 'nav-star';
    star.textContent = '\u2606';
    star.title = 'Add to favorites';
    star.setAttribute('role', 'button');
    star.setAttribute('aria-label', 'Add to favorites');
    star.addEventListener('click', ev => {
      ev.preventDefault();
      ev.stopPropagation();
      _smartNavToggleFavorite(btn.dataset.tab);
    });
    const txt = document.createElement('span');
    txt.className = 'nav-text';
    txt.textContent = label;
    btn.appendChild(star);
    btn.appendChild(txt);
    btn.dataset.smartNavDecorated = '1';
  });
}

function _smartNavClamp(value, min, max) {
  return Math.max(min, Math.min(value, max));
}

function _smartNavAlignDropdown(group) {
  const menu = group?.querySelector?.('.nav-items');
  const summary = group?.querySelector?.('summary');
  if (!menu || !summary || !group.open) return;
  const gutter = 12;
  menu.style.left = gutter + 'px';
  menu.style.right = 'auto';
  menu.style.top = '0px';
  menu.style.maxWidth = `calc(100vw - ${gutter * 2}px)`;
  requestAnimationFrame(() => {
    const summaryRect = summary.getBoundingClientRect();
    const menuRect = menu.getBoundingClientRect();
    const menuWidth = Math.min(menuRect.width || 260, window.innerWidth - gutter * 2);
    let left = summaryRect.left;
    const maxLeft = window.innerWidth - menuWidth - gutter;
    left = _smartNavClamp(left, gutter, Math.max(gutter, maxLeft));
    let top = summaryRect.bottom + 6;
    const menuHeight = Math.min(menuRect.height || 0, window.innerHeight * 0.7);
    const maxTop = window.innerHeight - menuHeight - gutter;
    top = _smartNavClamp(top, gutter, Math.max(gutter, maxTop));
    menu.style.left = `${Math.round(left)}px`;
    menu.style.top = `${Math.round(top)}px`;
  });
}

function _smartNavAlignOpenDropdown() {
  const open = document.querySelector('#tab-bar .nav-group[open]');
  if (open) _smartNavAlignDropdown(open);
}

function initSmartNavigation() {
  if (_smartNavReady) return;
  _smartNavReady = true;
  _smartNavBuildLabels();
  _smartNavDecorateItems();
  _smartNavRenderFavorites();
  _smartNavInitFavoriteReorder();
  _smartNavRefreshStars();

  const groups = Array.from(document.querySelectorAll('#tab-bar .nav-group'));
  let closing = false;
  groups.forEach(group => {
    group.open = false;
    group.addEventListener('toggle', () => {
      if (closing) return;
      if (group.open) {
        closing = true;
        groups.forEach(other => { if (other !== group) other.open = false; });
        closing = false;
        _smartNavAlignDropdown(group);
      }
    });
  });

  document.querySelectorAll('#tab-bar .nav-item[data-tab]').forEach(btn => {
    btn.addEventListener('click', () => {
      setTimeout(() => {
        _smartNavCloseAllGroups();
        _smartNavRenderFavorites();
        _smartNavRefreshStars();
      }, 0);
    });
  });

  document.addEventListener('click', ev => {
    const nav = document.getElementById('nav-wrap');
    if (nav && !nav.contains(ev.target)) _smartNavCloseAllGroups();
  });
  document.addEventListener('keydown', ev => {
    if (ev.key === 'Escape') _smartNavCloseAllGroups();
  });
  window.addEventListener('resize', _smartNavAlignOpenDropdown);
  const content = document.getElementById('content');
  if (content) content.addEventListener('scroll', _smartNavAlignOpenDropdown, { passive: true });
}
function setupTabs() {
  document.querySelectorAll('[data-tab]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      _setActiveTab(btn.dataset.tab);
      const tab = btn.dataset.tab;
      _toggleScannerResultPanes(tab !== 'backtest');
      // Lazy-load heavy pages on first visit
      if (tab==='tradeanalysis') setTimeout(_loadTradeAnalysis, 50);
      if (tab==='scheduler')     { setTimeout(_loadFuturesConfig, 200); setTimeout(_schwabCheckStatus, 300); }
      if (tab==='mom-retrace')     { setTimeout(_mrLoadWatchlists, 80); }
      if (tab==='rsi-mtf')          { setTimeout(rsiMtfLoadParams, 100); setTimeout(function(){ if(_scanCfgs['rmt-status']) _loadFromCache(_scanCfgs['rmt-status']); }, 200); setTimeout(_rmtLoadWatchlists, 150); }
      if (tab==='weeklyplan')       { /* manual only */ }
      if (tab==='heatmap') setTimeout(()=>_loadWatchlistDropdown('hm-watchlist','hm-wl-count'), 80);
      if (tab==='intraday')    { setTimeout(_intradayLoadWatchlists, 80); setTimeout(runIntradayScan, 140); }
      if (tab==='dashboard') { setTimeout(_loadDashFutures, 400); }
      if (tab==='weeklyanalysis') { setTimeout(_waLoadWatchlists, 80); }
      if (tab==='scanner-builder') { /* standalone iframe page */ }
      if (tab==='planner')   { setTimeout(_plannerLoadWatchlists, 80); }
      if (tab==='candidate-board') { setTimeout(_cbLoadWatchlists, 80); setTimeout(runCandidateBoard, 180); }
      if (tab==='backtest')      setTimeout(_loadBacktest, 50);
      if (tab==='watchlists')    { setTimeout(_wlLoad, 50); setTimeout(_tgLoadConfig, 100); }
      if (tab==='alerts')        { setTimeout(_loadAlertsHub, 50); setTimeout(_loadAlertsWatchlists, 100); setTimeout(_loadTradeHealthAlerts, 150); setTimeout(_loadPositionAlertRules, 220); }
      if (tab==='inst-scan')      { setTimeout(_instLoadWatchlists, 50); setTimeout(_instLoadCache, 100); }
      if (tab==='regime')        { setTimeout(loadRegimeResults, 50); setTimeout(()=>_loadWatchlistDropdown('regime-watchlist','regime-wl-count'), 80); }
      if (tab==='srbreak')       { setTimeout(()=>_loadWatchlistDropdown('sr-watchlist','sr-wl-count'), 80); setTimeout(()=>{ _srNav('breakout'); if(_scanCfgs['sr-prox-status']) _loadFromCache(_scanCfgs['sr-prox-status']); else _loadSRProximityFromDB(true); if(_scanCfgs['sr-status']) _loadFromCache(_scanCfgs['sr-status']); }, 50); }
      if (tab==='oibuildup')     { setTimeout(()=>{ _oibLoadWatchlists(); }, 50); }
      if (tab==='gexplan')       setTimeout(_gexLoadExpiries, 50);
      if (tab==='earnings') {
        setTimeout(() => {
          _earnLoadWatchlists();
          if(_scanCfgs['pre-earn-status'])  _loadFromCache(_scanCfgs['pre-earn-status']);
          else _loadPreEarningsFromDB(true);
          if(_scanCfgs['post-earn-status']) _loadFromCache(_scanCfgs['post-earn-status']);
          else _loadPostEarningsFromDB(true);
          _earnNav('pre');
        }, 150);
      }
    });
  });
}

// ── Expiration helpers ─────────────────────────────────────────
const _TODAY = new Date().toISOString().slice(0,10);

function firstFutureExp(exps) {
  // Return the first expiry >= today, or first overall
  return exps.find(e=>e>=_TODAY) || exps[0] || null;
}

async function loadExpSelect(selId, symbol, {futureOnly=false, defaultToFuture=true}={}) {
  /** Populate a <select> with expirations for symbol.
   *  futureOnly=true  → only future dates in the list
   *  futureOnly=false → past DB dates + all future dates (for aggregate historical)
   *  defaultToFuture  → auto-select the nearest future date
   *  Always merges DB + live yfinance to show ALL available expirations (SPY dailies etc.)
   */
  let exps = [];
  try {
    // Step 1: Get ALL DB expirations (includes historical data dates)
    const d = await api(`/api/db_expirations?symbol=${symbol}`).catch(()=>({}));
    const dbExps = d.expirations || [];

    // Step 2: Get ALL live yfinance expirations (future only, includes SPY dailies)
    const d2 = await api(`/api/expirations?symbol=${symbol}`).catch(()=>({expirations:[]}));
    const liveExps = d2.expirations || [];

    // Step 3: Merge + deduplicate + sort
    const allExps = [...new Set([...dbExps, ...liveExps])].sort();

    // Step 4: Apply futureOnly filter if requested
    if (futureOnly) {
      exps = allExps.filter(e => e >= _TODAY);
    } else {
      exps = allExps;  // include historical dates for aggregate analysis
    }
  } catch {}
  const sel = document.getElementById(selId);
  if (!sel) return null;
  sel.innerHTML = '';
  exps.forEach(e => {
    const o = document.createElement('option');
    o.value = e;
    o.textContent = e;
    // Highlight past dates
    if (e < _TODAY) o.style.color = '#64748b';
    sel.appendChild(o);
  });
  const chosen = defaultToFuture ? (firstFutureExp(exps) || exps[0]) : exps[0];
  if (chosen) sel.value = chosen;
  return chosen || null;
}


// BOOT — all wiring inside DOMContentLoaded

window.addEventListener('DOMContentLoaded', async () => {
  setupTabs();
  initSmartNavigation();
  initSqlSavedQueries();
  const _qpTab = new URLSearchParams(window.location.search).get('tab');
  if (_qpTab) setTimeout(() => document.querySelector(`[data-tab="${_qpTab}"]`)?.click(), 0);

  // ── Preload bootstrap data (single fast DB call, no yfinance) ──────────
  let _boot = {symbols:[], expirations:[], symbol:'SPY'};
  try { _boot = await api('/api/bootstrap?symbol=SPY'); } catch {}
  window._bootData = _boot;   // shared across inits
  _initTopbarMarketContext();

  // ── Run all inits in parallel — no sequential waiting ─────────────────
  initHeatmapTab();
  initScheduler();
  await Promise.all([
    initDashboard(),
    initAggregateTab(),
    initStrategyTab(),
    loadSchedulerList(),
    initSqlViewer(),
  ]);

  updateSchedulerStatus();
  setInterval(updateSchedulerStatus, 15000);
  const last = localStorage.getItem('last_sql_query');
  if (last) { const el=document.getElementById('sql-query'); if(el) el.value=last; }
  _jrnInitAutoRefreshControl();
});


// TOPBAR MARKET CONTEXT — spot, VIX, macro message board, and latest news
let _topbarCtxTimer = null;
let _topbarNewsItems = [];
const TOPBAR_NEWS_REFRESH_KEY = 'topbar_news_refresh_min';
const TOPBAR_MARQUEE_SPEED_KEY = 'topbar_marquee_speed_seconds';
function _topbarSymbol() {
  return (document.getElementById('symbol-input')?.value || currentSymbol || 'SPY').trim().toUpperCase() || 'SPY';
}
function _fmtTopbarPx(v, dec=2) {
  const n = Number(v);
  return Number.isFinite(n) ? n.toFixed(dec) : '—';
}
function _topbarEsc(v) {
  return String(v ?? '').replace(/[&<>"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
}
function _topbarNewsRefreshMin() {
  const el = document.getElementById('topbar-news-refresh');
  const raw = el?.value || localStorage.getItem(TOPBAR_NEWS_REFRESH_KEY) || '15';
  const n = parseInt(raw, 10);
  return Number.isFinite(n) && n > 0 ? Math.max(5, Math.min(n, 1440)) : 15;
}
function _topbarMarqueeSpeedSec() {
  const el = document.getElementById('topbar-marquee-speed');
  const raw = el?.value || localStorage.getItem(TOPBAR_MARQUEE_SPEED_KEY) || '90';
  const n = parseInt(raw, 10);
  return Number.isFinite(n) && n >= 30 ? Math.max(30, Math.min(n, 300)) : 90;
}
function _applyTopbarMarqueeSpeed() {
  const board = document.getElementById('market-message-board');
  const sec = _topbarMarqueeSpeedSec();
  if (board) board.style.setProperty('--market-marquee-duration', `${sec}s`);
}
function _openTopbarNewsItem(idx) {
  const n = _topbarNewsItems[Number(idx)] || null;
  if (!n) return;
  const url = String(n.url || '').trim();
  if (url && url !== '#') {
    window.open(url, '_blank', 'noopener,noreferrer');
    return;
  }
  // If there is no external URL, fall back to the Market News tab and search
  // for the clicked headline, similar to clicking through from the news page.
  document.querySelector('[data-tab="news"]')?.click();
  setTimeout(() => {
    const q = document.getElementById('news-search');
    if (q) {
      q.value = String(n.headline || '').slice(0, 80);
      if (typeof filterNews === 'function') filterNews();
    }
  }, 150);
}
function _setTopbarMessage(messages, events, news) {
  const board = document.getElementById('market-message-board');
  const track = document.getElementById('market-message-track');
  if (!board || !track) return;
  _applyTopbarMarqueeSpeed();
  const macroMsgs = Array.isArray(messages) ? messages.filter(Boolean) : [];
  const newsItems = Array.isArray(news?.items) ? news.items.filter(n => n && n.headline) : [];
  _topbarNewsItems = newsItems;
  const pieces = [];
  for (const m of macroMsgs) {
    pieces.push(`<span class="market-message-item macro">${_topbarEsc(m)}</span>`);
  }
  newsItems.slice(0, 8).forEach((n, idx) => {
    const headline = String(n.headline || '').trim();
    if (!headline) return;
    const source = n.source ? ` · ${n.source}` : '';
    const sym = n.symbol && !['MARKET','SPY','QQQ','^VIX'].includes(String(n.symbol).toUpperCase()) ? ` · ${n.symbol}` : '';
    const pub = n.published ? ` · ${String(n.published).slice(0,16)}` : '';
    const title = [headline, n.summary || '', n.url || ''].filter(Boolean).join(' | ');
    pieces.push(`<button type="button" class="market-message-item news" data-topbar-news-idx="${idx}" title="${_topbarEsc(title)}">📰 ${_topbarEsc(headline)}${_topbarEsc(sym)}${_topbarEsc(source)}${_topbarEsc(pub)}</button>`);
  });
  if (!pieces.length) pieces.push(`<span class="market-message-item macro">✅ No major macro/news items loaded.</span>`);
  track.innerHTML = pieces.join(`<span class="market-message-sep">•</span>`);
  track.querySelectorAll('[data-topbar-news-idx]').forEach(btn => {
    btn.addEventListener('click', ev => {
      ev.stopPropagation();
      _openTopbarNewsItem(btn.getAttribute('data-topbar-news-idx'));
    });
  });
  const hot = (events || []).some(e => e && e.is_today && String(e.impact || '').toLowerCase() === 'high');
  board.classList.toggle('is-hot', !!hot);
  board.classList.toggle('is-quiet', !hot);
  const refresh = news?.refresh_minutes ? `News refresh: ${news.refresh_minutes}m` : '';
  const checked = news?.last_checked ? `Last news check: ${news.last_checked}` : '';
  const speed = `Ticker speed: ${_topbarMarqueeSpeedSec()}s`;
  board.title = [refresh, checked, speed, [...macroMsgs, ...newsItems.map(n => n.headline)].join('  | ')].filter(Boolean).join(' · ');
}
async function _loadTopbarMarketContext(opts={}) {
  const refreshBtn = document.getElementById('topbar-news-refresh-now');
  if (opts.forceNews && refreshBtn) refreshBtn.classList.add('is-loading');
  try {
    const sym = 'SPY';
    const newsMin = _topbarNewsRefreshMin();
    const force = opts.forceNews ? '&force_news=1' : '';
    const d = await api(`/api/topbar_context?symbol=${encodeURIComponent(sym)}&days_back=0&days_ahead=3&news_refresh_min=${encodeURIComponent(newsMin)}${force}`);
    const sp = d && d.spot ? d.spot : {};
    const vx = d && d.vix ? d.vix : {};
    const spotEl = document.getElementById('spot-price');
    if (spotEl && sp.price != null) spotEl.textContent = `$${_fmtTopbarPx(sp.price, 2)}`;
    const vixEl = document.getElementById('vix-price');
    const vixBadge = document.getElementById('vix-badge');
    if (vixEl) {
      const chg = Number(vx.change_pct);
      vixEl.textContent = vx.price != null
        ? `${_fmtTopbarPx(vx.price, 2)}${Number.isFinite(chg) ? ' (' + (chg >= 0 ? '+' : '') + chg.toFixed(1) + '%)' : ''}`
        : '—';
    }
    if (vixBadge) {
      const n = Number(vx.price);
      vixBadge.classList.toggle('vix-hot', Number.isFinite(n) && n >= 20);
      vixBadge.classList.toggle('vix-calm', Number.isFinite(n) && n > 0 && n < 15);
      vixBadge.title = vx.source ? `VIX source: ${vx.source}${vx.timestamp ? ' · ' + vx.timestamp : ''}` : 'VIX';
    }
    const macroMsgs = d?.macro?.messages || [];
    _setTopbarMessage(macroMsgs, d?.macro?.events || [], d?.news || null);
  } catch(e) {
    _setTopbarMessage([`⚠️ Market message board unavailable: ${e.message || e}`], [], null);
  } finally {
    if (refreshBtn) refreshBtn.classList.remove('is-loading');
  }
}
function _initTopbarNewsControls() {
  const sel = document.getElementById('topbar-news-refresh');
  if (sel) {
    const saved = localStorage.getItem(TOPBAR_NEWS_REFRESH_KEY);
    if (saved && [...sel.options].some(o => o.value === saved)) sel.value = saved;
    sel.addEventListener('change', () => {
      localStorage.setItem(TOPBAR_NEWS_REFRESH_KEY, sel.value || '15');
      _loadTopbarMarketContext({forceNews:true});
    });
  }
  const speedSel = document.getElementById('topbar-marquee-speed');
  if (speedSel) {
    const savedSpeed = localStorage.getItem(TOPBAR_MARQUEE_SPEED_KEY);
    if (savedSpeed && [...speedSel.options].some(o => o.value === savedSpeed)) speedSel.value = savedSpeed;
    _applyTopbarMarqueeSpeed();
    speedSel.addEventListener('change', () => {
      localStorage.setItem(TOPBAR_MARQUEE_SPEED_KEY, speedSel.value || '90');
      _applyTopbarMarqueeSpeed();
    });
  }
  document.getElementById('topbar-news-refresh-now')?.addEventListener('click', () => {
    _loadTopbarMarketContext({forceNews:true});
  });
}
function _initTopbarMarketContext() {
  _initTopbarNewsControls();
  _loadTopbarMarketContext();
  if (_topbarCtxTimer) clearInterval(_topbarCtxTimer);
  // Spot/VIX/macro are refreshed every five minutes. News fetches honor the
  // selected server-side cache cadence, so choosing 1h won't hit news sources
  // every five minutes.
  _topbarCtxTimer = setInterval(_loadTopbarMarketContext, 5 * 60 * 1000);
}


// DASHBOARD

async function initDashboard() {
  const symEl  = document.getElementById('symbol-input');
  const expEl  = document.getElementById('expiration-select');
  const sideEl = document.getElementById('per-side-input');
  if (!symEl||!expEl) return;

  symEl.value = currentSymbol = 'SPY';
  uc(symEl);

  await _dashLoad(currentSymbol);
  setTimeout(_loadDashFutures, 350);

  symEl.addEventListener('change', async()=>{
    currentSymbol = symEl.value.trim().toUpperCase()||'SPY';
    await _dashLoad(currentSymbol);
    _loadTopbarMarketContext();
  });
  expEl.addEventListener('change', async()=>{
    currentExpiration = expEl.value;
    await dashRefresh();
  });
  sideEl?.addEventListener('change', async()=>{
    perSide = +sideEl.value||12;
    await dashRefresh();
  });
  document.getElementById('toggle-oi')?.addEventListener('change', dashRefresh);
  document.getElementById('toggle-vol')?.addEventListener('change', dashRefresh);
  document.getElementById('oi-sig-pct')?.addEventListener('change', dashRefresh);
}


async function _dashLoad(symbol) {
  symbol = (symbol || document.getElementById('symbol-input')?.value || 'SPY').trim().toUpperCase() || 'SPY';
  currentSymbol = symbol;
  const symInput = document.getElementById('symbol-input');
  if (symInput && (symInput.value || '').trim().toUpperCase() !== symbol) symInput.value = symbol;
  const expEl = document.getElementById('expiration-select');
  expEl.innerHTML = '<option value="">Loading…</option>';

  // Use loadExpSelect which merges DB + yfinance (gets SPY dailies too)
  const chosen = await loadExpSelect('expiration-select', symbol, {futureOnly:true, defaultToFuture:true});

  const exps = Array.from(expEl.options).map(o => o.value).filter(Boolean);

  if (!exps.length) {
    expEl.innerHTML = '<option value="">No data — run Scheduler first</option>';
    currentExpiration = null;
    _updateSpotBadge(symbol);
    loadHistory(symbol);
    return;
  }

  // Default to the nearest future expiry
  const want = (expEl.dataset.preselect||'').trim();
  if (want && exps.includes(want)) {
    currentExpiration = want;
  } else {
    // Pick first expiry that is today or later (nearest upcoming)
    currentExpiration = exps[0];
  }
  expEl.value = currentExpiration;
  if (want) delete expEl.dataset.preselect;

  _updateSpotBadge(symbol);
  loadHistory(symbol);
  await dashRefresh();
}

async function _updateSpotBadge(symbol) {
  const el=document.getElementById('selected-symbol-price'); if(!el) return;
  el.textContent='…';
  try {
    const d=await api(`/api/spot?symbol=${encodeURIComponent(symbol)}`);
    el.textContent=d.spot?`$${(+d.spot).toFixed(2)}`:'—';
  } catch { el.textContent='—'; }
}

async function _updateAggSpotBadge(symbol) {
  const el=document.getElementById('agg-spot'); if(!el) return;
  el.textContent='…';
  try {
    const d=await api(`/api/spot?symbol=${symbol}`);
    el.textContent=d.spot?`$${(+d.spot).toFixed(2)}`:'—';
  } catch { el.textContent='—'; }
}

function _oiSigPctFrom(id, fallback=30) {
  const el = document.getElementById(id);
  const n = Number(el?.value);
  return Number.isFinite(n) && n >= 0 ? n : fallback;
}
function _oiSigParam(id) { return String(_oiSigPctFrom(id, 30)); }
function _oiSigNote(filter) {
  if (!filter || !filter.enabled) return '';
  const q = filter.qualified ? 'ON' : 'OFF';
  const pct = Number(filter.min_change_pct ?? 30);
  const reason = String(filter.reason || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  return `ΔOI significance ${q} · threshold ${Number.isFinite(pct) ? pct : 30}%. ${reason}`;
}
function _sigLineArrays(rowsByStrike, strikes, baseColor) {
  const lineColors = []; const widths = [];
  for (const s of strikes) {
    const r = rowsByStrike.find(x => +x.strike === +s) || {};
    const sig = !!r.oi_change_significant;
    lineColors.push(sig ? '#fbbf24' : 'rgba(255,255,255,.12)');
    widths.push(sig ? 2.5 : 0);
  }
  return {color: lineColors, width: widths};
}

async function dashRefresh() {
  // Always use the Dashboard symbol input as the source of truth.
  // Other tabs can have their own symbol controls and must not overwrite this page.
  const dashSym = (document.getElementById('symbol-input')?.value || currentSymbol || 'SPY').trim().toUpperCase() || 'SPY';
  currentSymbol = dashSym;
  // Refresh compact futures OI when dashboard data refreshes.
  setTimeout(_syncDashFuturesSymbolFromDashboard, 150);
  setTimeout(_loadDashFutures, 500);
  if (!currentExpiration) return;
  // Auto-run OI intelligence when expiry changes (non-blocking)
  setTimeout(()=>{ if(currentExpiration) runOIIntelligence(); }, 300);
  const showOI  = document.getElementById('toggle-oi')?.checked??true;
  const showVol = document.getElementById('toggle-vol')?.checked??true;
  const d = await api(`/api/options?symbol=${dashSym}&expiration=${currentExpiration}&per_side=${perSide}&min_change_pct=${encodeURIComponent(_oiSigParam('oi-sig-pct'))}`).catch(()=>({}));
  const calls=d?.calls||[], puts=d?.puts||[];

  // Show message if no OI data
  const oiChartEl = document.getElementById('options-chart');
  const hasOI = calls.some(c=>c.oi>0) || puts.some(p=>p.oi>0);
  const hasVol = calls.some(c=>c.volume>0) || puts.some(p=>p.volume>0);

  if (!calls.length && !puts.length) {
    if (oiChartEl) oiChartEl.innerHTML = `
      <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:280px;color:var(--muted)">
        <div style="font-size:28px;margin-bottom:10px">📭</div>
        <div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:6px">No OI data for ${dashSym} ${currentExpiration}</div>
        <div style="font-size:11px;text-align:center;max-width:320px;line-height:1.7">
          Run the <b style="color:var(--accent)">Scheduler</b> tab to fetch options data,
          or click <b style="color:var(--accent)">▶ Run Now</b> to fetch immediately.
        </div>
      </div>`;
    return;
  }

  const strikes=[...new Set([...calls,...puts].map(r=>+r.strike))].sort((a,b)=>a-b);
  window.visibleStrikes=strikes;
  renderOIChart('options-chart',dashSym,currentExpiration,calls,puts,showOI,showVol,strikes);
  renderDeltaChart(dashSym,currentExpiration,strikes);
}

function renderOIChart(id, symbol, expiry, calls, puts, showOI, showVol, strikes) {
  const el=document.getElementById(id); if(!el) return;
  const mk=(src,metric,name,color)=>{
    const vals = strikes.map(s=>{const f=src.find(r=>+r.strike===s)||{};return+(f[metric]||0);});
    const custom = strikes.map(s=>{const f=src.find(r=>+r.strike===s)||{};return [f.oi_change ?? 0, f.oi_change_pct ?? null, f.oi_change_significant ? 'YES' : 'no', f.oi_change_significance_reason || ''];});
    return {
      type:'bar',x:strikes,y:vals,name,
      marker:{color, line: metric==='oi' ? _sigLineArrays(src, strikes, color) : {width:0}},
      customdata:custom,
      hovertemplate:'Strike %{x}<br>'+name+' %{y:,}<br>ΔOI %{customdata[0]:,}<br>ΔOI% %{customdata[1]}<br>Significant %{customdata[2]}<br>%{customdata[3]}<extra></extra>'
    };
  };
  const t=[];
  if(showOI){t.push(mk(calls,'oi','Call OI','rgba(59,130,246,0.8)'));t.push(mk(puts,'oi','Put OI','rgba(239,68,68,0.85)'));}
  if(showVol){t.push(mk(calls,'volume','Call Vol','rgba(99,102,241,0.35)'));t.push(mk(puts,'volume','Put Vol','rgba(220,38,38,0.3)'));}
  Plotly.newPlot(el,t,{...PL,barmode:'group',title:`${symbol} ${expiry} OI`, annotations:[{text:'Gold outline = ΔOI above configured significance threshold', xref:'paper', yref:'paper', x:0.5, y:1.08, showarrow:false, font:{size:10,color:'#94a3b8'}}]},PC);
}

let _oiChangeRenderToken = 0;
async function renderDeltaChart(symbol, expiration, strikes) {
  const holder=document.getElementById('oiChangeChart'); if(!holder) return;
  const token = ++_oiChangeRenderToken;
  // Use Plotly for the ΔOI chart, same rendering path as the main OI chart.
  // A render token prevents an older slow request from leaving a stale
  // "Loading ΔOI" overlay on top of a newer chart.
  let el = holder;
  if (holder.tagName && holder.tagName.toLowerCase() === 'canvas') {
    const div = document.createElement('div');
    div.id = holder.id;
    div.style.width = '100%';
    div.style.height = '100%';
    holder.replaceWith(div);
    el = div;
  }
  try { if (window.Plotly) Plotly.purge(el); } catch(_e) {}
  try { el.replaceChildren(); } catch(_e) { el.innerHTML = ''; }
  const loading = document.createElement('div');
  loading.style.cssText = 'height:100%;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px';
  loading.textContent = 'Loading ΔOI…';
  el.appendChild(loading);
  const d=await api(`/api/oi_change?symbol=${encodeURIComponent(symbol)}&expiration=${encodeURIComponent(expiration)}&min_change_pct=${encodeURIComponent(_oiSigParam('oi-sig-pct'))}`).catch((e)=>({error:e.message||String(e)}));
  if (token !== _oiChangeRenderToken) return;
  const cD=d.call_change||[], pD=d.put_change||[];
  const S=strikes?.length?strikes:[...new Set([...cD,...pD].map(x=>+x.strike))].sort((a,b)=>a-b);
  if(!S.length){
    el.innerHTML = `<div style="height:100%;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px;text-align:center;line-height:1.6">
      No OI change data for ${symbol} ${expiration}<br><span style="font-size:10px">${d.error||'Need at least one stored OI snapshot.'}</span>
    </div>`;
    return;
  }
  const cV=S.map(s=>{const r=cD.find(x=>+x.strike===+s);return r?+r.oi_change:0;});
  const pV=S.map(s=>{const r=pD.find(x=>+x.strike===+s);return r?+r.oi_change:0;});
  const hasNonZero = cV.some(v=>v!==0) || pV.some(v=>v!==0);
  const titleSuffix = d.comparison_label || (d.prev_date ? `${d.latest_date||''} vs ${d.prev_date}` : (d.latest_date ? `Latest ${d.latest_date}` : ''));
  // The API already compares latest OI against the previous distinct snapshot.
  // Do not show a scary "identical snapshot" warning on the chart; the dates
  // in the title are the actual comparison dates.
  const noteText = '';
  const cLine = _sigLineArrays(cD, S, 'rgba(59,130,246,0.85)');
  const pLine = _sigLineArrays(pD, S, 'rgba(239,68,68,0.85)');
  const cCustom = S.map(s=>{const r=cD.find(x=>+x.strike===+s)||{};return [r.oi_change_pct ?? null, r.latest_oi ?? 0, r.prev_oi ?? 0, r.oi_change_significant ? 'YES' : 'no', r.oi_change_significance_reason || ''];});
  const pCustom = S.map(s=>{const r=pD.find(x=>+x.strike===+s)||{};return [r.oi_change_pct ?? null, r.latest_oi ?? 0, r.prev_oi ?? 0, r.oi_change_significant ? 'YES' : 'no', r.oi_change_significance_reason || ''];});
  const traces=[
    {type:'bar', x:S, y:cV, name:'Call ΔOI', marker:{color:'rgba(59,130,246,0.85)', line:cLine}, customdata:cCustom, hovertemplate:'Strike %{x}<br>Call ΔOI %{y:,}<br>ΔOI% %{customdata[0]}<br>Now %{customdata[1]:,} vs Prev %{customdata[2]:,}<br>Significant %{customdata[3]}<br>%{customdata[4]}<extra></extra>'},
    {type:'bar', x:S, y:pV, name:'Put ΔOI', marker:{color:'rgba(239,68,68,0.85)', line:pLine}, customdata:pCustom, hovertemplate:'Strike %{x}<br>Put ΔOI %{y:,}<br>ΔOI% %{customdata[0]}<br>Now %{customdata[1]:,} vs Prev %{customdata[2]:,}<br>Significant %{customdata[3]}<br>%{customdata[4]}<extra></extra>'},
  ];
  const annotations=[];
  const sigNote = _oiSigNote(d.oi_change_filter);
  if (sigNote) annotations.push({text: sigNote + ' · Gold outline = significant strike ΔOI', xref:'paper', yref:'paper', x:0.5, y:1.12, showarrow:false, font:{color:'#94a3b8', size:10}, align:'center'});
  if (noteText) {
    annotations.push({text: noteText, xref:'paper', yref:'paper', x:0.5, y:1.22, showarrow:false, font:{color:'#f59e0b', size:10}, align:'center'});
  }
  if(!hasNonZero){
    annotations.push({text:(d.error||'No OI changed between stored snapshots'),xref:'paper',yref:'paper',x:0.5,y:0.5,showarrow:false,font:{color:'#94a3b8',size:12}});
  }
  const layout={...PL,barmode:'group',title:`ΔOI Change ${titleSuffix}`, margin:{...PL.margin,t:(noteText||sigNote)?58:34}, annotations};
  try { if (window.Plotly) Plotly.purge(el); } catch(_e) {}
  try { el.replaceChildren(); } catch(_e) { el.innerHTML = ''; }
  Plotly.newPlot(el,traces,layout,PC);
}


async function loadHistory(symbol) {
  const d=await api(`/api/history?symbol=${symbol}&period=3mo`).catch(()=>({}));
  const prices=d?.prices||[];
  if(!prices.length){
    const el=document.getElementById('history-chart');
    if(el) el.innerHTML=`
      <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:260px;color:var(--muted)">
        <div style="font-size:28px;margin-bottom:10px">📈</div>
        <div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:6px">Price history unavailable for ${symbol}</div>
        <div style="font-size:11px;color:var(--muted)">yfinance data will load automatically when market data is accessible.</div>
      </div>`;
    return;
  }
  const dates=prices.map(p=>p.date),open=prices.map(p=>+p.open),
        high=prices.map(p=>+p.high),low=prices.map(p=>+p.low),close=prices.map(p=>+p.close);
  const ema=(arr,n)=>{const k=2/(n+1);let e=arr[0];return arr.map((v,i)=>i?(e=v*k+e*(1-k)):v);};
  Plotly.newPlot('history-chart',[
    {type:'candlestick',x:dates,open,high,low,close,
     increasing:{line:{color:'#3b82f6'}},decreasing:{line:{color:'#ef4444'}},name:'Price'},
    {x:dates,y:ema(close,20),mode:'lines',name:'EMA20',line:{color:'#6366f1',width:1.5}},
    {x:dates,y:ema(close,50),mode:'lines',name:'EMA50',line:{color:'#f59e0b',width:1.5}},
  ],{...PL,xaxis:{...PL.xaxis,rangeslider:{visible:false}}},PC);
}



// OI INTELLIGENCE — 5-signal disambiguation panel


// OI INTELLIGENCE — directional verdict + OI walls

function _toggleOIIntel() {
  const body = document.getElementById('oi-intel-body');
  const btn  = document.getElementById('oi-intel-toggle-btn');
  if (!body) return;
  const open = body.style.display === '';
  body.style.display = open ? 'none' : '';
  if (btn) btn.textContent = open ? '▼ Evidence' : '▲ Hide';
}
window._toggleOIIntel = _toggleOIIntel;

async function runOIIntelligence() {
  const sym    = (document.getElementById('symbol-input')?.value || currentSymbol || 'SPY').trim().toUpperCase() || 'SPY';
  const expiry = currentExpiration;
  if (!expiry) return;

  const inlineS = document.getElementById('oi-intel-status-inline');
  const badge   = document.getElementById('oi-intel-overall-badge');
  const summEl  = document.getElementById('oi-intel-summary-chips');
  const barsEl  = document.getElementById('oi-intel-scorebars');
  const bodyEl  = document.getElementById('oi-intel-body');

  if (inlineS) inlineS.innerHTML = `<span style="color:var(--muted)">⏳ Analyzing…</span>`;

  try {
    const d = await api(`/api/oi_intelligence?symbol=${sym}&expiration=${expiry}`);

    if (d.error) {
      if (inlineS) inlineS.innerHTML =
        `<span style="color:var(--muted);font-size:11px">${d.error}</span>`;
      return;
    }

    const dc = d.direction_color || '#f59e0b';
    const confC = d.confidence==='HIGH'?'#22c55e':d.confidence==='MODERATE'?'#f59e0b':'#64748b';

    // ── Always-visible: direction badge ──────────────────────────────────────
    if (badge) {
      badge.style.cssText = `background:${dc}22;border:2px solid ${dc};color:${dc};
        font-size:15px;font-weight:800;padding:4px 16px;border-radius:6px;
        display:inline-block;letter-spacing:.05em`;
      badge.textContent = d.direction || '—';
    }

    // ── Always-visible: summary chips row ────────────────────────────────────
    if (summEl) {
      const priceC = (d.price_chg_pct||0)>=0?'#22c55e':'#ef4444';
      summEl.innerHTML = `
        <span style="font-size:12px;font-weight:700;color:${confC}">
          ${d.confidence} confidence</span>
        <span style="color:var(--border)">·</span>
        <span style="font-size:12px;color:#22c55e">▲ ${d.bull_pts}</span>
        <span style="font-size:11px;color:var(--muted)">bull</span>
        <span style="font-size:12px;color:#ef4444">▼ ${d.bear_pts}</span>
        <span style="font-size:11px;color:var(--muted)">bear</span>
        ${d.pcr!=null?`<span style="color:var(--border)">·</span>
          <span style="font-size:11px;color:var(--muted)">PCR
          <b style="color:${d.pcr>1.2?'#ef4444':d.pcr<0.8?'#22c55e':'#f59e0b'}">${d.pcr}</b></span>`:''}
        ${d.price_chg_pct!=null?`<span style="color:var(--border)">·</span>
          <span style="font-size:11px;color:${priceC}">
            Stock ${d.price_chg_pct>=0?'▲':'▼'}${Math.abs(d.price_chg_pct)}% on ${d.latest_date}</span>`:''}
        <span style="color:var(--border)">·</span>
        <span style="font-size:11px;color:var(--muted)">${d.days_to_expiry}d to expiry</span>`;
    }

    // ── Always-visible: OI walls + summary ───────────────────────────────────
    if (barsEl) {
      barsEl.style.display = '';
      const supports    = (d.walls||[]).filter(w=>w.side==='support');
      const resistances = (d.walls||[]).filter(w=>w.side==='resistance');

      const wallCard = (w) => {
        const c = w.side==='support'?'#22c55e':'#ef4444';
        const growIcon = w.growing ? ' 📈' : w.delta<-200 ? ' 📉' : '';
        const strengthC = w.strength==='STRONG'?c:w.strength==='MODERATE'?c+'aa':'#64748b';
        return `<div style="background:${c}0d;border:1px solid ${c}33;border-radius:5px;
            padding:8px 12px;min-width:130px;flex:1">
          <div style="font-size:10px;font-weight:700;color:${c};letter-spacing:.08em;margin-bottom:3px">
            ${w.side==='support'?'🟢 SUPPORT':'🔴 RESISTANCE'}${growIcon}
          </div>
          <div style="font-size:17px;font-weight:800;color:var(--text)">${w.strike}</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px">
            ${w.oi.toLocaleString()} OI &nbsp;·&nbsp;
            <span style="color:${strengthC}">${w.strength}</span>
          </div>
          <div style="font-size:10px;color:var(--muted)">
            ${w.pct_from_spot}% from spot
            ${w.delta!==0?` · ΔOI <span style="color:${w.delta>0?'#22c55e':'#ef4444'}">${w.delta>0?'+':''}${w.delta.toLocaleString()}</span>`:''}
          </div>
        </div>`;
      };

      barsEl.innerHTML = `
        <div style="font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:12px">
          ${d.summary}
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          ${supports.slice(0,3).map(wallCard).join('')}
          <div style="width:1px;background:var(--border);margin:0 4px;align-self:stretch"></div>
          ${resistances.slice(0,3).map(wallCard).join('')}
        </div>`;
    }

    if (inlineS) inlineS.innerHTML =
      `<span style="color:${dc};font-weight:700">${d.direction}</span>
       <span style="color:var(--muted);font-size:10px"> · ${d.confidence}</span>`;

    // ── Collapsible: evidence bullets ─────────────────────────────────────────
    const bodyContent = document.getElementById('oi-intel-body');
    if (bodyContent) {
      bodyContent.innerHTML = `
        <div style="font-size:11px;font-weight:700;color:var(--muted);
            letter-spacing:.1em;margin-bottom:8px">EVIDENCE — 5-SIGNAL BREAKDOWN</div>
        ${(d.evidence||[]).map((ev,i) => {
          const bull = ev.includes('bullish') || ev.includes('exiting bear');
          const bear = ev.includes('bearish') || ev.includes('hedge') || ev.includes('nervous');
          const c = bull&&!bear?'#22c55e':bear&&!bull?'#ef4444':'#f59e0b';
          return `<div style="display:flex;gap:8px;padding:5px 0;
              border-bottom:1px solid rgba(255,255,255,.05);align-items:flex-start">
            <span style="color:${c};font-size:12px;min-width:14px;margin-top:1px">
              ${bull&&!bear?'▲':bear&&!bull?'▼':'→'}</span>
            <span style="font-size:12px;color:var(--text);line-height:1.5">${ev}</span>
          </div>`;
        }).join('')}
        ${!d.evidence?.length ? '<p style="color:var(--muted);font-size:12px">No significant OI changes detected (min ±300 contracts).</p>' : ''}
        <div style="margin-top:8px;font-size:10px;color:var(--muted)">
          Signals: ① Price action on OI date ② Volume/OI ratio ③ Strike moneyness
          ④ IV expansion proxy ⑤ Roll detection · PCR as tie-breaker
        </div>`;
    }

  } catch(e) {
    const inS = document.getElementById('oi-intel-status-inline');
    if (inS) inS.innerHTML = `<span style="color:var(--red)">❌ ${e.message}</span>`;
    console.error('[oi_intel]', e);
  }
}
window.runOIIntelligence = runOIIntelligence;

// Auto-run OI intelligence when expiry changes (if panel visible)
const _origExpChange = window._onExpChange;

// AGGREGATE TAB

async function initAggregateTab() {
  const symEl=document.getElementById('agg-symbol'); if(!symEl) return;
  const qpSym = new URLSearchParams(window.location.search).get('symbol');
  const initialAggSymbol = (qpSym ? qpSym.trim().toUpperCase() : currentSymbol) || 'SPY';
  // Keep aggregate-tab symbols isolated from the dashboard OI symbol.
  // Previously this shared global caused SPY controls to render a stale LEN message after restarts/deep links.
  symEl.value=initialAggSymbol; uc(symEl);

  const loadAggExp=async(sym)=>{
    // All expiries in list, but DEFAULT to first future one
    const chosen=await loadExpSelect('agg-expiration', sym, {futureOnly:false, defaultToFuture:true});
    return chosen;
  };

  const aggRefresh=async()=>{
    const sym=(document.getElementById('agg-symbol').value||'SPY').trim().toUpperCase();
    const exp=document.getElementById('agg-expiration').value;
    const cnt=+document.getElementById('agg-count').value||3;
    const side=+document.getElementById('agg-strikes').value||10;
    await Promise.all([
      loadAggChart(sym,exp,cnt),
      loadOptionsAgg(sym,exp,side),
      _updateAggSpotBadge(sym),
      loadPCRChart(sym),
    ]);
    // Load cumulative futures OI after main data
    setTimeout(_loadCumulativeOi, 200);
  };

  symEl.addEventListener('change',async()=>{
    const sym=(symEl.value||'SPY').trim().toUpperCase();
    await loadAggExp(sym);
    await aggRefresh();
  });
  document.getElementById('btn-refresh-aggregate')?.addEventListener('click',aggRefresh);
  ['agg-expiration','agg-count','agg-strikes','agg-pcr-strike','agg-show-oi','agg-show-vol','agg-oi-sig-pct'].forEach(id=>
    document.getElementById(id)?.addEventListener('change',aggRefresh)
  );

  await loadAggExp(initialAggSymbol);
  await aggRefresh();
}

async function loadAggChart(sym,fromExp,count) {
  const strikes=+document.getElementById('agg-strikes').value||10;
  const showOI=document.getElementById('agg-show-oi').checked;
  const showVol=document.getElementById('agg-show-vol').checked;
  const d=await api(`/api/aggregate_strike?symbol=${sym}&from_expiration=${fromExp}&count=${count}&strikes=${strikes}&min_change_pct=${encodeURIComponent(_oiSigParam('agg-oi-sig-pct'))}`).catch(()=>({}));
  const xs=d?.strikes||[],call=d?.call_sum||[],put=d?.put_sum||[],cvol=d?.call_vol_sum||[],pvol=d?.put_vol_sum||[];
  _ensureAggPCRStrike(xs, d?.spot);
  const t=[];
  const callSigRows = xs.map((x,i)=>({strike:x, oi_change_significant: !!(d.call_oi_change_significant||[])[i]}));
  const putSigRows = xs.map((x,i)=>({strike:x, oi_change_significant: !!(d.put_oi_change_significant||[])[i]}));
  const callCustom = xs.map((x,i)=>[(d.call_change_sum||[])[i] ?? 0, (d.call_change_pct||[])[i] ?? null, (d.call_oi_change_significant||[])[i] ? 'YES' : 'no']);
  const putCustom = xs.map((x,i)=>[(d.put_change_sum||[])[i] ?? 0, (d.put_change_pct||[])[i] ?? null, (d.put_oi_change_significant||[])[i] ? 'YES' : 'no']);
  if(showOI){
    t.push({type:'bar',x:xs,y:call,name:'Call OI',marker:{color:'rgba(59,130,246,.75)', line:_sigLineArrays(callSigRows, xs, '')}, customdata:callCustom, hovertemplate:'Strike %{x}<br>Call OI %{y:,}<br>Aggregate ΔOI %{customdata[0]:,}<br>ΔOI% %{customdata[1]}<br>Significant %{customdata[2]}<extra></extra>'});
    t.push({type:'bar',x:xs,y:put,name:'Put OI',marker:{color:'rgba(239,68,68,.85)', line:_sigLineArrays(putSigRows, xs, '')}, customdata:putCustom, hovertemplate:'Strike %{x}<br>Put OI %{y:,}<br>Aggregate ΔOI %{customdata[0]:,}<br>ΔOI% %{customdata[1]}<br>Significant %{customdata[2]}<extra></extra>'});
  }
  if(showVol){t.push({type:'bar',x:xs,y:cvol,name:'Call Vol',marker:{color:'rgba(99,102,241,.35)'}});t.push({type:'bar',x:xs,y:pvol,name:'Put Vol',marker:{color:'rgba(220,38,38,.28)'}});}
  const aggNote = _oiSigNote(d.oi_change_filter);
  const sigRows = d.significant_oi_changes || [];
  const info = document.getElementById('agg-oi-sig-info');
  if (info) info.innerHTML = aggNote ? `${aggNote}${sigRows.length ? ' · Significant strikes: ' + sigRows.slice(0,6).map(r => `${String(r.type||'').toUpperCase()} ${r.strike} ${Number(r.oi_change||0).toLocaleString()} (${r.oi_change_pct ?? 'n/a'}%)`).join(' · ') : ' · No significant strike ΔOI in displayed window.'}` : '';
  Plotly.newPlot('aggregate-chart',t,{...PL,barmode:'group',title:'Aggregate OI', annotations: aggNote ? [{text:'Gold outline = strike ΔOI above configured significance threshold',xref:'paper',yref:'paper',x:0.5,y:1.08,showarrow:false,font:{size:10,color:'#94a3b8'}}] : []},PC);
  _bindAggPCRStrikeClick('aggregate-chart', sym);
}

async function loadOptionsAgg(sym,exp,side) {
  if(!exp) return;
  const d=await api(`/api/options?symbol=${sym}&expiration=${exp}&per_side=${side}&min_change_pct=${encodeURIComponent(_oiSigParam('agg-oi-sig-pct'))}`).catch(()=>({}));
  const calls=d?.calls||[],puts=d?.puts||[];
  const strikes=[...new Set([...calls,...puts].map(r=>+r.strike))].sort((a,b)=>a-b);
  renderOIChart('agg-options-chart',sym,exp,calls,puts,
    document.getElementById('agg-show-oi').checked,
    document.getElementById('agg-show-vol').checked,strikes);
  _bindAggPCRStrikeClick('agg-options-chart', sym);
}

function _bindAggPCRStrikeClick(chartId, sym) {
  const el = document.getElementById(chartId);
  const strikeEl = document.getElementById('agg-pcr-strike');
  if (!el || !strikeEl || typeof el.on !== 'function') return;
  try {
    if (typeof el.removeAllListeners === 'function') el.removeAllListeners('plotly_click');
  } catch (_) {}
  el.on('plotly_click', (ev) => {
    const x = ev?.points?.[0]?.x;
    if (x == null || x === '') return;
    const n = Number(x);
    strikeEl.value = Number.isFinite(n) ? String(n) : String(x);
    loadPCRChart(sym).catch(err => console.warn('[agg pcr strike click]', err));
  });
}

function _numFmtCompact(v) {
  if (v == null || !isFinite(Number(v))) return '—';
  const n = Number(v);
  if (Math.abs(n) >= 1000000) return (n / 1000000).toFixed(1) + 'M';
  if (Math.abs(n) >= 1000) return (n / 1000).toFixed(1) + 'k';
  return Math.round(n).toLocaleString();
}

function _ensureAggPCRStrike(strikes, spot) {
  const el = document.getElementById('agg-pcr-strike');
  if (!el) return null;
  const typed = Number(el.value);
  if (Number.isFinite(typed) && typed > 0) return typed;
  const arr = (strikes || []).map(Number).filter(Number.isFinite).sort((a,b)=>a-b);
  if (!arr.length) return null;
  const target = Number.isFinite(Number(spot)) && Number(spot) > 0 ? Number(spot) : arr[Math.floor(arr.length/2)];
  const nearest = arr.reduce((best, v) => Math.abs(v - target) < Math.abs(best - target) ? v : best, arr[0]);
  el.value = String(nearest);
  return nearest;
}

async function loadPCRChart(sym) {
  const exp = document.getElementById('agg-expiration')?.value || '';
  const count = +document.getElementById('agg-count')?.value || 3;
  const strikeEl = document.getElementById('agg-pcr-strike');
  const strike = Number(strikeEl?.value || 0);
  const histCanvas = document.getElementById('pcrStrikeHistoryChart') || document.getElementById('pcrChart');
  const expiryCanvas = document.getElementById('pcrStrikeExpiryChart');
  if (!histCanvas && !expiryCanvas) return;

  const qs = `symbol=${encodeURIComponent(sym)}&expiry=${encodeURIComponent(exp)}&strike=${encodeURIComponent(strike || '')}`;
  const hist = await api(`/api/pcr_strike_timeseries?${qs}`).catch(e => ({error: e.message, series: []}));
  if (hist?.selected_strike != null && strikeEl && !strikeEl.value) strikeEl.value = String(hist.selected_strike);
  await _renderPCRStrikeHistory(histCanvas, hist);

  if (expiryCanvas) {
    const qs2 = `symbol=${encodeURIComponent(sym)}&from_expiration=${encodeURIComponent(exp)}&count=${encodeURIComponent(count)}&strike=${encodeURIComponent(strikeEl?.value || hist?.selected_strike || strike || '')}`;
    const expBars = await api(`/api/pcr_strike_expiries?${qs2}`).catch(e => ({error: e.message, expiries: []}));
    await _renderPCRStrikeExpiryBars(expiryCanvas, expBars);
  }
}

async function _renderPCRStrikeHistory(canvas, d) {
  if (!canvas) return;
  const info = document.getElementById('agg-pcr-info');
  const series = d?.series || [];
  if (window._pcrStrikeHistoryC?.destroy) window._pcrStrikeHistoryC.destroy();
  const ctx = canvas.getContext('2d');
  if (!series.length) {
    if (info) info.innerHTML = `<span style="color:var(--muted);font-size:11px">No strike-level PCR history for ${d?.symbol||''} ${d?.expiry||''} ${d?.selected_strike||''}. Run Scheduler/OI fetch for this expiry.</span>`;
    window._pcrStrikeHistoryC = new Chart(ctx, {type:'bar', data:{labels:[],datasets:[]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});
    return;
  }
  const summary = d.summary || {};
  const dates = series.map(s => String(s.date || '').slice(5));
  const pcrs = series.map(s => s.pcr);
  const chgs = series.map(s => s.pcr_change);
  const current = Number(summary.current ?? pcrs[pcrs.length-1] ?? 0);
  const curC = current > 1.2 ? '#ef4444' : current < 0.8 ? '#22c55e' : '#f59e0b';
  const trendC = summary.trend === 'RISING' ? '#ef4444' : summary.trend === 'FALLING' ? '#22c55e' : '#94a3b8';
  if (info) {
    info.innerHTML = `
      <div style="display:flex;gap:12px;font-size:11px;flex-wrap:wrap;margin-bottom:6px">
        <span>Strike: <b>${d.selected_strike ?? '—'}</b></span>
        <span>Expiry: <b>${d.expiry ?? '—'}</b></span>
        <span>PCR: <b style="color:${curC};font-size:14px">${current ? current.toFixed(3) : '—'}</b></span>
        <span>Trend: <b style="color:${trendC}">${summary.trend || 'N/A'}</b></span>
        <span>Range: <b>${summary.low ?? '—'}</b> – <b>${summary.high ?? '—'}</b></span>
        <span>PCR Rank: <b style="color:${summary.pcr_rank>70?'#ef4444':summary.pcr_rank<30?'#22c55e':'#f59e0b'}">${summary.pcr_rank ?? '—'}%</b></span>
      </div>`;
  }

  window._pcrStrikeHistoryC = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: dates,
      datasets: [
        {
          label: 'PCR Change',
          data: chgs,
          backgroundColor: chgs.map(v => Number(v) > 0 ? 'rgba(239,68,68,.55)' : 'rgba(34,197,94,.55)'),
          borderColor: chgs.map(v => Number(v) > 0 ? '#ef4444' : '#22c55e'),
          borderWidth: 1,
          yAxisID: 'y2',
          order: 2,
        },
        {
          label: 'Strike PCR',
          data: pcrs,
          type: 'line',
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59,130,246,.08)',
          fill: true,
          tension: 0.3,
          pointBackgroundColor: pcrs.map(v => Number(v) > 1.2 ? '#ef4444' : Number(v) < 0.8 ? '#22c55e' : '#f59e0b'),
          pointRadius: 4,
          yAxisID: 'y1',
          order: 1,
        },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      scales: {
        x: { ticks: { color: '#64748b', font: { size: 10 } }, grid: { color: '#2a2f42' } },
        y1: { position: 'left', title: { display: true, text: 'PCR', color: '#3b82f6', font: { size: 10 } }, ticks: { color: '#3b82f6', font: { size: 10 } }, grid: { color: '#2a2f42' } },
        y2: { position: 'right', title: { display: true, text: 'Δ PCR', color: '#94a3b8', font: { size: 10 } }, ticks: { color: '#94a3b8', font: { size: 10 } }, grid: { drawOnChartArea: false } },
      },
      plugins: {
        legend: { labels: { color: '#e2e8f0', font: { size: 10 } } },
        tooltip: { callbacks: { afterBody: (items) => {
          const i = items[0]?.dataIndex; if (i == null) return '';
          const s = series[i] || {};
          return [`Put OI: ${_numFmtCompact(s.put_oi)}`, `Call OI: ${_numFmtCompact(s.call_oi)}`, `Put Vol: ${_numFmtCompact(s.put_vol)}`, `Call Vol: ${_numFmtCompact(s.call_vol)}`];
        }}}
      }
    }
  });
}

async function _renderPCRStrikeExpiryBars(canvas, d) {
  if (!canvas) return;
  const info = document.getElementById('agg-pcr-expiry-info');
  const rows = d?.expiries || [];
  if (window._pcrStrikeExpiryC?.destroy) window._pcrStrikeExpiryC.destroy();
  const ctx = canvas.getContext('2d');
  if (!rows.length) {
    if (info) info.innerHTML = `<span style="color:var(--muted);font-size:11px">No current strike PCR by expiry for ${d?.symbol||''} ${d?.target_strike||''}.</span>`;
    window._pcrStrikeExpiryC = new Chart(ctx, {type:'bar', data:{labels:[],datasets:[]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});
    return;
  }
  const labels = rows.map(r => String(r.expiration || '').slice(5));
  const pcrs = rows.map(r => r.pcr);
  const first = rows[0] || {};
  if (info) {
    const curC = Number(first.pcr) > 1.2 ? '#ef4444' : Number(first.pcr) < 0.8 ? '#22c55e' : '#f59e0b';
    info.innerHTML = `
      <div style="display:flex;gap:12px;font-size:11px;flex-wrap:wrap;margin-bottom:6px">
        <span>Target strike: <b>${d.target_strike ?? '—'}</b></span>
        <span>Current expiry PCR: <b style="color:${curC};font-size:14px">${first.pcr != null ? Number(first.pcr).toFixed(3) : '—'}</b></span>
        <span>Expiries: <b>${rows.length}</b></span>
        <span style="color:var(--muted)">Bars use latest OI snapshot only; no history.</span>
      </div>`;
  }
  window._pcrStrikeExpiryC = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Current PCR at strike',
        data: pcrs,
        backgroundColor: pcrs.map(v => Number(v) > 1.2 ? 'rgba(239,68,68,.70)' : Number(v) < 0.8 ? 'rgba(34,197,94,.70)' : 'rgba(245,158,11,.70)'),
        borderColor: pcrs.map(v => Number(v) > 1.2 ? '#ef4444' : Number(v) < 0.8 ? '#22c55e' : '#f59e0b'),
        borderWidth: 1,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      scales: {
        x: { ticks: { color: '#64748b', font: { size: 10 } }, grid: { color: '#2a2f42' } },
        y: { title: { display: true, text: 'PCR', color: '#94a3b8', font: { size: 10 } }, ticks: { color: '#94a3b8', font: { size: 10 } }, grid: { color: '#2a2f42' } },
      },
      plugins: {
        legend: { labels: { color: '#e2e8f0', font: { size: 10 } } },
        tooltip: { callbacks: { afterBody: (items) => {
          const i = items[0]?.dataIndex; if (i == null) return '';
          const r = rows[i] || {};
          return [`Actual strike: ${r.strike ?? '—'}`, `Snapshot: ${r.date || '—'}`, `Put OI: ${_numFmtCompact(r.put_oi)}`, `Call OI: ${_numFmtCompact(r.call_oi)}`];
        }}}
      }
    }
  });
}



// HEATMAP TAB  — multi-symbol screener

function initHeatmapTab() {
  document.querySelector('[data-tab="heatmap"]')?.addEventListener('click', ()=>{
    // sync symbol from dashboard but don't auto-run
  });
}

function _hmModeChange() {
  const mode = document.getElementById('hm-mode')?.value || '';
  const tw = document.getElementById('hm-thresh-wrap');
  const vw = document.getElementById('hm-vol-wrap');
  const mw = document.getElementById('hm-mom-wrap');
  if (tw) tw.style.display = (mode === 'high_volume' || mode === 'large_momentum') ? 'none' : 'flex';
  if (vw) vw.style.display = mode === 'high_volume' ? 'flex' : 'none';
  if (mw) mw.style.display = mode === 'large_momentum' ? 'flex' : 'none';
}

async function runHeatmapScreen() {
  const mode      = document.getElementById('hm-mode').value;
  const threshold = +document.getElementById('hm-threshold').value||10;
  const volRatio  = +document.getElementById('hm-vol-ratio')?.value || 1.2;
  const momX      = +document.getElementById('hm-mom-x')?.value || 2.0;
  const statEl    = document.getElementById('hm-status');
  const gridEl    = document.getElementById('hm-grid');
  statEl.textContent='⏳ Scanning DB…'; gridEl.innerHTML='';
  document.getElementById('hm-stats').innerHTML='';
  try {
    const sector = document.getElementById('hm-sector')?.value || '';
    const wlId = document.getElementById('hm-watchlist')?.value || '';
    const extraParams = mode==='high_volume' ? `&vol_ratio=${volRatio}`
                      : mode==='large_momentum' ? `&mom_x=${momX}` : '';
    const wlParam = wlId ? `&watchlist_id=${wlId}` : '';
    const data=await api(`/api/scanner/symbol_screener?mode=${mode}&threshold=${threshold}${extraParams}${wlParam}${sector?'&sector='+encodeURIComponent(sector):''}`);

    if(!data.length){
      statEl.textContent=`ℹ No symbols matched (mode=${mode}, threshold=${threshold}%). Run scheduler to populate data.`;
      return;
    }
    statEl.textContent=`✅ ${data.length} symbol(s) · ${data[0]?.snapshot_date||''} · sorted by signal score`;
    _hmData = data; _hmMode = mode;
    _renderHeatTiles(data, mode);
    // Refresh table if it's visible
    if (document.getElementById('hm-table-wrap')?.style.display !== 'none') _renderHeatTable(data, mode);
  } catch(e){statEl.textContent='❌ '+e.message;}
}
window.runHeatmapScreen=runHeatmapScreen;

function _renderHeatTiles(data, mode) {
  const gridEl = document.getElementById('hm-grid');
  if (!gridEl) return;

  // Color scale: red=hot, orange=warm, blue=moderate, slate=cool
  function tileColor(score) {
    if (score >= 75) return 'linear-gradient(135deg,rgba(220,38,38,.92),rgba(239,68,68,.85))';
    if (score >= 50) return 'linear-gradient(135deg,rgba(217,119,6,.9),rgba(245,158,11,.82))';
    if (score >= 25) return 'linear-gradient(135deg,rgba(37,99,235,.88),rgba(59,130,246,.80))';
    return 'linear-gradient(135deg,rgba(51,65,85,.85),rgba(71,85,105,.75))';
  }

  // Key metric — one line only
  function keyMetric(r) {
    if (mode === 'pcr_change') {
      const chg = r.pcr_chg != null ? (r.pcr_chg > 0 ? '+' : '') + r.pcr_chg + '%' : '—';
      return `PCR ${chg}`;
    }
    if (mode === 'oi_change') {
      const chg = r.oi_chg_pct != null ? (r.oi_chg_pct > 0 ? '+' : '') + r.oi_chg_pct + '%' : '—';
      return `OI Δ ${chg}`;
    }
    if (mode === 'large_momentum') {
      // Show: mom_ratio×  |  today_pct_chg%
      const mr  = r.mom_ratio  != null ? r.mom_ratio.toFixed(1)+'× mom' : '—';
      const pct = r.pct_chg    != null ? (r.pct_chg > 0 ? '+' : '') + r.pct_chg.toFixed(1)+'%' : '';
      return `${mr}${pct ? ' | '+pct : ''}`;
    }
    // high_volume: show real vol/avg(20) ratio
    if (r.vol_ratio != null) {
      const pct = r.pct_chg != null ? (r.pct_chg > 0 ? '+' : '') + r.pct_chg.toFixed(1)+'%' : '';
      return `Vol ${r.vol_ratio.toFixed(2)}× avg${pct ? ' | '+pct : ''}`;
    }
    return `Vol ×${r.vol_vs_avg != null ? (r.vol_vs_avg/100+1).toFixed(1) : '—'}`;
  }

  // Compact tile — symbol + price + ONE metric line + score
  gridEl.innerHTML = data.map(r => `
    <div class="hm-tile"
         style="background:${tileColor(r.signal_score)}"
         onclick="_hmTileClick('${r.symbol}')"
         onmouseenter="_hmShowTip(event,${JSON.stringify(r).replace(/"/g,"'")},'${mode}')"
         onmouseleave="_hmHideTip()">
      <div class="hm-tile-sym">${r.symbol}</div>
      <div class="hm-tile-spot">${r.spot != null ? '$' + r.spot : '—'}</div>
      <div class="hm-tile-metric">${keyMetric(r)}</div>
      <div class="hm-tile-score">Score ${r.signal_score}</div>
    </div>`).join('');

  // Stats bar
  const avgScore = Math.round(data.reduce((s, r) => s + r.signal_score, 0) / data.length);
  const hot = data.filter(r => r.signal_score >= 75).length;
  const warm = data.filter(r => r.signal_score >= 50 && r.signal_score < 75).length;
  document.getElementById('hm-stats').innerHTML = `
    <div class="stat-chip"><div class="s-label">Matched</div><div class="s-val">${data.length}</div></div>
    <div class="stat-chip"><div class="s-label">🔴 Hot (≥75)</div><div class="s-val c-red">${hot}</div></div>
    <div class="stat-chip"><div class="s-label">🟠 Warm (≥50)</div><div class="s-val c-yellow">${warm}</div></div>
    <div class="stat-chip"><div class="s-label">Avg Score</div><div class="s-val">${avgScore}</div></div>
    <div class="stat-chip"><div class="s-label">Top Signal</div><div class="s-val c-green">${data[0]?.symbol || '—'}</div></div>`;
}

// ── Tooltip ─────────────────────────────────────────────────────────────────
let _hmTipEl = null;
function _hmEnsureTip() {
  if (!_hmTipEl) {
    _hmTipEl = document.createElement('div');
    _hmTipEl.id = 'hm-tooltip';
    document.body.appendChild(_hmTipEl);
  }
  return _hmTipEl;
}
function _hmShowTip(evt, r, mode) {
  const tip = _hmEnsureTip();
  const pcr = r.pcr_now != null ? r.pcr_now.toFixed(3) : '—';
  const pcrPrev = r.pcr_prev != null ? r.pcr_prev.toFixed(3) : '—';
  const pct = v => v != null ? (v > 0 ? '+' : '') + v + '%' : '—';
  const fmtN = v => v != null ? (+v).toLocaleString() : '—';

  const rows = [
    ['Put OI',  fmtN(r.put_oi)],
    ['Call OI', fmtN(r.call_oi)],
    ['Put Vol', fmtN(r.put_vol)],
    ['Call Vol',fmtN(r.call_vol)],
    mode === 'pcr_change'
      ? ['PCR', `${pcrPrev} → ${pcr} (${pct(r.pcr_chg)})`]
      : mode === 'oi_change'
        ? ['OI Δ', `${pct(r.oi_chg_pct)}  Total: ${fmtN(r.tot_oi)}`]
        : ['Vol vs Avg', `+${r.vol_vs_avg ?? '—'}%`],
    ['Score', r.signal_score + ' / 100'],
  ];

  tip.innerHTML = `
    <div class="tt-sym">${r.symbol}  <span style="font-size:11px;font-weight:400;color:var(--muted)">$${r.spot ?? '—'}</span></div>
    ${rows.map(([l,v])=>`<div class="tt-row"><span class="tt-lbl">${l}</span><span class="tt-val">${v}</span></div>`).join('')}
    <div style="margin-top:5px;font-size:9px;color:var(--muted)">Click to open in Dashboard</div>`;

  // Position near cursor but keep on screen
  const x = Math.min(evt.clientX + 14, window.innerWidth - 295);
  const y = Math.min(evt.clientY + 14, window.innerHeight - 220);
  tip.style.left = x + 'px';
  tip.style.top  = y + 'px';
  tip.style.display = 'block';
}
function _hmHideTip() {
  if (_hmTipEl) _hmTipEl.style.display = 'none';
}

// ── Heatmap view toggle ──────────────────────────────────────────────────────
let _hmData = [], _hmMode = '';
function hmSetView(view) {
  document.getElementById('hm-grid-wrap').style.display  = view==='grid'  ? '' : 'none';
  document.getElementById('hm-table-wrap').style.display = view==='table' ? '' : 'none';
  document.getElementById('hm-btn-grid').classList.toggle('active',  view==='grid');
  document.getElementById('hm-btn-table').classList.toggle('active', view==='table');
  if (view==='table' && _hmData.length) _renderHeatTable(_hmData, _hmMode);
}
window.hmSetView = hmSetView;

function _renderHeatTable(data, mode) {
  const fmtN = v => v!=null ? (+v).toLocaleString() : '—';
  const fmtPct = v => v!=null ? (v>0?'+':'')+v+'%' : '—';
  const cols = [
    {k:'symbol',    h:'Symbol'},
    {k:'spot',      h:'Spot',       fmt: v=>`$${v??'—'}`},
    {k:'put_oi',    h:'Put OI',     fmt: fmtN},
    {k:'call_oi',   h:'Call OI',    fmt: fmtN},
    {k:'put_vol',   h:'Put Vol',    fmt: fmtN},
    {k:'call_vol',  h:'Call Vol',   fmt: fmtN},
    mode==='pcr_change'
      ? {k:'pcr_chg',  h:'PCR Δ%',   fmt: fmtPct}
      : mode==='oi_change'
        ? {k:'oi_chg_pct', h:'OI Δ%', fmt: fmtPct}
        : {k:'vol_vs_avg', h:'Vol vs Avg%', fmt: fmtPct},
    mode==='pcr_change'
      ? {k:'pcr_now',  h:'PCR Now',  fmt: v=>v!=null?v.toFixed(3):'—'}
      : {k:'tot_oi',   h:'Total OI', fmt: fmtN},
    {k:'signal_score', h:'Score', fmt: v=>`<span style="font-weight:700;color:${v>=75?'var(--red)':v>=50?'#f59e0b':v>=25?'#3b82f6':'var(--muted)'}">${v}</span>`},
  ];

  let h = `<table class="data-tbl"><thead><tr>
    ${cols.map(c=>`<th>${c.h}</th>`).join('')}
    <th>Action</th>
  </tr></thead><tbody>`;

  data.forEach(r => {
    const gc = r.signal_score>=75?'row-a':r.signal_score>=50?'row-b':'';
    h += `<tr class="${gc}">
      ${cols.map(c=>{const v=r[c.k];return `<td>${c.fmt?c.fmt(v):(v??'—')}</td>`;}).join('')}
      <td><button class="btn btn-ghost" style="padding:1px 7px;font-size:10px"
        onclick="_hmTileClick('${r.symbol}')">Dashboard →</button></td>
    </tr>`;
  });
  document.getElementById('hm-table').innerHTML = h + '</tbody></table>';
}



function _hmTileClick(symbol) {
  const si=document.getElementById('symbol-input');
  if(si){si.value=symbol;si.dispatchEvent(new Event('change'));}
  _setActiveTab('dashboard');
}


// SCANNER TAB  — with expiry filter (future only)

let _sd=[], _sc=[], _sCol=null, _sDir=-1;

// Populate the scanner expiry filter when symbol changes
async function _scannerLoadExpiries() {
  const sym = (document.getElementById('param_wall_sym').value||'SPY').toUpperCase();
  const d = await api(`/api/db_expirations?symbol=${sym}&future=true`).catch(()=>({expirations:[]}));
  const sel = document.getElementById('param_expiry');
  if (!sel) return;
  sel.innerHTML = '<option value="">All future expiries</option>';
  (d.expirations||[]).forEach(e=>{const o=document.createElement('option');o.value=e;o.textContent=e;sel.appendChild(o);});
}

// expose so onclick can call it
window._scannerLoadExpiries = _scannerLoadExpiries;



// OPPORTUNITY SCANNER  — 1:1+ R:R credit spreads, $5 wide, ≤30 DTE

let _oppData = [];

async function runOpportunityScanner() {
  const minDte = document.getElementById('opp_min_dte')?.value || 21;
  const maxDte = document.getElementById('opp_max_dte')?.value || 60;
  const wing   = document.getElementById('opp_wing')?.value   || 5;
  const statEl = document.getElementById('scanner-status');
  const resEl  = document.getElementById('opp-results');
  const tblEl  = document.getElementById('opp-table');

  if (statEl) statEl.innerHTML = `<span style="color:var(--accent)">⏳ Scanning all symbols (max ${maxDte}DTE, $${wing} wide)… this may take 30-60s</span>`;
  if (resEl)  resEl.style.display = 'none';
  if (tblEl)  tblEl.innerHTML = '';
  document.getElementById('scanner-results').innerHTML = '';

  try {
    const sectorF = document.getElementById('scanner-sector-filter')?.value || '';
    const d = await api(`/api/scanner/opportunities?min_dte=${minDte}&max_dte=${maxDte}&wing=${wing}&sector=${sectorF}`);
    _oppData = d.opportunities || [];
    const sum = d.summary || {};

    const earned  = (sum.skipped_earnings||[]).length;
    const nooi    = (sum.skipped_no_oi||[]).length;
    const found   = sum.total_found || 0;
    const scanned = sum.symbols_scanned || 0;
    const rb      = sum.regime_breakdown || {};

    if (statEl) statEl.innerHTML = `
      <span style="color:var(--green)">✅ ${found} opportunities across ${scanned} symbols</span>
      ${sum.errors?.length ? `<span style="color:var(--muted);margin-left:12px">| ${sum.errors.length} errors</span>` : ''}`;

    // Regime chips — use detail_breakdown from v5
    const det     = sum.detail_breakdown || {};
    const chipEl  = document.getElementById('opp-regime-chips');
    if (chipEl) chipEl.innerHTML = [
      ['📈 Uptrend',      det.UPTREND_setups||0,    '#22c55e'],
      ['📉 Downtrend',    det.DOWNTREND_setups||0,  '#ef4444'],
      ['🔄 Oversold',     det.OVERSOLD_setups||0,   '#4ade80'],
      ['🔄 Overbought',   det.OVERBOUGHT_setups||0, '#f59e0b'],
    ].map(([l,n,c])=>
      `<span style="background:${c}20;border:1px solid ${c}44;color:${c};padding:2px 10px;border-radius:4px;font-size:10px;font-weight:700">${l}: ${n}</span>`
    ).join('');

    if (resEl) resEl.style.display = '';
    _renderOppTable(_oppData);
  } catch(e) {
    if (statEl) statEl.innerHTML = `<span style="color:var(--red)">❌ ${e.message}</span>`;
  }
}
window.runOpportunityScanner = runOpportunityScanner;

// ── Sortable table state ─────────────────────────────────────────────────
let _oppSortKey = 'quality', _oppSortAsc = true;

function _oppSort(key) {
  if (_oppSortKey === key) { _oppSortAsc = !_oppSortAsc; }
  else { _oppSortKey = key; _oppSortAsc = key === 'quality' || key === 'symbol'; }
  // Update indicators
  document.querySelectorAll('[id^="opp-sort-ind-"]').forEach(el => el.textContent='');
  const ind = document.getElementById(`opp-sort-ind-${key}`);
  if (ind) ind.textContent = _oppSortAsc ? '▲' : '▼';
  filterOpportunities();
}
window._oppSort = _oppSort;

function filterOpportunities() {
  const regime = document.getElementById('opp-filter-regime')?.value || '';
  const bias   = document.getElementById('opp-filter-bias')?.value   || '';
  const sortBy = document.getElementById('opp-sort')?.value          || 'rr';

  const strategy = document.getElementById('opp-filter-strategy')?.value || '';
  let data = [..._oppData];
  if (regime)   data = data.filter(r => r.regime   === regime);
  if (strategy) data = data.filter(r => r.strategy === strategy);
  if (bias)     data = data.filter(r => r.bias     === bias);

  const qo = {'A':0,'B':1,'C':2};
  const sk = _oppSortKey || sortBy || 'quality';
  const asc = _oppSortAsc;
  data.sort((a,b) => {
    let va, vb;
    if (sk==='quality')  { va=qo[a.quality]||3; vb=qo[b.quality]||3; }
    else if (sk==='earn_days') {
      // 999 = unknown earnings → sort last regardless of direction
      va = a.earn_days>=999 ? (asc?99999:-99999) : (a.earn_days||999);
      vb = b.earn_days>=999 ? (asc?99999:-99999) : (b.earn_days||999);
    }
    else if (sk==='symbol'||sk==='regime'||sk==='bias'||sk==='expiry'||sk==='strategy'||sk==='earn_date')
                         { va=(a[sk]||'').toLowerCase(); vb=(b[sk]||'').toLowerCase(); return asc?(va<vb?-1:va>vb?1:0):(va>vb?-1:va<vb?1:0); }
    else                 { va=parseFloat(a[sk])||0; vb=parseFloat(b[sk])||0; }
    return asc ? va-vb : vb-va;
  });
  _renderOppTable(data);
}
window.filterOpportunities = filterOpportunities;

function _oppRegimeStyle(regime) {
  const map = {
    TRENDING:       {icon:'📈', c:'#22c55e', bg:'#22c55e18', label:'TRENDING'},
    MEAN_REVERSION: {icon:'🔄', c:'#f59e0b', bg:'#f59e0b18', label:'MEAN REV'},
  };
  return map[regime] || {icon:'◈', c:'#64748b', bg:'#64748b18', label:regime};
}


// ── Resizable table columns ────────────────────────────────────────────────
function _makeTableResizable(tableEl) {
  if (!tableEl) return;
  const ths = tableEl.querySelectorAll('thead th');
  ths.forEach(th => {
    // Remove existing handle
    const old = th.querySelector('.col-resize-handle');
    if (old) old.remove();

    const handle = document.createElement('div');
    handle.className = 'col-resize-handle';
    th.appendChild(handle);

    let startX, startW;
    handle.addEventListener('mousedown', e => {
      e.preventDefault();
      startX = e.clientX;
      startW = th.offsetWidth;
      handle.classList.add('dragging');
      const onMove = ev => {
        const w = Math.max(40, startW + ev.clientX - startX);
        th.style.width = w + 'px';
        th.style.minWidth = w + 'px';
      };
      const onUp = () => {
        handle.classList.remove('dragging');
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
      };
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  });
}

function _renderOppTable(data) {
  const tblEl = document.getElementById('opp-table');
  if (!tblEl) return;
  if (!data.length) {
    tblEl.innerHTML='<p style="color:var(--muted);padding:16px;font-size:12px">No opportunities. Try increasing Max DTE or reducing Wing $.</p>';
    return;
  }
  const _th=(label,key,align='')=>
    `<th class="${align}" style="cursor:pointer;user-select:none;white-space:nowrap;padding:5px 7px"
      onclick="_oppSort('${key}')">${label} <span id="opp-sort-ind-${key}" style="color:var(--muted);font-size:9px"></span></th>`;

  let html=`<table class="data-tbl" style="font-size:11px;border-collapse:collapse;width:100%">
  <thead><tr>
    ${_th('Score','win_prob')}
    ${_th('Gr','quality')}
    ${_th('Symbol','symbol')}
    ${_th('Regime','regime')}
    ${_th('Bias','bias')}
    <th style="padding:5px 7px;min-width:200px">Signals &amp; Indicators</th>
    <th style="padding:5px 7px;min-width:160px">Legs</th>
    ${_th('Credit','net_credit','text-end')}
    ${_th('R:R','rr_val','text-end')}
    ${_th('PoP','pop','text-end')}
    ${_th('EV','ev','text-end')}
    ${_th('DTE','dte','text-end')}
    ${_th('%OTM','pct_otm','text-end')}
    ${_th('ADX','adx','text-end')}
    ${_th('RSI-EMA','rsi_diff','text-end')}
    ${_th('IVR','iv_rank','text-end')}
    ${_th('Cont%','continuation_pct','text-end')}
    ${_th('Earn','earn_days','text-end')}
  </tr></thead><tbody>`;

  data.forEach((r,idx) => {
    const rs=_oppRegimeStyle(r.regime);
    const bC=r.bias==='Bullish'?'#22c55e':r.bias==='Bearish'?'#ef4444':'#f59e0b';
    const rrC=(r.rr_val||0)>=1.5?'var(--green)':(r.rr_val||0)>=1.0?'#f59e0b':'var(--red)';
    const pC=(r.pop||0)>=70?'var(--green)':(r.pop||0)>=55?'#f59e0b':'var(--red)';

    // Win probability score bar
    const wp = r.win_prob || 0;
    const wpC = wp>=75?'#22c55e':wp>=58?'#4ade80':wp>=42?'#f59e0b':wp>=28?'#f97316':'#ef4444';
    const wpBar = wp>0
      ? `<div style="display:flex;align-items:center;gap:4px;white-space:nowrap">
          <div style="width:36px;height:7px;background:var(--border);border-radius:3px;overflow:hidden">
            <div style="width:${wp}%;height:100%;background:${wpC};border-radius:3px"></div>
          </div>
          <span style="color:${wpC};font-weight:800;font-size:11px">${wp}</span>
        </div>`
      : `<span style="color:var(--muted);font-size:9px">—</span>`;

    // Grade badge
    const gC=r.quality==='A'?'#22c55e':r.quality==='B'?'#f59e0b':r.quality==='C'?'#94a3b8':'#ef4444';
    const gradeBadge=`<span style="background:${gC}22;border:1px solid ${gC};color:${gC};
      font-size:11px;font-weight:800;padding:1px 6px;border-radius:3px">${r.quality||'?'}</span>`;

    // ── Signals column: pills + key indicator values inline ──
    // Use win_reasons if available (richer), fallback to reasons
    const sigList = r.win_reasons && r.win_reasons.length ? r.win_reasons : (r.reasons||[]);
    const topSigs = sigList.slice(0,4);
    const pillHtml = topSigs.map(s=>{
      const isPos=s.includes('✓')||s.includes('bullish')||s.includes('↑')||s.includes('oversold')||s.includes('above avg')||s.includes('strong')||s.includes('rich');
      const isNeg=s.includes('⚠')||s.includes('bearish')||s.includes('↓')||s.includes('thin')||s.includes('weak')||s.includes('risk');
      const bg=isPos?'rgba(34,197,94,.12)':isNeg?'rgba(239,68,68,.12)':'rgba(99,102,241,.10)';
      const bc=isPos?'rgba(34,197,94,.3)':isNeg?'rgba(239,68,68,.3)':'rgba(99,102,241,.25)';
      const tc=isPos?'#86efac':isNeg?'#fca5a5':'#a5b4fc';
      return `<span style="background:${bg};border:1px solid ${bc};color:${tc};
        padding:1px 6px;border-radius:3px;font-size:9px;white-space:nowrap;margin:1px 1px 2px;display:inline-block">${s}</span>`;
    }).join('');
    // Inline indicator summary below pills
    const diffC=(r.rsi_diff||0)>=15?'#ef4444':(r.rsi_diff||0)<=-15?'#22c55e':'#64748b';
    const bbC=(r.bb_pct||50)>75?'#ef4444':(r.bb_pct||50)<25?'#22c55e':'#94a3b8';
    const pdiStr=(r.pdi_delta!=null&&Math.abs(r.pdi_delta)>=3)?`PDI${r.pdi_delta<0?'↓':'↑'}${Math.abs(r.pdi_delta).toFixed(0)}`:'';
    const ndiStr=(r.ndi_delta!=null&&Math.abs(r.ndi_delta)>=3)?`NDI${r.ndi_delta<0?'↓':'↑'}${Math.abs(r.ndi_delta).toFixed(0)}`:'';
    const convPill = [pdiStr,ndiStr].filter(Boolean).join(' ');
    const indSummary = `<div style="margin-top:3px;font-size:9px;color:var(--muted)">
      BB:<span style="color:${bbC}">${r.bb_pct!=null?r.bb_pct+'%':'—'}</span>
      ${convPill?`<span style="color:#d8b4fe;margin-left:4px">${convPill}</span>`:''}
      <span style="color:${(r.rsi||0)>70?'#ef4444':(r.rsi||0)<30?'#22c55e':'#94a3b8'};margin-left:4px">RSI${r.rsi!=null?r.rsi:'—'}</span>
    </div>`;
    const signalCell = `<div>${pillHtml}</div>${indSummary}`;

    // Legs — wrap, full text
    const legsHtml = `<div style="font-family:monospace;color:#a855f7;font-size:11px;font-weight:700;
      white-space:normal;word-break:break-word;line-height:1.5">${r.legs||'—'}</div>`;

    const adxC=(r.adx||0)>=30?'#22c55e':(r.adx||0)>=20?'#f59e0b':'#64748b';
    const rowBg=idx%2===0?'':'background:rgba(255,255,255,.02)';

    html+=`<tr style="cursor:pointer;${rowBg};vertical-align:top" onclick="_oppRowExpand(${idx},this)">
      <td style="padding:5px 7px;vertical-align:middle">${wpBar}</td>
      <td style="padding:5px 4px;text-align:center;vertical-align:middle">${gradeBadge}</td>
      <td style="font-weight:800;color:var(--accent);font-size:13px;padding:5px 6px;vertical-align:middle;white-space:nowrap">${r.symbol}</td>
      <td style="padding:5px 6px;vertical-align:middle">
        <span style="background:${rs.bg};border:1px solid ${rs.c}44;color:${rs.c};
          padding:2px 6px;border-radius:3px;font-size:10px;font-weight:700;white-space:nowrap">
          ${rs.icon} ${rs.label}</span>
      </td>
      <td style="padding:5px 6px;vertical-align:middle">
        <span style="color:${bC};font-weight:700;font-size:12px">${r.bias}</span>
        ${r.strategy==='Iron Condor'?'<br><span style="font-size:9px;color:#a855f7">IC</span>':''}
      </td>
      <td style="padding:5px 6px;max-width:220px">${signalCell}</td>
      <td style="padding:5px 6px;max-width:180px">${legsHtml}</td>
      <td class="text-end" style="color:#22c55e;font-weight:700;font-size:12px;padding:5px 6px;white-space:nowrap;vertical-align:middle">$${(r.net_credit||0).toFixed(2)}</td>
      <td class="text-end" style="color:${rrC};font-weight:700;font-size:12px;padding:5px 4px;white-space:nowrap;vertical-align:middle">${r.rr||'—'}</td>
      <td class="text-end" style="color:${pC};font-weight:700;font-size:12px;padding:5px 4px;vertical-align:middle">${r.pop||0}%</td>
      <td class="text-end" style="font-size:11px;font-weight:700;padding:5px 4px;vertical-align:middle;color:${(r.ev||0)>0.2?'var(--green)':(r.ev||0)>0?'#f59e0b':'var(--red)'}">
        ${r.ev!=null?'$'+r.ev.toFixed(2):'—'}</td>
      <td class="text-end" style="font-size:11px;padding:5px 4px;vertical-align:middle">${r.dte}d</td>
      <td class="text-end" style="color:var(--muted);font-size:11px;padding:5px 4px;vertical-align:middle">${r.pct_otm!=null?r.pct_otm+'%':'—'}</td>
      <td class="text-end" style="color:${adxC};font-size:11px;padding:5px 4px;vertical-align:middle">${r.adx||'—'}</td>
      <td class="text-end" style="color:${diffC};font-weight:700;font-size:11px;padding:5px 4px;vertical-align:middle">
        ${r.rsi_diff!=null?(r.rsi_diff>0?'+':'')+r.rsi_diff:'—'}</td>
      <td class="text-end" style="color:${(r.iv_rank||0)>=70?'var(--red)':(r.iv_rank||0)>=50?'#f59e0b':'#3b82f6'};font-size:11px;padding:5px 4px;vertical-align:middle">
        ${r.iv_rank||'—'}</td>
      <td class="text-end" style="font-size:11px;padding:5px 4px;vertical-align:middle;font-weight:700;
          color:${(r.continuation_pct||0)>65?'var(--red)':(r.continuation_pct||0)>50?'#f59e0b':'#22c55e'}"
          title="${r.continuation_note||''}">
        ${r.continuation_pct!=null?r.continuation_pct+'%':'—'}</td>
      <td class="text-end" style="font-size:10px;white-space:nowrap;padding:5px 4px;vertical-align:middle">
        ${r.earn_days<r.dte&&r.earn_days<999
          ?`<span style="color:#ef4444;font-weight:700">⚠${r.earn_days}d</span>`
          :r.earn_days<14?`<span style="color:#f59e0b">${r.earn_days}d</span>`
          :r.earn_days<999?`<span style="color:var(--muted)">${r.earn_days}d</span>`
          :`<span style="color:var(--muted)">—</span>`}
      </td>
    </tr>
    <tr id="opp-expand-${idx}" style="display:none;background:rgba(0,0,0,.28)">
      <td colspan="18" style="padding:0">${_buildExpandPanel(r)}</td>
    </tr>`;
  });
  tblEl.innerHTML=html+'</tbody></table>';
  _makeTableResizable(tblEl.querySelector('.data-tbl'));
}

function _oppRowExpand(idx, rowEl) {
  const panel = document.getElementById(`opp-expand-${idx}`);
  if (!panel) return;
  const isOpen = panel.style.display !== 'none';
  panel.style.display = isOpen ? 'none' : '';
  rowEl.style.background = isOpen ? '' : 'rgba(99,102,241,.08)';
}

function _buildExpandPanel(r) {
  const wpC = (r.win_prob||0)>=75?'#22c55e':(r.win_prob||0)>=58?'#4ade80':(r.win_prob||0)>=42?'#f59e0b':'#ef4444';

  // Signal detail grid from backend
  const sd = r.signal_detail || {};
  const signals = sd.signals || [];
  const signalGrid = signals.map(s=>`
    <div style="display:flex;flex-direction:column;align-items:center;gap:2px;
        background:var(--surface);border:1px solid ${s.color}33;border-radius:5px;padding:6px 10px;min-width:70px">
      <div style="font-size:9px;color:var(--muted);letter-spacing:.06em">${s.label}</div>
      <div style="font-size:12px;font-weight:800;color:${s.color}">${s.value}</div>
      <div style="font-size:9px;color:var(--muted)">${s.note||''}</div>
    </div>`).join('');

  // Win reasons
  const reasons = (r.win_reasons||r.reasons||[]).slice(0,6);
  const reasonsHtml = reasons.map(reason=>{
    const isPos=reason.includes('✓')||reason.includes('above avg')||reason.includes('strong')||reason.includes('bull')||reason.includes('oversold');
    const isNeg=reason.includes('⚠')||reason.includes('weak')||reason.includes('bear')||reason.includes('thin')||reason.includes('overbought');
    const c=isPos?'#22c55e':isNeg?'#ef4444':'#f59e0b';
    const icon=isPos?'✓':isNeg?'✗':'•';
    return `<div style="font-size:11px;color:${c};padding:2px 0">
      <span style="margin-right:5px">${icon}</span>${reason}</div>`;
  }).join('');

  return `<div style="padding:12px 16px">
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start">

      <!-- Win probability + score breakdown -->
      <div style="min-width:200px">
        <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:8px;letter-spacing:.08em">WIN PROBABILITY</div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
          <div style="width:80px;height:10px;background:var(--border);border-radius:5px;overflow:hidden">
            <div style="width:${r.win_prob||0}%;height:100%;background:${wpC};border-radius:5px"></div>
          </div>
          <span style="font-size:22px;font-weight:900;color:${wpC}">${r.win_prob||0}</span>
          <span style="font-size:13px;color:${wpC};font-weight:700">/100</span>
        </div>
        <div style="font-size:10px;color:var(--muted);margin-bottom:8px">
          Grade <b style="color:${wpC}">${r.quality||'?'}</b> · ${r.regime_label||''} · ${r.bias}
        </div>
        <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:6px">SCORING FACTORS</div>
        ${reasonsHtml}
      </div>

      <!-- Signal indicator grid -->
      <div style="flex:1;min-width:300px">
        <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:8px;letter-spacing:.08em">INDICATOR BREAKDOWN</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px">${signalGrid}</div>
      </div>

      <!-- Trade details -->
      <div style="min-width:180px">
        <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:8px;letter-spacing:.08em">TRADE DETAIL</div>
        <div style="font-size:11px;color:var(--text);line-height:1.8">
          <div>📋 ${r.rationale||''}</div>
          <div style="margin-top:6px;color:#f59e0b">⊕ ${r.manage||''}</div>
          ${r.continuation_pct!=null?`<div style="margin-top:4px;color:var(--muted);font-size:10px">Continuation: ${r.continuation_pct}% — ${r.continuation_note||''}</div>`:''}
          ${r.earn_warn?`<div style="margin-top:4px;color:#ef4444;font-weight:700;font-size:10px">${r.earn_warn}</div>`:''}
        </div>
      </div>
    </div>
  </div>`;
}

function _oppRowClick(symbol) {
  const si = document.getElementById('symbol-input');
  if (si) { si.value = symbol; si.dispatchEvent(new Event('change')); }
  _setActiveTab('dashboard');
}

const SCOLS = {
  large_oi:[
    {k:'signal_score',h:'Score',  fmt:v=>fmt(v),  cls:v=>v>=75?'c-green':v<40?'c-red':'c-yellow'},
    {k:'grade',       h:'Grade',  fmt:v=>v?`<span class="badge badge-${v==='A'?'green':v==='B'?'yellow':'red'}">${v}</span>`:''},
    {k:'symbol',      h:'Symbol', cls:()=>'c-bold'},
    {k:'expiry',      h:'Expiry'},
    {k:'expiry_type', h:'Type',   fmt:v=>v?`<span class="badge badge-blue">${v}</span>`:''},
    {k:'dte',         h:'DTE'},
    {k:'type',        h:'P/C',    cls:v=>v==='C'?'c-blue':'c-red'},
    {k:'strike',      h:'Strike', fmt:v=>fmt(v),  cls:()=>'c-bold'},
    {k:'spot',        h:'Spot',   fmt:v=>fmt(v,2)},
    {k:'sr_label',    h:'S/R',    fmt:v=>v?`<span class="badge ${v.includes('Support')||v.includes('Floor')?'badge-green':'badge-red'}">${v}</span>`:''},
    {k:'is_wall',     h:'Wall',   fmt:v=>v?'⭐':''},
    {k:'direction',   h:'Dir'},
    {k:'oi_prev',     h:'OI Prev',fmt:v=>fmt(v)},
    {k:'oi_now',      h:'OI Now', fmt:v=>fmt(v)},
    {k:'oi_change',   h:'OI Δ',   fmt:v=>fmt(v), cls:v=>clr(v)},
    {k:'pct_change',  h:'Δ%',     fmt:v=>v!=null?v.toFixed(1)+'%':'—', cls:v=>clr(v)},
    {k:'vol_confirmed',h:'Vol✔',  fmt:v=>v?'✔':''},
  ],
  pcr_change:[
    {k:'signal_score',h:'Score',  fmt:v=>fmt(v), cls:v=>v>=75?'c-green':v<40?'c-red':'c-yellow'},
    {k:'symbol',      h:'Symbol', cls:()=>'c-bold'},
    {k:'expiry',      h:'Expiry'},
    {k:'expiry_type', h:'Type',   fmt:v=>v?`<span class="badge badge-blue">${v}</span>`:''},
    {k:'dte',         h:'DTE'},
    {k:'spot',        h:'Spot',   fmt:v=>fmt(v,2)},
    {k:'pcr_prev',    h:'PCR Prev',fmt:v=>v!=null?v.toFixed(3):'—'},
    {k:'pcr_now',     h:'PCR Now', fmt:v=>v!=null?v.toFixed(3):'—', cls:v=>v>1.2?'c-red':v!=null&&v<0.8?'c-green':''},
    {k:'pct_change',  h:'PCR Δ%',  fmt:v=>v!=null?v.toFixed(1)+'%':'—', cls:v=>clr(v)},
    {k:'direction',   h:'Dir'},
    {k:'regime',      h:'Sentiment',fmt:v=>v?`<span class="badge ${v.includes('Fear')?'badge-red':v.includes('Very')?'badge-green':'badge-yellow'}">${v}</span>`:'',
      tooltip:'PCR>1.3=Fearful=sell puts. PCR<0.6=Complacent=be selective'},
    {k:'divergence',  h:'Divergence',fmt:v=>v?`<span class="c-yellow">${v}</span>`:'',
      tooltip:'Seller view: PCR↑+Price↑ → hedge against rally → sell calls/IC'},
    {k:'now_puts',    h:'Put OI',  fmt:v=>fmt(v)},
    {k:'now_calls',   h:'Call OI', fmt:v=>fmt(v)},
  ],
  weekly_pin:[
    {k:'signal_score',   h:'Score',    fmt:v=>fmt(v), cls:v=>v>=75?'c-green':v<40?'c-red':'c-yellow'},
    {k:'scan_type',      h:'Type',     fmt:v=>v?`<span class="badge badge-blue">${v}</span>`:''},
    {k:'symbol',         h:'Symbol',   cls:()=>'c-bold'},
    {k:'expiry',         h:'Expiry'},
    {k:'dte',            h:'DTE'},
    {k:'spot',           h:'Spot',     fmt:v=>fmt(v,2)},
    {k:'pin_strike',     h:'Pin',      fmt:v=>fmt(v), cls:()=>'c-bold'},
    {k:'pin_dist_$',     h:'Dist $',   fmt:v=>fmt(v,2)},
    {k:'pin_dist_%',     h:'Dist %',   fmt:v=>v!=null?v.toFixed(2)+'%':'—'},
    {k:'total_pin_oi',   h:'Pin OI',   fmt:v=>fmt(v)},
    {k:'window_pcr',     h:'PCR',      fmt:v=>v!=null?v.toFixed(3):'—'},
    {k:'inside_exp_move',h:'In 1SD?',  fmt:v=>v?'✔':'✗', cls:v=>v?'c-green':'c-muted'},
    {k:'exp_move_1sd',   h:'1SD Move', fmt:v=>v!=null?'$'+v.toFixed(2):'—'},
    {k:'trade_idea',     h:'Trade',    cls:()=>'c-muted'},
  ],
  trend_exhaustion:[
    {k:'score',          h:'Score',    fmt:v=>fmt(v), cls:v=>v>=75?'c-green':v<45?'c-red':'c-yellow'},
    {k:'symbol',         h:'Symbol',   cls:()=>'c-bold'},
    {k:'direction',      h:'Setup'},
    {k:'price',          h:'Price',    fmt:v=>fmt(v,2)},
    {k:'rsi',            h:'RSI',      fmt:v=>fmt(v,1)},
    {k:'atr_pct',        h:'ATR%',     fmt:v=>v!=null?v.toFixed(2)+'%':'—'},
    {k:'trend_age',      h:'TrendAge'},
    {k:'stretch_atr',    h:'Stretch',  fmt:v=>v!=null?v.toFixed(2)+'x':'—'},
    {k:'climax_vol',     h:'Vol x',    fmt:v=>v!=null?v.toFixed(2)+'x':'—'},
    {k:'edge_score',     h:'Edge',     fmt:v=>fmt(v,0)},
    {k:'detail',         h:'Why',      cls:()=>'c-muted'},
  ],
};

async function runScanner(type) {
  const statEl=document.getElementById('scanner-status'),resEl=document.getElementById('scanner-results');
  statEl.textContent=`⏳ Running ${type}…`; resEl.innerHTML='';
  const p=id=>document.getElementById(id)?.value||'';
  // expiry filter — applied client-side after results come back
  const filterExpiry = p('param_expiry');
  let url;
  if      (type==='large_oi')   url=`/api/scanner/large_oi?min_abs=${p('param_min_abs')}&min_pct=${p('param_min_pct')}&max_dte=${p('param_max_dte')}`;
  else if (type==='pcr_change') url=`/api/scanner/pcr_change?threshold=${p('param_pcr_thr')}&max_dte=${p('param_max_dte')}`;
  else if (type==='weekly_pin') url=`/api/scanner/weekly_pin?monthly=true`;
  else if (type==='trend_exhaustion') url=`/api/scanner/trend_exhaustion`;
  else { statEl.textContent='Unknown scanner'; return; }
  try {
    let data=await api(url);
    if (type === 'trend_exhaustion' && data && Array.isArray(data.results)) data = data.results;
    // apply expiry filter if set
    if (filterExpiry && Array.isArray(data)) {
      data=data.filter(r=>(r.expiry||r.expiration)===filterExpiry);
    }
    // always filter out past expiries
    if (Array.isArray(data)) data=data.filter(r=>{const e=r.expiry||r.expiration||''; return !e||e>=_TODAY;});
    _sd=Array.isArray(data)?data:[]; _sc=SCOLS[type]||[]; _sCol=null;
    statEl.innerHTML=`✅ <b>${data.length}</b> result(s)&nbsp;<span class="c-muted" style="font-size:10px">Click headers to sort · type to filter</span>`;
    _renderScanTbl();
  } catch(e){statEl.textContent='❌ '+e.message;}
}
window.runScanner=runScanner;

function _renderScanTbl() {
  const el=document.getElementById('scanner-results');
  if(!_sd.length){el.innerHTML='<p style="padding:16px;color:var(--muted)">No results — need ≥2 days of scheduler data, or no match for current filters.</p>';return;}
  el.innerHTML=`<div class="tbl-wrap"><table class="data-tbl"><thead>
    <tr>${_sc.map((c,i)=>`<th onclick="_sSort(${i})" title="${c.tooltip||''}">${c.h}</th>`).join('')}</tr>
    <tr class="filter-row">${_sc.map(()=>`<td><input type="text" onkeyup="_sFilter()" placeholder="…"/></td>`).join('')}</tr>
  </thead><tbody id="scan-tbody">${_sRows(_sd)}</tbody></table></div>`;
}
function _sRows(data){return data.map(r=>{const rc=r.grade==='A'?'row-a':r.grade==='B'?'row-b':r.grade==='C'?'row-c':'';return `<tr class="${rc}">${_sc.map(c=>{const v=r[c.k];const disp=c.fmt?c.fmt(v):(v==null?'—':String(v));const cc=c.cls?c.cls(v):'';return `<td class="${cc}">${disp}</td>`;}).join('')}</tr>`;}).join('');}
function _sSort(i){const k=_sc[i].k;if(_sCol===k)_sDir*=-1;else{_sCol=k;_sDir=-1;}_sd.sort((a,b)=>{const va=a[k],vb=b[k];if(va==null)return 1;if(vb==null)return-1;return(va<vb?-1:va>vb?1:0)*_sDir;});document.getElementById('scan-tbody').innerHTML=_sRows(_sd);}
function _sFilter(){const ins=Array.from(document.querySelectorAll('.filter-row input')).map(i=>i.value.toLowerCase());document.querySelectorAll('#scan-tbody tr').forEach(tr=>{const cells=tr.querySelectorAll('td');tr.style.display=ins.every((f,i)=>!f||(cells[i]&&cells[i].textContent.toLowerCase().includes(f)))?'':'none';});}
window._sSort=_sSort; window._sFilter=_sFilter;
function openBacktest(scanner){
  try {
    const btn = document.querySelector('[data-tab="backtest"]');
    btn?.click();
    setTimeout(()=>{
      const sel = document.getElementById('mb-scanner');
      if (sel) { sel.value = scanner; sel.dispatchEvent(new Event('change')); }
    }, 100);
  } catch(e) { console.warn(e); }
}
window.openBacktest=openBacktest;

async function showWallMap() {
  const sym=(document.getElementById('param_wall_sym').value||'SPY').toUpperCase();
  const maxDTE=document.getElementById('param_max_dte').value;
  const statEl=document.getElementById('scanner-status'),resEl=document.getElementById('scanner-results');
  statEl.textContent=`⏳ Loading OI Wall Map for ${sym}…`; resEl.innerHTML='';
  const d=await api(`/api/scanner/oi_wall_map?symbol=${sym}&max_dte=${maxDTE}`).catch(e=>({error:e.message}));
  if(d.error){statEl.textContent='❌ '+d.error;return;}
  statEl.textContent=`✅ OI Wall Map — ${sym} | Spot: ${d.spot?'$'+d.spot:'—'} | ${d.snapshot}`;
  const pinch=d.pinch_zone?`<div style="background:rgba(99,102,241,.12);border:1px solid var(--accent2);border-radius:6px;padding:10px 14px;margin-bottom:12px">
    <b style="color:var(--accent2)">🎯 IC Sweet Spot</b> &nbsp;Put wall <b>${d.pinch_zone.put_strike}</b> ↔ Call wall <b>${d.pinch_zone.call_strike}</b>
    &nbsp;Width <b>${d.pinch_zone.width} pts</b> &nbsp;Combined OI <b>${d.pinch_zone.combined_oi.toLocaleString()}</b></div>`:'';
  resEl.innerHTML=`${pinch}<div class="row" style="gap:12px">
    <div class="col-half card" style="padding:12px"><div class="card-title">🟢 Put Walls (Support)</div><div id="wm-puts-chart" style="height:280px"></div></div>
    <div class="col-half card" style="padding:12px"><div class="card-title">🔴 Call Walls (Resistance)</div><div id="wm-calls-chart" style="height:280px"></div></div>
  </div><div style="font-size:11px;color:var(--muted);margin-top:8px">🏋️ Gamma Wall: <b style="color:var(--text)">${d.gamma_wall??'—'}</b></div>`;
  const barchart=(id,walls,cs)=>{
    if(!walls?.length) return;
    const w=[...walls].reverse();
    Plotly.newPlot(id,[{type:'bar',orientation:'h',y:w.map(x=>`${x.strike}`),x:w.map(x=>x.total_oi),
      marker:{color:w.map(x=>x.total_oi),colorscale:cs,showscale:false},
      text:w.map(x=>x.total_oi.toLocaleString()),textposition:'outside'}],
      {...PL,xaxis:{...PL.xaxis,title:'Total OI'},showlegend:false},PC);
  };
  barchart('wm-puts-chart', d.put_walls, [[0,'rgba(34,197,94,.25)'],[1,'rgba(34,197,94,1)']]);
  barchart('wm-calls-chart',d.call_walls,[[0,'rgba(239,68,68,.25)'],[1,'rgba(239,68,68,1)']]);
}
window.showWallMap=showWallMap;


// STRATEGY TAB  — future expiries from DB, real spot from yfinance

async function initStrategyTab() {
  const symEl=document.getElementById('strat-symbol'); if(!symEl) return;
  // Populate symbol dropdown from DB
  try {
    const d = await api('/strategy/symbols').catch(()=>({}));
    const syms = d.symbols || (window._bootData?.symbols) || ['SPY'];
    symEl.innerHTML = syms.map(s=>`<option value="${s}"${s==='SPY'?'selected':''}>${s}</option>`).join('');
  } catch { symEl.innerHTML='<option value="SPY">SPY</option>'; }
  await _stratLoadExpiry('SPY');
  symEl.addEventListener('change', async()=>{
    await _stratLoadExpiry(symEl.value||'SPY');
  });
}
async function _stratLoadExpiry(sym) {
  const d = await api(`/strategy/future_expirations?symbol=${sym}`).catch(()=>({}));
  const exps = d.expirations || [];
  const sel = document.getElementById('strat-expiry');
  if (!sel) return;
  sel.innerHTML = exps.length
    ? exps.map(e=>`<option value="${e}">${e}</option>`).join('')
    : '<option value="">No expiries in DB</option>';
}

async function runStrategy() {
  let sym      = (document.getElementById('strat-symbol-input')?.value||'').trim().toUpperCase();
  if (!sym) sym = 'SPY'; // default to SPY if blank
  const expiry = document.getElementById('strat-expiry')?.value||'';
  const sector = document.getElementById('strat-sector')?.value||'';
  const minDte = document.getElementById('strat-min-dte')?.value||7;
  const maxDte = document.getElementById('strat-max-dte')?.value||60;
  const stype  = document.getElementById('strat-type')?.value||'';
  const statEl = document.getElementById('strat-status');
  const resEl  = document.getElementById('strat-results');
  // expiry is optional — backend auto-picks from DTE range if blank
  statEl.textContent='⏳ Analyzing…'; resEl.innerHTML='';

  try {
    // Scan modes (across all symbols in DB)
    if(stype==='__scan_condors'){
      const data=await api(`/strategy/scan_condors?expiry=${expiry}`);
      _renderScanTable(data, resEl, statEl, 'condors'); return;
    }
    if(stype==='__scan_bull_put'||stype==='__scan_bear_call'){
      const want=stype==='__scan_bull_put'?'Bull Put Spread':'Bear Call Spread';
      const data=(await api(`/strategy/scan_verticals?expiry=${expiry}`)).filter(r=>r.strategy===want);
      _renderScanTable(data, resEl, statEl, stype==='__scan_bull_put'?'bull_put':'bear_call'); return;
    }

    // Full analysis for selected symbol
    const url = stype
      ? `/strategy/analyze?symbol=${sym}&expiry=${expiry}&type=${stype}&sector=${sector}&min_dte=${minDte}&max_dte=${maxDte}`
      : `/strategy/analyze?symbol=${sym}&expiry=${expiry}&sector=${sector}&min_dte=${minDte}&max_dte=${maxDte}`;
    
    // Fetch strategies and live prices IN PARALLEL
    statEl.innerHTML = '<span style="color:var(--muted)">⏳ Fetching strategies + live prices…</span>';
    const [d, priceResp] = await Promise.all([
      api(url),
      expiry
        ? api(`/strategy/live_prices?symbol=${sym}&expiry=${expiry}`).catch(e => ({error: e.message}))
        : Promise.resolve({error: 'no expiry yet', chain: {}})
    ]);

    if(d.error){statEl.innerHTML=`<span style="color:var(--red)">❌ ${d.error}</span>`;return;}

    // Populate expiry dropdown with what backend picked (if it was auto-selected)
    const expiryEl = document.getElementById('strat-expiry');
    if (expiryEl && d.expiry && !expiryEl.value) {
      const opt = document.createElement('option');
      opt.value = opt.textContent = d.expiry;
      opt.selected = true;
      expiryEl.appendChild(opt);
    }

    // Merge real prices into strategies BEFORE rendering
    const chain = priceResp?.chain || {};
    const priceOk = !priceResp?.error && Object.keys(chain).length > 0;
    
    if (priceOk) {
      (d.strategies||[]).forEach(s => _mergeLivePrices(s, chain));
      const actualExp = priceResp.actual_expiry || expiry;
      const expNote = actualExp !== expiry ? ` (prices from ${actualExp})` : '';
      statEl.innerHTML = `<span style="color:var(--green)">✅ ${sym} ${expiry} | Spot $${d.spot} | ${d.strategies?.length||0} strategies | <span style="color:var(--green)">● LIVE PRICES${expNote}</span></span>`;
    } else {
      statEl.innerHTML = `<span style="color:var(--green)">✅ ${sym} ${expiry} | Spot $${d.spot} | ${d.strategies?.length||0} strategies</span> <span style="color:#f59e0b;font-size:10px">⚠ ${priceResp?.error || 'estimated prices'}</span>`;
    }

    _renderFullAnalysis(d, resEl);

  } catch(e) {
    statEl.innerHTML=`<span style="color:var(--red)">❌ ${e.message}</span>`;
  }
}

// ── Merge live prices into strategy before rendering ─────────────────────────
function _mergeLivePrices(s, chain) {
  if (!chain || !s.legs) return;

  // Parse legs: "Sell $735.0C  /  Buy $741.0C" etc.
  const legMatches = [...(s.legs||'').matchAll(/(Sell|Buy)\s+\$(\d+(?:\.\d+)?)(C|P)/gi)];
  if (!legMatches.length) return;

  let netCredit = 0;
  let allValid  = true;
  const legPrices = [];

  for (const m of legMatches) {
    const action    = m[1];
    const strike    = parseFloat(m[2]);
    const strikeInt = Math.round(strike);
    const type      = m[3].toUpperCase() === 'C' ? 'call' : 'put';

    // Try every possible key format the backend might have stored
    const data = chain[`${type}_${strikeInt}`]
      || chain[`${type}_${strike}`]
      || chain[`${type}_${strikeInt}.0`]
      || chain[`${type}_${strike}.0`]
      || null;

    const mid = data?.mid ?? null;
    if (mid === null) allValid = false;

    const signed = mid !== null ? (action.toLowerCase() === 'sell' ? mid : -mid) : 0;
    netCredit += signed;

    legPrices.push({
      action, strike, type,
      bid:    data?.bid    ?? null,
      ask:    data?.ask    ?? null,
      mid,
      iv:     data?.iv     ?? null,
      signed: mid !== null ? Math.round(signed * 100) / 100 : null,
    });
  }

  netCredit = Math.round(netCredit * 100) / 100;

  // Width = distance between first two strikes
  const width = legMatches.length >= 2
    ? Math.abs(parseFloat(legMatches[0][2]) - parseFloat(legMatches[1][2]))
    : 0;

  const maxProfitDollar = Math.round(netCredit * 100 * 100) / 100;   // in dollars
  const maxLossDollar   = width > 0 ? Math.round((width - netCredit) * 100 * 100) / 100 : null;
  const rr = (width > 0 && netCredit > 0 && width > netCredit)
    ? (netCredit / (width - netCredit)).toFixed(2) + ':1'
    : s.rr;   // keep original if can't compute

  // Write results back into strategy object
  s.leg_prices           = legPrices;
  s.net_credit           = netCredit;
  s.real_prices          = allValid;
  s.price_source         = allValid ? 'yfinance live' : 'partial';
  s.spread_width         = width;
  s.max_profit_dollar    = maxProfitDollar;
  s.max_loss_dollar      = maxLossDollar;
  s.rr                   = rr;

  // Update display strings used by the card renderer
  const isCredit = netCredit > 0;
  s.est_credit   = `$${Math.abs(netCredit).toFixed(2)} ${isCredit ? 'credit' : 'debit'}`;
  s.max_gain     = maxProfitDollar   != null ? `$${Math.abs(maxProfitDollar).toFixed(0)}/contract`  : s.max_gain;
  s.max_loss     = maxLossDollar     != null ? `$${Math.abs(maxLossDollar).toFixed(0)}/contract`    : s.max_loss;
  s.manage       = `Close at 50% ${isCredit?'credit':'profit'} (~$${(Math.abs(netCredit)*0.5).toFixed(2)}). `
    + (legPrices.length >= 2
        ? `Stop if spot ${isCredit && legPrices[0].type==='put' ? 'closes below' : 'closes above'} $${legPrices[1].strike}.`
        : '');
}

// ── Live price patching ────────────────────────────────────────────────────
async function _patchLivePrices(symbol, expiry, strategies, statEl) {
  // Show loading indicator on cards
  const priceEls = document.querySelectorAll('[data-price-src]');
  // Don't block UI — fetch in background

  let chain = null;
  try {
    const resp = await api(`/strategy/live_prices?symbol=${symbol}&expiry=${expiry}`);
    if (resp.error) throw new Error(resp.error);
    chain = resp.chain || {};
    console.log(`[live_prices] ${symbol}/${expiry}: ${resp.count} strikes loaded`);
    if (statEl) statEl.innerHTML = statEl.innerHTML.replace(/⟳.*$/, '')
      + ` <span style="color:var(--green);font-size:10px">✓ Live prices loaded (${resp.count} strikes)</span>`;
  } catch (e) {
    console.warn('[live_prices] Could not fetch real prices:', e.message);
    document.querySelectorAll('.price-src-badge').forEach(el => {
      el.textContent = '● ESTIMATED (yfinance error)';
      el.title = e.message;
    });
    if (statEl) statEl.innerHTML = statEl.innerHTML.replace(/⟳.*$/, '') 
      + ` <span style="color:#f59e0b;font-size:10px" title="${e.message}">⚠ Using estimated prices</span>`;
    return;
  }

  // For each strategy card, compute real prices from chain
  strategies.forEach((s, idx) => {
    try {
      const card = document.getElementById(`strat-card-${idx}`);
      if (!card || !chain) return;

      // Parse legs
      const legMatches = [...(s.legs||'').matchAll(/(Sell|Buy)\s+\$(\d+(?:\.\d+)?)(C|P)/gi)];
      if (!legMatches.length) return;

      let netCredit = 0;
      let allValid = true;
      const legRows = [];

      for (const m of legMatches) {
        const action = m[1], strike = parseFloat(m[2]);
        const type   = m[3].toUpperCase() === 'C' ? 'call' : 'put';
        const key    = `${type}_${strike}`;

        // Try exact strike, then ±0.5, ±1.0
        // Try multiple key formats: JS parseFloat of "695.0" gives 695 (integer)
        // but Python may store as "put_695.0" or "put_695"
        const strikeInt = Math.round(strike);
        let data = chain[key]                          // e.g. "put_695"
          || chain[`${type}_${strike}.0`]              // "put_695.0"  
          || chain[`${type}_${strikeInt}`]             // "put_695" (rounded)
          || chain[`${type}_${strikeInt}.0`]           // "put_695.0"
          || chain[`${type}_${strike+0.5}`] || chain[`${type}_${strike-0.5}`]
          || chain[`${type}_${strike+1}`]   || chain[`${type}_${strike-1}`]
          || null;

        const mid = data?.mid ?? null;
        if (mid === null) { allValid = false; }

        const signed = mid !== null ? (action.toLowerCase()==='sell' ? mid : -mid) : 0;
        netCredit += signed;

        legRows.push({
          action, strike, type, key,
          bid:    data?.bid ?? null,
          ask:    data?.ask ?? null,
          mid:    mid,
          iv:     data?.iv ?? null,
          signed: mid !== null ? round2(signed) : null,
        });
      }

      netCredit = round2(netCredit);
      const width = Math.abs(parseFloat(legMatches[0][2]) - parseFloat(legMatches[1][2]));
      const maxP  = round2(netCredit * 100);
      const maxL  = width > 0 ? round2((width - netCredit) * 100) : null;
      const rr    = (width > 0 && netCredit > 0 && width > netCredit)
                    ? (netCredit / (width - netCredit)).toFixed(2) + ':1' : '—';

      if (!allValid && netCredit === 0) return; // nothing useful

      // Patch the card's price section
      const creditEl = card.querySelector('.live-credit');
      const gainEl   = card.querySelector('.live-gain');
      const lossEl   = card.querySelector('.live-loss');
      const rrEl     = card.querySelector('.live-rr');
      const srcBadge = card.querySelector('.price-src-badge');
      const legTbl   = card.querySelector('.live-leg-table');

      if (creditEl) creditEl.textContent = `$${Math.abs(netCredit).toFixed(2)} ${netCredit >= 0 ? 'credit' : 'debit'}`;
      if (gainEl)   gainEl.textContent   = maxP   ? `$${maxP.toFixed(0)}/contract`        : '—';
      if (lossEl)   lossEl.textContent   = maxL   ? `$${Math.abs(maxL).toFixed(0)}/contract` : '—';
      if (rrEl)     rrEl.textContent     = rr;
      if (srcBadge) {
        srcBadge.textContent = allValid ? '● LIVE PRICES' : '● PARTIAL LIVE';
        srcBadge.style.color = allValid ? 'var(--green)' : '#f59e0b';
      }

      // Patch leg table
      if (legTbl) {
        legRows.forEach((lr, i) => {
          const row = legTbl.querySelectorAll('tr[data-leg]')[i];
          if (!row) return;
          const cells = row.querySelectorAll('td');
          if (cells[1]) cells[1].textContent = lr.bid != null ? '$'+lr.bid : '—';
          if (cells[2]) cells[2].textContent = lr.ask != null ? '$'+lr.ask : '—';
          if (cells[3]) { cells[3].textContent = lr.mid != null ? '$'+lr.mid : '—'; cells[3].style.fontWeight='700'; }
          if (cells[4]) cells[4].textContent = lr.iv  != null ? (lr.iv*100).toFixed(1)+'%' : '—';
          if (cells[5]) {
            cells[5].textContent = lr.signed != null ? (lr.signed >= 0 ? '+' : '') + lr.signed : '—';
            cells[5].style.color = lr.signed >= 0 ? 'var(--green)' : 'var(--red)';
          }
        });
        // Net row
        const netRow = legTbl.querySelector('tr[data-net]');
        if (netRow) {
          const netCell = netRow.querySelector('td:last-child');
          if (netCell) {
            netCell.textContent = (netCredit >= 0 ? '+' : '') + netCredit;
            netCell.style.color = netCredit >= 0 ? 'var(--green)' : 'var(--red)';
          }
        }
      }

    } catch(e) {
      console.warn(`[patchLivePrices] card ${idx}:`, e);
    }
  });
}

function round2(v) { return Math.round(v * 100) / 100; }

window.runStrategy=runStrategy;

// ── Full analysis renderer ─────────────────────────────────────────────────
function _renderFullAnalysis(d, resEl) {
  const ta  = d.ta||{};
  const ois = d.oi_summary||{};
  const oich = d.oi_change_history||[];
  const pcrh = d.pcr_history||[];

  const N=(v,dec=2)=>v==null?'—':typeof v==='number'?v.toFixed(dec):String(v);
  const momC={OVERBOUGHT:'var(--red)',OVERSOLD:'var(--green)',ELEVATED:'#f59e0b',DEPRESSED:'#3b82f6',NEUTRAL:'var(--muted)'};
  const trendC={UPTREND:'var(--green)',DOWNTREND:'var(--red)',SIDEWAYS:'var(--yellow)',MILD_UP:'#4ade80',MILD_DOWN:'#f87171'};

  // ── TA Snapshot ──
  const taHtml = `
  <div class="card" style="padding:12px;margin-bottom:12px">
    <div class="card-title">📊 Technical Snapshot — ${d.symbol}</div>
    <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:10px">
      ${[
        ['PRICE',    `$${N(ta.price)}`, '#e2e8f0'],
        ['DAY CHG',  `${(ta.chg_pct>=0?'+':'')}${N(ta.chg_pct)}%`, ta.chg_pct>=0?'var(--green)':'var(--red)'],
        ['RSI-14',   N(ta.rsi14,1),     momC[ta.momentum]||'var(--muted)'],
        ['EMA90(RSI)',N(ta.ema90_rsi,1),'var(--muted)'],
        ['RSI−EMA',  N(ta.rsi_ema_diff,1), Math.abs(ta.rsi_ema_diff)>=20?'var(--red)':Math.abs(ta.rsi_ema_diff)>=10?'#f59e0b':'var(--muted)'],
        ['MOMENTUM', ta.momentum||'—',  momC[ta.momentum]||'var(--muted)'],
        ['TREND',    ta.trend||'—',     trendC[ta.trend]||'var(--muted)'],
        ['MACD',     ta.macd_signal||'—', ta.macd_signal==='BULLISH'?'var(--green)':ta.macd_signal==='BEARISH'?'var(--red)':'var(--muted)'],
        ['IV RANK',  `${ta.iv_rank}/100`, ta.iv_rank>=70?'var(--red)':ta.iv_rank>=50?'#f59e0b':'#3b82f6'],
        ['BB%B',     `${N(ta.bb_pct,0)}%`, parseFloat(ta.bb_pct)>80?'var(--red)':parseFloat(ta.bb_pct)<20?'var(--green)':'#f59e0b'],
        ['ATR-14',   `$${N(ta.atr)}`,  '#94a3b8'],
        ['VOL RATIO',`${N(ta.vol_ratio,1)}×`, ta.vol_ratio>=1.5?'var(--green)':ta.vol_ratio<0.6?'var(--red)':'var(--muted)'],
      ].map(([l,v,c])=>`<div style="background:var(--surface);border:1px solid ${c}44;border-top:2px solid ${c};border-radius:5px;padding:5px 9px;min-width:80px">
        <div style="font-size:8px;color:var(--muted);letter-spacing:.1em;margin-bottom:2px">${l}</div>
        <div style="font-size:12px;font-weight:700;color:${c}">${v}</div>
      </div>`).join('')}
    </div>
    ${Math.abs(ta.rsi_ema_diff||0)>=20?`
    <div style="background:${ta.rsi_ema_diff>0?'rgba(239,68,68,.15)':'rgba(34,197,94,.15)'};border:1px solid ${ta.rsi_ema_diff>0?'var(--red)':'var(--green)'};border-radius:5px;padding:7px 11px;margin-bottom:8px;font-size:12px;font-weight:700;color:${ta.rsi_ema_diff>0?'var(--red)':'var(--green)'}">
      ${ta.rsi_ema_diff>0?'⚠ OVERBOUGHT':'◈ OVERSOLD'}: RSI14(${ta.rsi14}) − EMA90(RSI)(${ta.ema90_rsi}) = ${ta.rsi_ema_diff} — ±20 threshold triggered
    </div>`:''}
    ${(ta.pa_signals||[]).length?`<div style="font-size:11px;color:var(--muted)">${ta.pa_signals.map(s=>`📌 ${s}`).join('  |  ')}</div>`:''}
  </div>`;

  // ── OI Analysis ──
  const oiHtml = `
  <div class="card" style="padding:12px;margin-bottom:12px">
    <div class="card-title">🏋️ OI Analysis — ${d.symbol} ${d.expiry}</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px">
      ${[
        ['SUPPORT (Put Wall)',   `$${N(ois.support)}`,   'var(--green)'],
        ['RESISTANCE (Call Wall)',`$${N(ois.resistance)}`,'var(--red)'],
        ['GAMMA WALL',           `$${N(ois.gamma_wall)}`, '#a855f7'],
        ['PCR',                  N(ois.pcr,3),            ois.pcr>1.2?'var(--red)':ois.pcr<0.7?'var(--green)':'#f59e0b'],
        ['PUT OI',               (ois.total_put_oi||0).toLocaleString(), 'var(--green)'],
        ['CALL OI',              (ois.total_call_oi||0).toLocaleString(),'var(--red)'],
        ['INTERVAL',             `${N(ois.interval)}`,   'var(--muted)'],
      ].map(([l,v,c])=>`<div class="stat-chip" style="border-top:2px solid ${c}">
        <div class="s-label">${l}</div><div class="s-val" style="color:${c}">${v}</div>
      </div>`).join('')}
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <div style="flex:1;min-width:200px">
        <div style="font-size:10px;color:var(--green);font-weight:700;margin-bottom:5px">🟢 Top Put Walls (Support)</div>
        ${(ois.top_put_walls||[]).map(([s,oi])=>`
          <div style="display:flex;justify-content:space-between;padding:4px 8px;border-bottom:1px solid rgba(255,255,255,.05)">
            <span style="font-weight:700;font-family:monospace;color:var(--green)">$${s}</span>
            <span style="color:var(--muted);font-size:11px">${oi.toLocaleString()} OI</span>
          </div>`).join('')}
        ${(ois.put_buildups||[]).length?`<div style="font-size:10px;color:var(--green);margin-top:6px">OI buildup: ${ois.put_buildups.map(([s,d])=>`$${s} +${d.toLocaleString()}`).join(', ')}</div>`:''}
      </div>
      <div style="flex:1;min-width:200px">
        <div style="font-size:10px;color:var(--red);font-weight:700;margin-bottom:5px">🔴 Top Call Walls (Resistance)</div>
        ${(ois.top_call_walls||[]).map(([s,oi])=>`
          <div style="display:flex;justify-content:space-between;padding:4px 8px;border-bottom:1px solid rgba(255,255,255,.05)">
            <span style="font-weight:700;font-family:monospace;color:var(--red)">$${s}</span>
            <span style="color:var(--muted);font-size:11px">${oi.toLocaleString()} OI</span>
          </div>`).join('')}
        ${(ois.call_buildups||[]).length?`<div style="font-size:10px;color:var(--red);margin-top:6px">OI buildup: ${ois.call_buildups.map(([s,d])=>`$${s} +${d.toLocaleString()}`).join(', ')}</div>`:''}
      </div>
      ${oich.length?`<div style="flex:1;min-width:200px">
        <div style="font-size:10px;color:#a855f7;font-weight:700;margin-bottom:5px">📈 OI Change History (${oich[0]?.dates||''})</div>
        ${oich.slice(0,5).map(r=>`
          <div style="display:flex;justify-content:space-between;padding:4px 8px;border-bottom:1px solid rgba(255,255,255,.05)">
            <span style="font-family:monospace;color:${r.type==='put'?'var(--green)':'var(--red)'}">${r.type.toUpperCase()} $${r.strike}</span>
            <span style="color:${r.delta>0?'var(--green)':'var(--red)'};font-weight:700">${r.delta>0?'+':''}${r.delta.toLocaleString()}</span>
          </div>`).join('')}
      </div>`:''}
    </div>
  </div>`;

  // ── Strategy Cards ──
  const strats = d.strategies||[];

  function _legPriceRows(s) {
    if (!s.leg_prices?.length) return '';
    return `<div style="background:#0a0f1e;border:1px solid rgba(168,85,247,.3);border-radius:5px;padding:8px 12px;margin-bottom:10px">
      <div style="font-size:8px;color:#a855f7;letter-spacing:.12em;margin-bottom:5px">REAL PRICES (yfinance mid-price)</div>
      <table class="live-leg-table" style="width:100%;border-collapse:collapse;font-family:monospace;font-size:11px">
        <tr style="color:var(--muted);font-size:9px;letter-spacing:.08em">
          <td>LEG</td><td style="text-align:right">BID</td><td style="text-align:right">ASK</td>
          <td style="text-align:right">MID</td><td style="text-align:right">IV</td><td style="text-align:right">SIGNED</td>
        </tr>
        ${s.leg_prices.map((l,li)=>`<tr data-leg="${li}">
          <td style="color:${l.action==='Sell'?'var(--red)':'var(--green)'}">
            ${l.action} $${l.strike}${l.type==='call'?'C':'P'}</td>
          <td style="text-align:right;color:var(--muted)">${l.bid!=null?'$'+l.bid:'—'}</td>
          <td style="text-align:right;color:var(--muted)">${l.ask!=null?'$'+l.ask:'—'}</td>
          <td style="text-align:right;color:var(--text);font-weight:700">${l.mid!=null?'$'+l.mid:'—'}</td>
          <td style="text-align:right;color:var(--muted)">${l.iv!=null?(l.iv*100).toFixed(1)+'%':'—'}</td>
          <td style="text-align:right;color:${l.signed_credit>0?'var(--green)':'var(--red)'}">
            ${l.signed_credit!=null?(l.signed_credit>0?'+':'')+l.signed_credit:'—'}</td>
        </tr>`).join('')}
        <tr data-net="1" style="border-top:1px solid rgba(255,255,255,.1);font-weight:700">
          <td colspan="5" style="color:var(--muted);padding-top:4px">NET ${s.net_credit>0?'CREDIT':'DEBIT'}</td>
          <td style="text-align:right;padding-top:4px;color:${(s.net_credit||0)>0?'var(--green)':'var(--red)'}">
            ${s.net_credit!=null?(s.net_credit>0?'+':'')+s.net_credit:'—'}</td>
        </tr>
      </table>
    </div>`;
  }

  const stratHtml = strats.length
    ? strats.map((s, idx)=>{
        const bC=s.bias==='BULLISH'?'var(--green)':s.bias==='BEARISH'?'var(--red)':'#f59e0b';
        const tC=s.type==='credit'?'var(--green)':'#3b82f6';
        const pC=s.pop>=70?'var(--green)':s.pop>=55?'#f59e0b':s.pop>=40?'#f97316':'var(--red)';
        const gC=s.grade==='A'?'var(--green)':s.grade==='B'?'#f59e0b':'var(--red)';
        const rrV=parseFloat((s.rr||'0').split(':')[0])||0;
        const rrC=rrV>=1?'var(--green)':rrV>=0.7?'#f59e0b':'var(--red)';
        const hasReal = s.real_prices;
        const priceLabel = hasReal
          ? '<span style="color:var(--green);font-size:9px">● LIVE PRICES</span>'
          : '<span style="color:var(--muted);font-size:9px">● ESTIMATED</span>';

        // Per-leg credit box with real prices
        const creditLabel = s.type==='credit' ? 'NET CREDIT' : 'NET DEBIT';
        const creditVal   = hasReal && s.net_credit!=null
          ? `$${Math.abs(s.net_credit).toFixed(2)}`
          : s.est_credit || '—';
        const creditColor = s.type==='credit' ? 'var(--green)' : '#3b82f6';

        const maxG = s.max_profit_dollar!=null ? `$${s.max_profit_dollar.toFixed(0)}/contract` : s.max_gain || '—';
        const maxL = s.max_loss_dollar!=null   ? `$${Math.abs(s.max_loss_dollar).toFixed(0)}/contract` : s.max_loss || '—';

        return `
        <div id="strat-card-${idx}" style="background:var(--card);border:1px solid var(--border);border-left:4px solid ${bC};border-radius:8px;padding:14px 16px;margin-bottom:14px">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px;margin-bottom:10px">
            <div>
              <span style="font-size:15px;font-weight:800;color:var(--text)">${s.name}</span>
              <span style="margin-left:8px;font-size:11px;color:var(--muted)">${s.expiry} · ${s.dte}d DTE</span>
              <span class="price-src-badge" style="margin-left:8px;font-size:9px;color:${hasReal?'var(--green)':'var(--muted)'}">${hasReal?'● LIVE PRICES':'● ESTIMATED'}</span>
            </div>
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
              <span style="width:36px;height:36px;border-radius:4px;background:${gC}18;border:2px solid ${gC};display:inline-flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:${gC}">${s.grade}</span>
              <span style="font-size:11px;font-weight:700;color:var(--muted)">Score: ${s.score}</span>
              <span style="background:${bC}18;border:1px solid ${bC}55;color:${bC};padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700">${s.bias}</span>
              <span style="background:${tC}18;border:1px solid ${tC}55;color:${tC};padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700">${s.type.toUpperCase()}</span>
            </div>
          </div>

          <div style="font-family:monospace;font-size:14px;color:#a855f7;font-weight:700;background:#a855f720;border:1px solid #a855f744;border-radius:5px;padding:9px 13px;margin-bottom:10px">${s.legs}</div>

          ${_legPriceRows(s)}

          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
            ${[[creditLabel, creditVal, creditColor],
               ['MAX GAIN',  maxG,     'var(--green)'],
               ['MAX LOSS',  maxL,     'var(--red)'],
               ['R:R',       s.rr,     rrC],
               ['PoP',       s.pop+'%',pC]
              ].map(([l,v,c])=>`
            <div style="flex:1;min-width:90px;background:${c}12;border:1px solid ${c}33;border-radius:4px;padding:6px 10px">
              <div style="font-size:8px;color:${c};letter-spacing:.1em;margin-bottom:2px">${l}</div>
              <div class="${l.includes('CREDIT')||l.includes('DEBIT')?'live-credit':l.includes('GAIN')?'live-gain':l.includes('LOSS')?'live-loss':l.includes('R:R')?'live-rr':''}" style="font-size:13px;font-weight:700;color:var(--text)">${v||'—'}</div>
            </div>`).join('')}
          </div>
          <div style="font-size:11px;color:var(--muted);border-left:2px solid ${bC}55;padding-left:8px;line-height:1.6;margin-bottom:8px">${s.rationale}</div>
          <div style="background:#f59e0b10;border:1px solid #f59e0b22;border-radius:4px;padding:7px 11px;font-size:11px;color:var(--text)">
            <b style="color:#f59e0b">⊕ MANAGE:</b> ${s.manage}
          </div>
        </div>`; }).join('')
    : '<p style="color:var(--muted);font-size:12px;padding:12px">No strategies generated — check that OI data is in DB and TA is available.</p>';

  // ── PCR History ──
  const pcrHtml = pcrh.length>=2 ? `
  <div class="card" style="padding:12px;margin-bottom:12px">
    <div class="card-title">📉 PCR Trend (last ${pcrh.length} snapshots)</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      ${pcrh.map(p=>`<div class="stat-chip">
        <div class="s-label">${p.date||'—'}</div>
        <div class="s-val" style="color:${(p.pcr||0)>1.2?'var(--red)':(p.pcr||0)<0.7?'var(--green)':'#f59e0b'}">${p.pcr!=null?p.pcr.toFixed(3):'—'}</div>
      </div>`).join('')}
    </div>
  </div>` : '';

  resEl.innerHTML = taHtml + oiHtml
    + `<div style="font-size:13px;font-weight:700;color:var(--text);padding:0 0 10px">🎯 Suggested Strategies</div>`
    + stratHtml + pcrHtml;
}

// ── Scan table renderer (legacy condor/vertical scans) ────────────────────────
function _renderScanTable(data, resEl, statEl, mode) {
  if(!data?.length){statEl.textContent='ℹ No results';return;}
  statEl.innerHTML=`<span style="color:var(--green)">✅ ${data.length} result(s)</span>`;
  const cols = mode==='condors'
    ? [{k:'symbol',h:'Symbol'},{k:'expiration',h:'Expiry'},{k:'dte',h:'DTE'},{k:'grade',h:'Grade'},
       {k:'signal_score',h:'Score'},{k:'spot',h:'Spot'},{k:'put_wall_strike',h:'Put Wall'},
       {k:'put_wall_oi',h:'Put OI'},{k:'call_wall_strike',h:'Call Wall'},{k:'call_wall_oi',h:'Call OI'},
       {k:'range_width',h:'Width'},{k:'symmetry',h:'Sym'},{k:'suggested_spread',h:'Legs'}]
    : [{k:'strategy',h:'Strategy'},{k:'symbol',h:'Symbol'},{k:'expiration',h:'Expiry'},
       {k:'dte',h:'DTE'},{k:'grade',h:'Grade'},{k:'signal_score',h:'Score'},{k:'spot',h:'Spot'},
       {k:'sell_strike',h:'Sell'},{k:'buy_strike',h:'Buy'},{k:'wall_oi',h:'Wall OI'},
       {k:'full_chain_pcr',h:'PCR'},{k:'suggested_trade',h:'Trade'}];
  let h=`<div class="tbl-wrap"><table class="data-tbl"><thead><tr>${cols.map(c=>`<th>${c.h}</th>`).join('')}</tr></thead><tbody>`;
  data.forEach(r=>{
    const rc=r.grade==='A'?'row-a':r.grade==='B'?'row-b':'row-c';
    h+=`<tr class="${rc}">${cols.map(c=>{
      const v=r[c.k]; if(v==null) return '<td>—</td>';
      if(c.k==='grade') return `<td><span class="badge badge-${v==='A'?'green':v==='B'?'yellow':'red'}">${v}</span></td>`;
      return `<td>${typeof v==='number'?v.toLocaleString():v}</td>`;
    }).join('')}</tr>`;
  });
  resEl.innerHTML=h+'</tbody></table></div>';
}



window.runStrategy=runStrategy;

function _stratRows(data,cols){return data.map(r=>{const rc=r.grade==='A'?'row-a':r.grade==='B'?'row-b':r.grade==='C'?'row-c':'';return `<tr class="${rc}">${cols.map(c=>{const v=r[c.k];const disp=c.fmt?c.fmt(v):(v==null?'—':String(v));const cc=c.cls?c.cls(v):'';return `<td class="${cc}">${disp}</td>`;}).join('')}</tr>`;}).join('');}
function _stratSort(i){const k=window._stratCols[i].k,data=window._stratData,cols=window._stratCols;if(window._sSortCol===k)window._sSortDir=(window._sSortDir||1)*-1;else{window._sSortCol=k;window._sSortDir=-1;}data.sort((a,b)=>{const va=a[k],vb=b[k];if(va==null)return 1;if(vb==null)return-1;return(va<vb?-1:va>vb?1:0)*window._sSortDir;});document.getElementById('strat-tbody').innerHTML=_stratRows(data,cols);}
function _stratFilter(){const ins=Array.from(document.querySelectorAll('#strat-results .filter-row input')).map(i=>i.value.toLowerCase());document.querySelectorAll('#strat-tbody tr').forEach(tr=>{const cells=tr.querySelectorAll('td');tr.style.display=ins.every((f,i)=>!f||(cells[i]&&cells[i].textContent.toLowerCase().includes(f)))?'':'none';});}
window._stratSort=_stratSort; window._stratFilter=_stratFilter;


// SCHEDULER  — wired inside DOMContentLoaded via initScheduler()

function initScheduler() {
  document.getElementById('save-symbols')?.addEventListener('click', async()=>{
    const raw=document.getElementById('symbols-list').value||'';
    const syms=raw.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);
    await api('/api/symbols',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({symbols:syms})});
    document.getElementById('scheduler-status').textContent='✅ Saved';
  });
  document.getElementById('run-now')?.addEventListener('click', async()=>{
    document.getElementById('scheduler-status').textContent='⏳ Triggering…';
    await api('/api/fetch_now',{method:'POST'}).catch(()=>{});
    document.getElementById('scheduler-status').textContent='▶ Triggered — check status';
  });
}

async function updateSchedulerStatus() {
  const el=document.getElementById('scheduler-status'); if(!el) return;
  const d=await api('/api/fetch_status').catch(()=>({}));
  el.innerHTML=d.running
    ?`<span style="color:var(--green)">🟢 Running</span>  Last: ${d.last_run||'—'}`
    :`<span style="color:var(--muted)">⚪ Idle</span>  Last: ${d.last_run||'—'}  ${d.last_msg||''}`;
}

async function loadSchedulerList() {
  // Use bootstrap data if available — no extra API call needed
  const syms = window._bootData?.symbols?.length
    ? window._bootData.symbols
    : ((await api('/api/symbols').catch(()=>({}))).symbols || []);
  const el=document.getElementById('symbols-list');
  if(el) el.value=syms.join(', ');
}


// SQL VIEWER + SAVED QUERIES

const SQL_KEY='oi_saved_sqls';
function _getSQLs(){try{return JSON.parse(localStorage.getItem(SQL_KEY)||'[]');}catch{return[];}}
function _saveSQLs(l){localStorage.setItem(SQL_KEY,JSON.stringify(l));}
function _refreshSQLDrop(){
  const sel=document.getElementById('sql-saved-select'); if(!sel) return;
  sel.innerHTML='<option value="">— Load saved query —</option>';
  _getSQLs().forEach(x=>{const o=document.createElement('option');o.value=x.name;o.textContent=x.name;sel.appendChild(o);});
}

function initSqlSavedQueries() {
  _refreshSQLDrop();
  document.getElementById('sql-save-btn')?.addEventListener('click',()=>{
    const name=document.getElementById('sql-save-name').value.trim();
    const query=document.getElementById('sql-query').value.trim();
    if(!name||!query){alert('Enter both a name and a query.');return;}
    const list=_getSQLs(); const idx=list.findIndex(x=>x.name===name);
    if(idx>=0){if(!confirm(`Overwrite "${name}"?`))return; list[idx].query=query;}
    else list.push({name,query});
    _saveSQLs(list); _refreshSQLDrop();
    document.getElementById('sql-save-name').value='';
    document.getElementById('sql-status').innerHTML=`<span style="color:var(--green)">✅ Saved as "${name}"</span>`;
  });
  document.getElementById('sql-load-btn')?.addEventListener('click',()=>{
    const name=document.getElementById('sql-saved-select').value; if(!name) return;
    const item=_getSQLs().find(x=>x.name===name);
    if(item){document.getElementById('sql-query').value=item.query;
      document.getElementById('sql-status').innerHTML=`<span style="color:var(--accent)">Loaded: ${name}</span>`;}
  });
  document.getElementById('sql-del-btn')?.addEventListener('click',()=>{
    const name=document.getElementById('sql-saved-select').value;
    if(!name||!confirm(`Delete "${name}"?`)) return;
    _saveSQLs(_getSQLs().filter(x=>x.name!==name)); _refreshSQLDrop();
  });
}

async function initSqlViewer() {
  const tableEl=document.getElementById('sql-table'), symEl=document.getElementById('sql-symbol');
  const expEl=document.getElementById('sql-expiration'), limEl=document.getElementById('sql-limit');
  const btn=document.getElementById('sql-run'), reset=document.getElementById('sql-reset');
  if(!tableEl||!symEl) return;

  const loadExp=async()=>{
    const sym=symEl.value.trim().toUpperCase();
    if(!sym){expEl.innerHTML='<option value="">(all)</option>';return;}
    const d=await api(`/api/db_expirations?symbol=${sym}&future=true`).catch(()=>({}));
    expEl.innerHTML='<option value="">(all)</option>';
    (d.expirations||[]).forEach(e=>{const o=document.createElement('option');o.value=e;o.textContent=e;expEl.appendChild(o);});
  };
  symEl.addEventListener('change',loadExp);
  await loadExp();

  btn.addEventListener('click',async()=>{
    const tbl=tableEl.value,sym=symEl.value.trim().toUpperCase(),exp=expEl.value,lim=+(limEl.value||100);
    const url=new URL(window.location.origin+'/api/sql_view');
    url.searchParams.set('table',tbl); url.searchParams.set('limit',String(lim));
    if(tbl==='options'){if(sym)url.searchParams.set('symbol',sym);if(exp)url.searchParams.set('expiration',exp);}
    const d=await api(url.toString()).catch(()=>({}));
    _renderSqlTbl(d.columns||[],d.rows||[],'sql-grid');
  });

  reset.addEventListener('click',()=>{
    tableEl.value='options'; symEl.value='';
    expEl.innerHTML='<option value="">(all)</option>'; limEl.value='100';
    _renderSqlTbl([],[],'sql-grid');
  });
}

function _renderSqlTbl(cols,rows,id) {
  const wrap=document.getElementById(id); if(!wrap) return;
  if(!cols.length||!rows.length){wrap.textContent='No rows.';return;}
  let h=`<table class="data-tbl"><thead><tr>${cols.map(c=>`<th>${c}</th>`).join('')}</tr></thead><tbody>`;
  rows.forEach(r=>{h+='<tr>'+cols.map(c=>`<td>${(Array.isArray(r)?r[cols.indexOf(c)]:r[c])??''}</td>`).join('')+'</tr>';});
  wrap.innerHTML=h+'</tbody></table>';
}

async function runSQL() {
  const query=document.getElementById('sql-query').value.trim();
  const statEl=document.getElementById('sql-status'),resEl=document.getElementById('sql-results');
  if(!query){statEl.innerHTML=`<span style="color:var(--red)">Enter a query.</span>`;return;}
  statEl.innerHTML=`<span style="color:var(--accent)">Running…</span>`; resEl.innerHTML='';
  try {
    const res=await fetch('/sqlviewer/run_sql',{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify({query})});
    const data=await res.json();
    if(!res.ok||data.error){statEl.innerHTML=`<span style="color:var(--red)">Error: ${data.error||res.statusText}</span>`;return;}
    if(!data.rows?.length){statEl.innerHTML=`<span style="color:var(--yellow)">No rows returned.</span>`;return;}
    _renderSqlTbl(data.columns,data.rows,'sql-results');
    statEl.innerHTML=`<span style="color:var(--green)">✅ ${data.rows.length} row(s)</span>`;
    localStorage.setItem('last_sql_query',query);
  } catch(e){statEl.innerHTML=`<span style="color:var(--red)">${e.message}</span>`;}
}
function clearSQL(){
  document.getElementById('sql-query').value='';
  document.getElementById('sql-status').innerHTML='';
  document.getElementById('sql-results').innerHTML='';
  localStorage.removeItem('last_sql_query');
}
window.runSQL=runSQL; window.clearSQL=clearSQL;


// JOURNAL — enhanced with live prices, P&L, actions, rolling, analytics

let _jrnActiveTab = 'open';
let _jrnCloseId   = null;
let _jrnRollId    = null;
let _jrnOpenData  = [];

let _jrnAutoRefreshTimer = null;
const _JRN_AUTO_REFRESH_KEY = 'oiapp.journal.autoRefresh.v1';
function _jrnFreqToMs(freq) {
  const v = String(freq || 'off').toLowerCase();
  if (v === 'off' || v === '0') return 0;
  const m = v.match(/^(\d+)(m|h)$/);
  if (!m) return 0;
  const n = parseInt(m[1], 10);
  return m[2] === 'h' ? n * 60 * 60 * 1000 : n * 60 * 1000;
}
function _jrnInitAutoRefreshControl() {
  const sel = document.getElementById('jrn-auto-refresh-frequency');
  if (!sel) return;
  const saved = localStorage.getItem(_JRN_AUTO_REFRESH_KEY) || 'off';
  if ([...sel.options].some(o => o.value === saved)) sel.value = saved;
  _jrnSetAutoRefresh(sel.value, {silent:true});
}
function _jrnSetAutoRefresh(freq, opts={}) {
  const sel = document.getElementById('jrn-auto-refresh-frequency');
  const st = document.getElementById('jrn-auto-refresh-status');
  const f = freq || sel?.value || 'off';
  if (sel && sel.value !== f && [...sel.options].some(o => o.value === f)) sel.value = f;
  localStorage.setItem(_JRN_AUTO_REFRESH_KEY, f);
  if (_jrnAutoRefreshTimer) { clearInterval(_jrnAutoRefreshTimer); _jrnAutoRefreshTimer = null; }
  const ms = _jrnFreqToMs(f);
  if (!ms) { if (st) st.textContent = 'off'; return; }
  if (st) st.textContent = 'every ' + f;
  _jrnAutoRefreshTimer = setInterval(async () => {
    const tabActive = document.getElementById('tab-journal')?.classList.contains('active');
    if (!tabActive || _jrnActiveTab !== 'open') return;
    const st2 = document.getElementById('jrn-auto-refresh-status');
    if (st2) st2.textContent = 'refreshing…';
    try { await jrnRefreshAll(); }
    catch(e) { console.warn('[journal auto refresh]', e); }
    finally { if (st2) st2.textContent = 'every ' + f; }
  }, ms);
}
function _jrnOpenDashboardForTrade(symbol, expiry) {
  const sym = String(symbol || 'SPY').trim().toUpperCase() || 'SPY';
  const exp = String(expiry || '').trim();
  _setActiveTab('dashboard');
  _toggleScannerResultPanes(true);
  document.querySelectorAll('[data-tab="dashboard"]').forEach(b => b.classList.add('active'));
  const symEl = document.getElementById('symbol-input');
  const expEl = document.getElementById('expiration-select');
  if (symEl) symEl.value = sym;
  if (expEl && exp) expEl.dataset.preselect = exp;
  if (typeof _dashLoad === 'function') {
    _dashLoad(sym).then(() => {
      if (expEl && exp) { expEl.value = exp; currentExpiration = exp; dashRefresh(); }
      if (typeof _loadTopbarMarketContext === 'function') _loadTopbarMarketContext();
      document.getElementById('tab-dashboard')?.scrollIntoView({block:'start'});
    });
  }
}

function jrnTab(name) {
  _jrnActiveTab = name;
  ['open','closed','analytics','outcome','add'].forEach(t => {
    const panel = document.getElementById(`jrn-${t}`);
    const btn   = document.getElementById(`jrn-tab-${t}`);
    if (panel) panel.style.display = t===name ? '' : 'none';
    if (btn) {
      btn.classList.toggle('btn-primary', t===name);
      btn.classList.toggle('btn-ghost',   t!==name);
    }
  });
  if (name==='open')      jrnLoadOpen();
  if (name==='closed')    jrnLoadClosed();
  if (name==='analytics') jrnLoadAnalytics();
  if (name==='outcome')   _jrnLoadOutcomeAnalytics();
  if (name==='add')       setTimeout(() => {
    const dateEl = document.getElementById('jrn-add-entry-date');
    if (dateEl && !dateEl.value) dateEl.value = new Date().toISOString().slice(0,10);
    _jrnTypeChanged();
    const tt = document.getElementById('jrn-add-type')?.value || 'IC';
    if ((!_jrnLegs || !_jrnLegs.length) && tt !== 'Stock') _jrnTemplate(tt);
    if (typeof _jrnRefreshOptionContext === 'function') _jrnRefreshOptionContext(false);
  }, 50);
}

async function _loadPortfolioHeader() {
  try {
    const s = await api('/journal/portfolio_stats');
    const hdr = document.getElementById('jrn-portfolio-header');
    if (hdr) hdr.style.display = '';
    // Also load alignment asynchronously
    _loadPortfolioAlignment();
    const pnlC = v => v >= 0 ? '#22c55e' : '#ef4444';
    const $ = (id, val, color) => {
      const el = document.getElementById(id);
      if (el) { el.textContent = val; if (color) el.style.color = color; }
    };
    $('ph-current-pnl', s.current_pnl>=0?`+$${s.current_pnl}`:`-$${Math.abs(s.current_pnl)}`, pnlC(s.current_pnl));
    $('ph-overall-pnl', s.overall_pnl>=0?`+$${s.overall_pnl}`:`-$${Math.abs(s.overall_pnl)}`, pnlC(s.overall_pnl));
    $('ph-winners', s.winners);
    $('ph-losers',  s.losers);
    $('ph-win-rate', s.win_rate+'%', s.win_rate>=50?'#22c55e':'#ef4444');
    $('ph-bull-risk', '$'+s.bull_risk);
    $('ph-bull-rew',  '$'+s.bull_reward);
    $('ph-bear-risk', '$'+s.bear_risk);
    $('ph-bear-rew',  '$'+s.bear_reward);
    $('ph-total-rr',  s.overall_rr+':1', s.overall_rr>=0.7?'#22c55e':'#f59e0b');
    $('ph-capital-pct', s.capital_deployed_pct+'%', s.capital_deployed_pct>30?'#ef4444':s.capital_deployed_pct>20?'#f59e0b':'#22c55e');
    $('ph-open-count', s.open_count+' open');
    $('ph-proj-win',  s.proj_winners);
    $('ph-proj-lose', s.proj_losers);
    $('ph-itm-otm',   s.itm_count+' / '+s.otm_count);
  } catch(e) { console.error('[portfolio header]', e); }
}

async function _loadPortfolioAlignment() {
  try {
    const d = await api('/journal/portfolio_alignment');
    const el = document.getElementById('jrn-alignment-panel');
    if (!el || d.error) return;
    const sc = d.status_color || '#64748b';
    const mktC = d.market_bias?.includes('BULL')||d.market_bias==='OVERSOLD' ? '#22c55e'
               : d.market_bias?.includes('BEAR')||d.market_bias==='OVERBOUGHT' ? '#ef4444' : '#f59e0b';
    const bullW = d.bull_pct || 0; const bearW = d.bear_pct || 0; const icW = d.ic_pct || 0;
    el.innerHTML = `
      <div style="background:var(--card);border:1px solid ${sc}44;border-left:4px solid ${sc};
          border-radius:6px;padding:10px 14px;margin-bottom:10px">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:8px">
          <div style="display:flex;align-items:center;gap:10px">
            <span style="font-size:12px;font-weight:800;color:${sc}">${d.status_label}</span>
            <span style="font-size:11px;color:var(--muted)">Portfolio: <b style="color:${sc}">${d.portfolio_bias}</b></span>
            <span style="font-size:11px;color:var(--muted)">Market: <b style="color:${mktC}">${d.market_bias} (SPY ${d.spy_trend}) · RSI-EMA Δ${d.spy_rsi_diff>=0?'+':''}${d.spy_rsi_diff}</b></span>
            ${d.vix ? `<span style="font-size:11px;color:var(--muted)">VIX <b>${d.vix}</b> — ${d.vix_signal}</span>` : ''}
          </div>
        </div>
        <!-- Exposure bar -->
        <div style="margin-bottom:8px">
          <div style="font-size:9px;color:var(--muted);margin-bottom:3px">PORTFOLIO EXPOSURE</div>
          <div style="display:flex;height:14px;border-radius:4px;overflow:hidden;gap:1px">
            ${bullW>0?`<div style="width:${bullW}%;background:#22c55e;display:flex;align-items:center;justify-content:center">
              <span style="font-size:8px;color:#fff;font-weight:700">${bullW}% Bull</span></div>`:''}
            ${icW>0 ?`<div style="width:${icW}%;background:#a855f7;display:flex;align-items:center;justify-content:center">
              <span style="font-size:8px;color:#fff;font-weight:700">${icW}% IC</span></div>`:''}
            ${bearW>0?`<div style="width:${bearW}%;background:#ef4444;display:flex;align-items:center;justify-content:center">
              <span style="font-size:8px;color:#fff;font-weight:700">${bearW}% Bear</span></div>`:''}
            ${100-bullW-icW-bearW>0?`<div style="width:${100-bullW-icW-bearW}%;background:var(--border);"></div>`:''}
          </div>
        </div>
        <!-- Issues + suggestions -->
        ${(d.alignment_issues||[]).map(i=>`
          <div style="font-size:11px;color:#ef4444;margin-bottom:3px">⚠ ${i}</div>`).join('')}
        ${(d.suggestions||[]).slice(0,2).map(s=>`
          <div style="font-size:10px;color:var(--muted);margin-top:2px">→ ${s}</div>`).join('')}
      </div>`;
    el.style.display = '';
  } catch(e) { console.error('[alignment]', e); }
}

let _jrnSectorFilter = '';

async function jrnLoadOpen() {
  const el = document.getElementById('jrn-open-grid');
  if (!el) return;
  el.innerHTML = '<div style="color:var(--muted);padding:12px">Loading open trades…</div>';
  _loadPortfolioHeader();  // async, non-blocking
  try {
    const trades = await api('/journal/trades?status=OPEN');
    _jrnOpenData = trades;
window._jrnTrades = trades;  // for 📐 analysis button
    if (!trades.length) { el.innerHTML='<div style="color:var(--muted);padding:20px">No open trades. Click ➕ Add Trade to log one.</div>'; return; }
    // Sort state
    if (!window._jrnSort) window._jrnSort = {col:'expiry',dir:1};
    function _jrnSortTrades(arr) {
      const col = window._jrnSort.col; const dir = window._jrnSort.dir;
      return [...arr].sort((a,b)=>{
        let va = a[col]||''; let vb = b[col]||'';
        if (col==='expiry'||col==='entry_date') return dir*(va<vb?-1:va>vb?1:0);
        if (col==='outlook') {
          const order={'PROJECTED WINNER':0,'ITM':1,'NEUTRAL':2,'OTM':3,'PROJECTED LOSER':4,'UNKNOWN':5};
          return dir*((order[va.toUpperCase()]??9)-(order[vb.toUpperCase()]??9));
        }
        if (col==='prob_score') return dir*((parseFloat(vb||0))-(parseFloat(va||0)));  // high score first
      if (col==='entry_score') return dir*((parseFloat(vb||0))-(parseFloat(va||0)));
        return dir*(parseFloat(va||0)-parseFloat(vb||0));
      });
    }
    function _thSort(col) {
      if (window._jrnSort.col===col) window._jrnSort.dir*=-1;
      else { window._jrnSort.col=col; window._jrnSort.dir=1; }
      jrnLoadOpen();
    }
    const sorted = _jrnSortTrades(trades);
    const thStyle = 'cursor:pointer;user-select:none;white-space:nowrap;padding:5px 6px';
    const thArr = c => `${c===window._jrnSort.col?(window._jrnSort.dir>0?' ▲':' ▼'):''}`;
    // Filter trades
    const filter = window._jrnFilter || 'ALL';
    let sorted2 = sorted;
    if (filter !== 'ALL') {
      sorted2 = sorted.filter(t => {
        const tt = t.trade_type || '';
        const reason = (t.entry_reason || '').toUpperCase();
        const regime = reason;
        if (filter === 'BULL') return ['PS','PB','CB'].includes(tt) || tt==='Stock' || regime.includes('BULL') || regime.includes('MEAN_REV_BULL');
        if (filter === 'BEAR') return ['CS','IC'].includes(tt) || regime.includes('BEAR') || regime.includes('MEAN_REV_BEAR');
        if (filter === 'SIDEWAYS') return ['IC','Strangle','Straddle'].includes(tt) || regime.includes('SIDEWAYS');
        if (filter === 'CREDIT') return ['PS','CS','IC'].includes(tt);
        if (filter === 'DEBIT') return ['PB','CB'].includes(tt);
        return true;
      });
    }

    el.innerHTML = `
    <div style="display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap;align-items:center">
      <span style="font-size:11px;color:var(--muted)">Filter:</span>
      ${['ALL','BULL','BEAR','SIDEWAYS','CREDIT','DEBIT'].map(f=>{
        const active = f===filter;
        const colors = {ALL:'#64748b',BULL:'#22c55e',BEAR:'#ef4444',SIDEWAYS:'#f59e0b',CREDIT:'#4ade80',DEBIT:'#f97316'};
        const c = colors[f]||'#64748b';
        return `<button onclick="window._jrnFilter='${f}';jrnLoadOpen()"
          style="font-size:10px;padding:3px 10px;border-radius:4px;cursor:pointer;font-weight:700;
          background:${active?c+'22':'transparent'};color:${active?c:'var(--muted)'};
          border:1px solid ${active?c:'var(--border)'}">${f}</button>`;
      }).join('')}
      <span style="font-size:10px;color:var(--muted);margin-left:8px">${sorted2.length} of ${sorted.length} trades</span>
    </div>
    <div style="overflow-x:auto">
    <table class="data-tbl" style="font-size:11px;width:100%;border-collapse:collapse">
      <colgroup>
        <col style="width:52px"/><col style="width:38px"/><col style="width:230px"/>
        <col style="width:84px"/><col style="width:32px"/><col style="width:60px"/>
        <col style="width:52px"/><col style="width:28px"/>
        <col style="width:48px"/><col style="width:48px"/>
        <col style="width:58px"/>
        <col style="width:130px"/><col style="width:76px"/>
        <col style="width:76px"/><col style="width:190px"/>
        <col style="width:200px"/><col style="width:240px"/>
      </colgroup>
      <thead><tr>
        <th style="${thStyle}" onclick="_thSort('symbol')">Sym${thArr('symbol')}</th>
        <th style="${thStyle}">Type</th>
        <th style="${thStyle}">Strikes</th>
        <th style="${thStyle}" onclick="_thSort('expiry')">Expiry${thArr('expiry')}</th>
        <th style="${thStyle}" onclick="_thSort('expiry')">DTE${thArr('expiry')}</th>
        <th style="${thStyle}">Spot</th>
        <th style="${thStyle}">Entry</th><th style="${thStyle}">Qty</th>
        <th style="${thStyle}">Max+</th><th style="${thStyle}">Max-</th>
        <th style="${thStyle}" onclick="_thSort('current_pnl')">P&L${thArr('current_pnl')}</th>
        <th style="${thStyle}">Reason</th>
        <th style="${thStyle}" onclick="_thSort('outlook')">Outlook${thArr('outlook')}</th>
        <th style="${thStyle}" onclick="_thSort('prob_score')">Health${thArr('prob_score')}</th>
        <th style="${thStyle}" onclick="_thSort('entry_score')">Entry Score${thArr('entry_score')}</th>
        <th style="${thStyle}">Action / Signals</th>
        <th style="padding:5px 6px;white-space:nowrap;min-width:160px">Actions</th><th style="${thStyle}">Live P&L</th>
      </tr></thead>
      <tbody>${sorted2.filter(t => !_jrnSectorFilter || (t.sector||'') === _jrnSectorFilter).map(t => _renderTradeCard(t)).join('')}</tbody>
    </table></div>`;
  } catch(e) { el.innerHTML=`<span style="color:var(--red)">Error: ${e.message}</span>`; }
}


async function _jrnEditClosedPnl(tid){
  const newPnl = prompt(`Edit P&L for trade #${tid}\nEnter corrected P&L (e.g. 190 or -75):`);
  if(newPnl===null) return;
  const pnl = parseFloat(newPnl);
  if(isNaN(pnl)){alert('Invalid number');return;}
  try{
    await api(`/journal/trade/${tid}/edit_pnl`,{method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({pnl})});
    alert(`P&L updated to ${pnl>=0?'+':''}$${pnl.toFixed(2)}`);
    jrnLoadClosed();
  }catch(e){alert('Error: '+e.message);}
}

// ── Entry Score Preview (Add Trade form) ──────────────────────────────────
function _jrnRenderEntryScorePreview(panel, d) {
  if (!panel || !d) return;
  const sc = Number(d.score || 0);
  const ec = sc>=80?'#22c55e':sc>=65?'#4ade80':sc>=50?'#f59e0b':sc>=35?'#f97316':'#ef4444';
  const rec = d.recommendation || 'HOLD';
  const recC = /CLOSE|EXIT|BREACH/i.test(rec)?'#ef4444':/ROLL|TRIM|HEDGE/i.test(rec)?'#f97316':/ADD/i.test(rec)?'#3b82f6':'#22c55e';
  const r = Math.max(0, Math.min(1, sc/100));
  const circ = 2 * Math.PI * 18;
  const notes = (d.notes || []).slice(0, 4).map(n => `<div style="font-size:10px;color:#94a3b8;padding:1px 0">• ${n}</div>`).join('');
  const suggs = (d.suggestions || []).slice(0, 2).map(x => {
    const c = {EXIT:'#ef4444',TRIM:'#a78bfa',HEDGE:'#f97316',ROLL:'#f59e0b',ADD:'#3b82f6',HOLD:'#22c55e'}[(x.type||'').toUpperCase()] || '#94a3b8';
    return `<div style="font-size:10px;color:${c};padding:1px 0"><b>${x.type || rec}</b>: ${x.text || ''}</div>`;
  }).join('');
  const factors = (d.signal_factors || []).slice(0, 10).map(sf => {
    const delta = Number(sf.delta || 0);
    const c = delta > 0 ? '#22c55e' : delta < 0 ? '#ef4444' : '#64748b';
    return `<span style="background:${c}18;border:1px solid ${c}44;color:${c};font-size:9px;padding:2px 5px;border-radius:4px" title="${sf.note || ''}">${sf.label || ''}: ${sf.value || ''}</span>`;
  }).join(' ');
  const bestStrat = d.ai_best_strategy || null;
  const altStrats = (d.ai_strategy_alternatives || []).slice(0, 2);
  const stratHtml = bestStrat ? `
    <div style="background:#07101d;border:1px solid #1f2937;border-radius:8px;padding:8px 10px;margin:8px 0">
      <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:4px">
        <div style="font-size:11px;font-weight:800;color:#86efac">📐 Best strategy for ${bestStrat.expiry || d.dte || 'selected expiry'}</div>
        <div style="font-size:10px;color:#fbbf24">RR <b>${bestStrat.rr || '—'}</b> · PoP <b>${bestStrat.pop ?? '—'}%</b></div>
      </div>
      <div style="font-size:12px;color:#e2e8f0;font-weight:800;margin-bottom:3px">${bestStrat.name || 'Strategy'} — ${bestStrat.legs || ''}</div>
      <div style="font-size:10px;color:#cbd5e1;margin-bottom:4px">${bestStrat.rationale || ''}</div>
      <div style="font-size:10px;color:#cbd5e1;margin-bottom:4px"><b>Risk:</b> ${d.ai_best_strategy_risk || `${bestStrat.max_loss || '—'} max loss · ${bestStrat.max_gain || '—'} max gain`}</div>
      <div style="font-size:10px;color:#93c5fd;margin-bottom:4px"><b>Manage:</b> ${d.ai_best_strategy_manage || bestStrat.manage || '—'}</div>
      ${altStrats.length?`<div style="font-size:9px;color:#94a3b8">Alternatives: ${altStrats.map(s=>`${s.name || '—'} (${s.rr || '—'})`).join(' · ')}</div>`:''}
    </div>` : '';
  const pnr = (d.pnr || d.pnr_upper)
    ? `<div>PNR <b>${d.pnr ? ('$' + d.pnr + '↓') : ''}${d.pnr && d.pnr_upper ? ' / ' : ''}${d.pnr_upper ? ('$' + d.pnr_upper + '↑') : ''}</b> <span style="color:${d.pnr_breached?'#ef4444':'#22c55e'}">${d.pnr_status || ''}</span></div>`
    : '';
  panel.innerHTML = `
    <div style="background:#0f172a;border:1px solid #1e293b;border-radius:8px;padding:12px;margin-top:8px">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
        <svg width="46" height="46" viewBox="0 0 46 46">
          <circle cx="23" cy="23" r="18" fill="none" stroke="#1e293b" stroke-width="4"/>
          <circle cx="23" cy="23" r="18" fill="none" stroke="${ec}" stroke-width="4"
            stroke-dasharray="${(circ*r).toFixed(1)} ${(circ*(1-r)).toFixed(1)}" stroke-linecap="round" transform="rotate(-90 23 23)"/>
          <text x="23" y="27" text-anchor="middle" font-size="11" font-weight="800" fill="${ec}">${sc}</text>
        </svg>
        <div style="flex:1">
          <div style="font-size:18px;font-weight:900;color:${ec};margin-bottom:2px">${d.grade || '?'} Journal Health Preview</div>
          <div style="display:inline-block;background:${recC}22;border:1.5px solid ${recC};color:${recC};font-size:12px;font-weight:800;padding:3px 10px;border-radius:5px">${rec}</div>
        </div>
        <div style="text-align:right;font-size:10px;color:#64748b">
          ${d.spot!=null?`<div>Spot <b>$${d.spot}</b></div>`:''}
          ${d.dte!=null?`<div>DTE <b>${d.dte}</b></div>`:''}
          ${d.outlook?`<div>Outlook <b>${d.outlook}</b></div>`:''}
          ${d.current_mark!=null?`<div>Mark <b>${d.current_mark}</b></div>`:''}
          ${d.unrealised_pnl!=null?`<div>P/L <b style="color:${d.unrealised_pnl>=0?'#22c55e':'#ef4444'}">${d.unrealised_pnl>=0?'+':''}$${d.unrealised_pnl}</b></div>`:''}
        </div>
      </div>
      <div style="font-size:10px;color:#94a3b8;margin-bottom:6px">${d.action_reason || ''}</div>
      ${pnr?`<div style="font-size:10px;color:#94a3b8;margin-bottom:6px">${pnr}</div>`:''}
      ${(d.ai_summary||d.ai_headline)?`<div style="background:#08111f;border:1px solid #1f2937;border-radius:8px;padding:8px 10px;margin:8px 0">
        <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:4px">
          <div style="font-size:11px;font-weight:800;color:#93c5fd">🤖 AI Trade Analyst</div>
          ${d.ai_confidence!=null?`<div style="font-size:10px;color:#a5b4fc">Confidence <b>${Number(d.ai_confidence).toFixed(1)}%</b></div>`:''}
        </div>
        <div style="font-size:10px;color:#e2e8f0;line-height:1.45;margin-bottom:4px">${d.ai_summary || d.ai_headline || ''}</div>
        <div style="font-size:9px;color:#94a3b8;margin-bottom:3px">Score ${d.score ?? '—'}/100 = journal fit · Confidence ${d.ai_confidence != null ? Number(d.ai_confidence).toFixed(1)+'%' : '—'} = how complete the context is.</div>
        ${d.ai_score_meaning?`<div style="font-size:9px;color:#cbd5e1;margin-bottom:2px"><b>Score means:</b> ${d.ai_score_meaning}</div>`:''}
        ${d.ai_confidence_meaning?`<div style="font-size:9px;color:#cbd5e1;margin-bottom:5px"><b>Confidence means:</b> ${d.ai_confidence_meaning}</div>`:''}
        ${d.ai_action_mode || d.ai_action_text ? `<div style="font-size:10px;color:#cbd5e1;margin-bottom:5px"><b style="color:#93c5fd">Plan:</b> ${d.ai_action_mode || 'HOLD'}${d.ai_roll_side ? ' / ' + d.ai_roll_side : ''}${d.ai_roll_expiry ? ' → ' + d.ai_roll_expiry : ''}${d.ai_roll_strategy ? ' · ' + d.ai_roll_strategy : ''}${d.ai_action_text ? '<br><span style="color:#94a3b8">' + d.ai_action_text + '</span>' : ''}</div>` : ''}
        ${(d.ai_thesis||[]).length?`<div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:5px">${(d.ai_thesis||[]).slice(0,4).map(x=>`<span style="background:#1e293b;color:#cbd5e1;border:1px solid #334155;border-radius:999px;padding:1px 7px;font-size:9px">${x}</span>`).join('')}</div>`:''}
        ${stratHtml}
        ${(d.ai_price_alerts||[]).length?`<div style="margin-bottom:5px">${(d.ai_price_alerts||[]).slice(0,3).map(a=>`<div style="font-size:9px;color:#93c5fd;line-height:1.35">• ${a.label || 'Level'} ${a.level != null ? '@ $'+Number(a.level).toFixed(2) : ''} — ${a.reason || ''} <span style="color:#fbbf24">Action: ${a.action || 'Monitor'}</span></div>`).join('')}</div>`:''}
        ${(d.ai_next_actions||[]).length?`<div style="font-size:9px;color:#93c5fd"><b>Next:</b> ${(d.ai_next_actions||[]).slice(0,2).join(' · ')}</div>`:''}
        ${(d.ai_missing_inputs||[]).length?`<div style="font-size:9px;color:#fbbf24"><b>Missing:</b> ${(d.ai_missing_inputs||[]).slice(0,3).join(', ')}</div>`:''}
      </div>`:''}
      ${factors?`<div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px">${factors}</div>`:''}
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
        <div>${notes || '<span style="font-size:10px;color:#64748b">No score notes yet.</span>'}</div>
        <div>${suggs || '<span style="font-size:10px;color:#64748b">No immediate action.</span>'}</div>
      </div>
    </div>`;
}

async function _jrnPreviewEntryScore(symbol, tradeType) {
  const panel = document.getElementById('entry-score-preview');
  if (!panel) return;
  const payload = (typeof _jrnBuildDraftPayload === 'function')
    ? _jrnBuildDraftPayload({ silent: true })
    : null;
  const sym = (symbol || payload?.symbol || document.getElementById('jrn-add-symbol')?.value || '').trim().toUpperCase();
  if (!sym) { panel.innerHTML = ''; return; }
  if (payload) {
    payload.symbol = sym;
    payload.trade_type = tradeType || payload.trade_type || document.getElementById('jrn-add-type')?.value || 'IC';
  }
  panel.innerHTML = '<div style="color:var(--muted);font-size:11px;padding:8px 0">⏳ Calculating journal-style health score…</div>';
  try {
    const d = await api('/journal/draft_health_score', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload || { symbol: sym, trade_type: tradeType || 'IC' })
    });
    if (d.error) { panel.innerHTML = `<div style="color:#ef4444;font-size:11px">${d.error}</div>`; return; }
    window._lastConviction = d;
    _jrnRenderEntryScorePreview(panel, d);
  } catch(e) {
    panel.innerHTML = `<div style="color:#ef4444;font-size:10px">Health preview unavailable: ${e.message}</div>`;
  }
}

// ── Snapshot fetch button ─────────────────────────────────────────────────
async function _jrnFetchSnapshot(tid) {
  const el = document.getElementById(`jrn-live-${tid}`);
  if (!el) return;
  el.innerHTML = '<span style="color:var(--muted);font-size:10px">⏳ fetching snapshot…</span>';
  try {
    const d = await api(`/journal/trade/${tid}/snapshot/refresh`, {method:'POST'});
    if (d.ok && d.snapshot) {
      const snap = d.snapshot;
      const es = snap.entry_score || 0;
      const ec = es>=80?'#22c55e':es>=65?'#4ade80':es>=50?'#f59e0b':es>=35?'#f97316':'#ef4444';
      el.innerHTML = `<div style="font-size:10px;padding:4px;background:#0f172a;border:1px solid #1e293b;border-radius:4px;max-width:300px">
        <div style="color:${ec};font-weight:700">Entry Score: ${es}/100 (${snap.entry_grade||'?'})</div>
        <div style="font-size:9px;color:#94a3b8;margin-top:2px">
          RS: ${snap.entry_rs!=null?(snap.entry_rs>0?'+':'')+snap.entry_rs+'%':'—'} ·
          IVR: ${snap.entry_iv_rank!=null?snap.entry_iv_rank?.toFixed?.(0)+'%':'—'} ·
          PCR: ${snap.entry_pcr||'—'}
        </div>
        <div style="font-size:9px;color:#64748b;margin-top:2px">
          Regime: ${[snap.regime_monthly,snap.regime_weekly,snap.regime_daily].filter(Boolean).join(' / ')||'—'}
        </div>
      </div>`;
    } else {
      el.innerHTML = '<span style="color:#ef4444;font-size:10px">Snapshot failed — run scheduler first</span>';
    }
  } catch(e) {
    el.innerHTML = `<span style="color:#ef4444;font-size:10px">Error: ${e.message}</span>`;
  }
}

// ── Delta / Replay Panel ─────────────────────────────────────────────────
async function _jrnOpenDelta(tid) {
  const el = document.getElementById(`jrn-live-${tid}`);
  if (!el) return;
  el.innerHTML = '<span style="color:var(--muted);font-size:10px">⏳ loading structure replay…</span>';
  try {
    const d = await api(`/journal/trade/${tid}/delta`);
    if (d.error) { el.innerHTML = `<div style="color:#ef4444;font-size:10px">${d.error}</div>`; return; }
    const sh = d.structural_health;
    const rows = d.rows || [];
    const shScore = sh?.score || 0;
    const shColor = shScore>=70?'#22c55e':shScore>=50?'#f59e0b':shScore>=35?'#f97316':'#ef4444';
    const rowsHtml = rows.map(r => {
      const isBad = r.color === '#ef4444';
      const isGood = r.color === '#22c55e';
      const arrow = isBad ? '↓' : isGood ? '↑' : '→';
      return `<tr>
        <td style="padding:2px 6px;font-size:9px;color:#94a3b8;white-space:nowrap">${r.label}</td>
        <td style="padding:2px 6px;font-size:9px;color:#64748b;text-align:right">${r.entry}</td>
        <td style="padding:2px 6px;font-size:9px;font-weight:700;text-align:right">${r.current}</td>
        <td style="padding:2px 6px;font-size:9px;font-weight:700;color:${r.color};text-align:right">${arrow} ${r.delta}</td>
      </tr>`;
    }).join('');
    const reasons = (sh?.reasons||[]).map(r=>`<div style="font-size:9px;color:#ef4444;padding:1px 0">· ${r}</div>`).join('');
    el.innerHTML = `
      <div style="max-width:380px;font-size:10px;padding:4px 0">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
          <div style="background:${shColor}22;border:1px solid ${shColor};border-radius:4px;padding:3px 10px;font-weight:800;color:${shColor}">${shScore}/100</div>
          <div style="color:${shColor};font-weight:700;font-size:11px">${sh?.tier||''}</div>
          ${sh?.deteriorating?'<span style="color:#ef4444;font-size:10px;font-weight:700">⚠ DETERIORATING</span>':''}
        </div>
        <table style="width:100%;border-collapse:collapse;margin-bottom:6px">
          <tr style="border-bottom:1px solid #1e293b">
            <th style="padding:2px 6px;font-size:8px;color:#475569;text-align:left">Metric</th>
            <th style="padding:2px 6px;font-size:8px;color:#475569;text-align:right">Entry</th>
            <th style="padding:2px 6px;font-size:8px;color:#475569;text-align:right">Now</th>
            <th style="padding:2px 6px;font-size:8px;color:#475569;text-align:right">Δ</th>
          </tr>
          ${rowsHtml}
        </table>
        ${reasons?`<div style="border-top:1px solid #1e293b;padding-top:4px">${reasons}</div>`:''}
      </div>`;
  } catch(e) {
    el.innerHTML = `<span style="color:#ef4444;font-size:10px">Delta error: ${e.message}</span>`;
  }
}


async function _jrnDeleteClosed(tid){
  if(!confirm(`Delete closed trade #${tid}? Removes from P&L history.`))return;
  try{await api(`/journal/trade/${tid}/delete`,{method:'DELETE'});jrnLoadClosed();if(typeof _loadPortfolioHeader==='function')_loadPortfolioHeader();}
  catch(e){alert('Error: '+e.message);}
}

async function jrnLoadClosed() {
  const el = document.getElementById('jrn-closed-grid');
  if (!el) return;
  try {
    const trades = await api('/journal/trades?status=CLOSED');
    if (!trades.length) { el.innerHTML='<div style="color:var(--muted);padding:20px">No closed trades yet.</div>'; return; }
    el.innerHTML = `
      <table class="data-tbl" style="font-size:11px">
        <thead><tr>
          <th>Date</th><th>Symbol</th><th>Type</th><th>Expiry</th>
          <th class="text-end">Short</th><th class="text-end">Long</th>
          <th class="text-end">Entry</th><th class="text-end">Exit</th>
          <th class="text-end">P&L</th><th>Reason</th><th>Comments</th>
        </tr></thead><tbody>
        ${trades.map((t,i)=>{
          const pnl=parseFloat(t.pnl||0);
          const pnlC=pnl>0?'#22c55e':'#ef4444';
          return `<tr style="background:${i%2?'var(--surface)':'var(--card)'}">
            <td>${t.entry_date||''}</td>
            <td style="font-weight:700;color:var(--accent)">${t.symbol}</td>
            <td><span style="background:rgba(99,102,241,.2);padding:1px 6px;border-radius:3px">${t.trade_type}</span></td>
            <td>${t.expiry||''}</td>
            <td class="text-end">${t.short_strike||'—'}</td>
            <td class="text-end">${t.long_strike||'—'}</td>
            <td class="text-end">$${Number(t.entry_price||0).toFixed(2)}</td>
            <td class="text-end">${t.exit_price!=null && t.exit_price!=='' ? '$'+fmt2(t.exit_price) : '—'}</td>
            <td class="text-end" style="font-weight:700;color:${pnlC}">${pnl>0?'+':''}$${pnl.toFixed(2)}</td>
            <td style="font-size:10px">${t.close_reason||''}</td>
            <td style="font-size:10px;max-width:160px;overflow:hidden;text-overflow:ellipsis">${t.exit_reason||''}</td>
            <td style="white-space:nowrap">
            <button onclick="_jrnEditClosedPnl(${t.id})" style="background:#854d0e;color:#fde68a;border:1px solid #ca8a04;border-radius:3px;padding:3px 6px;cursor:pointer;font-size:10px;margin-right:3px" title="Edit P&L">✏️</button><button onclick="_jrnDeleteClosed(${t.id})" style="background:#7f1d1d;color:#fca5a5;border:1px solid #dc2626;border-radius:3px;padding:3px 6px;cursor:pointer;font-size:10px">🗑</button></td>
          </tr>`;
        }).join('')}
        </tbody>
      </table>`;
  } catch(e) { el.innerHTML=`<span style="color:var(--red)">Error: ${e.message}</span>`; }
}

async function jrnLoadAnalytics() {
  const el = document.getElementById('jrn-analytics-content');
  if (!el) return;
  el.innerHTML='<div style="color:var(--muted);padding:12px">Computing analytics…</div>';
  try {
    const d = await api('/journal/analytics');
    let ai = null;
    try { ai = await api('/journal/ai/portfolio_review'); } catch (e) { ai = null; }
    if (d.error) { el.innerHTML=`<div style="color:var(--muted);padding:20px">${d.error}</div>`; return; }

    const stratRows = Object.entries(d.by_strategy||{}).map(([tt,v],i)=>`
      <tr style="background:${i%2?'var(--surface)':'var(--card)'}">
        <td style="font-weight:700">${tt}</td>
        <td class="text-end">${v.count}</td>
        <td class="text-end" style="color:${v.win_rate>=60?'#22c55e':v.win_rate>=50?'#f59e0b':'#ef4444'};font-weight:700">${v.win_rate}%</td>
        <td class="text-end" style="color:${v.total_pnl>=0?'#22c55e':'#ef4444'};font-weight:700">${v.total_pnl>=0?'+':''}$${v.total_pnl.toFixed(2)}</td>
        <td class="text-end">${v.avg_pnl>=0?'+':''}$${v.avg_pnl.toFixed(2)}</td>
      </tr>`).join('');

    const symRows = Object.entries(d.by_symbol||{}).sort((a,b)=>b[1].total_pnl-a[1].total_pnl).slice(0,10).map(([s,v],i)=>`
      <tr style="background:${i%2?'var(--surface)':'var(--card)'}">
        <td style="font-weight:700;color:var(--accent)">${s}</td>
        <td class="text-end">${v.count}</td>
        <td class="text-end" style="color:${v.win_rate>=60?'#22c55e':v.win_rate>=50?'#f59e0b':'#ef4444'};font-weight:700">${v.win_rate}%</td>
        <td class="text-end" style="color:${v.total_pnl>=0?'#22c55e':'#ef4444'};font-weight:700">${v.total_pnl>=0?'+':''}$${v.total_pnl.toFixed(2)}</td>
      </tr>`).join('');

    el.innerHTML = `
      <!-- Summary chips -->
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px">
        ${[
          ['Total Trades', d.total_trades, ''],
          ['Win Rate', d.win_rate+'%', d.win_rate>=60?'#22c55e':d.win_rate>=50?'#f59e0b':'#ef4444'],
          ['Total P&L', (d.total_pnl>=0?'+':'')+'$'+d.total_pnl, d.total_pnl>=0?'#22c55e':'#ef4444'],
          ['Avg Win', '+$'+d.avg_win, '#22c55e'],
          ['Avg Loss', '$'+d.avg_loss, '#ef4444'],
          ['Expectancy', (d.expectancy>=0?'+':'')+'$'+d.expectancy, d.expectancy>=0?'#22c55e':'#ef4444'],
          ['Max Drawdown', '$'+d.max_drawdown, '#ef4444'],
        ].map(([l,v,c])=>`
          <div class="stat-chip">
            <div class="s-label">${l}</div>
            <div class="s-val" style="${c?'color:'+c:'color:var(--text)'};font-size:15px;font-weight:800">${v}</div>
          </div>`).join('')}
      </div>

      <!-- Insight box -->
      <div style="background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.3);border-radius:6px;
          padding:12px 16px;margin-bottom:16px;font-size:12px;color:var(--text);line-height:1.7">
        💡 ${d.insight}
      </div>
      ${ai?`<div style="background:#09111f;border:1px solid #1f2937;border-radius:8px;padding:12px 16px;margin-bottom:16px;font-size:12px;line-height:1.6">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px">
          <div style="font-size:12px;font-weight:800;color:#93c5fd">🤖 AI Portfolio Coach</div>
          <div style="font-size:10px;color:#94a3b8">Avg score <b style="color:#cbd5e1">${ai.avg_score ?? '—'}</b> · Open trades <b style="color:#cbd5e1">${ai.open_count ?? 0}</b></div>
        </div>
        <div style="color:#e2e8f0;margin-bottom:8px">${ai.summary || ''}</div>
        ${(ai.recommendation||[]).length?`<div style="display:flex;flex-direction:column;gap:3px;margin-bottom:8px">${(ai.recommendation||[]).slice(0,3).map(x=>`<div style="font-size:10px;color:#cbd5e1">• ${x}</div>`).join('')}</div>`:''}
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          ${(ai.best||[]).slice(0,3).map(x=>`<div style="background:#0f172a;border:1px solid #1e293b;border-radius:5px;padding:6px 8px;min-width:170px">
            <div style="font-weight:800;color:#22c55e">${x.symbol || '—'} <span style="color:#94a3b8;font-size:10px">${x.score != null ? x.score : '—'}</span></div>
            <div style="font-size:9px;color:#94a3b8">${x.action || ''}${x.reason ? ' · ' + x.reason : ''}</div>
          </div>`).join('')}
          ${(ai.worst||[]).slice(0,3).map(x=>`<div style="background:#0f172a;border:1px solid #1e293b;border-radius:5px;padding:6px 8px;min-width:170px">
            <div style="font-weight:800;color:#ef4444">${x.symbol || '—'} <span style="color:#94a3b8;font-size:10px">${x.score != null ? x.score : '—'}</span></div>
            <div style="font-size:9px;color:#94a3b8">${x.action || ''}${x.reason ? ' · ' + x.reason : ''}</div>
          </div>`).join('')}
        </div>
      </div>`:''}

      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <!-- By strategy -->
        <div class="card" style="padding:12px;flex:1;min-width:300px">
          <div class="card-title">By Strategy</div>
          <table class="data-tbl" style="font-size:11px">
            <thead><tr><th>Type</th><th class="text-end">Trades</th><th class="text-end">Win%</th><th class="text-end">Total P&L</th><th class="text-end">Avg P&L</th></tr></thead>
            <tbody>${stratRows}</tbody>
          </table>
        </div>
        <!-- By symbol -->
        <div class="card" style="padding:12px;flex:1;min-width:260px">
          <div class="card-title">By Symbol (top 10)</div>
          <table class="data-tbl" style="font-size:11px">
            <thead><tr><th>Symbol</th><th class="text-end">Trades</th><th class="text-end">Win%</th><th class="text-end">Total P&L</th></tr></thead>
            <tbody>${symRows}</tbody>
          </table>
        </div>
        <!-- By DTE -->
        <div class="card" style="padding:12px;min-width:200px">
          <div class="card-title">By DTE at Entry</div>
          ${Object.entries(d.by_dte_bucket||{}).map(([k,v])=>{
            const tot=v.wins+v.losses; const wr=tot?Math.round(v.wins/tot*100):0;
            const c=wr>=60?'#22c55e':wr>=50?'#f59e0b':'#ef4444';
            return `<div style="display:flex;justify-content:space-between;align-items:center;
              padding:5px 0;border-bottom:1px solid var(--border)">
              <span style="font-size:12px">${k}d</span>
              <span style="font-size:12px;color:var(--muted)">${tot} trades</span>
              <span style="font-size:13px;font-weight:700;color:${c}">${wr}%</span>
            </div>`;
          }).join('')}
        </div>
      </div>`;
  } catch(e) { el.innerHTML=`<span style="color:var(--red)">Error: ${e.message}</span>`; }
}

function _renderTradeCard(t) {
  const isCredit = ['PS','CS','IC'].includes(t.trade_type);
  const ep  = parseFloat(t.entry_price||0);
  const epDisplay = fmtMoney2(ep);
  // Prefer leg-derived size so old rows with stale quantity values render correctly
  let qty = parseInt(t.quantity||1);
  try {
    const legs0 = JSON.parse(t.legs_json||'[]');
    const inferredQty = _jrnInferQtyFromLegs(legs0);
    if (inferredQty > 0) qty = inferredQty;
    if (t.trade_type==='Stock') {
      const sl = legs0.find(l=>l.option_type==='stock');
      if (sl && parseInt(sl.qty||0) > qty) qty = parseInt(sl.qty);
    }
  } catch(e) {}
  const dte = _jrnDateOnlyDte(t.expiry);
  const ttC = {PS:'#22c55e',CS:'#ef4444',IC:'#a855f7',PB:'#4ade80',CB:'#f87171',Stock:'#3b82f6'}[t.trade_type]||'#64748b';
  const isIC = t.trade_type==='IC';

  // Strikes / Legs display
  let strikesStr='';
  // For ALL trade types: show full leg detail if legs_json available
  const _tryShowLegs = (legsJson, fallback) => {
    try {
      const _legs = JSON.parse(legsJson||'[]');
      if (!_legs.length) return fallback;
      return _legs.map(l=>{
        const lC = l.option_type==='call'?'#ef4444':l.option_type==='put'?'#22c55e':'#3b82f6';
        const sI = l.side==='sell'?'●':'○';
        if (l.option_type==='stock')
          return `<span style="color:#3b82f6;font-size:12px">${sI}STK</span>`;
        const sp = l.strike ? parseFloat(l.strike) : null;
        const typeChar = l.option_type==='call'?'C':l.option_type==='put'?'P':'?';
        const strikeStr = sp ? `$${sp%1===0?sp:sp.toFixed(1)}` : '?';
        return `<span style="color:${lC};font-size:12px">${sI}${typeChar}${strikeStr}</span>`;
      }).join('<span style="color:var(--muted);margin:0 2px">·</span>');
    } catch(e) { return fallback; }
  };

  if (t.trade_type==='Stock') {
    strikesStr = _tryShowLegs(t.legs_json, `${t.quantity||1} shares @ $${parseFloat(t.entry_price||0).toFixed(2)}`);
  } else if (t.legs_json) {
    // Multi-leg trades with legs_json (IC, CC, CP, spreads, etc.)
    strikesStr = _tryShowLegs(t.legs_json, '');
    if (!strikesStr && isIC && t.put_sell)
      strikesStr=`P:${t.put_sell}/${t.put_buy}·C:${t.call_sell}/${t.call_buy}`;
  } else if (isIC && t.put_sell && t.call_sell) {
    strikesStr=`P:${t.put_sell}/${t.put_buy}·C:${t.call_sell}/${t.call_buy}`;
  } else if (false && t.legs_json) {  // dead code - kept for ref
    try {
      const legs3 = JSON.parse(t.legs_json);
      if (legs3.length) strikesStr = legs3.map(l=>{
        const lC=l.option_type==='call'?'#ef4444':l.option_type==='put'?'#22c55e':'#3b82f6';
        const sI=l.side==='sell'?'●':'○';
        if (l.option_type==='stock')
          return `<span style="color:#3b82f6;font-size:12px">${sI}${l.qty}sh@$${parseFloat(l.price||0).toFixed(2)}</span>`;
        const strikeDisplay = l.strike ? `$${parseFloat(l.strike).toFixed(l.strike%1===0?0:1)}` : '?';
        const typeChar = l.option_type==='call'?'C':l.option_type==='put'?'P':'?';
        return `<span style="color:${lC};font-size:12px">${sI}${typeChar}${strikeDisplay}${l.entry_price||l.price?'@$'+(parseFloat(l.entry_price||l.price||0).toFixed(2)):''}${l.qty>1?' ×'+l.qty:''}</span>`;
      }).join('<span style="color:var(--muted);margin:0 2px">·</span>');
    } catch(e) {}
  }
  if (!strikesStr)
    strikesStr=[t.short_strike?`S:$${t.short_strike}`:'',t.long_strike?`L:$${t.long_strike}`:''].filter(Boolean).join('/');

  // Risk/Reward
  const width = isIC
    ? (t.put_sell&&t.put_buy?Math.abs(parseFloat(t.put_sell)-parseFloat(t.put_buy)):0)
    : (t.short_strike&&t.long_strike?Math.abs(parseFloat(t.short_strike)-parseFloat(t.long_strike)):0);
  const isStock2 = t.trade_type==='Stock';
  const netPts = _jrnNetPremiumPoints(t);
  // netPts = total net premium for ALL qty contracts (e.g. 2x $2.5 = 5.0 total)
  // per-contract point value:
  const premPerContract = Math.abs((netPts || 0) / Math.max(qty, 1));
  const premAbs = Math.abs(netPts || 0); // total points across all contracts
  const creditLike = netPts >= 0;
  // max gain/loss per contract (in points), dollar = per_contract * qty * 100
  const maxGainPts = isStock2
    ? null
    : (width > 0
        ? (creditLike ? premPerContract : Math.max(0, width - premPerContract))
        : premPerContract);
  const maxLossPts = isStock2
    ? null
    : (width > 0
        ? (creditLike ? Math.max(0, width - premPerContract) : premPerContract)
        : (creditLike ? null : premPerContract));
  // Sanity-check: if maxGainPts > 100 it was almost certainly entered in dollars
  // (options prices in points are rarely > $50, never > $100 for spreads)
  const isBadEntry = !isStock2 && maxGainPts != null && maxGainPts > 100;
  const maxGain = isStock2
    ? '∞'
    : (maxGainPts != null
        ? (isBadEntry
            ? `⚠ check entry ($${Math.round(maxGainPts * qty * 100).toFixed(0)})`
            : `${maxGainPts.toFixed(2)} pts ($${Math.round(maxGainPts * qty * 100).toFixed(0)})`)
        : '—');
  const maxLoss = isStock2
    ? `${(ep*qty).toFixed(2)} pts ($${Math.round(ep*qty*100).toFixed(0)})`
    : (maxLossPts != null
        ? (isBadEntry
            ? `⚠ check entry ($${Math.round(maxLossPts * qty * 100).toFixed(0)})`
            : `${maxLossPts.toFixed(2)} pts ($${Math.round(maxLossPts * qty * 100).toFixed(0)})`)
        : '—');

  // Outlook
  const ol  = (t.outlook||'').toUpperCase();
  const olC = ol.includes('WINNER')?'#22c55e':ol.includes('LOSER')?'#ef4444':ol.includes('ITM')?'#f59e0b':ol.includes('OTM')?'#64748b':'var(--muted)';
  const olShort = ol.includes('PROJECTED WINNER')?'✅ P.WIN'
    :ol.includes('LOSER (PUT')?'🔴 PUT↓'
    :ol.includes('LOSER (CALL')?'🔴 CALL↑'
    :ol.includes('PROJECTED LOSER')?'🔴 P.LOSE'
    :ol.includes('PUT ITM')?'⚠ PUT ITM'
    :ol.includes('CALL ITM')?'⚠ CALL ITM'
    :ol.includes('ITM')?'⚠ ITM'
    :ol.includes('OTM')?'◌ OTM'
    :(t.outlook||'—');

  // P&L
  const rowPnl = t.current_pnl!=null?parseFloat(t.current_pnl):null;
  const pnlStr = rowPnl!=null?`${rowPnl>=0?'+':''}$${Math.abs(rowPnl).toFixed(0)}`:'—';
  const pnlC   = rowPnl!=null?(rowPnl>=0?'#22c55e':'#ef4444'):'var(--muted)';
  const pnlSign= rowPnl!=null?(rowPnl>=0?'↑':'↓'):'';

  // Trade Health Score — from DB cache
  const scoreRaw = t.prob_score!=null ? parseInt(t.prob_score) : null;
  const score = (scoreRaw!=null && scoreRaw>0) ? scoreRaw : null;
  const scoreC= score==null?'#64748b':score>=75?'#22c55e':score>=58?'#4ade80':score>=42?'#f59e0b':score>=28?'#f97316':'#ef4444';
  // Score ring: arc gauge visual
  const scoreHtml = score!=null ? (() => {
    const pct = score/100; const r=14; const circ=2*Math.PI*r;
    const dash=circ*pct; const gap=circ*(1-pct);
    const lbl=score>=75?'💚':score>=55?'🟡':score>=35?'🟠':'🔴';
    return `<div style="display:flex;flex-direction:column;align-items:center;gap:1px;cursor:pointer" onclick="event.stopPropagation();_jrnFetchLive(${t.id})" title="Trade Health Score — click to refresh">
      <svg width="34" height="34" viewBox="0 0 34 34">
        <circle cx="17" cy="17" r="${r}" fill="none" stroke="var(--border)" stroke-width="3"/>
        <circle cx="17" cy="17" r="${r}" fill="none" stroke="${scoreC}" stroke-width="3"
          stroke-dasharray="${dash.toFixed(1)} ${gap.toFixed(1)}"
          stroke-linecap="round" transform="rotate(-90 17 17)"/>
        <text x="17" y="21" text-anchor="middle" font-size="9" font-weight="700" fill="${scoreC}">${score}</text>
      </svg>
    </div>`;
  })() : `<span style="font-size:9px;color:var(--muted);cursor:pointer" onclick="event.stopPropagation();_jrnFetchLive(${t.id})" title="Click to compute Trade Health Score">📡<br><span style="font-size:8px">health</span></span>`;

  // Action pill — HOLD/ADD/TRIM/HEDGE/EXIT from DB
  const ACTION_COLORS = {HOLD:'#22c55e',ADD:'#3b82f6',TRIM:'#a78bfa',HEDGE:'#f97316',EXIT:'#ef4444'};
  const rec = t.analytics_rec||'';
  // Detect action: analytics_rec stores the trade_action (HOLD/ADD/TRIM/HEDGE/EXIT)
  const actionKey = ['EXIT','TRIM','HEDGE','ADD','HOLD'].find(k => rec.toUpperCase().includes(k)) || '';
  const recC = ACTION_COLORS[actionKey] || '#64748b';

  // Parse analytics_json for suggestions & signals
  let topSugg = '';
  let signalChips = '';
  try {
    const aj = JSON.parse(t.analytics_json||'{}');
    const suggs = aj.suggestions||[];
    if (suggs.length) {
      const s = suggs[0];
      const typeColors = {EXIT:'#ef4444',TRIM:'#a78bfa',HEDGE:'#f97316',ROLL:'#f59e0b',ADD:'#3b82f6',HOLD:'#22c55e'};
      const sc2 = typeColors[s.type]||'#22c55e';
      topSugg = `<div style="font-size:9px;color:${sc2};margin-top:2px;white-space:normal;line-height:1.3">
        <b>${s.type}${s.priority==='HIGH'?' ❗':''}</b>: ${(s.text||'').slice(0,72)}${s.text&&s.text.length>72?'…':''}
      </div>`;
    }
    const pnrBreached = aj.pnr_breached;
    if (pnrBreached && !topSugg) {
      topSugg=`<div style="font-size:9px;color:#ef4444;margin-top:2px">⚠ ${aj.pnr_status||'PNR breached'}</div>`;
    }
    // Signal chips: regime / IV / OI
    const sfs = aj.signal_factors||[];
    if (sfs.length) {
      signalChips = '<div style="display:flex;gap:3px;flex-wrap:wrap;margin-top:3px">' +
        sfs.map(sf => {
          const dc = sf.delta>0?'#22c55e':sf.delta<0?'#ef4444':'#64748b';
          return `<span style="background:${dc}18;border:1px solid ${dc}44;color:${dc};font-size:8px;padding:1px 4px;border-radius:3px;font-weight:600" title="${sf.note||sf.value}">${sf.label}</span>`;
        }).join('') + '</div>';
    }
  } catch(e) {}

  const actionBadge = actionKey
    ? `<div style="display:inline-block;background:${recC}22;border:1px solid ${recC}66;color:${recC};font-size:10px;font-weight:800;padding:2px 7px;border-radius:4px;letter-spacing:0.5px;cursor:pointer" onclick="event.stopPropagation();_jrnFetchLive(${t.id})" title="Click to refresh">${actionKey}</div>`
    : `<span style="font-size:9px;color:var(--muted);cursor:pointer" onclick="event.stopPropagation();_jrnFetchLive(${t.id})">📡 analyze</span>`;

  const analyticsHtml = `<div style="line-height:1.4">
    ${actionBadge}
    ${topSugg}
    ${signalChips}
  </div>`;


  // Entry Score — from DB trade.entry_score / entry_grade
  const entryScoreHtml = (() => {
    const es = t.entry_score != null ? parseInt(t.entry_score) : null;
    const eg = t.entry_grade || '';
    const er = t.entry_recommendation || '';
    if (es == null) return `<span style="color:var(--muted);font-size:9px;cursor:pointer" onclick="event.stopPropagation();_jrnFetchSnapshot(${t.id})">📸 entry</span>`;
    const ec = es>=80?'#22c55e':es>=65?'#4ade80':es>=50?'#f59e0b':es>=35?'#f97316':'#ef4444';
    const recC2 = er==='OPEN'?'#22c55e':er==='OPEN_SMALL'?'#f59e0b':'#ef4444';
    return `<div style="display:flex;flex-direction:column;align-items:center;gap:1px;cursor:pointer" onclick="event.stopPropagation();_jrnOpenDelta(${t.id})" title="Entry Quality Score — click for replay">
      <div style="background:${ec}22;border:1px solid ${ec}66;border-radius:4px;padding:2px 6px;min-width:30px;text-align:center">
        <div style="font-size:11px;font-weight:800;color:${ec}">${eg}</div>
        <div style="font-size:9px;color:${ec}">${es}</div>
      </div>
      <div style="font-size:8px;color:${recC2};font-weight:600;margin-top:1px">${er}</div>
    </div>`;
  })();

  const dteStyle = dte<=2?'color:#ef4444;font-weight:700':dte<=7?'color:#f59e0b':'';
  let pnrTxt = '—';
  let pnrColor = 'var(--muted)';
  try {
    const aj = JSON.parse(t.analytics_json||'{}');
    const breached = !!aj.pnr_breached;
    if (aj && (aj.pnr != null || aj.pnr_upper != null)) {
      const low = aj.pnr != null ? `$${(+aj.pnr).toFixed(2)}↓` : '';
      const high = aj.pnr_upper != null ? `${low ? ' / ' : ''}$${(+aj.pnr_upper).toFixed(2)}↑` : '';
      pnrTxt = `${low}${high}` || '—';
      pnrColor = breached ? '#ef4444' : '#22c55e';
    }
  } catch (e) {}
  const spotStr  = t.spot_price ? `$${t.spot_price}` : '—';
  const spotHtml = `<div style="line-height:1.25"><div>${spotStr}</div><div style="font-size:9px;color:${pnrColor};font-weight:700">PNR: ${pnrTxt}</div></div>`;

  return `<tr id="jrn-row-${t.id}" style="border-bottom:1px solid var(--border);vertical-align:top" id="jrn-row-${t.id}">
    <td style="font-weight:800;white-space:nowrap;padding:5px 6px;vertical-align:middle"><a href="#" onclick="event.preventDefault();event.stopPropagation();_jrnOpenDashboardForTrade('${String(t.symbol||'').replace(/'/g,"\'")}', '${String(t.expiry||'').replace(/'/g,"\'")}')" title="Open Dashboard for ${t.symbol || ''} ${t.expiry || ''}" style="color:var(--accent);text-decoration:none;border-bottom:1px dotted var(--accent)">${t.symbol}</a></td>
    <td style="padding:4px;vertical-align:middle"><span style="background:${ttC}22;border:1px solid ${ttC}44;color:${ttC};padding:1px 5px;border-radius:3px;font-size:10px;font-weight:700">${t.trade_type}</span></td>
    <td style="padding:4px;vertical-align:middle;max-width:260px;white-space:normal;word-break:break-word;font-size:12px;line-height:1.4">${strikesStr}</td>
    <td style="font-size:10px;white-space:nowrap;padding:4px 6px;vertical-align:middle">${t.expiry||'?'}</td>
    <td style="${dteStyle};font-size:11px;text-align:center;padding:4px;vertical-align:middle">${dte}d</td>
    <td style="font-size:11px;padding:4px 6px;vertical-align:middle">${spotHtml}</td>
    <td style="font-size:12px;font-weight:700;color:var(--green);padding:4px 6px;vertical-align:middle">$${Number.isFinite(ep)?ep.toFixed(2):'0.00'}</td>
    <td style="font-size:11px;padding:4px;vertical-align:middle">${qty}x</td>
    <td style="font-size:11px;color:#22c55e;padding:4px;vertical-align:middle">${maxGain}</td>
    <td style="font-size:11px;color:#ef4444;padding:4px;vertical-align:middle">${maxLoss}</td>
    <td style="font-size:11px;font-weight:700;color:${pnlC};padding:4px 6px;vertical-align:middle">${pnlSign}${pnlStr}</td>
    <td style="font-size:10px;color:var(--muted);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:4px 6px;vertical-align:middle" title="${t.entry_reason||''}">${t.entry_reason||'—'}</td>
    <td style="padding:4px 6px;vertical-align:middle">
      <span style="font-size:10px;font-weight:700;color:${olC};white-space:nowrap" data-outlook="${ol}">${olShort}</span>
    </td>
    <td style="padding:4px 6px;vertical-align:middle">${scoreHtml}</td>
    <td style="padding:4px 6px;vertical-align:middle">${entryScoreHtml}</td>
    <td style="padding:4px 6px;max-width:200px;vertical-align:top">${analyticsHtml}</td>
    <td style="padding:4px 6px;vertical-align:middle;min-width:160px">
      <div style="display:flex;gap:4px;flex-wrap:nowrap;align-items:center">
      <button title="Live P&L" onclick="event.stopPropagation();_jrnFetchLive(${t.id})"
        style="background:#1e3a8a;color:#93c5fd;border:1px solid #2563eb;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap">📡</button>
      <button title="Structure Replay — Entry vs Now" onclick="event.stopPropagation();_jrnOpenDelta(${t.id})"
        style="background:#134e4a;color:#5eead4;border:1px solid #0d9488;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap" title="Structure Replay">🔁</button>
      <button title="Edit / Adjust" onclick="event.stopPropagation();_jrnOpenEdit(${t.id})"
        style="background:#854d0e;color:#fde68a;border:1px solid #ca8a04;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap">✏️</button>
      <button title="Payoff Analysis" onclick="event.stopPropagation();_jrnOpenAnalysis(${t.id})"
        style="background:#3730a3;color:#c4b5fd;border:1px solid #6366f1;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap">📐</button>

      <button title="Close Trade" onclick="event.stopPropagation();_jrnOpenClose(${t.id})"
        style="background:#14532d;color:#86efac;border:1px solid #16a34a;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap">✅&nbsp;Close</button>
      <button title="Roll / Split Trade" onclick="event.stopPropagation();_jrnOpenClose(${t.id}, 'roll')"
        style="background:#713f12;color:#fde68a;border:1px solid #f59e0b;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap">Roll</button>
      <button title="Delete" onclick="event.stopPropagation();_jrnDelete(${t.id})"
        style="background:#7f1d1d;color:#fca5a5;border:1px solid #dc2626;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap">🗑</button>
      </div>
    </td>
    <td id="jrn-live-${t.id}" style="font-size:10px;padding:4px 6px;max-width:260px;vertical-align:top"></td>
  </tr>`;
}

function _jrnRowClick(row) {
  // Toggle highlight
  row.classList.toggle('selected-row');
}



// JOURNAL — Live P&L, Close, Roll, Delete, Add

async function _jrnFetchLive(tid) {
  const el = document.getElementById(`jrn-live-${tid}`);
  if (!el) return;
  el.innerHTML = '<span style="color:var(--muted);font-size:10px">⏳ fetching…</span>';
  try {
    const d = await api(`/journal/trade/${tid}/live`);
    const pnlC  = (d.unrealised_pnl||0) >= 0 ? '#22c55e' : '#ef4444';
    const urgC  = d.urgency==='critical'?'#ef4444':d.urgency==='high'?'#f97316':d.urgency==='medium'?'#f59e0b':'#22c55e';
    const markStr = d.current_mark != null ? `<b>$${d.current_mark}</b>` : '—';
    const pnlStr  = d.unrealised_pnl != null
      ? `<span style="color:${pnlC};font-weight:700">${d.unrealised_pnl>=0?'+':''}$${d.unrealised_pnl.toFixed(0)}</span>` : '—';
    const pctStr  = d.pct_of_max_profit != null
      ? `<span style="color:${d.pct_of_max_profit>=50?'#22c55e':d.pct_of_max_profit>=0?'#f59e0b':'#ef4444'}">${d.pct_of_max_profit}%</span>` : '';
        // PNR display — direction-aware
    let pnrHtml = '';
    if (d.pnr || d.pnr_upper) {
      const pc = d.pnr_breached ? '#ef4444' : '#22c55e';
      const pnrTxt = (d.pnr && d.pnr_upper)
        ? `$${d.pnr}↓/$${d.pnr_upper}↑`
        : d.pnr ? `$${d.pnr}↓` : `$${d.pnr_upper}↑`;
      pnrHtml = `PNR:<b style="color:${pc}">${pnrTxt}</b>${d.pnr_breached?' ⚠':''} · `;
    }
    const olC2 = (d.outlook||'').includes('WINNER')?'#22c55e':(d.outlook||'').includes('LOSER')?'#ef4444':'#f59e0b';
    const aiPlan = d.ai_action_mode ? `<div style="background:#07101d;border:1px solid #1f2937;border-radius:6px;padding:6px 8px;margin-top:4px">
      <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:2px">
        <div style="font-size:9px;font-weight:800;color:#93c5fd">🤖 AI</div>
        <div style="font-size:9px;color:#a5b4fc;font-weight:800">${_posAlertEscape(d.ai_action_mode || 'HOLD')}</div>
      </div>
      <div style="font-size:9px;color:#e2e8f0;line-height:1.35">${_posAlertEscape((d.ai_roll_side ? d.ai_roll_side + ' side ' : '') + (d.ai_roll_expiry ? '→ ' + d.ai_roll_expiry : '') + (d.ai_roll_strategy ? ' · ' + d.ai_roll_strategy : ''))}</div>
      ${d.ai_action_text ? `<div style="font-size:9px;color:#94a3b8;line-height:1.35;margin-top:2px">${_posAlertEscape(d.ai_action_text)}</div>` : ''}
    </div>` : '';

    // Probability score gauge
    // Trade Health Score gauge (live fetch panel)
    const ths = d.trade_health_score || d.probability_score || 0;
    const thsC = ths>=75?'#22c55e':ths>=58?'#4ade80':ths>=42?'#f59e0b':ths>=28?'#f97316':'#ef4444';
    const thsR=16; const thsCirc=2*Math.PI*thsR;
    const thsDash=(thsCirc*ths/100).toFixed(1); const thsGap=(thsCirc*(1-ths/100)).toFixed(1);
    const thsGauge = `<svg width="44" height="44" viewBox="0 0 44 44" style="flex-shrink:0">
      <circle cx="22" cy="22" r="${thsR}" fill="none" stroke="#1e293b" stroke-width="4"/>
      <circle cx="22" cy="22" r="${thsR}" fill="none" stroke="${thsC}" stroke-width="4"
        stroke-dasharray="${thsDash} ${thsGap}" stroke-linecap="round" transform="rotate(-90 22 22)"/>
      <text x="22" y="26" text-anchor="middle" font-size="10" font-weight="800" fill="${thsC}">${ths}</text>
    </svg>`;

    // 5-action pill
    const ACT_CLRS = {HOLD:'#22c55e',ADD:'#3b82f6',TRIM:'#a78bfa',HEDGE:'#f97316',EXIT:'#ef4444'};
    const liveAction = d.trade_action || d.recommendation || '';
    const liveActKey = ['EXIT','TRIM','HEDGE','ADD','HOLD'].find(k=>liveAction.toUpperCase().includes(k))||liveAction;
    const liveActC = ACT_CLRS[liveActKey]||'#f59e0b';
    const actionPill = `<div style="display:inline-block;background:${liveActC}22;border:1.5px solid ${liveActC};color:${liveActC};font-size:13px;font-weight:900;padding:3px 12px;border-radius:6px;letter-spacing:1px">${liveActKey||'HOLD'}</div>`;

    // Signal factors (RS/IV/OI)
    const sigFactors = (d.signal_factors||[]).map(sf => {
      const dc=sf.delta>0?'#22c55e':sf.delta<0?'#ef4444':'#94a3b8';
      const arr=sf.delta>0?'▲':sf.delta<0?'▼':'—';
      return `<div style="display:flex;justify-content:space-between;font-size:9px;padding:2px 0;border-bottom:1px solid #1e293b">
        <span style="color:#94a3b8">${sf.label}</span>
        <span style="color:${dc};font-weight:700">${arr} ${sf.value}</span>
      </div>`;
    }).join('');
    const sigPanel = sigFactors ? `<div style="background:#0f172a;border:1px solid #1e293b;border-radius:4px;padding:4px 8px;margin-top:4px">${sigFactors}</div>` : '';

    // Score notes
    const notesHtml = (d.probability_notes||[]).map(n=>`<div style="font-size:9px;color:#94a3b8;padding:1px 0">· ${n}</div>`).join('');

    // Suggestions
    const suggs = (d.suggestions||[]).slice(0,3).map(s => {
      const typeColors = {EXIT:'#ef4444',TRIM:'#a78bfa',HEDGE:'#f97316',ROLL:'#f59e0b',ADD:'#3b82f6',HOLD:'#22c55e'};
      const sc2 = typeColors[s.type]||'#22c55e';
      return `<div style="background:${sc2}18;border-left:2px solid ${sc2};padding:3px 6px;margin-top:3px;font-size:9px;border-radius:0 3px 3px 0">
        <b style="color:${sc2}">${s.type}</b>${s.priority==='HIGH'?' ❗':''} · ${s.text}
      </div>`;
    }).join('');

    el.innerHTML = `
      <div style="font-size:10px;line-height:1.6;padding:4px 0;max-width:360px">
        <!-- Header: gauge + action pill + PnL -->
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px">
          ${thsGauge}
          <div style="flex:1">
            <div style="margin-bottom:3px">${actionPill}</div>
            <div style="font-size:9px;color:${liveActC};line-height:1.3">${d.rec_reason||''}</div>
          </div>
        </div>
        <!-- P&L row -->
        <div style="display:flex;gap:10px;font-size:10px;margin-bottom:2px;flex-wrap:wrap">
          <span>Spot:<b>$${d.spot||'—'}</b></span>
          <span>Mark:<b>${d.current_mark!=null?'$'+d.current_mark:'—'}</b></span>
          <span style="color:${(d.unrealised_pnl||0)>=0?'#22c55e':'#ef4444'};font-weight:700">${d.unrealised_pnl!=null?(d.unrealised_pnl>=0?'+':'')+'$'+d.unrealised_pnl.toFixed(0):'—'}</span>
          ${d.pct_of_max_profit!=null?`<span style="color:${d.pct_of_max_profit>=50?'#22c55e':d.pct_of_max_profit>=0?'#f59e0b':'#ef4444'}">${d.pct_of_max_profit}% of max</span>`:''}
        </div>
        <!-- PNR -->
        ${(d.pnr||d.pnr_upper)?`<div style="font-size:9px;color:${d.pnr_breached?'#ef4444':'#22c55e'};margin-bottom:2px">PNR: ${d.pnr?'$'+d.pnr+'↓':''} ${d.pnr_upper?'$'+d.pnr_upper+'↑':''} ${d.pnr_breached?'⚠ BREACHED':''}</div>`:''}
        <!-- AI plan -->
        ${aiPlan}
        <!-- Signal factors panel -->
        ${sigPanel}
        <!-- Score notes -->
        <div style="margin-top:3px">${notesHtml}</div>
        <!-- Suggestions -->
        ${suggs}
      </div>`;
    // Update score and analytics columns inline without full reload
    const spotCell = document.querySelector(`#jrn-row-${tid} td:nth-child(6)`);
    const pnlCell  = document.querySelector(`#jrn-row-${tid} td:nth-child(11)`);
    const olCell   = document.querySelector(`#jrn-row-${tid} span[data-outlook]`);
    const scoreCol = document.querySelector(`#jrn-row-${tid} td:nth-child(14)`);
    const analyticsCol = document.querySelector(`#jrn-row-${tid} td:nth-child(15)`);
    if (spotCell) {
      let pnrHtml = '';
      if (d.pnr || d.pnr_upper) {
        const pc = d.pnr_breached ? '#ef4444' : '#22c55e';
        const pnrTxt = (d.pnr && d.pnr_upper)
          ? `$${d.pnr}↓/$${d.pnr_upper}↑`
          : d.pnr ? `$${d.pnr}↓` : `$${d.pnr_upper}↑`;
        pnrHtml = `<div style="font-size:9px;color:${pc};font-weight:700">PNR: ${pnrTxt}${d.pnr_breached?' ⚠':''}</div>`;
      }
      spotCell.innerHTML = `<div style="line-height:1.25"><div>${d.spot != null ? '$'+d.spot : '—'}</div>${pnrHtml}</div>`;
    }
    if (pnlCell && d.unrealised_pnl != null) {
      const sign = d.unrealised_pnl>=0?'↑':'↓';
      pnlCell.textContent = sign+'$'+Math.abs(d.unrealised_pnl).toFixed(0);
      pnlCell.style.color = pnlC;
    }
    if (olCell && d.outlook) {
      // Update outlook short label
      const ol3 = (d.outlook||'').toUpperCase();
      const olShort3 = ol3.includes('PROJECTED WINNER')?'✅ P.WIN'
        :ol3.includes('LOSER (PUT')?'🔴 PUT↓'
        :ol3.includes('LOSER (CALL')?'🔴 CALL↑'
        :ol3.includes('PROJECTED LOSER')?'🔴 P.LOSE'
        :ol3.includes('PUT ITM')?'⚠ PUT ITM'
        :ol3.includes('CALL ITM')?'⚠ CALL ITM'
        :ol3.includes('ITM')?'⚠ ITM'
        :ol3.includes('OTM')?'◌ OTM':d.outlook;
      olCell.textContent = olShort3;
      olCell.setAttribute('data-outlook', ol3);
      olCell.style.color = ol3.includes('WINNER')?'#22c55e':ol3.includes('LOSER')?'#ef4444':'#f59e0b';
    }
    // Update score column
    // Update Trade Health Score column (ring gauge)
    if (scoreCol) {
      const ps2 = d.trade_health_score || d.probability_score || 0;
      const pc2=ps2>=75?'#22c55e':ps2>=58?'#4ade80':ps2>=42?'#f59e0b':ps2>=28?'#f97316':'#ef4444';
      const r2=14,c2=2*Math.PI*r2,d2=(c2*ps2/100).toFixed(1),g2=(c2*(1-ps2/100)).toFixed(1);
      scoreCol.innerHTML=`<div style="display:flex;flex-direction:column;align-items:center;gap:1px">
        <svg width="34" height="34" viewBox="0 0 34 34">
          <circle cx="17" cy="17" r="${r2}" fill="none" stroke="var(--border)" stroke-width="3"/>
          <circle cx="17" cy="17" r="${r2}" fill="none" stroke="${pc2}" stroke-width="3"
            stroke-dasharray="${d2} ${g2}" stroke-linecap="round" transform="rotate(-90 17 17)"/>
          <text x="17" y="21" text-anchor="middle" font-size="9" font-weight="700" fill="${pc2}">${ps2}</text>
        </svg>
      </div>`;
    }
    // Update analytics column (action badge + signal chips)
    if (analyticsCol && d.trade_action) {
      const ACT_CLRS2={HOLD:'#22c55e',ADD:'#3b82f6',TRIM:'#a78bfa',HEDGE:'#f97316',EXIT:'#ef4444'};
      const ak2=d.trade_action;
      const ac2=ACT_CLRS2[ak2]||'#f59e0b';
      const sugg2=(d.suggestions||[]).slice(0,1).map(s=>{
        const tc={EXIT:'#ef4444',TRIM:'#a78bfa',HEDGE:'#f97316',ROLL:'#f59e0b',ADD:'#3b82f6',HOLD:'#22c55e'};
        const sc3=tc[s.type]||'#22c55e';
        return `<div style="font-size:9px;color:${sc3};margin-top:2px;line-height:1.3"><b>${s.type}${s.priority==='HIGH'?' ❗':''}</b>: ${(s.text||'').slice(0,68)}${s.text&&s.text.length>68?'…':''}</div>`;
      }).join('');
      const sfs2=(d.signal_factors||[]).map(sf=>{const dc=sf.delta>0?'#22c55e':sf.delta<0?'#ef4444':'#64748b';return `<span style="background:${dc}18;border:1px solid ${dc}44;color:${dc};font-size:8px;padding:1px 3px;border-radius:3px">${sf.label}</span>`;}).join(' ');
      analyticsCol.innerHTML=`<div style="line-height:1.4">
        <div style="display:inline-block;background:${ac2}22;border:1px solid ${ac2}66;color:${ac2};font-size:10px;font-weight:800;padding:2px 7px;border-radius:4px">${ak2}</div>
        ${sugg2}
        ${sfs2?'<div style="display:flex;gap:2px;flex-wrap:wrap;margin-top:3px">'+sfs2+'</div>':''}
      </div>`;
    }
    // Save live P&L to DB for persistence
    try {
      await api(`/journal/trade/${tid}/live_pnl`, {method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          live_pnl: d.unrealised_pnl,
          live_pnl_pct: d.pct_of_max,
          live_spot: d.spot,
          updated: new Date().toISOString().slice(0,16)
        })
      });
    } catch {}
    _loadPortfolioHeader();
    return d;
  } catch(e) {
    // If live fetch fails, show saved data from DB instead
    try {
      const saved = await api(`/journal/trade/${tid}/live_pnl`);
      if (saved.live_pnl != null) {
        const pC = saved.live_pnl >= 0 ? '#22c55e' : '#ef4444';
        el.innerHTML = `<div style="font-size:10px;color:var(--muted)">⚡ Saved: <b style="color:${pC}">${saved.live_pnl >= 0 ? '+' : ''}$${saved.live_pnl.toFixed(2)}</b> @ $${saved.live_spot||'—'} <span style="font-size:9px">(${(saved.live_updated||'').slice(0,10)})</span></div>`;
        return;
      }
    } catch {}
    el.innerHTML = `<span style="color:var(--red);font-size:10px">❌ ${e.message}</span>`;
  }
}

async function jrnRefreshAll() {
  const s = document.getElementById('jrn-status');
  if (s) s.innerHTML = '⏳ Refreshing…';
  try {
    const results = await api('/journal/trades/refresh_all', {method:'POST'});
    if (typeof jrnLoadOpen === 'function') await jrnLoadOpen();
    if (typeof jrnLoadClosed === 'function' && document.getElementById('jrn-closed')?.style.display !== 'none') await jrnLoadClosed();
    if (typeof _loadPortfolioHeader === 'function') await _loadPortfolioHeader();
    if (s) s.innerHTML = `✅ Refreshed ${(results||[]).length} trades`;
  } catch(e) { if (s) s.innerHTML = `❌ ${e.message}`; }
}

_jrnCloseId = null;
_jrnRollId  = null;


function _jrnOpenEdit(tid) {
  const trade = window._jrnTrades?.find(t => t.id === tid);
  if (!trade) { alert('Trade not found'); return; }

  // Switch to Add Trade sub-tab
  jrnTab('add');

  // Wait for DOM to be ready
  setTimeout(() => {
    // Fill symbol
    const symEl = document.getElementById('jrn-add-symbol');
    if (symEl) symEl.value = trade.symbol || '';

    // Fill trade type
    const ttEl = document.getElementById('jrn-add-type');
    if (ttEl) {
      ttEl.value = trade.trade_type || 'PS';
      ttEl.dispatchEvent(new Event('change'));
    }

    // Fill entry date
    const dateEl = document.getElementById('jrn-add-entry-date');
    if (dateEl) dateEl.value = trade.entry_date || '';

    // Fill reason
    const reasonEl = document.getElementById('jrn-add-reason');
    if (reasonEl) reasonEl.value = (trade.entry_reason || '').replace(/^\[\w+\]\s*/, '');

    // Fill legs from legs_json
    try {
      const legs = JSON.parse(trade.legs_json || '[]');
      if (legs.length) {
        _jrnLegs = legs.map(l => ({
          side: l.side || 'buy',
          option_type: l.option_type || 'call',
          strike: l.strike || '',
          expiry: l.expiry || trade.expiry || '',
          qty: l.qty || 1,
          price: (() => { const _p = Number(l.price ?? l.entry_price); return Number.isFinite(_p) ? _p.toFixed(2) : ''; })(),
        }));
        _renderLegs();
      }
    } catch {}

    // Store the original trade ID so we can update instead of create
    window._jrnEditId = tid;

    // Show a banner indicating edit mode
    const banner = document.getElementById('jrn-edit-banner');
    if (banner) {
      banner.style.display = '';
      banner.innerHTML = `<span style="color:#f59e0b;font-weight:700">✏️ EDITING Trade #${tid} (${trade.symbol} ${trade.trade_type})</span>
        <button onclick="window._jrnEditId=null;this.parentElement.style.display='none'" class="btn btn-ghost" style="font-size:10px;padding:2px 6px;margin-left:8px">✕ Cancel Edit</button>`;
    }
  }, 200);
}



function _jrnCloseUnitQty(legs, trade) {
  try {
    const tq = parseInt(trade?.quantity || 0);
    if (Number.isFinite(tq) && tq > 0) return tq;
    if (typeof _jrnInferQtyFromLegs === 'function') return _jrnInferQtyFromLegs(legs || []);
    const optQtys = (legs || [])
      .filter(l => (l.option_type || '') !== 'stock')
      .map(l => Math.max(1, parseInt(l.qty || 1) || 1));
    return optQtys.length ? Math.max(1, Math.min(...optQtys)) : 1;
  } catch (e) { return 1; }
}

function _jrnNormalizeOptionPoints(v) {
  // Some older/edit flows stored option net premium as dollars (e.g. 250)
  // instead of option points (2.50).  The close modal must always work in
  // option points, then multiply by contract quantity and 100 once.
  const n = Number(v || 0);
  if (!Number.isFinite(n)) return 0;
  return Math.abs(n) > 50 ? n / 100 : n;
}

function _jrnCloseEntryNetPoints(legs, trade) {
  const qty = Math.max(1, _jrnCloseUnitQty(legs, trade));
  // Legs are the source of truth.  Entry net is always:
  //   sell leg prices - buy leg prices
  // in option points, not dollars.  For CAT CS: 44.01 - 41.51 = 2.50.
  let net = 0;
  let any = false;
  (legs || []).forEach(l => {
    const px = parseFloat(l.price ?? l.entry_price ?? 0);
    if (!Number.isFinite(px)) return;
    const lq = Math.max(1, parseInt(l.qty || 1) || 1);
    const side = String(l.side || '').toLowerCase();
    const mult = String(l.option_type || '').toLowerCase() === 'stock' ? 0 : 1;
    if (!mult) return;
    net += (side === 'sell' ? 1 : -1) * px * lq;
    any = true;
  });
  if (any && Math.abs(net) > 0.000001) return net / qty;

  const storedNet = parseFloat(trade?.net_premium);
  if (Number.isFinite(storedNet) && Math.abs(storedNet) > 0.000001) {
    return _jrnNormalizeOptionPoints(storedNet / qty);
  }
  const ep = _jrnNormalizeOptionPoints(parseFloat(trade?.entry_price || 0) || 0);
  const tt = String(trade?.trade_type || '').toUpperCase();
  // Positive means entry credit/cash received; negative means entry debit/cash paid.
  return ['PS','CS','IC','CC','CP','STRANGLE'].includes(tt) ? ep : -ep;
}

function _jrnCloseIsCreditStyle(tt, entryNet) {
  const key = String(tt || '').toUpperCase();
  if (['PS','CS','IC','CC','CP','STRANGLE'].includes(key)) return true;
  if (['CB','PB','STRADDLE','CALENDAR','BUTTERFLY'].includes(key)) return false;
  return Number(entryNet || 0) >= 0;
}

function _jrnClosePnlFromNetClose(netClose) {
  const entryNet = Number(window._jrnCloseEntryNet || 0);
  const entryAbs = Math.abs(entryNet) || Math.abs(_jrnNormalizeOptionPoints(Number(window._jrnCloseEp || 0)));
  const closePts = _jrnNormalizeOptionPoints(netClose);
  const qty = Math.max(1, parseInt(window._jrnCloseQty || 1) || 1);
  const isCredit = _jrnCloseIsCreditStyle(window._jrnCloseTT, entryNet);
  // Always sell price minus buy price, then qty, then 100.
  // Credit spread: entry sell credit - close buy debit.
  // Debit spread: close sell credit - entry buy debit.
  const raw = isCredit ? (entryAbs - closePts) : (closePts - entryAbs);
  return Math.round(raw * qty * 10000) / 100;
}

function _jrnCloseNetPreviewHtml(netClose, pnl) {
  const entryNet = Number(window._jrnCloseEntryNet || 0);
  const entryAbs = Math.abs(entryNet) || Math.abs(_jrnNormalizeOptionPoints(Number(window._jrnCloseEp || 0)));
  const closePts = _jrnNormalizeOptionPoints(netClose);
  const qty = Math.max(1, parseInt(window._jrnCloseQty || 1) || 1);
  const isCredit = _jrnCloseIsCreditStyle(window._jrnCloseTT, entryNet);
  const c = pnl >= 0 ? '#22c55e' : '#ef4444';
  const label = isCredit ? 'credit spread' : 'debit spread';
  const formula = isCredit
    ? `sell price ${entryAbs.toFixed(2)} - buy price ${closePts.toFixed(2)} = ${(entryAbs-closePts).toFixed(2)} × ${qty} × 100`
    : `sell price ${closePts.toFixed(2)} - buy price ${entryAbs.toFixed(2)} = ${(closePts-entryAbs).toFixed(2)} × ${qty} × 100`;
  return `P&L: <b style="font-size:16px;color:${c}">${pnl>=0?'+':''}$${pnl.toFixed(2)}</b>` +
         `<div style="font-size:10px;color:var(--muted);margin-top:2px">${label} · ${formula}</div>`;
}

function _jrnCloseActiveQty() {
  const maxQty = Math.max(1, parseInt(window._jrnCloseQty || 1) || 1);
  const el = document.getElementById('jrn-close-qty');
  if (!el || el.value === '') return maxQty;
  const q = Math.max(1, Math.min(maxQty, parseInt(el.value || maxQty) || maxQty));
  return q;
}

function _jrnClosePnlFromNetCloseQty(netClose, qty) {
  const entryNet = Number(window._jrnCloseEntryNet || 0);
  const entryAbs = Math.abs(entryNet) || Math.abs(_jrnNormalizeOptionPoints(Number(window._jrnCloseEp || 0)));
  const closePts = _jrnNormalizeOptionPoints(Number(netClose || 0));
  const q = Math.max(1, parseInt(qty || 1) || 1);
  const isCredit = _jrnCloseIsCreditStyle(window._jrnCloseTT, entryNet);
  const raw = isCredit ? (entryAbs - closePts) : (closePts - entryAbs);
  return Math.round(raw * q * 10000) / 100;
}

function _jrnCloseNetPreviewHtmlQty(netClose, pnl, qty) {
  const entryNet = Number(window._jrnCloseEntryNet || 0);
  const entryAbs = Math.abs(entryNet) || Math.abs(_jrnNormalizeOptionPoints(Number(window._jrnCloseEp || 0)));
  const closePts = _jrnNormalizeOptionPoints(netClose);
  const q = Math.max(1, parseInt(qty || 1) || 1);
  const isCredit = _jrnCloseIsCreditStyle(window._jrnCloseTT, entryNet);
  const c = pnl >= 0 ? '#22c55e' : '#ef4444';
  const formula = isCredit
    ? `entry credit ${entryAbs.toFixed(2)} - close debit ${closePts.toFixed(2)} = ${(entryAbs-closePts).toFixed(2)} x ${q} x 100`
    : `close credit ${closePts.toFixed(2)} - entry debit ${entryAbs.toFixed(2)} = ${(closePts-entryAbs).toFixed(2)} x ${q} x 100`;
  return `P&L: <b style="font-size:16px;color:${c}">${pnl>=0?'+':''}$${pnl.toFixed(2)}</b>` +
         `<div style="font-size:10px;color:var(--muted);margin-top:2px">${formula}</div>`;
}

function _jrnLegSideLabel(l) {
  const side = String(l.side || '').toLowerCase() === 'sell' ? 'SELL' : 'BUY';
  const typ = String(l.option_type || '').toLowerCase();
  if (typ === 'stock') return `${side} STK`;
  return `${side} ${typ === 'call' ? 'C' : 'P'} ${l.strike || '?'}`;
}

function _jrnOpenClose(tid, mode) {
  try {
    const trade = window._jrnTrades?.find(t => t.id === tid);
    if (!trade) { alert('Trade not found'); return; }
    _jrnCloseId = tid;
    window._jrnCloseTT  = trade.trade_type || '';
    window._jrnCloseEp  = parseFloat(trade.entry_price || 0) || 0;
    window._jrnCloseQty = parseInt(trade.quantity || 1) || 1;
    let legs = [];
    try { legs = JSON.parse(trade.legs_json || '[]'); } catch {}
    if (!Array.isArray(legs)) legs = [];
    if (!legs.length) {
      const side = ['PS','CS','IC'].includes(window._jrnCloseTT) ? 'sell' : 'buy';
      const legType = window._jrnCloseTT === 'CB' ? 'call' : (window._jrnCloseTT === 'PB' ? 'put' : (window._jrnCloseTT === 'Stock' ? 'stock' : (window._jrnCloseTT === 'CS' ? 'call' : 'put')));
      const strike = trade.short_strike || trade.long_strike || '';
      legs = [{ side, option_type: legType, strike, expiry: trade.expiry || '', qty: window._jrnCloseQty, price: window._jrnCloseEp }];
    }
    window._jrnCloseLegs = legs;
    window._jrnCloseQty = Math.max(1, _jrnCloseUnitQty(legs, trade));
    window._jrnCloseEntryNet = _jrnCloseEntryNetPoints(legs, trade);
    if (!window._jrnCloseEp) window._jrnCloseEp = Math.abs(window._jrnCloseEntryNet || 0);

    const modal = document.getElementById('jrn-close-modal');
    const idEl  = document.getElementById('jrn-close-id');
    const symEl = document.getElementById('jrn-close-sym');
    const prEl  = document.getElementById('jrn-close-price');
    const cmEl  = document.getElementById('jrn-close-comments');
    const qtyEl = document.getElementById('jrn-close-qty');
    const legsEl = document.getElementById('jrn-close-legs');
    const simpleEl = document.getElementById('jrn-close-simple');
    const netHost = document.getElementById('jrn-close-pnl-preview');
    if (idEl) idEl.textContent = tid;
    if (symEl) symEl.textContent = `${trade.symbol || ''} ${trade.trade_type || ''}`.trim();
    if (prEl) prEl.value = '';
    if (cmEl) cmEl.value = '';
    if (qtyEl) { qtyEl.max = window._jrnCloseQty; qtyEl.value = window._jrnCloseQty; qtyEl.title = `Max open quantity ${window._jrnCloseQty}`; }

    if (legsEl) {
      const multi = legs.length > 1;
      legsEl.innerHTML = multi
        ? `<div style="margin-bottom:8px;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--surface)">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
              <div style="font-size:12px;font-weight:800">Close selected legs/sides</div>
              <div style="display:flex;align-items:center;gap:6px">
                <span style="font-size:11px;color:var(--muted)">Net close</span>
                <input id="jrn-cl-net" type="number" step="0.01" placeholder="debit/credit" style="width:120px" oninput="_jrnClosePreview()"/>
              </div>
            </div>
            <div style="font-size:11px;color:var(--muted);margin-bottom:6px">Checked legs will be closed. Unchecked legs stay open. Use quantity for partial contract close.</div>
            ${legs.map((l,i)=>{
              const legLabel = _jrnLegSideLabel(l);
              const px = Number(l.price ?? l.entry_price ?? 0);
              return `<div style="display:grid;grid-template-columns:22px 1fr 92px;gap:8px;align-items:center;margin-bottom:6px">
                <input id="jrn-cl-${i}" type="checkbox" checked onchange="_jrnClosePreview()"/>
                <label style="font-size:12px;color:var(--text)">${legLabel}<span style="color:var(--muted)"> · qty ${l.qty || 1} · entry $${Number.isFinite(px)?px.toFixed(2):'0.00'}</span></label>
                <input id="jrn-cl-px-${i}" type="number" step="0.01" value="${Number.isFinite(px)?px.toFixed(2):'0.00'}" oninput="_jrnClosePreview()"/>
              </div>`;
            }).join('')}
          </div>`
        : `<div style="font-size:12px;color:var(--muted);margin-bottom:8px">Single-leg close. Use Close quantity for partial close.</div>`;
      if (simpleEl) simpleEl.style.display = multi ? 'none' : '';
      if (netHost) netHost.style.display = 'none';
    }

    if (modal) {
      modal.style.display = 'flex';
      modal.style.position = 'fixed';
      modal.style.zIndex = '99999';
    }
    _jrnCloseRollInit(mode === 'roll');
    _jrnClosePreview();
  } catch(e) { console.error('Close modal error:', e); alert('Error opening close dialog: '+e.message); }
}

function _jrnCloseSelect(side) {
  const legs = window._jrnCloseLegs || [];
  legs.forEach((l,i) => {
    const cb = document.getElementById(`jrn-cl-${i}`);
    if (!cb) return;
    const typ = String(l.option_type || '').toLowerCase();
    cb.checked = side === 'all' || typ === side || (side === 'stock' && typ === 'stock');
  });
  _jrnClosePreview();
}

async function _jrnClosePreview(){
  const legs = window._jrnCloseLegs || [];
  const el = document.getElementById('jrn-close-pnl-preview');
  if (!el) return;
  const qClose = _jrnCloseActiveQty();

  const netEl = document.getElementById('jrn-cl-net');
  if (legs.length > 1 && netEl && netEl.value !== '') {
    const netClose = parseFloat(netEl.value);
    if (Number.isFinite(netClose) && netClose >= 0) {
      const pnl = _jrnClosePnlFromNetCloseQty(netClose, qClose);
      el.style.display = '';
      el.innerHTML = _jrnCloseNetPreviewHtmlQty(netClose, pnl, qClose);
      return;
    }
  }

  let total = 0, any = false;
  legs.forEach((l,i) => {
    const cb = document.getElementById(`jrn-cl-${i}`);
    const px = document.getElementById(`jrn-cl-px-${i}`);
    if (legs.length > 1 && !cb?.checked) return;
    if (!px?.value && legs.length > 1) return;
    any = true;
    const exit = legs.length > 1 ? (parseFloat(px.value) || 0) : (parseFloat(document.getElementById('jrn-close-price')?.value || '0') || 0);
    const entry = parseFloat(l.price ?? l.entry_price ?? 0) || 0;
    const legQty = Math.min(parseInt(l.qty || qClose) || qClose, qClose);
    const sign = String(l.side || '').toLowerCase() === 'sell' ? -1 : 1;
    const mult = (l.option_type || '') === 'stock' ? 1 : 100;
    total += sign * (exit - entry) * legQty * mult;
  });
  if (any) {
    const c = total >= 0 ? '#22c55e' : '#ef4444';
    el.style.display = '';
    el.innerHTML = `P&L: <b style="font-size:16px;color:${c}">${total>=0?'+':''}$${total.toFixed(2)}</b>` +
      `<div style="font-size:10px;color:var(--muted);margin-top:2px">Quantity closing: ${qClose} of ${window._jrnCloseQty || qClose}</div>`;
  } else {
    el.style.display = 'none';
  }
  if (typeof _jrnCloseRollPreview === 'function') _jrnCloseRollPreview();
}


function _jrnCloseSelectedIndices() {
  const legs = window._jrnCloseLegs || [];
  const selected = [];
  legs.forEach((l,i) => {
    const cb = document.getElementById(`jrn-cl-${i}`);
    if (legs.length <= 1 || cb?.checked) selected.push(i);
  });
  return selected;
}

function _jrnCloseSideFromSelection() {
  const legs = window._jrnCloseLegs || [];
  const selected = _jrnCloseSelectedIndices();
  const types = new Set(selected.map(i => String(legs[i]?.option_type || '').toLowerCase()).filter(Boolean));
  if (types.size === 1 && types.has('put')) return 'put';
  if (types.size === 1 && types.has('call')) return 'call';
  if (selected.length === legs.length) return 'all';
  return 'custom';
}

function _jrnCloseRollInit(expand) {
  const panel = document.getElementById('jrn-close-roll-panel');
  if (!panel) return;
  const legs = window._jrnCloseLegs || [];
  const hasOpts = legs.some(l => ['put','call'].includes(String(l.option_type || '').toLowerCase()));
  const btn = document.getElementById('jrn-close-roll-toggle');
  if (btn) btn.style.display = hasOpts ? '' : 'none';
  panel.style.display = expand && hasOpts ? '' : 'none';
  ['jrn-close-roll-new-expiry','jrn-close-roll-new-short','jrn-close-roll-new-long','jrn-close-roll-new-short-price','jrn-close-roll-new-long-price','jrn-close-roll-new-net','jrn-close-roll-reason'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  const sideEl = document.getElementById('jrn-close-roll-side');
  if (sideEl) {
    const hasPut = legs.some(l => String(l.option_type || '').toLowerCase() === 'put');
    const hasCall = legs.some(l => String(l.option_type || '').toLowerCase() === 'call');
    sideEl.value = hasPut ? 'put' : (hasCall ? 'call' : 'custom');
  }
  const qEl = document.getElementById('jrn-close-roll-qty');
  if (qEl) { qEl.max = window._jrnCloseQty || 1; qEl.value = document.getElementById('jrn-close-qty')?.value || window._jrnCloseQty || 1; }
  if (expand && hasOpts) _jrnCloseRollSideChanged();
  _jrnCloseRollPreview();
}

function _jrnCloseRollToggle(force) {
  const panel = document.getElementById('jrn-close-roll-panel');
  if (!panel) return;
  const open = force === true ? true : panel.style.display === 'none' || !panel.style.display;
  panel.style.display = open ? '' : 'none';
  if (open) _jrnCloseRollSideChanged(false);
  _jrnCloseRollPreview();
}

function _jrnCloseRollSideChanged(applySelection=true) {
  const side = document.getElementById('jrn-close-roll-side')?.value || 'put';
  if (applySelection && side !== 'custom') _jrnCloseSelect(side === 'all' ? 'all' : side);
  const reason = document.getElementById('jrn-close-reason');
  if (reason) reason.value = 'rolled';
  const qEl = document.getElementById('jrn-close-roll-qty');
  if (qEl) qEl.value = document.getElementById('jrn-close-qty')?.value || qEl.value || 1;
  _jrnCloseRollPreview();
}

function _jrnCloseRollActiveQty() {
  const maxQty = window._jrnCloseQty || 1;
  const q = parseInt(document.getElementById('jrn-close-roll-qty')?.value || document.getElementById('jrn-close-qty')?.value || maxQty) || maxQty;
  return Math.max(1, Math.min(maxQty, q));
}

function _jrnCloseEntryNetForSelected() {
  const legs = window._jrnCloseLegs || [];
  const selected = _jrnCloseSelectedIndices();
  const q = _jrnCloseRollActiveQty();
  let total = 0, any = false;
  selected.forEach(i => {
    const l = legs[i] || {};
    if (String(l.option_type || '').toLowerCase() === 'stock') return;
    const px = parseFloat(l.price ?? l.entry_price ?? 0) || 0;
    const legQty = Math.min(parseInt(l.qty || q) || q, q);
    const sign = String(l.side || '').toLowerCase() === 'sell' ? 1 : -1;
    total += sign * px * legQty;
    any = true;
  });
  return any ? total / Math.max(1, q) : 0;
}

function _jrnCloseNetForSelected() {
  const legs = window._jrnCloseLegs || [];
  const q = _jrnCloseRollActiveQty();
  const netEl = document.getElementById('jrn-cl-net');
  if (netEl && netEl.value !== '') {
    const v = parseFloat(netEl.value);
    if (Number.isFinite(v)) return Math.abs(v);
  }
  if (legs.length <= 1) {
    const v = parseFloat(document.getElementById('jrn-close-price')?.value || '');
    if (Number.isFinite(v)) return Math.abs(v);
  }
  let total = 0, any = false;
  _jrnCloseSelectedIndices().forEach(i => {
    const l = legs[i] || {};
    if (String(l.option_type || '').toLowerCase() === 'stock') return;
    const pxEl = document.getElementById(`jrn-cl-px-${i}`);
    const px = parseFloat(pxEl?.value || '0') || 0;
    const legQty = Math.min(parseInt(l.qty || q) || q, q);
    const sign = String(l.side || '').toLowerCase() === 'sell' ? 1 : -1;
    total += sign * px * legQty;
    any = true;
  });
  return any ? Math.abs(total / Math.max(1, q)) : 0;
}

function _jrnCloseRollUpdateNetFromLegs() {
  const sp = parseFloat(document.getElementById('jrn-close-roll-new-short-price')?.value || '');
  const lp = parseFloat(document.getElementById('jrn-close-roll-new-long-price')?.value || '');
  if (Number.isFinite(sp) && Number.isFinite(lp)) {
    const actualNewOpen = sp - lp;
    const closeNet = _jrnCloseNetForSelected();
    const netRoll = actualNewOpen - closeNet;
    const net = document.getElementById('jrn-close-roll-new-net');
    if (net) net.value = netRoll.toFixed(2);
  }
  _jrnCloseRollPreview();
}

function _jrnCloseRollPreview() {
  const host = document.getElementById('jrn-close-roll-preview');
  if (!host) return;
  const panel = document.getElementById('jrn-close-roll-panel');
  if (!panel || panel.style.display === 'none') { host.innerHTML = ''; return; }
  const q = _jrnCloseRollActiveQty();
  const selected = _jrnCloseSelectedIndices();
  const oldNet = _jrnCloseEntryNetForSelected();
  const closeNet = _jrnCloseNetForSelected();
  const rollNetRaw = document.getElementById('jrn-close-roll-new-net')?.value;
  const rollNet = rollNetRaw === '' || rollNetRaw == null ? NaN : parseFloat(rollNetRaw);
  const impliedNewOpen = Number.isFinite(rollNet) ? (closeNet + rollNet) : NaN;
  const effective = Number.isFinite(rollNet) ? (oldNet + rollNet) : NaN;
  const adjColor = Number.isFinite(rollNet) && rollNet >= 0 ? '#22c55e' : '#ef4444';
  const effColor = Number.isFinite(effective) && effective >= 0 ? '#22c55e' : '#ef4444';
  host.innerHTML = `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px">` +
    `<div><b>${selected.length}</b> leg(s)<br><span style="color:var(--muted)">selected to roll</span></div>` +
    `<div><b>${q}</b><br><span style="color:var(--muted)">qty rolled</span></div>` +
    `<div><b>${oldNet>=0?'+':''}${oldNet.toFixed(2)}</b><br><span style="color:var(--muted)">old side net</span></div>` +
    `<div><b>${closeNet.toFixed(2)}</b><br><span style="color:var(--muted)">close cost/net</span></div>` +
    `<div><b style="color:${adjColor}">${Number.isFinite(rollNet) ? (rollNet>=0?'+':'') + rollNet.toFixed(2) : '—'}</b><br><span style="color:var(--muted)">net roll credit/debit</span></div>` +
    `<div><b>${Number.isFinite(impliedNewOpen) ? (impliedNewOpen>=0?'+':'') + impliedNewOpen.toFixed(2) : '—'}</b><br><span style="color:var(--muted)">implied new open</span></div>` +
    `<div><b style="color:${effColor}">${Number.isFinite(effective) ? (effective>=0?'+':'') + effective.toFixed(2) : '—'}</b><br><span style="color:var(--muted)">effective position credit</span></div>` +
    `</div><div style="margin-top:6px;color:var(--muted);font-size:11px">Enter the total roll order cashflow: positive = credit collected, negative = debit paid. Example: old side +2.50 and roll debit -1.03 gives effective position credit +1.47. If short/long new leg premiums are entered, this net roll value is auto-derived as new spread credit minus close cost.</div>`;
}

async function jrnCloseRollTrade() {
  const legs = window._jrnCloseLegs || [];
  const selected = _jrnCloseSelectedIndices();
  if (!selected.length) { alert('Select the side/legs to roll in the close-leg grid.'); return; }
  const q = _jrnCloseRollActiveQty();
  const sideSel = document.getElementById('jrn-close-roll-side')?.value || _jrnCloseSideFromSelection();
  const newExpiry = document.getElementById('jrn-close-roll-new-expiry')?.value || '';
  const newShort = parseFloat(document.getElementById('jrn-close-roll-new-short')?.value || '');
  const newLong = parseFloat(document.getElementById('jrn-close-roll-new-long')?.value || '');
  const newShortPx = parseFloat(document.getElementById('jrn-close-roll-new-short-price')?.value || '');
  const newLongPx = parseFloat(document.getElementById('jrn-close-roll-new-long-price')?.value || '');
  const rollNet = parseFloat(document.getElementById('jrn-close-roll-new-net')?.value || '');
  if (!newExpiry || !Number.isFinite(newShort) || !Number.isFinite(newLong)) { alert('Fill new expiry, new short strike, and new long strike.'); return; }
  if (!Number.isFinite(rollNet) && !(Number.isFinite(newShortPx) && Number.isFinite(newLongPx))) { alert('Enter net roll credit/debit. Positive = credit, negative = debit.'); return; }
  const first = legs[selected[0]] || {};
  const optType = sideSel === 'call' ? 'call' : (sideSel === 'put' ? 'put' : String(first.option_type || 'put').toLowerCase());
  const closeNetForRoll = _jrnCloseNetForSelected();
  const hasLegPremiums = Number.isFinite(newShortPx) && Number.isFinite(newLongPx);
  const signedRollNet = Number.isFinite(rollNet) ? rollNet : ((newShortPx - newLongPx) - closeNetForRoll);
  const actualNewOpenNet = hasLegPremiums ? (newShortPx - newLongPx) : (closeNetForRoll + signedRollNet);
  let sellPx, buyPx;
  if (hasLegPremiums) {
    sellPx = newShortPx; buyPx = newLongPx;
  } else if (Number.isFinite(actualNewOpenNet) && actualNewOpenNet >= 0) {
    sellPx = actualNewOpenNet; buyPx = 0;
  } else {
    sellPx = 0; buyPx = Math.abs(actualNewOpenNet || 0);
  }
  const newLegs = [
    {side:'sell', option_type:optType, strike:newShort, expiry:newExpiry, qty:q, price:sellPx},
    {side:'buy',  option_type:optType, strike:newLong,  expiry:newExpiry, qty:q, price:buyPx}
  ];
  const closeLegExits = selected.map(i => {
    const rowPx = document.getElementById(`jrn-cl-px-${i}`)?.value;
    const singlePx = document.getElementById('jrn-close-price')?.value;
    return {leg_index:i, exit_price:parseFloat(rowPx ?? singlePx ?? '0') || 0};
  });
  const closeNetOverride = document.getElementById('jrn-cl-net')?.value;
  const payload = {
    roll_side: sideSel === 'custom' ? 'custom' : sideSel,
    roll_legs: selected,
    roll_quantity: q,
    close_quantity: q,
    close_price: closeNetOverride !== '' && closeNetOverride != null ? parseFloat(closeNetOverride) : undefined,
    close_leg_exits: closeLegExits,
    new_expiry: newExpiry,
    new_legs: newLegs,
    signed_roll_adjustment: signedRollNet,
    net_roll_credit_debit: signedRollNet,
    roll_net_is_cashflow: true,
    actual_new_entry_net: actualNewOpenNet,
    new_leg_prices_provided: hasLegPremiums,
    signed_new_net: actualNewOpenNet,
    effective_side_basis_preview: _jrnCloseEntryNetForSelected() + signedRollNet,
    roll_basis_mode: 'realized_plus_actual_new_with_effective_note',
    roll_reason: document.getElementById('jrn-close-roll-reason')?.value || document.getElementById('jrn-close-comments')?.value || 'rolled from close dialog'
  };
  try {
    const r = await api(`/journal/trade/${_jrnCloseId}/roll`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    document.getElementById('jrn-close-modal').style.display='none';
    const adj = Number(r.roll_adjustment || 0);
    const basis = Number(r.cumulative_side_basis || 0);
    const actual = Number(r.actual_new_entry_net || 0);
    alert(`Roll complete. Closed P&L: ${r.closed_pnl>=0?'+':''}$${Number(r.closed_pnl||0).toFixed(2)}. Net roll cashflow: ${adj>=0?'+':''}${adj.toFixed(2)}. Effective position credit: ${basis>=0?'+':''}${basis.toFixed(2)}. New trade #${r.new_trade_id || ''}${actual ? ` (new open net ${actual>=0?'+':''}${actual.toFixed(2)})` : ''}.`);
    jrnLoadOpen(); jrnLoadClosed();
  } catch(e) { alert('Error: ' + e.message); }
}

async function jrnCloseTrade(){
  const legs=window._jrnCloseLegs||[];
  const reason=document.getElementById('jrn-close-reason').value;
  const comments=document.getElementById('jrn-close-comments').value;
  const closeQuantity = _jrnCloseActiveQty();
  const _setupGrade    = document.getElementById('jrn-setup-grade')?.value || '';
  const _followedRules = document.getElementById('jrn-followed-rules')?.value;
  const _expectedMove  = parseFloat(document.getElementById('jrn-expected-move')?.value)||null;
  const _actualMove    = parseFloat(document.getElementById('jrn-actual-move')?.value)||null;
  const _hindsight     = document.getElementById('jrn-hindsight')?.value || '';
  window._pendingOutcome = {setup_grade:_setupGrade, followed_rules:_followedRules===''?null:parseInt(_followedRules), expected_move:_expectedMove, actual_move:_actualMove, hindsight_notes:_hindsight};
  const tt=window._jrnCloseTT||'';

  if(legs.length>1){
    const legExits=[]; let anyChecked=false; let anyUnchecked=false;
    legs.forEach((l,i)=>{
      const cb=document.getElementById(`jrn-cl-${i}`); const px=document.getElementById(`jrn-cl-px-${i}`);
      if(cb?.checked){ anyChecked=true; legExits.push({leg_index:i,exit_price:parseFloat(px?.value||0),closed:true}); }
      else { anyUnchecked=true; legExits.push({leg_index:i,closed:false}); }
    });
    if(!anyChecked){ alert('Select at least one leg/side to close.'); return; }
    const netEl=document.getElementById('jrn-cl-net');
    const payload={leg_exits:legExits,close_quantity:closeQuantity,partial:anyUnchecked || closeQuantity < (window._jrnCloseQty||closeQuantity),close_reason:reason,comments};
    if(netEl?.value){ payload.exit_price=parseFloat(netEl.value); payload._net_close=true; payload._entry_net=window._jrnCloseEntryNet; }
    try{
      const r=await api(`/journal/trade/${_jrnCloseId}/close`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
      const _oc = window._pendingOutcome||{}; const _hasOc = _oc.setup_grade||_oc.followed_rules!=null||_oc.hindsight_notes;
      if (_jrnCloseId && _hasOc) api(`/outcome/grade/${_jrnCloseId}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(_oc)}).catch(()=>{});
      document.getElementById('jrn-close-modal').style.display='none';
      alert(r.partial?`Partial/side close complete. P&L: ${r.pnl>=0?'+':''}$${Number(r.pnl||0).toFixed(2)}. Remaining position stays open.`:`Closed. P&L: ${r.pnl>=0?'+':''}$${Number(r.pnl||0).toFixed(2)}`);
      jrnLoadOpen(); jrnLoadClosed();
    }catch(e){alert('Error: '+e.message);}
    return;
  }

  const price=parseFloat(document.getElementById('jrn-close-price').value);
  if(isNaN(price)){alert('Enter exit price');return;}
  try{
    const r=await api(`/journal/trade/${_jrnCloseId}/close`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({exit_price:price,close_quantity:closeQuantity,close_reason:reason,comments})});
    const _oc2 = window._pendingOutcome||{}; const _hasOc2 = _oc2.setup_grade||_oc2.followed_rules!=null||_oc2.hindsight_notes;
    if (_jrnCloseId && _hasOc2) api(`/outcome/grade/${_jrnCloseId}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(_oc2)}).catch(()=>{});
    document.getElementById('jrn-close-modal').style.display='none';
    alert(`${r.partial?'Partial close':'Closed'}. P&L: ${r.pnl>=0?'+':''}$${Number(r.pnl||0).toFixed(2)}`); jrnLoadOpen(); jrnLoadClosed();
  }catch(e){alert('Error: '+e.message);}
}

function _jrnRollSelectedIndices(side) {
  const legs = window._jrnRollLegs || [];
  const selected = [];
  legs.forEach((l,i) => {
    const cb = document.getElementById(`jrn-roll-leg-${i}`);
    const typ = String(l.option_type || '').toLowerCase();
    if (side === 'custom') { if (cb?.checked) selected.push(i); }
    else if (side === 'all' || typ === side) selected.push(i);
  });
  return selected;
}

function _jrnOpenRoll(tid) {
  return _jrnOpenClose(tid, 'roll');
  const trade = window._jrnTrades?.find(t => t.id === tid);
  if (!trade) { alert('Trade not found'); return; }
  _jrnRollId = tid;
  let legs = [];
  try { legs = JSON.parse(trade.legs_json || '[]'); } catch {}
  if (!Array.isArray(legs)) legs = [];
  if (!legs.length) { alert('Roll/split needs leg-level journal data. Use Edit to add legs first.'); return; }
  window._jrnRollLegs = legs;
  window._jrnRollTrade = trade;
  const qty = Math.max(1, _jrnCloseUnitQty(legs, trade));
  const idEl=document.getElementById('jrn-roll-id'); if(idEl) idEl.textContent=tid;
  const symEl=document.getElementById('jrn-roll-sym'); if(symEl) symEl.textContent=`${trade.symbol || ''} ${trade.trade_type || ''}`.trim();
  ['jrn-roll-close-price','jrn-roll-new-expiry','jrn-roll-new-short','jrn-roll-new-long','jrn-roll-new-short-price','jrn-roll-new-long-price','jrn-roll-new-price','jrn-roll-reason'].forEach(id=>{const el=document.getElementById(id); if(el) el.value='';});
  const qtyEl=document.getElementById('jrn-roll-qty'); if(qtyEl){qtyEl.max=qty; qtyEl.value=qty;}
  const sideEl=document.getElementById('jrn-roll-side');
  if(sideEl){
    const hasPut=legs.some(l=>String(l.option_type||'').toLowerCase()==='put');
    const hasCall=legs.some(l=>String(l.option_type||'').toLowerCase()==='call');
    sideEl.value = hasPut ? 'put' : (hasCall ? 'call' : 'all');
  }
  _jrnRenderRollOldLegs();
  _jrnRollSideChanged();
  document.getElementById('jrn-roll-modal').style.display='flex';
}

function _jrnRenderRollOldLegs(){
  const host=document.getElementById('jrn-roll-old-legs'); if(!host) return;
  const legs=window._jrnRollLegs||[];
  host.innerHTML = `<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px">
    <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
      <div style="font-size:12px;font-weight:800">Original legs to close for roll</div>
      <div style="font-size:11px;color:var(--muted)">Selected legs are closed; unselected legs stay open in the original trade.</div>
    </div>
    ${legs.map((l,i)=>{
      const px=Number(l.price ?? l.entry_price ?? 0);
      return `<div style="display:grid;grid-template-columns:24px 1fr 100px;gap:8px;align-items:center;margin-bottom:6px">
        <input id="jrn-roll-leg-${i}" type="checkbox" onchange="_jrnRollPreview()" />
        <div style="font-size:12px;color:var(--text)">${_jrnLegSideLabel(l)} <span style="color:var(--muted)">qty ${l.qty||1} exp ${l.expiry||''} entry $${Number.isFinite(px)?px.toFixed(2):'0.00'}</span></div>
        <input id="jrn-roll-leg-px-${i}" type="number" step="0.01" value="${Number.isFinite(px)?px.toFixed(2):'0.00'}" oninput="_jrnRollPreview()" />
      </div>`;
    }).join('')}
  </div>`;
}

function _jrnRollSideChanged(){
  const side = document.getElementById('jrn-roll-side')?.value || 'put';
  const legs = window._jrnRollLegs || [];
  legs.forEach((l,i)=>{
    const cb=document.getElementById(`jrn-roll-leg-${i}`); if(!cb) return;
    const typ=String(l.option_type||'').toLowerCase();
    if(side==='custom') return;
    cb.checked = side==='all' || typ===side;
  });
  _jrnRollPreview();
}

function _jrnRollUpdateNetFromLegs(){
  const sp=parseFloat(document.getElementById('jrn-roll-new-short-price')?.value || '');
  const lp=parseFloat(document.getElementById('jrn-roll-new-long-price')?.value || '');
  if(Number.isFinite(sp) && Number.isFinite(lp)){
    const closeNet=parseFloat(document.getElementById('jrn-roll-close-price')?.value || '0') || 0;
    const net=document.getElementById('jrn-roll-new-price'); if(net) net.value=((sp-lp)-Math.abs(closeNet)).toFixed(2);
  }
  _jrnRollPreview();
}

function _jrnRollActiveQty(){
  const maxQty=Math.max(1, _jrnCloseUnitQty(window._jrnRollLegs||[], window._jrnRollTrade||{}));
  const q=parseInt(document.getElementById('jrn-roll-qty')?.value || maxQty) || maxQty;
  return Math.max(1, Math.min(maxQty, q));
}

function _jrnRollPreview(){
  const host=document.getElementById('jrn-roll-preview'); if(!host) return;
  const side=document.getElementById('jrn-roll-side')?.value || 'put';
  const selected=_jrnRollSelectedIndices(side);
  const q=_jrnRollActiveQty();
  const closeNet=Math.abs(parseFloat(document.getElementById('jrn-roll-close-price')?.value || '0') || 0);
  const rollNet=parseFloat(document.getElementById('jrn-roll-new-price')?.value || '0') || 0;
  const c=rollNet>=0?'#22c55e':'#ef4444';
  const actualNewOpen = closeNet + rollNet;
  host.innerHTML = `${selected.length} leg(s) selected · qty ${q} · net roll cashflow <b style="color:${c}">${rollNet>=0?'+':''}${rollNet.toFixed(2)}</b> per spread unit · implied new open ${actualNewOpen>=0?'+':''}${actualNewOpen.toFixed(2)}.`;
}

async function jrnRollTrade() {
  const side=document.getElementById('jrn-roll-side')?.value || 'put';
  const selected=_jrnRollSelectedIndices(side);
  if(!selected.length){ alert('Select at least one original leg/side to roll.'); return; }
  const q=_jrnRollActiveQty();
  const newExpiry=document.getElementById('jrn-roll-new-expiry')?.value || '';
  const newShort=parseFloat(document.getElementById('jrn-roll-new-short')?.value || '');
  const newLong=parseFloat(document.getElementById('jrn-roll-new-long')?.value || '');
  const newShortPx=parseFloat(document.getElementById('jrn-roll-new-short-price')?.value || '');
  const newLongPx=parseFloat(document.getElementById('jrn-roll-new-long-price')?.value || '');
  const rollNet=parseFloat(document.getElementById('jrn-roll-new-price')?.value || '');
  if(!newExpiry || !Number.isFinite(newShort) || !Number.isFinite(newLong)) { alert('Fill new expiry, new short strike, and new long strike.'); return; }
  if(!Number.isFinite(rollNet) && !(Number.isFinite(newShortPx) && Number.isFinite(newLongPx))) { alert('Fill net roll credit/debit or both leg premiums.'); return; }
  const optType = side === 'call' ? 'call' : (side === 'put' ? 'put' : (String((window._jrnRollLegs||[])[selected[0]]?.option_type||'put').toLowerCase()));
  const closeNetForRoll = Math.abs(parseFloat(document.getElementById('jrn-roll-close-price')?.value || '0') || 0);
  const hasLegPremiums = Number.isFinite(newShortPx) && Number.isFinite(newLongPx);
  const signedRollNet = Number.isFinite(rollNet) ? rollNet : ((newShortPx - newLongPx) - closeNetForRoll);
  const actualNewOpenNet = hasLegPremiums ? (newShortPx - newLongPx) : (closeNetForRoll + signedRollNet);
  let sellPx, buyPx;
  if (hasLegPremiums) {
    sellPx = newShortPx; buyPx = newLongPx;
  } else if (Number.isFinite(actualNewOpenNet) && actualNewOpenNet >= 0) {
    sellPx = actualNewOpenNet; buyPx = 0;
  } else if (Number.isFinite(actualNewOpenNet)) {
    sellPx = 0; buyPx = Math.abs(actualNewOpenNet);
  } else {
    sellPx = 0; buyPx = 0;
  }
  const newLegs=[
    {side:'sell', option_type:optType, strike:newShort, expiry:newExpiry, qty:q, price:sellPx},
    {side:'buy',  option_type:optType, strike:newLong,  expiry:newExpiry, qty:q, price:buyPx}
  ];
  const closeLegExits=selected.map(i=>({leg_index:i, exit_price:parseFloat(document.getElementById(`jrn-roll-leg-px-${i}`)?.value || '0') || 0}));
  const payload={
    roll_side: side,
    roll_legs: side==='custom'?selected:undefined,
    roll_quantity:q,
    close_price: parseFloat(document.getElementById('jrn-roll-close-price')?.value || '') || undefined,
    close_leg_exits: closeLegExits,
    new_expiry:newExpiry,
    new_legs:newLegs,
    signed_roll_adjustment:signedRollNet,
    net_roll_credit_debit:signedRollNet,
    roll_net_is_cashflow:true,
    actual_new_entry_net:actualNewOpenNet,
    new_leg_prices_provided:hasLegPremiums,
    signed_new_net:actualNewOpenNet,
    roll_reason: document.getElementById('jrn-roll-reason')?.value || ''
  };
  try {
    const r = await api(`/journal/trade/${_jrnRollId}/roll`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    document.getElementById('jrn-roll-modal').style.display='none';
    alert(`Roll complete. Closed P&L: ${r.closed_pnl>=0?'+':''}$${Number(r.closed_pnl||0).toFixed(2)}. New trade #${r.new_trade_id || ''}. ${r.remaining_open_id?'Original remaining side stays open.':''}`);
    jrnLoadOpen(); jrnLoadClosed();
  } catch(e) { alert(`Error: ${e.message}`); }
}

async function _jrnDelete(tid) {
  if (!confirm(`Delete trade #${tid}? Cannot be undone.`)) return;
  try {
    await api(`/journal/trade/${tid}/delete`, {method:'DELETE'});
    jrnLoadOpen();
  } catch(e) { alert(`Error: ${e.message}`); }
}


function _jrnTypeChanged() {
  const tt = document.getElementById('jrn-add-type')?.value;
  if (!tt) return;

  // Auto-populate legs from template when strategy type changes
  const templated = ['PS','CS','IC','PB','CB','CC','CP','Straddle','Strangle','Calendar','Butterfly'];
  if (templated.includes(tt)) {
    _jrnTemplate(tt);
  } else if (tt === 'Custom') {
    // Custom: just clear legs so user can add manually
    if (typeof _jrnLegs !== 'undefined') { _jrnLegs = []; }
    if (typeof _renderLegs === 'function') _renderLegs();
  }
  if (typeof _jrnScheduleOptionContext === 'function') _jrnScheduleOptionContext();
  if (typeof _jrnScheduleDraftScore === 'function') _jrnScheduleDraftScore();
}

function _jrnDateOnlyDte(expiry) {
  if (!expiry) return '?';
  try {
    const [y, m, d] = String(expiry).slice(0, 10).split('-').map(Number);
    if (!y || !m || !d) return '?';
    const expUtc = Date.UTC(y, m - 1, d);
    const today = new Date();
    const todayUtc = Date.UTC(today.getFullYear(), today.getMonth(), today.getDate());
    return Math.max(0, Math.floor((expUtc - todayUtc) / 86400000));
  } catch (e) {
    return '?';
  }
}

function _jrnNetPremiumPoints(t) {
  const ep = parseFloat(t?.entry_price || 0);
  const net = t?.net_premium != null ? parseFloat(t.net_premium) : NaN;
  if (Number.isFinite(net)) return net;
  try {
    const legs = JSON.parse(t?.legs_json || '[]');
    if (Array.isArray(legs) && legs.length) {
      let total = 0;
      for (const l of legs) {
        const px = parseFloat(l.price ?? l.entry_price ?? 0) || 0;
        const q = Math.max(1, parseInt(l.qty || 1) || 1);
        total += (l.side === 'sell' ? 1 : -1) * px * q;
      }
      return total;
    }
  } catch (e) {}
  return Number.isFinite(ep) ? ep : 0;
}

function _jrnInferQtyFromLegs(legs) {
  try {
    if (!Array.isArray(legs) || !legs.length) return 1;
    const optionQtys = legs
      .filter(l => (l.option_type || '') !== 'stock')
      .map(l => Math.max(1, parseInt(l.qty || 1) || 1));
    if (!optionQtys.length) {
      const stockLeg = legs.find(l => (l.option_type || '') === 'stock');
      return Math.max(1, parseInt(stockLeg?.qty || 1) || 1);
    }
    const gcd = (a, b) => (b ? gcd(b, a % b) : a);
    return optionQtys.reduce((a, b) => gcd(a, b), optionQtys[0]) || 1;
  } catch (e) {
    return 1;
  }
}


function _jrnBuildDraftPayload(opts={}) {
  const s = id => document.getElementById(id)?.value;
  const sym = (s('jrn-add-symbol') || '').trim().toUpperCase();
  if (!sym) {
    if (!opts.silent) alert('Symbol required');
    return null;
  }
  const tradeType  = s('jrn-add-type') || 'IC';
  const reasonType = s('jrn-add-reason-type') || 'OTHER';
  const reasonText = s('jrn-add-reason') || '';
  const entryDate  = s('jrn-add-entry-date') || new Date().toISOString().slice(0,10);
  const netPrice   = parseFloat(s('jrn-add-price') || 0);
  const legs = (typeof _jrnLegs !== 'undefined' && _jrnLegs.length > 0)
    ? _jrnLegs.map(l => ({
        side:        l.side        || 'buy',
        option_type: l.option_type || 'call',
        strike:      parseFloat(l.strike) || 0,
        expiry:      l.expiry      || '',
        qty:         parseInt(l.qty) || 1,
        price:       parseFloat(l.price) || 0,
      }))
    : [];
  const expiry = legs.find(l => l.option_type !== 'stock' && l.expiry)?.expiry || '';
  return {
    symbol:       sym,
    trade_type:   tradeType,
    expiry:       expiry,
    entry_date:   entryDate,
    entry_price:  netPrice,
    quantity:     _jrnInferQtyFromLegs(legs),
    entry_reason: '[' + reasonType.toUpperCase() + '] ' + reasonText,
    legs:         legs,
  };
}

async function jrnAddTrade() {
  const payload = _jrnBuildDraftPayload();
  if (!payload) return;

  const st = document.getElementById('jrn-add-status');
  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Saving…</span>';

  try {
    const _editId = window._jrnEditId || null;
    const _url    = _editId ? '/journal/trade/update/' + _editId : '/journal/trade/add';
    await api(_url, { method: 'POST', headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify(payload) });

    window._jrnEditId = null;
    const _eb = document.getElementById('jrn-edit-banner');
    if (_eb) _eb.style.display = 'none';

    if (typeof _jrnLegs !== 'undefined') { _jrnLegs = []; }
    if (typeof _renderLegs === 'function') _renderLegs();
    const prev = document.getElementById('entry-score-preview');
    if (prev) prev.innerHTML = '';

    if (st) st.innerHTML = '<span style="color:#22c55e">✅ Trade ' + (_editId ? 'updated' : 'saved') + '!</span>';
    setTimeout(() => { jrnTab('open'); }, 900);
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

// Auto-load when Journal tab clicked
document.querySelectorAll('[data-tab="journal"]').forEach(btn =>
  btn.addEventListener('click', () => setTimeout(() => jrnTab('open'), 100)));

document.addEventListener('change', function(e) {
  if (!e || !e.target) return;
  if (e.target.id === 'jrn-oi-expiry-select') {
    if (typeof _jrnScheduleOptionContext === 'function') _jrnScheduleOptionContext();
    if (typeof _jrnScheduleDraftScore === 'function') _jrnScheduleDraftScore();
  }
});

// SECTORS — 4-quadrant analysis

let _sectorData = [];

async function runSectorAnalysis() {
  const st = document.getElementById('sector-status');
  const qEl = document.getElementById('sector-quadrant');
  const cEl = document.getElementById('sector-cards');
  if (st) st.innerHTML = '⏳ Fetching sector data…';
  try {
    const data = await api('/sectors/performance');
    _sectorData = data;
    if (!data || !data.length) {
      if (st) st.innerHTML = '⚠ No sector data — ensure yfinance is working and retry.';
      return;
    }
    if (st) st.innerHTML = `✅ ${data.length} sectors loaded`;
    _renderSectorQuadrant(data, qEl);
    _renderSectorCards(data, cEl);
  } catch(e) { if (st) st.innerHTML = `❌ ${e.message}`; }
}

function _renderSectorQuadrant(data, el) {
  if (!el) return;
  const q = {1:[],2:[],3:[],4:[]};
  (data||[]).forEach(s => (q[s.quadrant]||q[4]).push(s));
  const quad = (num, title, titleColor, items) => `
    <div style="background:${titleColor}0d;border:2px solid ${titleColor}33;border-radius:8px;padding:12px;min-height:120px">
      <div style="font-size:11px;font-weight:700;color:${titleColor};letter-spacing:.08em;margin-bottom:8px">${title}</div>
      ${items.map(s => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:3px 0;border-bottom:1px solid rgba(255,255,255,.06)">
          <span style="font-size:11px;color:var(--text);font-weight:600">${s.sector.split(' ').slice(0,2).join(' ')}</span>
          <div style="display:flex;gap:8px;align-items:center">
            <span style="font-size:10px;color:${(s.chg_5d||0)>=0?'#22c55e':'#ef4444'}">${(s.chg_5d||0)>=0?'+':''}${s.chg_5d||0}%</span>
            <span style="font-size:9px;color:var(--muted)">RSI${s.rsi||'—'}</span>
            <span style="font-size:9px;font-weight:700;color:${(s.rsi_diff||0)>=20?'#ef4444':(s.rsi_diff||0)<=-20?'#22c55e':'#64748b'}">Δ${s.rsi_diff>=0?'+':''}${s.rsi_diff||0}</span>
          </div>
        </div>`).join('')}
      ${!items.length ? '<div style="color:var(--muted);font-size:11px">None</div>' : ''}
    </div>`;
  el.innerHTML = `
    <div class="card" style="padding:14px;margin-bottom:12px">
      <div class="card-title" style="margin-bottom:12px">📊 Sector 4-Quadrant  <span style="font-size:11px;color:var(--muted);font-weight:400">· 5-day momentum × RSIDiff90 signal</span></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        ${quad(1,'↗ BULLISH  (5d up · not overbought)','#22c55e', q[1])}
        ${quad(3,'→ EXTENDED  (5d up · RSIDiff90 ≥ +20)','#f59e0b', q[3])}
        ${quad(2,'↑ RECOVERING  (5d down · RSIDiff90 ≥ 0)','#4ade80', q[2])}
        ${quad(4,'↓ BEARISH  (5d down · RSIDiff90 < 0)','#ef4444', q[4])}
      </div>
      <div style="font-size:10px;color:var(--muted);margin-top:8px">Quadrant logic: X = 5-day price change · Δ = RSIDiff90 = RSI14−EMA90(RSI14). EXTENDED requires Δ ≥ +20; normal 5d-up names stay in BULLISH/ADVANCING.</div>
    </div>`;
}

function _renderSectorCards(data, el) {
  if (!el) return;
  el.innerHTML = (data||[]).map(s => `
    <div style="background:var(--card);border:1px solid ${s.quad_color||'#64748b'}44;border-left:4px solid ${s.quad_color||'#64748b'};border-radius:6px;padding:12px;min-width:160px;flex:1">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
        <span style="font-size:12px;font-weight:700;color:var(--text)">${s.sector}</span>
        <span style="background:${s.quad_color||'#64748b'}20;border:1px solid ${s.quad_color||'#64748b'}44;color:${s.quad_color||'#64748b'};padding:1px 6px;border-radius:3px;font-size:10px;font-weight:700">${s.quad_label||''}</span>
      </div>
      <div style="font-size:10px;font-weight:700;color:var(--muted);margin-bottom:6px">${s.etf||''} · $${s.price||'—'}</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:5px">
        <span style="font-size:11px;color:${(s.chg_1d||0)>=0?'#22c55e':'#ef4444'}">1d:${(s.chg_1d||0)>=0?'+':''}${s.chg_1d||0}%</span>
        <span style="font-size:11px;color:${(s.chg_5d||0)>=0?'#22c55e':'#ef4444'}">5d:${(s.chg_5d||0)>=0?'+':''}${s.chg_5d||0}%</span>
        <span style="font-size:11px;color:${(s.chg_20d||0)>=0?'#22c55e':'#ef4444'}">20d:${(s.chg_20d||0)>=0?'+':''}${s.chg_20d||0}%</span>
      </div>
      <div style="font-size:10px;color:var(--muted)">
        RSI ${s.rsi||'—'}
        <span style="color:${(s.rsi_diff||0)>=20?'#ef4444':(s.rsi_diff||0)<=-20?'#22c55e':'#64748b'}">Δ${(s.rsi_diff||0)>=0?'+':''}${s.rsi_diff||0}</span>
        · MACD <span style="color:${s.macd==='BULLISH'?'#22c55e':s.macd==='BEARISH'?'#ef4444':'#64748b'}">${s.macd||'—'}</span>
        · ADX ${s.adx||'—'}
        · EMA ${s.ema_trend==='above'?'<span style="color:#22c55e">20>50</span>':'<span style="color:#ef4444">20&lt;50</span>'}
        · <b style="color:${s.momentum==='OVERBOUGHT'?'#ef4444':s.momentum==='OVERSOLD'?'#22c55e':'var(--text)'}">${s.momentum||'—'}</b>
      </div>
    </div>`).join('');
}

// Auto-load when Sectors tab clicked
document.querySelectorAll('[data-tab="sectors"]').forEach(btn =>
  btn.addEventListener('click', () => setTimeout(runSectorAnalysis, 100)));


// MARKET NEWS + MORNING DIGEST

let _allNews = [];

async function loadNews() {
  const st = document.getElementById('news-status');
  if (st) st.innerHTML = '⏳ Loading…';
  try {
    const news = await api('/news/latest');
    _allNews = news || [];
    filterNews();
    if (st) st.innerHTML = `✅ ${_allNews.length} articles`;
  } catch(e) { if (st) st.innerHTML = `❌ ${e.message}`; }
}

async function refreshNews() {
  const st = document.getElementById('news-status');
  if (st) st.innerHTML = '⏳ Fetching news…';
  try {
    await api('/news/refresh', {method:'POST'});
    const news = await api('/news/latest');
    _allNews = news || [];
    filterNews();
    if (st) st.innerHTML = `✅ ${_allNews.length} articles`;
  } catch(e) { if (st) st.innerHTML = `❌ ${e.message}`; }
}

function filterNews() {
  const sent = document.getElementById('news-filter-sentiment')?.value || '';
  const cat  = document.getElementById('news-filter-cat')?.value || '';
  const q    = (document.getElementById('news-search')?.value || '').toLowerCase();
  let data = (_allNews || []).filter(n => n && n.headline && n.headline.trim());
  if (sent) data = data.filter(n => n.sentiment === sent);
  if (cat)  data = data.filter(n => n.category  === cat);
  if (q)    data = data.filter(n => (n.headline||'').toLowerCase().includes(q));
  _renderNews(data);
}

function _renderNews(items) {
  const el = document.getElementById('news-grid');
  if (!el) return;
  if (!items || !items.length) {
    el.innerHTML = '<div style="color:var(--muted);padding:20px;grid-column:1/-1">No articles. Click 🔄 Refresh News to fetch latest headlines.</div>';
    return;
  }
  el.innerHTML = items.map(n => {
    const sc   = n.sentiment==='positive'?'#22c55e':n.sentiment==='negative'?'#ef4444':'#64748b';
    const sLbl = n.sentiment==='positive'?'▲ POS':n.sentiment==='negative'?'▼ NEG':'● NEU';
    const sym  = n.symbol && n.symbol !== '^VIX' && n.symbol !== 'SPY' && n.symbol !== 'QQQ' ? n.symbol : '';
    const pub  = (n.published||'').slice(0,16);
    return `<a href="${n.url||'#'}" target="_blank" style="text-decoration:none">
      <div style="background:var(--card);border:1px solid var(--border);border-top:3px solid ${sc};border-radius:6px;padding:10px 12px;cursor:pointer">
        <div style="display:flex;justify-content:space-between;gap:6px;margin-bottom:5px">
          <span style="font-size:10px;font-weight:700;color:${sc}">${sLbl}${sym?' · '+sym:''}</span>
          <span style="font-size:10px;color:var(--muted);flex-shrink:0">${pub}</span>
        </div>
        <div style="font-size:12px;font-weight:700;color:var(--text);line-height:1.4;margin-bottom:5px">${n.headline}</div>
        ${n.summary && n.summary.length > 10
          ? `<div style="font-size:10px;color:var(--muted);line-height:1.5;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">${n.summary}</div>` : ''}
        <div style="font-size:10px;color:var(--muted);margin-top:5px">${n.source||''}</div>
      </div></a>`;
  }).join('');
}

async function generateDigest() {
  const st = document.getElementById('news-status');
  if (st) st.innerHTML = '⏳ Generating digest…';
  try {
    const d = await api('/news/digest/generate', {method:'POST'});
    _renderDigest(d);
    if (st) st.innerHTML = `✅ Digest for ${d.date||'today'}`;
  } catch(e) { if (st) st.innerHTML = `❌ ${e.message}`; }
}

async function loadDigest() {
  try {
    const d = await api('/news/digest');
    if (d && d.date) _renderDigest(d);
  } catch(e) {}
}

function _renderDigest(d) {
  const el = document.getElementById('news-digest');
  if (!el || !d) return;
  const bull = (d.oi_changes||[]).filter(s => s.signal==='BULLISH').slice(0,4);
  const bear = (d.oi_changes||[]).filter(s => s.signal==='BEARISH').slice(0,4);
  el.style.display = '';
  el.innerHTML = `
    <div class="card" style="padding:14px;border-left:4px solid #3b82f6;margin-bottom:12px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
        <span style="font-size:14px;font-weight:800">🌅 Morning Digest — ${d.date||''}</span>
        <span style="font-size:11px;color:var(--muted)">${d.generated_at||''}</span>
      </div>
      <div style="font-size:13px;color:var(--text);margin-bottom:10px">${d.market_summary||''}</div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <div style="flex:1;min-width:200px">
          <div style="font-size:11px;font-weight:700;color:#22c55e;margin-bottom:6px">🟢 BULLISH OI</div>
          ${bull.length ? bull.map(s => `<div style="padding:4px 8px;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2);border-radius:4px;margin-bottom:4px">
            <span style="font-weight:700;color:var(--accent)">${s.symbol}</span>
            <span style="font-size:10px;color:var(--muted);margin-left:6px">${s.detail}</span>
          </div>`).join('') : '<div style="color:var(--muted);font-size:11px">No significant bullish OI flow</div>'}
        </div>
        <div style="flex:1;min-width:200px">
          <div style="font-size:11px;font-weight:700;color:#ef4444;margin-bottom:6px">🔴 BEARISH OI</div>
          ${bear.length ? bear.map(s => `<div style="padding:4px 8px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:4px;margin-bottom:4px">
            <span style="font-weight:700;color:var(--accent)">${s.symbol}</span>
            <span style="font-size:10px;color:var(--muted);margin-left:6px">${s.detail}</span>
          </div>`).join('') : '<div style="color:var(--muted);font-size:11px">No significant bearish OI flow</div>'}
        </div>
      </div>
    </div>`;
}

// Auto-load news when tab clicked
document.querySelectorAll('[data-tab="news"]').forEach(btn =>
  btn.addEventListener('click', () => { setTimeout(() => { loadDigest(); loadNews(); }, 100); }));


// INTRADAY TAB — Market Regime + Momentum Ignition
// ════════════════════════════════════════════════════════════════════════════

let _intradayRegimeData = [];
let _intradayMomentumData = [];

async function _intradayLoadWatchlists() {
  const sel = document.getElementById('intraday-watchlist');
  if (!sel) return;
  try {
    await _loadWatchlistDropdown('intraday-watchlist', 'intraday-wl-count', 'Intraday Core 40 (default)');
    sel.value = '';
    _updateWlCount('intraday-watchlist', 'intraday-wl-count');
    sel.onchange = () => _updateWlCount('intraday-watchlist', 'intraday-wl-count');
  } catch(e) { console.warn('intraday wl load:', e.message); }
}

function _intradayStateColor(state) {
  const s = String(state || '').toLowerCase();
  if (s.includes('strong') || s.includes('trend day')) return '#22c55e';
  if (s.includes('trend')) return '#4ade80';
  if (s.includes('range')) return '#f59e0b';
  if (s.includes('neutral')) return '#64748b';
  if (s.includes('chop')) return '#ef4444';
  return '#64748b';
}

function _renderIntradayRegime(d) {
  const summaryEl = document.getElementById('intraday-regime-summary');
  const resultsEl = document.getElementById('intraday-regime-results');
  if (!summaryEl || !resultsEl) return;
  const summary = d?.summary || {};
  const rows = d?.results || [];
  _intradayRegimeData = rows;

  summaryEl.innerHTML = `
    <div style="background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.28);border-radius:6px;padding:6px 10px;font-size:11px">
      <div style="color:var(--muted)">Market State</div>
      <div style="font-size:13px;font-weight:800;color:${_intradayStateColor(summary.state)}">${summary.state || '—'}</div>
    </div>
    <div style="background:rgba(59,130,246,.12);border:1px solid rgba(59,130,246,.28);border-radius:6px;padding:6px 10px;font-size:11px">
      <div style="color:var(--muted)">Direction</div>
      <div style="font-size:13px;font-weight:800;color:${summary.direction === 'BULLISH' ? '#22c55e' : summary.direction === 'BEARISH' ? '#ef4444' : '#64748b'}">${summary.direction || '—'}</div>
    </div>
    <div style="background:rgba(168,85,247,.12);border:1px solid rgba(168,85,247,.28);border-radius:6px;padding:6px 10px;font-size:11px">
      <div style="color:var(--muted)">Trend Score</div>
      <div style="font-size:13px;font-weight:800;color:#c084fc">${summary.score != null ? summary.score : '—'}</div>
    </div>
    <div style="background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.28);border-radius:6px;padding:6px 10px;font-size:11px">
      <div style="color:var(--muted)">Chop Score</div>
      <div style="font-size:13px;font-weight:800;color:#f59e0b">${summary.chop_score != null ? summary.chop_score : '—'}</div>
    </div>`;

  resultsEl.innerHTML = rows.length ? rows.map(r => {
    const c = _intradayStateColor(r.state);
    const dirC = r.direction === 'BULLISH' ? '#22c55e' : r.direction === 'BEARISH' ? '#ef4444' : '#64748b';
    return `
      <div class="card" style="padding:10px;border:1px solid var(--border);background:rgba(255,255,255,.02)">
        <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;margin-bottom:6px;flex-wrap:wrap">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span style="font-size:15px;font-weight:900;color:var(--accent)">${r.symbol}</span>
            <span style="background:${dirC}22;border:1px solid ${dirC}55;color:${dirC};padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700">${r.direction || '—'}</span>
            <span style="background:${c}22;border:1px solid ${c}55;color:${c};padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700">${r.state || '—'}</span>
          </div>
          <div style="font-size:18px;font-weight:900;color:${c}">${r.trend_score ?? '—'}</div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 10px;font-size:11px;color:var(--muted)">
          <div>Price: <b style="color:var(--text)">${fmt(r.price,2)}</b></div>
          <div>VWAP: <b style="color:var(--text)">${fmt(r.vwap,2)}</b></div>
          <div>EMA9: <b style="color:var(--text)">${fmt(r.ema9,2)}</b></div>
          <div>EMA20: <b style="color:var(--text)">${fmt(r.ema20,2)}</b></div>
          <div>RVOL: <b style="color:var(--text)">${fmt(r.rel_vol,2)}x</b></div>
          <div>ORB: <b style="color:var(--text)">${fmt(r.orb_high,2)} / ${fmt(r.orb_low,2)}</b></div>
        </div>
        <div style="margin-top:6px;font-size:11px;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap">
          <span>TF ${r.timeframe || '—'}</span>
          <span>Age ${r.trend_age ?? '—'} bars</span>
          <span>Body ${r.candle_body_pct ?? '—'}%</span>
          <span>Range ${r.candle_range_atr ?? '—'}x ATR</span>
        </div>
        <div style="margin-top:6px">${_edgeScoreBlock(r)}</div>
        <div style="margin-top:6px;font-size:11px;color:var(--muted)">${(r.signals || []).slice(0,6).map(s=>`<span style="display:inline-block;margin:2px 4px 0 0;padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid var(--border)">${s}</span>`).join(' ')}</div>
      </div>`;
  }).join('') : '<div style="color:var(--muted);font-size:12px;padding:14px">No regime rows yet. Click <b>Market Regime</b> or <b>Run Both</b>.</div>';
}

async function runIntradayRegime() {
  const st = document.getElementById('intraday-status');
  const tf = document.getElementById('intraday-tf')?.value || '5m';
  if (st) st.innerHTML = '⏳ Running intraday market regime…';
  try {
    const d = await api(`/intraday/regime?timeframe=${encodeURIComponent(tf)}&symbols=SPY,QQQ,IWM`);
    _renderIntradayRegime(d);
    if (st) st.innerHTML = `✅ ${d.count || (d.results||[]).length || 0} regime symbols · ${d.summary?.state || '—'}`;
  } catch(e) {
    if (st) st.innerHTML = `❌ ${e.message}`;
  }
}

function _renderMomentumIgnition(d) {
  const el = document.getElementById('intraday-results');
  if (!el) return;
  const rows = (d && d.results) ? d.results : [];
  _intradayMomentumData = rows;
  if (!rows.length) {
    el.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:14px">No momentum ignition setups found. Try lowering Min Score or Min RVOL.</div>';
    return;
  }
  el.innerHTML = rows.map(r => {
    const dirC = r.direction === 'BULLISH' ? '#22c55e' : r.direction === 'BEARISH' ? '#ef4444' : '#64748b';
    const scoreC = (r.final_score || r.score || 0) >= 80 ? '#22c55e' : (r.final_score || r.score || 0) >= 60 ? '#4ade80' : '#f59e0b';
    return `
      <div class="card" style="padding:10px;border:1px solid var(--border);background:rgba(255,255,255,.02)">
        <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;margin-bottom:6px;flex-wrap:wrap">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span style="font-size:15px;font-weight:900;color:var(--accent)">${r.symbol}</span>
            <span style="background:${dirC}22;border:1px solid ${dirC}55;color:${dirC};padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700">${r.direction || '—'}</span>
            <span style="background:${scoreC}22;border:1px solid ${scoreC}55;color:${scoreC};padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700">${r.final_score ?? r.score ?? '—'}</span>
          </div>
          <div style="font-size:11px;color:var(--muted);text-align:right">
            <div>${r.setup_type || 'Momentum Ignition'}</div>
            <div>Age ${r.trend_age ?? '—'} bars</div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 10px;font-size:11px;color:var(--muted)">
          <div>Price: <b style="color:var(--text)">${fmt(r.price,2)}</b></div>
          <div>RVOL: <b style="color:var(--text)">${fmt(r.rel_vol,2)}x</b></div>
          <div>VWAP: <b style="color:var(--text)">${fmt(r.vwap,2)}</b></div>
          <div>EMA9/20: <b style="color:var(--text)">${fmt(r.ema9,2)} / ${fmt(r.ema20,2)}</b></div>
          <div>ORB: <b style="color:var(--text)">${fmt(r.orb_high,2)} / ${fmt(r.orb_low,2)}</b></div>
          <div>ATR: <b style="color:var(--text)">${fmt(r.atr14,3)}</b></div>
        </div>
        <div style="margin-top:6px">${_edgeScoreBlock(r)}</div>
        <div style="margin-top:6px;font-size:11px;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap">
          <span>${r.vwap_bias || '—'} VWAP</span>
          <span>${r.ema_bias || '—'} EMA</span>
          <span>Body ${r.candle_body_pct ?? '—'}%</span>
          <span>Range ${r.candle_range_atr ?? '—'}x ATR</span>
          ${r.earn_days != null ? `<span>Earn ${r.earn_days}d</span>` : ''}
        </div>
        <div style="margin-top:6px;font-size:11px;color:var(--muted)">${(r.signals || []).slice(0,6).map(s=>`<span style="display:inline-block;margin:2px 4px 0 0;padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid var(--border)">${s}</span>`).join(' ')}</div>
      </div>`;
  }).join('');
}

async function runMomentumIgnition() {
  const st = document.getElementById('intraday-status');
  const tf = document.getElementById('intraday-tf')?.value || '5m';
  const wlId = document.getElementById('intraday-watchlist')?.value || '';
  const minRvol = document.getElementById('intraday-min-rvol')?.value || '1.5';
  const minAtr = document.getElementById('intraday-min-atr')?.value || '0.8';
  const minScore = document.getElementById('intraday-min-score')?.value || '60';
  if (st) st.innerHTML = '⏳ Scanning momentum ignition setups…';
  try {
    const params = new URLSearchParams({ timeframe: tf, min_rvol: minRvol, min_candle_atr: minAtr, min_score: minScore });
    if (wlId) params.set('watchlist_id', wlId);
    const d = await api(`/intraday/momentum_ignition?${params.toString()}`);
    _renderMomentumIgnition(d);
    if (st) st.innerHTML = `✅ ${d.count || (d.results||[]).length || 0} momentum setups${wlId ? ' · watchlist' : ' · core 40'}`;
  } catch(e) {
    if (st) st.innerHTML = `❌ ${e.message}`;
  }
}

async function runIntradayScan() {
  await runIntradayRegime();
  await runMomentumIgnition();
}

// S/R BREAKOUT SCANNER

async function runSRBreakout() {

  _srNav('breakout');
  const st  = document.getElementById('sr-status');
  const el  = document.getElementById('sr-results');
  const min = document.getElementById('sr-min-strength')?.value||40;
  const mom = document.getElementById('sr-require-momentum')?.checked;
  const sec = document.getElementById('sr-sector')?.value||'';
  const earn = document.getElementById('sr-min-earn-days')?.value || '';
  if (st) st.innerHTML='⏳ Scanning S/R breakouts across watchlist…';
  if (el) el.innerHTML='';
  try {
    const _srWlId = document.getElementById('sr-watchlist')?.value || '';
    const _srWlQ  = _srWlId ? `&watchlist_id=${_srWlId}` : '';
    const d = await api(`/scanner/sr/scan?min_strength=${min}&require_momentum=${mom}&sector=${encodeURIComponent(sec)}${earn ? '&min_earn_days=' + earn : ''}${_srWlQ}`);
    const results = d.results||[];
    if (st) st.innerHTML=`✅ ${results.length} breakouts found`;
    if (!results.length) {
      el.innerHTML='<div style="color:var(--muted);padding:20px">No confirmed S/R breakouts found. Try lowering Min Strength or unchecking Momentum Confirmed.</div>';
      return;
    }
    _renderSRResults(results, el);
  } catch(e) { if(st) st.innerHTML=`❌ ${e.message}`; }
}


let _srAgeSortKey = 'score';
let _srAgeSortDir = -1;
let _srAgeData = [];

async function runSRAgeBreakout() {
  _srNav('age');
  const st  = document.getElementById('sr-age-status');
  const el  = document.getElementById('sr-age-results');
  const days = +document.getElementById('sr-age-days')?.value || 10;
  const min  = +document.getElementById('sr-age-min-strength')?.value || 40;
  const mom  = document.getElementById('sr-age-require-momentum')?.checked ?? true;
  const sec  = document.getElementById('sr-age-sector')?.value || '';
  const earn = document.getElementById('sr-min-earn-days')?.value || '';
  if (st) st.innerHTML = `⏳ Scanning breakouts from the last ${days} day(s)…`;
  if (el) el.innerHTML = '<div style="padding:16px;color:var(--muted)">⏳ Finding recent breakout age setups across the watchlist…</div>';
  try {
    const _srWlId = document.getElementById('sr-watchlist')?.value || '';
    const _srWlQ  = _srWlId ? `&watchlist_id=${_srWlId}` : '';
    const d = await api(`/api/scanner/sr/age_scan?days_back=${days}&min_strength=${min}&require_momentum=${mom}&sector=${encodeURIComponent(sec)}${earn ? '&min_earn_days=' + earn : ''}${_srWlQ}`);
    const results = d.results || [];
    _srAgeData = results;
    if (st) st.innerHTML = `✅ ${results.length} breakout-age setup(s) found`;
    if (!results.length) {
      if (el) el.innerHTML = '<div style="color:var(--muted);padding:20px">No breakout-age setups found. Try increasing Days Back or lowering Min Strength.</div>';
      return;
    }
    _renderSRAgeResults(results, el);
  } catch(e) {
    if (st) st.innerHTML = `❌ ${e.message}`;
    if (el) el.innerHTML = '';
  }
}

function _sortSRAge(key) {
  if (_srAgeSortKey === key) _srAgeSortDir *= -1;
  else { _srAgeSortKey = key; _srAgeSortDir = (key === 'symbol' || key === 'breakout_date') ? 1 : -1; }
  const data = [..._srAgeData].sort((a,b) => {
    const va = a?.[key], vb = b?.[key];
    if (va == null && vb == null) return 0;
    if (va == null) return 1;
    if (vb == null) return -1;
    if (typeof va === 'number' && typeof vb === 'number') return (_srAgeSortDir) * (va - vb);
    const sa = String(va).toLowerCase(), sb = String(vb).toLowerCase();
    return _srAgeSortDir * (sa < sb ? -1 : sa > sb ? 1 : 0);
  });
  _renderSRAgeResults(data, document.getElementById('sr-age-results'));
}

function _fmtPct(v) {
  if (v == null || Number.isNaN(v)) return '—';
  const n = +v;
  return `${n > 0 ? '+' : ''}${n.toFixed(2)}%`;
}

function _renderSRAgeResults(results, el) {
  if (!el) return;
  if (!results.length) {
    el.innerHTML = '<div style="color:var(--muted);padding:20px">No results.</div>';
    return;
  }
  const statusColor = s => s === 'Fresh' ? '#22c55e' : s === 'Running' ? '#3b82f6' : s === 'Retesting' ? '#f59e0b' : '#ef4444';
  const typeLabel = t => t === 'resistance_break' ? 'Above resistance' : 'Below support';
  const th = (label, key, align='') => `<th onclick="_sortSRAge('${key}')" style="cursor:pointer;user-select:none;white-space:nowrap;padding:6px 8px;${align?'text-align:'+align:''}">${label} <span style="color:var(--muted);font-size:9px">⇅</span></th>`;
  const rows = results.map(r => `
    <tr style="vertical-align:top;">
      <td style="padding:6px 8px;font-weight:800;color:var(--accent);white-space:nowrap">${r.symbol}</td>
      <td style="padding:6px 8px;white-space:nowrap">${r.timeframe||'1d'}</td>
      <td style="padding:6px 8px;white-space:nowrap">${r.breakout_date||'—'}</td>
      <td style="padding:6px 8px;text-align:right;white-space:nowrap">${r.days_since ?? '—'}</td>
      <td style="padding:6px 8px;white-space:nowrap">${typeLabel(r.breakout_type)} @ $${r.level ?? '—'}</td>
      <td style="padding:6px 8px;white-space:nowrap;color:${r.direction==='BULLISH'?'#22c55e':'#ef4444'};font-weight:700">${r.direction||'—'}</td>
      <td style="padding:6px 8px;white-space:normal;min-width:180px">
        <div>Start: <b>$${r.breakout_close ?? '—'}</b></div>
        <div>Now: <b>$${r.current_close ?? '—'}</b></div>
      </td>
      <td style="padding:6px 8px;white-space:nowrap;font-weight:700;color:${(r.directional_return_pct||0)>=0?'#22c55e':'#ef4444'}">${_fmtPct(r.directional_return_pct)}</td>
      <td style="padding:6px 8px;white-space:nowrap;color:${(r.max_favorable_pct||0)>=0?'#22c55e':'#ef4444'}">${_fmtPct(r.max_favorable_pct)}</td>
      <td style="padding:6px 8px;white-space:nowrap;color:${(r.max_adverse_pct||0)>=0?'#22c55e':'#ef4444'}">${_fmtPct(r.max_adverse_pct)}</td>
      <td style="padding:6px 8px;white-space:nowrap"><span style="background:${statusColor(r.status)}22;border:1px solid ${statusColor(r.status)}55;color:${statusColor(r.status)};padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700">${r.status||'—'}</span></td>
      <td style="padding:6px 8px;white-space:nowrap;font-weight:700;color:var(--text)">${r.score ?? '—'}</td>
      <td style="padding:6px 8px;white-space:nowrap;min-width:220px">${_edgeScoreCell(r)}</td>
      <td style="padding:6px 8px;white-space:normal;min-width:220px">${(r.notes||[]).map(n => `<div style="line-height:1.4">• ${n}</div>`).join('')}</td>
    </tr>`).join('');
  el.innerHTML = `
    <div class="card" style="padding:12px;overflow-x:auto">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap">
        <div style="font-size:12px;font-weight:700;color:var(--text)">⏱ Breakout Age Scanner</div>
        <div style="font-size:10px;color:var(--muted)">Shows the most recent breakout within the selected days back window.</div>
      </div>
      <table class="data-tbl" style="width:100%;table-layout:auto;border-collapse:collapse;font-size:11px">
        <thead>
          <tr>
            ${th('Symbol','symbol')}
            ${th('TF','timeframe')}
            ${th('Breakout Date','breakout_date')}
            ${th('Days Ago','days_since','right')}
            ${th('Level Broken','level')}
            ${th('Dir','direction')}
            ${th('Entry / Current','breakout_close')}
            ${th('Since Breakout','directional_return_pct')}
            ${th('MFE','max_favorable_pct')}
            ${th('MAE','max_adverse_pct')}
            ${th('Status','status')}
            ${th('Score','score')}
            ${th('Edge Scores','Shared RS / vol / sector / inst / EM scores')}
            <th style="padding:6px 8px;white-space:nowrap">Notes</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;
}

function _renderSRResults(results, el) {
  const resistBreaks = results.filter(r=>r.breakout_type==='resistance_break');
  const supportBreaks= results.filter(r=>r.breakout_type==='support_break');

  function renderGroup(items, title, titleColor) {
    if (!items.length) return '';
    const rows = items.map((r,i) => {
      const pctC = r.breakout_type==='resistance_break'?'#22c55e':'#ef4444';
      const tfBadge = r.timeframe==='1wk'
        ? '<span style="background:rgba(168,85,247,.2);border:1px solid #a855f744;color:#d8b4fe;padding:1px 5px;border-radius:3px;font-size:9px">Weekly</span>'
        : '<span style="background:rgba(59,130,246,.15);border:1px solid #3b82f644;color:#93c5fd;padding:1px 5px;border-radius:3px;font-size:9px">Daily</span>';
      const momBadge = r.momentum_confirmed
        ? '<span style="background:rgba(34,197,94,.15);border:1px solid #22c55e44;color:#86efac;padding:1px 5px;border-radius:3px;font-size:9px">✓ MOM</span>'
        : '<span style="background:rgba(100,116,139,.1);color:#64748b;padding:1px 5px;border-radius:3px;font-size:9px">no mom</span>';
      const recency = r.bar_offset===1?'<b style="color:#f59e0b">Today</b>':r.bar_offset===2?'Yesterday':`${r.bar_offset}d ago`;
      const channels = (r.channels||[]).map(c=>{
        const cC = c.type==='resistance'?'#ef4444':c.type==='support'?'#22c55e':'#64748b';
        return `<span style="font-size:9px;color:${cC}">${c.type==='resistance'?'R':'S'}:$${c.hi}/$${c.lo}(str:${c.strength})</span>`;
      }).join(' · ');
      return `<tr style="background:${i%2?'var(--surface)':'var(--card)'}">
        <td style="font-weight:800;color:var(--accent);padding:6px 8px">${r.symbol}</td>
        <td style="padding:6px 6px">${tfBadge}</td>
        <td style="padding:6px 4px">${momBadge}</td>
        <td style="padding:6px 6px;font-size:11px;color:var(--muted)">${recency}</td>
        <td style="padding:6px 6px;font-size:12px;color:var(--muted)">$${r.spot}</td>
        <td style="padding:6px 8px;font-weight:700;color:${pctC};font-size:13px">${r.pct_change>0?'+':''}${r.pct_change}%</td>
        <td style="padding:6px 6px;font-size:11px;color:var(--muted)">
          ${r.breakout_type==='resistance_break'?'Broke above $'+r.level:'Broke below $'+r.level}
        </td>
        <td style="padding:6px 6px;font-size:10px;color:#64748b">Thr: ${r.momentum_threshold?.toFixed(2)||'—'}%</td>
        <td style="padding:6px 6px;font-size:10px;min-width:220px">${_edgeScoreCell(r)}</td>
        <td style="padding:6px 6px;font-size:10px;color:var(--muted);max-width:220px;white-space:normal">${channels}</td>
      </tr>`;
    }).join('');
    return `
      <div style="margin-bottom:16px">
        <div style="font-size:12px;font-weight:700;color:${titleColor};margin-bottom:6px;letter-spacing:.08em">${title} (${items.length})</div>
        <table class="data-tbl" style="font-size:11px;width:100%">
          <thead><tr>
            <th>Symbol</th><th>TF</th><th>Momentum</th><th>When</th>
            <th>Spot</th><th>Move%</th><th>Level Broken</th><th>Threshold</th><th>Edge Scores</th><th>S/R Levels</th>
          </tr></thead>
          <tbody>${rows}</tbody>
        </table>
      </div>`;
  }

  el.innerHTML = `
    ${renderGroup(resistBreaks,'🟢 RESISTANCE BREAKS (Bullish — potential long setups)','#22c55e')}
    ${renderGroup(supportBreaks,'🔴 SUPPORT BREAKS (Bearish — potential short/put setups)','#ef4444')}`;
}

// Auto-load when SR tab clicked
document.querySelectorAll('[data-tab="srbreak"]').forEach(btn=>
  btn.addEventListener('click', ()=>{ setTimeout(runSRBreakout, 100); }));
// tab loading now handled in setupTabs()


// REGIME SCANNER PAGE

let _regimeAllData = [];

async function runRegimeScan() {
  const st = document.getElementById('regime-status');
  const t0 = Date.now();
  let _timer = null;
  // Add banner above existing results so user knows they're stale
  const regTbl = document.getElementById('regime-table');
  if (regTbl) {
    const banner = document.createElement('div');
    banner.id = 'regime-scan-banner';
    banner.style.cssText = 'background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);border-radius:6px;padding:8px 12px;font-size:11px;color:#f59e0b;margin-bottom:8px';
    banner.innerHTML = '⏳ New scan running in background — table shows previous results';
    regTbl.parentNode.insertBefore(banner, regTbl);
  }
  if (st) {
    st.innerHTML = '⏳ Running full regime scan… (1–3 min)';
    _timer = setInterval(() => {
      const elapsed = Math.round((Date.now()-t0)/1000);
      if (st) st.innerHTML = `⏳ Scanning… ${elapsed}s — results below are from previous scan`;
    }, 2000);
  }
  try {
    const r = await api('/regime/scan', {method:'POST'});
    clearInterval(_timer);
    const ts = r.completed_at || new Date().toLocaleTimeString();
    if (st) st.innerHTML = `✅ Scanned ${r.scanned} symbols · ${r.errors} errors · Completed at ${ts}`;
    _updateMetaBar();
    loadRegimeResults();
  } catch(e) {
    clearInterval(_timer);
    if (st) st.innerHTML = `❌ ${e.message}`;
  }
}

async function loadRegimeResults() {
  const st     = document.getElementById('regime-status');
  const regime = document.getElementById('regime-filter')?.value || 'ALL';
  const bias   = document.getElementById('regime-bias-filter')?.value || 'ALL';
  const sector = document.getElementById('regime-sector-filter')?.value || '';
  try {
    const d = await api(`/regime/results?regime=${regime}&bias=${bias}&sector=${encodeURIComponent(sector)}`);
    _regimeAllData = d.results || [];
    const _ts = d.completed_at ? ` · Completed ${d.completed_at}` : ` · Scan date: ${d.date}`;
    if (st) st.innerHTML = `✅ ${_regimeAllData.length} symbols${_ts}`;
    _renderRegimeSummary(_regimeAllData);
    filterRegimeTable();
  } catch(e) { if (st) st.innerHTML = `❌ ${e.message}`; addNotif('error', 'Regime results failed', e.message, 'Regime'); }
}

function filterRegimeTable() {
  const q = (document.getElementById('regime-search')?.value||'').toUpperCase();
  const data = q ? _regimeAllData.filter(r => r.symbol.includes(q)) : _regimeAllData;
  _renderRegimeTable(data);
}

function _renderRegimeSummary(data) {
  const el = document.getElementById('regime-summary');
  if (!el || !data.length) return;
  const counts = {};
  data.forEach(r => { counts[r.regime] = (counts[r.regime]||0) + 1; });
  const regimeInfo = {
    TRENDING_UP:    {icon:'📈',color:'#22c55e',label:'Trending Up'},
    TRENDING_DOWN:  {icon:'📉',color:'#ef4444',label:'Trending Down'},
    MEAN_REV_BULL:  {icon:'🔄↑',color:'#4ade80',label:'MR Bull'},
    MEAN_REV_BEAR:  {icon:'🔄↓',color:'#f97316',label:'MR Bear'},
    MILD_BULLISH:   {icon:'↗',color:'#86efac',label:'Mild Bull'},
    MILD_BEARISH:   {icon:'↘',color:'#fca5a5',label:'Mild Bear'},
    SIDEWAYS:       {icon:'↔',color:'#64748b',label:'Sideways'},
  };
  el.innerHTML = Object.entries(counts).map(([regime, cnt]) => {
    const info = regimeInfo[regime] || {icon:'?',color:'#64748b',label:regime};
    return `<div style="background:${info.color}18;border:1px solid ${info.color}44;
      border-radius:5px;padding:5px 10px;cursor:pointer"
      onclick="document.getElementById('regime-filter').value='${regime}';loadRegimeResults()">
      <span style="color:${info.color};font-size:12px;font-weight:700">${info.icon} ${info.label}</span>
      <span style="color:var(--muted);font-size:11px;margin-left:6px">${cnt}</span>
    </div>`;
  }).join('');
}


function _renderRegimeTable(data) {
  const el = document.getElementById('regime-table');
  if (!el) return;
  if (!data.length) {
    el.innerHTML='<div style="color:var(--muted);padding:20px">No results. Click ▶ Run Scan Now to scan all symbols.</div>';
    return;
  }
  if (!window._regimeSort) window._regimeSort={col:'confidence',dir:-1};
  const {col:sCol,dir:sDir}=window._regimeSort;

  const colOrder={TRENDING_UP:0,TRENDING_UP_OB:1,MILD_BULLISH:2,MEAN_REV_BULL:1,
                  SIDEWAYS:3,MEAN_REV_BEAR:5,MILD_BEARISH:4,TRENDING_DOWN_OS:5,TRENDING_DOWN:6};

  const sorted=[...data].sort((a,b)=>{
    const sda=a.signals_data||{},sdb=b.signals_data||{};
    switch(sCol){
      case 'symbol':     return sDir*(a.symbol<b.symbol?-1:a.symbol>b.symbol?1:0);
      case 'regime':     return sDir*((colOrder[a.regime]??3)-(colOrder[b.regime]??3));
      case 'bias':       return sDir*(a.bias<b.bias?-1:a.bias>b.bias?1:0);
      case 'confidence': return sDir*((a.confidence||0)-(b.confidence||0));
      case 'score':      return sDir*((sda.score||0)-(sdb.score||0));
      case 'rsi_diff':   return sDir*((a.rsi_diff||0)-(b.rsi_diff||0));
      case 'rsi':        return sDir*((a.rsi||0)-(b.rsi||0));
      case 'ema_trend':  return sDir*(a.ema_trend<b.ema_trend?-1:a.ema_trend>b.ema_trend?1:0);
      case 'macd':       return sDir*(a.macd<b.macd?-1:a.macd>b.macd?1:0);
      case 'adx':        return sDir*((a.adx||0)-(b.adx||0));
      case 'large_move':{const ma=sda.largest_move_10d,mb=sdb.largest_move_10d;return sDir*((ma?Math.abs(ma.chg_pct):0)-(mb?Math.abs(mb.chg_pct):0));}
      case 'earn_days':  return sDir*((a.earn_days??999)-(b.earn_days??999));
      case 'vol_spike':  return sDir*((sda.vol_spike_info?.vol_ratio||0)-(sdb.vol_spike_info?.vol_ratio||0));
      case 'earn_score': return sDir*((sda.earn_score??-99)-(sdb.earn_score??-99));
      case 'iv_rank': return sDir*((sda.iv_rank??50)-(sdb.iv_rank??50));
      case 'fut_oi': return sDir*((sda.futures_oi?.score??0)-(sdb.futures_oi?.score??0));
      default: return 0;
    }
  });

  const _th=(label,col,w)=>{
    const active=sCol===col, arrow=active?(sDir>0?' ▲':' ▼'):'';
    return `<th style="cursor:pointer;user-select:none;white-space:nowrap;padding:4px 5px;${w?'min-width:'+w+';':''}${active?'color:var(--accent)':''}" onclick="_regimeSortBy('${col}')">${label}${arrow}</th>`;
  };
  const _thF=(l)=>`<th style="padding:4px 5px;white-space:nowrap">${l}</th>`;

  const RS={
    TRENDING_UP:     {bg:'rgba(34,197,94,.12)',  c:'#22c55e',icon:'📈'},
    TRENDING_UP_OB:  {bg:'rgba(249,115,22,.12)', c:'#f97316',icon:'📈⚠'},
    TRENDING_DOWN:   {bg:'rgba(239,68,68,.12)',  c:'#ef4444',icon:'📉'},
    TRENDING_DOWN_OS:{bg:'rgba(74,222,128,.10)', c:'#4ade80',icon:'📉⚠'},
    MEAN_REV_BULL:   {bg:'rgba(74,222,128,.12)', c:'#4ade80',icon:'🔄↑'},
    MEAN_REV_BEAR:   {bg:'rgba(249,115,22,.12)', c:'#f97316',icon:'🔄↓'},
    MILD_BULLISH:    {bg:'rgba(134,239,172,.08)',c:'#86efac',icon:'↗'},
    MILD_BEARISH:    {bg:'rgba(252,165,165,.08)',c:'#fca5a5',icon:'↘'},
    SIDEWAYS:        {bg:'rgba(100,116,139,.08)',c:'#94a3b8',icon:'↔'},
  };

  const rows=sorted.map((r,idx)=>{
    const rs=RS[r.regime]||{bg:'rgba(100,116,139,.08)',c:'#94a3b8',icon:'?'};
    const bC=r.bias==='Bullish'?'#22c55e':r.bias==='Bearish'?'#ef4444':'#94a3b8';
    const conf=r.confidence||0, confC=conf>=75?'#22c55e':conf>=55?'#f59e0b':'#ef4444';
    const sd=r.signals_data||{};
    const score=sd.score||0, absS=Math.min(100,Math.abs(score)), sC=score>0?'#22c55e':'#ef4444';
    const rdC=(r.rsi_diff||0)>=20?'#ef4444':(r.rsi_diff||0)>=12?'#f97316':(r.rsi_diff||0)<=-20?'#22c55e':(r.rsi_diff||0)<=-12?'#4ade80':'#94a3b8';
    const adxC=(r.adx||0)>=40?'#f97316':(r.adx||0)>=30?'#22c55e':(r.adx||0)>=20?'#f59e0b':'#64748b';
    const macdC=r.macd?.includes('BULL')?'#22c55e':r.macd?.includes('BEAR')?'#ef4444':'#94a3b8';
    const emaTrC=r.ema_trend?.includes('UP')?'#22c55e':r.ema_trend?.includes('DOWN')?'#ef4444':'#94a3b8';

    // Big Move
    const lm=sd.largest_move_10d;
    const lmHtml=lm
      ?`<div style="white-space:nowrap"><span style="color:${lm.direction==='UP'?'#22c55e':'#ef4444'};font-weight:700">${lm.direction==='UP'?'▲':'▼'}${lm.chg_pct>0?'+':''}${lm.chg_pct}%</span><br><span style="font-size:9px;color:var(--muted)">${lm.date?lm.date.slice(5):(lm.bars_ago<=1?'yday':lm.bars_ago+'d')}</span></div>`
      :'<span style="color:var(--muted);font-size:10px">—</span>';

    // Earnings — FUTURE ONLY, with date
    const earnDate=sd.earn_date_str||'';
    const earnShort=earnDate?earnDate.slice(5):'';
    let earnHtml='<span style="color:var(--muted);font-size:10px">—</span>';
    if(r.post_earnings){
      earnHtml=`<span style="color:#3b82f6;font-weight:700;font-size:10px">📊 PE${earnShort?' '+earnShort:''}</span>`;
    } else if(r.earn_days!=null && r.earn_days>=1 && r.earn_days<999){
      const dc=r.earn_days<=7?'#ef4444':r.earn_days<=21?'#f59e0b':'var(--muted)';
      earnHtml=`<div style="white-space:nowrap"><span style="color:${dc};font-weight:700;font-size:11px">in ${r.earn_days}d</span><br><span style="font-size:9px;color:var(--muted)">${earnShort}</span></div>`;
    }

    // Vol spike
    const vs=sd.vol_spike_info;
    const vsHtml=(sd.vol_spike_10d&&vs)
      ?`<div style="white-space:nowrap"><span style="color:#f59e0b;font-weight:700">⚡${vs.vol_ratio}×</span><br><span style="font-size:9px;color:var(--muted)">${vs.date?vs.date.slice(5):(vs.bars_ago<=1?'yday':vs.bars_ago+'d')}</span></div>`
      :'<span style="color:var(--muted);font-size:10px">—</span>';

    // Earn score
    const es=sd.earn_score??null;
    const esHtml=es!=null?_earnScoreCell(es,sd.earn_score_notes):'<span style="color:var(--muted);font-size:10px">—</span>';

    // Signals — ultra compact, 3 pills, truncated with tooltip
    const sigs=(sd.signals||[]).slice(0,3);
    const momBadge=r.momentum_move?`<div style="background:rgba(251,191,36,.10);color:#fbbf24;padding:1px 3px;border-radius:2px;font-size:7px;margin-bottom:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:105px" title="${r.momentum_move}">🔥 ${r.momentum_move}</div>`:'';
    const pillHtml=sigs.map(s=>{
      const ip=s.includes('↑')||s.includes('bull')||s.includes('UP')||s.includes('OVERSOLD')||s.includes('bounce')||s.includes('beat');
      const in2=s.includes('↓')||s.includes('bear')||s.includes('DOWN')||s.includes('OVERBOUGHT')||s.includes('fade');
      const tc=ip?'#86efac':in2?'#fca5a5':'#a5b4fc';
      return `<div style="color:${tc};padding:0 2px;font-size:8px;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:105px" title="${s}">• ${s}</div>`;
    }).join('');

    // Strategy suggestions
    const strats=(sd.strategies||[]).slice(0,3);
    const stratHtml=strats.length
      ?strats.map((st,i)=>{
          const sc2=st.probability>=70?'#22c55e':st.probability>=55?'#f59e0b':st.probability>=40?'#f97316':'#ef4444';
          const typeC=st.type==='credit'?'#a855f7':st.type==='debit'?'#3b82f6':'#64748b';
          const ivrTag = sd.iv_rank != null ? `<span style="font-size:9px;padding:1px 4px;border-radius:3px;margin-left:4px;background:${sd.iv_rank>50?'rgba(168,85,247,.15)':'rgba(59,130,246,.15)'};color:${sd.iv_rank>50?'#c4b5fd':'#93c5fd'}">IVR ${Math.round(sd.iv_rank)}%</span>` : '';
          const biasC=st.bias==='Bullish'?'#22c55e':st.bias==='Bearish'?'#ef4444':'#94a3b8';
          return `<div style="display:flex;align-items:flex-start;gap:4px;padding:2px 0;${i>0?'border-top:1px solid rgba(255,255,255,.04)':''}">
            <div style="min-width:28px;height:28px;background:${sc2}22;border:1px solid ${sc2}44;border-radius:4px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <span style="font-size:12px;font-weight:900;color:${sc2}">${st.probability}</span>
            </div>
            <div style="overflow:hidden">
              <div style="font-size:13px;font-weight:700;color:${biasC};white-space:nowrap">${st.strategy}${i===0?ivrTag:""}</div>
              <div style="font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px" title="${st.note||''}">${st.note||''}</div>
            </div>
          </div>`;
        }).join('')
      :'<span style="color:var(--muted);font-size:9px">📡 run scan</span>';

    const rowBg=idx%2?'var(--surface)':'var(--card)';
    return `<tr style="background:${rowBg};cursor:pointer;vertical-align:top" onclick="_regimeRowExpand(${idx},this)">
      <td style="font-weight:800;color:var(--accent);font-size:13px;padding:5px 7px;white-space:nowrap;vertical-align:middle">${r.symbol}</td>
      <td style="padding:4px 5px;vertical-align:middle"><span style="background:${rs.bg};border:1px solid ${rs.c}44;color:${rs.c};padding:2px 5px;border-radius:3px;font-size:10px;font-weight:700;white-space:nowrap">${rs.icon} ${(r.regime||'').replace(/_/g,' ')}</span></td>
      <td style="padding:4px 4px;vertical-align:middle"><span style="color:${bC};font-weight:700;font-size:11px">${r.bias||'—'}</span></td>
      <td style="padding:4px 5px;vertical-align:middle">
        <div style="display:flex;align-items:center;gap:3px">
          <div style="width:36px;height:6px;background:var(--border);border-radius:3px;overflow:hidden"><div style="width:${conf}%;height:100%;background:${confC};border-radius:3px"></div></div>
          <span style="font-weight:800;color:${confC};font-size:11px">${conf}</span>
        </div>
      </td>
      <td style="padding:4px 4px;vertical-align:middle">
        <div style="display:flex;align-items:center;gap:3px">
          <div style="width:28px;height:5px;background:var(--border);border-radius:3px;overflow:hidden"><div style="width:${absS}%;height:100%;background:${sC};border-radius:3px"></div></div>
          <span style="font-size:10px;font-weight:700;color:${sC}">${score>0?'+':''}${score}</span>
        </div>
      </td>
      <td style="color:${rdC};font-weight:700;font-size:12px;padding:4px 4px;text-align:center;vertical-align:middle">${r.rsi_diff!=null?(r.rsi_diff>0?'+':'')+r.rsi_diff:'—'}</td>
      <td style="font-size:11px;color:var(--muted);padding:4px 3px;text-align:center;vertical-align:middle">${r.rsi!=null?r.rsi:'—'}</td>
      <td style="font-size:10px;color:${emaTrC};padding:4px 4px;white-space:nowrap;vertical-align:middle">${(r.ema_trend||'—').replace(/_/g,' ')}</td>
      <td style="font-size:11px;color:${macdC};font-weight:700;padding:4px 4px;vertical-align:middle">${(r.macd||'—').replace(/_/g,' ')}</td>
      <td style="color:${adxC};font-weight:700;font-size:12px;padding:4px 3px;text-align:center;vertical-align:middle">${r.adx!=null?r.adx:'—'}</td>
      <td style="padding:4px 5px;vertical-align:top">${lmHtml}</td>
      <td style="padding:4px 5px;vertical-align:top">${earnHtml}</td>
      <td style="padding:4px 5px;vertical-align:top">${vsHtml}</td>
      <td style="padding:4px 4px;vertical-align:top">${esHtml}</td>
      <td style="padding:4px 4px;vertical-align:top;text-align:center">${(()=>{
        const ivr=sd.iv_rank;
        if(ivr==null) return '<span style="color:var(--muted);font-size:10px">—</span>';
        const ivrC=ivr>60?'#a855f7':ivr>40?'#f59e0b':ivr>20?'#3b82f6':'#64748b';
        const label=ivr>60?'HIGH':ivr>40?'MID':ivr>20?'LOW':'VLOW';
        return `<div style="font-size:11px;font-weight:800;color:${ivrC}">${Math.round(ivr)}%</div><div style="font-size:8px;color:${ivrC}">${label}</div>`;
      })()}</td>
      <td style="padding:4px 4px;vertical-align:top;text-align:center">${(()=>{
        const fi=sd.futures_oi||r.futures_oi_signal||{};
        if(!fi.signal||fi.signal==='NO_DATA') return '<span style="color:var(--muted);font-size:10px">—</span>';
        const fc={LONG_BUILDUP:'#22c55e',SHORT_BUILDUP:'#ef4444',LONG_UNWINDING:'#f59e0b',SHORT_COVERING:'#3b82f6'}[fi.signal]||'#64748b';
        return `<div style="font-size:9px;font-weight:700;color:${fc}" title="${fi.description||''}">${fi.signal?.replace(/_/g,' ')}</div><div style="font-size:8px;color:var(--muted)">${fi.futures_symbol||''} ${fi.score>=0?'+':''}${fi.score||0}</div>`;
      })()}</td>
      <td style="padding:3px 4px;max-width:140px;vertical-align:top">${momBadge}${pillHtml}</td>
      <td style="padding:3px 5px;min-width:280px;vertical-align:top">${stratHtml}</td>
    </tr>
    <tr id="regime-expand-${idx}" style="display:none;background:rgba(0,0,0,.25)">
      <td colspan="18" style="padding:0">${_buildRegimeExpandPanel(r)}</td>
    </tr>`;
  }).join('');

  el.innerHTML=`<div style="overflow-x:auto"><table class="data-tbl" style="font-size:11px;width:100%;border-collapse:collapse">
    <colgroup>
      <col style="width:55px"/><col style="width:120px"/><col style="width:50px"/>
      <col style="width:68px"/><col style="width:56px"/>
      <col style="width:58px"/><col style="width:36px"/>
      <col style="width:78px"/><col style="width:64px"/><col style="width:38px"/>
      <col style="width:86px"/><col style="width:76px"/>
      <col style="width:72px"/><col style="width:64px"/>
      <col style="width:110px"/><col style="width:80px"/><col style="min-width:190px"/>
    </colgroup>
    <thead><tr>
      ${_th('Symbol','symbol')}
      ${_th('Regime','regime')}
      ${_th('Bias','bias')}
      ${_th('Conf','confidence')}
      ${_th('Score','score')}
      ${_th('RSI-EMA','rsi_diff')}
      ${_th('RSI','rsi')}
      ${_th('EMA Trend','ema_trend')}
      ${_th('MACD','macd')}
      ${_th('ADX','adx')}
      ${_th('Big Move','large_move')}
      ${_th('Earn Days','earn_days')}
      ${_th('Vol Spike','vol_spike')}
      ${_th('Earn Sc','earn_score')}
      ${_th('IVR','iv_rank')}
      ${_th('Fut OI','fut_oi')}
      ${_thF('Signals')}
      ${_thF('Top Strategies (prob %)')}
    </tr></thead>
    <tbody>${rows}</tbody>
  </table></div>`;
}

function _regimeSortBy(col) {
  if (!window._regimeSort) window._regimeSort = {col, dir: -1};
  if (window._regimeSort.col === col) window._regimeSort.dir *= -1;
  else { window._regimeSort.col = col; window._regimeSort.dir = -1; }
  filterRegimeTable();
}

function _regimeRowExpand(idx, rowEl) {
  const panel = document.getElementById(`regime-expand-${idx}`);
  if (!panel) return;
  const isOpen = panel.style.display !== 'none';
  panel.style.display = isOpen ? 'none' : '';
  rowEl.style.background = isOpen ? '' : 'rgba(99,102,241,.08)';
}

function _buildRegimeExpandPanel(r) {
  const sd = r.signals_data || {};
  const allSignals = sd.signals || [];
  const spot = sd.spot || '—';

  const pills = allSignals.map(s => {
    const isPos = s.includes('↑')||s.includes('bull')||s.includes('UP')||s.includes('OVERSOLD');
    const isNeg = s.includes('↓')||s.includes('bear')||s.includes('DOWN')||s.includes('OVERBOUGHT');
    const c = isPos?'#22c55e':isNeg?'#ef4444':'#f59e0b';
    const icon = isPos?'✓':isNeg?'✗':'•';
    return `<div style="font-size:11px;color:${c};padding:3px 0">${icon} ${s}</div>`;
  }).join('');

  const recentMom = sd.recent_mom;
  const momHtml = recentMom
    ? `<div style="background:rgba(251,191,36,.1);border:1px solid #fbbf2433;border-radius:5px;padding:8px 12px;margin-top:6px;font-size:11px">
        <b style="color:#fbbf24">Recent Momentum Move</b>
        <div style="color:var(--muted);margin-top:3px">
          ${recentMom.bars_ago===1?'Yesterday':recentMom.bars_ago+'d ago'}:
          <span style="color:${recentMom.direction==='UP'?'#22c55e':'#ef4444'};font-weight:700">
            ${recentMom.chg_pct>0?'+':''}${recentMom.chg_pct}%
          </span>
          vs threshold ${recentMom.threshold}% (2× EMA₆₀)
        </div>
      </div>`
    : '';

  return `<div style="padding:12px 16px;display:flex;gap:20px;flex-wrap:wrap">
    <div style="min-width:200px">
      <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:6px;letter-spacing:.08em">SIGNAL BREAKDOWN</div>
      ${pills}
      ${momHtml}
    </div>
    <div style="min-width:180px">
      <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:6px;letter-spacing:.08em">INDICATOR VALUES</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;font-size:11px">
        <span style="color:var(--muted)">Spot</span><span style="font-weight:700">$${spot}</span>
        <span style="color:var(--muted)">EMA9</span><span>${sd.ema9||'—'}</span>
        <span style="color:var(--muted)">EMA20</span><span>${sd.ema20||'—'}</span>
        <span style="color:var(--muted)">EMA50</span><span>${sd.ema50||'—'}</span>
        <span style="color:var(--muted)">BB%B</span><span style="color:${(sd.bb_pct||50)>75?'#ef4444':(sd.bb_pct||50)<25?'#22c55e':'var(--muted)'}">
          ${sd.bb_pct!=null?sd.bb_pct+'%':'—'}</span>
        <span style="color:var(--muted)">PDI→</span><span style="color:${(sd.pdi_delta||0)<-3?'#ef4444':(sd.pdi_delta||0)>3?'#22c55e':'var(--muted)'}">
          ${sd.pdi!=null?sd.pdi:'—'} (${sd.pdi_delta>0?'+':''}${sd.pdi_delta||0})</span>
        <span style="color:var(--muted)">NDI→</span><span style="color:${(sd.ndi_delta||0)>3?'#ef4444':(sd.ndi_delta||0)<-3?'#22c55e':'var(--muted)'}">
          ${sd.ndi!=null?sd.ndi:'—'} (${sd.ndi_delta>0?'+':''}${sd.ndi_delta||0})</span>
        <span style="color:var(--muted)">Volume</span><span style="color:${(sd.vol_ratio||1)>=1.5?'#22c55e':'var(--muted)'}">
          ${sd.vol_ratio!=null?sd.vol_ratio+'×':'—'}</span>
        <span style="color:var(--muted)">IVR</span><span style="color:${sd.iv_rank>60?'#a855f7':sd.iv_rank>40?'#f59e0b':'#3b82f6'};font-weight:700">
          ${sd.iv_rank!=null?Math.round(sd.iv_rank)+'%':'—'} ${sd.iv_rank>60?'(sell)':sd.iv_rank<30?'(buy)':''}</span>
      </div>
    </div>
    <div style="min-width:150px">
      <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:6px;letter-spacing:.08em">BIG MOVES (10d)</div>
      ${(sd.large_moves_10d||[]).length
        ? (sd.large_moves_10d||[]).map(m => {
            const mc = m.direction==='UP'?'#22c55e':'#ef4444';
            const mi = m.direction==='UP'?'▲':'▼';
            const ba = m.date?m.date.slice(5):(m.bars_ago<=1?'Yday':m.bars_ago+'d ago');
            return '<div style="font-size:11px;padding:2px 0;display:flex;justify-content:space-between;gap:10px">'
              +'<span style="color:var(--muted)">'+ba+'</span>'
              +'<span style="color:'+mc+';font-weight:700">'+mi+(m.chg_pct>0?'+':'')+m.chg_pct+'%</span>'
              +'<span style="color:var(--muted);font-size:9px">'+m.volume_ratio+'× vol</span>'
              +'</div>';
          }).join('')
        : '<div style="color:var(--muted);font-size:11px">None in 10d</div>'}
    </div>
    <div style="min-width:220px;flex:1">
      <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:8px;letter-spacing:.08em">TOP STRATEGIES</div>
      ${(sd.strategies||[]).length ? (sd.strategies||[]).map((st,i)=>{
        const sc3=st.probability>=70?'#22c55e':st.probability>=55?'#f59e0b':st.probability>=40?'#f97316':'#ef4444';
        const biasC=st.bias==='Bullish'?'#22c55e':st.bias==='Bearish'?'#ef4444':'#94a3b8';
        const typeC=st.type==='credit'?'#a855f7':st.type==='debit'?'#3b82f6':'#64748b';
          const ivrTag = sd.iv_rank != null ? `<span style="font-size:9px;padding:1px 4px;border-radius:3px;margin-left:4px;background:${sd.iv_rank>50?'rgba(168,85,247,.15)':'rgba(59,130,246,.15)'};color:${sd.iv_rank>50?'#c4b5fd':'#93c5fd'}">IVR ${Math.round(sd.iv_rank)}%</span>` : '';
        return '<div style="background:var(--surface);border:1px solid var(--border);border-left:3px solid '+sc3+';border-radius:4px;padding:6px 8px;margin-bottom:5px">'
          +'<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">'
          +'<span style="font-size:11px;font-weight:700;color:'+biasC+'">'+st.strategy+'</span>'
          +'<div style="display:flex;align-items:center;gap:4px">'
          +'<div style="width:40px;height:5px;background:var(--border);border-radius:3px;overflow:hidden"><div style="width:'+st.probability+'%;height:100%;background:'+sc3+';border-radius:3px"></div></div>'
          +'<span style="font-size:11px;font-weight:800;color:'+sc3+'">'+st.probability+'%</span>'
          +'</div></div>'
          +'<div style="font-size:10px;color:var(--muted);line-height:1.4">'
          +'<span style="background:'+typeC+'18;border:1px solid '+typeC+'33;color:'+typeC+';padding:0 4px;border-radius:2px;font-size:9px;margin-right:4px">'+st.type+'</span>'
          +(st.note||'')+'</div></div>';
      }).join('') : '<div style="color:var(--muted);font-size:11px">Run scan to see strategies</div>'}
    </div>
  </div>`;
}

// Auto-load on tab click
document.querySelectorAll('[data-tab="regime"]').forEach(btn =>
  btn.addEventListener('click', () => setTimeout(loadRegimeResults, 100)));

// Earnings score cell renderer (-10 to +10)
function _earnScoreCell(score, notes) {
  if (score == null) return '<span style="color:var(--muted)">—</span>';
  const s   = parseInt(score);
  const abs = Math.min(10, Math.abs(s));
  // Colour: +6 to +10 = green, +3 to +5 = light green, -2 to +2 = neutral,
  //         -3 to -5 = orange, -6 to -10 = red
  const c = s >= 6 ? '#22c55e'
          : s >= 3 ? '#4ade80'
          : s >= -2 ? '#94a3b8'
          : s >= -5 ? '#f97316'
          : '#ef4444';
  const label = s >= 6  ? 'Bullish'
              : s >= 3  ? 'Mild Bull'
              : s >= -2 ? 'Neutral'
              : s >= -5 ? 'Mild Bear'
              : 'Bearish';
  const topNote = (notes && notes.length) ? notes[0] : '';
  return `<div style="white-space:nowrap" title="${(notes||[]).join(' · ')}">
    <div style="display:flex;align-items:center;gap:3px">
      <div style="width:28px;height:6px;background:var(--border);border-radius:3px;overflow:hidden">
        <div style="width:${abs*10}%;height:100%;background:${c};border-radius:3px"></div>
      </div>
      <span style="color:${c};font-weight:700;font-size:11px">${s>0?'+':''}${s}</span>
    </div>
    <div style="font-size:9px;color:${c};margin-top:1px">${label}</div>
    ${topNote?`<div style="font-size:9px;color:var(--muted);max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${topNote}">${topNote}</div>`:''}
  </div>`;
}



function _jrnClearLegs() {
  _jrnLegs = [];
  _renderLegs();
}


function _jrnFirstOptionExpiry() {
  const leg = (_jrnLegs || []).find(l => l.option_type !== 'stock' && l.expiry);
  return leg ? leg.expiry : '';
}
function _jrnFirstOptionStrike() {
  const leg = (_jrnLegs || []).find(l => l.option_type !== 'stock' && l.strike);
  return leg ? parseFloat(leg.strike) : null;
}
function _jrnCascadeFirstLeg(field, val, oldVal) {
  if (!_jrnLegs || !_jrnLegs.length) return;
  const typ = document.getElementById('jrn-add-type')?.value || '';
  if (field === 'qty') {
    if (typ === 'Butterfly' || typ === 'Custom') return;
    for (let j = 1; j < _jrnLegs.length; j++) _jrnLegs[j].qty = val;
  } else if (field === 'expiry') {
    if (typ === 'Calendar' || typ === 'Custom') return; // calendars need row-level expiries
    for (let j = 1; j < _jrnLegs.length; j++) {
      if (_jrnLegs[j].option_type === 'stock') continue;
      if (!_jrnLegs[j].expiry || _jrnLegs[j].expiry === oldVal) _jrnLegs[j].expiry = val;
    }
  }
}
let _jrnOptCtxTimer = null;
let _jrnScoreTimer = null;
function _jrnScheduleOptionContext() {
  clearTimeout(_jrnOptCtxTimer);
  _jrnOptCtxTimer = setTimeout(() => _jrnRefreshOptionContext(false), 450);
}
function _jrnScheduleDraftScore() {
  clearTimeout(_jrnScoreTimer);
  _jrnScoreTimer = setTimeout(() => {
    const sym = (document.getElementById('jrn-add-symbol')?.value || '').trim().toUpperCase();
    if (!sym) return;
    const hasOptionLeg = (_jrnLegs || []).some(l => l.option_type !== 'stock' && l.expiry && l.strike && l.price !== '');
    const isStock = (document.getElementById('jrn-add-type')?.value || '') === 'Stock';
    const hasExpiryContext = !!document.getElementById('jrn-oi-expiry-select')?.value || !!(_jrnFirstOptionExpiry && _jrnFirstOptionExpiry());
    if (isStock || hasOptionLeg || hasExpiryContext) _jrnPreviewEntryScore(sym, document.getElementById('jrn-add-type')?.value || 'IC');
  }, 900);
}
async function _jrnLoadChartExpiriesFor(selectId, sym, preferred, fallbackExpiryFn) {
  const sel = document.getElementById(selectId);
  if (!sel || !sym) return '';
  try {
    const d = await api(`/api/db_expirations?symbol=${encodeURIComponent(sym)}&future=true`);
    const exps = d.expirations || [];
    const current = preferred || sel.value || (typeof fallbackExpiryFn === 'function' ? fallbackExpiryFn() : '');
    sel.innerHTML = exps.map(e => `<option value="${e}" ${e===current?'selected':''}>${e}</option>`).join('');
    if (!sel.value && current) sel.innerHTML = `<option value="${current}" selected>${current}</option>` + sel.innerHTML;
    if (!sel.value && exps.length) sel.value = exps[0];
    return sel.value;
  } catch(e) {
    return preferred || sel.value || (typeof fallbackExpiryFn === 'function' ? fallbackExpiryFn() : '');
  }
}
async function _jrnLoadChartExpiries(sym, preferred) {
  return _jrnLoadChartExpiriesFor('jrn-oi-expiry-select', sym, preferred, _jrnFirstOptionExpiry);
}
function _jrnNearestChainRow(chain, side, strike) {
  if (!chain || strike == null) return null;
  const keys = Object.keys(chain).filter(k => k.startsWith(side + '_'));
  let best = null, bestD = Infinity;
  for (const k of keys) {
    const st = parseFloat(k.slice(side.length + 1));
    if (!isFinite(st)) continue;
    const d = Math.abs(st - strike);
    if (d < bestD) { bestD = d; best = chain[k]; }
  }
  return best;
}

function _jrnMidFromOptionRow(row) {
  if (!row) return null;
  const num = (v) => {
    const x = parseFloat(v);
    return Number.isFinite(x) ? x : null;
  };
  const mid0 = num(row.mid);
  const mark = num(row.mark);
  const bid = num(row.bid);
  const ask = num(row.ask);
  const last = num(row.lastPrice != null ? row.lastPrice : (row.last != null ? row.last : row.price));
  let px = null;
  if (mid0 != null && mid0 > 0) px = mid0;
  else if (bid != null && ask != null && bid > 0 && ask > 0) px = (bid + ask) / 2;
  else if (mark != null && mark > 0) px = mark;
  else if (last != null && last > 0) px = last;
  return px != null && Number.isFinite(px) ? Math.round(px * 100) / 100 : null;
}
async function _jrnFetchOptionLegPremium(sym, leg) {
  sym = String(sym || '').trim().toUpperCase();
  if (!sym || !leg || String(leg.option_type || '') === 'stock' || !leg.expiry || !leg.strike) return null;
  const type = String(leg.option_type || '').toLowerCase() === 'put' ? 'put' : 'call';
  const strike = parseFloat(leg.strike);
  if (!Number.isFinite(strike) || strike <= 0) return null;

  // Shared live-price path for the full Journal Add Trade page and the global Quick Trade modal.
  // Live chain first, then the existing IV endpoint fallback. Keep this one helper as the
  // maintenance point for strike price lookup behavior.
  try {
    const live = await api(`/strategy/live_prices?symbol=${encodeURIComponent(sym)}&expiry=${encodeURIComponent(leg.expiry)}`);
    let row = null;
    if (live && live.chain) {
      row = _jrnNearestChainRow(live.chain, type, strike);
    } else if (live && (live.calls || live.puts)) {
      const arr = type === 'call' ? (live.calls || []) : (live.puts || []);
      let best = null, bestD = Infinity;
      for (const r of arr) {
        const k = parseFloat(r.strike != null ? r.strike : r.k);
        if (!Number.isFinite(k)) continue;
        const d = Math.abs(k - strike);
        if (d < bestD) { bestD = d; best = r; }
      }
      row = best;
    }
    const px = _jrnMidFromOptionRow(row);
    if (px != null && px > 0) {
      return {price: px, source: live.source || 'live option chain', actual_expiry: live.actual_expiry || live.expiry || leg.expiry, row};
    }
  } catch (e) {
    // Non-fatal; try existing Journal IV endpoint fallback below.
  }

  try {
    const d = await api(`/analysis/iv/${encodeURIComponent(sym)}/${encodeURIComponent(leg.expiry)}/${encodeURIComponent(leg.strike)}/${encodeURIComponent(type)}`);
    const px = parseFloat(d && d.price);
    if (Number.isFinite(px) && px > 0) return {price: Math.round(px * 100) / 100, source: d.source || 'analysis/iv', actual_expiry: leg.expiry, row: d};
  } catch (e) {}
  return null;
}
async function _renderOptionOiIvContext(opts={}) {
  const panel = document.getElementById(opts.panelId);
  const chartEl = document.getElementById(opts.chartId);
  const stat = document.getElementById(opts.statusId);
  const sel = document.getElementById(opts.selectId);
  if (!panel || !chartEl) return;
  const sym = String(opts.symbol || '').trim().toUpperCase();
  if (!sym) { panel.style.display = 'none'; return; }
  panel.style.display = 'block';
  const preferred = opts.preferredExpiry || (opts.force && sel?.value ? sel.value : '') || (typeof opts.fallbackExpiryFn === 'function' ? opts.fallbackExpiryFn() : '') || sel?.value || '';
  const exp = await _jrnLoadChartExpiriesFor(opts.selectId, sym, preferred, opts.fallbackExpiryFn);
  if (!exp) {
    if (stat) stat.textContent = 'No expiries found yet. Run Scheduler or enter a row expiry.';
    chartEl.innerHTML = '';
    return;
  }
  if (stat) stat.textContent = `Loading ${sym} ${exp} OI / IV…`;
  try {
    const opt = await api(`/api/options?symbol=${encodeURIComponent(sym)}&expiration=${encodeURIComponent(exp)}&per_side=${opts.perSide || 24}`).catch(e => ({error:e.message,calls:[],puts:[]}));
    const calls = opt.calls || [], puts = opt.puts || [];
    const strikes = [...new Set([...calls, ...puts].map(r => +r.strike).filter(v => isFinite(v)))].sort((a,b)=>a-b);
    let chain = null, actualExp = exp;
    try {
      const live = await api(`/strategy/live_prices?symbol=${encodeURIComponent(sym)}&expiry=${encodeURIComponent(exp)}`);
      chain = live.chain || null;
      actualExp = live.actual_expiry || live.expiry || exp;
    } catch(e) {}
    if (!strikes.length) {
      chartEl.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:${opts.emptyHeight || 240}px;color:var(--muted);font-size:12px">No OI rows for ${sym} ${exp}. Run Scheduler for this symbol/expiry.</div>`;
      if (stat) stat.textContent = opt.message || 'No OI rows available.';
      return;
    }
    const callOI = strikes.map(s => +(calls.find(r => +r.strike === s)?.oi || 0));
    const putOI  = strikes.map(s => +(puts.find(r => +r.strike === s)?.oi || 0));
    const callIV = strikes.map(s => {
      const r = _jrnNearestChainRow(chain, 'call', s);
      return r && r.iv != null ? +(r.iv * 100).toFixed(1) : null;
    });
    const putIV = strikes.map(s => {
      const r = _jrnNearestChainRow(chain, 'put', s);
      return r && r.iv != null ? +(r.iv * 100).toFixed(1) : null;
    });
    const data = [
      {type:'bar', x:strikes, y:callOI, name:'Call OI', marker:{color:'rgba(59,130,246,0.82)'}},
      {type:'bar', x:strikes, y:putOI,  name:'Put OI',  marker:{color:'rgba(239,68,68,0.82)'}},
    ];
    if (callIV.some(v => v != null)) data.push({type:'scatter', mode:'lines+markers', x:strikes, y:callIV, yaxis:'y2', name:'Call IV %', line:{width:2,color:'rgba(96,165,250,0.95)'}, marker:{size:5}});
    if (putIV.some(v => v != null)) data.push({type:'scatter', mode:'lines+markers', x:strikes, y:putIV, yaxis:'y2', name:'Put IV %', line:{width:2,color:'rgba(248,113,113,0.95)'}, marker:{size:5}});
    const selectedStrike = typeof opts.selectedStrikeFn === 'function' ? opts.selectedStrikeFn() : opts.selectedStrike;
    const shapes = [];
    if (selectedStrike != null && isFinite(Number(selectedStrike))) {
      shapes.push({type:'line', x0:Number(selectedStrike), x1:Number(selectedStrike), y0:0, y1:1, yref:'paper', line:{color:'#f59e0b', width:1.5, dash:'dot'}});
    }
    Plotly.newPlot(chartEl, data, {
      ...PL,
      title: `${sym} ${actualExp || exp} — OI + IV`,
      barmode: 'group',
      margin: opts.margin || {l:42, r:44, t:36, b:42},
      yaxis: {title:'Open Interest', gridcolor:'#1e293b'},
      yaxis2: {title:'IV %', overlaying:'y', side:'right', showgrid:false},
      shapes,
      legend: {orientation:'h', y:1.12, x:0, font:{size:10}},
    }, PC);
    if (stat) {
      const day = opt.oi_snapshot_day ? ` · OI snapshot ${opt.oi_snapshot_day}` : '';
      stat.textContent = `${strikes.length} strikes${day}${actualExp && actualExp !== exp ? ' · IV nearest ' + actualExp : ''}`;
    }
  } catch(e) {
    if (stat) stat.textContent = `OI/IV chart unavailable: ${e.message}`;
    chartEl.innerHTML = '';
  }
}
async function _jrnRefreshOptionContext(force=true) {
  const sym = (document.getElementById('jrn-add-symbol')?.value || '').trim().toUpperCase();
  return _renderOptionOiIvContext({
    panelId: 'jrn-oi-iv-panel',
    chartId: 'jrn-oi-iv-chart',
    statusId: 'jrn-oi-iv-status',
    selectId: 'jrn-oi-expiry-select',
    symbol: sym,
    force,
    preferredExpiry: force ? document.getElementById('jrn-oi-expiry-select')?.value : (_jrnFirstOptionExpiry() || document.getElementById('jrn-oi-expiry-select')?.value || ''),
    fallbackExpiryFn: _jrnFirstOptionExpiry,
    selectedStrikeFn: _jrnFirstOptionStrike,
    perSide: 24,
  });
}


function _jrnTemplate(type) {
  const sym = document.getElementById('jrn-add-symbol')?.value?.toUpperCase() || 'SPY';
  const today = new Date(); today.setDate(today.getDate()+28);
  const exp = today.toISOString().slice(0,10);
  const templates = {
    PS:       [{side:'sell',option_type:'put', strike:'',expiry:exp,qty:1,price:''},{side:'buy',option_type:'put', strike:'',expiry:exp,qty:1,price:''}],
    CS:       [{side:'sell',option_type:'call',strike:'',expiry:exp,qty:1,price:''},{side:'buy',option_type:'call',strike:'',expiry:exp,qty:1,price:''}],
    IC:       [{side:'sell',option_type:'put', strike:'',expiry:exp,qty:1,price:''},{side:'buy',option_type:'put', strike:'',expiry:exp,qty:1,price:''},{side:'sell',option_type:'call',strike:'',expiry:exp,qty:1,price:''},{side:'buy',option_type:'call',strike:'',expiry:exp,qty:1,price:''}],
    PB:       [{side:'buy',option_type:'call', strike:'',expiry:exp,qty:1,price:''},{side:'sell',option_type:'call',strike:'',expiry:exp,qty:1,price:''}],
    CB:       [{side:'buy',option_type:'put',  strike:'',expiry:exp,qty:1,price:''},{side:'sell',option_type:'put', strike:'',expiry:exp,qty:1,price:''}],
    CC:       [{side:'buy',option_type:'stock',strike:'',expiry:'',  qty:100,price:''},{side:'sell',option_type:'call',strike:'',expiry:exp,qty:1,price:''}],
    CP:       [{side:'sell',option_type:'stock',strike:'',expiry:'', qty:100,price:''},{side:'sell',option_type:'put', strike:'',expiry:exp,qty:1,price:''}],
    Straddle: [{side:'buy',option_type:'call', strike:'',expiry:exp,qty:1,price:''},{side:'buy',option_type:'put',  strike:'',expiry:exp,qty:1,price:''}],
    Strangle: [{side:'sell',option_type:'call',strike:'',expiry:exp,qty:1,price:''},{side:'sell',option_type:'put', strike:'',expiry:exp,qty:1,price:''}],
    Calendar: [{side:'buy',option_type:'call', strike:'',expiry:exp,qty:1,price:''},{side:'sell',option_type:'call',strike:'',expiry:'',qty:1,price:''}],
    Butterfly:[{side:'buy',option_type:'call', strike:'',expiry:exp,qty:1,price:''},{side:'sell',option_type:'call',strike:'',expiry:exp,qty:2,price:''},{side:'buy',option_type:'call',strike:'',expiry:exp,qty:1,price:''}],
  };
  if (templates[type]) _jrnLegs = templates[type].map(l=>({...l}));
  _renderLegs();
  if (typeof _jrnScheduleOptionContext === 'function') _jrnScheduleOptionContext();
}

function _jrnAddLeg() {
  const exp = _jrnLegs.length ? _jrnLegs[0].expiry : new Date(Date.now()+28*86400000).toISOString().slice(0,10);
  const qty = _jrnLegs.length ? (_jrnLegs[0].qty || 1) : 1;
  _jrnLegs.push({side:'buy',option_type:'call',strike:'',expiry:exp,qty:qty,price:''});
  _renderLegs();
  _jrnScheduleOptionContext();
}

function _renderLegs() {
  const el  = document.getElementById('jrn-legs-container');
  const cnt = document.getElementById('jrn-legs-count');
  const net = document.getElementById('jrn-net-premium-display');
  const priceEl = document.getElementById('jrn-add-price');
  if (!el) return;
  if (cnt) cnt.textContent = _jrnLegs.length;

  let netPrem = 0;
  _jrnLegs.forEach(l => {
    const px = parseFloat(l.price||0), q = parseInt(l.qty||1);
    if (l.side==='sell') netPrem += px*q;
    else                 netPrem -= px*q;
  });
  if (net) {
    net.textContent = (netPrem>=0?'+':'')+'$'+netPrem.toFixed(2);
    net.style.color = netPrem>0?'#22c55e':netPrem<0?'#ef4444':'var(--muted)';
  }
  if (priceEl && !priceEl.dataset.manualEdit) priceEl.value = netPrem.toFixed(2);

  const ns='appearance:textfield;-moz-appearance:textfield;-webkit-appearance:none;';
  el.innerHTML = _jrnLegs.map((leg,i) => {
    const sideC  = leg.side==='sell'?'#f97316':'#3b82f6';
    const legPnL = (parseFloat(leg.price||0)*(parseInt(leg.qty||1))*(leg.side==='sell'?1:-1));
    const lbc    = legPnL>0?'#22c55e':legPnL<0?'#ef4444':'#64748b';
    return `<div style="display:grid;grid-template-columns:80px 70px 80px 100px 50px 70px 60px 28px;gap:4px;margin-bottom:3px;align-items:center">
      <select onchange="_jrnLegChange(${i},'side',this.value)" style="font-size:11px;padding:2px;color:${sideC};background:${sideC}15;border:1px solid ${sideC}44;border-radius:3px">
        <option value="buy"  ${leg.side==='buy' ?'selected':''}>🔵 BUY</option>
        <option value="sell" ${leg.side==='sell'?'selected':''}>🟠 SELL</option>
      </select>
      <select onchange="_jrnLegChange(${i},'option_type',this.value)" style="font-size:11px;padding:2px">
        <option value="call"  ${leg.option_type==='call' ?'selected':''}>CALL</option>
        <option value="put"   ${leg.option_type==='put'  ?'selected':''}>PUT</option>
        <option value="stock" ${leg.option_type==='stock'?'selected':''}>STOCK</option>
      </select>
      <input type="text" inputmode="decimal" placeholder="Strike" value="${leg.strike||''}"
        onblur="_jrnLegStrikeBlur(${i},this.value)"
        style="font-size:11px;${ns}${leg.option_type==='stock'?'opacity:.4':''}"/>
      <input type="date" value="${leg.expiry||''}"
        onchange="_jrnLegExpiryChange(${i},this.value)"
        style="font-size:10px;${leg.option_type==='stock'?'opacity:.4':''}"/>
      <input type="text" inputmode="numeric" value="${leg.qty||1}"
        oninput="_jrnLegVal(${i},'qty',this.value)"
        onblur="_jrnLegChange(${i},'qty',this.value)"
        style="font-size:11px;${ns}"/>
      <input type="text" inputmode="decimal" placeholder="$0.00" value="${leg.price||''}"
        oninput="_jrnLegVal(${i},'price',this.value)"
        onblur="_jrnLegChange(${i},'price',this.value)"
        style="font-size:11px;${ns}"/>
      <span style="font-size:10px;font-weight:700;color:${lbc};text-align:right">
        ${legPnL>0?'+':''}$${legPnL.toFixed(2)}</span>
      <button onclick="_jrnRemoveLeg(${i})" style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:14px;padding:0">✕</button>
    </div>`;
  }).join('');
}


// Journal: auto-fetch premium when strike or expiry changes
async function _jrnLegStrikeBlur(i, val) {
  if (!_jrnLegs[i]) return;
  _jrnLegs[i].strike = val;
  _renderLegs();
  _jrnScheduleOptionContext();
  await _jrnFetchLegPremium(i);
  _jrnScheduleDraftScore();
}

async function _jrnLegExpiryChange(i, val) {
  if (!_jrnLegs[i]) return;
  const oldVal = _jrnLegs[i].expiry || '';
  _jrnLegs[i].expiry = val;
  if (i === 0) _jrnCascadeFirstLeg('expiry', val, oldVal);
  // Clear prices so re-fetch always runs when expiry changes.  Do not clear
  // manually overridden calendar expiries on other rows.
  _jrnLegs[i].price = '';
  _renderLegs();
  _jrnScheduleOptionContext();
  await _jrnFetchLegPremium(i);
  _jrnScheduleDraftScore();
}

async function _jrnFetchLegPremium(i) {
  const leg = _jrnLegs[i];
  if (!leg || !leg.strike || !leg.expiry || leg.option_type === 'stock') return;
  const sym = (document.getElementById('jrn-add-symbol')?.value || 'SPY').toUpperCase();
  const q = await _jrnFetchOptionLegPremium(sym, leg);
  if (q && q.price != null) {
    _jrnLegs[i].price = Number(q.price).toFixed(2);
    _renderLegs();
    _jrnScheduleDraftScore();
  }
}


function _jrnLegVal(i, field, val) {
  if (_jrnLegs[i]) {
    _jrnLegs[i][field] = val;
    if (i === 0 && field === 'qty') _jrnCascadeFirstLeg('qty', val, null);
    const net = document.getElementById('jrn-net-premium-display');
    if (net) {
      let np = 0;
      _jrnLegs.forEach(l => {
        const px = parseFloat(l.price || 0), q = parseInt(l.qty || 1);
        np += l.side === 'sell' ? px * q : -px * q;
      });
      net.textContent = (np >= 0 ? '+' : '') + '$' + np.toFixed(2);
      net.style.color = np > 0 ? '#22c55e' : np < 0 ? '#ef4444' : 'var(--muted)';
      const priceEl = document.getElementById('jrn-add-price');
      if (priceEl && !priceEl.dataset.manualEdit) priceEl.value = np.toFixed(2);
    }
    if (field === 'qty' || field === 'price') _jrnScheduleDraftScore();
  }
}

function _jrnLegChange(i, field, val) {
  if (_jrnLegs[i]) {
    if (i === 0 && field === 'qty') _jrnCascadeFirstLeg('qty', val, null);
    _jrnLegs[i][field] = val;
    _renderLegs();
    if (field === 'qty' || field === 'price' || field === 'side' || field === 'option_type') _jrnScheduleDraftScore();
  }
}

function _jrnRemoveLeg(i) {
  _jrnLegs.splice(i,1);
  _renderLegs();
}

// Override jrnAddTrade to support multi-leg


// Show trade legs in the journal row
function _renderLegsSummary(legs) {
  if (!legs || !legs.length) return '';
  const typeC = {call:'#ef4444',put:'#22c55e',stock:'#3b82f6'};
  return legs.map(l => {
    const c = typeC[l.option_type]||'#64748b';
    const sideIcon = l.side==='sell'?'●':'○';
    if (l.option_type==='stock')
      return `<span style="color:${c};font-size:9px">${sideIcon}STK@$${l.price}</span>`;
    return `<span style="color:${c};font-size:9px">${sideIcon}${(l.option_type||'').toUpperCase()[0]}$${l.strike}</span>`;
  }).join('<span style="color:var(--muted);margin:0 2px">·</span>');
}


// TRADE ANALYSIS PAGE — P&L Diagram + Greeks + Step-through Time

// State vars declared here so they are initialized before any function uses them
let _taLegs=[], _taData=null, _taSpotOffset=0, _taIvOffset=0, _taDaysOffset=0;
let _taBaseSpot=0, _taBaseIv=0.20, _taBaseDte=28;
let _taActiveGreek='delta';

// ─────────────────────────────────────────────────────────────────────────
// Client-side Black-Scholes (fully self-contained, no server needed for sliders)
// ─────────────────────────────────────────────────────────────────────────
function _bsNormCDF(x){
  if(x<0)return 1-_bsNormCDF(-x);
  const t=1/(1+0.2316419*x);
  const p=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))));
  return 1-(1/Math.sqrt(2*Math.PI))*Math.exp(-0.5*x*x)*p;
}
function _bsNormPDF(x){ return Math.exp(-0.5*x*x)/Math.sqrt(2*Math.PI); }
function _bsPrice(S,K,T,iv,isCall,r=0.043){
  if(S<=0||K<=0||iv<=0) return isCall?Math.max(0,S-K):Math.max(0,K-S);
  if(T<=0) return isCall?Math.max(0,S-K):Math.max(0,K-S);
  const d1=(Math.log(S/K)+(r+0.5*iv*iv)*T)/(iv*Math.sqrt(T));
  const d2=d1-iv*Math.sqrt(T);
  if(isCall) return Math.max(0, S*_bsNormCDF(d1) - K*Math.exp(-r*T)*_bsNormCDF(d2));
  return Math.max(0, K*Math.exp(-r*T)*_bsNormCDF(-d2) - S*_bsNormCDF(-d1));
}
function _bsGreeks(S,K,T,iv,isCall,r=0.043){
  if(T<=0.5/365){
    return{price:isCall?Math.max(0,S-K):Math.max(0,K-S),delta:isCall?(S>K?1:0):(S<K?-1:0),gamma:0,theta:0,vega:0};
  }
  const sqT=Math.sqrt(T);
  const d1=(Math.log(S/K)+(r+0.5*iv*iv)*T)/(iv*sqT);
  const d2=d1-iv*sqT;
  const pdf1=_bsNormPDF(d1);
  const price=_bsPrice(S,K,T,iv,isCall,r);
  const delta=isCall?_bsNormCDF(d1):(_bsNormCDF(d1)-1);
  const gamma=pdf1/(S*iv*sqT);
  const theta=(-(S*pdf1*iv)/(2*sqT) - r*K*Math.exp(-r*T)*(isCall?_bsNormCDF(d2):_bsNormCDF(-d2)))/365;
  const vega=S*pdf1*sqT/100;
  const rho=K*T*Math.exp(-r*T)*(isCall?_bsNormCDF(d2):-_bsNormCDF(-d2))/100;
  return{price,delta,gamma,theta,vega,rho};
}


// Implied IV from market price (bisection method)
function _bsImpliedIV(S, K, T, marketPrice, isCall, r=0.043) {
  if (T <= 0 || marketPrice <= 0 || S <= 0 || K <= 0) return 0.20;
  const intrinsic = isCall ? Math.max(0, S - K) : Math.max(0, K - S);
  if (marketPrice <= intrinsic) return 0.01;
  let lo = 0.01, hi = 3.0;
  for (let iter = 0; iter < 50; iter++) {
    const mid = (lo + hi) / 2;
    const px = _bsPrice(S, K, T, mid, isCall, r);
    if (Math.abs(px - marketPrice) < 0.001) return mid;
    if (px > marketPrice) hi = mid;
    else lo = mid;
  }
  return (lo + hi) / 2;
}

// Compute total strategy P&L at a given spot/DTE/IV
function _taStratPnL(legs, S, dte, iv){
  let pnl=0;
  legs.forEach(leg=>{
    const K=parseFloat(leg.strike||0);
    const ep=parseFloat(leg.entry_price||leg.price||0);
    const q=parseInt(leg.qty||1);
    const sign=leg.side==='sell'?-1:1;
    if(leg.option_type==='stock'){
      pnl+=sign*(S-ep)*q;
    } else if(K>0){
      const isCall=leg.option_type==='call';
      const T=Math.max(0,dte/365);
      // Use per-leg implied IV if available (calibrated from entry price)
      // Then apply the IV OFFSET from the slider on top
      const baseIv = leg._impliedIv || parseFloat(leg.leg_iv||0)/100 || iv;
      const ivShift = iv - _taBaseIv;  // how much IV changed from base
      const legIv = Math.max(0.01, baseIv + ivShift);
      const curr = _bsPrice(S, K, T, legIv, isCall);
      pnl += sign * (curr - ep) * q * 100;
    }
  });
  return pnl;
}

// Compute aggregate greeks at spot
function _taStratGreeks(legs, S, dte, iv){
  let delta=0,gamma=0,theta=0,vega=0;
  legs.forEach(leg=>{
    if(leg.option_type==='stock'){
      delta+=parseInt(leg.qty||1)*(leg.side==='sell'?-1:1);
      return;
    }
    const K=parseFloat(leg.strike||0); if(!K) return;
    const isCall=leg.option_type==='call';
    const sign=leg.side==='sell'?-1:1;
    const q=parseInt(leg.qty||1);
    const T=Math.max(0.001,dte/365);
    const baseIv=leg._impliedIv||parseFloat(leg.leg_iv||0)/100||iv;
    const ivShift=iv-_taBaseIv;
    const legIv=Math.max(0.01,baseIv+ivShift);
    const g=_bsGreeks(S,K,T,legIv,isCall);
    delta+=sign*g.delta*q*100;
    gamma+=sign*g.gamma*q*100;
    theta+=sign*g.theta*q*100;
    vega +=sign*g.vega *q*100;
  });
  return{delta,gamma,theta,vega};
}

// ─────────────────────────────────────────────────────────────────────────
// BUILD PAGE
// ─────────────────────────────────────────────────────────────────────────
function _loadTradeAnalysis(preloadTrade){
  // HTML is now static in index.html. Just wire events on first load.
  const cv = document.getElementById('ta-canvas');
  if(cv && !cv.dataset.wired){
    cv.dataset.wired='1';
    cv.addEventListener('mousemove', _taHover);
    cv.addEventListener('mouseleave', ()=>{const t=document.getElementById('ta-tip');if(t)t.style.display='none';});
  }
  // Auto-fetch IV rank when symbol changes
  const symInput = document.getElementById('ta-sym');
  if (symInput && !symInput.dataset.ivWired) {
    symInput.dataset.ivWired = '1';
    symInput.addEventListener('blur', () => { if(symInput.value) _taFetchIVRank(symInput.value.toUpperCase()); });
  }

  if(preloadTrade){
    _taLoadFromTrade(preloadTrade);
  } else if(!cv?.dataset.loaded){
    cv.dataset.loaded='1';
    _taTemplate('Iron Condor');
    setTimeout(() => { try { _taAnalyze(); } catch (e) { console.warn(e); } }, 120);
  }
}

// ─────────────────────────────────────────────────────────────────────────
// Leg management
// ─────────────────────────────────────────────────────────────────────────
function _taAddLeg(){
  _taLegs.push({side:'buy',option_type:'call',strike:'',entry_price:'',qty:1,leg_iv:''});
  _taRenderLegs();
}
function _taRemoveLeg(i){_taLegs.splice(i,1);_taRenderLegs();}

// Update leg value without re-rendering (prevents focus loss)
function _taLegVal(i, field, val) {
  if (_taLegs[i]) {
    _taLegs[i][field] = val;
    // Just update net display
    const netEl = document.getElementById('ta-net');
    if (netEl) {
      let net = 0;
      _taLegs.forEach(l => {
        const px = parseFloat(l.entry_price || l.price || 0), q = parseInt(l.qty || 1);
        net += l.side === 'sell' ? px * q * 100 : -px * q * 100;
      });
      netEl.textContent = (net >= 0 ? '+' : '') + '$' + net.toFixed(2) + (net > 0 ? ' credit' : net < 0 ? ' debit' : '');
      netEl.style.color = net > 0 ? '#22c55e' : net < 0 ? '#ef4444' : 'var(--muted)';
    }
  }
}

function _taLegChange(i,f,v){if(_taLegs[i]){_taLegs[i][f]=v;_taRenderLegs();}}

function _taRenderLegs(){
  const tbody=document.getElementById('ta-legs');
  const netEl=document.getElementById('ta-net');
  if(!tbody) return;
  let net=0;
  _taLegs.forEach(l=>{
    const px=parseFloat(l.entry_price||l.price||0),q=parseInt(l.qty||1);
    net+=l.side==='sell'?px*q*100:-px*q*100;
  });
  if(netEl){
    netEl.textContent=(net>=0?'+':'')+'$'+net.toFixed(2)+(net>0?' credit':net<0?' debit':'');
    netEl.style.color=net>0?'#22c55e':net<0?'#ef4444':'var(--muted)';
  }
  const ns='appearance:textfield;-moz-appearance:textfield;-webkit-appearance:none;';
  tbody.innerHTML=_taLegs.map((leg,i)=>{
    const sC=leg.side==='sell'?'#f97316':'#3b82f6';
    const ep=parseFloat(leg.entry_price||leg.price||0),q=parseInt(leg.qty||1);
    const lpnl=(leg.side==='sell'?ep:-ep)*(leg.option_type==='stock'?1:100)*q;
    const lC=lpnl>0?'#22c55e':lpnl<0?'#ef4444':'#64748b';
    const dlt=leg._delta!=null?leg._delta.toFixed(3):'—';
    const dltC=(leg._delta||0)>0?'#22c55e':(leg._delta||0)<0?'#ef4444':'#64748b';
    return `<tr style="border-bottom:1px solid var(--border)">
      <td style="padding:3px 4px">
        <select onchange="_taLegChange(${i},'side',this.value)" style="font-size:11px;color:${sC};background:${sC}18;border:1px solid ${sC}44;border-radius:3px;padding:2px">
          <option value="buy" ${leg.side==='buy'?'selected':''}>🔵 BUY</option>
          <option value="sell" ${leg.side==='sell'?'selected':''}>🟠 SELL</option>
        </select>
      </td>
      <td style="padding:3px 4px">
        <select onchange="_taLegChange(${i},'option_type',this.value)" style="font-size:11px;padding:2px">
          <option value="call"  ${leg.option_type==='call' ?'selected':''}>CALL</option>
          <option value="put"   ${leg.option_type==='put'  ?'selected':''}>PUT</option>
          <option value="stock" ${leg.option_type==='stock'?'selected':''}>STOCK</option>
        </select>
      </td>
      <td style="padding:3px 4px"><input type="text" inputmode="decimal" value="${leg.strike||''}" placeholder="Strike"
        onblur="_taLegStrikeBlur(${i},this.value)"
        style="width:70px;font-size:11px;${ns}${leg.option_type==='stock'?'opacity:.4':''}"/></td>
      <td style="padding:3px 4px"><input type="date" value="${leg.expiry||''}"
        onchange="_taLegExpiryChange(${i},this.value)"
        style="width:110px;font-size:10px;${leg.option_type==='stock'?'opacity:.4':''}"/></td>
      <td style="padding:3px 4px"><input type="text" inputmode="decimal" value="${leg.entry_price||leg.price||''}" placeholder="$"
        oninput="_taLegVal(${i},'entry_price',this.value)"
        onblur="_taLegChange(${i},'entry_price',this.value)"
        style="width:62px;font-size:11px;${ns}"/></td>
      <td style="padding:3px 4px"><input type="text" inputmode="numeric" value="${leg.qty||1}"
        oninput="_taLegVal(${i},'qty',this.value)"
        onblur="_taLegChange(${i},'qty',this.value)"
        style="width:38px;font-size:11px;${ns}"/></td>
      <td style="padding:3px 6px;font-weight:700;color:${lC};font-size:11px;white-space:nowrap">
        ${lpnl>=0?'+':''}$${lpnl.toFixed(0)}</td>
      <td style="padding:3px 4px;font-size:10px;color:${dltC};font-weight:700;text-align:center;min-width:44px"
        title="Delta for this leg">${dlt}</td>
      <td style="padding:3px 4px"><input type="text" inputmode="decimal"
        value="${leg._impliedIv ? (leg._impliedIv*100).toFixed(1) : (leg.leg_iv||'')}" placeholder="auto"
        oninput="_taLegVal(${i},'leg_iv',this.value)"
        onblur="_taLegChange(${i},'leg_iv',this.value)"
        style="width:44px;font-size:10px;${ns}${leg._impliedIv?'color:#a78bfa':''}"
        title="${leg._impliedIv ? 'Implied IV from entry price' : 'Per-leg IV override'}"/></td>
      <td style="padding:3px 2px"><button onclick="_taRemoveLeg(${i})"
        style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:13px;padding:0">✕</button></td>
    </tr>`;
  }).join('');
}


// Auto-fetch spot when symbol changes
async function _taSymbolChange(){
  const sym=(document.getElementById('ta-sym')?.value||'').toUpperCase().trim();
  if(!sym||sym.length<1) return;
  const spotEl=document.getElementById('ta-spot');
  const msg=document.getElementById('ta-msg');
  if(msg) msg.textContent='📡 Fetching spot…';
  try{
    const d=await api(`/analysis/spot/${sym}`);
    if(d.spot&&spotEl){spotEl.value=d.spot; _taBaseSpot=d.spot;}
    if(msg) msg.textContent=`✅ ${sym} @ $${d.spot}`;
  }catch(e){if(msg) msg.textContent=`⚠ ${e.message}`;}
}

// Auto-fetch premium + IV + delta when strike/expiry changes
async function _taLegStrikeBlur(i, val){
  if(!_taLegs[i]) return;
  _taLegs[i].strike = val;
  _taRenderLegs();
  await _taFetchLegData(i);
}

async function _taLegExpiryChange(i, val){
  if(!_taLegs[i]) return;
  _taLegs[i].expiry = val;
  _taRenderLegs();
  await _taFetchLegData(i);
}

async function _taFetchLegData(i){
  const leg=_taLegs[i];
  if(!leg||!leg.strike||!leg.expiry||leg.option_type==='stock') return;
  const sym=(document.getElementById('ta-sym')?.value||'SPY').toUpperCase();
  const msg=document.getElementById('ta-msg');
  try{
    const d=await api(`/analysis/iv/${sym}/${leg.expiry}/${leg.strike}/${leg.option_type}`);
    if(d.iv&&d.iv>0){
      leg.leg_iv = (d.iv*100).toFixed(1);
      if((leg.entry_price===''||leg.entry_price===undefined||leg.entry_price===null) && d.price) leg.entry_price = d.price.toFixed(2);
      // Compute delta
      const spot=parseFloat(document.getElementById('ta-spot')?.value||0)||_taBaseSpot;
      const dte=parseInt(document.getElementById('ta-dte')?.value||28);
      if(spot>0){
        const g=_bsGreeks(spot, parseFloat(leg.strike), Math.max(0.001,dte/365), d.iv, leg.option_type==='call');
        leg._delta = g.delta;
      }
      _taRenderLegs();
      if(msg) msg.textContent=`✅ ${leg.option_type.toUpperCase()} $${leg.strike}: IV=${leg.leg_iv}% price=$${d.price?.toFixed(2)||'?'}`;
    }
  }catch{}
}

function _taTemplate(type){
  const S=parseFloat(document.getElementById('ta-spot')?.value||0)||500;
  const exp=new Date(Date.now()+28*864e5).toISOString().slice(0,10);
  const exp2=new Date(Date.now()+56*864e5).toISOString().slice(0,10);
  const T={
    'Bull Put Spread':  [{side:'sell',option_type:'put', strike:Math.round(S*0.97),expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'buy', option_type:'put', strike:Math.round(S*0.95),expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Bear Call Spread': [{side:'sell',option_type:'call',strike:Math.round(S*1.03),expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'buy', option_type:'call',strike:Math.round(S*1.05),expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Iron Condor':      [{side:'sell',option_type:'put', strike:Math.round(S*0.97),expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'buy', option_type:'put', strike:Math.round(S*0.95),expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'sell',option_type:'call',strike:Math.round(S*1.03),expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'buy', option_type:'call',strike:Math.round(S*1.05),expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Long Call':        [{side:'buy', option_type:'call',strike:Math.round(S),      expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Long Put':         [{side:'buy', option_type:'put', strike:Math.round(S),      expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Straddle':         [{side:'buy', option_type:'call',strike:Math.round(S),      expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'buy', option_type:'put', strike:Math.round(S),      expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Strangle':         [{side:'sell',option_type:'call',strike:Math.round(S*1.05), expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'sell',option_type:'put', strike:Math.round(S*0.95), expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Call Debit Spread':[{side:'buy', option_type:'call',strike:Math.round(S),      expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'sell',option_type:'call',strike:Math.round(S*1.05), expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Put Debit Spread': [{side:'buy', option_type:'put', strike:Math.round(S),      expiry:exp,entry_price:'',qty:1,leg_iv:''},
                         {side:'sell',option_type:'put', strike:Math.round(S*0.95), expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Covered Call':     [{side:'buy', option_type:'stock',strike:'',               expiry:'',  entry_price:S,qty:100,leg_iv:''},
                         {side:'sell',option_type:'call', strike:Math.round(S*1.03),expiry:exp,entry_price:'',qty:1,leg_iv:''}],
    'Calendar Spread':  [{side:'buy', option_type:'call',strike:Math.round(S),      expiry:exp2,entry_price:'',qty:1,leg_iv:''},
                         {side:'sell',option_type:'call',strike:Math.round(S),      expiry:exp, entry_price:'',qty:1,leg_iv:''}],
  };
  if(T[type]){_taLegs=T[type].map(l=>({...l}));_taRenderLegs();}
}

// ─────────────────────────────────────────────────────────────────────────
// Analyze / Fetch IV
// ─────────────────────────────────────────────────────────────────────────
async function _taAnalyze(){
  const msg=document.getElementById('ta-msg');
  const sym=(document.getElementById('ta-sym')?.value||'SPY').toUpperCase();
  let spot=parseFloat(document.getElementById('ta-spot')?.value||0);
  let iv=parseFloat(document.getElementById('ta-iv')?.value||20)/100;
  const dte=parseInt(document.getElementById('ta-dte')?.value||28);
  const legs=_taLegs.filter(l=>l.strike||l.option_type==='stock');
  if(!legs.length){if(msg)msg.textContent='⚠ Add at least one leg';return;}
  // Auto-fetch spot
  if(!spot||spot<1){
    if(msg)msg.textContent='📡 Fetching spot…';
    try{const d=await api(`/analysis/spot/${sym}`);spot=d.spot||500;
      document.getElementById('ta-spot').value=spot;}
    catch{spot=500;}
  }
  // Fetch IV Rank (non-blocking, shows above graph)
  _taFetchIVRank(sym).catch(()=>{});
  // For journal trades: auto-fetch CURRENT IV for each leg
  const hasOriginal = legs.some(l=>l._isOriginal);
  if(hasOriginal){
    if(msg)msg.textContent='📡 Fetching live IV for existing position…';
    for(const leg of legs){
      if(leg.option_type==='stock'||!leg.strike||!leg.expiry) continue;
      try{
        const d=await api(`/analysis/iv/${sym}/${leg.expiry}/${leg.strike}/${leg.option_type}`);
        if(d.iv>0) leg.leg_iv=(d.iv*100).toFixed(1);
      }catch{}
    }
    // Update global IV to avg of fetched
    const fetchedIvs=legs.filter(l=>l.leg_iv).map(l=>parseFloat(l.leg_iv)/100);
    if(fetchedIvs.length){
      iv=fetchedIvs.reduce((a,b)=>a+b,0)/fetchedIvs.length;
      document.getElementById('ta-iv').value=(iv*100).toFixed(1);
    }
  }
  // For each leg: if entry price exists, compute implied IV from it
  // This ensures P&L=0 at entry conditions (spot/DTE haven't changed)
  const T_entry = Math.max(0.001, dte/365);
  legs.forEach(leg=>{
    if(leg.option_type==='stock') return;
    const K=parseFloat(leg.strike); if(!K) return;
    const isCall=leg.option_type==='call';
    const ep=parseFloat(leg.entry_price||leg.price||0);
    if(ep > 0){
      // Compute implied IV from the entry price — this calibrates the model
      const impliedIv = _bsImpliedIV(spot, K, T_entry, ep, isCall);
      leg._impliedIv = impliedIv;
      // Also compute delta at entry
      const g = _bsGreeks(spot, K, T_entry, impliedIv, isCall);
      leg._delta = g.delta;
    } else {
      // No entry price — estimate using global IV
      const legIv=parseFloat(leg.leg_iv||0)/100||iv;
      leg.entry_price=_bsPrice(spot,K,T_entry,legIv,isCall).toFixed(2);
      leg._impliedIv = legIv;
      const g = _bsGreeks(spot, K, T_entry, legIv, isCall);
      leg._delta = g.delta;
    }
  });
  _taLegs=legs;
  _taRenderLegs();
  _taBaseSpot=spot; _taBaseIv=iv; _taBaseDte=dte;
  _taSpotOffset=0; _taIvOffset=0; _taDaysOffset=0;
  // Reset sliders
  ['ta-s','ta-v','ta-d'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=0;});
  // Update days slider max
  const dsl=document.getElementById('ta-d');
  if(dsl)dsl.max=dte;
  const emptyEl = document.getElementById('ta-empty');
  if(emptyEl) emptyEl.style.display='none';
  _taDraw();
  _taDrawGreekChart('delta');
  _taShowStockInfo(sym, spot, dte, iv);
  _taShowStrikesBar(legs, spot);
  if(msg)msg.textContent=`✅ ${legs.length} legs · $${spot} · IV ${(iv*100).toFixed(0)}%`;
}

async function _taFetchIV(){
  const msg=document.getElementById('ta-msg');
  const sym=(document.getElementById('ta-sym')?.value||'SPY').toUpperCase();
  if(msg) msg.textContent='📡 Fetching IV from options chain…';
  try{
    const legs=_taLegs.filter(l=>l.option_type!=='stock'&&l.strike&&l.expiry);
    if(!legs.length){if(msg)msg.textContent='⚠ Set strikes and expiry first';return;}
    let totalIv=0,cnt=0;
    for(const leg of legs){
      try{
        const d=await api(`/analysis/iv/${sym}/${leg.expiry}/${leg.strike}/${leg.option_type}`);
        if(d.iv&&d.iv>0){
          totalIv+=d.iv; cnt++;
          if(!leg.entry_price&&d.price) leg.entry_price=d.price.toFixed(2);
          leg.leg_iv=(d.iv*100).toFixed(1);
        }
      }catch{}
    }
    if(cnt>0){
      const avgIv=totalIv/cnt;
      document.getElementById('ta-iv').value=(avgIv*100).toFixed(1);
      _taBaseIv=avgIv;
      _taRenderLegs();
      if(msg)msg.textContent=`✅ IV fetched: ${(avgIv*100).toFixed(1)}% avg`;
    } else {
      if(msg)msg.textContent='⚠ Could not fetch IV — using manual value';
    }
  }catch(e){if(msg)msg.textContent=`❌ ${e.message}`;}
}

// ─────────────────────────────────────────────────────────────────────────
// Sliders
// ─────────────────────────────────────────────────────────────────────────
function _taSlide(){
  _taSpotOffset=parseFloat(document.getElementById('ta-s')?.value||0);
  _taIvOffset  =parseFloat(document.getElementById('ta-v')?.value||0);
  _taDaysOffset=parseInt  (document.getElementById('ta-d')?.value||0);
  _taUpdatePins();
  _taDraw();
}

function _taUpdatePins(){
  const W=el=>document.getElementById(el)?.offsetWidth||300;
  const pin=(id,val,min,max,fmt,c)=>{
    const pct=(val-min)/(max-min)*100;
    const p=document.getElementById(id+'-pin');
    const f=document.getElementById(id+'-fill');
    if(p){p.style.left=pct+'%';p.textContent=fmt(val);p.style.background=c;}
    if(f){
      const mid=(0-min)/(max-min)*100;
      const l=Math.min(pct,mid),w=Math.abs(pct-mid);
      f.style.left=l+'%';f.style.width=w+'%';
      f.style.background=c;
    }
  };
  const sv=_taSpotOffset, vv=_taIvOffset, dv=_taDaysOffset;
  pin('ta-s',sv,-20,20,v=>(v>0?'+':'')+v+'%', sv>0?'#22c55e':sv<0?'#ef4444':'#3b82f6');
  pin('ta-v',vv,-50,50,v=>(v>0?'+':'')+v+'%', vv>0?'#ef4444':'#22c55e');
  const dMax=parseInt(document.getElementById('ta-d')?.max||60);
  pin('ta-d',dv,0,dMax,v=>v+'d','#64748b');

  // Scenario P&L labels
  const S2=_taBaseSpot*(1+sv/100);
  const iv2=Math.max(0.01,_taBaseIv+vv/100);
  const dte2=Math.max(0,_taBaseDte-dv);
  const legs=_taLegs.filter(l=>l.strike||l.option_type==='stock');
  const pnlS=_taStratPnL(legs,S2,_taBaseDte,_taBaseIv);
  const pnlV=_taStratPnL(legs,_taBaseSpot,_taBaseDte,iv2);
  const pnlD=_taStratPnL(legs,_taBaseSpot,dte2,_taBaseIv);
  const fmt=v=>(v>=0?'+':'')+'$'+v.toFixed(0);
  const fC=v=>v>=0?'#22c55e':'#ef4444';
  const set=(id,v)=>{const el=document.getElementById(id);if(el){el.textContent=fmt(v);el.style.color=fC(v);}};
  set('ta-s-pnl',pnlS);set('ta-v-pnl',pnlV);set('ta-d-pnl',pnlD);
}

// ─────────────────────────────────────────────────────────────────────────
// Draw payoff canvas
// ─────────────────────────────────────────────────────────────────────────
function _taDraw(){
  const cv=document.getElementById('ta-canvas');
  if(!cv||!_taBaseSpot) return;
  const ctx=cv.getContext('2d');
  const W=cv.offsetWidth||800; const H=cv.height||320;
  cv.width=W;

  const spot =_taBaseSpot*(1+_taSpotOffset/100);
  const iv   =Math.max(0.01,_taBaseIv+_taIvOffset/100);
  const dte  =Math.max(0,_taBaseDte-_taDaysOffset);
  const legs =_taLegs.filter(l=>l.strike||l.option_type==='stock');
  if(!legs.length) return;

  const PAD={t:28,r:16,b:28,l:58};
  const cW=W-PAD.l-PAD.r, cH=H-PAD.t-PAD.b;

  // Spot range: ±25% around BASE spot, 160 points
  const lo=_taBaseSpot*0.75, hi=_taBaseSpot*1.25;
  const spotArr=Array.from({length:160},(_,i)=>lo+i*(hi-lo)/159);

  // Scenario line and expiry line
  const scenLine=spotArr.map(S=>({S,pnl:_taStratPnL(legs,S,dte,iv)}));
  const expiryLine=spotArr.map(S=>({S,pnl:_taStratPnL(legs,S,0,iv)}));

  const allPnls=[...scenLine,...expiryLine].map(p=>p.pnl);
  const maxP=Math.max(...allPnls,0); const minP=Math.min(...allPnls,0);
  const range=Math.max(Math.abs(maxP),Math.abs(minP))||100;
  const padded=range*1.12;

  const toX=S=>PAD.l+(S-lo)/(hi-lo)*cW;
  const toY=v=>PAD.t+cH/2-v/padded*(cH/2);
  const y0=toY(0);

  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#0d1117';ctx.fillRect(0,0,W,H);

  // ── Sigma bands ──────────────────────────────────────────────────────
  const annIv=iv*Math.sqrt(Math.max(1,dte)/365);
  const sigma=[-2,-1,0,1,2].map(n=>_taBaseSpot*Math.exp(n*annIv));
  const bandC=['rgba(239,68,68,.07)','rgba(251,191,36,.05)','rgba(34,197,94,.05)','rgba(251,191,36,.05)','rgba(239,68,68,.07)'];
  for(let i=0;i<4;i++){
    const x1=Math.max(PAD.l,toX(sigma[i]));
    const x2=Math.min(W-PAD.r,toX(sigma[i+1]));
    if(x2>x1){ctx.fillStyle=bandC[i];ctx.fillRect(x1,PAD.t,x2-x1,cH);}
  }

  // ── Grid ─────────────────────────────────────────────────────────────
  ctx.strokeStyle='rgba(255,255,255,.04)';ctx.lineWidth=1;
  for(let i=1;i<8;i++){
    const y=PAD.t+i*cH/8;
    ctx.beginPath();ctx.moveTo(PAD.l,y);ctx.lineTo(W-PAD.r,y);ctx.stroke();
  }

  // ── Sigma lines ──────────────────────────────────────────────────────
  ctx.strokeStyle='rgba(255,255,255,.10)';ctx.lineWidth=1;ctx.setLineDash([2,4]);
  [-2,-1,1,2].forEach(n=>{
    const sx=toX(_taBaseSpot*Math.exp(n*annIv));
    if(sx>PAD.l&&sx<W-PAD.r){
      ctx.beginPath();ctx.moveTo(sx,PAD.t);ctx.lineTo(sx,PAD.t+cH);ctx.stroke();
      ctx.fillStyle='rgba(255,255,255,.3)';ctx.font='9px sans-serif';ctx.textAlign='center';
      ctx.fillText((n>0?'+':'')+n+'σ',sx,PAD.t-5);
    }
  });
  ctx.setLineDash([]);

  // ── Zero line ────────────────────────────────────────────────────────
  ctx.strokeStyle='rgba(255,255,255,.2)';ctx.lineWidth=1.5;ctx.setLineDash([5,4]);
  ctx.beginPath();ctx.moveTo(PAD.l,y0);ctx.lineTo(W-PAD.r,y0);ctx.stroke();
  ctx.setLineDash([]);

  // ── Expiry line (orange dashed, like Opstra) ─────────────────────────
  if(dte>0){
    ctx.strokeStyle='rgba(249,115,22,.7)';ctx.lineWidth=1.8;ctx.setLineDash([4,3]);
    ctx.beginPath();
    expiryLine.forEach((p,i)=>i===0?ctx.moveTo(toX(p.S),toY(p.pnl)):ctx.lineTo(toX(p.S),toY(p.pnl)));
    ctx.stroke();ctx.setLineDash([]);
  }

  // ── Fill zones for scenario line ─────────────────────────────────────
  // Green above zero
  ctx.save();ctx.beginPath();ctx.rect(PAD.l,PAD.t,cW,Math.max(0,y0-PAD.t));ctx.clip();
  const gG=ctx.createLinearGradient(0,PAD.t,0,y0);
  gG.addColorStop(0,'rgba(34,197,94,.25)');gG.addColorStop(1,'rgba(34,197,94,.04)');
  ctx.fillStyle=gG;ctx.beginPath();
  scenLine.forEach((p,i)=>i===0?ctx.moveTo(toX(p.S),toY(p.pnl)):ctx.lineTo(toX(p.S),toY(p.pnl)));
  ctx.lineTo(toX(scenLine[scenLine.length-1].S),y0);ctx.lineTo(toX(scenLine[0].S),y0);
  ctx.closePath();ctx.fill();ctx.restore();
  // Red below zero
  ctx.save();ctx.beginPath();ctx.rect(PAD.l,y0,cW,cH-(y0-PAD.t));ctx.clip();
  const gR=ctx.createLinearGradient(0,y0,0,PAD.t+cH);
  gR.addColorStop(0,'rgba(239,68,68,.04)');gR.addColorStop(1,'rgba(239,68,68,.22)');
  ctx.fillStyle=gR;ctx.beginPath();
  scenLine.forEach((p,i)=>i===0?ctx.moveTo(toX(p.S),toY(p.pnl)):ctx.lineTo(toX(p.S),toY(p.pnl)));
  ctx.lineTo(toX(scenLine[scenLine.length-1].S),y0);ctx.lineTo(toX(scenLine[0].S),y0);
  ctx.closePath();ctx.fill();ctx.restore();

  // ── Scenario P&L line (blue solid) ──────────────────────────────────
  ctx.strokeStyle='#3b82f6';ctx.lineWidth=2.5;
  ctx.beginPath();
  scenLine.forEach((p,i)=>i===0?ctx.moveTo(toX(p.S),toY(p.pnl)):ctx.lineTo(toX(p.S),toY(p.pnl)));
  ctx.stroke();

  // ── Breakeven markers ────────────────────────────────────────────────
  let prevPnl=expiryLine[0].pnl, beArr=[];
  expiryLine.forEach((p,i)=>{
    if(i>0&&((prevPnl<0&&p.pnl>=0)||(prevPnl>=0&&p.pnl<0)))
      beArr.push((p.S+expiryLine[i-1].S)/2);
    prevPnl=p.pnl;
  });
  beArr.forEach(be=>{
    const bx=toX(be);
    ctx.fillStyle='#fbbf24';ctx.beginPath();ctx.arc(bx,y0,5,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='rgba(0,0,0,.7)';ctx.fillRect(bx-24,y0-20,48,14);
    ctx.fillStyle='#fbbf24';ctx.font='bold 9px monospace';ctx.textAlign='center';
    ctx.fillText('$'+be.toFixed(0),bx,y0-9);
  });

  // ── Current spot line ────────────────────────────────────────────────
  const sx=toX(spot);
  ctx.strokeStyle='rgba(251,191,36,.6)';ctx.lineWidth=1.5;ctx.setLineDash([3,3]);
  ctx.beginPath();ctx.moveTo(sx,PAD.t);ctx.lineTo(sx,PAD.t+cH);ctx.stroke();
  ctx.setLineDash([]);

  // P&L dot at scenario spot
  const nearestPnl=_taStratPnL(legs,spot,dte,iv);
  const py=toY(nearestPnl);
  ctx.fillStyle=nearestPnl>=0?'#22c55e':'#ef4444';
  ctx.beginPath();ctx.arc(sx,py,6,0,Math.PI*2);ctx.fill();
  // Label
  ctx.fillStyle='rgba(0,0,0,.75)';ctx.fillRect(sx-28,py-20,56,15);
  ctx.fillStyle=nearestPnl>=0?'#22c55e':'#ef4444';
  ctx.font='bold 10px monospace';ctx.textAlign='center';
  ctx.fillText((nearestPnl>=0?'+':'')+'$'+nearestPnl.toFixed(0),sx,py-9);

  // ── Y-axis labels ────────────────────────────────────────────────────
  ctx.textAlign='right';ctx.font='10px monospace';
  const step=Math.pow(10,Math.floor(Math.log10(padded)));
  for(let v=-padded;v<=padded+step*0.1;v+=step){
    const vy=toY(v);if(vy<PAD.t-2||vy>PAD.t+cH+2)continue;
    ctx.fillStyle=v>0?'rgba(34,197,94,.7)':v<0?'rgba(239,68,68,.7)':'rgba(255,255,255,.5)';
    ctx.fillText((v>=0?'+':'')+v.toFixed(0),PAD.l-4,vy+3);
  }

  // ── X-axis spot labels ───────────────────────────────────────────────
  ctx.textAlign='center';ctx.fillStyle='rgba(255,255,255,.35)';ctx.font='9px monospace';
  [0,40,79,119,159].forEach(i=>{if(spotArr[i])ctx.fillText(spotArr[i].toFixed(0),toX(spotArr[i]),PAD.t+cH+12);});

  // ── Key levels ───────────────────────────────────────────────────────
  const levEl=document.getElementById('ta-levels');
  if(levEl){
    const exPnls=expiryLine.map(p=>p.pnl);
    const mp=Math.max(...exPnls),ml=Math.min(...exPnls);
    // Compute PoP for levels bar
    const _avgIv2 = legs.reduce((s,l)=>s+(l._impliedIv||parseFloat(l.leg_iv||0)/100||iv),0)/legs.length;
    const _sig2 = _avgIv2*Math.sqrt(Math.max(1,_taBaseDte)/365);
    const _mu2 = Math.log(_taBaseSpot)+(-0.5*_avgIv2*_avgIv2)*(_taBaseDte/365);
    let _pop2 = 50;
    if(beArr.length===1){
      const z=(Math.log(beArr[0])-_mu2)/_sig2;
      const midPnl2=expiryLine[Math.floor(expiryLine.length/2)]?.pnl||0;
      _pop2=(midPnl2>0?_bsNormCDF(z):1-_bsNormCDF(z))*100;
    } else if(beArr.length===2){
      const midPnl2=_taStratPnL(legs,(beArr[0]+beArr[1])/2,0,iv);
      const pB0=_bsNormCDF((Math.log(beArr[0])-_mu2)/_sig2);
      const pB1=_bsNormCDF((Math.log(beArr[1])-_mu2)/_sig2);
      _pop2=midPnl2>0?(pB1-pB0)*100:(pB0+(1-pB1))*100;
    } else if(beArr.length===0){ _pop2=expiryLine[80]?.pnl>=0?95:5; }
    _pop2=Math.min(99,Math.max(1,Math.round(_pop2*10)/10));
    const _popC2=_pop2>=65?'#22c55e':_pop2>=45?'#f59e0b':'#ef4444';

    levEl.innerHTML=[
      {l:'Max Profit',v:'$'+mp.toFixed(0),c:'#22c55e'},
      {l:'Max Loss',  v:'$'+Math.abs(ml).toFixed(0),c:'#ef4444'},
      {l:'Breakevens',v:beArr.length?beArr.map(b=>'$'+b.toFixed(0)).join(' / '):'—',c:'#fbbf24'},
      {l:'P&L now',   v:(nearestPnl>=0?'+':'')+'$'+nearestPnl.toFixed(0),c:nearestPnl>=0?'#22c55e':'#ef4444'},
      {l:'PoP',       v:_pop2.toFixed(1)+'%',c:_popC2},
      {l:'DTE',       v:dte+'d',c:'#3b82f6'},
    ].map(k=>`<span><span style="color:var(--muted)">${k.l}: </span><b style="color:${k.c}">${k.v}</b></span>`)
     .join('<span style="color:var(--border);margin:0 6px">|</span>');
  }

  // ── Greeks bar ───────────────────────────────────────────────────────
  const g=_taStratGreeks(legs,spot,dte,iv);
  const gbEl=document.getElementById('ta-greeks-bar');
  if(gbEl) gbEl.innerHTML=[
    {n:'Δ Delta',v:g.delta,c:g.delta>=0?'#22c55e':'#ef4444'},
    {n:'Γ Gamma', v:g.gamma,c:'#3b82f6'},
    {n:'Θ Theta', v:g.theta,c:g.theta<0?'#ef4444':'#22c55e'},
    {n:'V Vega',  v:g.vega, c:'#a855f7'},
  ].map(x=>`<span style="background:var(--surface);border:1px solid var(--border);
    padding:3px 9px;border-radius:4px;font-size:11px">
    <span style="color:var(--muted)">${x.n}: </span>
    <b style="color:${x.c}">${x.v>=0?'+':''}${x.v.toFixed(x.v>10||x.v<-10?1:3)}</b>
  </span>`).join('');

  // ── P&L at spot display ──────────────────────────────────────────────
  const pnlSEl=document.getElementById('ta-pnl-spot');
  if(pnlSEl){
    pnlSEl.textContent=(nearestPnl>=0?'+':'')+'$'+nearestPnl.toFixed(2);
    pnlSEl.style.color=nearestPnl>=0?'#22c55e':'#ef4444';
  }

  // Update slider scenario labels
  _taUpdatePins();
}

// ─────────────────────────────────────────────────────────────────────────
// Hover tooltip
// ─────────────────────────────────────────────────────────────────────────
function _taHover(e){
  if(!_taBaseSpot) return;
  const cv=e.currentTarget;
  const rect=cv.getBoundingClientRect();
  const mx=e.clientX-rect.left;
  const W=cv.width||800;
  const PAD_L=58,cW=W-PAD_L-16;
  const lo=_taBaseSpot*0.75, hi=_taBaseSpot*1.25;
  const S=lo+(mx-PAD_L)/cW*(hi-lo);
  if(S<lo||S>hi) return;
  const legs=_taLegs.filter(l=>l.strike||l.option_type==='stock');
  const dte=Math.max(0,_taBaseDte-_taDaysOffset);
  const iv=Math.max(0.01,_taBaseIv+_taIvOffset/100);
  const pnl=_taStratPnL(legs,S,dte,iv);
  const tip=document.getElementById('ta-tip');
  if(!tip) return;
  const c=pnl>=0?'#22c55e':'#ef4444';
  tip.innerHTML=`<div style="color:var(--muted);font-size:9px">Spot: $${S.toFixed(1)}</div>
    <div style="font-weight:800;font-size:13px;color:${c}">${pnl>=0?'+':''}$${pnl.toFixed(2)}</div>`;
  tip.style.display='';
  tip.style.left=Math.min(mx+10,cv.offsetWidth-90)+'px';
  tip.style.top='30px';
}

// ─────────────────────────────────────────────────────────────────────────
// Greeks chart
// ─────────────────────────────────────────────────────────────────────────
function _taShowGreek(g){
  _taActiveGreek=g;
  ['delta','gamma','theta','vega'].forEach(k=>{
    const b=document.getElementById('ta-gb-'+k);
    if(b){b.style.background=k===g?'#6366f1':'';b.style.color=k===g?'#fff':'';}
  });
  _taDrawGreekChart(g);
}

function _taDrawGreekChart(metric){
  const cv=document.getElementById('ta-gcanvas');
  if(!cv||!_taBaseSpot) return;
  const ctx=cv.getContext('2d');
  const W=cv.offsetWidth||800; const H=cv.height||120;
  cv.width=W; ctx.clearRect(0,0,W,H);
  const legs=_taLegs.filter(l=>l.strike||l.option_type==='stock');
  if(!legs.length) return;
  const spot=_taBaseSpot*(1+_taSpotOffset/100);
  const iv=Math.max(0.01,_taBaseIv+_taIvOffset/100);
  // Compute greek at spot for each DTE from max down to 1
  const dtes=Array.from({length:_taBaseDte},(_,i)=>_taBaseDte-i);
  const vals=dtes.map(d=>_taStratGreeks(legs,spot,d,iv)[metric]||0);
  const maxV=Math.max(...vals,0),minV=Math.min(...vals,0);
  const rng=Math.max(Math.abs(maxV),Math.abs(minV))||1;
  const PAD={t:14,r:12,b:18,l:48};
  const cW=W-PAD.l-PAD.r,cH=H-PAD.t-PAD.b;
  const toX=(_,i)=>PAD.l+i/Math.max(1,dtes.length-1)*cW;
  const toY=v=>PAD.t+cH/2-v/rng*(cH/2);
  // Zero
  ctx.strokeStyle='rgba(255,255,255,.15)';ctx.lineWidth=1;ctx.setLineDash([3,3]);
  const yz=toY(0);ctx.beginPath();ctx.moveTo(PAD.l,yz);ctx.lineTo(W-PAD.r,yz);ctx.stroke();ctx.setLineDash([]);
  const colors={delta:'#3b82f6',gamma:'#22c55e',theta:'#ef4444',vega:'#a855f7'};
  const c=colors[metric]||'#64748b';
  // Fill
  ctx.fillStyle=c+'28';ctx.beginPath();ctx.moveTo(toX(null,0),toY(vals[0]));
  vals.forEach((v,i)=>ctx.lineTo(toX(null,i),toY(v)));
  ctx.lineTo(toX(null,vals.length-1),yz);ctx.lineTo(toX(null,0),yz);ctx.closePath();ctx.fill();
  // Line
  ctx.strokeStyle=c;ctx.lineWidth=2;ctx.beginPath();
  vals.forEach((v,i)=>i===0?ctx.moveTo(toX(null,i),toY(v)):ctx.lineTo(toX(null,i),toY(v)));
  ctx.stroke();
  // Labels
  ctx.fillStyle='rgba(255,255,255,.4)';ctx.font='9px monospace';ctx.textAlign='left';
  ctx.fillText(metric.toUpperCase()+' @ $'+spot.toFixed(0),PAD.l+2,12);
  ctx.textAlign='right';
  [maxV,0,minV].forEach(v=>{
    const vy=toY(v);if(vy>PAD.t&&vy<PAD.t+cH){
      ctx.fillStyle=v>0?'rgba(34,197,94,.7)':v<0?'rgba(239,68,68,.7)':'rgba(255,255,255,.4)';
      ctx.fillText(v.toFixed(2),PAD.l-3,vy+3);
    }
  });
  ctx.textAlign='center';ctx.fillStyle='rgba(255,255,255,.35)';
  [0,Math.floor(dtes.length/2),dtes.length-1].forEach(i=>{
    if(dtes[i]) ctx.fillText(dtes[i]+'d',toX(null,i),H-2);
  });
}

// ─────────────────────────────────────────────────────────────────────────
// Load from journal trade
// ─────────────────────────────────────────────────────────────────────────
function _taLoadFromTrade(trade){
  if(!trade) return;
  const symEl=document.getElementById('ta-sym');
  if(symEl) symEl.value=trade.symbol||'SPY';
  const spotEl=document.getElementById('ta-spot');
  if(spotEl&&trade.spot_price) spotEl.value=trade.spot_price;
  const dteEl=document.getElementById('ta-dte');
  if(dteEl&&trade.expiry){
    const days=Math.max(1,Math.round((new Date(trade.expiry)-new Date())/86400000));
    dteEl.value=days;
    const dsl=document.getElementById('ta-d');if(dsl) dsl.max=days;
  }
  // Build legs
  try{
    const legs=JSON.parse(trade.legs_json||'[]');
    if(legs.length){
      _taLegs=legs.map(l=>{
        // Preserve original entry price — don't let 0 become empty
        const origPrice = l.price!=null&&l.price!=='' ? String(l.price)
                        : l.entry_price!=null&&l.entry_price!=='' ? String(l.entry_price) : '';
        return {side:l.side||'buy', option_type:l.option_type||'call',
          strike:l.strike||'', expiry:l.expiry||trade.expiry||'',
          entry_price:origPrice, qty:l.qty||1, leg_iv:'', _isOriginal:true};
      });
    } else { _taLegs=_taLegsLegacy(trade); }
  }catch{ _taLegs=_taLegsLegacy(trade); }
  _taRenderLegs();
  setTimeout(_taAnalyze,100);
}

function _taLegsLegacy(t){
  const exp=t.expiry||'';const tt=t.trade_type;
  if(tt==='PS')  return [{side:'sell',option_type:'put', strike:t.short_strike,expiry:exp,entry_price:t.entry_price,qty:t.quantity||1,leg_iv:''},
                          {side:'buy', option_type:'put', strike:t.long_strike, expiry:exp,entry_price:'',qty:t.quantity||1,leg_iv:''}];
  if(tt==='CS')  return [{side:'sell',option_type:'call',strike:t.short_strike,expiry:exp,entry_price:t.entry_price,qty:t.quantity||1,leg_iv:''},
                          {side:'buy', option_type:'call',strike:t.long_strike, expiry:exp,entry_price:'',qty:t.quantity||1,leg_iv:''}];
  if(tt==='IC')  return [{side:'sell',option_type:'put', strike:t.put_sell,  expiry:exp,entry_price:t.put_credit||'',qty:1,leg_iv:''},
                          {side:'buy', option_type:'put', strike:t.put_buy,   expiry:exp,entry_price:'',qty:1,leg_iv:''},
                          {side:'sell',option_type:'call',strike:t.call_sell, expiry:exp,entry_price:t.call_credit||'',qty:1,leg_iv:''},
                          {side:'buy', option_type:'call',strike:t.call_buy,  expiry:exp,entry_price:'',qty:1,leg_iv:''}];
  if(tt==='Stock') return [{side:'buy',option_type:'stock',strike:'',expiry:'',entry_price:t.entry_price,qty:t.quantity||100,leg_iv:''}];
  return [];
}

async function _jrnOpenAnalysis(tid){
  let trade=window._jrnTrades?.find(t=>t.id===tid);
  if(!trade){
    try{const all=await api('/journal/trades?status=ALL');window._jrnTrades=all;trade=all.find(t=>t.id===tid);}catch{}
  }
  // Switch tab
  _setActiveTab('tradeanalysis');
  // Reset dataset.built so it rebuilds with trade data
  const root=document.getElementById('trade-analysis-root');
  if(root) root.dataset.built='';
  setTimeout(()=>_loadTradeAnalysis(trade||null),80);
}



function _taShowStockInfo(sym, spot, dte, iv) {
  const el = document.getElementById('ta-stock-info');
  if (!el) return;
  el.style.display = '';
  const legs = _taLegs.filter(l => l.strike || l.option_type === 'stock');
  if (!legs.length) return;

  // ── Expiry P&L curve for max profit / max loss / breakevens ────────
  const expiryLine = Array.from({length:200}, (_, i) => {
    const S = spot * 0.70 + i * (spot * 0.60) / 199;
    return {S, pnl: _taStratPnL(legs, S, 0, iv)};
  });
  const pnls = expiryLine.map(p => p.pnl);
  const maxP = Math.max(...pnls), minP = Math.min(...pnls);
  let prevP = expiryLine[0].pnl;
  const bes = [];
  expiryLine.forEach((p, i) => {
    if (i > 0 && ((prevP < 0 && p.pnl >= 0) || (prevP >= 0 && p.pnl < 0)))
      bes.push((p.S + expiryLine[i - 1].S) / 2);
    prevP = p.pnl;
  });

  // ── Probability of Profit (PoP) using log-normal distribution ──────
  // Uses per-leg implied IVs for accurate sigma
  const avgIv = legs.reduce((sum, l) => sum + (l._impliedIv || parseFloat(l.leg_iv||0)/100 || iv), 0) / legs.length;
  const sigma = avgIv * Math.sqrt(Math.max(1, dte) / 365);
  const mu = Math.log(spot) + (-0.5 * avgIv * avgIv) * (dte / 365);  // log-normal drift

  function probBelow(S) {
    // P(S_T < S) under log-normal
    if (S <= 0) return 0;
    const z = (Math.log(S) - mu) / sigma;
    return _bsNormCDF(z);
  }
  function probAbove(S) { return 1 - probBelow(S); }

  // Determine profit zones from expiry P&L
  // Sample at fine granularity to find where P&L > 0
  let popPct = 0;
  if (bes.length === 0) {
    // No breakevens: either all profit or all loss
    popPct = expiryLine[Math.floor(expiryLine.length/2)].pnl >= 0 ? 95 : 5;
  } else if (bes.length === 1) {
    // One breakeven: profit is on one side
    const be = bes[0];
    const profitAbove = expiryLine[expiryLine.length - 1].pnl > 0;
    popPct = profitAbove ? probAbove(be) * 100 : probBelow(be) * 100;
  } else if (bes.length === 2) {
    // Two breakevens (e.g. iron condor, straddle)
    const midPnl = _taStratPnL(legs, (bes[0] + bes[1]) / 2, 0, iv);
    if (midPnl > 0) {
      // Profit is BETWEEN breakevens (iron condor / credit spread)
      popPct = (probBelow(bes[1]) - probBelow(bes[0])) * 100;
    } else {
      // Profit is OUTSIDE breakevens (long straddle/strangle)
      popPct = (probBelow(bes[0]) + probAbove(bes[1])) * 100;
    }
  } else {
    // Multiple breakevens: integrate profit zones
    let pop = 0;
    for (let i = 0; i < expiryLine.length - 1; i++) {
      if (expiryLine[i].pnl >= 0) {
        const w = (expiryLine[i + 1].S - expiryLine[i].S);
        pop += probBelow(expiryLine[i].S + w/2) - probBelow(expiryLine[i].S - w/2);
      }
    }
    popPct = Math.min(99, Math.max(1, pop * 100));
  }
  popPct = Math.min(99, Math.max(1, Math.round(popPct * 10) / 10));

  // ── Score (0-100) ─────────────────────────────────────────────────
  // Factors: PoP, R:R, theta advantage, DTE sweet spot, delta neutrality
  const g = _taStratGreeks(legs, spot, dte, iv);
  const rrRatio = Math.abs(minP) > 0 ? maxP / Math.abs(minP) : 0;
  const netCredit = legs.reduce((s, l) => {
    const ep = parseFloat(l.entry_price || l.price || 0), q = parseInt(l.qty || 1);
    return s + (l.side === 'sell' ? ep * q : -ep * q);
  }, 0);
  const isCredit = netCredit > 0;

  let score = 0;
  const scoreNotes = [];

  // PoP (max 30 pts)
  if (popPct >= 70) { score += 30; scoreNotes.push(`PoP ${popPct.toFixed(0)}% excellent`); }
  else if (popPct >= 55) { score += 22; scoreNotes.push(`PoP ${popPct.toFixed(0)}% good`); }
  else if (popPct >= 40) { score += 14; scoreNotes.push(`PoP ${popPct.toFixed(0)}% moderate`); }
  else { score += 6; scoreNotes.push(`PoP ${popPct.toFixed(0)}% low`); }

  // R:R ratio (max 20 pts)
  if (rrRatio >= 2.0) { score += 20; scoreNotes.push(`R:R ${rrRatio.toFixed(1)}:1 excellent`); }
  else if (rrRatio >= 1.0) { score += 14; scoreNotes.push(`R:R ${rrRatio.toFixed(1)}:1 solid`); }
  else if (rrRatio >= 0.5) { score += 8; scoreNotes.push(`R:R ${rrRatio.toFixed(1)}:1 marginal`); }
  else { score += 3; }

  // Theta advantage (max 15 pts) — positive theta = time working for you
  if (g.theta > 0) { score += 15; scoreNotes.push(`Theta +${g.theta.toFixed(1)} (time decay earns)`); }
  else if (g.theta > -5) { score += 8; }
  else { score += 2; scoreNotes.push(`Theta ${g.theta.toFixed(1)} (time decay costs)`); }

  // DTE sweet spot (max 10 pts)
  if (dte >= 21 && dte <= 45) { score += 10; scoreNotes.push(`DTE ${dte}d sweet spot`); }
  else if (dte >= 14 && dte <= 60) { score += 6; }
  else if (dte < 7) { score += 2; scoreNotes.push(`DTE ${dte}d gamma risk`); }
  else { score += 4; }

  // Credit vs debit (max 10 pts)
  if (isCredit) { score += 10; scoreNotes.push('Credit trade ✓'); }
  else { score += 4; }

  // Delta neutrality for neutral strategies (max 10 pts)
  const absDelta = Math.abs(g.delta);
  if (absDelta < 5) { score += 10; scoreNotes.push('Delta neutral ✓'); }
  else if (absDelta < 15) { score += 7; }
  else if (absDelta < 30) { score += 4; }
  else { score += 1; }

  // Vega (max 5 pts) — negative vega for credit spreads is good
  if (isCredit && g.vega < 0) { score += 5; scoreNotes.push('Short vega ✓'); }
  else if (!isCredit && g.vega > 0) { score += 5; }
  else { score += 2; }

  score = Math.min(100, Math.max(5, Math.round(score)));
  const scoreC = score >= 75 ? '#22c55e' : score >= 55 ? '#4ade80' : score >= 40 ? '#f59e0b' : '#ef4444';
  const popC = popPct >= 65 ? '#22c55e' : popPct >= 50 ? '#4ade80' : popPct >= 35 ? '#f59e0b' : '#ef4444';

  // ── Strategy name detection ────────────────────────────────────────
  const puts = legs.filter(l => l.option_type === 'put');
  const calls = legs.filter(l => l.option_type === 'call');
  const stocks = legs.filter(l => l.option_type === 'stock');
  let stratName = legs.length + '-Leg Custom';
  if (puts.length===2 && !calls.length) stratName = puts.some(l=>l.side==='sell')?'Bull Put Spread':'Put Debit Spread';
  if (calls.length===2 && !puts.length) stratName = calls.some(l=>l.side==='sell')?'Bear Call Spread':'Call Debit Spread';
  if (puts.length===2 && calls.length===2) stratName = 'Iron Condor';
  if (puts.length===1 && calls.length===1 && puts[0].strike===calls[0].strike) stratName = 'Straddle';
  if (puts.length===1 && calls.length===1 && puts[0].strike!==calls[0].strike) stratName = (puts[0].side==='sell'&&calls[0].side==='sell')?'Strangle':'Custom';
  if (stocks.length && calls.length===1 && calls[0].side==='sell') stratName = 'Covered Call';
  if (legs.length===1 && legs[0].option_type==='call') stratName = legs[0].side==='buy'?'Long Call':'Short Call';
  if (legs.length===1 && legs[0].option_type==='put') stratName = legs[0].side==='buy'?'Long Put':'Short Put';
  if (stocks.length===1 && !calls.length && !puts.length) stratName = 'Stock Position';

  el.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px">
      <div>
        <div style="margin-bottom:4px">
          <span style="font-size:15px;font-weight:800;color:var(--accent)">${sym}</span>
          <span style="font-size:12px;color:var(--muted);margin-left:8px">Spot: <b style="color:var(--text)">$${spot.toFixed(2)}</b></span>
          <span style="font-size:12px;color:var(--muted);margin-left:8px">IV: <b style="color:#a855f7">${(avgIv*100).toFixed(1)}%</b></span>
          <span style="font-size:12px;color:var(--muted);margin-left:8px">DTE: <b style="color:#3b82f6">${dte}d</b></span>
        </div>
        <div style="display:flex;gap:16px;font-size:11px;flex-wrap:wrap">
          <span>Max Profit: <b style="color:#22c55e">$${maxP.toFixed(0)}</b></span>
          <span>Max Loss: <b style="color:#ef4444">$${Math.abs(minP).toFixed(0)}</b></span>
          <span>Breakevens: <b style="color:#fbbf24">${bes.length?bes.map(b=>'$'+b.toFixed(1)).join(' / '):'—'}</b></span>
          <span>R:R: <b style="color:${rrRatio>=1?'#22c55e':'#f59e0b'}">${rrRatio.toFixed(2)}:1</b></span>
          <span>Net ${isCredit?'Credit':'Debit'}: <b style="color:${isCredit?'#22c55e':'#ef4444'}">$${Math.abs(netCredit*100).toFixed(0)}</b></span>
        </div>
      </div>
      <div style="display:flex;gap:10px;align-items:center">
        <!-- PoP -->
        <div style="text-align:center;background:var(--card);border:2px solid ${popC};border-radius:8px;padding:6px 12px;min-width:70px">
          <div style="font-size:9px;color:var(--muted);margin-bottom:2px">Prob. of Profit</div>
          <div style="font-size:20px;font-weight:900;color:${popC}">${popPct.toFixed(1)}%</div>
        </div>
        <!-- Score -->
        <div style="text-align:center;background:var(--card);border:2px solid ${scoreC};border-radius:8px;padding:6px 12px;min-width:70px"
          title="${scoreNotes.join(' · ')}">
          <div style="font-size:9px;color:var(--muted);margin-bottom:2px">Score</div>
          <div style="font-size:20px;font-weight:900;color:${scoreC}">${score}</div>
          <div style="font-size:9px;color:${scoreC}">/100</div>
        </div>
        <!-- Strategy badge -->
        <div style="background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.3);color:#a5b4fc;
          padding:6px 14px;border-radius:6px;font-size:12px;font-weight:700;white-space:nowrap">${stratName}</div>
      </div>
    </div>`;
}

function _taShowStrikesBar(legs, spot) {
  const el = document.getElementById('ta-strikes-bar');
  if (!el) return;
  const optLegs = legs.filter(l => l.option_type !== 'stock' && l.strike);
  if (!optLegs.length) { el.style.display = 'none'; return; }
  el.style.display = '';
  const strikes = optLegs.map(l => parseFloat(l.strike));
  const minK = Math.min(...strikes, spot * 0.95);
  const maxK = Math.max(...strikes, spot * 1.05);
  const range = maxK - minK || 1;
  const toP = v => ((v - minK) / range * 90 + 5);
  el.innerHTML = `
    <div style="position:relative;height:32px;background:var(--surface);border:1px solid var(--border);border-radius:4px;overflow:hidden">
      <!-- Spot marker -->
      <div style="position:absolute;top:0;bottom:0;left:${toP(spot)}%;width:2px;background:rgba(251,191,36,.5)"></div>
      <div style="position:absolute;top:2px;left:${toP(spot)}%;transform:translateX(-50%);
        font-size:8px;color:#fbbf24;font-weight:700;white-space:nowrap">S: $${spot.toFixed(0)}</div>
      <!-- Strike markers -->
      ${optLegs.map(l => {
        const K = parseFloat(l.strike);
        const c = l.option_type === 'call' ? '#ef4444' : '#22c55e';
        const icon = l.side === 'sell' ? '▼' : '▲';
        const typeChar = l.option_type === 'call' ? 'C' : 'P';
        return `<div style="position:absolute;bottom:2px;left:${toP(K)}%;transform:translateX(-50%);
          text-align:center">
          <div style="font-size:10px;color:${c};font-weight:700">${icon}</div>
          <div style="font-size:8px;color:${c};white-space:nowrap">${l.side === 'sell' ? 'S' : 'B'}${typeChar}$${K}</div>
        </div>`;
      }).join('')}
    </div>`;
}




// BACKTEST PAGE

function _loadBacktest() {
  const el=document.getElementById('backtest-root');
  if(!el) return;
  if(el.dataset.built) return;
  el.dataset.built='1';

  const today=new Date().toISOString().slice(0,10);
  const oneYearAgo=new Date(Date.now()-365*86400000).toISOString().slice(0,10);

  el.innerHTML=`
  <div style="max-width:900px">
    <div class="card" style="padding:14px;margin-bottom:10px">
      <div style="font-size:13px;font-weight:700;margin-bottom:10px">⏮ Strategy Backtest</div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:10px">
        <div><label style="font-size:11px;color:var(--muted)">Symbol</label>
          <input id="bt-symbol" value="SPY" style="width:100%"/></div>
        <div><label style="font-size:11px;color:var(--muted)">Strategy</label>
          <select id="bt-strategy" style="width:100%">
            <option value="CS">Bear Call Spread (MR Bear / Overbought)</option>
            <option value="PS">Bull Put Spread (MR Bull / Oversold)</option>
          </select></div>
        <div><label style="font-size:11px;color:var(--muted)">Entry Signal</label>
          <select id="bt-signal" style="width:100%">
            <option value="MEAN_REV_BEAR">RSI-EMA ≥ threshold (Overbought)</option>
            <option value="MEAN_REV_BULL">RSI-EMA ≤ -threshold (Oversold)</option>
            <option value="TRENDING">EMA20 > EMA50 (Trend)</option>
          </select></div>
        <div><label style="font-size:11px;color:var(--muted)">RSI-EMA Threshold</label>
          <input id="bt-threshold" type="number" value="15" min="5" max="30" style="width:100%"/></div>
        <div><label style="font-size:11px;color:var(--muted)">Target DTE</label>
          <input id="bt-dte" type="number" value="28" min="7" max="90" style="width:100%"/></div>
        <div><label style="font-size:11px;color:var(--muted)">Wing % OTM</label>
          <input id="bt-wing" type="number" value="5" step="0.5" min="1" max="20" style="width:100%"/></div>
        <div><label style="font-size:11px;color:var(--muted)">Start Date</label>
          <input id="bt-start" type="date" value="${oneYearAgo}" style="width:100%"/></div>
        <div><label style="font-size:11px;color:var(--muted)">End Date</label>
          <input id="bt-end" type="date" value="${today}" style="width:100%"/></div>
        <div style="display:flex;align-items:flex-end">
          <button class="btn btn-primary" style="width:100%;padding:8px" onclick="_btRun()">▶ Run Backtest</button>
        </div>
      </div>
      <div id="bt-status" style="font-size:11px;color:var(--muted)"></div>
    </div>

    <!-- Stats + Equity Curve -->
    <div id="bt-results" style="display:none">
      <!-- Stats header -->
      <div id="bt-stats" class="card" style="padding:12px;margin-bottom:10px"></div>
      <!-- Equity curve chart -->
      <div class="card" style="padding:12px;margin-bottom:10px">
        <div style="font-size:12px;font-weight:700;margin-bottom:8px">Equity Curve</div>
        <div style="height:200px;position:relative">
          <canvas id="bt-equity-chart" style="width:100%;height:100%"></canvas>
        </div>
      </div>
      <!-- Trade log -->
      <div class="card" style="padding:12px">
        <div style="font-size:12px;font-weight:700;margin-bottom:8px">Trade Log <span id="bt-trade-count" style="color:var(--muted);font-size:11px"></span></div>
        <div style="overflow-x:auto">
          <table class="data-tbl" style="width:100%;font-size:11px" id="bt-trade-table"></table>
        </div>
      </div>
    </div>
  </div>`;
}

async function _btRun() {
  const st=document.getElementById('bt-status');
  if(st) st.innerHTML='⏳ Running backtest… (fetching historical data)';
  const p={
    symbol:    document.getElementById('bt-symbol')?.value||'SPY',
    strategy:  document.getElementById('bt-strategy')?.value||'CS',
    entry_signal: document.getElementById('bt-signal')?.value||'MEAN_REV_BEAR',
    rsi_ema_threshold: document.getElementById('bt-threshold')?.value||15,
    dte:       document.getElementById('bt-dte')?.value||28,
    wing_pct:  document.getElementById('bt-wing')?.value||5,
    start:     document.getElementById('bt-start')?.value||'2023-01-01',
    end:       document.getElementById('bt-end')?.value||new Date().toISOString().slice(0,10),
  };
  try {
    const d=await api(`/analysis/backtest?${new URLSearchParams(p)}`);
    if(d.error){ if(st) st.innerHTML=`❌ ${d.error}`; return; }
    if(st) st.innerHTML=`✅ Complete: ${d.stats.total} trades found`;
    _btRenderResults(d);
  } catch(e){ if(st) st.innerHTML=`❌ ${e.message}`; }
}

function _btRenderResults(d) {
  const res=document.getElementById('bt-results');
  if(res) res.style.display='';
  const s=d.stats;

  // Stats header
  const stats=document.getElementById('bt-stats');
  if(stats) stats.innerHTML=`
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px">
      ${[
        {l:'Total Trades',v:s.total,c:'var(--text)'},
        {l:'Win Rate',v:s.win_rate+'%',c:s.win_rate>=55?'#22c55e':'#ef4444'},
        {l:'Total P&L',v:(s.total_pnl>=0?'+':'')+'$'+s.total_pnl,c:s.total_pnl>=0?'#22c55e':'#ef4444'},
        {l:'Avg Win',v:'$'+s.avg_win,c:'#22c55e'},
        {l:'Avg Loss',v:'$'+Math.abs(s.avg_loss),c:'#ef4444'},
        {l:'Max Drawdown',v:'$'+s.max_dd,c:'#f97316'},
        {l:'Expectancy',v:(s.expectancy>=0?'+':'')+'$'+s.expectancy,c:s.expectancy>=0?'#22c55e':'#ef4444'},
        {l:'Avg Hold',v:s.avg_days+'d',c:'var(--muted)'},
      ].map(x=>`<div style="background:var(--surface);border:1px solid var(--border);border-radius:5px;padding:8px">
        <div style="font-size:9px;color:var(--muted)">${x.l}</div>
        <div style="font-size:14px;font-weight:800;color:${x.c}">${x.v}</div>
      </div>`).join('')}
    </div>`;

  // Equity curve
  _btDrawEquity(d.equity_curve);

  // Trade log
  const cnt=document.getElementById('bt-trade-count');
  if(cnt) cnt.textContent=`(${d.trades.length} trades)`;
  const tbl=document.getElementById('bt-trade-table');
  if(tbl) tbl.innerHTML=`<thead><tr>
    <th>Entry</th><th>Exit</th><th>Spot@Entry</th><th>Short K</th><th>Long K</th>
    <th>Credit</th><th>Width</th><th>IV</th><th>RSI-EMA</th><th>P&L</th><th>Reason</th><th>Days</th>
  </tr></thead><tbody>${d.trades.map(t=>{
    const c=t.winner?'#22c55e':'#ef4444';
    return `<tr style="background:${t.winner?'rgba(34,197,94,.04)':'rgba(239,68,68,.04)'}">
      <td>${t.entry_date}</td><td>${t.exit_date}</td><td>$${t.entry_spot}</td>
      <td>$${t.short_k}</td><td>$${t.long_k}</td>
      <td style="color:#22c55e">$${t.net_credit}</td>
      <td>$${t.width}</td>
      <td>${(t.iv*100).toFixed(0)}%</td>
      <td style="color:${Math.abs(t.rsi_diff)>=15?'#ef4444':'#94a3b8'}">${t.rsi_diff>0?'+':''}${t.rsi_diff}</td>
      <td style="color:${c};font-weight:700">${t.final_pnl>=0?'+':''}$${t.final_pnl}</td>
      <td style="color:${c};font-size:10px">${t.exit_reason}</td>
      <td>${t.days_held}d</td>
    </tr>`;
  }).join('')}</tbody>`;
}

function _btDrawEquity(curve) {
  if(!curve?.length) return;
  const canvas=document.getElementById('bt-equity-chart');
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  const W=canvas.offsetWidth||800; const H=canvas.offsetHeight||200;
  canvas.width=W; canvas.height=H;
  ctx.clearRect(0,0,W,H);
  const vals=curve.map(p=>p.equity);
  const maxV=Math.max(...vals,0)*1.05; const minV=Math.min(...vals,0)*1.05;
  const range=maxV-minV||1;
  const toX=(i)=>Math.round(i/(curve.length-1)*(W-40)+20);
  const toY=(v)=>Math.round((maxV-v)/range*(H-30)+15);
  // Zero line
  ctx.strokeStyle='rgba(255,255,255,.2)'; ctx.lineWidth=1; ctx.setLineDash([3,3]);
  const y0=toY(0); ctx.beginPath(); ctx.moveTo(0,y0); ctx.lineTo(W,y0); ctx.stroke(); ctx.setLineDash([]);
  // Fill
  const grad=ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,'rgba(34,197,94,.2)'); grad.addColorStop(1,'rgba(34,197,94,.02)');
  ctx.fillStyle=grad;
  ctx.beginPath(); ctx.moveTo(toX(0),H);
  curve.forEach((p,i)=>ctx.lineTo(toX(i),toY(p.equity)));
  ctx.lineTo(toX(curve.length-1),H); ctx.closePath(); ctx.fill();
  // Line
  ctx.strokeStyle='#22c55e'; ctx.lineWidth=2;
  ctx.beginPath();
  curve.forEach((p,i)=>i===0?ctx.moveTo(toX(i),toY(p.equity)):ctx.lineTo(toX(i),toY(p.equity)));
  ctx.stroke();
  // Trade dots
  curve.forEach((p,i)=>{
    const c=p.trade_pnl>0?'#22c55e':'#ef4444';
    ctx.fillStyle=c; ctx.beginPath(); ctx.arc(toX(i),toY(p.equity),3,0,Math.PI*2); ctx.fill();
  });
  // Labels
  ctx.fillStyle='rgba(255,255,255,.5)'; ctx.font='9px monospace';
  [0,Math.floor(curve.length/2),curve.length-1].forEach(i=>{
    if(curve[i]) ctx.fillText(curve[i].date.slice(5),toX(i)-18,H-2);
  });
  ctx.textAlign='right'; ctx.fillStyle='#22c55e';
  ctx.fillText('$'+vals[vals.length-1].toFixed(0),W-2,15);
  ctx.textAlign='left';
}


// OI BUILDUP / COVERING ANALYSIS (Dashboard)

async function _loadOiBuildup() {
  const sym = document.getElementById('symbol-input')?.value || 'SPY';
  const exp = document.getElementById('expiration-select')?.value || '';
  const sigEl = document.getElementById('oi-buildup-signal');
  const moversEl = document.getElementById('oi-top-movers');
  if (sigEl) sigEl.innerHTML = '⏳ Loading Schwab real futures OI…';

  try {
    // Use Schwab real OI only. Do not call the legacy yfinance volume-proxy fetch here.
    const d = await api(`/api/futures/analysis?symbol=${sym}`).catch(()=>({contracts:[], source:'none'}));
    const chart = await api(`/api/futures/chart_data?symbol=${sym}`).catch(()=>({contracts:[], oi_series:{}, source:'none'}));
    const frontCt = (chart.front || (chart.contracts || [])[0] || '').toString();
    const futData = {data: ((chart.oi_series || {})[frontCt] || []).map(r => ({
      date: r.date, close: r.close || 0, volume: r.volume || 0, oi: r.oi || 0, oi_change: r.oi_change || 0
    }))};

    // Get options OI for selected expiry
    let optOiSeries = [];
    if (exp) {
      const optOi = await api(`/api/futures_oi?symbol=${sym}&expiry=${exp}`).catch(()=>({series:[]}));
      optOiSeries = optOi.series || [];
    }

    const sigColors = {LONG_BUILDUP:'#22c55e',SHORT_BUILDUP:'#ef4444',LONG_UNWINDING:'#f59e0b',SHORT_COVERING:'#3b82f6',NET_LONG_BUILDUP:'#22c55e',NET_LONG_UNWINDING:'#ef4444',ROLL:'#f59e0b',NEUTRAL:'#64748b',NO_DATA:'#64748b',FIRST_FETCH:'#818cf8'};
    const sigC = sigColors[d.signal] || '#64748b';
    
    // Build daily change table for front month
    const fData = futData.data || [];
    let changeRows = '';
    if (fData.length >= 2) {
      const recent = fData.slice(-5).reverse();
      changeRows = recent.map((day, i) => {
        const prev = i < recent.length-1 ? recent[i+1] : day;
        const oiChg = (day.oi||day.volume) - (prev.oi||prev.volume);
        const pChg = day.close - prev.close;
        const useOi = day.oi > 0;
        const oiC = oiChg >= 0 ? '#22c55e' : '#ef4444';
        const pC = pChg >= 0 ? '#22c55e' : '#ef4444';
        let daySig = 'Neutral';
        if(oiChg>0&&pChg>0) daySig='Long Buildup';
        else if(oiChg>0&&pChg<0) daySig='Short Buildup';
        else if(oiChg<0&&pChg>0) daySig='Short Covering';
        else if(oiChg<0&&pChg<0) daySig='Long Unwinding';
        const dSigC = {
          'Long Buildup':'#22c55e','Short Buildup':'#ef4444',
          'Short Covering':'#3b82f6','Long Unwinding':'#f59e0b','Neutral':'#64748b'
        }[daySig];
        return `<tr style="border-bottom:1px solid var(--border)">
          <td style="font-size:10px">${day.date?.slice(5)||''}</td>
          <td style="text-align:right">$${day.close?.toFixed(2)||'—'}</td>
          <td style="text-align:right;color:${pC}">${pChg>=0?'+':''}${pChg.toFixed(2)}</td>
          <td style="text-align:right">${(useOi?day.oi:day.volume)?.toLocaleString()||'—'}</td>
          <td style="text-align:right;color:${oiC};font-weight:700">${oiChg>=0?'+':''}${oiChg.toLocaleString()}</td>
          <td style="color:${dSigC};font-weight:700;font-size:10px">${daySig}</td></tr>`;
      }).join('');
    }

    if (sigEl) sigEl.innerHTML = `
      <!-- All contracts OI summary -->
      <div style="margin-bottom:10px">
        <div style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">
          Futures OI — ${sym} · ${d.source === 'schwab' && (d.total_oi||0) > 0 ? '✅ Schwab Real OI' : '⚠ No real Schwab OI'}
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:6px;margin-bottom:8px">
          ${(d.contracts||[]).map(c => {
            const chgC = (c.oi_change||0) > 0 ? '#22c55e' : (c.oi_change||0) < 0 ? '#ef4444' : 'var(--muted)';
            const chgTxt = c.oi_change ? ((c.oi_change>0?'+':'')+c.oi_change.toLocaleString()) : '—';
            return '<div style="background:var(--card2);border:1px solid var(--border2);border-radius:5px;padding:7px 10px">'
              + '<div style="font-size:10px;font-weight:700;color:var(--accent)">' + c.contract + '</div>'
              + '<div style="font-size:13px;font-weight:800;color:var(--text)">' + (c.oi||0).toLocaleString() + '</div>'
              + '<div style="font-size:10px;color:var(--muted)">OI Δ <b style="color:' + chgC + '">' + chgTxt + '</b></div>'
              + (c.price ? '<div style="font-size:10px;color:var(--muted)">$' + c.price + '</div>' : '')
              + (c.date ? '<div style="font-size:9px;color:var(--dim)">' + c.date + '</div>' : '')
              + '</div>';
          }).join('')}
          <!-- Total across all contracts -->
          <div style="background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.3);border-radius:5px;padding:7px 10px">
            <div style="font-size:10px;font-weight:700;color:#818cf8">TOTAL (3 contracts)</div>
            <div style="font-size:15px;font-weight:900;color:#818cf8">${(d.total_oi||0).toLocaleString()}</div>
            <div style="font-size:10px;color:var(--muted)">${d.description||''}</div>
          </div>
        </div>
      </div>
      ${changeRows ? `<div style="margin-top:8px"><table style="width:100%;min-width:1180px;border-collapse:collapse;font-size:11px">
        <thead><tr style="color:var(--muted)"><th style="text-align:left">Date</th><th>Price</th><th>Chg</th><th>OI</th><th>Δ OI</th><th>Signal</th></tr></thead>
        <tbody>${changeRows}</tbody></table></div>` : ''}`;

    // Draw chart — if no futures data, use options OI as primary series
    let chartData = futData.data || [];
    if (!chartData.length && optOiSeries.length) {
      // Convert options OI series to chart-compatible format with price from TA
      chartData = optOiSeries.map(s => ({
        date: s.date,
        close: 0,   // no price in options series
        volume: s.total_oi,
        oi: 0,
        _opt: true,
      }));
    }
    _drawOiChart(chartData, optOiSeries);

    // Top movers (options OI)
    if (exp && moversEl) {
      try {
        const bld = await api(`/api/oi_buildup?symbol=${sym}&expiry=${exp}`);
        if (bld.top_movers?.length) {
          moversEl.innerHTML = `<div style="font-size:10px;font-weight:700;color:var(--muted);margin-bottom:4px">OPTIONS OI MOVERS (${bld.dates?.today||''})</div>
            <table style="width:100%;border-collapse:collapse;font-size:10px"><thead>
            <tr style="color:var(--muted)"><th>Strike</th><th>Type</th><th>Chg</th><th>%</th></tr></thead><tbody>` +
            bld.top_movers.slice(0,12).map(m => {
              const chgC = m.change > 0 ? '#22c55e' : '#ef4444';
              return `<tr style="border-bottom:1px solid var(--border)"><td style="font-weight:700">$${m.strike}</td>
                <td style="color:${m.type==='call'?'#22c55e':'#ef4444'}">${m.type[0].toUpperCase()}</td>
                <td style="color:${chgC};font-weight:700">${m.change>0?'+':''}${m.change.toLocaleString()}</td>
                <td style="color:${chgC}">${m.change_pct}%</td></tr>`;
            }).join('') + '</tbody></table>';
        }
      } catch {}
    }
  } catch (e) {
    if (sigEl) sigEl.innerHTML = `❌ ${e.message}`;
  }
}

function _drawOiChart(futSeries, optSeries) {
  const cv = document.getElementById('oi-buildup-chart');
  if (!cv) return;
  const ctx = cv.getContext('2d');
  const W = cv.offsetWidth || 500; const H = cv.height || 220;
  cv.width = W; ctx.clearRect(0, 0, W, H);
  const PAD = {t:22, r:58, b:26, l:58};
  const cW = W - PAD.l - PAD.r, cH = H - PAD.t - PAD.b;

  const series = futSeries.length ? futSeries : [];
  const hasOi = series.some(s => s.oi > 0);
  const oiArr = series.map(s => hasOi ? s.oi : s.volume);
  const priceArr = series.map(s => s.close);
  
  if (!series.length && !optSeries?.length) {
    ctx.fillStyle='rgba(255,255,255,.3)'; ctx.font='12px sans-serif'; ctx.textAlign='center';
    ctx.fillText('No data — run Scheduler to fetch OI', W/2, H/2); return;
  }
  // If series are synthetic from options, show as options OI bars
  if (series.length && series[0]?._opt) {
    // Draw options OI as bar chart with change colors
    const maxOi = Math.max(...series.map(s=>s.volume))*1.1||1;
    const minOi = Math.min(...series.map(s=>s.volume))*0.9||0;
    const toX = i => PAD.l + i/Math.max(1,series.length-1)*cW;
    const toY = v => PAD.t+cH-(v-minOi)/(maxOi-minOi||1)*cH;
    const barW = Math.max(3, cW/series.length*0.6);
    series.forEach((s,i)=>{
      const v=s.volume; const prev=i>0?series[i-1].volume:v;
      ctx.fillStyle=v>=prev?'rgba(99,102,241,.55)':'rgba(239,68,68,.45)';
      const h=(v-minOi)/(maxOi-minOi||1)*cH;
      ctx.fillRect(toX(i)-barW/2, PAD.t+cH-h, barW, h);
    });
    // Y axis
    ctx.fillStyle='rgba(255,255,255,.4)';ctx.font='9px monospace';ctx.textAlign='right';
    for(let i=0;i<=3;i++){const v=minOi+(maxOi-minOi)*(3-i)/3;
      ctx.fillText(v>1000?(v/1000).toFixed(0)+'K':v.toFixed(0), PAD.l-4, PAD.t+i*cH/3+3);}
    ctx.fillStyle='rgba(255,255,255,.3)';ctx.font='9px sans-serif';ctx.textAlign='center';
    ctx.fillText('Options OI (no Schwab futures OI yet)', W/2, 12);
    // X dates
    ctx.textAlign='center';
    const step=Math.max(1,Math.floor(series.length/6));
    for(let i=0;i<series.length;i+=step)
      ctx.fillText(series[i].date?.slice(5)||'',toX(i),H-4);
    window._oiChartPts = series.map((s,i)=>({x:toX(i),y:toY(s.volume),idx:i}));
    return;
  }

  // Store coords for hover
  window._oiChartData = {series, oiArr, priceArr, optSeries, hasOi, PAD, cW, cH, W, H};
  const pts = [];

  if (series.length) {
    const maxOi = Math.max(...oiArr)*1.1||1, minOi = Math.min(...oiArr)*0.9||0;
    const maxP = Math.max(...priceArr)*1.005, minP = Math.min(...priceArr)*0.995;
    const toX = i => PAD.l + i/Math.max(1,series.length-1)*cW;
    const toOiY = v => PAD.t+cH-(v-minOi)/(maxOi-minOi||1)*cH;
    const toPY = v => PAD.t+cH-(v-minP)/(maxP-minP||1)*cH;
    const barW = Math.max(3, cW/series.length*0.55);

    window._oiChartData.maxOi=maxOi; window._oiChartData.minOi=minOi;
    window._oiChartData.maxP=maxP; window._oiChartData.minP=minP;
    window._oiChartData.toX=toX; window._oiChartData.toPY=toPY;

    // OI bars
    series.forEach((s,i)=>{
      const v=hasOi?s.oi:s.volume; const prev=i>0?(hasOi?series[i-1].oi:series[i-1].volume):v;
      ctx.fillStyle=v>=prev?'rgba(34,197,94,.45)':'rgba(239,68,68,.45)';
      const h=(v-minOi)/(maxOi-minOi||1)*cH;
      ctx.fillRect(toX(i)-barW/2, PAD.t+cH-h, barW, h);
      pts.push({x:toX(i), y:toPY(priceArr[i]), idx:i});
    });

    // Price line
    ctx.strokeStyle='#60a5fa'; ctx.lineWidth=2.5; ctx.beginPath();
    priceArr.forEach((v,i)=>i===0?ctx.moveTo(toX(i),toPY(v)):ctx.lineTo(toX(i),toPY(v)));
    ctx.stroke();

    // Signal dots
    for(let i=1;i<series.length;i++){
      const oiChg=oiArr[i]-oiArr[i-1], pChg=priceArr[i]-priceArr[i-1];
      let c='#64748b', sig='Neutral';
      if(oiChg>0&&pChg>0){c='#22c55e';sig='Long Buildup';}
      else if(oiChg>0&&pChg<0){c='#ef4444';sig='Short Buildup';}
      else if(oiChg<0&&pChg>0){c='#3b82f6';sig='Short Covering';}
      else if(oiChg<0&&pChg<0){c='#f59e0b';sig='Long Unwinding';}
      ctx.fillStyle=c; ctx.beginPath(); ctx.arc(toX(i),toPY(priceArr[i]),4,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle='rgba(0,0,0,.3)'; ctx.lineWidth=1; ctx.stroke();
      if(pts[i]) pts[i].sig=sig; pts[i].sigColor=c;
    }

    // Y-axis labels
    ctx.fillStyle='rgba(255,255,255,.45)'; ctx.font='10px monospace'; ctx.textAlign='right';
    for(let i=0;i<=4;i++){const v=minOi+(maxOi-minOi)*(4-i)/4;
      ctx.fillText(v>1000?(v/1000).toFixed(0)+'K':v.toFixed(0), PAD.l-4, PAD.t+i*cH/4+4);}
    ctx.textAlign='left'; ctx.fillStyle='#60a5fa'; ctx.font='10px monospace';
    for(let i=0;i<=4;i++){const v=minP+(maxP-minP)*(4-i)/4;
      ctx.fillText('$'+v.toFixed(0), W-PAD.r+4, PAD.t+i*cH/4+4);}

    // X dates
    ctx.fillStyle='rgba(255,255,255,.4)'; ctx.textAlign='center'; ctx.font='10px monospace';
    const dateStep=Math.max(1,Math.floor(series.length/6));
    for(let i=0;i<series.length;i+=dateStep)
      if(series[i]) ctx.fillText(series[i].date?.slice(5)||'',toX(i),H-4);

    // Axis labels
    ctx.save(); ctx.fillStyle='rgba(255,255,255,.3)'; ctx.font='9px sans-serif';
    ctx.translate(12,PAD.t+cH/2); ctx.rotate(-Math.PI/2); ctx.textAlign='center';
    ctx.fillText(hasOi?'Futures OI':'Futures Volume',0,0); ctx.restore();
    ctx.save(); ctx.fillStyle='#60a5fa'; ctx.font='9px sans-serif';
    ctx.translate(W-8,PAD.t+cH/2); ctx.rotate(-Math.PI/2); ctx.textAlign='center';
    ctx.fillText('Price ($)',0,0); ctx.restore();
  }

  // Options OI overlay (purple dashed)
  if (optSeries?.length > 1) {
    const maxOptOi = Math.max(...optSeries.map(s=>s.total_oi))*1.1||1;
    ctx.strokeStyle='#a78bfa'; ctx.lineWidth=2; ctx.setLineDash([5,4]);
    ctx.beginPath();
    optSeries.forEach((s,i)=>{
      const x = PAD.l + i/Math.max(1,optSeries.length-1)*cW;
      const y = PAD.t+cH-s.total_oi/maxOptOi*cH;
      i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
    });
    ctx.stroke(); ctx.setLineDash([]);
  }

  // Legend
  ctx.font='10px sans-serif'; ctx.textAlign='left';
  const leg=[{c:'#22c55e',t:'Long Build'},{c:'#ef4444',t:'Short Build'},{c:'#3b82f6',t:'Short Cover'},{c:'#f59e0b',t:'Long Unwind'},{c:'#60a5fa',t:'Price',line:true},{c:'#a78bfa',t:'Opt OI',dash:true}];
  leg.forEach((l,i)=>{
    const lx=PAD.l+i*80;
    if(l.line){ctx.strokeStyle=l.c;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(lx,10);ctx.lineTo(lx+14,10);ctx.stroke();}
    else if(l.dash){ctx.strokeStyle=l.c;ctx.lineWidth=2;ctx.setLineDash([3,2]);ctx.beginPath();ctx.moveTo(lx,10);ctx.lineTo(lx+14,10);ctx.stroke();ctx.setLineDash([]);}
    else{ctx.fillStyle=l.c;ctx.beginPath();ctx.arc(lx+6,10,4,0,Math.PI*2);ctx.fill();}
    ctx.fillStyle='rgba(255,255,255,.55)';ctx.fillText(l.t,lx+18,13);
  });

  // Store pts for hover
  window._oiChartPts = pts;

  // Hover tooltip (wire once)
  if (!cv.dataset.hoverWired) {
    cv.dataset.hoverWired = '1';
    const tip = document.createElement('div');
    tip.id = 'oi-chart-tip';
    tip.style.cssText = 'display:none;position:fixed;background:#1e293b;border:1px solid #334155;border-radius:6px;padding:8px 12px;font-size:11px;pointer-events:none;z-index:9999;box-shadow:0 4px 12px rgba(0,0,0,.4);max-width:220px';
    document.body.appendChild(tip);

    cv.addEventListener('mousemove', e => {
      const rect = cv.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const pts2 = window._oiChartPts || [];
      const cd = window._oiChartData || {};
      if (!pts2.length) return;
      // Find nearest point
      let nearest = null, minDist = Infinity;
      pts2.forEach(p => { const d = Math.abs(p.x - mx); if (d < minDist) { minDist = d; nearest = p; }});
      if (!nearest || minDist > 30) { tip.style.display = 'none'; return; }
      const s = cd.series[nearest.idx];
      const oiVal = cd.hasOi ? s.oi : s.volume;
      const prevOi = nearest.idx > 0 ? (cd.hasOi ? cd.series[nearest.idx-1].oi : cd.series[nearest.idx-1].volume) : oiVal;
      const oiChg = oiVal - prevOi;
      const optS = cd.optSeries?.[nearest.idx];
      tip.innerHTML = `<div style="font-weight:700;color:var(--accent);margin-bottom:4px">${s.date||''}</div>
        <div>Price: <b style="color:#60a5fa">$${s.close?.toFixed(2)||'—'}</b></div>
        <div>${cd.hasOi?'OI':'Volume'}: <b>${oiVal?.toLocaleString()||'—'}</b> <span style="color:${oiChg>=0?'#22c55e':'#ef4444'}">(${oiChg>=0?'+':''}${oiChg?.toLocaleString()})</span></div>
        ${optS?`<div>Opt OI: <b style="color:#a78bfa">${optS.total_oi?.toLocaleString()||'—'}</b> P/C: ${optS.pc_ratio||'—'}</div>`:''}
        ${nearest.sig?`<div style="color:${nearest.sigColor||'#64748b'};font-weight:700;margin-top:3px">${nearest.sig}</div>`:''}`;
      tip.style.display = '';
      tip.style.left = (e.clientX + 14) + 'px';
      tip.style.top = (e.clientY - 10) + 'px';
    });
    cv.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
  }
}


// CUMULATIVE OI (Aggregate)

function _aggFuturesProxySymbol(raw) {
  const txt = String(raw || '').trim().toUpperCase();
  if (!txt) return 'SPY';
  const rootMap = { ES:'SPY', NQ:'QQQ', RTY:'IWM', GC:'GLD', CL:'USO', ZB:'TLT', YM:'DIA' };
  const parts = txt.replace(/\//g, ' /').replace(/[-–—]/g, ' ').split(/\s+/).filter(Boolean);
  for (const part of parts) {
    const clean = part.replace('/', '');
    if (rootMap[clean]) return rootMap[clean];
    if (['SPY','QQQ','IWM','GLD','USO','TLT','DIA'].includes(clean)) return clean;
  }
  return parts[0]?.replace('/', '') || 'SPY';
}

async function _loadCumulativeOi() {
  const rawSym = document.getElementById('agg-symbol')?.value || document.getElementById('symbol-input')?.value || 'SPY';
  const sym = _aggFuturesProxySymbol(rawSym);
  const sumEl = document.getElementById('agg-cum-oi-summary');
  const tblEl = document.getElementById('agg-cum-oi-table');
  if (sumEl) sumEl.innerHTML = '⏳ Loading Schwab futures OI for ' + sym + '…';

  try {
    // Use the same Schwab-only endpoint as the Dashboard, then adapt it for
    // the Aggregate chart. This prevents Dashboard showing data while
    // Aggregate says no futures OI.
    const d = await api(`/api/futures/chart_data?symbol=${encodeURIComponent(sym)}`);
    const series = d.oi_series || {};
    const contracts = (d.contracts || []).map(ct => ({
      contract: ct,
      source: d.source || 'schwab',
      data: series[ct] || []
    })).filter(c => (c.data || []).some(r => (r.oi || 0) > 0));

    if (!contracts.length) {
      const msg = d.interpretation || 'No Schwab futures OI data — connect Schwab and run Scheduler → Fetch OI Now.';
      if (sumEl) sumEl.innerHTML = `<span style="color:var(--muted)">${msg}</span>`;
      if (tblEl) tblEl.innerHTML = '';
      _drawMultiExpiryOiChart([]);
      return;
    }

    // Summary cards per contract
    const colors = ['#3b82f6','#a855f7','#f59e0b'];
    if (sumEl) sumEl.innerHTML = contracts.map((c, i) => {
      const data = c.data || [];
      const last = data.length ? data[data.length-1] : {};
      const prev = data.length >= 2 ? data[data.length-2] : last;
      const val = last.oi || 0;
      const prevVal = prev.oi || val;
      const chg = (val||0) - (prevVal||0);
      const chgC = chg >= 0 ? '#22c55e' : '#ef4444';
      return `<div style="display:inline-flex;align-items:center;gap:8px;padding:8px 14px;background:${colors[i]}15;border:1px solid ${colors[i]}44;border-radius:6px;margin:2px 4px 2px 0">
        <div><div style="font-size:9px;color:var(--muted)">Contract</div>
          <div style="font-size:14px;font-weight:900;color:${colors[i]}">${c.contract}</div>
          <div style="font-size:9px;color:var(--muted)">${c.expiry_approx?.slice(0,7)||''}</div></div>
        <div style="font-size:11px">OI: <b>${(val||0).toLocaleString()}</b>
          <span style="color:${chgC};font-weight:700"> (${chg>=0?'+':''}${chg.toLocaleString()})</span><br>
          Settle: <b>$${last.close?.toFixed(2)||'—'}</b>
          <span style="color:var(--muted);font-size:10px">${data.length}d history</span></div>
      </div>`;
    }).join('');

    // Multi-contract chart
    _drawMultiExpiryOiChart(contracts.map((c,i) => ({
      expiry: c.contract,
      series: (c.data||[]).map(d => ({date: d.date, total_oi: d.oi || 0}))
    })));

    // Daily change table
    if (tblEl) {
      // Merge all dates
      const allDates = [...new Set(contracts.flatMap(c => (c.data||[]).map(d => d.date)))].sort().reverse().slice(0, 15);
      tblEl.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:10px"><thead>
        <tr style="color:var(--muted)"><th style="text-align:left">Date</th>` +
        contracts.map((c,i) => `<th style="color:${colors[i]}">${c.contract}</th><th>Δ</th>`).join('') +
        `</tr></thead><tbody>` +
        allDates.map(dt => {
          return '<tr style="border-bottom:1px solid var(--border)"><td style="font-size:9px">' + dt?.slice(5) + '</td>' +
            contracts.map((c,ci) => {
              const data = c.data || [];
              const day = data.find(d => d.date === dt);
              const dayIdx = data.indexOf(day);
              if (!day) return '<td>—</td><td>—</td>';
              const val = day.oi || 0;
              const prev = dayIdx > 0 ? (data[dayIdx-1].oi || val) : val;
              const chg = val - prev;
              const chgC = chg >= 0 ? '#22c55e' : '#ef4444';
              return `<td style="text-align:right;font-weight:600">${(val||0).toLocaleString()}</td>
                <td style="text-align:right;color:${chgC};font-weight:700">${chg>=0?'+':''}${chg.toLocaleString()}</td>`;
            }).join('') + '</tr>';
        }).join('') + '</tbody></table>';
    }
  } catch (e) {
    if (sumEl) sumEl.innerHTML = `❌ ${e.message}`;
  }
}

function _drawCumOiChart(strikes) { /* replaced by _drawMultiExpiryOiChart */ }

function _drawMultiExpiryOiChart(expiries) {
  const cv = document.getElementById('agg-cum-oi-chart');
  if (!cv) return;
  const ctx = cv.getContext('2d');
  const W = cv.offsetWidth || 400; const H = cv.height || 220;
  cv.width = W; ctx.clearRect(0, 0, W, H);
  if (!expiries.length) {
    ctx.fillStyle = 'rgba(255,255,255,.45)';
    ctx.font = '12px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('No Schwab futures OI data yet', W / 2, H / 2);
    return;
  }
  const PAD = {t:20, r:12, b:24, l:55};
  const cW = W - PAD.l - PAD.r, cH = H - PAD.t - PAD.b;

  // Collect all dates and OI values
  const allDates = [...new Set(expiries.flatMap(e => (e.series||[]).map(s => s.date)))].sort();
  if (!allDates.length) return;
  const colors = ['#3b82f6','#a855f7','#f59e0b'];
  let maxOi = 0;
  expiries.forEach(e => (e.series||[]).forEach(s => { if (s.total_oi > maxOi) maxOi = s.total_oi; }));
  maxOi *= 1.1 || 1;

  const toX = i => PAD.l + i / Math.max(1, allDates.length - 1) * cW;
  const toY = v => PAD.t + cH - v / maxOi * cH;

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,.05)'; ctx.lineWidth = 1;
  for (let i = 1; i < 4; i++) {
    const y = PAD.t + i * cH / 4;
    ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(W - PAD.r, y); ctx.stroke();
  }

  // Lines per expiry
  expiries.forEach((exp, ei) => {
    const series = exp.series || [];
    const dateMap = {}; series.forEach(s => dateMap[s.date] = s.total_oi);
    ctx.strokeStyle = colors[ei] || '#64748b';
    ctx.lineWidth = 2;
    ctx.beginPath();
    let started = false;
    allDates.forEach((d, i) => {
      if (dateMap[d] !== undefined) {
        if (!started) { ctx.moveTo(toX(i), toY(dateMap[d])); started = true; }
        else ctx.lineTo(toX(i), toY(dateMap[d]));
      }
    });
    ctx.stroke();
    // Dots
    ctx.fillStyle = colors[ei];
    allDates.forEach((d, i) => {
      if (dateMap[d] !== undefined) {
        ctx.beginPath(); ctx.arc(toX(i), toY(dateMap[d]), 3, 0, Math.PI * 2); ctx.fill();
      }
    });
  });

  // Y-axis
  ctx.fillStyle = 'rgba(255,255,255,.4)'; ctx.font = '9px monospace'; ctx.textAlign = 'right';
  for (let i = 0; i <= 4; i++) {
    const v = maxOi * (4 - i) / 4;
    ctx.fillText(v > 1000 ? (v/1000).toFixed(0) + 'K' : v.toFixed(0), PAD.l - 4, PAD.t + i * cH / 4 + 3);
  }
  // X dates
  ctx.fillStyle = 'rgba(255,255,255,.35)'; ctx.textAlign = 'center';
  const step = Math.max(1, Math.floor(allDates.length / 6));
  for (let i = 0; i < allDates.length; i += step)
    ctx.fillText(allDates[i]?.slice(5) || '', toX(i), H - 2);

  // Legend
  ctx.font = '9px sans-serif'; ctx.textAlign = 'left';
  expiries.forEach((e, i) => {
    ctx.fillStyle = colors[i]; ctx.fillRect(PAD.l + i * 100, 4, 14, 8);
    ctx.fillStyle = 'rgba(255,255,255,.5)'; ctx.fillText(e.expiry?.slice(5) || '?', PAD.l + i * 100 + 16, 12);
  });
}


// OI HEATMAP SCANNER

let _oiHmData = [];

async function _loadOiHeatmap() {
  const stEl = document.getElementById('oi-heatmap-status');
  const resEl = document.getElementById('oi-heatmap-result');
  if (stEl) stEl.innerHTML = '⏳ Scanning OI across all symbols…';
  if (resEl) resEl.innerHTML = '';
  try {
    const d = await api('/api/oi_heatmap_scanner');
    _oiHmData = d.results || [];
    if (stEl) stEl.innerHTML = `✅ ${_oiHmData.length} symbols scanned`;
    _filterOiHeatmap();
  } catch (e) {
    if (stEl) stEl.innerHTML = `❌ ${e.message}`;
  }
}

function _filterOiHeatmap() {
  const filter = document.getElementById('oi-hm-filter')?.value || 'ALL';
  const resEl = document.getElementById('oi-heatmap-result');
  if (!resEl) return;

  let data = _oiHmData;
  if (filter !== 'ALL') data = data.filter(r => r.signal === filter);

  const sigColors = {LONG_BUILDUP:'#22c55e', SHORT_BUILDUP:'#ef4444', LONG_UNWINDING:'#f59e0b', SHORT_COVERING:'#3b82f6', NEUTRAL:'#64748b'};

  resEl.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:11px">
    <thead><tr style="color:var(--muted)">
      <th style="text-align:left;padding:4px">Symbol</th>
      <th>Signal</th><th>Spot</th><th>Price Chg</th>
      <th>Total OI</th><th>OI Chg</th><th>OI %</th>
      <th>Call OI</th><th>Put OI</th><th>P/C</th><th>Expiry</th>
    </tr></thead><tbody>` +
    data.map(r => {
      const sigC = sigColors[r.signal] || '#64748b';
      const pChgC = r.price_change >= 0 ? '#22c55e' : '#ef4444';
      const oiChgC = r.oi_change >= 0 ? '#22c55e' : '#ef4444';
      const pcC = r.pc_ratio > 1 ? '#ef4444' : r.pc_ratio < 0.7 ? '#22c55e' : '#f59e0b';
      return `<tr style="border-bottom:1px solid var(--border)">
        <td style="font-weight:800;color:var(--accent);padding:4px">${r.symbol}</td>
        <td style="text-align:center"><span style="background:${sigC}22;color:${sigC};padding:2px 8px;border-radius:4px;font-weight:700;font-size:10px;white-space:nowrap">${r.signal?.replace(/_/g,' ')}</span></td>
        <td style="text-align:right">$${r.spot?.toFixed(2)||'—'}</td>
        <td style="text-align:right;color:${pChgC};font-weight:700">${r.price_change>=0?'+':''}${r.price_change?.toFixed(2)||'—'}</td>
        <td style="text-align:right;font-weight:600">${(r.total_oi||0).toLocaleString()}</td>
        <td style="text-align:right;color:${oiChgC};font-weight:700">${r.oi_change>=0?'+':''}${(r.oi_change||0).toLocaleString()}</td>
        <td style="text-align:right;color:${oiChgC}">${r.oi_change_pct||0}%</td>
        <td style="text-align:right;color:#22c55e">${(r.call_oi||0).toLocaleString()}</td>
        <td style="text-align:right;color:#ef4444">${(r.put_oi||0).toLocaleString()}</td>
        <td style="text-align:right;color:${pcC};font-weight:700">${r.pc_ratio||'—'}</td>
        <td style="font-size:10px;color:var(--muted)">${r.expiry||''}</td>
      </tr>`;
    }).join('') + '</tbody></table>';
}



// TRADE ANALYSIS — IV RANK / PERCENTILE

async function _taFetchIVRank(sym) {
  const el = document.getElementById('ta-iv-panel');
  if (!el) return;
  el.style.display = '';
  el.innerHTML = '<div style="padding:6px 0;font-size:11px;color:var(--muted)">⏳ Loading IV Rank…</div>';
  try {
    const d = await api(`/api/iv_rank/${sym}`);
    _taRenderIVPanel(el, d);
  } catch(e) {
    el.innerHTML = `<div style="font-size:11px;color:var(--muted)">IV Rank unavailable: ${e.message}</div>`;
  }
}

function _taRenderIVPanel(el, d) {
  const regC = d.regime==='HIGH' ? '#ef4444' : d.regime==='LOW' ? '#22c55e' : '#f59e0b';
  const recC = d.recommendation==='SELL PREMIUM' ? '#a855f7' : d.recommendation==='BUY OPTIONS' ? '#3b82f6' : '#f59e0b';
  const trendArrow = d.iv_trend==='RISING' ? '↑' : d.iv_trend==='FALLING' ? '↓' : '→';
  const trendC = d.iv_trend==='RISING' ? '#ef4444' : d.iv_trend==='FALLING' ? '#22c55e' : '#94a3b8';

  // IV Rank bar
  const rankPct = d.iv_rank || 0;
  const pctPct  = d.iv_percentile || 0;
  const barC = rankPct >= 70 ? '#ef4444' : rankPct >= 40 ? '#f59e0b' : '#22c55e';

  // Preferred strategies as tags
  const strats = (d.preferred_strategies || []).slice(0,4).map(s =>
    `<span style="font-size:10px;padding:2px 8px;border-radius:3px;background:${recC}18;color:${recC};border:1px solid ${recC}33">${s}</span>`
  ).join('');

  el.innerHTML = `
    <div style="background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:10px 14px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px">

        <!-- Left: regime badge + meters -->
        <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">
          <div style="text-align:center">
            <div style="font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px">IV Regime</div>
            <div style="font-size:18px;font-weight:900;color:${regC}">${d.regime}</div>
            <div style="font-size:10px;font-weight:700;color:${recC}">${d.recommendation}</div>
          </div>

          <!-- IV Rank meter -->
          <div style="min-width:140px">
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-bottom:3px">
              <span>IV Rank</span><b style="color:${barC}">${rankPct}%</b>
            </div>
            <div style="height:6px;background:var(--border2);border-radius:3px;overflow:hidden">
              <div style="width:${rankPct}%;height:100%;background:${barC};border-radius:3px;transition:width .3s"></div>
            </div>
            <div style="font-size:9px;color:var(--muted);margin-top:2px">Low: ${d.hv_low}% · High: ${d.hv_high}%</div>
          </div>

          <!-- IV Percentile meter -->
          <div style="min-width:140px">
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-bottom:3px">
              <span>IV Percentile</span><b style="color:${barC}">${pctPct}%</b>
            </div>
            <div style="height:6px;background:var(--border2);border-radius:3px;overflow:hidden">
              <div style="width:${pctPct}%;height:100%;background:${barC}aa;border-radius:3px;transition:width .3s"></div>
            </div>
            <div style="font-size:9px;color:var(--muted);margin-top:2px">Days below current: ${pctPct}% of past year</div>
          </div>

          <!-- HV term structure -->
          <div>
            <div style="font-size:9px;color:var(--muted);margin-bottom:3px;text-transform:uppercase;letter-spacing:.5px">HV Term Structure <span style="color:${trendC}">${trendArrow} ${d.iv_trend}</span></div>
            <div style="display:flex;gap:8px;font-size:11px;font-family:monospace">
              <span style="color:var(--muted)">5d:</span><b>${d.hv_5}%</b>
              <span style="color:var(--muted)">10d:</span><b>${d.hv_10}%</b>
              <span style="color:var(--muted)">21d:</span><b style="color:var(--accent)">${d.hv_21}%</b>
              <span style="color:var(--muted)">63d:</span><b>${d.hv_63}%</b>
            </div>
          </div>
        </div>

        <!-- Right: advice + strategies -->
        <div style="max-width:320px">
          <div style="font-size:11px;color:var(--text2);margin-bottom:6px;line-height:1.4">${d.advice}</div>
          <div style="display:flex;gap:4px;flex-wrap:wrap">${strats}</div>
        </div>

      </div>
    </div>`;
}


// OI BUILDUP SCREENER TAB

var _oibData = [];
var _oibFilterVal = 'ALL';
var _oibQualityMin = 1;
var _oibSortCol = 'flow_confidence';
var _oibSortDir = -1;
var _oibLastScan = null;  // timestamp of last scan

const _OIB_QUALITY_LABELS = {
  1: 'All',
  2: 'Watch+',
  3: 'Setup+',
  4: 'Tradable+',
  5: 'Best only'
};

function _oibQualityChange(v) {
  _oibQualityMin = Math.max(1, Math.min(5, parseInt(v || 1, 10) || 1));
  try { localStorage.setItem('oib_quality_min', String(_oibQualityMin)); } catch {}
  _oibUpdateQualityLabel();
  _oibRender();
}

function _oibUpdateQualityLabel() {
  const el = document.getElementById('oib-quality-label');
  if (el) el.textContent = _OIB_QUALITY_LABELS[_oibQualityMin] || 'All';
  const rng = document.getElementById('oib-quality-min');
  if (rng && String(rng.value) !== String(_oibQualityMin)) rng.value = String(_oibQualityMin);
}

function _oibTextHas(txt, words) {
  const s = String(txt || '').toLowerCase();
  return words.some(w => s.includes(String(w).toLowerCase()));
}

function _oibRowDirection(row) {
  const vals = [row.final_seller_read, row.bias, row.st_outlook, row.mt_outlook, row.lt_outlook, row.st_seller_bias, row.mt_seller_bias, row.lt_seller_bias].join(' ');
  const bull = (vals.match(/bullish|put selling|call unwind/gi) || []).length;
  const bear = (vals.match(/bearish|call selling|put unwind/gi) || []).length;
  if (bear > bull) return 'bearish';
  if (bull > bear) return 'bullish';
  return 'neutral';
}

function _oibComputeQuality(row) {
  if (!row || typeof row !== 'object') return {score:0, bucket:1, label:'Weak', reasons:['missing row']};
  const n = (v, d=null) => { const x = Number(v); return Number.isFinite(x) ? x : d; };
  let score = n(row.flow_confidence, n(row.confidence, 50)) || 50;
  const reasons = [];
  {
    const direction = _oibRowDirection(row);
    const action = String(row.should_buy_sell || row.trade_action || row.entry_action || '').toUpperCase();
    const uae = String(row.uae_confirmation || '').toLowerCase();
    const sectorAlign = String(row.sector_alignment || '').toLowerCase();
    const sectorRegime = String(row.sector_regime || '').toLowerCase();
    const priceBias = String(row.price_action_bias || '').toLowerCase();
    const guard = String(row.price_location_guard || '');
    const ivr = n(row.iv_rank, null);
    const strat = String(row.suggested_trade_label || row.suggested_strategy || '').toLowerCase();
    const st = String(row.st_seller_bias || row.st_outlook || '');
    const mt = String(row.mt_seller_bias || row.mt_outlook || '');
    const lt = String(row.lt_seller_bias || row.lt_outlook || '');

    if (row.earnings_conflict) { score -= 35; reasons.push('earnings conflict'); }
    if (guard) { score -= 22; reasons.push('price-location guard'); }
    if (/WAIT|AVOID|WATCH/.test(action) || /^wait/i.test(strat)) { score -= 18; reasons.push('wait/watch action'); }
    if (/SELL PREMIUM|BUY OPTIONS|SELL|BUY/.test(action) && !/WAIT|AVOID|WATCH/.test(action)) { score += 8; reasons.push('actionable implementation'); }
    if (strat && !/^wait|no strategy|n\/a/.test(strat)) { score += 5; reasons.push('strategy present'); }

    if (uae.includes('confirms')) { score += 8; reasons.push('UAE confirms'); }
    else if (uae.includes('conflict')) { score -= 12; reasons.push('UAE conflicts'); }
    else if (uae.includes('unavailable')) { score -= 4; reasons.push('UAE unavailable'); }

    if (sectorAlign.includes('confirms')) { score += 6; reasons.push('sector confirms'); }
    else if (sectorAlign.includes('conflict')) { score -= 10; reasons.push('sector conflicts'); }
    else if (sectorRegime.includes('n/a') || sectorRegime.includes('unavailable')) { score -= 3; reasons.push('sector unavailable'); }

    if (direction === 'bullish' && priceBias.includes('bull')) { score += 6; reasons.push('price confirms'); }
    else if (direction === 'bearish' && priceBias.includes('bear')) { score += 6; reasons.push('price confirms'); }
    else if ((direction === 'bullish' && priceBias.includes('bear')) || (direction === 'bearish' && priceBias.includes('bull'))) { score -= 12; reasons.push('price conflicts'); }

    if (ivr == null) { score -= 4; reasons.push('IVR unavailable'); }
    else if ((/SELL PREMIUM/.test(action) || /PS|CS|IC/.test(String(row.suggested_strategy_code||''))) && ivr >= 50) { score += 5; reasons.push('IV supports premium sale'); }
    else if (/BUY OPTIONS/.test(action) && ivr <= 35) { score += 5; reasons.push('low IV supports debit'); }

    const dirWord = direction === 'bullish' ? 'Bullish' : direction === 'bearish' ? 'Bearish' : '';
    if (dirWord && st.includes(dirWord) && mt.includes(dirWord) && lt.includes(dirWord)) { score += 8; reasons.push('ST/MT/LT aligned'); }
    else if (dirWord && (mt.includes(dirWord) || lt.includes(dirWord))) { score += 3; reasons.push('partial timeframe alignment'); }
  }
  score = Math.max(0, Math.min(100, Math.round(score)));
  let bucket = score >= 85 ? 5 : score >= 70 ? 4 : score >= 55 ? 3 : score >= 40 ? 2 : 1;
  // Hard blocks cannot be shown as tradable/best. They can still be visible at lower slider levels.
  if (row.earnings_conflict || row.price_location_guard || /WAIT|AVOID/.test(String(row.should_buy_sell || row.trade_action || row.entry_action || '').toUpperCase()) || /^wait/i.test(String(row.suggested_trade_label || ''))) {
    bucket = Math.min(bucket, 3);
  }
  const label = bucket === 5 ? 'Best' : bucket === 4 ? 'Tradable' : bucket === 3 ? 'Setup' : bucket === 2 ? 'Watch' : 'Weak';
  return {score, bucket, label, reasons};
}

function _oibQualityPass(row) {
  const q = _oibComputeQuality(row);
  row.trade_quality_score = q.score;
  row.trade_quality_bucket = q.bucket;
  row.trade_quality_label = q.label;
  row.trade_quality_reasons = q.reasons || [];
  return q.bucket >= (_oibQualityMin || 1);
}

async function _oibShowCached() {
  try { _oibQualityMin = Math.max(1, Math.min(5, parseInt(localStorage.getItem('oib_quality_min') || '1', 10) || 1)); } catch {}
  _oibUpdateQualityLabel();
  const stEl = document.getElementById('oib-status');
  const wlId = document.getElementById('oib-watchlist')?.value || '';
  if (_oibData.length) {
    const ago = _oibLastScan ? Math.round((Date.now() - _oibLastScan) / 60000) : null;
    const agoStr = ago != null ? (ago < 60 ? `${ago}m ago` : `${Math.round(ago/60)}h ago`) : '';
    if (stEl) stEl.innerHTML = `✅ ${_oibData.length} symbols${agoStr ? ` · ${agoStr}` : ''} <span style="color:var(--muted);font-size:10px">(🔄 to refresh)</span>`;
    _oibRender(); return;
  }
  // Load from DB — survives restarts
  if (stEl) stEl.innerHTML = '⏳ Loading cached scan…';
  try {
    const d = await api('/api/oi_buildup_cached' + (wlId ? '?watchlist_id='+wlId : ''));
    if (d.results?.length) {
      _oibData = d.results;
      _oibLastScan = d.date;
      // Enrich with sectors (fast, from sector_cache)
      try {
        const secs = await api('/api/scanner/sectors').catch(()=>({}));
        _oibData.forEach(r => { if (!r.sector) r.sector = secs[r.symbol] || ''; });
      } catch {}
      if (stEl) stEl.innerHTML = `✅ ${_oibData.length} symbols · ${d.date||'cached'} <span style="color:var(--muted);font-size:10px">(🔄 to refresh)</span>`;
      _oibRender(); return;
    }
  } catch {}
  if (stEl) stEl.innerHTML = '<span style="color:var(--muted)">No data yet — click 🔄 Scan</span>';
}

async function _loadOibScreener() {
  const stEl = document.getElementById('oib-status');
  const tblEl = document.getElementById('oib-table');
  const wlId = document.getElementById('oib-watchlist')?.value || '';
  if (stEl) stEl.innerHTML = `⏳ Scanning${wlId ? ' selected watchlist' : ' all symbols'}… (30-60s)`;
  if (tblEl) tblEl.innerHTML = '<div style="padding:20px;color:var(--muted)">⏳ Loading — scanning OI across all symbols with recent data…</div>';
  try {
    const d = await api('/api/oi_buildup_screener?st='
      + (document.getElementById('oib-st-days')?.value||3)
      + '&mt=' + (document.getElementById('oib-mt-days')?.value||10)
      + '&lt=' + (document.getElementById('oib-lt-days')?.value||30)
      + (wlId ? '&watchlist_id=' + wlId : ''));
    _oibData = d.results || [];
    clearInterval(window._oibTimer);
    if (d.error_count > 0) addNotif('warn', 'OI Buildup: '+d.error_count+' symbols failed', d.errors.map(function(e){return e.sym+': '+e.error}).join('\n'), 'OI Buildup');
    if (d.error) addNotif('error', 'OI Buildup failed', (d.error||'')+(d.trace?'\n'+d.trace:''), 'OI Buildup');
    if(stEl){const _ts=d.completed_at?' · Completed '+d.completed_at:'';stEl.innerHTML='✅ '+_oibData.length+' symbols scanned'+_ts;}
    _updateMetaBar();
    _oibLastScan = Date.now();
    // Enrich with sector data
    try {
      const secs = await api('/api/scanner/sectors').catch(()=>({}));
      _oibData.forEach(r => { if (!r.sector) r.sector = secs[r.symbol] || ''; });
    } catch {}
    // Persist in localStorage so data survives page refresh
    try {
      localStorage.setItem('oib_cache', JSON.stringify({
        data: _oibData, ts: _oibLastScan, date: d.date
      }));
    } catch {}
    const defaultName = `OIBuildUp_${new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'')}`;
    if (stEl) stEl.innerHTML = `✅ ${_oibData.length} symbols · ${d.date} · just now` + ` <span style="color:var(--muted);font-size:10px">Saved runs are optional.</span>` + `<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px;padding:8px 10px;border:1px solid rgba(99,102,241,.25);border-radius:10px;background:rgba(99,102,241,.08)"><b>Save fresh scan</b><input id="oib-save-name" type="text" value="${defaultName}" style="min-width:260px;flex:1 1 320px" /><button class="btn btn-primary" style="padding:6px 10px" onclick="_oibSaveCurrentRun(document.getElementById('oib-save-name')?.value)">Save run</button><span style="font-size:11px;color:var(--muted)">Default name is OIBuildUp_datetime.</span></div>`;
    _oibRender();
  } catch (e) {
    if (stEl) stEl.innerHTML = `❌ ${e.message}`;
  }
}


async function _oibRefreshLiveVisibleSpots(force=false) {
  const cb = document.getElementById('oib-live-spot');
  if (!force && !cb?.checked) return;
  const cards = Array.from(document.querySelectorAll('#oib-table .oib-card[data-symbol]'));
  if (!cards.length) return;
  const limit = force ? 60 : 30;
  const batch = cards.slice(0, limit);
  const stEl = document.getElementById('oib-status');
  const oldStatus = stEl ? stEl.innerHTML : '';
  if (stEl) stEl.innerHTML = `${oldStatus || ''} · ⚡ refreshing live spot for ${batch.length}`;
  const fmt = (v) => { const n = parseFloat(v); return Number.isFinite(n) && n>0 ? '$'+n.toFixed(2) : 'Spot n/a'; };
  let idx = 0, ok = 0;
  async function worker() {
    while (idx < batch.length) {
      const card = batch[idx++];
      const sym = card.dataset.symbol;
      if (!sym) continue;
      try {
        const d = await api(`/api/spot?symbol=${encodeURIComponent(sym)}&_=${Date.now()}`);
        const spot = Number(d.spot ?? d.price);
        if (Number.isFinite(spot) && spot > 0) {
          ok++;
          const row = (_oibData||[]).find(x => String(x.symbol||'').toUpperCase() === sym.toUpperCase());
          if (row) {
            row.spot = spot; row.spot_proxy = spot; row.spot_source = d.source || 'live'; row.spot_price_date = d.timestamp || 'live';
          }
          const px = card.querySelector('.oib-live-spot');
          const src = card.querySelector('.oib-price-src');
          if (px) px.textContent = fmt(spot);
          if (src) src.textContent = d.source ? `live ${d.source}` : 'live';
          if (card.querySelector('.oib-head-right')) {
            card.querySelector('.oib-head-right').title = `Underlying price source: ${d.source||'live'} ${d.timestamp||''}`;
          }
        }
      } catch {}
    }
  }
  await Promise.all(Array.from({length: Math.min(6, batch.length)}, () => worker()));
  if (stEl) stEl.innerHTML = `${oldStatus || ''} · live spot ${ok}/${batch.length}`;
}

function _oibFilter(btn) {
  document.querySelectorAll('.oib-filter').forEach(b => {
    const isAll = b.dataset.filter === 'ALL';
    b.style.background = 'transparent';
    b.style.color = isAll ? 'var(--accent)' : (b.dataset.color || b.style.borderColor || 'var(--muted)');
  });
  btn.style.background = btn.dataset.filter === 'ALL' ? 'var(--accent)' : (btn.dataset.color || btn.style.borderColor || 'var(--accent)');
  btn.style.color = 'white';
  _oibFilterVal = btn.dataset.filter;
  _oibRender();
}

function _oibSort(col) {
  if (_oibSortCol === col) _oibSortDir *= -1;
  else { _oibSortCol = col; _oibSortDir = -1; }
  _oibRender();
}

function _oibSignalMatches(row, filterVal) {
  if (!filterVal || filterVal === 'ALL') return true;
  const signals = [row.st_outlook, row.mt_outlook, row.lt_outlook, row.final_seller_read].map(x => (x || '').toString());
  const dirs = [row.st_seller_bias, row.mt_seller_bias, row.lt_seller_bias, row.bias].map(x => (x || '').toString());
  if (filterVal === 'BULLISH') return dirs.some(x => x.includes('Bullish')) || signals.some(x => x.includes('Bullish'));
  if (filterVal === 'BEARISH') return dirs.some(x => x.includes('Bearish')) || signals.some(x => x.includes('Bearish'));
  if (filterVal === 'CONFIRMED') return signals.some(x => x.includes('Confirmed'));
  if (filterVal === 'EARNINGS_CONFLICT') return !!row.earnings_conflict;
  if (filterVal === 'EARNINGS_CLEAR') return !row.earnings_conflict;
  if (filterVal === 'UNWIND') return signals.some(x => x.includes('Unwind'));
  if (filterVal === 'MIXED') return signals.some(x => x.includes('Mixed') || x.includes('Neutral') || x.includes('No Clear')) || String(row.bias||'').includes('Sideways');
  return signals.some(x => x.includes(filterVal));
}

function _oibRender() {
  const tblEl = document.getElementById('oib-table');
  if (!tblEl) return;
  if (!_oibData || !_oibData.length) {
    tblEl.innerHTML = '<div class="oib-empty">No data - click Scan</div>';
    return;
  }

  const stD  = parseInt(document.getElementById('oib-st-days')?.value || 3);
  const mtD  = parseInt(document.getElementById('oib-mt-days')?.value || 10);
  const ltD  = parseInt(document.getElementById('oib-lt-days')?.value || 30);
  const search  = (document.getElementById('oib-search')?.value || '').toUpperCase();
  const sectorF = document.getElementById('oib-sector-filter')?.value || '';

  _oibUpdateQualityLabel();
  let data = _oibData.slice();
  // Compute quality for all rows before filtering so sort/counts/tooltips stay stable.
  data.forEach(r => _oibQualityPass(r));
  if (_oibFilterVal && _oibFilterVal !== 'ALL') data = data.filter(r => _oibSignalMatches(r, _oibFilterVal));
  if ((_oibQualityMin || 1) > 1) data = data.filter(r => _oibQualityPass(r));
  if (sectorF) data = data.filter(r => !r.sector || r.sector === sectorF);
  if (search)  data = data.filter(r => r.symbol && r.symbol.includes(search));

  if (data.length === 0 && _oibData.length > 0) {
    tblEl.innerHTML = `<div class="oib-empty">
      No symbols match current filters: <b style="color:var(--accent)">${_oibFilterVal||'All'}</b> · quality <b style="color:var(--accent)">${_OIB_QUALITY_LABELS[_oibQualityMin]||'All'}</b>
      <button onclick="_oibFilterVal='ALL';_oibQualityMin=1;try{localStorage.setItem('oib_quality_min','1')}catch{};_oibUpdateQualityLabel();_oibRender()" class="oib-mini-btn">Reset Filters</button>
    </div>`;
    return;
  }

  data.sort((a, b) => {
    const va = a[_oibSortCol] ?? 0, vb = b[_oibSortCol] ?? 0;
    if (typeof va === 'string' || typeof vb === 'string') return _oibSortDir * String(va).localeCompare(String(vb));
    return _oibSortDir * ((Number(va||0) - Number(vb||0)) || 0);
  });

  const esc = (x) => String(x ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));
  const nval = (v, d=0) => { const n = parseFloat(v); return isNaN(n) ? d : n; };
  const fmtPct = (v, digits=1) => {
    const n = parseFloat(v);
    if (isNaN(n)) return 'n/a';
    return (n > 0 ? '+' : '') + n.toFixed(digits) + '%';
  };
  const fmtDist = (v, digits=1) => {
    const n = parseFloat(v);
    if (isNaN(n)) return 'n/a';
    return n.toFixed(digits) + '%';
  };
  const fmtNum = (v, digits=2) => {
    const n = parseFloat(v);
    if (isNaN(n)) return 'n/a';
    return n.toFixed(digits);
  };
  const fmtDelta = (v, digits=1) => {
    const n = parseFloat(v);
    if (isNaN(n)) return 'n/a';
    return (n > 0 ? '+' : '') + n.toFixed(digits);
  };
  const fmtOI = (n) => {
    n = Number(n || 0);
    if (!n) return 'n/a';
    if (n >= 1000000) return (n/1000000).toFixed(1) + 'M';
    if (n >= 1000) return (n/1000).toFixed(0) + 'K';
    return String(Math.round(n));
  };
  const fmtPrice = (v) => {
    const n = parseFloat(v);
    return Number.isFinite(n) && n > 0 ? '$' + n.toFixed(2) : 'Spot n/a';
  };
  const tone = (text, fallback='neutral') => {
    const s = String(text || '');
    if (s.includes('Skew Risk') || s.includes('Earnings Conflict')) return 'warn';
    if (s.includes('Bullish') || s.includes('Strongly Bull') || s.includes('Put Selling')) return 'bull';
    if (s.includes('Bearish') || s.includes('Strongly Bear') || s.includes('Call Selling')) return 'bear';
    if (s.includes('Mixed')) return 'mixed';
    return fallback;
  };
  const numTone = (v, reverse=false) => {
    const n = parseFloat(v);
    if (isNaN(n) || Math.abs(n) < 0.05) return 'neutral';
    const pos = n > 0;
    return (reverse ? !pos : pos) ? 'bull' : 'bear';
  };
  const actionTone = (v) => {
    const s = String(v||'').toUpperCase();
    if (s.includes('SELL')) return 'bull';
    if (s.includes('BUY')) return 'warn';
    if (s.includes('AVOID') || s.includes('WAIT') || s.includes('WATCH')) return 'neutral';
    return 'neutral';
  };
  const biasTone = (v) => {
    const s = String(v||'');
    if (/bull/i.test(s)) return 'bull';
    if (/bear/i.test(s)) return 'bear';
    if (/low iv|buy options/i.test(s)) return 'warn';
    if (/high iv|sell premium/i.test(s)) return 'bull';
    return 'neutral';
  };
  const badge = (txt, extra='') => txt ? `<span class="oib-badge oib-${tone(txt)} ${extra}" title="${esc(txt)}">${esc(txt)}</span>` : '<span class="oib-muted">n/a</span>';
  const metric = (label, value, cls='neutral', title='') => `
    <span class="oib-metric" title="${esc(title)}">
      <span>${esc(label)}</span><b class="oib-${cls}">${esc(value)}</b>
    </span>`;
  const sortBtn = (label, col) => {
    const active = _oibSortCol === col;
    return `<button class="oib-sort-btn ${active?'active':''}" onclick="_oibSort('${col}')">${esc(label)}${active?(_oibSortDir>0?' up':' down'):''}</button>`;
  };
  const get = (r, key, alt, d=null) => (r[key] ?? (alt ? r[alt] : undefined) ?? d);
  const miniStat = (label, value, cls='neutral', title='') => `
    <span class="oib-mini-stat" title="${esc(title)}"><em>${esc(label)}</em><b class="oib-${cls}">${esc(value)}</b></span>`;
  const signalLine = (label, sig, ctx) => `
    <div class="oib-signal-line">
      <span>${esc(label)}</span>
      ${badge(sig)}
      ${ctx ? `<em>${esc(ctx)}</em>` : ''}
    </div>`;
  const windowCard = (r, p, label, days) => {
    const oiPct = get(r, `oi_${p}_pct`, p==='st'?'oi_1d_pct':p==='mt'?'oi_5d_pct':'oi_15d_pct');
    const pcrPct = get(r, `pcr_${p}_chg_pct`, p==='st'?'pcr_1d_chg_pct':p==='mt'?'pcr_5d_chg_pct':'pcr_15d_chg_pct');
    const pcrPts = get(r, `pcr_${p}_chg`, p==='st'?'pcr_1d_chg':p==='mt'?'pcr_5d_chg':'pcr_15d_chg');
    const skew = get(r, `skew_${p}_chg`, p==='st'?'skew_1d_chg':p==='mt'?'skew_5d_chg':'skew_15d_chg');
    const mpPct = get(r, `max_pain_${p}_chg_pct`, p==='st'?'max_pain_1d_chg_pct':p==='mt'?'max_pain_5d_chg_pct':'max_pain_15d_chg_pct');
    const skewTxt = (skew !== null && skew !== undefined && skew !== '') ? fmtDelta(skew) : (r.risk_reversal !== null && r.risk_reversal !== undefined && r.risk_reversal !== '' ? fmtDelta(r.risk_reversal)+' RR' : (r.skew_source==='oi_proxy' ? 'proxy' : 'n/a'));
    const painTxt = (mpPct !== null && mpPct !== undefined && mpPct !== '') ? fmtPct(mpPct) : (r.max_pain !== null && r.max_pain !== undefined && r.max_pain !== '' ? fmtNum(r.max_pain,2) : 'n/a');
    const sig = get(r, `${p}_outlook`, `${p}_seller_signal`, 'Neutral');
    const ctx = get(r, `${p}_price_context`, null, '');
    const sigTone = tone(sig);
    return `<details class="oib-window oib-window-${p}">
      <summary class="oib-window-summary">
        <span class="oib-window-title"><b>${esc(label)}</b><em>${days}D</em></span>
        <span class="oib-window-signal oib-${sigTone}" title="${esc(sig)}">${esc(sig)}</span>
        <span class="oib-window-chiprow">
          ${miniStat('OI', fmtPct(oiPct), numTone(oiPct), 'Total open-interest change')}
          ${miniStat('PCR', fmtPct(pcrPct), numTone(pcrPct), `PCR point change ${fmtDelta(pcrPts,2)}`)}
          ${miniStat('Skew', skewTxt, numTone(skew), `Risk-reversal or OI-skew proxy shift. Source: ${r.skew_source || 'n/a'}; current RR/proxy ${fmtDelta(r.risk_reversal)}`)}
          ${miniStat('Pain', painTxt, numTone(mpPct), 'Max-pain shift; if shift is unavailable this shows current max pain')}
        </span>
      </summary>
      <div class="oib-window-body">
        <div class="oib-row-metrics">
          ${metric('OI change', fmtPct(oiPct), numTone(oiPct), 'Total open-interest change')}
          ${metric('PCR % change', fmtPct(pcrPct), numTone(pcrPct), `PCR point change ${fmtDelta(pcrPts,2)}`)}
          ${metric('PCR point Δ', fmtDelta(pcrPts,2), numTone(pcrPts), '')}
          ${metric('Skew / RR', skewTxt, numTone(skew), `Source: ${r.skew_source || 'n/a'}; current RR/proxy ${fmtDelta(r.risk_reversal)}`)}
          ${metric('Max pain', painTxt, numTone(mpPct), 'Window shift or latest max-pain value')}
        </div>
        ${signalLine('Read', sig, ctx)}
      </div>
    </details>`;
  };
  const earningsText = (r) => {
    if (!r.earnings_date) return 'Earn n/a';
    const d = (r.earnings_days === null || r.earnings_days === undefined || r.earnings_days === '') ? '?' : r.earnings_days;
    return `Earn ${r.earnings_date} (${d}d ${r.earnings_conflict ? 'conflict' : 'clear'})`;
  };
  const earningsChip = (r) => {
    const cls = r.earnings_conflict ? 'warn' : (r.earnings_date ? 'bull' : 'neutral');
    return `<span class="oib-earn-chip oib-${cls}" title="${esc(r.avoid_timeframe || r.earnings_note || '')}">${esc(earningsText(r))}</span>`;
  };
  const uaeChip = (r) => {
    const conf = r.uae_confirmation || (r.uae_context_available ? 'UAE mixed' : 'UAE unavailable');
    const cls = /confirms/i.test(conf) ? 'bull' : /conflict/i.test(conf) ? 'bear' : /unavailable/i.test(conf) ? 'neutral' : 'warn';
    const d = r.uae_daily_regime || 'n/a';
    const w = r.uae_weekly_regime || 'n/a';
    const dm = r.uae_daily_marker_label || 'No daily marker';
    const wm = r.uae_weekly_marker_label || 'No weekly marker';
    const da = (r.uae_daily_marker_age===null || r.uae_daily_marker_age===undefined || r.uae_daily_marker_age==='') ? 'n/a' : r.uae_daily_marker_age;
    const wa = (r.uae_weekly_marker_age===null || r.uae_weekly_marker_age===undefined || r.uae_weekly_marker_age==='') ? 'n/a' : r.uae_weekly_marker_age;
    const tip = `${conf}: Daily ${d}, ${dm} age ${da}; Weekly ${w}, ${wm} age ${wa}. ${r.uae_action_note || ''}`;
    return `<div class="oib-uae-row oib-${cls}" title="${esc(tip)}"><b>UAE</b><span>${esc(conf)}</span><em>D ${esc(d)} · W ${esc(w)}</em></div>`;
  };

  const contextStrip = (r) => {
    const iv = (r.iv_rank !== null && r.iv_rank !== undefined && r.iv_rank !== '')
      ? `${fmtNum(r.iv_rank,1)} ${r.iv_regime || ''}${r.iv_rank_estimated ? ' est' : ''}`
      : (r.current_iv ? `IV ${fmtNum(r.current_iv,1)} · rank n/a` : 'IVR n/a');
    const pref = r.should_buy_sell || r.premium_preference || 'WAIT';
    const sector = r.sector_etf ? `${r.sector_etf} ${r.sector_regime || 'n/a'}` : (r.sector ? `${r.sector} trend n/a` : 'Sector n/a');
    const sectorTitle = `${r.sector || 'Sector n/a'} ${r.sector_etf ? 'via '+r.sector_etf : ''}. ${r.sector_note || ''}`;
    const px = r.price_action_read || 'Price n/a';
    const pxTitle = `${r.price_action_note || ''} RSI ${r.rsi14 ?? 'n/a'} · RSIDiff90 ${r.rsidiff90 ?? 'n/a'} · BB/KC ${r.bb_kc_state || 'n/a'}`;
    const rsiTxt = `RSI ${fmtNum(r.rsi14,1)} · Δ90 ${fmtNum(r.rsidiff90,1)}`;
    const dSrTxt = `S ${fmtDist(r.distance_from_support_20_pct)} · R ${fmtDist(r.distance_from_resistance_20_pct)}`;
    const wSrTxt = `S ${fmtDist(r.weekly_distance_from_support_20_pct)} · R ${fmtDist(r.weekly_distance_from_resistance_20_pct)}`;
    const guard = r.price_location_guard || '';
    const srTitle = r.price_location_note || 'Distance from rolling 20-bar support/resistance. S = percent above support; R = percent below resistance.';
    return `<div class="oib-context-strip">
      ${metric('Action', pref, actionTone(pref), r.buy_sell_note || '')}
      ${metric('IVR', iv, biasTone(r.iv_regime || pref), r.iv_note || '')}
      ${metric('Sector', sector, biasTone(r.sector_regime), sectorTitle)}
      ${metric('Price', px, biasTone(r.price_action_bias), pxTitle)}
    </div>
    <div class="oib-pa-strip">
      ${metric('Daily RSI', rsiTxt, (Number(r.rsi14) >= 70 || Number(r.rsidiff90) >= 18) ? 'warn' : (Number(r.rsi14) <= 35 || Number(r.rsidiff90) <= -18) ? 'bear' : 'neutral', pxTitle)}
      ${metric('Daily S/R', dSrTxt, Number(r.distance_from_support_20_pct) <= 2 ? 'warn' : Number(r.distance_from_resistance_20_pct) <= 2 ? 'warn' : 'neutral', srTitle)}
      ${metric('Weekly S/R', wSrTxt, Number(r.weekly_distance_from_support_20_pct) <= 3 ? 'warn' : Number(r.weekly_distance_from_resistance_20_pct) <= 3 ? 'warn' : 'neutral', srTitle)}
      ${guard ? metric('Guard', guard, 'warn', r.price_location_action_note || guard) : ''}
    </div>`;
  };

  const card = (r, idx) => {
    const read = r.final_seller_read || r.bias || 'No Clear Seller Edge';
    const readTone = tone(read);
    const pcr = nval(r.pcr ?? r.pc_ratio, 0);
    const pcrCls = pcr > 1.2 ? 'bull' : pcr < 0.8 ? 'bear' : 'warn';
    const inferSuggestion = () => {
      const txt = [read, r.st_outlook, r.mt_outlook, r.lt_outlook, r.st_seller_signal, r.mt_seller_signal, r.lt_seller_signal].join(' ');
      if (/Bearish|Call Selling|Strongly Bear/i.test(txt)) {
        const st = r.call_wall_strike ? `Sell ${fmtNum(r.call_wall_strike,2)}C${r.call_long_strike ? ' / Buy '+fmtNum(r.call_long_strike,2)+'C' : ''}` : 'above call resistance';
        return {strategy:'Bear call credit spread above call-resistance / max-pain resistance', code:'CS', strikes:st, label:`CS ${st}`};
      }
      if (/Bullish|Put Selling|Strongly Bull/i.test(txt)) {
        const st = r.put_wall_strike ? `Sell ${fmtNum(r.put_wall_strike,2)}P${r.put_long_strike ? ' / Buy '+fmtNum(r.put_long_strike,2)+'P' : ''}` : 'below put support';
        return {strategy:'Bull put credit spread below put-support / max-pain support', code:'PS', strikes:st, label:`PS ${st}`};
      }
      return {strategy:'No strategy suggestion', code:'', strikes:'', label:'No strategy suggestion'};
    };
    const inferred = inferSuggestion();
    const strat = r.suggested_strategy || inferred.strategy;
    const code = r.suggested_strategy_code || inferred.code;
    const strikes = r.suggested_strikes || inferred.strikes;
    const tradeLabel = r.suggested_trade_label || ([code, strikes].filter(Boolean).join(' ') || inferred.label || strat);
    const tf = [r.suggested_timeframe, r.suggested_expiry_window].filter(Boolean).join(' / ');
    const action = r.suggested_action || r.reason || '';
    const rrCurrent = (r.risk_reversal !== null && r.risk_reversal !== undefined && r.risk_reversal !== '') ? r.risk_reversal : null;
    const rrFallback = rrCurrent ?? r.skew_st_chg ?? r.skew_mt_chg ?? r.skew_lt_chg;
    const skewSuffix = (rrFallback !== null && rrFallback !== undefined && rrFallback !== '')
      ? ` ${fmtDelta(rrFallback,1)}${rrCurrent === null ? ' Δ' : ' RR'}`
      : '';
    const sourceLabel = r.skew_source === 'oi_proxy' ? `OI-proxy${skewSuffix}` : (r.skew_source === 'iv' || r.skew_source === 'price_iv') ? `IV skew${skewSuffix}` : (skewSuffix ? `Skew${skewSuffix}` : 'Skew unavailable');
    const support = r.put_wall_strike ? `${fmtNum(r.put_wall_strike,2)}P support` : 'support n/a';
    const resist = r.call_wall_strike ? `${fmtNum(r.call_wall_strike,2)}C resistance` : 'resistance n/a';
    return `<article class="oib-card oib-card-${readTone}" data-symbol="${esc(r.symbol)}">
      <div class="oib-card-head">
        <div>
          <div class="oib-symbol-row"><span class="oib-rank">#${idx+1}</span><b>${esc(r.symbol)}</b>${r.has_futures?'<small>F+O</small>':''}</div>
          <div class="oib-subline">${esc(r.sector || 'No sector')} | Latest ${esc(r.latest_date || '')}</div>
        </div>
        <div class="oib-head-right" title="Underlying price source: ${esc(r.spot_source || 'price_cache/option underlying')} ${r.spot_price_date ? '· '+esc(r.spot_price_date) : ''}. OI-weighted strike is no longer used as spot.">
          <em>Spot</em>
          <b class="oib-live-spot">${fmtPrice(r.spot ?? r.spot_proxy)}</b>
          <span class="oib-price-src">${esc(r.spot_source || 'price')}</span>
          <span class="oib-conf">Conf ${esc(r.flow_confidence ?? r.confidence ?? '')}</span>
        </div>
      </div>
      <div class="oib-read oib-${readTone}" title="${esc(r.reason || r.seller_thesis || '')}">${esc(read)}</div>
      <div class="oib-quality-row" title="${esc((r.trade_quality_reasons||[]).join(' · '))}">
        <span class="oib-quality-pill oib-q${esc(r.trade_quality_bucket || 1)}">Q${esc(r.trade_quality_bucket || 1)} ${esc(r.trade_quality_label || 'Weak')} · ${esc(r.trade_quality_score ?? '')}</span>
      </div>
      <div class="oib-trade-line" title="${esc(strat)}">
        <div class="oib-trade-main">
          <span>Suggested</span>
          <b>${esc(tradeLabel)}</b>
          <em>${esc(tf || 'n/a')}</em>
        </div>
        ${earningsChip(r)}
      </div>
      ${uaeChip(r)}
      ${contextStrip(r)}
      <div class="oib-snapshot-strip">
        ${metric('OI', fmtOI(r.total_oi), 'neutral')}
        ${metric('Calls', fmtOI(r.call_oi), 'bear', 'Call OI: potential resistance/supply side')}
        ${metric('Puts', fmtOI(r.put_oi), 'bull', 'Put OI: potential support/supply side')}
        ${metric('PCR', fmtNum(pcr,2), pcrCls, 'Put/call OI ratio')}
        ${metric('Pain', fmtNum(r.max_pain,2), 'neutral', 'Current max pain')}
        ${metric('Skew', sourceLabel, r.skew_source==='oi_proxy'?'warn':'neutral', r.data_quality_note || '')}
        ${metric('UAE', r.uae_confirmation || 'n/a', /confirms/i.test(r.uae_confirmation||'')?'bull':/conflict/i.test(r.uae_confirmation||'')?'bear':'warn', r.uae_action_note || '')}
      </div>
      <div class="oib-wall-row">
        <span title="Put wall selected from latest strike-level OI">${esc(support)}</span>
        <span title="Call wall selected from latest strike-level OI">${esc(resist)}</span>
      </div>
      <div class="oib-window-stack">
        ${windowCard(r, 'st', 'ST', stD)}
        ${windowCard(r, 'mt', 'MT', mtD)}
        ${windowCard(r, 'lt', 'LT', ltD)}
      </div>
      <details class="oib-details">
        <summary>Rationale and action</summary>
        <div>${esc(action)}</div>
        <div>${esc(r.reason || r.seller_thesis || '')}</div>
      </details>
    </article>`;
  };

  const html = `<div class="oib-results-wrap">
    <div class="oib-results-toolbar">
      <div><b>${data.length}</b> shown of ${_oibData.length}. Quality filter: <b>${esc(_OIB_QUALITY_LABELS[_oibQualityMin] || 'All')}</b>. Model: seller-flow PCR/OI + skew/max-pain + IV rank + sector/price/UAE guardrails.</div>
      <div class="oib-sort-row">
        ${sortBtn('Quality','trade_quality_score')}
        ${sortBtn('Confidence','flow_confidence')}
        ${sortBtn('Bias score','bias_score')}
        ${sortBtn('LT OI','oi_lt_pct')}
        ${sortBtn('LT PCR','pcr_lt_chg_pct')}
        ${sortBtn('Total OI','total_oi')}
        ${sortBtn('IVR','iv_rank')}
        ${sortBtn('D Sup','distance_from_support_20_pct')}
        ${sortBtn('W Sup','weekly_distance_from_support_20_pct')}
        ${sortBtn('Sector','sector_regime')}
      </div>
    </div>
    <div class="oib-cards">${data.map((r, i) => card(r, i)).join('')}</div>
  </div>`;

  tblEl.innerHTML = html;
  if (document.getElementById('oib-live-spot')?.checked) {
    setTimeout(() => _oibRefreshLiveVisibleSpots(false), 50);
  }
}


// GEX-BASED DAILY TRADING PLAN  (TradeHive-style)

async function _gexLoadExpiries() {
  const sym = (document.getElementById('gex-plan-symbol')?.value || 'SPY').trim().toUpperCase() || 'SPY';
  const sel = document.getElementById('gex-plan-expiry');
  if (!sel) return;
  sel.innerHTML = '<option value="">Loading…</option>';
  try {
    const d = await api(`/api/db_expirations?symbol=${encodeURIComponent(sym)}&future=true`);
    const exps = d.expirations||[];
    sel.innerHTML = exps.length
      ? exps.map((e,i) => `<option value="${e}"${i===0?' selected':''}>${e}</option>`).join('')
      : '<option value="">Auto-select</option>';
  } catch { sel.innerHTML = '<option value="">Auto-select</option>'; }
  _gexLoadSnapshotTable(sym);
}

async function _loadDailyPlan(saveSnapshot=false) {
  const sym  = (document.getElementById('gex-plan-symbol')?.value || 'SPY').trim().toUpperCase() || 'SPY';
  const exp  = document.getElementById('gex-plan-expiry')?.value || '';
  const el   = document.getElementById('gex-plan-result');
  const stEl = document.getElementById('gex-plan-status');
  if (!el) { console.error('gex-plan-result not found'); return; }
  el.innerHTML = '<div style="padding:32px;text-align:center;color:var(--muted)">⏳ Computing GEX levels, VIX/DTE composite score, and trade actions…</div>';
  if (stEl) stEl.innerHTML = saveSnapshot ? '⏳ Running on demand and saving snapshot…' : '⏳ Loading…';
  try {
    _loadContextPanel(sym, 'gex-context-panel');
    const qs = new URLSearchParams({symbol:sym});
    if (exp) qs.set('expiry', exp);
    qs.set('min_change_pct', _oiSigParam('gex-oi-sig-pct'));
    if (saveSnapshot) { qs.set('save_snapshot', '1'); qs.set('snapshot_label', 'on demand'); }
    const d = await api(`/spy/daily_plan?${qs.toString()}`);
    // Populate expiry list if backend returned more options
    if (d.expiry_list?.length) {
      const sel = document.getElementById('gex-plan-expiry');
      if (sel && sel.options.length <= 1) {
        sel.innerHTML = d.expiry_list.map(e =>
          `<option value="${e}"${e===d.expiry?' selected':''}>${e}</option>`).join('');
      }
    }
    _gexLoadSnapshotTable(sym, d.snapshots || []);
    el.innerHTML = _renderDailyPlan({...d, snapshots: []});
    if (stEl) stEl.innerHTML = `✅ ${d.date||''} · ${d.expiry||''} (${d.dte}d)${d.snapshot_saved?' · 💾 saved':''}`;
  } catch(e) {
    el.innerHTML = `<div class="card" style="padding:16px;border-left:3px solid #ef4444"><b style="color:#ef4444">Error:</b> ${e.message}</div>`;
    if (stEl) stEl.innerHTML = `❌ ${e.message.slice(0,40)}`;
  }
}
window._loadDailyPlan = _loadDailyPlan;

function _gexCell(v, dec=2) {
  if (v === null || v === undefined || v === '') return '—';
  const n = Number(v);
  if (Number.isFinite(n)) return dec === 0 ? Math.round(n).toLocaleString() : n.toFixed(dec);
  return String(v);
}


function _fmtSignedInt(v) {
  const n = Number(v);
  if (!Number.isFinite(n)) return '—';
  return (n >= 0 ? '+' : '') + Math.round(n).toLocaleString();
}

function _renderGexWallStrength(ws) {
  ws = ws || {};
  const puts = Array.isArray(ws.top_put_walls) ? ws.top_put_walls.slice(0, 3) : [];
  const calls = Array.isArray(ws.top_call_walls) ? ws.top_call_walls.slice(0, 3) : [];
  const oiFilter = ws.oi_change_filter || {};
  const oiFilterLine = oiFilter.enabled ? `<div style="font-size:9px;color:${oiFilter.qualified ? '#22c55e' : '#f59e0b'};margin-top:3px">ΔOI significance: ${oiFilter.qualified ? 'ON' : 'OFF'} · ${String(oiFilter.reason || '').replace(/[&<>"]/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[s]))}</div>` : '';
  if (!puts.length && !calls.length) return oiFilterLine ? `<div style="font-size:10px;color:var(--muted);padding:8px 0">${oiFilterLine}</div>` : '';
  const row = (w) => {
    const isPut = String(w.type||'').toLowerCase() === 'put';
    const c = isPut ? '#22c55e' : '#ef4444';
    const role = isPut ? 'Support' : 'Resistance';
    const score = Number(w.score || 0);
    const bg = score >= 75 ? 'rgba(245,158,11,.12)' : score >= 60 ? 'rgba(34,197,94,.08)' : 'rgba(255,255,255,.03)';
    const dC = Number(w.oi_change||0) >= 0 ? '#22c55e' : '#ef4444';
    return `<tr style="background:${bg};border-top:1px solid var(--border)">
      <td style="padding:6px 8px;font-size:11px;font-weight:900;color:${c}">${isPut?'PUT':'CALL'} $${w.strike}</td>
      <td style="padding:6px 8px;font-size:11px;color:var(--text)">${role}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px;font-weight:900;color:${score>=75?'#f59e0b':'var(--text)'}">${score.toFixed(0)}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px">${Number(w.oi||0).toLocaleString()}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px;color:${dC};font-weight:800">${_fmtSignedInt(w.oi_change)}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px">${w.zscore ?? w.z_oi ?? '—'}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px">${w.oi_change_rank != null ? Number(w.oi_change_rank).toFixed(2) : (w.z_delta ?? '—')}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px">${w.pct_from_spot ?? w.distance_pct ?? '—'}%</td>
      <td style="padding:6px 8px;font-size:10px;color:var(--muted)">${w.label || ''}<br><span style="font-size:9px">${w.note || w.reason || ''}</span></td>
    </tr>`;
  };
  const rows = puts.concat(calls).map(row).join('');
  return `<div style="margin:10px 0;background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.22);border-radius:8px;overflow:hidden">
    <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;padding:9px 12px;border-bottom:1px solid rgba(245,158,11,.2)">
      <div>
        <div style="font-size:11px;font-weight:900;color:#f59e0b;text-transform:uppercase;letter-spacing:.5px">Significant Walls</div>
        <div style="font-size:10px;color:var(--muted)">${ws.summary || ''}</div>
        ${oiFilterLine}
      </div>
      <div style="font-size:18px;font-weight:900;color:#f59e0b">${Number(ws.score||0).toFixed(0)}<span style="font-size:10px;color:var(--muted)">/100</span></div>
    </div>
    <div style="overflow:auto">
      <table style="width:100%;border-collapse:collapse;min-width:860px">
        <thead><tr style="background:rgba(255,255,255,.03);color:var(--muted);font-size:10px;text-align:left">
          <th style="padding:5px 8px">Wall</th><th style="padding:5px 8px">Role</th><th style="padding:5px 8px;text-align:right">Score</th>
          <th style="padding:5px 8px;text-align:right">OI</th><th style="padding:5px 8px;text-align:right">ΔOI</th>
          <th style="padding:5px 8px;text-align:right">Z / OI z</th><th style="padding:5px 8px;text-align:right">Δ rank</th><th style="padding:5px 8px;text-align:right">Dist</th><th style="padding:5px 8px">Read</th>
        </tr></thead><tbody>${rows}</tbody>
      </table>
    </div>
    <div style="padding:6px 10px;font-size:9px;color:var(--muted);border-top:1px solid rgba(255,255,255,.06)">${ws.method || 'Score = 40% current OI + 30% positive OI change + 20% proximity/Z + 10% GEX. VIX is reliability overlay.'}</div>
  </div>`;
}

function _renderGexSnapshotTable(snapshots) {
  snapshots = Array.isArray(snapshots) ? snapshots : [];
  if (!snapshots.length) {
    return `<div class="card" style="padding:12px;margin:8px 0;color:var(--muted);font-size:12px">
      No saved GEX Plan snapshots yet. Scheduled runs are 8:45 and 10:15; use <b>Run On Demand & Save</b> to create one now.
    </div>`;
  }
  const rows = snapshots.map(s => {
    const p = s.payload || {};
    const g = p.gex || {};
    const i = p.interpretation || {};
    const rel = p.reliability || {};
    const bias = s.bias || p.bias || '—';
    const bC = bias === 'BEARISH' ? '#ef4444' : bias === 'BULLISH' ? '#22c55e' : '#f59e0b';
    const totalGex = g.total_gex ?? p.gex_total ?? null;
    const gC = Number(totalGex) < 0 ? '#ef4444' : '#22c55e';
    const flip = g.gamma_flip != null ? '$' + _gexCell(g.gamma_flip) : (s.gamma_flip || i.flip_note || '—');
    const pin = g.pin_strike != null ? '$' + _gexCell(g.pin_strike) : (i.pin_note || s.pin_note || '—');
    const maxPain = g.max_pain != null ? '$' + _gexCell(g.max_pain) : (p.max_pain != null ? '$' + _gexCell(p.max_pain) : (i.max_pain_note || s.max_pain_note || '—'));
    const ws = p.wall_strength || p.significant_walls || p.walls?.significance || {};
    const tp = (ws.top_put_walls || [])[0];
    const tc = (ws.top_call_walls || [])[0];
    const wallLine = (tp || tc) ? `<br>Put ${tp ? ('$'+tp.strike+' '+Math.round(tp.score||0)) : '—'} · Call ${tc ? ('$'+tc.strike+' '+Math.round(tc.score||0)) : '—'}` : '';
    return `<tr style="border-top:1px solid var(--border)">
      <td style="padding:6px 8px;font-size:11px;white-space:nowrap">${s.captured_at || '—'}</td>
      <td style="padding:6px 8px;font-size:11px;font-weight:800">${s.label || 'snapshot'}</td>
      <td style="padding:6px 8px;font-size:11px">${s.expiry || p.expiry || '—'}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px;color:var(--accent);font-weight:800">$${_gexCell(s.spot ?? p.spot)}</td>
      <td style="padding:6px 8px;text-align:center;font-size:11px;color:${bC};font-weight:800">${bias}</td>
      <td style="padding:6px 8px;font-size:11px">${s.regime || p.regime || '—'}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px">${_gexCell(s.score ?? p.score, 0)}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px">${_gexCell(s.confidence ?? p.confidence, 0)}%</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px;color:${gC};font-weight:700">${totalGex == null ? '—' : Number(totalGex).toLocaleString()}</td>
      <td style="padding:6px 8px;text-align:right;font-size:11px">${_gexCell(s.gex_strength ?? p.gex_strength, 1)}%</td>
      <td style="padding:6px 8px;font-size:10px;color:var(--muted)">Flip ${flip}<br>Pin ${pin}<br>Max pain ${maxPain}${rel.score != null ? `<br>Reliability ${rel.score}%` : ''}${wallLine}</td>
    </tr>`;
  }).join('');
  return `<div class="card" style="padding:0;margin:8px 0;overflow:hidden">
    <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;padding:10px 12px;border-bottom:1px solid var(--border)">
      <div>
        <div style="font-size:12px;font-weight:900;color:var(--text)">📋 Saved GEX Plan Runs</div>
        <div style="font-size:10px;color:var(--muted)">Today/latest only: older GEX Plan snapshots are auto-deleted · Set GEX_PLAN_TODAY_SNAPSHOT_LIMIT to keep more intraday runs</div>
      </div>
      <button class="btn" onclick="_gexLoadSnapshotTable()" style="font-size:11px;padding:5px 9px">↻ Refresh</button>
    </div>
    <div style="overflow:auto;max-height:360px">
      <table style="width:100%;border-collapse:collapse;min-width:980px">
        <thead><tr style="background:var(--surface);color:var(--muted);font-size:10px;text-align:left">
          <th style="padding:6px 8px">Captured</th><th style="padding:6px 8px">Run</th><th style="padding:6px 8px">Expiry</th>
          <th style="padding:6px 8px;text-align:right">Spot</th><th style="padding:6px 8px;text-align:center">Bias</th><th style="padding:6px 8px">Regime</th>
          <th style="padding:6px 8px;text-align:right">Score</th><th style="padding:6px 8px;text-align:right">Conf</th><th style="padding:6px 8px;text-align:right">Total GEX</th>
          <th style="padding:6px 8px;text-align:right">GEX Str</th><th style="padding:6px 8px">Levels</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
  </div>`;
}

async function _gexLoadSnapshotTable(sym=null, snapshots=null) {
  const el = document.getElementById('gex-snapshot-table');
  if (!el) return;
  sym = (sym || document.getElementById('gex-plan-symbol')?.value || 'SPY').trim().toUpperCase() || 'SPY';
  if (!Array.isArray(snapshots)) {
    el.innerHTML = '<div class="card" style="padding:12px;margin:8px 0;color:var(--muted);font-size:12px">⏳ Loading saved GEX Plan runs…</div>';
    try {
      const d = await api(`/spy/daily_plan_snapshots?symbol=${encodeURIComponent(sym)}&limit=12&_=${Date.now()}`);
      snapshots = d.snapshots || [];
    } catch(e) {
      el.innerHTML = `<div class="card" style="padding:12px;margin:8px 0;color:#ef4444;font-size:12px">❌ Could not load saved GEX Plan runs: ${e.message}</div>`;
      return;
    }
  }
  el.innerHTML = _renderGexSnapshotTable(snapshots);
}
window._gexLoadSnapshotTable = _gexLoadSnapshotTable;

function _render3PMTrades(t) {
  if (!t) return '';

  // Not OK case
  if (!t.ok) {
    return `<div style="background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.25);
                        border-radius:8px;padding:12px 14px;margin-bottom:10px">
      <div style="font-weight:700;font-size:13px;margin-bottom:4px">📋 3PM 1-DTE Trade Builder</div>
      <div style="font-size:12px;color:#f59e0b">⚠ ${t.reason}</div>
      ${t.regime === 'NEGATIVE_GAMMA' ? '<div style="font-size:11px;color:var(--muted);margin-top:4px">In negative gamma, dealers amplify moves — avoid selling premium. Wait for positive gamma day.</div>' : ''}
    </div>`;
  }

  const gapCtx = t.gap_context || {};
  const gapHtml = `
    <div style="background:var(--surface);border-radius:6px;padding:8px 10px;margin-bottom:6px">
      <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">
        📏 Gap Risk Context
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;font-size:11px">
        <span><span style="color:var(--muted)">Overnight 1σ:</span> <b>±$${gapCtx.overnight_1sigma||'—'} (±${gapCtx.overnight_1sigma_pct||'—'}%)</b></span>
        <span><span style="color:var(--muted)">To breach put wall:</span> <b style="color:#22c55e">>${gapCtx.put_wall_buffer_pct||'—'}% gap ↓</b></span>
        <span><span style="color:var(--muted)">To breach call wall:</span> <b style="color:#22c55e">>${gapCtx.call_wall_buffer_pct||'—'}% gap ↑</b></span>
      </div>
      <div style="font-size:10px;color:var(--muted);margin-top:3px;font-style:italic">${gapCtx.historical_note||''}</div>
    </div>`;

  const tradeCards = (t.trades||[]).map(tr => {
    const credColor = '#22c55e';
    const lossColor = '#ef4444';

    // Gap analysis table for T1/T2
    let gapTable = '';
    if (tr.gap_analysis) {
      const gapRows = tr.gap_analysis.map(g =>
        `<tr style="background:${g.in_the_money?'rgba(239,68,68,.08)':'rgba(34,197,94,.04)'}">
          <td style="padding:2px 6px;font-size:10px">${g.gap_pct >= 0 ? '+' : ''}${g.gap_pct}%</td>
          <td style="padding:2px 6px;font-size:10px">$${g.gap_price}</td>
          <td style="padding:2px 6px;font-size:10px">${g.status}</td>
        </tr>`
      ).join('');
      gapTable = `<div style="margin-top:6px">
        <div style="font-size:9px;color:var(--muted);margin-bottom:2px">Overnight gap scenario vs ${tr.type.includes('Put')?'Put':'Call'} short ${tr.type.includes('Put')?tr.short_strike:tr.short_strike}:</div>
        <table style="width:100%;border-collapse:collapse">
          <thead><tr style="background:var(--bg)">
            <th style="padding:2px 6px;font-size:9px;text-align:left;color:var(--muted)">Gap</th>
            <th style="padding:2px 6px;font-size:9px;text-align:left;color:var(--muted)">Open Price</th>
            <th style="padding:2px 6px;font-size:9px;text-align:left;color:var(--muted)">Position Status</th>
          </tr></thead>
          <tbody>${gapRows}</tbody>
        </table>
      </div>`;
    }

    // Legs
    const legs = tr.legs.map(l =>
      `<span style="font-size:11px;background:rgba(255,255,255,.05);padding:2px 6px;border-radius:3px;margin:1px">
        <b style="color:${l.action==='SELL'?'#22c55e':'#94a3b8'}">${l.action}</b> ${l.option} exp ${l.expiry}
      </span>`
    ).join(' ');

    return `<div style="background:var(--card);border:1px solid var(--border);border-radius:8px;
                         padding:12px 14px;margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;flex-wrap:wrap;gap:4px">
        <span style="font-weight:700;font-size:13px">${tr.id}. ${tr.name}</span>
        <span style="font-size:11px;color:var(--muted)">${tr.direction}</span>
      </div>
      <div style="font-size:11px;color:#f59e0b;margin-bottom:6px">
        ✅ Best when: ${tr.best_when}
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">${legs}</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:6px;margin-bottom:8px">
        ${[
          ['Max Profit', tr.max_profit, '#22c55e'],
          ['Max Loss',   tr.max_loss,   '#ef4444'],
          ['R:R',        tr.rr,             '#94a3b8'],
          ['PoP',        tr.pop+'%',        '#818cf8'],
          ['Credit Est', '$'+tr.credit_est, '#22c55e'],
          ['Width',      '$'+tr.width,      '#94a3b8'],
        ].map(([l,v,c]) =>
          `<div style="background:var(--surface);border-radius:5px;padding:6px 8px;text-align:center">
            <div style="font-size:9px;color:var(--muted)">${l}</div>
            <div style="font-size:14px;font-weight:800;color:${c}">${v}</div>
          </div>`
        ).join('')}
      </div>
      <div style="font-size:11px;color:var(--text2);margin-bottom:4px">
        <b>Entry:</b> ${tr.stop?.replace('Exit if','')?.trim()||''} &nbsp;|&nbsp; <b>Stop:</b> ${tr.stop||'—'} &nbsp;|&nbsp; <b>Target:</b> ${tr.target||'—'}
      </div>
      <div style="font-size:10px;color:var(--muted);font-style:italic;margin-bottom:4px">${tr.rationale}</div>
      ${tr.theta_edge ? `<div style="font-size:10px;color:#818cf8">⚡ ${tr.theta_edge}</div>` : ''}
      ${gapTable}
    </div>`;
  }).join('');

  // Entry + exit rules
  const rulesHtml = `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px">
      <div style="background:rgba(34,197,94,.06);border:1px solid rgba(34,197,94,.2);border-radius:6px;padding:8px 10px">
        <div style="font-size:10px;font-weight:700;color:#22c55e;margin-bottom:4px">✅ ENTRY RULES</div>
        ${(t.entry_rules||[]).map(r => `<div style="font-size:10px;color:var(--text2);margin-bottom:2px">${r}</div>`).join('')}
      </div>
      <div style="background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);border-radius:6px;padding:8px 10px">
        <div style="font-size:10px;font-weight:700;color:#ef4444;margin-bottom:4px">🚪 EXIT RULES</div>
        ${(t.exit_rules||[]).map(r => `<div style="font-size:10px;color:var(--text2);margin-bottom:2px">${r}</div>`).join('')}
      </div>
    </div>`;

  return `
  <div style="border:2px solid rgba(129,140,248,.3);border-radius:10px;padding:14px 16px;margin-bottom:10px;
              background:rgba(129,140,248,.04)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:6px">
      <div>
        <div style="font-size:14px;font-weight:700;color:#818cf8">📋 3PM 1-DTE Trade Builder</div>
        <div style="font-size:11px;color:var(--muted)">
          Entry: ${t.entry_time} · Expiry: ${t.expiry} · IV: ${t.iv_atm}% ·
          GEX reliability: <b style="color:#22c55e">${t.reliability_score}%</b> ·
          Regime: <b style="color:#22c55e">${t.regime}</b>
        </div>
      </div>
      <div style="display:flex;gap:8px;font-size:12px;flex-wrap:wrap">
        <span style="background:var(--surface);padding:3px 8px;border-radius:4px">
          <span style="color:var(--muted)">Flip:</span> <b>$${t.flip}</b>
        </span>
        <span style="background:rgba(239,68,68,.1);padding:3px 8px;border-radius:4px;color:#ef4444">
          Put wall: <b>$${t.top_put}</b>
        </span>
        <span style="background:rgba(34,197,94,.1);padding:3px 8px;border-radius:4px;color:#22c55e">
          Call wall: <b>$${t.top_call}</b>
        </span>
      </div>
    </div>
    ${gapHtml}
    ${tradeCards}
    ${rulesHtml}
  </div>`;
}

function _renderReliabilityPanel(rel) {
  if (!rel) return '';
  const sc    = rel.score || 0;
  const color = sc >= 80 ? '#22c55e' : sc >= 65 ? '#f59e0b' : sc >= 50 ? '#f97316' : '#ef4444';
  const barW  = sc + '%';

  const factorRows = (rel.factors||[]).map(f => {
    const ac = f.adj > 0 ? '#22c55e' : f.adj < 0 ? '#ef4444' : '#94a3b8';
    return `<div style="display:flex;align-items:baseline;gap:6px;margin-bottom:3px;font-size:11px">
      <span style="min-width:14px;text-align:center">${f.icon||''}</span>
      <span style="flex:1;color:var(--text2)">${f.detail}</span>
      <span style="font-weight:700;color:${ac};min-width:30px;text-align:right">${f.adj >= 0 ? '+' : ''}${f.adj}%</span>
    </div>`;
  }).join('');

  const caveatRows = (rel.caveats||[]).map(c =>
    `<div style="font-size:11px;color:#f59e0b;margin-top:2px">⚠ ${c}</div>`
  ).join('');

  return `
  <div style="background:${sc>=65?'rgba(34,197,94,.06)':sc>=50?'rgba(249,115,22,.06)':'rgba(239,68,68,.06)'};
              border:2px solid ${color};border-radius:10px;padding:14px 16px;margin-bottom:10px">
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px;flex-wrap:wrap">
      <div style="text-align:center;min-width:60px">
        <div style="font-size:38px;font-weight:900;color:${color};line-height:1">${sc}</div>
        <div style="font-size:10px;color:var(--muted)">% reliable</div>
      </div>
      <div style="flex:1;min-width:180px">
        <div style="font-size:14px;font-weight:700;color:${color};margin-bottom:3px">${rel.label}</div>
        <div style="font-size:11px;color:var(--text2);margin-bottom:6px">${rel.summary}</div>
        <div style="height:6px;background:var(--bg);border-radius:3px">
          <div style="height:6px;width:${barW};background:${color};border-radius:3px;transition:width .5s"></div>
        </div>
      </div>
      <div style="font-size:11px;padding:6px 12px;border-radius:20px;
                  background:${rel.trade_ok?'rgba(34,197,94,.15)':'rgba(239,68,68,.15)'};
                  color:${rel.trade_ok?'#22c55e':'#ef4444'};font-weight:700;border:1px solid ${rel.trade_ok?'rgba(34,197,94,.3)':'rgba(239,68,68,.3)'}">
        ${rel.trade_ok ? '✅ OK to trade tomorrow' : '⛔ High risk — skip or size down'}
      </div>
    </div>

    <div style="border-top:1px solid rgba(255,255,255,.08);padding-top:8px;margin-top:2px">
      <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;
                  letter-spacing:.5px;margin-bottom:5px">Reliability Factors</div>
      ${factorRows}
      <div style="display:flex;gap:12px;margin-top:6px;font-size:10px;flex-wrap:wrap">
        ${rel.vix != null ? `<span><span style="color:var(--muted)">VIX:</span> <b>${rel.vix}</b></span>` : ''}
        <span><span style="color:var(--muted)">Gamma:</span> <b style="color:${rel.gex_regime==='POSITIVE'?'#22c55e':'#ef4444'}">${rel.gex_regime}</b></span>
        <span><span style="color:var(--muted)">Valid for:</span> <b>${rel.computed_for||'tomorrow'}</b></span>
      </div>
      ${caveatRows ? `<div style="margin-top:6px;padding-top:6px;border-top:1px solid rgba(255,255,255,.06)">${caveatRows}</div>` : ''}
    </div>
  </div>`;
}


function _renderGexActionGuide(guide) {
  if (!guide || guide.available === false) return '';
  const esc2 = (v) => String(v ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\\':'&#92;','"':'&quot;'}[c] || c));
  const range = guide.range || {};
  const setups = Array.isArray(guide.setups) ? guide.setups : [];
  const tension = guide.tension || {};
  const bottom = Array.isArray(guide.bottom_line) ? guide.bottom_line : [];
  const setupHtml = setups.map((s, idx) => {
    const colors = ['#22c55e', '#38bdf8', '#ef4444'];
    const c = colors[idx] || '#f59e0b';
    const rules = (Array.isArray(s.rules) ? s.rules : []).map(r =>
      `<li style="margin:4px 0;line-height:1.35;color:var(--text2)">${esc2(r)}</li>`
    ).join('');
    return `<div style="background:rgba(255,255,255,.035);border:1px solid ${c}44;border-radius:8px;padding:10px 12px">
      <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:4px">
        <b style="font-size:12px;color:${c}">${esc2(s.name)}</b>
        <span style="font-size:9px;color:${c};border:1px solid ${c}44;background:${c}12;border-radius:999px;padding:2px 7px">${esc2(s.probability || '')}</span>
      </div>
      <ul style="margin:0 0 0 16px;padding:0;font-size:11px">${rules}</ul>
    </div>`;
  }).join('');
  const bottomHtml = bottom.map(b => `<div style="font-size:11px;color:var(--text2);margin:3px 0">• ${esc2(b)}</div>`).join('');
  return `<div style="margin:12px 0;background:linear-gradient(135deg,rgba(59,130,246,.10),rgba(168,85,247,.07));border:1px solid rgba(96,165,250,.28);border-radius:10px;padding:12px">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap;margin-bottom:8px">
      <div>
        <div style="font-size:13px;font-weight:900;color:#93c5fd;text-transform:uppercase;letter-spacing:.45px">${esc2(guide.title || 'How To Trade This Today')}</div>
        <div style="font-size:12px;color:var(--text);margin-top:3px">The Range: <b style="color:#22c55e">${esc2(range.label || '')}</b></div>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;font-size:10px">
        <span style="border:1px solid rgba(34,197,94,.35);background:rgba(34,197,94,.10);color:#22c55e;border-radius:999px;padding:3px 8px">DTE ${esc2(guide.dte)}</span>
        <span style="border:1px solid rgba(245,158,11,.35);background:rgba(245,158,11,.10);color:#f59e0b;border-radius:999px;padding:3px 8px">${esc2(guide.expiry)}</span>
      </div>
    </div>
    <div style="font-size:11px;color:var(--text2);line-height:1.35;margin-bottom:10px">${esc2(guide.context || '')}</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px;margin-bottom:10px">${setupHtml}</div>
    <div style="display:grid;grid-template-columns:1.1fr .9fr;gap:8px;margin-top:8px">
      <div style="background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-radius:8px;padding:10px">
        <div style="font-size:11px;font-weight:900;color:#f59e0b;text-transform:uppercase;margin-bottom:4px">Tension to Watch</div>
        <div style="font-size:12px;font-weight:800;color:var(--text);margin-bottom:4px">${esc2(tension.title || '')}</div>
        ${tension.gex_says ? `<div style="font-size:11px;color:var(--text2)"><b>GEX:</b> ${esc2(tension.gex_says)}</div>` : ''}
        ${tension.pcr_says ? `<div style="font-size:11px;color:var(--text2)"><b>PCR:</b> ${esc2(tension.pcr_says)}</div>` : ''}
        ${tension.resolution ? `<div style="font-size:11px;color:#f59e0b;margin-top:5px"><b>Resolution:</b> ${esc2(tension.resolution)}</div>` : ''}
      </div>
      <div style="background:rgba(255,255,255,.035);border:1px solid var(--border);border-radius:8px;padding:10px">
        <div style="font-size:11px;font-weight:900;color:#93c5fd;text-transform:uppercase;margin-bottom:4px">Bottom Line</div>
        ${bottomHtml}
        ${guide.vix_note ? `<div style="font-size:10px;color:#f59e0b;margin-top:7px">${esc2(guide.vix_note)}</div>` : ''}
        ${guide.dte_note ? `<div style="font-size:10px;color:#94a3b8;margin-top:3px">${esc2(guide.dte_note)}</div>` : ''}
      </div>
    </div>
  </div>`;
}

function _renderDailyPlan(d) {
  if (!d || d.error) return `<div class="card" style="padding:12px;color:#ef4444">❌ ${d?.error||'No data'}</div>`;

  const biasC = d.bias==='BEARISH'?'#ef4444':d.bias==='BULLISH'?'#22c55e':'#f59e0b';
  const scoreC = d.score<0?'#ef4444':d.score>0?'#22c55e':'#f59e0b';
  const gexC = d.gex?.total_gex<0?'#ef4444':'#22c55e';
  const interp = d.interpretation || {};

  // Factor grid
  const factorRows = (d.factors||[]).map(f => {
    const fc = f.score<0?'#ef4444':f.score>0?'#22c55e':'#64748b';
    const bar = Math.abs(f.score)/2*100;
    return `<div style="display:grid;grid-template-columns:110px 80px 120px 1fr;gap:6px;align-items:start;padding:6px 0;border-bottom:1px solid var(--border)">
      <span style="font-size:11px;color:var(--muted)">${f.name}</span>
      <span style="font-size:12px;font-weight:700;color:var(--text)">${f.value}</span>
      <div style="display:flex;align-items:center;gap:4px">
        <div style="flex:1;height:6px;background:var(--surface);border-radius:3px">
          <div style="width:${bar}%;height:100%;background:${fc};border-radius:3px"></div></div>
        <span style="font-size:10px;color:${fc};font-weight:700;min-width:12px">${f.score>0?'+':''}${f.score}</span>
      </div>
      <div><span style="font-size:10px;font-weight:700;color:${fc}">${f.signal}</span>
        <div style="font-size:9px;color:var(--muted)">${f.note}</div></div>
    </div>`;
  }).join('');

  // Price level map
  const levels = d.plan?.levels || [];
  const levelRows = levels.map(lv => {
    const isSpot = lv.label === 'SPOT';
    const lc = lv.label.includes('CALL')?'#22c55e':lv.label.includes('PUT')?'#ef4444':
               lv.label.includes('FLIP')?'#a855f7':lv.label.includes('BREAK')?'#f59e0b':'#94a3b8';
    return `<div style="display:flex;align-items:center;gap:8px;padding:4px 0;${isSpot?'background:rgba(255,255,255,.04);border-radius:4px;padding:6px':''}">
      <span style="min-width:120px;font-size:10px;font-weight:700;color:${lc}">${lv.label}</span>
      <span style="min-width:60px;font-size:${isSpot?'16px':'13px'};font-weight:${isSpot?900:700};color:${isSpot?'var(--accent)':lc}">${isSpot?'▶ ':''}$${lv.price}</span>
      <span style="font-size:10px;color:var(--muted)">${lv.note}</span>
    </div>`;
  }).join('');

  const interpretationHtml = (interp.dealer_bias || interp.flip_note || interp.pin_note || interp.max_pain_note) ? `
    <div style="margin:10px 0 6px;background:rgba(168,85,247,.08);border:1px solid rgba(168,85,247,.25);border-radius:8px;padding:10px 12px">
      <div style="font-size:10px;font-weight:800;color:#a855f7;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">INTERPRETATION</div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;font-size:11px;color:var(--text2)">
        ${interp.dealer_bias ? `<span><b style="color:#a855f7">Bias:</b> ${interp.dealer_bias}</span>` : ''}
        ${interp.flip_note ? `<span><b style="color:#a855f7">Flip:</b> ${interp.flip_note}</span>` : ''}
        ${interp.pin_note ? `<span><b style="color:#f59e0b">Pin:</b> ${interp.pin_note}</span>` : ''}
        ${interp.max_pain_note ? `<span><b style="color:#f59e0b">Max Pain:</b> ${interp.max_pain_note}</span>` : ''}
        ${d.gex_strength != null ? `<span><b style="color:#22c55e">Strength:</b> ${d.gex_strength}% of gross GEX</span>` : ''}
        ${d.vix_overlay?.vix != null ? `<span><b style="color:#f59e0b">VIX:</b> ${d.vix_overlay.vix} · reliability overlay</span>` : ''}
      </div>
    </div>` : '';

  const wallStrengthHtml = _renderGexWallStrength(d.wall_strength || d.significant_walls || d.walls?.significance);

  // Primary scenario
  const pr = d.plan?.primary || {};
  const prC = pr.direction==='BEARISH'?'#ef4444':'#22c55e';
  const primaryHtml = `
    <div style="background:${prC}0a;border:1px solid ${prC}33;border-radius:8px;padding:12px">
      <div style="font-size:14px;font-weight:900;color:${prC};margin-bottom:8px">${pr.direction} SETUP
        <span style="font-size:11px;font-weight:400;color:var(--muted);margin-left:8px">${d.confidence}% confidence · score ${d.score}</span>
      </div>
      <div style="font-size:11px;color:var(--muted);margin-bottom:8px">📌 ${pr.trigger}</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px">
        <div><span style="color:var(--muted)">Entry Zone: </span><b style="color:${prC}">${pr.entry_zone}</b></div>
        <div><span style="color:var(--muted)">Stop Loss: </span><b style="color:#ef4444">$${pr.stop}</b> <span style="font-size:10px;color:var(--muted)">${pr.stop_note}</span></div>
        <div><span style="color:var(--muted)">Target 1 (50%): </span><b style="color:#22c55e">$${pr.t1}</b> <span style="font-size:10px;color:var(--muted)">${pr.t1_note}</span></div>
        <div><span style="color:var(--muted)">Target 2 (40%): </span><b style="color:#22c55e">$${pr.t2}</b> <span style="font-size:10px;color:var(--muted)">${pr.t2_note}</span></div>
        ${pr.t3?`<div style="grid-column:1/-1"><span style="color:var(--muted)">Extended T3: </span><b style="color:#22c55e">$${pr.t3}</b> <span style="font-size:10px;color:var(--muted)">${pr.t3_note}</span></div>`:''}
      </div>
      <div style="margin-top:8px;font-size:12px">R:R = <b style="color:${pr.rr>=1.5?'#22c55e':'#f59e0b'}">${pr.rr}:1</b>
        <span style="color:var(--muted);margin-left:8px">($${pr.stop_dist} stop vs $${pr.reward_t2} reward)</span></div>
    </div>`;

  // Counter scenario
  const ct = d.plan?.counter || {};
  const ctC = ct.direction==='BEARISH'?'#ef4444':'#22c55e';
  const counterHtml = `
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px">
      <div style="font-size:12px;font-weight:700;color:${ctC};margin-bottom:6px">${ct.direction} COUNTER (LOW PROBABILITY)
        <span style="font-size:10px;color:var(--muted);font-weight:400"> — ${ct.trigger}</span></div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;font-size:11px">
        <div><span style="color:var(--muted)">Entry: </span><b>$${ct.entry}</b> <span style="font-size:9px;color:var(--muted)">${ct.entry_note}</span></div>
        <div><span style="color:var(--muted)">Stop: </span><b style="color:#ef4444">$${ct.stop}</b></div>
        <div><span style="color:var(--muted)">T1: </span><b style="color:#22c55e">$${ct.t1}</b></div>
      </div>
    </div>`;

  // ── Trade Suggestions ────────────────────────────────────
  const sugs = d.suggestions || [];
  const sugHtml = sugs.length ? `
    <div style="margin-top:14px">
      <div style="font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.6px;text-transform:uppercase;margin-bottom:8px">
        TRADE SUGGESTIONS · ${d.expiry} (${d.dte}d) · Based on GEX + ${d.score>0?'Bullish':d.score<0?'Bearish':'Neutral'} Score
      </div>
      ${sugs.map(s => {
        const tC = s.direction==='bullish'?'#22c55e':s.direction==='bearish'?'#ef4444':'#f59e0b';
        const tBg = s.direction==='bullish'?'rgba(34,197,94,.06)':s.direction==='bearish'?'rgba(239,68,68,.06)':'rgba(245,158,11,.06)';
        const popC = s.pop>=65?'#22c55e':s.pop>=50?'#f59e0b':'#ef4444';
        const confC = s.confidence>=70?'#22c55e':s.confidence>=55?'#f59e0b':'#ef4444';
        const typeTag = s.type==='credit'
          ? '<span style="font-size:9px;padding:1px 6px;border-radius:3px;background:rgba(168,85,247,.15);color:#c4b5fd;border:1px solid rgba(168,85,247,.3)">CREDIT</span>'
          : '<span style="font-size:9px;padding:1px 6px;border-radius:3px;background:rgba(59,130,246,.15);color:#93c5fd;border:1px solid rgba(59,130,246,.3)">DEBIT</span>';
        
        // Build strikes display
        let strikesHtml = '';
        if (s.strategy==='Iron Condor') {
          strikesHtml = `<span style="color:#ef4444">$${s.put_buy}P</span> / <span style="color:#22c55e">$${s.put_sell}P</span> &nbsp;|&nbsp; <span style="color:#22c55e">$${s.call_sell}C</span> / <span style="color:#ef4444">$${s.call_buy}C</span>`;
        } else if (s.opt_type==='put') {
          strikesHtml = s.type==='credit'
            ? `Sell <b style="color:#22c55e">$${s.sell_strike}P</b> / Buy <b style="color:#ef4444">$${s.buy_strike}P</b>`
            : `Buy <b style="color:#22c55e">$${s.buy_strike}P</b> / Sell <b style="color:#ef4444">$${s.sell_strike}P</b>`;
        } else {
          strikesHtml = s.type==='credit'
            ? `Sell <b style="color:#ef4444">$${s.sell_strike}C</b> / Buy <b style="color:#22c55e">$${s.buy_strike}C</b>`
            : `Buy <b style="color:#22c55e">$${s.buy_strike}C</b> / Sell <b style="color:#ef4444">$${s.sell_strike}C</b>`;
        }
        const pnlLine = s.type==='credit'
          ? `Net Credit: <b style="color:#22c55e">$${s.credit}</b> &nbsp; Max+: <b style="color:#22c55e">$${s.max_profit}</b> <span style="color:var(--muted)">(pts shown in card)</span> &nbsp; Max-: <b style="color:#ef4444">$${s.max_loss}</b>`
          : `Net Debit: <b style="color:#ef4444">$${s.debit}</b> &nbsp; Max+: <b style="color:#22c55e">$${s.max_profit}</b> <span style="color:var(--muted)">(pts shown in card)</span> &nbsp; Max-: <b style="color:#ef4444">$${s.max_loss}</b>`;
        const beLabel = s.upper_be ? `BE: $${s.lower_be} – $${s.upper_be}` : `BE: $${s.breakeven}`;

        return `<div style="background:${tBg};border:1px solid ${tC}33;border-radius:8px;padding:10px 12px;margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:6px">
            <div>
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
                <b style="font-size:13px;color:${tC}">${s.strategy}</b>
                ${typeTag}
                <span style="font-size:10px;color:var(--muted)">Anchor: ${s.anchor||''}</span>
              </div>
              <div style="font-size:12px;margin-bottom:4px">${strikesHtml}</div>
              <div style="font-size:11px;color:var(--muted)">${pnlLine} &nbsp; R:R <b>${s.rr}</b> &nbsp; ${beLabel}</div>
              <div style="font-size:10px;color:var(--muted);margin-top:4px;font-style:italic">${s.rationale}</div>
            </div>
            <div style="display:flex;gap:8px;flex-shrink:0">
              <div style="text-align:center;padding:6px 10px;background:${popC}18;border:1px solid ${popC}44;border-radius:6px;min-width:52px">
                <div style="font-size:9px;color:var(--muted)">PoP</div>
                <div style="font-size:16px;font-weight:900;color:${popC}">${s.pop}%</div>
              </div>
              <div style="text-align:center;padding:6px 10px;background:${confC}18;border:1px solid ${confC}44;border-radius:6px;min-width:52px">
                <div style="font-size:9px;color:var(--muted)">Conf</div>
                <div style="font-size:16px;font-weight:900;color:${confC}">${s.confidence}</div>
              </div>
            </div>
          </div>
        </div>`;
      }).join('')}
    </div>` : '';

  // 10-session history sparks
  const history = d.history || [];
  const histHtml = history.length ? `
    <div style="display:flex;gap:8px;align-items:flex-end;height:40px;margin-top:4px">
      ${history.map((h,i)=>{
        const prev = i>0?history[i-1].close:h.close;
        const up = h.close >= prev;
        return `<div title="${h.date}: $${h.close}" style="flex:1;background:${up?'#22c55e44':'#ef4444aa'};border-radius:2px 2px 0 0;min-height:6px;height:${Math.max(6,(h.close-Math.min(...history.map(x=>x.close)))/(Math.max(...history.map(x=>x.close))-Math.min(...history.map(x=>x.close))+0.01))*38}px"></div>`;
      }).join('')}
    </div>
    <div style="display:flex;gap:8px;font-size:8px;color:var(--muted)">
      ${history.map(h=>`<div style="flex:1;text-align:center;overflow:hidden">${h.date?.slice(5)}</div>`).join('')}
    </div>` : '';

  const reliabilityHtml = _renderReliabilityPanel(d.reliability);
  const trades3pmHtml   = _render3PMTrades(d.trades_3pm);
  const snapshotHtml = '';
  return `${reliabilityHtml}${snapshotHtml}
  <details open style="margin-bottom:10px">
    <summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:8px;font-weight:800;color:var(--muted);margin:0 0 8px 2px">1DTE details</summary>
    <div style="margin-top:8px">${trades3pmHtml}</div>
  </details>
  <div class="card" style="padding:0;overflow:hidden;margin-bottom:10px">
    <!-- Header -->
    <div style="display:grid;grid-template-columns:1fr auto auto auto;gap:1px;background:var(--border)">
      <div style="background:var(--card);padding:14px 16px">
        <div style="font-size:10px;color:var(--muted)">📊 DAY TRADING PLAN · ${d.date} · ${d.symbol}</div>
        <div style="font-size:22px;font-weight:900;color:${biasC};margin:4px 0">${d.bias}</div>
        <div style="font-size:11px;color:var(--muted)">Score ${d.score>0?'+':''}${d.score} · ${d.confidence}% confidence</div>
      </div>
      <div style="background:var(--card);padding:14px 16px;text-align:center;min-width:140px">
        <div style="font-size:9px;color:var(--muted)">GEX REGIME · ${d.gex?.regime}</div>
        <div style="font-size:16px;font-weight:800;color:${gexC}">${d.gex?.total_gex?.toLocaleString()} <span style="font-size:10px">$/1%</span></div>
        <div style="font-size:9px;color:var(--muted)">${d.gex?.total_gex<0?'Dealer flows AMPLIFY moves':'Dealer flows CUSHION moves'}</div>
      </div>
      <div style="background:var(--card);padding:14px 16px;text-align:center">
        <div style="font-size:9px;color:var(--muted)">SPOT · ATM IV</div>
        <div style="font-size:18px;font-weight:900;color:var(--accent)">$${d.spot}</div>
        <div style="font-size:11px;color:#a855f7">${d.iv_atm}%</div>
      </div>
      <div style="background:var(--card);padding:14px 16px;text-align:center">
        <div style="font-size:9px;color:var(--muted)">PCR · SKEW RR</div>
        <div style="font-size:16px;font-weight:800;color:${d.pcr>1.2?'#ef4444':'#22c55e'}">${d.pcr}</div>
        <div style="font-size:11px;color:${d.skew_rr<0?'#ef4444':'#22c55e'}">${d.skew_rr}%</div>
      </div>
    </div>

    <!-- Sub-header: regime + sigma range -->
    <div style="background:${biasC}18;border-bottom:1px solid ${biasC}33;padding:8px 16px;display:flex;gap:16px;flex-wrap:wrap;align-items:center">
      <span style="font-size:12px;font-weight:800;color:${biasC}">${d.regime}</span>
      ${d.sub_regime?`<span style="font-size:11px;color:var(--muted)">${d.sub_regime}</span>`:''}
      <span style="font-size:11px;color:var(--muted)">1σ Range: <b style="color:var(--text)">${d.sigma_range?.low} – ${d.sigma_range?.high}</b> (±$${d.sigma_1d})</span>
      <span style="font-size:11px;color:var(--muted)">Gamma Flip: <b style="color:#a855f7">$${d.gex?.gamma_flip||'N/A'}</b></span>
      <span style="font-size:11px;color:var(--muted)">GEX Pin: <b style="color:#f59e0b">$${d.gex?.pin_strike||'N/A'}</b></span>
      <span style="font-size:11px;color:var(--muted)">Max Pain: <b style="color:#f59e0b">$${d.max_pain||'N/A'}</b></span>
      <span style="font-size:11px;color:var(--muted)">Expiry: <b>${d.expiry}</b> (${d.dte}d)</span>
    </div>

    <div style="display:grid;grid-template-columns:1fr 300px;gap:1px;background:var(--border)">
      <!-- Left: factor grid + trade scenarios -->
      <div style="background:var(--card);padding:14px">
        <div style="font-size:12px;font-weight:700;color:var(--muted);margin-bottom:8px">${(d.composite_grid && d.composite_grid.label ? d.composite_grid.label.toUpperCase() : '7-FACTOR GEX COMPOSITE GRID')}</div>
        ${factorRows}
        ${interpretationHtml}
        ${_renderGexActionGuide(d.action_guide)}
        ${wallStrengthHtml}
        <div style="margin-top:14px">${primaryHtml}</div>
        <div style="margin-top:8px">${counterHtml}</div>
        ${sugHtml}
      </div>
      <!-- Right: key levels + history -->
      <div style="background:var(--card);padding:14px">
        <div style="font-size:12px;font-weight:700;color:var(--muted);margin-bottom:8px">KEY LEVELS</div>
        ${levelRows}
        ${history.length?`<div style="margin-top:14px"><div style="font-size:11px;color:var(--muted);margin-bottom:4px">PRICE HISTORY (${history.length}d)</div>${histHtml}</div>`:''}
      </div>
    </div>
  </div>`;
}

async function _updateSectors() {
  const stEl = document.getElementById('sector-update-status');
  if (stEl) stEl.innerHTML = '⏳ Fetching sectors for all symbols (~2 min)…';
  try {
    const d = await api('/api/update_sectors?force=true', {method: 'POST'});
    if (stEl) stEl.innerHTML = `✅ ${d.updated}/${d.total} sectors updated`;
  } catch(e) {
    if (stEl) stEl.innerHTML = `❌ ${e.message}`;
  }
}


// PRE-EARNINGS SCREENER

async function _runPreEarningsScan(fetchAll=false) {
  const days = document.getElementById('earn-days-ahead')?.value || 30;
  const wlId = document.getElementById('earn-watchlist')?.value || '';
  const stEl = document.getElementById('pre-earn-status');
  const resEl = document.getElementById('pre-earn-result');
  const btn   = document.getElementById('btn-pre-earnings');
  _earnShowSection('screener');
  if (stEl) stEl.innerHTML = '⏳ Scanning earnings calendar…';
  if (resEl) resEl.innerHTML = '<div style="padding:16px;color:var(--muted)">⏳ Fetching earnings, IV, OI, price action… (60–90s)</div>';
  if (btn) btn.disabled = true;
  try {
    const _preT0 = Date.now();
    const d = await api(`/earnings/pre_earnings_scan?days=${days}${wlId ? '&watchlist_id='+wlId : ''}`);
    const results = d.results || [];
    const _preElapsed = ((Date.now()-_preT0)/1000).toFixed(1);
    const _preTs = d.completed_at || new Date().toLocaleString();
    if (stEl) stEl.innerHTML = `✅ ${d.count} symbols · within ${days}d · Last run: ${_preTs} · took ${_preElapsed}s`;
    addNotif('ok', '✅ Pre-Earnings scan complete', `${d.count} symbols · ${_preTs} · ${_preElapsed}s`, 'Pre-Earnings');
    _updateMetaBar();
    if (resEl) resEl.innerHTML = _renderPreEarningsTable(results);
    // Save to DB
    try {
      const saveRes = await api('/api/pre_earnings_cache', {method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({results, date: new Date().toISOString().slice(0,10), watchlist_id: wlId || null})
      });
      if (stEl && saveRes?.ok) {
        stEl.innerHTML += ' · <span style="color:#22c55e">💾 saved</span>';
      }
    } catch(saveErr) {
      if (stEl) stEl.innerHTML += ` · <span style="color:#f59e0b">⚠ save failed: ${saveErr.message}</span>`;
    }
  } catch(e) {
    if (stEl) stEl.innerHTML = `❌ ${e.message}`;
    if (resEl) resEl.innerHTML = '';
  } finally {
    if (btn) btn.disabled = false;
  }
}

async function _loadPreEarningsFromDB(silent=false) {
  const stEl = document.getElementById('pre-earn-status');
  const resEl = document.getElementById('pre-earn-result');
  if (!silent) _earnShowSection('screener');
  if (stEl && !silent) stEl.innerHTML = '⏳ Loading saved scan…';
  try {
    const wlId = document.getElementById('earn-watchlist')?.value || '';
    const d = await api('/api/pre_earnings_cache' + (wlId ? '?watchlist_id='+wlId : ''));
    if (!d.results?.length) {
      if (stEl) stEl.innerHTML = '⚠ No saved data — click 📊 Scan Earnings first';
      return;
    }
    if (stEl) stEl.innerHTML = `💾 From ${d.date||'cache'} · ${d.results.length} symbols <span style="color:var(--muted);font-size:10px">(click 🔄 to refresh)</span>`;
    if (resEl) resEl.innerHTML = _renderPreEarningsTable(d.results);
    if (!silent) _earnShowSection('screener');
  } catch(e) {
    if (stEl) stEl.innerHTML = `❌ ${e.message}`;
  }
}

function _earnShowSection(which) {
  if (which === 'screener') _earnNav('pre');
  else _earnNav('detail');
}

function _earnNav(panel) {
  // Panels: pre | post | detail
  const panels = ['pre','post','detail'];
  panels.forEach(p => {
    const el = document.getElementById(`earn-panel-${p}`);
    const ctrl = document.getElementById(`earn-ctrl-${p}`);
    const btn  = document.getElementById(`earn-nav-${p}`);
    if (el)   el.style.display   = p===panel ? '' : 'none';
    if (ctrl) ctrl.style.display = p===panel ? 'flex' : 'none';
    if (btn)  { btn.className = p===panel ? 'btn btn-primary' : 'btn btn-ghost'; }
  });
}

function _renderPreEarningsTable(results) {
  if (!results || !results.length) return '<div style="padding:16px;color:var(--muted)">No upcoming earnings in this window.</div>';
  const fmt = (v, suffix='') => (v == null || isNaN(v)) ? '—' : (v > 0 ? '+' : '') + Number(v).toFixed(1) + suffix;
  const fmtN = (v, d=2) => (v == null || isNaN(v)) ? '—' : Number(v).toFixed(d);
  const cols = `<tr style="background:rgba(255,255,255,.04)">
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Symbol</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Earn Date</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Days</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Spot</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Vol Ratio</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">IV%</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Exp ±</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">52W %</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Last EPS</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Est</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Surp%</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Streak</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Earn Rx%</th>
    <th style="padding:6px 8px;font-size:11px;color:var(--muted)">Analyst</th>
  </tr>`;
  const rows = results.map(r => {
    const surpC = (r.last_surp_pct||r.surp_pct||0) > 0 ? '#22c55e' : '#ef4444';
    const rxC   = (r.earn_react||r.hist_move||0) > 0 ? '#22c55e' : '#ef4444';
    const daysC = r.earn_days <= 3 ? '#ef4444' : r.earn_days <= 7 ? '#f59e0b' : '#22c55e';
    const confBadge = r.earn_confirmed ? '✅' : '❓';
    return `<tr style="border-bottom:1px solid var(--border)">
      <td style="padding:5px 8px;font-weight:800;color:var(--accent)">${r.symbol}</td>
      <td style="padding:5px 8px;font-size:11px">${confBadge} ${r.earn_date||'—'}</td>
      <td style="padding:5px 8px;font-weight:700;color:${daysC}">${r.earn_days??'—'}d</td>
      <td style="padding:5px 8px">$${(r.spot||0).toFixed(2)}</td>
      <td style="padding:5px 8px;color:${(r.vol_ratio||0)>1.5?'#f59e0b':'var(--text2)'}">${fmtN(r.vol_ratio,1)}×</td>
      <td style="padding:5px 8px">${r.iv_atm ? r.iv_atm+'%' : '—'}</td>
      <td style="padding:5px 8px;color:#818cf8">${r.exp_move_pct ? '±'+r.exp_move_pct+'%' : '—'}</td>
      <td style="padding:5px 8px;font-size:11px">${fmt(r.pct_52hi,'%')}</td>
      <td style="padding:5px 8px;font-size:11px">${fmtN(r.last_eps_act||r.last_eps_actual)}</td>
      <td style="padding:5px 8px;font-size:11px;color:var(--muted)">${fmtN(r.last_eps_est||r.last_eps_estimate)}</td>
      <td style="padding:5px 8px;font-weight:700;color:${surpC}">${fmt(r.last_surp_pct||r.surp_pct,'%')}</td>
      <td style="padding:5px 8px;text-align:center">${r.surp_streak!=null?r.surp_streak+'Q':'—'}</td>
      <td style="padding:5px 8px;font-weight:700;color:${rxC}">${fmt(r.earn_react||r.earn_reaction_pct||r.hist_move,'%')}</td>
      <td style="padding:5px 8px;font-size:10px;color:var(--muted)">${r.analyst_rating||'—'}</td>
    </tr>`;
  }).join('');
  return `<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead>${cols}</thead><tbody>${rows}</tbody></table></div>`;
}

let _peSortDir = 1;
let _peSortField = 'earn_days';
function _peSortBy(field) {
  if (_peSortField === field) _peSortDir *= -1;
  else { _peSortField = field; _peSortDir = 1; }
}

// OI Dashboard  –  app.js  v5.4
// OI Dashboard app.js — v5.4 | P&L Fix · Health Alerts: All Trades + Strikes · Smart Telegram · No Dupes
// All event listeners inside DOMContentLoaded.
// Aggregate defaults to first future expiry.
// Scanner has expiry filter (future only).
// SQL viewer jsonify fix applied on backend; JS unchanged.

'use strict';

// ════════════════════════════════════════════════════════════════════════════
// POST-EARNINGS SCANNER
// ════════════════════════════════════════════════════════════════════════════
async function _runPostEarningsScan(fetchAll=false) {
  const days = document.getElementById('post-earn-days')?.value || 10;
  const wlId = document.getElementById('earn-watchlist')?.value || '';
  const stEl  = document.getElementById('post-earn-status');
  const resEl = document.getElementById('post-earn-result');
  const btn   = document.getElementById('btn-post-earnings');
  const btnAll= document.getElementById('btn-post-all');
  _earnNav('post');
  const modeLabel = fetchAll ? 'all symbols' : 'new symbols only';
  if (btn) btn.textContent = fetchAll ? '🔄 Scanning…' : '⚡ Scanning…';
  if (stEl) stEl.innerHTML = `⏳ Scanning ${modeLabel}…`;
  if (resEl) resEl.innerHTML = `<div style="padding:16px;color:var(--muted)">⏳ ${fetchAll?'Re-fetching all':'Fetching new'} symbols…</div>`;
  if (btn) btn.disabled = true;
  if (btnAll) btnAll.disabled = true;
  try {
    const _postT0 = Date.now();
    const d = await api(`/earnings/post_earnings_scan?days=${days}&fetch_all=${fetchAll}${wlId ? '&watchlist_id='+wlId : ''}`);
    if (d.error) { addNotif('error', 'Post Earnings scan failed', (d.error||'')+(d.trace?'\n'+d.trace:''), 'Post Earnings'); }
    const results = d.results || [];
    const cacheInfo2 = d.from_cache > 0 ? ` (${d.new_fetched} new + ${d.from_cache} cached)` : '';
    const _postElapsed = ((Date.now()-_postT0)/1000).toFixed(1);
    const _postTs = d.completed_at || new Date().toLocaleString();
    if (stEl) stEl.innerHTML = `✅ ${d.count} symbols${cacheInfo2} · Last run: ${_postTs} · took ${_postElapsed}s`;
    addNotif('ok', '✅ Post-Earnings scan complete', `${d.count} symbols · ${_postTs} · ${_postElapsed}s`, 'Post-Earnings');
    _updateMetaBar();
    if (resEl) resEl.innerHTML = results.length
      ? _renderPostEarningsTable(results)
      : '<div style="padding:16px;color:var(--muted)">No post-earnings results in the last '+days+' days. Try increasing the days range or run <b>📅 Fetch Earnings Calendar</b> in Settings first.</div>';
    if (!results.length) {
      addNotif('info', 'Post-Earnings: 0 results',
        'No symbols with earnings in the last '+days+' days. Run "Fetch Earnings Calendar" in Settings to populate earnings dates.',
        'Post-Earnings');
    }
  } catch(e) {
    addNotif('error', 'Post Earnings scan error', e.message, 'Post Earnings');
    if (stEl) stEl.innerHTML = `❌ ${e.message}`;
    if (resEl) resEl.innerHTML = '';
  } finally {
    if (btn)    { btn.disabled = false; btn.textContent = '⚡ Scan New'; }
    if (btnAll) { btnAll.disabled = false; btnAll.textContent = '🔄 Fetch All'; }
  }
}

async function _loadPostEarningsFromDB(silent=false) {
  const stEl  = document.getElementById('post-earn-status');
  const resEl = document.getElementById('post-earn-result');
  if (!silent) _earnNav('post');
  if (stEl && !silent) stEl.innerHTML = '⏳ Loading saved scan…';
  try {
    const wlId = document.getElementById('earn-watchlist')?.value || '';
    const d = await api('/api/post_earnings_cache' + (wlId ? '?watchlist_id='+wlId : ''));
    if (!d.results?.length) {
      if (stEl) stEl.innerHTML = '⚠ No saved data — click 📊 Scan';
      return;
    }
    if (stEl) stEl.innerHTML = `💾 From ${d.date||'cache'} · ${d.results.length} symbols <span style="color:var(--muted);font-size:10px">(🔄 to refresh)</span>`;
    if (resEl) resEl.innerHTML = _renderPostEarningsTable(d.results);
  } catch(e) {
    if (stEl && !silent) stEl.innerHTML = `❌ ${e.message}`;
  }
}

function _renderPostEarningsTable(rows) {
  if (!rows.length) return '<div style="padding:20px;color:var(--muted)">No earnings found in the specified window.</div>';

  const verdictBadge = (v, reaction) => {
    const c = v==='BEAT'?'#22c55e':v==='MISS'?'#ef4444':v==='MIXED'?'#f59e0b':'#64748b';
    const rC = reaction>0?'#22c55e':reaction<0?'#ef4444':'var(--muted)';
    return `<span style="background:${c}18;color:${c};border:1px solid ${c}44;border-radius:4px;padding:2px 7px;font-size:10px;font-weight:700">${v}</span>
      <span style="color:${rC};font-size:10px;font-weight:700;margin-left:4px">${reaction>0?'+':''}${reaction}%</span>`;
  };

  const trendBadge = (trend, move) => {
    const c = trend==='UP'?'#22c55e':trend==='DOWN'?'#ef4444':'#f59e0b';
    const arr = trend==='UP'?'↑':trend==='DOWN'?'↓':'→';
    return `<span style="color:${c};font-weight:700">${arr} ${trend}</span>
      <span style="font-size:10px;color:${move>=0?'#22c55e':'#ef4444'};margin-left:4px">${move>=0?'+':''}${move}%</span>`;
  };

  const tradeCards = (trades) => {
    if (!trades?.length) return '<span style="color:var(--dim);font-size:10px">No data</span>';
    return trades.map(t => {
      const sc = t.confidence>=70?'#22c55e':t.confidence>=55?'#f59e0b':'#ef4444';
      const popC = t.pop>=60?'#22c55e':t.pop>=45?'#f59e0b':'#ef4444';
      const dirC = t.direction==='bullish'?'#22c55e':t.direction==='bearish'?'#ef4444':'#f59e0b';
      const tc = t.type==='credit'?'rgba(168,85,247,.12)':'rgba(59,130,246,.1)';
      const tl = t.type==='credit'?'#c4b5fd':'#93c5fd';
      return `<div style="background:${tc};border-radius:5px;padding:6px 9px;margin-bottom:5px;min-width:260px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;flex-wrap:wrap;gap:4px">
          <b style="font-size:11px;color:${dirC}">${t.strategy}</b>
          <span style="font-size:9px;padding:1px 5px;background:${tc};color:${tl};border-radius:3px">${t.type?.toUpperCase()}</span>
        </div>
        <div style="font-size:10px;color:var(--accent);font-family:monospace;margin-bottom:2px">📋 ${t.entry}</div>
        <div style="font-size:9px;color:var(--muted)">🎯 ${t.target}</div>
        <div style="font-size:9px;color:#ef4444">🛑 Stop: ${t.stop}</div>
        <div style="font-size:9px;color:var(--muted);margin:2px 0;line-height:1.3">${t.rationale}</div>
        <div style="font-size:9px;color:#f59e0b;margin-bottom:4px">📊 ${t.sr_key}</div>
        <div style="display:flex;gap:8px;font-size:10px;flex-wrap:wrap">
          <span>Conf: <b style="color:${sc}">${t.confidence}</b></span>
          <span>PoP: <b style="color:${popC}">${t.pop}%</b></span>
          <span>R:R: <b style="color:#a5b4fc">${t.rr}</b></span>
        </div>
      </div>`;
    }).join('');
  };

  const th = l => `<th style="padding:6px 8px;font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;background:#0b1322;border-bottom:1px solid var(--border2)">${l}</th>`;

  return `<div style="overflow-x:auto">
  <table style="width:100%;border-collapse:collapse;font-size:12px">
  <thead><tr>
    ${th('Symbol')} ${th('Earn Date')} ${th('Verdict')} ${th('EPS')} ${th('Rev')}
    ${th('Post Trend')} ${th('Total Mv')} ${th('Vol (Earn)')} ${th('IV')} ${th('PCR')}
    ${th('S/R Levels')} ${th('Market')} ${th('Trades')}
  </tr></thead>
  <tbody>` +
  rows.map((r,i) => {
    const epsC = r.eps_beat===true?'#22c55e':r.eps_beat===false?'#ef4444':'#64748b';
    const revC = r.rev_beat===true?'#22c55e':r.rev_beat===false?'#ef4444':'#64748b';
    const ivC  = r.iv_atm>50?'#ef4444':r.iv_atm>30?'#f59e0b':'#22c55e';
    const mktC = (r.spy_regime||'').includes('Bull')?'#22c55e':(r.spy_regime||'').includes('Bear')?'#ef4444':'#64748b';
    return `<tr style="border-bottom:1px solid var(--border);${i%2?'background:var(--surface)':''}">
      <td style="padding:5px 10px;font-weight:800;color:var(--accent)">${r.symbol}</td>
      <td style="padding:5px 8px;font-family:monospace;font-size:11px;text-align:center">
        <div>${r.earn_date?.slice(5)||'?'}</div>
        <div style="color:var(--muted);font-size:9px">${r.days_since}d ago</div>
      </td>
      <td style="padding:5px 8px;white-space:nowrap">${verdictBadge(r.verdict, r.earn_reaction)}</td>
      <td style="padding:5px 8px;text-align:center">
        <span style="color:${epsC};font-weight:700;font-size:11px">${r.eps_beat===true?'✓ Beat':r.eps_beat===false?'✗ Miss':'—'}</span>
        ${r.eps_actual!=null?`<div style="font-size:9px;color:var(--muted)">${r.eps_actual?.toFixed(2)||'—'} vs ${r.eps_est?.toFixed(2)||'—'}</div>`:''}
      </td>
      <td style="padding:5px 8px;text-align:center">
        <span style="color:${revC};font-weight:700;font-size:11px">${r.rev_beat===true?'✓ Beat':r.rev_beat===false?'✗ Miss':'—'}</span>
      </td>
      <td style="padding:5px 8px;white-space:nowrap">${trendBadge(r.recent_trend, r.post_move)}</td>
      <td style="padding:5px 8px;text-align:right;font-family:monospace;font-weight:700;color:${r.total_move>=0?'#22c55e':'#ef4444'}">${r.total_move>=0?'+':''}${r.total_move}%</td>
      <td style="padding:5px 8px;text-align:center;font-family:monospace;color:${r.vol_ratio>150?'#a855f7':r.vol_ratio>120?'#22c55e':'var(--muted)'}">${r.vol_ratio||'—'}%</td>
      <td style="padding:5px 8px;text-align:right;font-family:monospace;color:${ivC}">${r.iv_atm!=null?r.iv_atm+'%':'—'}</td>
      <td style="padding:5px 8px;text-align:right;font-family:monospace;color:${r.pcr>1.2?'#ef4444':r.pcr<0.8?'#22c55e':'#f59e0b'}">${r.pcr??'—'}</td>
      <td style="padding:5px 8px;font-size:10px;font-family:monospace;white-space:nowrap">
        <div>S: <b style="color:#ef4444">$${r.support}</b></div>
        <div>R: <b style="color:#22c55e">$${r.resistance}</b></div>
        <div style="color:var(--muted)">SMA: $${r.sma_20}</div>
      </td>
      <td style="padding:5px 8px;font-size:10px;white-space:nowrap">
        <span style="color:${mktC};font-weight:700">${r.spy_regime||'—'}</span>
      </td>
      <td style="padding:5px 8px;min-width:270px">${tradeCards(r.trades)}</td>
    </tr>`;
  }).join('') +
  '</tbody></table></div>';
}

// ════════════════════════════════════════════════════════════════════════════
// S/R TAB PANEL NAVIGATION + PROXIMITY SCANNER
// ════════════════════════════════════════════════════════════════════════════

function _srNav(panel) {
  ['breakout','proximity','failed','hllh','age'].forEach(p => {
    const panEl  = document.getElementById(`sr-panel-${p}`);
    const ctrlEl = document.getElementById(`sr-ctrl-${p}`);
    const btnEl  = document.getElementById(`sr-nav-${p}`);
    if (panEl)  panEl.style.display  = p===panel ? '' : 'none';
    if (ctrlEl) ctrlEl.style.display = p===panel ? 'flex' : 'none';
    if (btnEl)  btnEl.className      = p===panel ? 'btn btn-primary' : 'btn btn-ghost';
  });
}
// ════════════════════════════════════════════════════════════════════════════
// FAILED BREAKOUT SCANNER
// ════════════════════════════════════════════════════════════════════════════

async function runFailedBreakout() {
  _srNav('failed');
  var st  = document.getElementById('sr-fb-status');
  var el  = document.getElementById('sr-fb-results');
  var lk  = document.getElementById('sr-fb-lookback')?.value  || 10;
  var str = document.getElementById('sr-fb-strength')?.value  || 30;
  var earn = document.getElementById('sr-min-earn-days')?.value || '';
  var wlId= document.getElementById('sr-watchlist')?.value    || '';

  if (st) st.innerHTML = '⏳ Scanning failed breakouts…';
  if (el) el.innerHTML = '';

  try {
    var url = '/scanner/sr/failed_breakout?lookback_days=' + lk + '&min_strength=' + str + (earn ? '&min_earn_days=' + earn : '');
    if (wlId) url += '&watchlist_id=' + wlId;
    var d = await api(url);
    var results = d.results || [];
    if (st) st.innerHTML = results.length
      ? ('✅ ' + results.length + ' signals | lookback ' + lk + 'd')
      : '✅ No signals found';
    if (el) el.innerHTML = _renderFBResults(results);
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

function _renderFBResults(results) {
  if (!results.length) return '<div style="color:var(--muted);font-size:12px;padding:16px">No failed breakouts found. Try reducing Min S/R Strength or increasing Lookback Days.</div>';

  var bull = results.filter(function(r){ return String(r.direction||'').toLowerCase()==='bullish'; });
  var bear = results.filter(function(r){ return String(r.direction||'').toLowerCase()==='bearish'; });

  function _table(rows, title, color) {
    if (!rows.length) return '';
    var hdr = '<div style="font-size:12px;font-weight:700;color:'+color+';margin:12px 0 6px">'+title+' ('+rows.length+')</div>';
    var cols = ['Symbol','Setup','Final','Native','Comp','Edge Scores','Age','Spot','S/R Level','Reached','Move','Detail'];
    var thead = '<tr style="background:var(--surface)">'
      + cols.map(function(c){ return '<th style="padding:5px 8px;font-size:10px;color:var(--muted);font-weight:600;text-align:left">'+c+'</th>'; }).join('')
      + '</tr>';
    var tbody = rows.map(function(r) {
      var isBull = String(r.direction||'').toLowerCase()==='bullish';
      var move = isBull
        ? ('<span style="color:#22c55e">+'+r.recovery_pct+'%</span>')
        : ('<span style="color:#ef4444">−'+r.pullback_pct+'%</span>');
      var reached = isBull ? r.low_reached : r.high_reached;
      return '<tr style="border-bottom:1px solid var(--border)">'
        + '<td style="padding:5px 8px;font-weight:700">'+r.symbol+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+r.icon+' '+r.setup+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.final_score ?? r.score ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.native_score ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.composite_score ?? r.edge_score ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px;min-width:220px">'+_edgeScoreCell(r)+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.trend_age ?? r.days_ago ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">$'+r.spot+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">$'+r.res_lo+'–$'+r.res_hi+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">$'+reached+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+move+'</td>'
        + '<td style="padding:4px 8px;font-size:10px;color:var(--text2);max-width:300px">'+r.detail+'</td>'
        + '</tr>';
    }).join('');
    return hdr + '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse">'+thead+tbody+'</table></div>';
  }

  var html = _table(bull, 'Failed Breakdowns (Bullish — support held)', '#22c55e');
  html    += _table(bear, 'Failed Breakouts (Bearish — resistance rejected)', '#ef4444');

  // Legend
  html += '<div style="margin-top:10px;padding:8px 12px;background:var(--surface);border-radius:6px;font-size:10px;color:var(--muted)">'
    + '<b>Failed Breakdown:</b> Price dipped below support but recovered — bulls defended the level. '
    + 'Watch for continuation above support. &nbsp;|&nbsp; '
    + '<b>Failed Breakout:</b> Price broke above resistance but got rejected and fell back. '
    + 'Bears defended resistance — watch for further downside.</div>';
  return html;
}

// ════════════════════════════════════════════════════════════════════════════
// HIGHER LOW / LOWER HIGH SCANNER
// ════════════════════════════════════════════════════════════════════════════

async function runHLLH() {
  _srNav('hllh');
  var st   = document.getElementById('sr-hllh-status');
  var el   = document.getElementById('sr-hllh-results');
  var days = document.getElementById('sr-hllh-days')?.value   || 5;
  var prd  = document.getElementById('sr-hllh-period')?.value || 5;
  var earn = document.getElementById('sr-min-earn-days')?.value || '';
  var wlId = document.getElementById('sr-watchlist')?.value   || '';

  if (st) st.innerHTML = '⏳ Scanning Higher Lows / Lower Highs…';
  if (el) el.innerHTML = '';

  try {
    var url = '/scanner/sr/hl_lh?x_days=' + days + '&swing_period=' + prd + (earn ? '&min_earn_days=' + earn : '');
    if (wlId) url += '&watchlist_id=' + wlId;
    var d = await api(url);
    var results = d.results || [];
    if (st) st.innerHTML = results.length
      ? ('✅ ' + results.length + ' signals | last ' + days + 'd')
      : '✅ No signals found';
    if (el) el.innerHTML = _renderHLLHResults(results);
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

function _renderHLLHResults(results) {
  if (!results.length) return '<div style="color:var(--muted);font-size:12px;padding:16px">No Higher Low / Lower High signals found. Try increasing days or reducing swing period.</div>';

  var hl = results.filter(function(r){ return r.setup==='Higher Low'; });
  var lh = results.filter(function(r){ return r.setup==='Lower High'; });

  function _table(rows, title, color) {
    if (!rows.length) return '';
    var hdr = '<div style="font-size:12px;font-weight:700;color:'+color+';margin:12px 0 6px">'+title+' ('+rows.length+')</div>';
    var cols = ['Symbol','Setup','Final','Native','Comp','Edge Scores','Age','Spot','Last Swing','Prev Swing','Change','Detail'];
    var thead = '<tr style="background:var(--surface)">'
      + cols.map(function(c){ return '<th style="padding:5px 8px;font-size:10px;color:var(--muted);font-weight:600;text-align:left">'+c+'</th>'; }).join('')
      + '</tr>';
    var tbody = rows.map(function(r) {
      var chg = r.setup==='Higher Low'
        ? ('<span style="color:#22c55e">+'+r.swing_rise+'%</span>')
        : ('<span style="color:#ef4444">−'+r.swing_drop+'%</span>');
      return '<tr style="border-bottom:1px solid var(--border)">'
        + '<td style="padding:5px 8px;font-weight:700">'+r.symbol+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+r.icon+' '+r.setup+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.final_score ?? r.score ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.native_score ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.composite_score ?? r.edge_score ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px;min-width:220px">'+_edgeScoreCell(r)+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+(r.trend_age ?? r.days_ago ?? '—')+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">$'+r.spot+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">$'+r.last_swing+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">$'+r.prev_swing+'</td>'
        + '<td style="padding:5px 8px;font-size:11px">'+chg+'</td>'
        + '<td style="padding:4px 8px;font-size:10px;color:var(--text2);max-width:300px">'+r.detail+'</td>'
        + '</tr>';
    }).join('');
    return hdr + '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse">'+thead+tbody+'</table></div>';
  }

  var html = _table(hl, '� Higher Lows (Bullish structure — rising floor)', '#22c55e');
  html    += _table(lh, '� Lower Highs (Bearish structure — falling ceiling)', '#ef4444');

  html += '<div style="margin-top:10px;padding:8px 12px;background:var(--surface);border-radius:6px;font-size:10px;color:var(--muted)">'
    + '<b>� Higher Low:</b> Most recent swing low is higher than previous — rising demand floor, potential uptrend start or continuation. '
    + '&nbsp;|&nbsp; '
    + '<b>� Lower High:</b> Most recent swing high is lower than previous — falling supply ceiling, potential downtrend start or continuation. '
    + 'Strongest signals when combined with volume confirmation.</div>';
  return html;
}

async function _runSRProximity() {
  const prox   = document.getElementById('sr-prox-pct')?.value    || 3;
  const rsiF   = document.getElementById('sr-prox-rsi')?.value    || 'all';
  const sector = document.getElementById('sr-prox-sector')?.value || '';
  const earn   = document.getElementById('sr-min-earn-days')?.value || '';
  const stEl   = document.getElementById('sr-prox-status');
  const resEl  = document.getElementById('sr-prox-result');
  const btn    = document.getElementById('btn-prox-scan');

  _srNav('proximity');
  if (stEl)  stEl.innerHTML  = `⏳ Scanning symbols within ${prox}% of S/R…`;
  if (resEl) resEl.innerHTML = '<div style="padding:16px;color:var(--muted)">⏳ Computing S/R levels, RSI, volume across watchlist… (30-60s)</div>';
  if (btn)   btn.disabled    = true;

    const tfs = ['daily','weekly','monthly','4h'].filter(
    id => document.getElementById('sr-tf-'+id)?.checked
  );
  const tfsParam = tfs.length ? tfs.join(',') : 'daily';
  try {
    const _prxWlId = document.getElementById('sr-watchlist')?.value || '';
    const _prxWlQ  = _prxWlId ? `&watchlist_id=${_prxWlId}` : '';
    const d = await api(`/scanner/sr/proximity?proximity=${prox}&rsi_filter=${rsiF}&sector=${encodeURIComponent(sector)}&timeframes=${tfsParam}${earn ? '&min_earn_days=' + earn : ''}${_prxWlQ}`);
    const results = d.results || [];
    if (stEl) stEl.innerHTML = `✅ ${results.length} symbols within ${prox}% of S/R`;
    if (resEl) resEl.innerHTML = _renderSRProximityTable(results);
    // Save to DB
    try {
      const sv = await api('/api/sr_proximity_cache', {method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({results, date: new Date().toISOString().slice(0,10), watchlist_id: wlId || null})
      });
      if (sv?.ok && stEl) stEl.innerHTML += ' · <span style="color:#22c55e">💾 saved</span>';
    } catch {}
  } catch(e) {
    if (stEl)  stEl.innerHTML  = `❌ ${e.message}`;
    if (resEl) resEl.innerHTML = '';
  } finally {
    if (btn) btn.disabled = false;
  }
}

async function _loadSRProximityFromDB(silent=false) {
  const stEl  = document.getElementById('sr-prox-status');
  const resEl = document.getElementById('sr-prox-result');
  if (!silent) _srNav('proximity');
  try {
    const d = await api('/api/sr_proximity_cache');
    if (!d.results?.length) {
      if (stEl && !silent) stEl.innerHTML = '⚠ No saved data — click 🎯 Scan';
      return;
    }
    if (stEl) stEl.innerHTML = `💾 From ${d.date||'cache'} · ${d.results.length} symbols`;
    if (resEl) resEl.innerHTML = _renderSRProximityTable(d.results);
  } catch(e) {
    if (stEl && !silent) stEl.innerHTML = `❌ ${e.message}`;
  }
}

function _renderSRProximityTable(rows) {
  if (!rows.length) return `<div style="padding:24px;text-align:center;color:var(--muted)">
    <div style="font-size:28px;margin-bottom:8px;opacity:.4">🎯</div>
    No symbols found within the specified proximity. Try increasing the % threshold.</div>`;

  const signalBadge = (sig) => {
    const c = sig==='BULLISH'?'#22c55e':sig==='BEARISH'?'#ef4444':'#f59e0b';
    const ic= sig==='BULLISH'?'↑':sig==='BEARISH'?'↓':'→';
    return `<span style="background:${c}18;color:${c};border:1px solid ${c}44;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700">${ic} ${sig}</span>`;
  };

  const srBadge = (type, dist) => {
    const c = type==='support'?'#22c55e':'#ef4444';
    const label = type==='support'?'Support':'Resistance';
    return `<span style="color:${c};font-weight:700;font-size:11px">${label}</span>
      <span style="font-size:10px;color:var(--muted);margin-left:3px">${dist>0?'+':''}${dist}%</span>`;
  };

  const rsiCell = (rsi, delta) => {
    const c = rsi>=70?'#ef4444':rsi>=65?'#f97316':rsi<=30?'#22c55e':rsi<=35?'#86efac':'var(--text2)';
    const label = rsi>=70?'OB':rsi>=65?'Near OB':rsi<=30?'OS':rsi<=35?'Near OS':'';
    const dc = delta>20?'#22c55e':delta<-20?'#ef4444':'var(--muted)';
    return `<td style="padding:5px 8px;text-align:center">
      <div style="font-family:monospace;font-weight:700;color:${c}">${rsi}</div>
      ${label?`<div style="font-size:9px;color:${c}">${label}</div>`:''}
      <div style="font-size:9px;color:${dc}" title="RSI − EMA90">Δ${delta>0?'+':''}${delta}</div>
    </td>`;
  };

  const scoreBar = (score, pop) => {
    const sc = score>=70?'#22c55e':score>=50?'#f59e0b':'#ef4444';
    const pc = pop  >=60?'#22c55e':pop  >=45?'#f59e0b':'#ef4444';
    return `<td style="padding:5px 8px;white-space:nowrap">
      <div style="display:flex;gap:6px;align-items:center;margin-bottom:3px">
        <div style="font-size:9px;color:var(--muted);width:28px">Score</div>
        <div style="flex:1;height:5px;background:var(--border2);border-radius:3px;overflow:hidden;min-width:50px">
          <div style="width:${score}%;height:100%;background:${sc};border-radius:3px"></div>
        </div>
        <b style="font-size:11px;color:${sc};min-width:24px;text-align:right">${score}</b>
      </div>
      <div style="display:flex;gap:6px;align-items:center">
        <div style="font-size:9px;color:var(--muted);width:28px">PoP</div>
        <div style="flex:1;height:5px;background:var(--border2);border-radius:3px;overflow:hidden;min-width:50px">
          <div style="width:${pop}%;height:100%;background:${pc};border-radius:3px"></div>
        </div>
        <b style="font-size:11px;color:${pc};min-width:28px;text-align:right">${pop}%</b>
      </div>
    </td>`;
  };

  const th = (t, tip='') =>
    `<th style="padding:6px 8px;font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;background:#0b1322;border-bottom:1px solid var(--border2)" title="${tip}">${t}</th>`;

  const header = `<div style="overflow-x:auto">
    <table style="width:100%;border-collapse:collapse;font-size:12px">
    <thead><tr>
      ${th('Symbol')} ${th('Spot','Current price')}
      ${th('S/R Level','Support or Resistance zone price')}
      ${th('Distance','% from current price to S/R zone')}
      ${th('Strength','S/R zone strength 0-100')}
      ${th('RSI / Δ','RSI-14 and RSI minus EMA90 of RSI')}
      ${th('Volume','Today vs 20d avg')}
      ${th('Signal','Bullish or Bearish')}
      ${th('Score / PoP','Trade quality score and probability')}
      ${th('Edge Scores','Shared RS / vol / sector / inst / EM scores')}
      ${th('Sector','')}
      ${th('Other Zones','Other nearby S/R levels')}
    </tr></thead><tbody>`;

  const bodyRows = rows.map((r, i) => {
    const distAbs = Math.abs(r.dist_pct);
    const distC = distAbs < 1 ? '#ef4444' : distAbs < 2 ? '#f59e0b' : '#22c55e';
    const volC  = r.vol_ratio > 150 ? '#a855f7' : r.vol_ratio > 120 ? '#22c55e' : r.vol_ratio < 70 ? '#64748b' : 'var(--text2)';
    const strC  = r.strength >= 70 ? '#22c55e' : r.strength >= 50 ? '#f59e0b' : 'var(--muted)';

    // Other nearby levels
    const otherZones = (r.all_nearby||[]).filter(z => z.price !== r.sr_level).slice(0,2)
      .map(z => `<span style="font-size:10px;font-family:monospace;color:${z.sr_type==='support'?'#22c55e':'#ef4444'}">${z.sr_type==='support'?'S':'R'}$${z.price} (${z.dist_pct>0?'+':''}${z.dist_pct}%)</span>`).join('<br>');

    return `<tr style="border-bottom:1px solid var(--border);${i%2?'background:var(--surface)':''}">
      <td style="padding:5px 10px;font-weight:800;color:var(--accent)">${r.symbol}</td>
      <td style="padding:5px 8px;text-align:right;font-family:monospace;font-weight:600">$${r.spot}</td>
      <td style="padding:5px 8px;text-align:center">
        <div style="font-family:monospace;font-weight:700">$${r.sr_level}</div>
        <div>${srBadge(r.sr_type, r.dist_pct)}</div>
      </td>
      <td style="padding:5px 8px;text-align:center">
        <span style="font-size:14px;font-weight:900;font-family:monospace;color:${distC}">${distAbs}%</span>
      </td>
      <td style="padding:5px 8px;text-align:center;font-family:monospace;font-weight:700;color:${strC}">${r.strength}</td>
      ${rsiCell(r.rsi, r.delta_rsi)}
      <td style="padding:5px 8px;text-align:center;font-family:monospace;font-weight:700;color:${volC}">${r.vol_ratio}%</td>
      <td style="padding:5px 8px">${signalBadge(r.signal)}</td>
      ${scoreBar(r.score, r.pop)}
      <td style="padding:5px 8px;font-size:10px;color:var(--muted)">${(r.sector||'—').replace('Consumer Cyclical','Consumer').replace('Communication Services','Comm.')}</td>
      <td style="padding:5px 8px;font-size:10px">${otherZones || '<span style="color:var(--dim)">—</span>'}</td>
    </tr>`;
  }).join('');

  return header + bodyRows + '</tbody></table></div>';
}

// ════════════════════════════════════════════════════════════════════════════
// DASHBOARD — FUTURES ROLL-ADJUSTED SIGNAL WIDGET
// ════════════════════════════════════════════════════════════════════════════


function _htmlEsc(v) {
  return String(v ?? '').replace(/[&<>"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[ch] || ch));
}

function _dashHasFuturesSeries(d) {
  const series = d?.oi_series || {};
  return Object.values(series).some(rows => (rows || []).some(r => Number(r.oi || 0) > 0));
}

function _adaptAllContractsFuturesPayload(d, sym) {
  const sourceContracts = Array.isArray(d?.contracts) ? d.contracts : [];
  const contracts = sourceContracts.map(c => String(c.contract || c || '').trim()).filter(Boolean);
  const oi_series = {};
  sourceContracts.forEach((src, idx) => {
    const ct = contracts[idx];
    if (!ct) return;
    const rows = Array.isArray(src?.data) ? src.data : [];
    oi_series[ct] = rows.map(r => ({
      date: r.date,
      close: Number(r.close || r.price || 0),
      volume: Number(r.volume || 0),
      oi: Number(r.oi || 0),
      oi_change: Number(r.oi_change || 0),
      source: src.source || d.source || 'schwab'
    }));
  });
  const cumulative_series = _buildFuturesCumulativeSeries(contracts, oi_series);
  const latestCum = cumulative_series.length ? cumulative_series[cumulative_series.length - 1] : null;
  const firstWithRows = contracts.find(ct => (oi_series[ct] || []).length) || '';
  return {
    symbol: d?.symbol || sym,
    source: d?.source || 'schwab',
    signal: d?.signal || (firstWithRows ? 'NEUTRAL' : 'NO_DATA'),
    interpretation: d?.interpretation || d?.message || '',
    contracts,
    front: firstWithRows || contracts[0] || '',
    active_contract: firstWithRows || contracts[0] || '',
    oi_series,
    cumulative_series,
    net_oi_chg: Number(latestCum?.oi_change || 0),
    cumulative_oi_chg: Number(latestCum?.oi_change || 0),
    total_oi: Number(latestCum?.oi || 0),
    contract_table: contracts.map(ct => {
      const rows = oi_series[ct] || [];
      const last = rows.length ? rows[rows.length - 1] : {};
      return {
        contract: ct,
        oi: Number(last.oi || 0),
        oi_change: Number(last.oi_change || 0),
        close: Number(last.close || 0),
        volume: Number(last.volume || 0),
        date: last.date || '',
        source: d?.source || 'schwab'
      };
    }),
    is_volume_proxy: false
  };
}

function _syncDashFuturesSymbolFromDashboard() {
  const raw = (document.getElementById('symbol-input')?.value || currentSymbol || 'SPY').trim().toUpperCase();
  const sel = document.getElementById('dash-fut-symbol');
  if (!sel) return;
  const map = {SPY:'SPY', QQQ:'QQQ', IWM:'IWM', DIA:'DIA', GLD:'GLD', SLV:'SLV', USO:'USO', TLT:'TLT'};
  if (map[raw]) sel.value = map[raw];
}

async function _loadDashFutures() {
  var el  = document.getElementById('dash-futures-result');
  var sym = document.getElementById('dash-fut-symbol')?.value || 'SPY';
  if (!el) return;
  el.innerHTML = '<div style="font-size:11px;color:var(--muted)">⏳ Loading futures data…</div>';
  try {
    let primaryErr = null;
    var d = await api('/api/futures/chart_data?symbol=' + encodeURIComponent(sym)).catch(err => { primaryErr = err; return null; });
    // Aggregate and Dashboard must use compatible data. If chart_data returns a
    // no-series envelope or errors, ask the compatibility endpoint that powers
    // the Aggregate futures panel and adapt the payload for this widget.
    if (!_dashHasFuturesSeries(d)) {
      const alt = await api('/api/futures/all_contracts?symbol=' + encodeURIComponent(sym)).catch(() => null);
      const adapted = _adaptAllContractsFuturesPayload(alt, sym);
      if (_dashHasFuturesSeries(adapted)) d = adapted;
    }
    if (d && primaryErr && !d._dashboard_note) {
      d._dashboard_note = 'Dashboard used Aggregate-compatible futures OI fallback after chart_data did not return rows.';
    }
    el.innerHTML = _renderFuturesRollWidget(d);
  } catch(e) {
    console.error('Dashboard futures OI render failed', e);
    el.innerHTML = '<div style="font-size:11px;color:var(--muted);line-height:1.7">No futures data rendered on Dashboard.<br><span style="font-size:10px;color:#f59e0b">' + _htmlEsc(e && e.message ? e.message : String(e || 'unknown error')) + '</span><br>If Aggregate shows rows, click the Dashboard futures refresh button. If no rows exist, go to Scheduler → <b>⚡ Fetch OI Now</b>.</div>';
  }
}

function _renderFuturesRollWidget(d) {
  if (!d || (!_dashHasFuturesSeries(d) && d.signal === 'NO_DATA') || d.source === 'none') {
    return '<div style="padding:10px;color:var(--muted);font-size:11px;line-height:1.8">'
      + '<b style="color:var(--text)">No Schwab futures OI data yet.</b><br>'
      + '1. Go to <b>Scheduler tab</b> → make sure Schwab badge is green<br>'
      + '2. Click <b>⚡ Fetch OI Now</b><br>'
      + '<span style="font-size:10px;color:var(--dim)">Runs automatically every morning at 8 AM.</span>'
      + '</div>';
  }
  const sig = d.signal || 'UNKNOWN';
  const sigC = (sig==='LONG_BUILDUP' || sig==='NET_LONG_BUILDUP') ? '#22c55e'
    : (sig==='SHORT_BUILDUP' || sig==='LONG_UNWINDING' || sig==='NET_LONG_UNWINDING') ? '#ef4444'
    : sig==='SHORT_COVERING' ? '#38bdf8'
    : sig==='OI_BUILDUP' ? '#a78bfa'
    : sig==='OI_UNWINDING' ? '#f97316'
    : sig==='ROLL' ? '#f59e0b'
    : sig==='FIRST_FETCH' ? '#818cf8' : '#64748b';
  const label = sig.replace(/_/g,' ');
  const fChg = Number(d.front_oi_chg || 0);
  const bChg = Number(d.back_oi_chg || 0);
  const net  = Number(d.net_oi_chg || 0);
  const series = d.oi_series || {};
  const contracts = d.contracts || [];
  const active = d.active_contract || d.active || '';
  const firstWithRows = contracts.find(ct => (series[ct] || []).length) || Object.keys(series).find(ct => (series[ct] || []).length) || '';
  const front = ((d.front && (series[d.front] || []).length) ? d.front : (firstWithRows || d.front || contracts[0] || active || ''));
  const totalOi = Number(d.total_oi || 0);
  const sourceOk = d.source === 'schwab' || d.data_source === 'schwab';
  const histStart = d.history_start || '';
  const histEnd = d.history_end || '';
  const histRows = Number(d.history_rows || 0);
  const histNote = histRows ? `History: ${histRows.toLocaleString()} rows from ${d.history_table || 'futures_oi_daily'}${histStart && histEnd ? ` (${histStart} → ${histEnd})` : ''}` : '';
  const chgHtml = (lbl, val) => `<span style="color:var(--muted)">${lbl}: <b style="color:${val>=0?'#22c55e':'#ef4444'}">${val>=0?'+':''}${val.toLocaleString()}</b></span>`;

  const summary = `<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px;padding:8px 10px;background:${sigC}0f;border:1px solid ${sigC}33;border-radius:6px">
    <div style="font-size:14px;font-weight:900;color:${sigC};min-width:120px">${label}</div>
    <div style="display:flex;gap:12px;font-size:11px;flex-wrap:wrap;flex:1">
      ${front ? chgHtml(front + ' front ΔOI', fChg) : ''}
      ${active && active !== front ? chgHtml(active + ' active ΔOI', Number(d.active_oi_chg || 0)) : ''}
      ${d.back ? chgHtml(d.back + ' next ΔOI', bChg) : ''}
      <span>CUM ΔOI: <b style="font-size:12px;color:${net>=0?'#22c55e':'#ef4444'}">${net>=0?'+':''}${net.toLocaleString()}</b></span>
      ${totalOi ? `<span>Total Curve OI: <b style="color:#818cf8">${totalOi.toLocaleString()}</b></span>` : ''}
    </div>
    <span style="font-size:10px;color:${sourceOk?'#22c55e':'#f59e0b'}">${sourceOk?'✅ Schwab Real OI':'⚠ No real OI'}</span>
  </div>
  ${d.interpretation ? `<div style="font-size:11px;color:var(--text2);margin-bottom:4px;padding:0 2px">${d.interpretation}</div>` : ''}
  ${histNote ? `<div style="font-size:10px;color:var(--muted);margin-bottom:8px;padding:0 2px">${histNote}</div>` : ''}
  ${_renderFuturesSelectedSentiment(d)}`;

  const frontRows = (series[front] || []).slice(-30);
  const cumRows = ((d.cumulative_series || []).length ? d.cumulative_series : _buildFuturesCumulativeSeries(contracts, series)).slice(-30);
  const latestFront = frontRows.length ? frontRows[frontRows.length-1] : null;
  const latestCum = cumRows.length ? cumRows[cumRows.length-1] : null;
  const frontDelta = latestFront ? Number(latestFront.oi_change != null ? latestFront.oi_change : (frontRows.length >= 2 ? (Number(frontRows[frontRows.length-1].oi||0) - Number(frontRows[frontRows.length-2].oi||0)) : 0)) : 0;
  const cumDelta = latestCum ? Number(latestCum.oi_change != null ? latestCum.oi_change : (cumRows.length >= 2 ? (Number(cumRows[cumRows.length-1].oi||0) - Number(cumRows[cumRows.length-2].oi||0)) : 0)) : 0;
  const frontSub = latestFront ? `Latest OI ${(latestFront.oi||0).toLocaleString()} · ΔOI <span style="color:${frontDelta>=0?'#22c55e':'#ef4444'}">${frontDelta>=0?'+':''}${frontDelta.toLocaleString()}</span> · Settle $${latestFront.close || '—'} · ${latestFront.date || ''}` : 'No front-contract OI history yet';
  const cumSub = latestCum ? `Latest cumulative OI ${(latestCum.oi||0).toLocaleString()} · ΔOI <span style="color:${cumDelta>=0?'#22c55e':'#ef4444'}">${cumDelta>=0?'+':''}${cumDelta.toLocaleString()}</span> across ${contracts.length || 0} contracts · ${latestCum.date || ''}` : 'No cumulative OI history yet';

  const graphs = `<div class="dash-futures-compact-grid">
    <div class="dash-futures-chart-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;gap:6px">
        <div><div style="font-size:11px;font-weight:800;color:var(--accent)">Immediate Expiring Contract OI</div>
          <div style="font-size:10px;color:var(--muted)">${front || 'Front'} · ${frontSub}</div></div>
      </div>
      <canvas id="dash-fut-front-oi-chart" height="150" style="width:100%;display:block;cursor:crosshair"></canvas>
    </div>
    <div class="dash-futures-chart-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;gap:6px">
        <div><div style="font-size:11px;font-weight:800;color:#a78bfa">Cumulative OI Across Contracts</div>
          <div style="font-size:10px;color:var(--muted)">${contracts.slice(0,3).join(' + ')} · ${cumSub}</div></div>
      </div>
      <canvas id="dash-fut-cum-oi-chart" height="150" style="width:100%;display:block;cursor:crosshair"></canvas>
    </div>
  </div>`;

  setTimeout(() => {
    _drawFuturesOiCanvas('dash-fut-front-oi-chart', frontRows, {title: front || 'Front', color:'#60a5fa', showPrice:true});
    _drawFuturesOiCanvas('dash-fut-cum-oi-chart', cumRows, {title:'Cumulative', color:'#a78bfa', showPrice:false});
  }, 80);

  const ladder = _renderFuturesContractLadder(d.contract_table || [], active, front);
  return summary + graphs + ladder;
}

function _fmtFutSigned(v) {
  v = Number(v || 0);
  return (v >= 0 ? '+' : '') + v.toLocaleString();
}

function _normalizeCotRootForDashboard(rootOrSymbol) {
  const raw = String(rootOrSymbol || '').toUpperCase().trim().replace(/^\//, '');
  const map = {SPY:'ES', QQQ:'NQ', IWM:'RTY', DIA:'YM', GLD:'GC', SLV:'SI', COPPER:'HG', PLATINUM:'PL',
    USO:'CL', NATGAS:'NG', GASOLINE:'RB', HEATINGOIL:'HO', TLT:'ZB', ZN10Y:'ZN', ZF5Y:'ZF', ZT2Y:'ZT',
    EURUSD:'6E', JPYUSD:'6J', GBPUSD:'6B', AUDUSD:'6A', CADUSD:'6C', CHFUSD:'6S', NZDUSD:'6N', MXNUSD:'6M'};
  return map[raw] || raw || 'ES';
}

async function _loadDashSelectedFuturesSentiment(rootOrSymbol) {
  const el = document.getElementById('dash-fut-selected-sentiment');
  if (!el) return;
  const root = _normalizeCotRootForDashboard(rootOrSymbol);
  try {
    const d = await api('/cot/signal/' + encodeURIComponent(root));
    const sc = Number(d.combined_score ?? 5);
    const color = _cotScoreColor(sc);
    const sw = d.schwab || {};
    const cot = d.cot || {};
    const hasSw = (sw.data_points ?? 0) > 0;
    const hasCot = cot.found === true;
    const oiTrend = sw.oi_trend_pct != null ? ((Number(sw.oi_trend_pct) >= 0 ? '+' : '') + sw.oi_trend_pct + '%') : '—';
    const pxTrend = sw.price_trend_pct != null ? ((Number(sw.price_trend_pct) >= 0 ? '+' : '') + sw.price_trend_pct + '%') : '—';
    const cotIdx = cot.cot_index != null ? Number(cot.cot_index).toFixed(0) + '/100' : '—';
    el.innerHTML = `<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;width:100%">
      <span style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em">Selected sentiment</span>
      <b style="color:${color};font-size:15px">${String(d.contract || ('/'+root)).replace('//','/')} ${sc.toFixed(1)}/10</b>
      <span style="font-size:11px;color:${color}">${d.label || 'Neutral'}</span>
      <span class="dash-fut-chip">Schwab OI trend: <b>${hasSw ? oiTrend : 'no data'}</b></span>
      <span class="dash-fut-chip">Price trend: <b>${hasSw ? pxTrend : '—'}</b></span>
      <span class="dash-fut-chip">COT Index: <b>${hasCot ? cotIdx : 'no COT'}</b></span>
      ${cot.direction ? `<span class="dash-fut-chip">COT: <b>${cot.direction}</b></span>` : ''}
    </div>`;
  } catch(e) {
    el.innerHTML = `<span style="font-size:11px;color:var(--muted)">Selected COT/positioning not available yet. Fetch CFTC COT in Scheduler for the weekly overlay.</span>`;
  }
}

function _renderFuturesSelectedSentiment(d) {
  const st = d?.selected_sentiment || {};
  const sw = st.schwab || {};
  const cot = st.cot || {};
  const hasCot = !!cot.found || cot.cot_index != null;
  const score = Number(st.combined_score ?? 5);
  const label = st.label || (d.signal || 'Neutral').replace(/_/g, ' ');
  const color = score >= 7.5 ? '#22c55e' : score >= 6 ? '#86efac' : score >= 4.5 ? '#94a3b8' : score >= 3 ? '#fca5a5' : '#ef4444';
  const root = (d.root || '').replace(/^\//, '');
  const oiPct = sw.oi_trend_pct;
  const pxPct = sw.price_trend_pct;
  const idx = cot.cot_index;
  const cotNet = cot.lspec_net;
  const cotChg = cot.lspec_chg;
  const chip = (k, v, c) => `<span class="dash-fut-sent-chip"><span>${k}</span><b style="color:${c||'var(--text)'}">${v}</b></span>`;
  const oiC = Number(oiPct) > 0 ? '#22c55e' : Number(oiPct) < 0 ? '#ef4444' : 'var(--muted)';
  const pxC = Number(pxPct) > 0 ? '#22c55e' : Number(pxPct) < 0 ? '#ef4444' : 'var(--muted)';
  const cotC = idx == null ? 'var(--muted)' : idx >= 70 ? '#22c55e' : idx <= 30 ? '#ef4444' : '#94a3b8';
  return `<div class="dash-fut-selected-sentiment">
    <div class="dash-fut-sent-head">
      <span style="font-weight:900;color:${color}">${root ? '/' + root : d.display || d.symbol || 'Futures'} Sentiment: ${label}</span>
      <span style="font-weight:900;color:${color}">${Number.isFinite(score) ? score.toFixed(1) : '—'}/10</span>
    </div>
    <div class="dash-fut-sent-chips">
      ${chip('Schwab OI trend', oiPct != null ? (Number(oiPct)>=0?'+':'') + oiPct + '%' : '—', oiC)}
      ${chip('Price trend', pxPct != null ? (Number(pxPct)>=0?'+':'') + pxPct + '%' : '—', pxC)}
      ${chip('COT index', idx != null ? Number(idx).toFixed(0) + '/100' : 'not loaded', cotC)}
      ${chip('COT net', cotNet != null ? (Number(cotNet)>=0?'+':'') + Number(cotNet).toLocaleString() : '—', Number(cotNet)>=0?'#22c55e':'#ef4444')}
      ${chip('COT Δ', cotChg != null ? (Number(cotChg)>=0?'+':'') + Number(cotChg).toLocaleString() : '—', Number(cotChg)>=0?'#22c55e':'#ef4444')}
    </div>
    <div style="font-size:10px;color:var(--muted);margin-top:3px">COT is a weekly macro positioning overlay. Daily Schwab OI drives the OI charts/signals; COT helps judge whether large-spec positioning confirms or warns against the daily OI read.</div>
  </div>`;
}

function _renderFuturesContractLadder(rows, active, front) {
  rows = (rows || []).filter(r => (r.oi || 0) > 0 || r.date);
  if (!rows.length) return '';
  const body = rows.slice(0, 8).map(r => {
    const chg = Number(r.oi_change || 0);
    const sig = (r.close || 0) ? '' : '';
    return `<tr>
      <td style="padding:4px 6px;font-weight:800;color:${r.contract===active?'#22c55e':r.contract===front?'#60a5fa':'var(--text)'}">${_htmlEsc(r.contract||'')}${r.contract===active?' <span style="font-size:9px;color:#22c55e">active</span>':''}${r.contract===front?' <span style="font-size:9px;color:#60a5fa">front</span>':''}</td>
      <td style="padding:4px 6px;color:var(--muted)">${_htmlEsc(r.expiry||'')}</td>
      <td style="padding:4px 6px;text-align:right">${Number(r.close||0).toLocaleString(undefined,{maximumFractionDigits:2})}</td>
      <td style="padding:4px 6px;text-align:right">${Number(r.oi||0).toLocaleString()}</td>
      <td style="padding:4px 6px;text-align:right;color:${chg>=0?'#22c55e':'#ef4444'}">${chg>=0?'+':''}${chg.toLocaleString()}</td>
      <td style="padding:4px 6px;color:var(--muted)">${_htmlEsc(r.date||'')}</td>
    </tr>`;
  }).join('');
  return `<div style="margin-top:8px;overflow:auto;border:1px solid var(--border);border-radius:6px">
    <table style="width:100%;border-collapse:collapse;font-size:10.5px">
      <thead><tr style="background:rgba(255,255,255,.03)">
        <th style="padding:5px 6px;text-align:left;color:var(--muted)">Contract</th>
        <th style="padding:5px 6px;text-align:left;color:var(--muted)">Expiry</th>
        <th style="padding:5px 6px;text-align:right;color:var(--muted)">Price</th>
        <th style="padding:5px 6px;text-align:right;color:var(--muted)">OI</th>
        <th style="padding:5px 6px;text-align:right;color:var(--muted)">ΔOI</th>
        <th style="padding:5px 6px;text-align:left;color:var(--muted)">Date</th>
      </tr></thead><tbody>${body}</tbody>
    </table>
  </div>`;
}

function _buildFuturesCumulativeSeries(contracts, series) {
  const byDate = {};
  (contracts || []).forEach(ct => {
    (series[ct] || []).forEach(r => {
      const dt = r.date;
      if (!dt) return;
      if (!byDate[dt]) byDate[dt] = {date: dt, oi: 0, close: 0, count: 0};
      byDate[dt].oi += Number(r.oi || 0);
      if (r.close) { byDate[dt].close += Number(r.close || 0); byDate[dt].count += 1; }
    });
  });
  return Object.values(byDate).sort((a,b) => String(a.date).localeCompare(String(b.date))).map(r => ({
    date: r.date,
    oi: r.oi,
    close: r.count ? +(r.close / r.count).toFixed(2) : 0,
  }));
}

function _drawFuturesOiCanvas(id, rows, opts={}) {
  const cv = document.getElementById(id);
  if (!cv) return;
  const ctx = cv.getContext('2d');
  const W = cv.offsetWidth || 520;
  const H = cv.getAttribute('height') ? parseInt(cv.getAttribute('height'),10) : 150;
  cv.width = W; cv.height = H;
  ctx.clearRect(0,0,W,H);
  const data = (rows || []).filter(r => r && r.date);
  if (!data.length) {
    ctx.fillStyle='rgba(255,255,255,.35)'; ctx.font='12px sans-serif'; ctx.textAlign='center';
    ctx.fillText('No Schwab futures OI data yet', W/2, H/2);
    return;
  }
  const PAD = {l:48,r:44,t:16,b:22};
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;
  const oiVals = data.map(r => Number(r.oi || 0));
  const pxVals = data.map(r => Number(r.close || 0)).filter(Boolean);
  const maxOi = Math.max(...oiVals, 1) * 1.12;
  const minOi = Math.min(...oiVals, 0) * 0.92;
  const oiRange = Math.max(1, maxOi - minOi);
  const maxPx = Math.max(...pxVals, 1) * 1.002;
  const minPx = Math.min(...pxVals, maxPx) * 0.998;
  const pxRange = Math.max(1, maxPx - minPx);
  const n = data.length;
  const barW = Math.max(3, Math.min(18, cW / Math.max(1,n) * 0.62));
  const toX = i => PAD.l + (i + 0.5) / Math.max(1,n) * cW;
  const toY = v => PAD.t + cH - (v - minOi) / oiRange * cH;
  const toPY = v => PAD.t + cH - (v - minPx) / pxRange * cH;

  // Grid + y labels
  ctx.strokeStyle='rgba(255,255,255,.06)'; ctx.lineWidth=1;
  ctx.fillStyle='rgba(255,255,255,.45)'; ctx.font='9px monospace'; ctx.textAlign='right';
  for (let i=0;i<=3;i++) {
    const y = PAD.t + i*cH/3;
    ctx.beginPath(); ctx.moveTo(PAD.l,y); ctx.lineTo(W-PAD.r,y); ctx.stroke();
    const val = maxOi - i*oiRange/3;
    ctx.fillText(val>=1000000 ? (val/1000000).toFixed(1)+'M' : val>=1000 ? Math.round(val/1000)+'K' : Math.round(val), PAD.l-5, y+3);
  }

  data.forEach((r,i) => {
    const v = Number(r.oi || 0);
    const prev = i > 0 ? Number(data[i-1].oi || v) : v;
    const chg = r.oi_change != null ? Number(r.oi_change || 0) : (v - prev);
    const x = toX(i) - barW/2;
    const y = toY(v);
    ctx.fillStyle = chg >= 0 ? 'rgba(34,197,94,.46)' : 'rgba(239,68,68,.48)';
    ctx.fillRect(x, y, barW, PAD.t+cH-y);
    // Label only the latest bar so OI change is visible without needing hover.
    if (i === data.length - 1 && chg !== 0) {
      ctx.fillStyle = chg >= 0 ? '#22c55e' : '#ef4444';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      const label = (chg >= 0 ? '+' : '') + (Math.abs(chg) >= 1000000 ? (chg/1000000).toFixed(1)+'M' : Math.abs(chg) >= 1000 ? Math.round(chg/1000)+'K' : chg);
      ctx.fillText(label, toX(i), Math.max(10, y - 4));
    }
  });

  if (opts.showPrice && pxVals.length > 1) {
    ctx.strokeStyle='rgba(251,191,36,.9)'; ctx.lineWidth=1.8; ctx.setLineDash([4,3]);
    ctx.beginPath();
    data.forEach((r,i) => {
      const v = Number(r.close || 0); if (!v) return;
      const x = toX(i); const y = toPY(v);
      i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
    });
    ctx.stroke(); ctx.setLineDash([]);
  }

  // X labels
  ctx.fillStyle='rgba(255,255,255,.45)'; ctx.font='9px monospace'; ctx.textAlign='center';
  const idxs = [...new Set([0, Math.floor(n/2), n-1])];
  idxs.forEach(i => { if (data[i]) ctx.fillText(String(data[i].date||'').slice(5), toX(i), H-5); });

  // Legend
  ctx.textAlign='left'; ctx.font='9px sans-serif';
  ctx.fillStyle='rgba(34,197,94,.75)'; ctx.fillText('■ OI up', PAD.l, 10);
  ctx.fillStyle='rgba(239,68,68,.75)'; ctx.fillText('■ OI down', PAD.l+58, 10);
  if (opts.showPrice) { ctx.fillStyle='rgba(251,191,36,.85)'; ctx.fillText('-- price', PAD.l+128, 10); }

  _wireFuturesOiTooltip(cv, data, {toX, toY, H, W, opts});
}

function _wireFuturesOiTooltip(cv, data, geom) {
  if (!cv || !data || !data.length) return;
  if (!cv._futTip) {
    const tip = document.createElement('div');
    tip.className = 'futures-oi-tip';
    tip.style.cssText = 'display:none;position:fixed;background:#111827;border:1px solid #334155;border-radius:6px;padding:7px 10px;font-size:11px;pointer-events:none;z-index:9999;box-shadow:0 6px 18px rgba(0,0,0,.35);line-height:1.5';
    document.body.appendChild(tip);
    cv._futTip = tip;
  }
  const tip = cv._futTip;
  cv.onmousemove = e => {
    const rect = cv.getBoundingClientRect();
    const mx = (e.clientX - rect.left) * (geom.W / rect.width);
    const idx = Math.max(0, Math.min(data.length-1, Math.round((mx - 48) / Math.max(1, geom.W - 92) * data.length)));
    const r = data[idx]; if (!r) return;
    const prev = idx > 0 ? data[idx-1] : r;
    const chg = r.oi_change != null ? Number(r.oi_change || 0) : (Number(r.oi||0) - Number(prev.oi||0));
    tip.innerHTML = `<b style="color:var(--accent)">${r.date || ''}</b><br>OI: <b>${Number(r.oi||0).toLocaleString()}</b> ΔOI <span style="color:${chg>=0?'#22c55e':'#ef4444'}">${chg>=0?'+':''}${chg.toLocaleString()}</span>${r.close?'<br>Price: <b>$'+r.close+'</b>':''}`;
    tip.style.display = '';
    tip.style.left = (e.clientX + 14) + 'px';
    tip.style.top = (e.clientY - 8) + 'px';
  };
  cv.onmouseleave = () => { tip.style.display='none'; };
}


// Wire to setupTabs
