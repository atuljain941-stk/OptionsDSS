// SCHEDULER — Futures OI Config + Manual Fetch
// ════════════════════════════════════════════════════════════════════════════
async function _saveBarchartKey() {
  // Deprecated — Schwab is now the primary source
  console.log("Schwab is now the primary futures OI source");
}

async function _fetchFuturesNow() {
  const st  = document.getElementById('futures-config-status');
  const btn = document.querySelector('[onclick="_fetchFuturesNow()"]');
  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Starting Schwab Futures OI fetch…</span>';
  if (btn) btn.disabled = true;
  try {
    const started = await api('/api/futures/fetch_now', {method:'POST'});
    const jobId = started.job_id || '';
    const qs = jobId ? ('?job_id=' + encodeURIComponent(jobId)) : '';
    if (st) st.innerHTML = '<span style="color:#f59e0b">⏳ Fetching from Schwab… waiting for the current fetch, not old cached rows.</span>';

    let attempts = 0;
    const maxAttempts = 30; // 30 x 3s = 90s
    const renderSummary = (chk, final=false) => {
      const rows = chk.rows || [];
      const job = chk.job || {};
      const anyStale = chk.any_stale || false;
      const running = !!job.running;
      const done = !!job.done;
      const storedTotal = Number(job.stored_total || 0);
      const noNewSchwabRows = done && storedTotal <= 0;
      const jobMsg = job.message || '';
      const errors = (job.errors || []).filter(Boolean);
      const summary = rows.slice(0,6).map(r => {
        const dateLabel = r.is_today
          ? `[today${r.fetched_at ? ' · ' + String(r.fetched_at).slice(11,16) : ''}]`
          : `[${r.last_date}${r.stale_msg||''}]`;
        const oiStr = (r.oi||0).toLocaleString();
        const px = r.settle ? ` @${r.settle}` : '';
        const sym = r.symbol ? `${r.symbol} ` : '';
        return `${sym}${r.contract}: OI=${oiStr}${px} ${dateLabel}`;
      }).join(' · ');

      const statusColor = running ? '#f59e0b' : (noNewSchwabRows ? '#ef4444' : (anyStale ? '#f59e0b' : '#22c55e'));
      const statusIcon  = running ? '⏳' : (noNewSchwabRows ? '❌' : (anyStale ? '⚠' : '✅'));
      const headline = running
        ? 'Fetching real Schwab OI'
        : (noNewSchwabRows ? 'No new Schwab OI stored' : 'Schwab OI updated');
      const errHtml = errors.length
        ? '<br><span style="font-size:10px;color:#ef4444">' + errors.slice(0,4).map(e => String(e)).join('<br>') + '</span>'
        : '';
      const reauth = job.reauthorize_required
        ? '<br><span style="font-size:10px;color:#ef4444;font-weight:700">Re-authorize Schwab in Settings, then run Fetch OI Now again.</span>'
        : '';
      const cacheNote = noNewSchwabRows && rows.length
        ? '<br><span style="font-size:10px;color:#f59e0b">Cached/stale rows are shown only for reference; they were not refreshed by this fetch.</span>'
        : '';
      const staleNote = (!running && !noNewSchwabRows && anyStale)
        ? '<br><span style="font-size:10px;color:#f59e0b">⚠ Rows are still stale. Schwab may not have published the next OI snapshot yet.</span>'
        : '';
      const runningNote = running
        ? '<br><span style="font-size:10px;color:var(--muted)">' + (jobMsg || 'Fetch still running...') + '</span>'
        : '';
      if (st) st.innerHTML = `<span style="color:${statusColor}">${statusIcon} ${headline} — ${jobMsg || summary || chk.message || 'waiting...'}${runningNote}${errHtml}${reauth}${cacheNote}${staleNote}</span>`;
    };

    const poll = setInterval(async () => {
      attempts++;
      try {
        const chk = await api('/api/futures/fetch_status' + qs);
        const running = !!(chk.job && chk.job.running);
        const jobDone = !!(chk.job && chk.job.done);
        if (chk.has_data || chk.job) renderSummary(chk, !running);
        else if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Waiting for Schwab rows... (' + (attempts*3) + 's)</span>';

        // Stop only when the current job is done, or after timeout.
        // Do not stop just because old stale rows exist.
        if (!running && (jobDone || chk.has_data || attempts >= maxAttempts)) {
          clearInterval(poll);
          if (btn) btn.disabled = false;
          if (!chk.has_data && !chk.job && st) {
            st.innerHTML = '<span style="color:#f59e0b">⚠ Fetch finished but no active futures OI rows were stored. Check Schwab auth/token and console logs.</span>';
          }
          if (typeof _loadDashFutures === 'function') _loadDashFutures();
        } else if (attempts >= maxAttempts) {
          clearInterval(poll);
          if (btn) btn.disabled = false;
          if (st) st.innerHTML += '<br><span style="font-size:10px;color:#f59e0b">⚠ Still waiting after 90s. Click Check Data or try again.</span>';
        }
      } catch(e) {
        if (attempts >= maxAttempts) {
          clearInterval(poll);
          if (btn) btn.disabled = false;
          if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
        }
      }
    }, 3000);
  } catch(e) {
    if (btn) btn.disabled = false;
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

function _schwabAuthLabel(d) {
  const hasToken = !!(d && d.access_token);
  if (!hasToken) return {ok:false, color:'#f59e0b', html:'⚠ Not connected — connect Schwab below to get real futures OI'};
  const exp = Number(d.expires_in_seconds);
  if (Number.isFinite(exp) && exp <= 0) {
    return {ok:false, color:'#f59e0b', html:'⚠ Schwab access token is expired — click Refresh Token or re-authorize if refresh fails'};
  }
  if (!d.has_refresh_token) {
    return {ok:false, color:'#f59e0b', html:'⚠ Schwab access token exists but no refresh token is stored — re-authorize soon'};
  }
  const min = Number.isFinite(exp) ? Math.max(0, Math.round(exp / 60)) : null;
  return {ok:true, color:'#22c55e', html:'✅ Schwab connected — real exchange OI active' + (min !== null ? ` · token ${min}m` : '')};
}

async function _loadFuturesConfig() {
  const authEl = document.getElementById('futures-auth-status');
  try {
    const d = await api('/schwab/config');
    const lbl = _schwabAuthLabel(d);
    if (authEl) authEl.innerHTML = '<span style="color:' + lbl.color + '">' + lbl.html + '</span>';
  } catch {
    if (authEl) authEl.innerHTML = '<span style="color:var(--muted)">⚠ Could not check Schwab status</span>';
  }
}

// ════════════════════════════════════════════════════════════════════════════
// SCHWAB CONNECT — Scheduler Tab
// ════════════════════════════════════════════════════════════════════════════
async function _schwabCheckStatus() {
  const badge = document.getElementById('schwab-conn-badge');
  const authEl= document.getElementById('futures-auth-status');
  try {
    const d = await api('/schwab/config');
    const lbl = _schwabAuthLabel(d);
    if (badge) {
      badge.textContent    = lbl.ok ? '✅ Connected' : '⚠ Needs auth';
      badge.style.background = lbl.ok ? 'rgba(34,197,94,.15)'  : 'rgba(245,158,11,.15)';
      badge.style.color      = lbl.color;
    }
    if (authEl) authEl.innerHTML = '<span style="color:' + lbl.color + '">' + lbl.html + '</span>';
    // Pre-fill keys if already saved (show hint only)
    if (d && d.app_key) {
      const keyEl = document.getElementById('schwab-app-key');
      if (keyEl && !keyEl.value) keyEl.placeholder = d.app_key.slice(0,8) + '... (already saved)';
    }
  } catch(e) {
    if (badge) { badge.textContent = '❌ Error'; badge.style.color = '#ef4444'; }
  }
}

async function _schwabSaveCreds() {
  const key    = document.getElementById('schwab-app-key')?.value?.trim();
  const secret = document.getElementById('schwab-app-secret')?.value?.trim();
  const st     = document.getElementById('schwab-status');
  if (!key || !secret) {
    if (st) st.innerHTML = '<span style="color:#ef4444">Enter both App Key and App Secret</span>';
    return;
  }
  try {
    await api('/schwab/config', { method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ app_key: key, app_secret: secret })
    });
    if (st) st.innerHTML = '<span style="color:#22c55e">✅ Credentials saved — now click � Get Auth URL</span>';
    document.getElementById('schwab-app-secret').value = '';
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

async function _schwabGetAuthUrl() {
  const st = document.getElementById('schwab-status');
  try {
    const d = await api('/schwab/auth_url');
    if (d.url) {
      window.open(d.url, '_blank');
      const row = document.getElementById('schwab-redirect-row');
      if (row) row.style.display = '';
      if (st) st.innerHTML = '<span style="color:#f59e0b">� Browser opened — log in to Schwab, authorize, then paste the redirect URL below</span>';
    } else {
      if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + (d.error||'Save credentials first') + '</span>';
    }
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + ' — save credentials first</span>';
  }
}

async function _schwabExchangeCode() {
  const url = document.getElementById('schwab-redirect-url')?.value?.trim();
  const st  = document.getElementById('schwab-status');
  if (!url) { if (st) st.innerHTML = '<span style="color:#ef4444">Paste the redirect URL first</span>'; return; }
  // Extract the code from the URL
  let code = '';
  try { code = new URL(url).searchParams.get('code') || ''; } catch {}
  if (!code) code = url.match(/code=([^&]+)/)?.[1] || '';
  if (!code) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ No code found in URL. Copy the full URL from browser.</span>';
    return;
  }
  try {
    const d = await api('/schwab/exchange_code', { method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ code })
    });
    if (d.ok || d.access_token) {
      if (st) st.innerHTML = '<span style="color:#22c55e">✅ Connected! Schwab will now provide real futures OI at 8 AM.</span>';
      document.getElementById('schwab-redirect-row').style.display = 'none';
      document.getElementById('schwab-redirect-url').value = '';
      setTimeout(_schwabCheckStatus, 500);
    } else {
      if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + (d.error||'Exchange failed') + '</span>';
    }
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

async function _schwabRefreshToken() {
  const st = document.getElementById('schwab-status');
  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Refreshing token…</span>';
  try {
    const d = await api('/schwab/refresh', {method:'POST'});
    if (d.ok || d.access_token) {
      if (st) st.innerHTML = '<span style="color:#22c55e">✅ Token refreshed</span>';
      setTimeout(_schwabCheckStatus, 300);
    } else {
      if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + (d.error||'Refresh failed — re-authorize') + '</span>';
    }
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

async function _checkFuturesData() {
  const st = document.getElementById('futures-config-status');
  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Checking active Futures OI rows…</span>';
  try {
    const d = await api('/api/futures/fetch_status');
    if (d.has_data) {
      const rows = d.rows || [];
      const lines = rows.map(r => {
        const stale = r.stale ? ' <span style="color:#f59e0b">' + (r.stale_msg||'stale') + '</span>' : ' <span style="color:#22c55e">current</span>';
        const time = r.fetched_at ? ' fetched=' + String(r.fetched_at).replace('T',' ').slice(0,16) : '';
        return '<b style="color:var(--accent)">' + (r.symbol ? r.symbol + ' ' : '') + r.contract + '</b>: OI=' +
          (r.oi||0).toLocaleString() + ' Vol=' + (r.volume||0).toLocaleString() +
          ' Date=' + r.last_date + stale +
          ' <span style="color:var(--muted);font-size:9px">[' + (r.source||'') + time + ']</span>';
      }).join('<br>');
      const color = d.any_stale ? '#f59e0b' : '#22c55e';
      const icon  = d.any_stale ? '⚠' : '✅';
      if (st) st.innerHTML = '<span style="color:' + color + '">' + icon + ' ' + d.count + ' active contracts in DB:</span><br>' + lines;
    } else {
      if (st) st.innerHTML = '<span style="color:#f59e0b">⚠ No active futures OI data in DB yet — click ⚡ Fetch OI Now</span>';
    }
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}



async function _clearFuturesData() {
  const st = document.getElementById('futures-config-status');
  if (!confirm('Clear ALL futures OI data from both tables (futures_oi + futures_oi_daily)?\nThis cannot be undone.')) return;
  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Clearing…</span>';
  try {
    const d = await api('/api/futures/clear', {method:'POST'});
    if (d.ok) {
      const summary = (d.cleared||[]).map(t =>
        t.error ? t.table + ': ❌ ' + t.error
                : t.table + ': ' + t.rows_deleted + ' rows deleted'
      ).join(' · ');
      if (st) st.innerHTML = '<span style="color:#f59e0b">🗑 Cleared — ' + summary + '</span>';
    } else {
      if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + (d.error||'Failed') + '</span>';
    }
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

// ════════════════════════════════════════════════════════════════════════════
// SCAN RESULT -> WATCHLIST IMPORT HELPERS
// ---------------------------------------------------------------------------
async function _importScanResults(source, rows, opts={}) {
  const symbols = [...new Set((rows || []).map(r => (r && r.symbol ? String(r.symbol).trim().toUpperCase() : '')).filter(Boolean))];
  if (!symbols.length) throw new Error('No symbols found in scan results');
  const payload = {
    source,
    symbols,
    description: opts.description || `Imported from ${source}`,
  };
  if (opts.watchlistId) payload.watchlist_id = opts.watchlistId;
  if (opts.name) payload.name = opts.name;
  if (opts.fetch_options_oi) payload.fetch_options_oi = !!opts.fetch_options_oi;
  return await api('/watchlists/import_scan_results', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(payload),
  });
}

async function _promptImportWatchlist(source, rows, existingSelectId, statusId) {
  const sel = document.getElementById(existingSelectId);
  const st = document.getElementById(statusId);
  if (!rows || !rows.length) { alert('No scan results to save'); return; }
  const wlId = sel?.value || '';
  if (wlId) {
    if (st) st.innerHTML = '<span style="color:var(--muted)">Saving to watchlist...</span>';
    try {
      const d = await _importScanResults(source, rows, {watchlistId: wlId});
      if (st) st.innerHTML = `<span style="color:#22c55e">Saved ${d.added||0} symbols to ${d.watchlist_name}</span>`;
      addNotif('ok', `${source} saved`, `${d.added||0} symbols -> ${d.watchlist_name}`, 'Watchlists');
      if (typeof _wlLoad === 'function') await _wlLoad();
      return;
    } catch(e) {
      if (st) st.innerHTML = '<span style="color:#ef4444">' + e.message + '</span>';
      addNotif('error', `${source} save failed`, e.message, 'Watchlists');
      return;
    }
  }
  const name = prompt(`Save ${source} results as a new watchlist`, `${source.replace(/_/g,' ')} Watchlist`);
  if (!name) return;
  if (st) st.innerHTML = '<span style="color:var(--muted)">Creating watchlist...</span>';
  try {
    const d = await _importScanResults(source, rows, {name});
    if (st) st.innerHTML = `<span style="color:#22c55e">Saved ${d.added||0} symbols to ${d.watchlist_name}</span>`;
    addNotif('ok', `${source} watchlist created`, `${d.added||0} symbols`, 'Watchlists');
    if (typeof _wlLoad === 'function') await _wlLoad();
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">' + e.message + '</span>';
    addNotif('error', `${source} create failed`, e.message, 'Watchlists');
  }
}

// MOMENTUM RETRACEMENT SCANNER
// ════════════════════════════════════════════════════════════════════════════
var _mrData = null;
var _mrCurrentFilter = 'all';

async function runMomRetrace() {
  const st  = document.getElementById('mr-status');
  const res = document.getElementById('mr-results');
  const lookback  = document.getElementById('mr-lookback')?.value  || 15;
  const movePct   = document.getElementById('mr-move-pct')?.value  || 6;
  const rsiPeak   = document.getElementById('mr-rsi-peak')?.value  || 68;
  const rsiTrough = document.getElementById('mr-rsi-trough')?.value|| 32;
  const deltaRsi  = document.getElementById('mr-delta-rsi')?.value || 18;
  const retMin    = document.getElementById('mr-ret-min')?.value   || 3;
  const retMax    = document.getElementById('mr-ret-max')?.value   || 8;
  const recoveryDays = document.getElementById('mr-recovery-days')?.value || 5;
  const earnDays  = document.getElementById('mr-min-earn-days')?.value || '';
  const symsRaw   = document.getElementById('mr-symbols')?.value?.trim() || '';
  const wlId      = document.getElementById('mr-watchlist')?.value || '';
  const wlTxt     = document.getElementById('mr-watchlist')?.selectedOptions?.[0]?.text || '';

  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Scanning'+(wlId?' '+wlTxt:'')+'… (30-60s for full watchlist)</span>';
  if (res) res.innerHTML = '';

  const params = new URLSearchParams({
    lookback, move_pct: movePct,
    rsi_peak: rsiPeak, rsi_trough: rsiTrough, delta_rsi: deltaRsi,
    retrace_min: retMin, retrace_max: retMax, recovery_days: recoveryDays,
    min_earn_days: earnDays
  });
  if (symsRaw) params.set('symbols', symsRaw);
  if (wlId) params.set('watchlist_id', wlId);

  try {
    const d = await api('/api/scanner/momentum_retrace?' + params.toString());
    _mrData = d;
    if (d.error) { if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + d.error + '</span>'; return; }
    const total = (d.bull_count||0) + (d.bear_count||0);
    if (st) st.innerHTML = '<span style="color:#22c55e">✅ Scanned '+(d.total_scanned||0)+
      ' symbols → '+total+' setups'+(wlId?' ['+wlTxt+']':'')+': 🟢 '+(d.bull_count||0)+' bull pullbacks · 🔴 '+(d.bear_count||0)+' bear bounces</span>';
    _mrRender(_mrCurrentFilter);
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

function mrFilter(f) {
  _mrCurrentFilter = f;
  ['all','bull','bear'].forEach(function(id) {
    const el = document.getElementById('mr-filter-' + id);
    if (el) el.classList.toggle('active', id === f);
  });
  if (_mrData) _mrRender(f);
}

function _mrRender(filter) {
  const res = document.getElementById('mr-results');
  if (!res || !_mrData) return;

  const bulls = (_mrData.bulls || []).map(function(r){ return {...r, _dir:'BULL'}; });
  const bears = (_mrData.bears || []).map(function(r){ return {...r, _dir:'BEAR'}; });
  let rows = [];
  if (filter !== 'bear') rows = rows.concat(bulls);
  if (filter !== 'bull') rows = rows.concat(bears);
  rows.sort(function(a,b){ return b.score - a.score; });

  if (!rows.length) {
    res.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:12px">No setups found. '
      + 'Try: lower Min Move% (e.g. 5), widen Retrace window, or reduce RSI OB/OS thresholds.</div>';
    return;
  }

  const html = rows.map(function(r) {
    const isBull  = r._dir === 'BULL';
    const dirC    = isBull ? '#22c55e' : '#ef4444';
    const dirBg   = isBull ? 'rgba(34,197,94,.06)' : 'rgba(239,68,68,.06)';
    const dirLabel= isBull ? '🟢 BULL PULLBACK' : '🔴 BEAR BOUNCE';
    const scoreC  = r.score >= 82 ? '#22c55e' : r.score >= 68 ? '#f59e0b' : '#94a3b8';

    // RSI extreme label
    const rsiExt  = isBull
      ? 'OB at ' + r.rsi_at_extreme
      : 'OS at ' + r.rsi_at_extreme;
    const rsiC    = isBull ? (r.rsi_at_extreme >= 70 ? '#ef4444' : '#f59e0b')
                           : (r.rsi_at_extreme <= 30 ? '#22c55e' : '#f59e0b');

    // MACD status
    const macdBull = r.macd > r.macd_sig;
    const macdC    = macdBull ? '#22c55e' : '#ef4444';
    const macdTurn = r.macd_turning;
    const macdLabel= macdTurn
      ? (isBull ? '🔼 Turning up' : '🔽 Turning dn')
      : (macdBull ? '▲ Positive' : '▼ Negative');

    // Price vs EMAs
    const vsEma20  = ((r.price - r.ema20) / r.ema20 * 100).toFixed(1);
    const vsEma50  = ((r.price - r.ema50) / r.ema50 * 100).toFixed(1);
    const ema20C   = isBull ? (r.price > r.ema20 ? '#22c55e' : '#ef4444')
                            : (r.price < r.ema20 ? '#22c55e' : '#ef4444');
    const ema50C   = isBull ? (r.price > r.ema50 ? '#22c55e' : '#ef4444')
                            : (r.price < r.ema50 ? '#22c55e' : '#ef4444');

    const signals = r.signals || [];

    return '<div style="display:grid;grid-template-columns:110px 80px 1fr 110px;gap:10px;align-items:start;'
      + 'padding:11px 13px;margin-bottom:7px;'
      + 'background:' + dirBg + ';'
      + 'border:1px solid ' + dirC + '33;border-left:3px solid ' + dirC + ';border-radius:7px">'

      // ── Col 1: Symbol block ─────────────────────────────────────────
      + '<div>'
      + '<div style="font-size:15px;font-weight:900;color:var(--text);letter-spacing:-.3px">' + r.symbol + '</div>'
      + '<div style="font-size:10px;font-weight:700;color:' + dirC + ';margin-bottom:3px">' + dirLabel + '</div>'
      + '<div style="font-size:12px;font-weight:700;color:var(--text)">$' + r.price + '</div>'
      + '<div style="font-size:10px;color:var(--muted)">ATR $' + r.atr + '</div>'
      + '</div>'

      // ── Col 2: Scores + RSI ─────────────────────────────────────────
      + '<div style="text-align:center">'
      + '<div style="font-size:22px;font-weight:900;color:' + scoreC + ';line-height:1">' + r.score + '</div>'
      + '<div style="font-size:9px;color:var(--muted);margin-bottom:6px">score</div>'
      + '<div style="font-size:11px">RSI <b style="color:' + dirC + '">' + r.rsi + '</b></div>'
      + '<div style="font-size:10px;color:' + rsiC + '">' + rsiExt + '</div>'
      + '<div style="font-size:10px;color:var(--muted)">'
      + (r.delta_rsi >= 0 ? '+' : '') + r.delta_rsi + ' ΔRSI</div>'
      + '</div>'

      // ── Col 3: Setup details ────────────────────────────────────────
      + '<div>'
      // Signal tags
      + '<div style="display:flex;flex-wrap:wrap;gap:3px;margin-bottom:7px">'
      + signals.map(function(s){
          var bg = s.includes('↑')||s.includes('above')||s.includes('Above') ? 'rgba(34,197,94,.12)'
                 : s.includes('↓')||s.includes('below')||s.includes('Below') ? 'rgba(239,68,68,.12)'
                 : 'rgba(255,255,255,.06)';
          return '<span style="font-size:10px;padding:2px 7px;border-radius:3px;background:'+bg+';color:var(--text2)">' + s + '</span>';
        }).join('')
      + '</div>'
      // Key metrics row
      + '<div style="display:flex;gap:10px;font-size:10px;color:var(--muted);flex-wrap:wrap">'
      + '<span>Move <b style="color:' + dirC + '">' + (isBull?'+':'−') + r.move_pct + '%</b></span>'
      + '<span>Fib <b style="color:#a5b4fc">' + r.fib_pct + '%</b></span>'
      + '<span>' + r.bars_retrace + 'd retrace</span>'
      + '<span>MACD <b style="color:' + macdC + '">' + macdLabel + '</b></span>'
      + '<span>RSI-EMA <b style="color:' + (r.rsi_ema_diff>=0?'#22c55e':'#ef4444') + '">'
      + (r.rsi_ema_diff>=0?'+':'') + r.rsi_ema_diff + '</b></span>'
      + (r.vol_declining ? '<span style="color:#818cf8">📉 Vol ↓</span>' : '')
      + '</div>'
      + _edgeScoreBlock(r)
      + '</div>'

      // ── Col 4: EMA levels ───────────────────────────────────────────
      + '<div style="font-size:10px;text-align:right;line-height:1.8">'
      + '<div style="color:' + ema20C + '">EMA20 $' + r.ema20
      + ' <span style="font-size:9px">(' + (vsEma20>=0?'+':'') + vsEma20 + '%)</span></div>'
      + '<div style="color:' + ema50C + '">EMA50 $' + r.ema50
      + ' <span style="font-size:9px">(' + (vsEma50>=0?'+':'') + vsEma50 + '%)</span></div>'
      + '<div style="color:var(--muted)">EMA200 $' + r.ema200 + '</div>'
      + '<div style="margin-top:4px;color:var(--muted)">🟢<b>' + r.bull_score + '</b> 🔴<b>' + r.bear_score + '</b></div>'
      + '</div>'
      + '</div>';
  }).join('');

  res.innerHTML = html;
}





// ════════════════════════════════════════════════════════════════════════════
// TREND EXHAUSTION -> SECOND PULLBACK SCANNER
// Looks back X days for RSI exhaustion, then looks for an actual second-pullback
// sequence after the first bounce and first retrace.
// ════════════════════════════════════════════════════════════════════════════
var _tepData = null;
var _tepCurrentFilter = 'all';

async function runMomExhaustionPullback() {
  const st  = document.getElementById('tep-status');
  const res = document.getElementById('tep-results');
  const lookback = document.getElementById('tep-lookback-days')?.value || 20;
  const rsiHi    = document.getElementById('tep-rsi-hi')?.value || 68;
  const rsiLo    = document.getElementById('tep-rsi-lo')?.value || 32;
  const diffThr  = document.getElementById('tep-diff-thr')?.value || 20;
  const minBounce= document.getElementById('tep-min-bounce')?.value || 4;
  const minBars  = document.getElementById('tep-min-second-bars')?.value || 1;
  const earnDays = document.getElementById('tep-min-earn-days')?.value || '';
  const exhaustTf = document.getElementById('tep-exhaust-tf')?.value || '1d';
  const pullbackTf = document.getElementById('tep-pullback-tf')?.value || '1h';
  const symsRaw  = document.getElementById('mr-symbols')?.value?.trim() || '';
  const wlId     = document.getElementById('mr-watchlist')?.value || '';
  const wlTxt    = document.getElementById('mr-watchlist')?.selectedOptions?.[0]?.text || '';

  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Scanning ' + (wlId ? wlTxt : 'symbols table') + ' on ' + exhaustTf + ' → ' + pullbackTf + '…</span>';
  if (res) res.innerHTML = '';

  const params = new URLSearchParams({
    lookback_days: lookback,
    rsi_hi: rsiHi,
    rsi_lo: rsiLo,
    diff_thr: diffThr,
    min_bounce_pct: minBounce,
    min_second_bars: minBars,
    min_earn_days: earnDays,
    exhaust_tf: exhaustTf,
    pullback_tf: pullbackTf,
  });
  if (symsRaw) params.set('symbols', symsRaw);
  if (wlId) params.set('watchlist_id', wlId);

  try {
    const d = await api('/api/scanner/momentum_retrace_exhaustion?' + params.toString());
    _tepData = d;
    if (d.error) { if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + d.error + '</span>'; return; }
    const total = d.count || ((d.bulls||[]).length + (d.bears||[]).length);
    const combo = (d.params && d.params.exhaust_tf && d.params.pullback_tf) ? (' [' + d.params.exhaust_tf + ' → ' + d.params.pullback_tf + ']') : '';
    if (st) st.innerHTML = '<span style="color:#22c55e">✅ Found ' + total + ' second-pullback setups' + combo + (wlId ? ' [' + wlTxt + ']' : '') + '</span>';
    _tepRender(_tepCurrentFilter);
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

function tepFilter(f) {
  _tepCurrentFilter = f;
  ['all','bull','bear'].forEach(function(id) {
    const el = document.getElementById('tep-filter-' + id);
    if (el) el.classList.toggle('active', id === f);
  });
  if (_tepData) _tepRender(f);
}

function _tepRender(filter) {
  const res = document.getElementById('tep-results');
  if (!res || !_tepData) return;

  const bulls = (_tepData.bulls || []).map(function(r){ return {...r, _dir:'BULL'}; });
  const bears = (_tepData.bears || []).map(function(r){ return {...r, _dir:'BEAR'}; });
  let rows = [];
  if (filter !== 'bear') rows = rows.concat(bulls);
  if (filter !== 'bull') rows = rows.concat(bears);
  rows.sort(function(a,b){ return (b.score||0) - (a.score||0); });

  function _group(rows, title, color) {
    if (!rows.length) return '';
    const hdr = '<div style="margin:12px 0 6px;font-size:12px;font-weight:800;color:' + color + '">' + title + ' (' + rows.length + ')</div>';
    const head = ['Symbol','Setup','Final','Native','Comp','Edge Scores','Price','Exh TF','PB TF','Exh Date','Age','Exh RSI','Exh Δ','Bounce','2nd PB','State','Trade'];
    const th = '<tr>' + head.map(function(h){ return '<th style="padding:6px 8px;font-size:10px;color:var(--muted);font-weight:600;text-align:left;border-bottom:1px solid var(--border)">' + h + '</th>'; }).join('') + '</tr>';
    const body = rows.map(function(r) {
      const scoreC = r.score >= 75 ? '#22c55e' : r.score >= 55 ? '#f59e0b' : '#94a3b8';
      const setupC = r._dir === 'BULL' ? '#22c55e' : '#ef4444';
      return '<tr style="border-bottom:1px solid var(--border)">' +
        '<td style="padding:5px 8px;font-weight:800;color:var(--accent)">' + r.symbol + '</td>' +
        '<td style="padding:5px 8px;font-size:11px;color:' + setupC + ';font-weight:700">' + r.setup + '</td>' +
        '<td style="padding:5px 8px;font-weight:800;color:' + scoreC + '">' + (r.final_score ?? r.score) + '</td>' +
        '<td style="padding:5px 8px;font-weight:800;color:var(--text)">' + (r.native_score ?? '—') + '</td>' +
        '<td style="padding:5px 8px;font-weight:800;color:var(--text);min-width:220px">' + _edgeScoreCell(r) + '</td>' +
        '<td style="padding:5px 8px;font-family:monospace">$' + r.price + '</td>' +
        '<td style="padding:5px 8px;font-family:monospace;font-size:11px">' + (r.exhaustion_tf || '—') + '</td>' +
        '<td style="padding:5px 8px;font-family:monospace;font-size:11px">' + (r.pullback_tf || '—') + '</td>' +
        '<td style="padding:5px 8px;font-family:monospace;font-size:11px">' + (r.exhaustion_date || '—') + '</td>' +
        '<td style="padding:5px 8px;font-size:11px">' + (r.exhaustion_age ?? '—') + 'd</td>' +
        '<td style="padding:5px 8px;font-family:monospace">' + (r.exhaustion_rsi ?? '—') + '</td>' +
        '<td style="padding:5px 8px;font-family:monospace">' + (r.exhaustion_diff != null ? (r.exhaustion_diff >= 0 ? '+' : '') + r.exhaustion_diff : '—') + '</td>' +
        '<td style="padding:5px 8px;font-family:monospace;color:#a5b4fc">' + (r.bounce_pct != null ? r.bounce_pct.toFixed(1) + '%' : '—') + '</td>' +
        '<td style="padding:5px 8px;font-family:monospace;color:' + (r.second_pullback_pct >= 0 ? '#f59e0b' : '#94a3b8') + '">' + (r.second_pullback_pct != null ? r.second_pullback_pct.toFixed(1) + '%' : '—') + '</td>' +
        '<td style="padding:5px 8px;font-size:11px;color:' + ((r.setup_state==='Reversal Risk')?'#ef4444':(r.setup_state==='Continuation Risk')?'#f59e0b':(r.setup_state==='Exhausted')?'#a855f7':'#94a3b8') + ';font-weight:700">' + (r.setup_state || '—') + '</td>' +
        '<td style="padding:5px 8px;font-size:11px;color:var(--muted)">' + (r.trade_bias || r.signal || '—') + '</td>' +
      '</tr>';
    }).join('');
    return hdr + '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse">' + th + body + '</table></div>';
  }

  if (!rows.length) {
    res.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:12px">No second-pullback setups yet. Try increasing Lookback X or lowering the bounce threshold.</div>';
    return;
  }

  res.innerHTML = _group(rows.filter(function(r){ return r._dir === 'BULL'; }), 'Bullish second-pullback setups (bounce / calls)', '#22c55e')
    + _group(rows.filter(function(r){ return r._dir === 'BEAR'; }), 'Bearish second-pullback setups (fade / puts)', '#ef4444');
  setTimeout(function(){ _loadWatchlistDropdown('tep-save-watchlist','tep-save-status','Default watchlist'); }, 0);
}

// ════════════════════════════════════════════════════════════════════════════
// RSI MULTI-TIMEFRAME SCANNER
// Bull: Daily RSI Δ >= +25  AND  1H/2H RSI Δ <= -20  (buy the dip)
// Bear: Daily RSI Δ <= -25  AND  1H/2H RSI Δ >= +20  (short the bounce)
// ════════════════════════════════════════════════════════════════════════════
var _rmtData   = null;
var _rmtFilter = 'all';
var _rmtDefaults = {
  daily_delta_bull: 25, daily_delta_bear: 25,
  intra_delta_bull: -20, intra_delta_bear: 20,
  daily_lookback: 10, intra_lookback: 8,
  intra_tf: '1h', rsi_period: 14,
  macd_filter: true, ema_filter: true,
  min_price: 5, symbols: ''
};

// ── param helpers ─────────────────────────────────────────────────────────────
function _rmtSetUI(p) {
  const s = function(id, v) { var el = document.getElementById(id); if(el) el.value = v; };
  const b = function(id, v) { var el = document.getElementById(id); if(el) el.checked = !!v; };
  s('rmt-d-lb',       p.daily_lookback  ?? 10);
  s('rmt-daily-thr',  p.daily_threshold ?? 20);
  s('rmt-intra-thr',  p.intra_threshold ?? 20);
  s('rmt-htf',        p.htf             ?? 'daily');
  s('rmt-ltf',        p.ltf             ?? '1h');
  s('rmt-itf',        p.intra_tf        ?? '1h');  // legacy fallback
  s('rmt-rsi-p',      p.rsi_period      ?? 14);
  s('rmt-ema-p',      p.ema_period      ?? 90);
  s('rmt-symbols',    p.symbols         ?? '');
  s('rmt-min-earn-days', p.min_earn_days ?? '');
  b('rmt-macd', p.macd_filter  ?? true);
  b('rmt-ema',  p.ema50_filter ?? true);
}

function _rmtGetUI() {
  const n = function(id){ return parseFloat(document.getElementById(id)?.value || 0); };
  const c = function(id){ return !!(document.getElementById(id)?.checked); };
  return {
    daily_lookback:   n('rmt-d-lb'),
    daily_threshold:  n('rmt-daily-thr'),
    intra_threshold:  n('rmt-intra-thr'),
    htf:     document.getElementById('rmt-htf')?.value || 'daily',
    ltf:     document.getElementById('rmt-ltf')?.value || '1h',
    intra_tf: document.getElementById('rmt-ltf')?.value || '1h',  // keep for compat
    rsi_period:       n('rmt-rsi-p'),
    ema_period:       n('rmt-ema-p'),
    macd_filter:      c('rmt-macd'),
    ema50_filter:     c('rmt-ema'),
    symbols:          document.getElementById('rmt-symbols')?.value?.trim() || '',
    min_earn_days:    document.getElementById('rmt-min-earn-days')?.value || '',
  };
}

async function rsiMtfLoadParams() {
  try {
    const p = await api('/api/scanner/rsi_mtf/params');
    _rmtSetUI(p);
  } catch { _rmtSetUI(_rmtDefaults); }
}

async function rsiMtfSaveParams() {
  const st = document.getElementById('rmt-save-status');
  const p  = _rmtGetUI();
  try {
    await api('/api/scanner/rsi_mtf/params', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(p)
    });
    if (st) { st.innerHTML = '<span style="color:#22c55e">✅ Saved</span>'; setTimeout(()=>{ st.innerHTML=''; }, 2000); }
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

function rsiMtfResetParams() { _rmtSetUI(_rmtDefaults); }

// ── run scanner ───────────────────────────────────────────────────────────────
async function runRsiMtf() {
  const st    = document.getElementById('rmt-status');
  const res   = document.getElementById('rmt-results');
  const p     = _rmtGetUI();
  const wlId  = document.getElementById('rmt-watchlist')?.value || '';
  const wlTxt = document.getElementById('rmt-watchlist')?.selectedOptions?.[0]?.text || '';

  // If watchlist selected: clear symbols so backend uses watchlist
  if (wlId) { p.symbols = ''; _setScannerWatchlistId(wlId); }

  const scanUrl = '/api/scanner/rsi_mtf' + (wlId ? '?watchlist_id=' + wlId : '');

  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Scanning '+(wlId?wlTxt:'default symbols')+'… (30-90s)</span>';
  if (res) res.innerHTML = '';

  try {
    const d = await api(scanUrl, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(p)
    });
    _rmtData = d;
    if (d.error) { if(st) st.innerHTML = '<span style="color:#ef4444">❌ '+d.error+'</span>'; return; }
    const itf = p.intra_tf.toUpperCase();
    if (st) st.innerHTML =
      '<span style="color:#22c55e">✅ Scanned '+(d.total_scanned||0)+' symbols — '
      + (wlId?' ['+wlTxt+'] ':'')+'🟢 '+(d.bull_count||0)+' buy-dip · 🔴 '+(d.bear_count||0)+' short-bounce</span>';
    _rmtRender(_rmtFilter);
  } catch(e) {
    if (st) st.innerHTML = '<span style="color:#ef4444">❌ '+e.message+'</span>';
  }
}

// ── filter ────────────────────────────────────────────────────────────────────
function rsiMtfFilter(f) {
  _rmtFilter = f;
  ['all','bull','bear'].forEach(function(id) {
    const el = document.getElementById('rmt-f-'+id);
    if (el) el.classList.toggle('active', id === f);
  });
  if (_rmtData) _rmtRender(f);
}

// ── render ────────────────────────────────────────────────────────────────────
function _rmtRender(filter) {
  const res = document.getElementById('rmt-results');
  if (!res || !_rmtData) return;

  const bulls = (_rmtData.bulls||[]).map(function(r){ return {...r, _dir:'BULL'}; });
  const bears = (_rmtData.bears||[]).map(function(r){ return {...r, _dir:'BEAR'}; });
  let rows = [];
  if (filter !== 'bear') rows = rows.concat(bulls);
  if (filter !== 'bull') rows = rows.concat(bears);
  rows.sort(function(a,b){ return b.score - a.score; });

  if (!rows.length) {
    res.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:14px">'
      + 'No setups found. Try: lower the Daily RSI Δ threshold, reduce Intraday RSI Δ threshold, '
      + 'or uncheck MACD/EMA filters.</div>';
    return;
  }

  const htfLabel = (_rmtData.params?.htf || 'daily').toUpperCase();
  const itf      = (_rmtData.params?.ltf || _rmtData.params?.intra_tf || '1h').toUpperCase();

  res.innerHTML = rows.map(function(r) {
    const isBull  = r._dir === 'BULL';
    const dirC    = isBull ? '#22c55e' : '#ef4444';
    const dirBg   = isBull ? 'rgba(34,197,94,.05)' : 'rgba(239,68,68,.05)';
    const dirLabel= isBull ? '🟢 BUY DIP' : '🔴 SHORT BOUNCE';
    const subLabel= isBull
      ? htfLabel + ' uptrend → ' + itf + ' retracing'
      : htfLabel + ' downtrend → ' + itf + ' bouncing';
    const scoreC  = r.score >= 82 ? '#22c55e' : r.score >= 65 ? '#f59e0b' : '#94a3b8';

    // RSI delta direction arrows
    // Bull: daily highest_d is green (was overbought), iDelta negative = retracing (green)
    // Bear: daily lowest_d is red (was oversold), iDelta positive = bouncing (red)
    const dDeltaC = isBull ? '#22c55e' : '#ef4444';
    const iDeltaC = isBull
      ? (r.diff_i_now <= -15 ? '#22c55e' : r.diff_i_now <= -5 ? '#f59e0b' : '#94a3b8')
      : (r.diff_i_now >= 15  ? '#22c55e' : r.diff_i_now >= 5  ? '#f59e0b' : '#94a3b8');

    // MACD label
    const macdBull = r.d_macd > r.d_msig;
    const macdC    = macdBull ? '#22c55e' : '#ef4444';
    const macdLbl  = macdBull
      ? (r.d_mhist > 0 ? '▲ +'+(r.d_mhist).toFixed(2) : '▲ '+r.d_mhist.toFixed(2))
      : (r.d_mhist < 0 ? '▼ '+r.d_mhist.toFixed(2)   : '▼ '+r.d_mhist.toFixed(2));

    // EMA vs price
    const vs50  = ((r.price-r.ema50)/r.ema50*100).toFixed(1);
    const vs200 = ((r.price-r.ema200)/r.ema200*100).toFixed(1);
    const ema50C = isBull ? (r.price>r.ema50?'#22c55e':'#ef4444')
                          : (r.price<r.ema50?'#22c55e':'#ef4444');

    const sigs = (r.signals||[]).map(function(s) {
      const bg = s.includes('Above')||s.includes('▲')||s.includes('+') ? 'rgba(34,197,94,.1)'
               : s.includes('Below')||s.includes('▼') ? 'rgba(239,68,68,.1)'
               : 'rgba(255,255,255,.06)';
      return '<span style="font-size:10px;padding:2px 7px;border-radius:3px;background:'+bg+';color:var(--text2)">'+s+'</span>';
    }).join('');

    return '<div style="display:grid;grid-template-columns:100px 140px 1fr 120px;gap:10px;align-items:start;'
      + 'padding:11px 14px;margin-bottom:7px;'
      + 'background:'+dirBg+';border:1px solid '+dirC+'2e;'
      + 'border-left:3px solid '+dirC+';border-radius:7px">'

      // Col 1 — symbol
      + '<div>'
      + '<div style="font-size:15px;font-weight:900;color:var(--text)">' + r.symbol + '</div>'
      + (r.timeframes && r.timeframes.length > 1
          ? '<div>' + r.timeframes.map(function(tf){ return '<span style="font-size:9px;padding:1px 5px;border-radius:3px;background:rgba(129,140,248,.15);color:#818cf8;margin-right:3px">' + tf.toUpperCase() + '</span>'; }).join('') + '</div>'
          : '<div style="font-size:9px;color:var(--muted)">' + ((r.timeframes && r.timeframes[0]) || 'daily').toUpperCase() + '</div>')
      + '<div style="font-size:10px;font-weight:700;color:'+dirC+'">' + dirLabel + '</div>'
      + '<div style="font-size:9px;color:var(--muted);margin-bottom:4px">' + subLabel + '</div>'
      + '<div style="font-size:12px;font-weight:700">$' + r.price + '</div>'
      + '</div>'

      // Col 2 — RSI-EMA(90) diff (the core signal)
      + '<div style="background:rgba(255,255,255,.04);border-radius:5px;padding:7px 8px">'
      + '<div style="font-size:9px;color:var(--muted);font-weight:700;text-transform:uppercase;margin-bottom:5px">RSI−EMA(90) Signal</div>'
      + '<div style="font-size:10px;color:var(--muted);margin-bottom:1px">Daily Highest(' + (_rmtData.params?.daily_lookback||10) + 'd):</div>'
      + '<div style="font-size:13px;font-weight:800;color:'+dDeltaC+';margin-bottom:4px">'
      + (isBull ? (r.highest_d>=0?'+':'') + r.highest_d : (r.lowest_d>=0?'+':'') + r.lowest_d)
      + ' <span style="font-size:9px;font-weight:400;color:var(--muted)">now ' + r.diff_d_now + '</span></div>'
      + '<div style="font-size:10px;color:var(--muted);margin-bottom:1px">' + itf + ' diff now:</div>'
      + '<div style="font-size:13px;font-weight:800;color:'+iDeltaC+';margin-bottom:4px">'
      + (r.diff_i_now>=0?'+':'') + r.diff_i_now
      + ' <span style="font-size:9px;font-weight:400;color:var(--muted)">(RSI ' + r.i_rsi + ' EMA ' + r.i_ema_rsi + ')</span></div>'
      + '<div style="font-size:10px;color:var(--muted);margin-top:2px">Final <b style="color:#22c55e">' + (r.final_score ?? r.score) + '</b> · Native ' + (r.native_score ?? r.score) + ' · Comp ' + (r.composite_score ?? r.edge_score ?? '—') + ' · Age ' + (r.trend_age ?? '—') + '</div>'
      + _edgeScoreBlock(r)
      + '<div style="font-size:10px;color:var(--muted)">Daily RSI ' + r.d_rsi + ' / EMA ' + r.d_ema_rsi + '</div>'
      + '</div>'

      // Col 3 — signals + MACD
      + '<div>'
      + '<div style="display:flex;flex-wrap:wrap;gap:3px;margin-bottom:6px">' + sigs + '</div>'
      + '<div style="display:flex;gap:10px;font-size:10px;color:var(--muted);flex-wrap:wrap">'
      + '<span>MACD <b style="color:'+macdC+'">'+macdLbl+'</b></span>'
      + '<span>EMA50 $'+r.ema50+' <b style="color:'+ema50C+'">('+( vs50>=0?'+':'')+vs50+'%)</b></span>'
      + '<span>EMA200 $'+r.ema200+' ('+( vs200>=0?'+':'')+vs200+'%)</span>'
      + '</div>'
      + '</div>'

      // Col 4 — score
      + '<div style="text-align:right">'
      + '<div style="font-size:24px;font-weight:900;color:'+scoreC+';line-height:1">'+r.score+'</div>'
      + '<div style="font-size:9px;color:var(--muted);margin-bottom:6px">score</div>'
      + '<div style="font-size:10px;color:var(--muted)">🟢 <b>'+r.bull_score+'</b></div>'
      + '<div style="font-size:10px;color:var(--muted)">🔴 <b>'+r.bear_score+'</b></div>'
      + '</div>'

      + '</div>';
  }).join('');
}

// ════════════════════════════════════════════════════════════════════════════
// WEEKLY PLAN
// ════════════════════════════════════════════════════════════════════════════
async function loadWeeklyPlan() {
  const sym    = (document.getElementById('wk-symbol')?.value  || 'SPY').trim();
  const expiry = document.getElementById('wk-expiry')?.value  || '';
  const st     = document.getElementById('wk-status');
  const res    = document.getElementById('wk-result');
  if (!res) return;
  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Generating weekly plan…</span>';
  res.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:20px">⏳ Loading…</div>';
  try {
    const url = '/spy/weekly?symbol=' + encodeURIComponent(sym) + (expiry ? '&expiry=' + encodeURIComponent(expiry) : '') + '&min_change_pct=' + encodeURIComponent(_oiSigParam('wk-oi-sig-pct')); 
    const d   = await api(url);
    if (d.error) {
      res.innerHTML = '<div style="padding:20px;color:#ef4444;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:8px">'
        + '<b>❌ ' + d.error + '</b>'
        + (d.trace ? '<pre style="font-size:10px;margin-top:8px;white-space:pre-wrap;color:#fca5a5">' + d.trace + '</pre>' : '')
        + '</div>';
      if (st) st.innerHTML = '';
      return;
    }
    // Populate expiry dropdown
    const exSel = document.getElementById('wk-expiry');
    if (exSel && d.expiry_list && d.expiry_list.length) {
      exSel.innerHTML = '<option value="">Auto current Friday</option>'
        + d.expiry_list.map(function(e){ return '<option value="'+e+'"'+(e===d.expiry?' selected':'')+'>'+e+'</option>'; }).join('');
    }
    const defaultName = `WeeklyPlan_${new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'')}`;
    if (st) st.innerHTML = '<span style="color:#22c55e">✅ '+sym+' Friday plan · '+d.expiry+' ('+d.dte+'d) · $'+d.spot+'</span>' + `<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px;padding:8px 10px;border:1px solid rgba(99,102,241,.25);border-radius:10px;background:rgba(99,102,241,.08)"><b>Save fresh plan</b><input id="wk-save-name" type="text" value="${defaultName}" style="min-width:260px;flex:1 1 320px" /><button class="btn btn-primary" style="padding:6px 10px" onclick="_weeklyPlanSaveCurrentRun(document.getElementById('wk-save-name')?.value)">Save run</button><span style="font-size:11px;color:var(--muted)">Default name is WeeklyPlan_datetime.</span></div>`;
    try {
      window._weeklyPlanLast = d;
      res.innerHTML = _renderWeeklyPlan(d);
    } catch(renderErr) {
      res.innerHTML = '<div style="padding:20px;color:#f59e0b">⚠ Render error: ' + renderErr.message + '</div>';
      console.error('_renderWeeklyPlan error:', renderErr);
    }
  } catch(fetchErr) {
    res.innerHTML = '<div style="padding:20px;color:#ef4444">❌ ' + fetchErr.message + '</div>';
    if (st) st.innerHTML = '';
  }
}

window._weeklyPlanLast = window._weeklyPlanLast || null;

async function _weeklyPlanSaveCurrentRun(runName) {
  try {
    const cur = window._weeklyPlanLast || null;
    if (!cur) { addNotif('error', 'Weekly Plan save failed', 'Generate a plan first.', 'Weekly Plan'); return; }
    const defaultName = `WeeklyPlan_${new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'')}`;
    const name = String(runName || document.getElementById('wk-save-name')?.value || defaultName).trim() || defaultName;
    const summary = {
      symbol: cur.symbol,
      expiry: cur.expiry,
      dte: cur.dte,
      spot: cur.spot,
      bias: (cur.weekly_overlays || {}).weekly_bias || cur.bias,
      confidence: (cur.weekly_overlays || {}).weekly_confidence || cur.confidence,
      composite_score: (cur.weekly_plan_score || {}).composite_score,
    };
    const saved = await _savedRunSave('weekly_plan', name, cur, summary, { symbol: cur.symbol || 'SPY' });
    const st = document.getElementById('wk-status');
    if (st) st.innerHTML = `💾 Saved plan <b>${esc(name)}</b> · ${esc(cur.symbol || 'SPY')} ${esc(cur.expiry || '')}`;
    addNotif('ok', 'Weekly Plan saved', `${name} · ${cur.symbol || 'SPY'} ${cur.expiry || ''}`, 'Weekly Plan');
    return saved;
  } catch(e) {
    addNotif('error', 'Weekly Plan save failed', e.message, 'Weekly Plan');
  }
}


async function _weeklyPlanViewSavedRuns() {
  const box = _savedRunsBox('wk-saved-runs-box', 'No saved Weekly Plan runs yet.');
  box.innerHTML = _savedRunsRenderControlsForBox('wk-saved-runs-box', 'wk', '_weeklyPlanViewSavedRuns') + `<div style="font-size:12px;color:var(--muted)">Loading…</div>`;
  try {
    const f = _savedRunsLoadFromControls('wk');
    const runs = await _savedRunListFiltered('weekly_plan', { name: f.name, dateFrom: f.dateFrom, dateTo: f.dateTo, limit: f.limit });
    if (!runs.length) { box.innerHTML = _savedRunsRenderControlsForBox('wk-saved-runs-box', 'wk', '_weeklyPlanViewSavedRuns', f) + '<div style="color:var(--muted);font-size:12px">No saved Weekly Plan runs matched the filters.</div>'; return; }
    box.innerHTML = _savedRunsRenderControlsForBox('wk-saved-runs-box', 'wk', '_weeklyPlanViewSavedRuns', f) + _savedRunsRenderPicker('wk', runs, '_weeklyPlanLoadSavedRun') + '<div style="overflow:auto;max-height:320px"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr><th style="text-align:left;padding:6px">Name</th><th style="text-align:left;padding:6px">Saved</th><th style="text-align:left;padding:6px">Symbol</th><th style="text-align:left;padding:6px">Expiry</th><th style="text-align:left;padding:6px">Bias</th><th style="text-align:left;padding:6px"></th></tr></thead><tbody>' +
      runs.map(r => `<tr><td style="padding:6px;font-weight:700">${esc(r.run_name || '')}</td><td style="padding:6px">${esc(r.updated_at || r.created_at || '')}</td><td style="padding:6px">${esc((r.summary && r.summary.symbol) || r.symbol || 'SPY')}</td><td style="padding:6px">${esc((r.summary && r.summary.expiry) || '')}</td><td style="padding:6px">${esc((r.summary && r.summary.bias) || '')}</td><td style="padding:6px;text-align:right"><button class="btn btn-primary" style="font-size:11px;padding:4px 8px" onclick="_weeklyPlanLoadSavedRun(${r.id})">Load</button></td></tr>`).join('') +
      '</tbody></table></div>';
  } catch(e) {
    box.innerHTML = `<div style="color:#ef4444;font-size:12px">${esc(e.message)}</div>`;
  }
}

async function _weeklyPlanLoadSavedRun(runId) {

  try {
    const run = await _savedRunLoad(runId);
    const payload = run.payload || {};
    window._weeklyPlanLast = payload;
    if (document.getElementById('wk-symbol') && payload.symbol) document.getElementById('wk-symbol').value = payload.symbol;
    if (document.getElementById('wk-expiry') && payload.expiry) document.getElementById('wk-expiry').value = payload.expiry;
    const res = document.getElementById('wk-result');
    if (res) res.innerHTML = _renderWeeklyPlan(payload);
    const st = document.getElementById('wk-status');
    if (st) st.innerHTML = `📥 Loaded saved plan <b>${esc(run.run_name || runId)}</b>`;
    addNotif('ok', 'Weekly Plan loaded', run.run_name || String(runId), 'Weekly Plan');
  } catch(e) {
    addNotif('error', 'Weekly Plan load failed', e.message, 'Weekly Plan');
  }
}


function _renderWeeklyPlan(d) {
  const esc = (v) => String(v ?? '—').replace(/[&<>"]/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[s]));
  const num = (v, dec=1) => (v === null || v === undefined || v === '' || Number.isNaN(Number(v))) ? '—' : Number(v).toFixed(dec);
  const money = (v, dec=2) => (v === null || v === undefined || v === '' || Number.isNaN(Number(v))) ? '—' : '$' + Number(v).toFixed(dec);
  const pct = (v, dec=1) => (v === null || v === undefined || v === '' || Number.isNaN(Number(v))) ? '—' : Number(v).toFixed(dec) + '%';
  const colorScore = (n) => Number(n) >= 75 ? '#22c55e' : Number(n) >= 60 ? '#f59e0b' : Number(n) >= 45 ? '#94a3b8' : '#ef4444';
  const dirColor = (label) => String(label || '').includes('BULL') ? '#22c55e' : String(label || '').includes('BEAR') ? '#ef4444' : '#f59e0b';
  const wp = d.weekly_plan_score || {};
  const em = d.expected_move || {};
  const oc = d.option_chain || {};
  const vix = d.vix || {};
  const tfs = d.timeframes || {};
  const walls = d.walls || {};
  const wo = d.week_outlook || {};
  const woi = d.weekly_oi_context || {};
  const oiFilter = d.oi_change_filter || woi.oi_change_filter || walls.oi_change_filter || {};
  const oiFilterText = oiFilter.enabled ? ` · ΔOI significance ${oiFilter.qualified ? 'ON' : 'OFF'} (${oiFilter.reason || ''})` : '';
  const preferred = wp.preferred || {};
  const comp = wp.component_scores || {};
  const bias = wp.directional_bias || d.bias || 'NEUTRAL';
  const biasC = dirColor(bias);

  function metricCard(label, value, sub, color) {
    return `<div class="wk-metric" style="background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:10px 11px;min-height:64px">
      <div style="font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px">${esc(label)}</div>
      <div style="font-size:16px;font-weight:900;color:${color || 'var(--text)'};line-height:1.1">${esc(value)}</div>
      ${sub ? `<div style="font-size:10px;color:var(--muted);margin-top:4px;line-height:1.35">${esc(sub)}</div>` : ''}
    </div>`;
  }

  function scoreBar(label, value, note) {
    const v = Math.max(0, Math.min(100, Number(value || 0)));
    return `<div style="margin-bottom:7px">
      <div style="display:flex;justify-content:space-between;font-size:10px;margin-bottom:3px"><span style="color:var(--muted)">${esc(label)}</span><b style="color:${colorScore(v)}">${num(v,0)}</b></div>
      <div style="height:6px;border-radius:4px;background:rgba(255,255,255,.07);overflow:hidden"><div style="height:6px;width:${v}%;background:${colorScore(v)}"></div></div>
      ${note ? `<div style="font-size:9px;color:var(--dim,#64748b);margin-top:2px">${esc(note)}</div>` : ''}
    </div>`;
  }

  function tfCard(tf, p) {
    p = p || {};
    const c = dirColor(p.regime);
    const sc = p.strong_candle || null;
    const scHtml = sc ? `<div style="margin-top:7px;padding:6px;border-radius:6px;background:${sc.side==='bull'?'rgba(34,197,94,.08)':'rgba(239,68,68,.08)'};border:1px solid ${sc.side==='bull'?'rgba(34,197,94,.25)':'rgba(239,68,68,.25)'}">
      <b style="color:${sc.side==='bull'?'#22c55e':'#ef4444'}">${sc.side.toUpperCase()} strong candle</b>
      <span style="color:var(--muted)"> · ${sc.bars_ago} bars ago · chg ${sc.change_pct}% vs base ${sc.baseline_pct}% · vol ${sc.volume_mult}x</span>
    </div>` : `<div style="margin-top:7px;color:var(--muted);font-size:10px">No recent strong candle with volume.</div>`;
    if (p.error) return `<div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:10px"><b>${esc(tf)}</b><div style="color:#f59e0b;font-size:11px">${esc(p.error)}</div></div>`;
    return `<div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-left:3px solid ${c};border-radius:8px;padding:10px">
      <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:6px">
        <b style="font-size:13px;color:${c}">${esc(tf)} · ${esc(p.regime)}</b>
        <span style="font-size:11px;color:${colorScore(p.score)};font-weight:800">${num(p.score,0)}/100</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,minmax(80px,1fr));gap:6px;font-size:10px">
        <span>RSI <b>${num(p.rsi,1)}</b></span><span>RSIDiff <b>${num(p.rsi_diff90,1)}</b></span>
        <span>MACD Hist <b style="color:${Number(p.macd_hist)>=0?'#22c55e':'#ef4444'}">${num(p.macd_hist,4)}</b></span>
        <span>ADX <b>${num(p.adx,1)}${p.adx_rising?' ↑':' ↓'}</b></span>
        <span>BB% <b>${num(p.bb_pct,1)}</b></span><span>BB width rank <b>${p.bb_width_rank ?? '—'}</b></span>
        <span>Vol <b>${num(p.volume_mult,2)}x</b></span><span>Stretch <b>${esc(p.stretch)}</b></span>
      </div>
      <div style="font-size:10px;color:var(--muted);margin-top:6px">Close ${money(p.close)} · EMA20 ${money(p.ema20)} · EMA50 ${money(p.ema50)} · EMA200 ${money(p.ema200)}</div>
      <div style="font-size:10px;color:var(--muted);margin-top:3px">BB/KC: Squeeze ${p.bb_inside_kc?'YES':'no'} · KC inside BB ${p.kc_inside_bb?'YES':'no'} · KC ${money(p.kc_lower)}–${money(p.kc_upper)}</div>
      ${scHtml}
    </div>`;
  }

  function wallRow(w) {
    if (!w) return '';
    const c = w.type === 'put' ? '#22c55e' : '#ef4444';
    return `<tr>
      <td style="padding:7px 8px;color:${c};font-weight:800">${w.type === 'put' ? 'PUT support' : 'CALL resistance'}</td>
      <td style="padding:7px 8px;font-weight:800">${money(w.strike,2)}</td>
      <td style="padding:7px 8px">${Number(w.oi || 0).toLocaleString()}</td>
      <td style="padding:7px 8px;color:${Number(w.oi_change || 0)>=0?'#22c55e':'#ef4444'}">${Number(w.oi_change || 0).toLocaleString('en-US',{signDisplay:'always'})}</td>
      <td style="padding:7px 8px">${num(w.score,1)}</td>
      <td style="padding:7px 8px">${w.zscore ?? '—'}</td>
      <td style="padding:7px 8px;color:var(--muted)">${esc(w.label || w.note)}</td>
    </tr>`;
  }

  const approachCards = (wp.approaches || []).map(a => `<div style="background:rgba(255,255,255,.035);border:1px solid ${a.name===preferred.name?colorScore(a.score):'rgba(255,255,255,.08)'};border-radius:8px;padding:10px">
    <div style="display:flex;justify-content:space-between;align-items:center"><b style="color:${colorScore(a.score)}">${esc(a.name)} · ${esc(a.label)}</b><span style="font-size:18px;font-weight:900;color:${colorScore(a.score)}">${num(a.score,0)}</span></div>
    <div style="font-size:10px;color:var(--muted);margin-top:4px">${esc(a.why)}</div>
  </div>`).join('');

  const wallRows = [].concat(wo.significant_put_walls || [], wo.significant_call_walls || []).map(wallRow).join('') || `<tr><td colspan="7" style="padding:12px;color:var(--muted)">No local OI wall data for this expiry yet. Run Scheduler/Dashboard OI fetch.</td></tr>`;

  const notes = (wp.setup_notes || []).map(n => `<li style="margin-bottom:3px">${esc(n)}</li>`).join('');

  const strategiesHtml = (d.strategies || []).slice(0,4).map(s => {
    const c = s.bias === 'BULL' ? '#22c55e' : s.bias === 'BEAR' ? '#ef4444' : '#f59e0b';
    const legs = (s.legs || []).map(l => `<span style="font-size:10px;padding:2px 6px;background:rgba(255,255,255,.06);border-radius:4px;margin-right:4px">${l.side==='sell'?'SELL':'BUY'} ${String(l.type).toUpperCase()} ${l.strike}</span>`).join('');
    return `<div style="border:1px solid ${c}33;border-left:3px solid ${c};border-radius:8px;padding:10px;background:rgba(255,255,255,.03)">
      <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap"><b style="color:${c}">${esc(s.type)}${s.approach_score ? ' · '+num(s.approach_score,0) : ''}</b><span style="font-size:11px;color:var(--muted)">${esc(s.iv_context)}</span></div>
      <div style="margin:6px 0">${legs}</div>
      ${s.edge ? `<div style="font-size:10px;color:var(--text2);margin-bottom:3px">${esc(s.edge)}</div>` : ''}
      <div style="font-size:10px;color:var(--muted)">${esc(s.rationale)}</div>
    </div>`;
  }).join('');

  return `<div class="wk-plan-v2" style="display:flex;flex-direction:column;gap:12px">
    <div style="display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:10px">
      <div style="background:${biasC}12;border:1px solid ${biasC}55;border-radius:10px;padding:14px">
        <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em">Weekly Plan · Monday 10am → Friday</div>
        <div style="display:flex;align-items:end;gap:12px;margin-top:4px"><div style="font-size:30px;font-weight:950;color:${biasC}">${esc(preferred.name || bias)}</div><div style="font-size:14px;font-weight:800;color:${biasC}">${num(wp.composite_score,0)}/100</div></div>
        <div style="font-size:11px;color:var(--muted);margin-top:5px">Preferred: <b>${esc(preferred.label || '—')}</b> · Directional bias ${esc(bias)} (${num(wp.directional_score,1)}) · ${esc(wp.run_use || '')}</div>
      </div>
      ${metricCard('Friday expected move', em.display || `${money(em.move)} ${pct(em.move_pct)}`, `${esc(em.source || 'IV')} · Exp ${esc(d.expiry)} · DTE ${esc(d.dte)}`, '#818cf8')}
      ${metricCard('IV / VIX', `IV ${num(d.iv_atm,1)}% · Rank ${esc(d.iv_rank)}`, vix.available ? `VIX ${vix.level} (${vix.change >= 0 ? '+' : ''}${vix.change}) · ${vix.regime}` : `Option chain: ${oc.source || '—'}`, '#a78bfa')}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <div style="background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px">
        <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Composite score components</div>
        ${scoreBar('Technical trend / regime', comp.technical_trend, 'Weekly + Daily + 4H + 2H EMA/RSI/MACD/ADX')}
        ${scoreBar('OI wall quality', comp.oi_walls, 'current OI + OI change + proximity/z-score + GEX')}
        ${scoreBar('2H/4H confirmation', comp.two_four_hour_confirmation, 'swing timeframes and volume confirmation')}
        ${scoreBar('IV / expected move', comp.iv_expected_move, 'credit vs debit environment; VIX overlay')}
        ${scoreBar('BB/Keltner / stretch', comp.squeeze_stretch, 'BB width, KC-inside-BB, squeeze, RSI, RSIDiff')}
        ${scoreBar('Wall + strong-candle alignment', comp.wall_candle_alignment, 'does fresh OI wall align with strong candle levels?')}
      </div>
      <div style="background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px">
        <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Approach scores</div>
        <div style="display:grid;grid-template-columns:1fr;gap:7px">${approachCards}</div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px">
      ${metricCard('Spot / Expiry', `${money(d.spot)} · ${esc(d.expiry)}`, `DTE ${esc(d.dte)} · ATM ${money(oc.atm_strike,2)}`, 'var(--text)')}
      ${metricCard('ATM straddle', `${money(oc.straddle_move)}`, `Call ${money(oc.call_mid)} + Put ${money(oc.put_mid)} · chain ${esc(oc.source)}`, '#f59e0b')}
      ${metricCard('Key range', `${money(em.range_low)}–${money(em.range_high)}`, `2σ ${money(em.range_low_2sd)}–${money(em.range_high_2sd)}`, '#38bdf8')}
      ${metricCard('Max pain / GEX pin', `${money(wo.max_pain)} / ${money(wo.gamma_wall)}`, `PCR ${esc(d.pcr)} · GEX ${num((d.gex||{}).gex_ratio,3)}`, '#f59e0b')}
      ${metricCard('Put wall', money((walls.support_detail||{}).strike || wo.support), `${esc((walls.support_detail||{}).label || '')} · ΔOI ${(walls.support_detail||{}).oi_change ?? '—'}`, '#22c55e')}
      ${metricCard('Call wall', money((walls.resistance_detail||{}).strike || wo.resistance), `${esc((walls.resistance_detail||{}).label || '')} · ΔOI ${(walls.resistance_detail||{}).oi_change ?? '—'}`, '#ef4444')}
    </div>

    <div style="background:rgba(59,130,246,.06);border:1px solid rgba(59,130,246,.18);border-radius:8px;padding:9px 11px;font-size:11px;color:var(--muted);line-height:1.45">
      <b style="color:#93c5fd">Weekly OI source:</b> ${esc(walls.source || woi.source || 'target expiry')} · Expiries ${esc((woi.expirations || walls.aggregate_expirations || []).slice(0,7).join(', ') || d.expiry)} · Actionable strikes ${esc((woi.selected_strikes || walls.selected_strikes || []).slice(0,6).join(', '))}${(woi.selected_strikes||walls.selected_strikes||[]).length>6?' …':''}. Deep raw walls are retained in JSON but are not allowed to dominate weekly strike selection${esc(oiFilterText)}.
    </div>

    <div style="background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px">
      <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Weekly, Daily, 4H and 2H market state</div>
      <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px">${tfCard('1w', tfs['1w'])}${tfCard('1d', tfs['1d'])}${tfCard('4h', tfs['4h'])}${tfCard('2h', tfs['2h'])}</div>
    </div>

    <div style="background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px;overflow-x:auto">
      <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Significant OI walls and accumulation/change</div>
      <table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="color:var(--muted);text-align:left"><th style="padding:7px 8px">Wall</th><th style="padding:7px 8px">Strike</th><th style="padding:7px 8px">OI</th><th style="padding:7px 8px">ΔOI</th><th style="padding:7px 8px">Score</th><th style="padding:7px 8px">Z</th><th style="padding:7px 8px">Read</th></tr></thead><tbody>${wallRows}</tbody></table>
      <div style="font-size:10px;color:var(--muted);margin-top:7px">Method: ${esc(walls.method || 'current OI + OI change + proximity + GEX')}</div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <div style="background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px">
        <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Plan notes</div>
        <ul style="font-size:11px;color:var(--muted);line-height:1.55;padding-left:18px;margin:0">${notes || '<li>No special notes.</li>'}</ul>
        ${vix.note ? `<div style="font-size:10px;color:#f59e0b;margin-top:8px">VIX overlay: ${esc(vix.note)}</div>` : ''}
      </div>
      <div style="background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px">
        <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Candidate structures</div>
        <div style="display:grid;gap:7px">${strategiesHtml || '<div style="font-size:11px;color:var(--muted)">No strategy suggestions.</div>'}</div>
      </div>
    </div>

    <div style="font-size:10px;color:var(--dim,#64748b);line-height:1.55">
      Run this on Monday around 10:00 ET after the first hour stabilizes. Use the plan as structure selection only; confirm live liquidity, bid/ask, OI at selected strikes, and SPY/QQQ GEX before entry.
    </div>
  </div>`;
}

// ════════════════════════════════════════════════════════════════════════════
// UNIVERSAL SORTABLE TABLE  — call makeSortable(tableEl) after any table render
// ════════════════════════════════════════════════════════════════════════════
(function() {
  var _sortState = new WeakMap();  // table → {col, asc}

  window.makeSortable = function(table) {
    if (!table) return;
    var ths = table.querySelectorAll('thead th, tr:first-child th');
    ths.forEach(function(th, ci) {
      if (th.dataset.nosort) return;
      th.style.cursor = 'pointer';
      th.style.userSelect = 'none';
      th.style.position = 'relative';
      // Remove old listener by cloning
      var newTh = th.cloneNode(true);
      th.parentNode.replaceChild(newTh, th);
      newTh.addEventListener('click', function() {
        var state = _sortState.get(table) || {col:-1, asc:true};
        var asc = (state.col === ci) ? !state.asc : true;
        _sortState.set(table, {col:ci, asc:asc});
        _doSort(table, ci, asc);
        // Update indicators
        table.querySelectorAll('thead th, tr:first-child th').forEach(function(h,i) {
          h.innerHTML = h.innerHTML.replace(/ [▲▼]$/, '');
          if (i === ci) h.innerHTML += (asc ? ' ▲' : ' ▼');
        });
      });
    });
  };

  function _doSort(table, col, asc) {
    var tbody = table.querySelector('tbody') || table;
    var rows  = Array.from(tbody.querySelectorAll('tr'));
    // Skip header row if no thead
    var hasHead = !!table.querySelector('thead');
    var dataRows = hasHead ? rows : rows.slice(1);

    dataRows.sort(function(a, b) {
      var aCell = a.querySelectorAll('td')[col];
      var bCell = b.querySelectorAll('td')[col];
      if (!aCell || !bCell) return 0;
      var aVal = _parseCell(aCell);
      var bVal = _parseCell(bCell);
      if (typeof aVal === 'number' && typeof bVal === 'number') {
        return asc ? aVal - bVal : bVal - aVal;
      }
      return asc
        ? String(aVal).localeCompare(String(bVal))
        : String(bVal).localeCompare(String(aVal));
    });

    dataRows.forEach(function(r) { tbody.appendChild(r); });
  }

  function _parseCell(td) {
    var raw = td.dataset.sort || td.textContent.trim();
    // Strip currency, %, K/M suffixes
    var s = raw.replace(/[$,%]/g, '').replace(/K$/,'e3').replace(/M$/,'e6').replace(/B$/,'e9').trim();
    var n = parseFloat(s);
    return isNaN(n) ? raw.toLowerCase() : n;
  }
})();

// Auto-apply to tables after renders — patch _oibRender and regime render
var _origOibRender = typeof _oibRender === 'function' ? _oibRender : null;
// We'll call makeSortable at the end of each render instead

// ── App Meta Bar — show last scan timestamps ────────────────────────────────
async function _updateMetaBar() {
  const el = document.getElementById('app-last-scan-info');
  if (!el) return;
  try {
    const d = await api('/api/fetch_status');
    const parts = [];
    if (d.regime_completed_at)          parts.push('Regime: ' + d.regime_completed_at);
    if (d.oib_completed_at)             parts.push('OI: ' + d.oib_completed_at);
    if (d.post_earnings_completed_at)   parts.push('Post-Earn: ' + d.post_earnings_completed_at);
    if (d.pre_earnings_completed_at)    parts.push('Pre-Earn: ' + d.pre_earnings_completed_at);
    if (d.last_fetch)                   parts.push('Fetch: ' + d.last_fetch);
    el.innerHTML = parts.length ? '🕐 ' + parts.join(' · ') : '';
  } catch { el.innerHTML = ''; }
}


// ════════════════════════════════════════════════════════════════════════════
// NOTIFICATION CENTER
// ════════════════════════════════════════════════════════════════════════════
// _notifs declared at top

function addNotif(type, title, detail, source) {
  // type: 'error' | 'warn' | 'ok' | 'info'
  if (!Array.isArray(_notifs)) _notifs = [];  // guard against TDZ
  var icons = {error:'❌', warn:'⚠️', ok:'✅', info:'ℹ️'};
  var colors = {error:'#ef4444', warn:'#f59e0b', ok:'#22c55e', info:'#818cf8'};
  var ts = new Date().toLocaleTimeString();
  var id = Date.now();
  _notifs.unshift({id: id, type: type, title: title, detail: detail||'', source: source||'', ts: ts, color: colors[type]||'#94a3b8', icon: icons[type]||'ℹ️'});
  if (_notifs.length > 50) _notifs.pop();
  _renderNotifs();
  // Flash bell for errors/warnings
  if (type === 'error' || type === 'warn') {
    var bell = document.getElementById('notif-bell');
    if (bell) { bell.style.color = colors[type]; setTimeout(()=>{ bell.style.color=''; }, 3000); }
  }
}

function _renderNotifs() {
  var list = document.getElementById('notif-list');
  var cnt  = document.getElementById('notif-count');
  if (!list) return;
  var merged = [].concat(_alertHistory || [], _notifs || []);
  var errCount = merged.filter(function(n){ return n.type==='error'||n.type==='warn'; }).length;
  if (cnt) { cnt.textContent = errCount > 0 ? errCount : ''; cnt.style.display = errCount > 0 ? 'block' : 'none'; }
  if (!merged.length) { list.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:20px;text-align:center">No notifications</div>'; return; }
  merged.sort(function(a, b) { return String(b.ts || b.created_at || '').localeCompare(String(a.ts || a.created_at || '')); });
  list.innerHTML = merged.map(function(n) {
    return '<div style="padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.05)">'
      + '<div style="display:flex;justify-content:space-between;margin-bottom:4px">'
      + '<span style="font-size:12px;font-weight:700;color:'+n.color+'">'+n.icon+' '+n.title+'</span>'
      + '<span style="font-size:10px;color:var(--muted)">'+(n.ts || n.created_at || '')+(n.source?' · '+n.source:'')+'</span>'
      + '</div>'
      + (n.detail ? '<div style="font-size:11px;color:var(--muted);white-space:pre-wrap;font-family:monospace;max-height:120px;overflow-y:auto;background:rgba(0,0,0,.2);padding:4px 6px;border-radius:4px">'+n.detail+'</div>' : '')
      + '</div>';
  }).join('');
}

async function _loadAlertHistory() {
  try {
    var d = await api('/watchlists/alerts/history?limit=100');
    _alertHistory = Array.isArray(d && d.alerts) ? d.alerts.map(function(a) {
      return {
        id: a.id,
        type: (a.severity === 'warn' || a.alert_type === 'PNR_BREACH' || a.alert_type === 'SCANNER_EXIT') ? 'warn' : (a.severity === 'error' ? 'error' : 'info'),
        title: a.title || a.alert_type || 'Alert',
        detail: a.detail || '',
        source: a.source || a.alert_type || 'Alerts',
        ts: a.created_at || '',
        color: a.severity === 'warn' ? '#f59e0b' : (a.severity === 'error' ? '#ef4444' : '#818cf8'),
        icon: a.severity === 'warn' ? '⚠️' : (a.severity === 'error' ? '❌' : 'ℹ️')
      };
    }) : [];
  } catch (e) {
    _alertHistory = [];
  }
  _renderNotifs();
}

async function toggleNotifPanel() {
  var p = document.getElementById('notif-panel');
  if (!p) return;
  p.style.display = p.style.display === 'flex' ? 'none' : 'flex';
  if (p.style.display === 'flex') await _loadAlertHistory();
}

function clearNotifs() {
  _notifs = [];
  _renderNotifs();
}

async function _loadAlertsHub() {
  await Promise.allSettled([
    _loadAlertsPicklists(),
    _loadAlertsAllSymbols(),
    _loadSymbolAlertsHub(),
    _loadTradePnrAlerts(),
    _loadScannerAlertsHub(),
    _loadAlertHistoryHub(),
  ]);
}


async function _loadAlertsAllSymbols() {
  const box = document.getElementById('alerts-symbols-wrap');
  const st = document.getElementById('alerts-symbols-status');
  const input = document.getElementById('alerts-symbol-entry');
  if (!box) return;
  if (st) st.textContent = '⏳ Loading symbols…';
  try {
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    const symbolSet = new Set();
    await Promise.all((wls || []).map(async (wl) => {
      try {
        const s = await api(`/watchlists/${wl.id}/symbols`);
        (s.symbols || []).forEach(x => symbolSet.add(String(x.symbol || '').toUpperCase()));
      } catch {}
    }));
    const symbols = Array.from(symbolSet).filter(Boolean).sort();
    if (input && !input.value.trim()) input.value = symbols.join(', ');
    box.innerHTML = symbols.length
      ? '<div style="display:flex;flex-wrap:wrap;gap:6px;max-height:120px;overflow:auto">' + symbols.map(sym => `<span style="padding:2px 6px;border:1px solid var(--border);border-radius:999px;font-size:11px">${sym}</span>`).join('') + '</div>'
      : '<div style="color:var(--muted);font-size:12px">No symbols found in watchlists.</div>';
    if (st) st.textContent = `${symbols.length} unique symbols`;
  } catch (e) {
    box.innerHTML = '<div style="color:#ef4444;font-size:12px">' + e.message + '</div>';
    if (st) st.textContent = 'Error';
  }
}

async function _loadAlertsWatchlists() {
  var wrap = document.getElementById('alerts-watchlists-wrap');
  var st = document.getElementById('alerts-watchlists-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    var d = await api('/watchlists/');
    var rows = (d && d.watchlists) ? d.watchlists : [];
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No watchlists found.</div>';
      if (st) st.textContent = '0 watchlists';
      return;
    }
    wrap.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="background:rgba(255,255,255,.05)"><th style="padding:8px;text-align:left">Watchlist</th><th style="padding:8px;text-align:left">Symbols</th><th style="padding:8px;text-align:left">Mode</th><th style="padding:8px;text-align:left">Default</th><th style="padding:8px;text-align:left">Last Fetch</th><th style="padding:8px;text-align:left">Action</th></tr></thead><tbody>' + rows.map(function(wl) {
      return '<tr style="border-top:1px solid var(--border)"><td style="padding:8px;font-weight:700">' + (wl.name || '—') + '</td><td style="padding:8px">' + (wl.symbol_count || 0) + '</td><td style="padding:8px">' + (wl.fetch_options_oi ? 'Options OI' : 'Price/Vol') + '</td><td style="padding:8px">' + (wl.is_default ? '⭐ Yes' : 'No') + '</td><td style="padding:8px;color:var(--muted)">' + (wl.last_fetch_at || '—') + '</td><td style="padding:8px"><button class="btn btn-ghost btn-sm" onclick="_openWatchlistFromAlerts(' + wl.id + ')">Open</button></td></tr>';
    }).join('') + '</tbody></table>';
    if (st) st.textContent = rows.length + ' watchlists';
  } catch (e) {
    wrap.innerHTML = '<div style="color:#ef4444;font-size:12px;padding:16px">' + e.message + '</div>';
    if (st) st.textContent = 'Error';
  }
}

function _openWatchlistFromAlerts(wlId) {
  _setActiveTab('watchlists');
  setTimeout(function() {
    try { _wlLoadSymbolsPanel(wlId, 'Watchlist'); } catch {}
  }, 120);
}

function _priceAlertRowKey(wlId, symbol) {
  return `${Number(wlId)}:${String(symbol || '').trim().toUpperCase()}`;
}

function _removeDeletedSymbolAlertFromGrids(wlId, symbol) {
  const key = _priceAlertRowKey(wlId, symbol);
  document.querySelectorAll('[data-price-alert-row]').forEach(function(row) {
    if (row.dataset.priceAlertRow === key) row.remove();
  });
  const symbolUpper = String(symbol || '').trim().toUpperCase();
  const priceEl = document.getElementById(`wl-ap-${Number(wlId)}-${symbolUpper}`);
  const dirEl = document.getElementById(`wl-ad-${Number(wlId)}-${symbolUpper}`);
  const enEl = document.getElementById(`wl-ae-${Number(wlId)}-${symbolUpper}`);
  if (priceEl) priceEl.value = '';
  if (dirEl) dirEl.value = 'both';
  if (enEl) enEl.checked = false;
  const wrap = document.getElementById('symbol-alerts-wrap');
  if (wrap) {
    const bodyRows = wrap.querySelectorAll('tbody tr');
    if (!bodyRows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No symbol alerts enabled.</div>';
      const st = document.getElementById('symbol-alerts-status');
      if (st) st.textContent = '0 alerts';
    }
  }
}

async function _loadSymbolAlertsHub(forceRefresh=false) {
  var wrap = document.getElementById('symbol-alerts-wrap');
  var st = document.getElementById('symbol-alerts-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    var d = await api('/watchlists/alerts/open?_=' + Date.now());
    var rows = d.alerts || [];
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No symbol alerts enabled.</div>';
      if (st) st.textContent = '0 alerts';
      return;
    }
    wrap.innerHTML = `
      <table style="width:100%;border-collapse:collapse;font-size:12px">
        <thead><tr style="background:rgba(255,255,255,.05)">
          <th style="padding:8px;text-align:left">Watchlist</th>
          <th style="padding:8px;text-align:left">Symbol</th>
          <th style="padding:8px;text-align:left">Price</th>
          <th style="padding:8px;text-align:left">Dir</th>
          <th style="padding:8px;text-align:left">Mode</th>
          <th style="padding:8px;text-align:left">Action</th>
        </tr></thead>
        <tbody>
          ${rows.map(function(r) {
            const rowKey = _priceAlertRowKey(r.watchlist_id, r.symbol);
            return `<tr data-price-alert-row="${rowKey}" style="border-top:1px solid var(--border)">
              <td style="padding:8px">${r.watchlist_name || '—'}</td>
              <td style="padding:8px;font-weight:700">${r.symbol || '—'}</td>
              <td style="padding:8px">${fmt(r.alert_price, 2)}</td>
              <td style="padding:8px">${r.alert_direction || 'both'}</td>
              <td style="padding:8px">${r.alert_enabled ? 'Yes' : 'No'}</td>
              <td style="padding:8px;display:flex;gap:6px;flex-wrap:wrap"><button type="button" class="btn btn-ghost btn-sm" onclick="_jumpToWatchlistAlert(${r.watchlist_id}, ${JSON.stringify(String(r.symbol || ''))})">Edit</button><button type="button" class="btn btn-ghost btn-sm" onclick="_deleteSymbolPriceAlert(${r.watchlist_id}, ${JSON.stringify(String(r.symbol || ''))})">Delete</button></td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>`;
    if (st) st.textContent = rows.length + ' alerts';
  } catch (e) {
    wrap.innerHTML = '<div style="color:#ef4444;font-size:12px;padding:16px">' + e.message + '</div>';
    if (st) st.textContent = 'Error';
  }
}

// ── Trade Health Alert Hub ────────────────────────────────────────────────
async function _sendHealthAlertsTelegram() {
  try {
    addNotif('info', 'Health Alerts', 'Scanning trades and sending Telegram alerts…', 'Journal');
    const d = await api('/journal/health_alert/manual_scan', {
      method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({}),
    });
    const suppressed = d.suppressed || 0;
    const skipped = d.skipped || 0;
    addNotif(d.sent > 0 ? 'warn' : 'info', 'Health Alerts',
      `Sent ${d.sent} Telegram alert${d.sent===1?'':'s'} (${d.health_sent ?? d.sent} health, ${d.ai_sent || 0} AI, ${d.position_custom_sent || 0} custom) · suppressed ${suppressed} · skipped ${skipped}`, 'Journal');
    await _loadTradeHealthAlerts();
  } catch(e) {
    addNotif('err', 'Health Alerts', e.message || String(e), 'Journal');
  }
}


function _posAlertEscape(v) {
  return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}


// Position custom-alert expression autocomplete / parameter help.
// Reuses the Scanner Builder catalog used by normal Alert Hub alerts, but also
// suggests position-specific variables like short_strike and call_sell.
const _posAlertExpressionIds = ['pos-alert-rule-bull', 'pos-alert-rule-bear', 'pos-alert-rule-neutral'];
let _posAlertActiveTextAreaId = 'pos-alert-rule-bull';
let _posAlertAutocompleteItems = [];
let _posAlertAutocompleteIndex = -1;
const _posAlertAutocompleteWired = new Set();

const _posAlertVariableMeta = [
  {name:'spot', signature:'spot', description:'Current underlying/stock price for the trade symbol', kind:'variable'},
  {name:'short_strike', signature:'short_strike', description:'Sold strike for PS/CS/CB/PB verticals', kind:'variable'},
  {name:'long_strike', signature:'long_strike', description:'Bought strike for PS/CS/CB/PB verticals', kind:'variable'},
  {name:'sell_strike', signature:'sell_strike', description:'Alias for the sold leg strike', kind:'variable'},
  {name:'buy_strike', signature:'buy_strike', description:'Alias for the bought leg strike', kind:'variable'},
  {name:'put_sell', signature:'put_sell', description:'IC/put spread short put strike', kind:'variable'},
  {name:'put_buy', signature:'put_buy', description:'IC/put spread long put strike', kind:'variable'},
  {name:'call_sell', signature:'call_sell', description:'IC/call spread short call strike', kind:'variable'},
  {name:'call_buy', signature:'call_buy', description:'IC/call spread long call strike', kind:'variable'},
  {name:'short_put', signature:'short_put', description:'Alias for put_sell', kind:'variable'},
  {name:'long_put', signature:'long_put', description:'Alias for put_buy', kind:'variable'},
  {name:'short_call', signature:'short_call', description:'Alias for call_sell', kind:'variable'},
  {name:'long_call', signature:'long_call', description:'Alias for call_buy', kind:'variable'},
  {name:'breakeven', signature:'breakeven', description:'Estimated breakeven for one-sided verticals', kind:'variable'},
  {name:'lower_breakeven', signature:'lower_breakeven', description:'Lower breakeven for IC', kind:'variable'},
  {name:'upper_breakeven', signature:'upper_breakeven', description:'Upper breakeven for IC', kind:'variable'},
  {name:'dte', signature:'dte', description:'Days to expiry from today', kind:'variable'},
  {name:'pnl', signature:'pnl', description:'Current unrealized P&L dollars', kind:'variable'},
  {name:'pnl_pct', signature:'pnl_pct', description:'Current P&L as percent of max risk', kind:'variable'},
  {name:'max_loss', signature:'max_loss', description:'Estimated max risk dollars', kind:'variable'},
  {name:'max_profit', signature:'max_profit', description:'Estimated max reward dollars', kind:'variable'},
  {name:'pnr', signature:'pnr', description:'Lower PNR safety line when available', kind:'variable'},
  {name:'pnr_upper', signature:'pnr_upper', description:'Upper PNR safety line when available', kind:'variable'},
  {name:'distance_to_short', signature:'distance_to_short', description:'spot - short_strike; positive means price is above the short strike', kind:'variable'},
  {name:'distance_pct_to_short', signature:'distance_pct_to_short', description:'Percent distance from spot to short_strike', kind:'variable'},
  {name:'distance_to_long', signature:'distance_to_long', description:'spot - long_strike', kind:'variable'},
  {name:'distance_pct_to_long', signature:'distance_pct_to_long', description:'Percent distance from spot to long_strike', kind:'variable'},
];

function _posAlertTextArea(id) {
  if (id) return document.getElementById(id);
  return document.getElementById(_posAlertActiveTextAreaId) || document.getElementById('pos-alert-rule-bull');
}

function _posAlertPanel(id) {
  const ta = _posAlertTextArea(id);
  return ta ? document.getElementById(`${ta.id}-autocomplete`) : null;
}

function _posAlertHint() {
  return document.getElementById('pos-alert-rule-func-hint');
}

function _posAlertSetActive(id) {
  if (id && document.getElementById(id)) _posAlertActiveTextAreaId = id;
}

function _posAlertCurrentRange(ta) {
  const cursor = ta.selectionStart ?? ta.value.length;
  const end = ta.selectionEnd ?? cursor;
  if (end !== cursor) return {mode:'selection', start: cursor, end};
  const before = ta.value.slice(0, cursor);
  const scanMatch = before.match(/scan\(\s*([A-Za-z0-9_\- ]*)$/i);
  if (scanMatch) return {mode:'scan', start: before.length - scanMatch[0].length, end: cursor};
  const fnParen = before.match(/([A-Za-z_][A-Za-z0-9_]*)\($/);
  if (fnParen) return {mode:'function', start: before.length - fnParen[0].length, end: cursor};
  const token = before.match(/([A-Za-z_][A-Za-z0-9_]*)$/);
  if (token) return {mode:'token', start: before.length - token[0].length, end: cursor};
  return {mode:'insert', start: cursor, end: cursor};
}

function _posAlertCurrentTokenBeforeCursor(ta) {
  const cursor = ta.selectionStart ?? ta.value.length;
  const before = ta.value.slice(0, cursor);
  const scanMatch = before.match(/scan\(\s*([A-Za-z0-9_\- ]*)$/i);
  if (scanMatch) return {mode:'scan', typed:(scanMatch[1] || '').trim().toLowerCase()};
  const fnParen = before.match(/([A-Za-z_][A-Za-z0-9_]*)\($/);
  if (fnParen) return {mode:'function', typed:fnParen[1].toLowerCase()};
  const token = before.match(/([A-Za-z_][A-Za-z0-9_]*)$/);
  if (token) return {mode:'token', typed:token[1].toLowerCase()};
  return {mode:'none', typed:''};
}

function _posAlertReplaceFragment(id, text, statusMessage, cursorOffset = null) {
  const ta = _posAlertTextArea(id);
  if (!ta) return;
  _posAlertSetActive(ta.id);
  const range = _posAlertCurrentRange(ta);
  ta.value = ta.value.slice(0, range.start) + text + ta.value.slice(range.end);
  const pos = range.start + (cursorOffset == null ? text.length : cursorOffset);
  ta.setSelectionRange(pos, pos);
  ta.focus();
  if (typeof _alertSetBuilderStatus === 'function') _alertSetBuilderStatus(statusMessage || 'Inserted');
  _posAlertUpdateFunctionHelp(ta.id);
}

function _posAlertInsertFunctionCall(id, name) {
  const call = `${name}()`;
  _posAlertReplaceFragment(id, call, `Inserted ${call}`, name.length + 1);
}

function _posAlertInsertScannerCall(id, name) {
  _posAlertReplaceFragment(id, `scan(${name})`, `Inserted scan(${name})`);
}

function _posAlertCommitItem(id, item, action) {
  if (!item) return;
  if (item.kind === 'function' || action === 'insert-fn') _posAlertInsertFunctionCall(id, item.name);
  else if (item.kind === 'variable') _posAlertReplaceFragment(id, item.name, `Inserted ${item.name}`);
  else if (action === 'ref') _posAlertInsertScannerCall(id, item.name);
  else _posAlertReplaceFragment(id, _alertScannerSnippet(item), 'Inserted scanner code block');
  const panel = _posAlertPanel(id); if (panel) panel.style.display = 'none';
}

function _posAlertRenderAutocompleteSelection(id) {
  const panel = _posAlertPanel(id);
  if (!panel) return;
  panel.querySelectorAll('.scanner-autocomplete-item').forEach(el => {
    el.classList.toggle('selected', Number(el.dataset.idx || -1) === _posAlertAutocompleteIndex);
  });
}

function _posAlertChooseAutocomplete(id, delta = 0) {
  if (!_posAlertAutocompleteItems.length) return false;
  _posAlertAutocompleteIndex = Math.max(0, Math.min(_posAlertAutocompleteItems.length - 1, _posAlertAutocompleteIndex + delta));
  _posAlertRenderAutocompleteSelection(id);
  return true;
}

function _posAlertCommitAutocomplete(id) {
  if (!_posAlertAutocompleteItems.length) return false;
  const item = _posAlertAutocompleteItems[Math.max(0, _posAlertAutocompleteIndex)] || _posAlertAutocompleteItems[0];
  _posAlertCommitItem(id, item);
  return true;
}

function _posAlertShowAutocomplete(id = null, forceAll = false) {
  const ta = _posAlertTextArea(id);
  if (!ta) return;
  _posAlertSetActive(ta.id);
  _posAlertExpressionIds.forEach(otherId => {
    if (otherId !== ta.id) { const p = _posAlertPanel(otherId); if (p) p.style.display = 'none'; }
  });
  const panel = _posAlertPanel(ta.id);
  if (!panel) return;
  const token = _posAlertCurrentTokenBeforeCursor(ta);
  const mode = token.mode;
  const typed = token.typed || '';
  if (!forceAll && mode === 'none') {
    panel.style.display = 'none'; panel.innerHTML = ''; _posAlertAutocompleteItems = []; _posAlertAutocompleteIndex = -1;
    _posAlertUpdateFunctionHelp(ta.id);
    return;
  }
  let entries = [];
  if (mode === 'scan' || forceAll) {
    entries = _alertAllScannerEntries()
      .filter(x => !typed || String(x.name || '').toLowerCase().includes(typed))
      .slice(0, 16)
      .map(x => ({...x, kind:'scanner'}));
  }
  if (mode === 'function' || mode === 'token' || forceAll) {
    const fnEntries = _alertAllFunctionEntries()
      .filter(x => !typed || String(x.name || '').toLowerCase().startsWith(typed))
      .slice(0, 18)
      .map(x => ({...x, kind:'function'}));
    const varEntries = _posAlertVariableMeta
      .filter(x => !typed || String(x.name || '').toLowerCase().startsWith(typed))
      .slice(0, 18);
    entries = (mode === 'scan' && !forceAll) ? entries : [...fnEntries, ...varEntries, ...entries];
  }
  const seen = new Set();
  entries = entries.filter(x => {
    const k = `${x.kind}:${String(x.name || '').toLowerCase()}`;
    if (!x.name || seen.has(k)) return false;
    seen.add(k); return true;
  }).slice(0, 28);
  if (!entries.length) {
    panel.style.display = 'none'; panel.innerHTML = ''; _posAlertAutocompleteItems = []; _posAlertAutocompleteIndex = -1;
    _posAlertUpdateFunctionHelp(ta.id);
    return;
  }
  _posAlertAutocompleteItems = entries;
  _posAlertAutocompleteIndex = 0;
  panel.innerHTML = entries.map((x, idx) => {
    if (x.kind === 'function') {
      return `<div class="scanner-autocomplete-item ${idx === 0 ? 'selected' : ''}" data-idx="${idx}">
        <div style="min-width:0"><b>${_alertHtmlEscape(x.name)}</b> <span style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.signature || '')}</span><div style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.description || 'Primitive')}</div></div>
        <button type="button" class="btn btn-ghost btn-sm" data-action="insert-fn" data-name="${_alertHtmlEscape(x.name)}">fn()</button>
      </div>`;
    }
    if (x.kind === 'variable') {
      return `<div class="scanner-autocomplete-item ${idx === 0 ? 'selected' : ''}" data-idx="${idx}">
        <div style="min-width:0"><b>${_alertHtmlEscape(x.name)}</b> <span style="color:#a78bfa;font-size:11px">position variable</span><div style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.description || '')}</div></div>
        <button type="button" class="btn btn-ghost btn-sm" data-action="insert-var" data-name="${_alertHtmlEscape(x.name)}">var</button>
      </div>`;
    }
    return `<div class="scanner-autocomplete-item ${idx === 0 ? 'selected' : ''}" data-idx="${idx}">
      <div style="min-width:0"><b>${_alertHtmlEscape(x.name)}</b><div style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.category || 'Scanner')}</div><pre class="scanner-code">${_alertHtmlEscape(_alertScannerSnippet(x))}</pre></div>
      <div style="display:flex;gap:6px;flex-shrink:0"><button type="button" class="btn btn-ghost btn-sm" data-action="code" data-name="${_alertHtmlEscape(x.name)}">code</button><button type="button" class="btn btn-ghost btn-sm" data-action="ref" data-name="${_alertHtmlEscape(x.name)}">scan()</button></div>
    </div>`;
  }).join('');
  panel.style.display = 'block';
  panel.querySelectorAll('.scanner-autocomplete-item').forEach(el => {
    el.addEventListener('mouseenter', () => { _posAlertAutocompleteIndex = Number(el.dataset.idx || 0); _posAlertRenderAutocompleteSelection(ta.id); });
    el.addEventListener('mousedown', e => {
      const btn = e.target.closest('button[data-action]');
      if (btn) return;
      e.preventDefault();
      _posAlertCommitItem(ta.id, _posAlertAutocompleteItems[Number(el.dataset.idx || 0)]);
    });
  });
  panel.querySelectorAll('button[data-action]').forEach(btn => btn.addEventListener('mousedown', e => {
    e.preventDefault();
    const item = _posAlertAutocompleteItems.find(x => String(x.name) === String(btn.dataset.name));
    _posAlertCommitItem(ta.id, item, btn.dataset.action);
  }));
  _posAlertUpdateFunctionHelp(ta.id);
}

function _posAlertUpdateFunctionHelp(id = null) {
  const hint = _posAlertHint();
  const ta = _posAlertTextArea(id);
  if (!hint || !ta) return;
  _posAlertSetActive(ta.id);
  const text = ta.value || '';
  const cursor = ta.selectionStart ?? text.length;
  const active = _alertFindActiveFunction(text, cursor);
  let meta = null;
  let paramIndex = 0;
  if (active) {
    paramIndex = active.paramIndex;
    meta = _alertAllFunctionEntries().find(x => String(x.name || '').toLowerCase() === String(active.name || '').toLowerCase());
  } else {
    const tok = _posAlertCurrentTokenBeforeCursor(ta);
    if ((tok.mode === 'function' || tok.mode === 'token') && tok.typed) {
      meta = _alertAllFunctionEntries().find(x => String(x.name || '').toLowerCase().startsWith(tok.typed))
          || _posAlertVariableMeta.find(x => String(x.name || '').toLowerCase().startsWith(tok.typed));
    }
  }
  if (!meta) {
    hint.innerHTML = 'Type a primitive or position variable. Examples: <code>close[1d] &lt; short_strike</code>, <code>distance_pct_to_short &lt;= 1</code>, <code>close[1d] &gt; call_sell OR close[1d] &lt; put_sell</code>. Position variables include <code>short_strike</code>, <code>long_strike</code>, <code>put_sell</code>, <code>call_sell</code>, <code>breakeven</code>, <code>dte</code>, and <code>pnl</code>.';
    return;
  }
  if (meta.kind === 'variable') {
    hint.innerHTML = `<b>${_alertHtmlEscape(meta.name)}</b> <span class="dim">position variable</span><br><span>${_alertHtmlEscape(meta.description || '')}</span>`;
    return;
  }
  const params = _alertSignatureParams(meta.signature);
  const current = params.length ? params[Math.min(paramIndex, params.length - 1)] : 'value';
  const paramHtml = params.length ? `<div>${params.map((p, i) => `<span class="param ${active && i === Math.min(paramIndex, params.length - 1) ? 'active' : ''}">${i + 1}. ${_alertHtmlEscape(p)}</span>`).join('')}</div>` : '';
  hint.innerHTML = `<b>${_alertHtmlEscape(meta.name)}</b> <span class="dim">${_alertHtmlEscape(meta.signature || '')}</span><br><span>${_alertHtmlEscape(meta.description || '')}</span>${active ? `<br><span class="warn">Current parameter: ${_alertHtmlEscape(current)}</span>` : ''}${paramHtml}`;
}

function _posAlertInitConditionAutocomplete() {
  _posAlertExpressionIds.forEach(id => {
    const ta = document.getElementById(id);
    if (!ta || _posAlertAutocompleteWired.has(id)) return;
    _posAlertAutocompleteWired.add(id);
    ta.addEventListener('focus', () => { _posAlertSetActive(id); _alertLoadScannerCatalog().then(() => _posAlertUpdateFunctionHelp(id)); });
    ta.addEventListener('input', () => { _posAlertSetActive(id); _posAlertShowAutocomplete(id); _posAlertUpdateFunctionHelp(id); });
    ta.addEventListener('keyup', () => { _posAlertSetActive(id); _posAlertShowAutocomplete(id); _posAlertUpdateFunctionHelp(id); });
    ta.addEventListener('click', () => { _posAlertSetActive(id); _posAlertShowAutocomplete(id); _posAlertUpdateFunctionHelp(id); });
    ta.addEventListener('keydown', e => {
      const panel = _posAlertPanel(id);
      const visible = panel && panel.style.display === 'block';
      if (e.shiftKey && e.key === 'Enter') { e.preventDefault(); _posAlertOpenAutocomplete(id); return; }
      if (visible && e.key === 'ArrowDown') { e.preventDefault(); _posAlertChooseAutocomplete(id, 1); return; }
      if (visible && e.key === 'ArrowUp') { e.preventDefault(); _posAlertChooseAutocomplete(id, -1); return; }
      if (visible && e.key === 'Enter') { e.preventDefault(); _posAlertCommitAutocomplete(id); return; }
      if (visible && e.key === 'Escape') { e.preventDefault(); panel.style.display = 'none'; return; }
    });
    ta.addEventListener('blur', () => setTimeout(() => {
      const panel = _posAlertPanel(id); if (panel) panel.style.display = 'none';
      _posAlertUpdateFunctionHelp(id);
    }, 160));
  });
  _posAlertUpdateFunctionHelp(_posAlertActiveTextAreaId);
}

function _posAlertOpenAutocomplete(id = null) {
  const targetId = id || _posAlertActiveTextAreaId || 'pos-alert-rule-bull';
  const ta = _posAlertTextArea(targetId);
  if (!ta) return;
  _posAlertSetActive(ta.id);
  _alertLoadScannerCatalog().then(() => {
    ta.focus();
    _posAlertShowAutocomplete(ta.id, true);
    _posAlertUpdateFunctionHelp(ta.id);
  });
}

function _posAlertFormData() {
  return {
    name: (document.getElementById('pos-alert-rule-name')?.value || '').trim(),
    enabled: !!document.getElementById('pos-alert-rule-enabled')?.checked,
    severity: (document.getElementById('pos-alert-rule-severity')?.value || 'warning'),
    benchmark: (document.getElementById('pos-alert-rule-benchmark')?.value || 'SPY').trim().toUpperCase(),
    bull_condition: (document.getElementById('pos-alert-rule-bull')?.value || '').trim(),
    bear_condition: (document.getElementById('pos-alert-rule-bear')?.value || '').trim(),
    neutral_condition: (document.getElementById('pos-alert-rule-neutral')?.value || '').trim(),
    notes: (document.getElementById('pos-alert-rule-notes')?.value || '').trim(),
  };
}

function _resetPositionAlertRuleForm() {
  const ids = ['pos-alert-rule-id','pos-alert-rule-name','pos-alert-rule-bull','pos-alert-rule-bear','pos-alert-rule-neutral','pos-alert-rule-notes'];
  ids.forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  const en = document.getElementById('pos-alert-rule-enabled'); if (en) en.checked = true;
  const sev = document.getElementById('pos-alert-rule-severity'); if (sev) sev.value = 'warning';
  const bm = document.getElementById('pos-alert-rule-benchmark'); if (bm) bm.value = 'SPY';
  try { _posAlertUpdateFunctionHelp(); } catch {}
}

function _posAlertUseMacdTemplate() {
  const name = document.getElementById('pos-alert-rule-name');
  const bull = document.getElementById('pos-alert-rule-bull');
  const bear = document.getElementById('pos-alert-rule-bear');
  const neu  = document.getElementById('pos-alert-rule-neutral');
  if (name && !name.value) name.value = 'MACD adverse cross';
  if (bull) bull.value = 'CrossBelow(MACDLine, MACDSignal, "1d")';
  if (bear) bear.value = 'CrossAbove(MACDLine, MACDSignal, "1d")';
  if (neu)  neu.value  = 'CrossAbove(MACDLine, MACDSignal, "1d") OR CrossBelow(MACDLine, MACDSignal, "1d")';
  const sev = document.getElementById('pos-alert-rule-severity'); if (sev) sev.value = 'warning';
  const bm = document.getElementById('pos-alert-rule-benchmark'); if (bm) bm.value = 'SPY';
  try { _posAlertUpdateFunctionHelp(); } catch {}
}

function _editPositionAlertRule(rule) {
  if (!rule) return;
  const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = val == null ? '' : String(val); };
  set('pos-alert-rule-id', rule.id || '');
  set('pos-alert-rule-name', rule.name || '');
  set('pos-alert-rule-severity', rule.severity || 'warning');
  set('pos-alert-rule-benchmark', rule.benchmark || 'SPY');
  set('pos-alert-rule-bull', rule.bull_condition || '');
  set('pos-alert-rule-bear', rule.bear_condition || '');
  set('pos-alert-rule-neutral', rule.neutral_condition || '');
  set('pos-alert-rule-notes', rule.notes || '');
  const en = document.getElementById('pos-alert-rule-enabled'); if (en) en.checked = !!Number(rule.enabled ?? 1);
  const panel = document.getElementById('position-custom-alert-panel'); if (panel) panel.open = true;
  try { _posAlertInitConditionAutocomplete(); _posAlertUpdateFunctionHelp(); } catch {}
}

async function _savePositionAlertRule() {
  const data = _posAlertFormData();
  const id = (document.getElementById('pos-alert-rule-id')?.value || '').trim();
  if (!data.name) { addNotif('err', 'Position alerts', 'Rule name is required', 'Journal'); return; }
  if (!data.bull_condition && !data.bear_condition && !data.neutral_condition) {
    addNotif('err', 'Position alerts', 'Enter at least one condition', 'Journal'); return;
  }
  try {
    const url = id ? `/journal/position_alert_rules/${encodeURIComponent(id)}` : '/journal/position_alert_rules';
    const method = id ? 'PUT' : 'POST';
    const d = await api(url, {method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(data)});
    if (!d.ok) throw new Error(d.error || 'Save failed');
    addNotif('ok', 'Position alerts', 'Rule saved', 'Journal');
    _resetPositionAlertRuleForm();
    await _loadPositionAlertRules();
  } catch(e) {
    addNotif('err', 'Position alerts', e.message || String(e), 'Journal');
  }
}

async function _deletePositionAlertRule(id) {
  if (!id) return;
  if (!confirm('Delete this custom position alert rule?')) return;
  try {
    const d = await api(`/journal/position_alert_rules/${encodeURIComponent(id)}`, {method:'DELETE'});
    if (!d.ok) throw new Error(d.error || 'Delete failed');
    addNotif('ok', 'Position alerts', 'Rule deleted', 'Journal');
    await _loadPositionAlertRules();
  } catch(e) {
    addNotif('err', 'Position alerts', e.message || String(e), 'Journal');
  }
}


function _posAlertSideFromTradeType(tt) {
  const t = String(tt || '').toUpperCase();
  if (['PS','CB','CALL','LONG_CALL'].includes(t)) return {label:'Bullish', color:'#22c55e'};
  if (['CS','PB','PUT','LONG_PUT'].includes(t)) return {label:'Bearish', color:'#ef4444'};
  if (t === 'IC') return {label:'Neutral', color:'#a78bfa'};
  return {label:'Neutral', color:'#94a3b8'};
}

async function _loadPositionAlertOpenTrades() {
  const wrap = document.getElementById('position-alert-open-trades-wrap');
  if (!wrap) return;
  wrap.innerHTML = '<div style="color:var(--muted);font-size:11px;padding:8px">Loading open positions...</div>';
  try {
    const d = await api('/journal/health_alerts_all');
    const rows = d.alerts || [];
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:11px;padding:8px;border:1px dashed var(--border);border-radius:6px">No open option positions.</div>';
      return;
    }
    wrap.innerHTML = `<table style="width:100%;min-width:980px;border-collapse:collapse;font-size:10px">
      <thead><tr style="background:rgba(255,255,255,.04);color:var(--muted)">
        <th style="padding:6px;text-align:left">Symbol</th>
        <th style="padding:6px;text-align:left">Type</th>
        <th style="padding:6px;text-align:left">Alert side</th>
        <th style="padding:6px;text-align:left">Strikes</th>
        <th style="padding:6px;text-align:left">Expiry</th>
        <th style="padding:6px;text-align:left">DTE</th>
        <th style="padding:6px;text-align:left">Spot</th>
        <th style="padding:6px;text-align:left">PNR</th>
        <th style="padding:6px;text-align:left">Score</th>
      </tr></thead>
      <tbody>${rows.map(a => {
        const side = _posAlertSideFromTradeType(a.trade_type);
        const score = a.trade_health_score == null ? '—' : Number(a.trade_health_score).toFixed(0);
        const pnr = [a.pnr != null ? fmt(a.pnr,2)+'↓' : '', a.pnr_upper != null ? fmt(a.pnr_upper,2)+'↑' : ''].filter(Boolean).join(' / ') || '—';
        return `<tr style="border-top:1px solid var(--border)">
          <td style="padding:6px;font-weight:800;color:var(--accent)">${_posAlertEscape(a.symbol || '—')}</td>
          <td style="padding:6px">${_posAlertEscape(a.trade_type || '—')}</td>
          <td style="padding:6px;color:${side.color};font-weight:700">${side.label}</td>
          <td style="padding:6px;color:#e2e8f0;white-space:nowrap">${_posAlertEscape(a.strikes || '—')}</td>
          <td style="padding:6px;color:var(--muted);white-space:nowrap">${_posAlertEscape(a.expiry || '—')}</td>
          <td style="padding:6px;color:var(--muted);white-space:nowrap">${a.dte != null ? _posAlertEscape(a.dte + 'd') : '—'}</td>
          <td style="padding:6px;white-space:nowrap">${a.spot != null ? fmt(a.spot,2) : '—'}</td>
          <td style="padding:6px;white-space:nowrap">${_posAlertEscape(pnr)}</td>
          <td style="padding:6px;font-weight:800">${score}</td>
        </tr>`;
      }).join('')}</tbody></table>`;
  } catch(e) {
    wrap.innerHTML = `<div style="color:#ef4444;font-size:11px;padding:8px">${_posAlertEscape(e.message || String(e))}</div>`;
  }
}

async function _loadPositionAlertRules() {
  _posAlertInitConditionAutocomplete();
  _alertLoadScannerCatalog().then(() => _posAlertUpdateFunctionHelp(_posAlertActiveTextAreaId));
  _loadPositionAlertOpenTrades();
  const wrap = document.getElementById('position-alert-rules-wrap');
  const st = document.getElementById('position-alert-rules-status');
  if (!wrap) return;
  if (st) st.textContent = 'Loading rules...';
  try {
    const d = await api('/journal/position_alert_rules');
    const rows = d.rules || [];
    if (!rows.length) {
      wrap.innerHTML = '<div style="font-size:11px;color:var(--muted);padding:8px;border:1px dashed var(--border);border-radius:6px">No custom position alert rules yet. Click "Use MACD adverse-cross template" to start.</div>';
      if (st) st.textContent = '0 custom rules';
      return;
    }
    wrap.innerHTML = `<table style="width:100%;min-width:1180px;border-collapse:collapse;font-size:10px;table-layout:auto">
      <thead><tr style="background:rgba(255,255,255,.04);color:var(--muted)">
        <th style="padding:6px;text-align:left;width:48px">On</th>
        <th style="padding:6px;text-align:left;width:170px">Rule</th>
        <th style="padding:6px;text-align:left;width:28%">Bullish PS/CB condition</th>
        <th style="padding:6px;text-align:left;width:28%">Bearish CS/PB condition</th>
        <th style="padding:6px;text-align:left;width:24%">Neutral / IC condition</th>
        <th style="padding:6px;text-align:left;width:120px">Action</th>
      </tr></thead><tbody>${rows.map(r => `<tr style="border-top:1px solid var(--border);vertical-align:top">
        <td style="padding:6px;color:${Number(r.enabled)?'#22c55e':'#64748b'};font-weight:700">${Number(r.enabled)?'ON':'OFF'}</td>
        <td style="padding:6px;min-width:150px"><b>${_posAlertEscape(r.name)}</b><br><span style="color:var(--muted)">${_posAlertEscape((r.severity||'warning').toUpperCase())} · ${_posAlertEscape(r.benchmark||'SPY')}</span>${r.notes?`<br><span style="color:var(--muted)">${_posAlertEscape(r.notes)}</span>`:''}</td>
        <td style="padding:6px"><code style="display:block;white-space:pre-wrap;word-break:break-word">${_posAlertEscape(r.bull_condition||'—')}</code></td>
        <td style="padding:6px"><code style="display:block;white-space:pre-wrap;word-break:break-word">${_posAlertEscape(r.bear_condition||'—')}</code></td>
        <td style="padding:6px"><code style="display:block;white-space:pre-wrap;word-break:break-word">${_posAlertEscape(r.neutral_condition||'—')}</code></td>
        <td style="padding:6px;white-space:nowrap"><button class="btn btn-ghost btn-sm" onclick='_editPositionAlertRule(${JSON.stringify(r).replace(/'/g,"&#39;")})'>Edit</button><button class="btn btn-ghost btn-sm" style="margin-left:4px;color:#ef4444" onclick="_deletePositionAlertRule(${Number(r.id)})">Delete</button></td>
      </tr>`).join('')}</tbody></table>`;
    if (st) st.textContent = rows.length + ' custom rule' + (rows.length===1?'':'s');
    try { _posAlertInitConditionAutocomplete(); } catch {}
  } catch(e) {
    wrap.innerHTML = `<div style="color:#ef4444;font-size:11px;padding:8px">${_posAlertEscape(e.message || String(e))}</div>`;
    if (st) st.textContent = 'Error';
  }
}

async function _testPositionAlertRules(sendNow) {
  try {
    addNotif('info', 'Position alerts', sendNow ? 'Scanning and sending matched custom alerts...' : 'Testing custom position alerts...', 'Journal');
    const url = sendNow ? '/journal/position_alerts/manual_scan' : '/journal/position_alerts/test';
    const d = await api(url, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})});
    const sample = (d.reasons || []).slice(0, 3).map(r => `${r.symbol || ''} ${r.trade_type || ''} ${r.strikes || ''}: ${r.reason || ''}`.trim()).join(' · ');
    const msg = `rules ${d.rules || 0} · checked ${d.checked || 0} · matched ${d.matched || 0} · sent ${d.sent || 0} · suppressed ${d.suppressed || 0}${sample ? ' · ' + sample : ''}`;
    addNotif((d.sent||0)>0 ? 'warn' : 'info', 'Position alerts', msg, 'Journal');
  } catch(e) {
    addNotif('err', 'Position alerts', e.message || String(e), 'Journal');
  }
}

async function _loadTradeHealthAlerts() {
  const wrap = document.getElementById('trade-health-alerts-wrap');
  const st   = document.getElementById('trade-health-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    const d = await api('/journal/health_alerts_all');
    const alerts = d.alerts || [];

    if (!alerts.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No open trades.</div>';
      if (st) st.textContent = '0 trades';
      return;
    }

    const SEV_COLORS = {critical:'#dc2626', exit_candidate:'#ef4444', warning:'#f97316', watch:'#f59e0b', healthy:'#22c55e', unknown:'#64748b'};
    const SEV_ICONS  = {critical:'🔴', exit_candidate:'🟠', warning:'🟡', watch:'⚪', healthy:'✅', unknown:'❓'};
    const ACT_COLORS = {EXIT:'#ef4444', TRIM:'#a78bfa', HEDGE:'#f97316', ADD:'#3b82f6', HOLD:'#22c55e'};

    const critCount    = alerts.filter(a=>a.severity==='critical').length;
    const exitCount    = alerts.filter(a=>a.severity==='exit_candidate').length;
    const warnCount    = alerts.filter(a=>a.severity==='warning').length;
    const healthyCount = alerts.filter(a=>a.severity==='healthy').length;
    if (st) st.textContent = `${alerts.length} open · ${critCount+exitCount+warnCount} need attention · ${healthyCount} healthy`;

    const rowsHtml = alerts.map(a => {
      const sc = a.trade_health_score || 0;
      const sc_c = SEV_COLORS[a.severity] || '#64748b';
      const sevIcon = SEV_ICONS[a.severity] || '❓';
      const actKey  = (a.action||'').toUpperCase();
      const actC    = ACT_COLORS[actKey] || (a.severity==='healthy'?'#22c55e':'#64748b');

      // Score ring (small)
      const r=13, circ=2*Math.PI*r;
      const dash=(circ*sc/100).toFixed(1), gap=(circ*(1-sc/100)).toFixed(1);
      const scoreRing = `<svg width="32" height="32" viewBox="0 0 32 32">
        <circle cx="16" cy="16" r="${r}" fill="none" stroke="#1e293b" stroke-width="3"/>
        <circle cx="16" cy="16" r="${r}" fill="none" stroke="${sc_c}" stroke-width="3"
          stroke-dasharray="${dash} ${gap}" stroke-linecap="round" transform="rotate(-90 16 16)"/>
        <text x="16" y="20" text-anchor="middle" font-size="8" font-weight="800" fill="${sc_c}">${sc}</text>
      </svg>`;

      // PNR display
      let pnrHtml = '<span style="color:var(--muted);font-size:10px">—</span>';
      if (a.pnr || a.pnr_upper) {
        const pc = a.pnr_breached ? '#ef4444' : '#22c55e';
        const ptxt = [a.pnr?`$${(+a.pnr).toFixed(2)}↓`:'', a.pnr_upper?`$${(+a.pnr_upper).toFixed(2)}↑`:''].filter(Boolean).join(' / ');
        pnrHtml = `<span style="color:${pc};font-size:10px;font-weight:600">${ptxt}${a.pnr_breached?' ⚠':''}</span>`;
      }

      // P&L display
      const pnlC = (a.unrealised_pnl||0) >= 0 ? '#22c55e' : '#ef4444';
      const pnlStr = a.unrealised_pnl != null
        ? `<span style="color:${pnlC};font-weight:700;font-size:10px">${a.unrealised_pnl>=0?'+':''}$${Math.abs(a.unrealised_pnl).toFixed(0)}</span>`
        + (a.pct_of_max!=null?` <span style="color:${(+a.pct_of_max)>=50?'#22c55e':'#f59e0b'};font-size:9px">${(+a.pct_of_max).toFixed(0)}%</span>`:'')
        : '<span style="color:var(--muted);font-size:10px">—</span>';

      // Chips: regime/IV/OI
      const chips = [
        a.regime_bias ? `<span style="font-size:8px;background:#1e293b;border-radius:2px;padding:1px 4px;color:#94a3b8">${a.regime_bias}</span>` : '',
        a.iv_rank!=null ? `<span style="font-size:8px;background:#1e293b;border-radius:2px;padding:1px 4px;color:#94a3b8">IVR ${(+a.iv_rank).toFixed(0)}%</span>` : '',
        a.oi_signal&&a.oi_signal!=='NO_DATA' ? `<span style="font-size:8px;background:#1e293b;border-radius:2px;padding:1px 4px;color:#94a3b8">${a.oi_signal.replace(/_/g,' ')}</span>` : '',
      ].filter(Boolean).join(' ');

      // DTE badge
      const dteC = a.dte<=2?'#ef4444':a.dte<=7?'#f59e0b':'#64748b';

      return `<tr style="border-top:1px solid var(--border);vertical-align:middle">
        <td style="padding:7px 6px;white-space:nowrap">
          <span style="font-size:16px">${sevIcon}</span>
        </td>
        <td style="padding:7px 6px;font-weight:700;white-space:nowrap">
          <a href="#" onclick="event.preventDefault();jrnTab('open');setTimeout(()=>{const si=document.getElementById('jrn-search');if(si){si.value='${a.symbol}';_jrnFilter();}},200)"
             style="color:var(--accent);text-decoration:none">${a.symbol||'—'}</a>
        </td>
        <td style="padding:7px 6px;font-size:10px;color:var(--muted)">${a.trade_type||'—'}</td>
        <td style="padding:7px 6px;font-size:10px;color:#e2e8f0;white-space:nowrap;font-weight:700">${a.strikes||'—'}</td>
        <td style="padding:7px 6px;font-size:10px;color:${dteC};white-space:nowrap">${a.dte!=null?a.dte+'d':'—'}</td>
        <td style="padding:7px 6px">
          <div style="display:flex;align-items:center;gap:6px">
            ${scoreRing}
            <div style="display:flex;flex-direction:column;gap:1px">
              <div style="display:background:${sc_c}22;border:1px solid ${sc_c}44;color:${sc_c};font-size:9px;font-weight:600;padding:1px 5px;border-radius:3px;white-space:nowrap">${a.severity.replace(/_/g,' ').toUpperCase()}</div>
              ${a.score_drop>=10?`<span style="color:#ef4444;font-size:9px">↓${a.score_drop.toFixed(0)} pts</span>`:''}
            </div>
          </div>
        </td>
        <td style="padding:7px 6px">
          <div style="background:${actC}22;border:1px solid ${actC}66;color:${actC};font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;display:inline-block;white-space:nowrap">${actKey||'—'}</div>
        </td>
        <td style="padding:7px 6px">${pnlStr}</td>
        <td style="padding:7px 6px">${pnrHtml}</td>
        <td style="padding:7px 6px;font-size:9px;color:#94a3b8;max-width:420px;white-space:normal">${a.rec_reason||'—'}</td>
        <td style="padding:7px 6px;font-size:9px">${chips}</td>
        <td style="padding:7px 6px;white-space:nowrap">
          <button class="btn btn-ghost btn-sm" style="font-size:10px" onclick="_jrnOpenDelta(${a.id||0})">🔁</button>
          <button class="btn btn-ghost btn-sm" style="font-size:10px;margin-left:3px" onclick="_jrnFetchLive(${a.id||0})">📡</button>
        </td>
      </tr>`;
    }).join('');

    wrap.innerHTML = `
      <table style="width:100%;min-width:1600px;border-collapse:collapse;font-size:11px">
        <thead>
          <tr style="background:rgba(255,255,255,.03);font-size:10px;color:var(--muted)">
            <th style="padding:6px"></th>
            <th style="padding:6px;text-align:left">Symbol</th>
            <th style="padding:6px;text-align:left">Type</th>
            <th style="padding:6px;text-align:left">Strikes</th>
            <th style="padding:6px;text-align:left">DTE</th>
            <th style="padding:6px;text-align:left">Health Score</th>
            <th style="padding:6px;text-align:left">Action</th>
            <th style="padding:6px;text-align:left">P&amp;L</th>
            <th style="padding:6px;text-align:left">PNR</th>
            <th style="padding:6px;text-align:left">Reason</th>
            <th style="padding:6px;text-align:left">Signals</th>
            <th style="padding:6px;text-align:left">Tools</th>
          </tr>
        </thead>
        <tbody>${rowsHtml}</tbody>
      </table>`;
  } catch(e) {
    if (wrap) wrap.innerHTML = `<div style="color:#ef4444;font-size:12px;padding:16px">${e.message}</div>`;
    if (st) st.textContent = 'Error';
  }
}




// ── Quick Alert modal: create alert without leaving current tab ─────────────
let _quickAlertAutocompleteItems = [];
let _quickAlertAutocompleteIndex = -1;
let _quickAlertAutocompleteWired = false;
let _quickAlertLastFocus = null;

function _quickAlertStatus(msg, cls='') {
  const st = document.getElementById('quick-alert-status');
  if (!st) return;
  st.textContent = msg || '';
  st.className = cls || '';
}

function _quickAlertModal() { return document.getElementById('quick-alert-modal'); }
function _quickAlertTextArea() { return document.getElementById('quick-alert-condition'); }

function _quickAlertCurrentSymbol() {
  const candidates = [
    document.getElementById('symbol-input')?.value,
    document.getElementById('agg-symbol')?.value,
    document.getElementById('jrn-add-symbol')?.value,
    currentSymbol,
  ];
  for (const v of candidates) {
    const s = String(v || '').trim().toUpperCase();
    if (s) return s;
  }
  return 'SPY';
}

function _quickAlertUpdateVisibility() {
  const kind = (document.getElementById('quick-alert-kind')?.value || 'price').toLowerCase();
  const priceRow = document.getElementById('quick-alert-price-row');
  const exprRow = document.getElementById('quick-alert-expr-row');
  if (priceRow) priceRow.style.display = kind === 'price' ? 'grid' : 'none';
  if (exprRow) exprRow.style.display = kind === 'price' ? 'none' : 'block';
  _quickAlertUpdateFunctionHelp();
}

function _resetQuickAlertForm(clearSymbol=false) {
  ['quick-alert-id','quick-alert-price-value','quick-alert-condition','quick-alert-notes'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  const wl = document.getElementById('quick-alert-watchlist'); if (wl) wl.value = '';
  const sym = document.getElementById('quick-alert-symbol'); if (sym) sym.value = clearSymbol ? '' : _quickAlertCurrentSymbol();
  const kind = document.getElementById('quick-alert-kind'); if (kind) kind.value = 'price';
  const mode = document.getElementById('quick-alert-trigger-mode'); if (mode) mode.value = 'daily';
  const tf = document.getElementById('quick-alert-timeframe'); if (tf) tf.value = '1d';
  const op = document.getElementById('quick-alert-price-op'); if (op) op.value = '>=';
  const en = document.getElementById('quick-alert-enabled'); if (en) en.checked = true;
  _quickAlertUpdateVisibility();
  _quickAlertStatus('');
}

async function _quickAlertLoadPicklists() {
  const wlSel = document.getElementById('quick-alert-watchlist');
  const watchlistId = wlSel && wlSel.value ? wlSel.value : '';
  try {
    const d = await api(`/watchlists/alerts/picklists${watchlistId ? `?watchlist_id=${encodeURIComponent(watchlistId)}` : ''}`);
    _alertsPicklists = {watchlists: d.watchlists || [], symbols: d.symbols || []};
    if (wlSel) {
      const current = wlSel.value;
      wlSel.innerHTML = '<option value="">No watchlist / symbol only</option>' + _alertsPicklists.watchlists.map(w => `<option value="${w.id}">${_alertHtmlEscape(w.name || '—')}</option>`).join('');
      if (current) wlSel.value = current;
    }
    const list = document.getElementById('quick-alert-symbol-list');
    if (list) list.innerHTML = (_alertsPicklists.symbols || []).map(s => `<option value="${_alertHtmlEscape(String(s).toUpperCase())}"></option>`).join('');
    const sym = document.getElementById('quick-alert-symbol');
    if (sym && !sym.dataset.ucReady) { uc(sym); sym.dataset.ucReady = '1'; }
    _quickAlertStatus(`${(_alertsPicklists.watchlists || []).length} watchlists · ${(_alertsPicklists.symbols || []).length} symbols`);
  } catch (e) {
    _quickAlertStatus('Could not load alert picklists', 'err');
  }
}

async function _openQuickAlertModal(preset={}) {
  const modal = _quickAlertModal();
  if (!modal) return;
  _quickAlertLastFocus = document.activeElement;
  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.classList.add('modal-open');
  _resetQuickAlertForm(false);
  const sym = document.getElementById('quick-alert-symbol');
  if (sym) sym.value = String(preset.symbol || _quickAlertCurrentSymbol() || '').toUpperCase();
  if (preset.kind) {
    const kind = document.getElementById('quick-alert-kind');
    if (kind) kind.value = preset.kind;
  }
  if (preset.price != null) {
    const p = document.getElementById('quick-alert-price-value');
    if (p) p.value = preset.price;
  }
  _quickAlertUpdateVisibility();
  await Promise.allSettled([_quickAlertLoadPicklists(), _alertLoadScannerCatalog()]);
  _quickAlertInitAutocomplete();
  setTimeout(() => {
    const el = document.getElementById('quick-alert-symbol') || document.getElementById('quick-alert-price-value');
    el?.focus?.();
    el?.select?.();
  }, 30);
}

function _closeQuickAlertModal() {
  const modal = _quickAlertModal();
  if (!modal) return;
  modal.classList.remove('open');
  modal.setAttribute('aria-hidden', 'true');
  document.body.classList.remove('modal-open');
  const panel = document.getElementById('quick-alert-autocomplete');
  if (panel) panel.style.display = 'none';
  try { _quickAlertLastFocus?.focus?.(); } catch {}
}

function _quickAlertReplaceFragment(text, statusMessage, cursorOffset=null) {
  const ta = _quickAlertTextArea();
  if (!ta) return;
  const range = _alertCurrentAutocompleteRange(ta);
  ta.value = ta.value.slice(0, range.start) + text + ta.value.slice(range.end);
  const pos = range.start + (cursorOffset == null ? text.length : cursorOffset);
  ta.setSelectionRange(pos, pos);
  ta.focus();
  _quickAlertStatus(statusMessage || 'Inserted');
  _quickAlertShowAutocomplete();
  _quickAlertUpdateFunctionHelp();
}

function _quickAlertInsertScannerCall(name) {
  _quickAlertReplaceFragment(`scan(${name})`, `Inserted scan(${name})`);
}
function _quickAlertInsertFunctionCall(name) {
  const call = `${name}()`;
  _quickAlertReplaceFragment(call, `Inserted ${call}`, name.length + 1);
}

function _quickAlertRenderAutocompleteSelection() {
  const panel = document.getElementById('quick-alert-autocomplete');
  if (!panel) return;
  panel.querySelectorAll('.scanner-autocomplete-item').forEach(el => {
    el.classList.toggle('selected', Number(el.dataset.idx || -1) === _quickAlertAutocompleteIndex);
  });
}
function _quickAlertChooseAutocomplete(delta=0) {
  if (!_quickAlertAutocompleteItems.length) return false;
  _quickAlertAutocompleteIndex = Math.max(0, Math.min(_quickAlertAutocompleteItems.length - 1, _quickAlertAutocompleteIndex + delta));
  _quickAlertRenderAutocompleteSelection();
  return true;
}
function _quickAlertCommitAutocomplete() {
  if (!_quickAlertAutocompleteItems.length) return false;
  const item = _quickAlertAutocompleteItems[Math.max(0, _quickAlertAutocompleteIndex)] || _quickAlertAutocompleteItems[0];
  if (!item) return false;
  if (item.kind === 'function') _quickAlertInsertFunctionCall(item.name);
  else _quickAlertReplaceFragment(_alertScannerSnippet(item), 'Inserted scanner code block');
  const panel = document.getElementById('quick-alert-autocomplete');
  if (panel) panel.style.display = 'none';
  return true;
}

function _quickAlertShowAutocomplete(forceAll=false) {
  const ta = _quickAlertTextArea();
  const panel = document.getElementById('quick-alert-autocomplete');
  if (!ta || !panel) return;
  const token = _alertCurrentTokenBeforeCursor(ta.value, ta.selectionStart ?? ta.value.length);
  const mode = token.mode;
  const typed = token.typed || '';
  if (mode !== 'scan' && mode !== 'function' && !forceAll) {
    panel.style.display = 'none';
    panel.innerHTML = '';
    _quickAlertAutocompleteItems = [];
    _quickAlertAutocompleteIndex = -1;
    _quickAlertUpdateFunctionHelp();
    return;
  }
  let entries = [];
  if (forceAll) {
    const scanners = _alertAllScannerEntries().filter(x => !typed || String(x.name || '').toLowerCase().includes(typed)).slice(0, 12).map(x => ({...x, kind:'scanner'}));
    const fns = _alertAllFunctionEntries().filter(x => !typed || String(x.name || '').toLowerCase().startsWith(typed)).slice(0, 20).map(x => ({...x, kind:'function'}));
    entries = scanners.concat(fns);
  } else if (mode === 'scan') {
    entries = _alertAllScannerEntries().filter(x => !typed || String(x.name || '').toLowerCase().includes(typed)).slice(0, 20).map(x => ({...x, kind:'scanner'}));
  } else if (mode === 'function') {
    entries = _alertAllFunctionEntries().filter(x => !typed || String(x.name || '').toLowerCase().startsWith(typed)).slice(0, 24).map(x => ({...x, kind:'function'}));
  }
  if (!entries.length) {
    panel.style.display = 'none';
    panel.innerHTML = '';
    _quickAlertAutocompleteItems = [];
    _quickAlertAutocompleteIndex = -1;
    _quickAlertUpdateFunctionHelp();
    return;
  }
  _quickAlertAutocompleteItems = entries;
  _quickAlertAutocompleteIndex = 0;
  panel.innerHTML = entries.map((x, idx) => {
    if (x.kind === 'function') {
      return `<div class="scanner-autocomplete-item ${idx === _quickAlertAutocompleteIndex ? 'selected' : ''}" data-idx="${idx}">
        <div style="min-width:0"><b>${_alertHtmlEscape(x.name)}</b> <span style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.signature || '')}</span><div style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.description || 'Primitive')}</div></div>
        <button type="button" class="btn btn-ghost btn-sm" data-action="insert-fn" data-name="${_alertHtmlEscape(x.name)}">fn()</button>
      </div>`;
    }
    return `<div class="scanner-autocomplete-item ${idx === _quickAlertAutocompleteIndex ? 'selected' : ''}" data-idx="${idx}">
      <div style="min-width:0"><b>${_alertHtmlEscape(x.name)}</b><div style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.category || 'Scanner')}</div><pre class="scanner-code">${_alertHtmlEscape(_alertScannerSnippet(x))}</pre></div>
      <div style="display:flex;gap:6px;flex-shrink:0"><button type="button" class="btn btn-ghost btn-sm" data-action="code" data-name="${_alertHtmlEscape(x.name)}">code</button><button type="button" class="btn btn-ghost btn-sm" data-action="ref" data-name="${_alertHtmlEscape(x.name)}">scan()</button></div>
    </div>`;
  }).join('');
  panel.style.display = 'block';
  panel.querySelectorAll('.scanner-autocomplete-item').forEach(el => {
    el.addEventListener('mouseenter', () => {
      _quickAlertAutocompleteIndex = Number(el.dataset.idx || 0);
      _quickAlertRenderAutocompleteSelection();
    });
    el.addEventListener('mousedown', e => {
      if (e.target.closest('button')) return;
      e.preventDefault();
      const item = _quickAlertAutocompleteItems[Number(el.dataset.idx || 0)];
      if (!item) return;
      if (item.kind === 'function') _quickAlertInsertFunctionCall(item.name);
      else _quickAlertReplaceFragment(_alertScannerSnippet(item), 'Inserted scanner code block');
      panel.style.display = 'none';
    });
  });
  panel.querySelectorAll('button[data-action]').forEach(btn => btn.addEventListener('mousedown', e => {
    e.preventDefault();
    const item = _quickAlertAutocompleteItems.find(x => String(x.name) === String(btn.dataset.name));
    if (!item) return;
    if (item.kind === 'function' || btn.dataset.action === 'insert-fn') _quickAlertInsertFunctionCall(item.name);
    else if (btn.dataset.action === 'ref') _quickAlertInsertScannerCall(item.name);
    else _quickAlertReplaceFragment(_alertScannerSnippet(item), 'Inserted scanner code block');
    panel.style.display = 'none';
  }));
  _quickAlertUpdateFunctionHelp();
}

function _quickAlertUpdateFunctionHelp() {
  const hint = document.getElementById('quick-alert-func-hint');
  const ta = _quickAlertTextArea();
  if (!hint || !ta) return;
  const text = ta.value || '';
  const cursor = ta.selectionStart ?? text.length;
  const active = _alertFindActiveFunction(text, cursor);
  let meta = null;
  let paramIndex = 0;
  if (active) {
    paramIndex = active.paramIndex;
    meta = _alertAllFunctionEntries().find(x => String(x.name || '').toLowerCase() === String(active.name || '').toLowerCase());
  } else {
    const tok = _alertCurrentTokenBeforeCursor(text, cursor);
    if (tok.mode === 'function' && tok.typed) {
      meta = _alertAllFunctionEntries().find(x => String(x.name || '').toLowerCase().startsWith(tok.typed));
    }
  }
  if (!meta) {
    hint.innerHTML = 'Type a primitive name, choose one from autocomplete, or place your cursor inside a function to see parameter help.';
    return;
  }
  const params = _alertSignatureParams(meta.signature);
  const current = params.length ? params[Math.min(paramIndex, params.length - 1)] : 'value';
  const paramHtml = params.length ? `<div>${params.map((p, i) => `<span class="param ${active && i === Math.min(paramIndex, params.length - 1) ? 'active' : ''}">${i + 1}. ${_alertHtmlEscape(p)}</span>`).join('')}</div>` : '';
  hint.innerHTML = `<b>${_alertHtmlEscape(meta.name)}</b> <span class="dim">${_alertHtmlEscape(meta.signature || '')}</span><br><span>${_alertHtmlEscape(meta.description || '')}</span>${active ? `<br><span class="warn">Current parameter: ${_alertHtmlEscape(current)}</span>` : ''}${paramHtml}`;
}

function _quickAlertInitAutocomplete() {
  const ta = _quickAlertTextArea();
  if (!ta) return;
  if (!_quickAlertAutocompleteWired) {
    _quickAlertAutocompleteWired = true;
    ta.addEventListener('input', () => { _quickAlertShowAutocomplete(); _quickAlertUpdateFunctionHelp(); });
    ta.addEventListener('keyup', () => { _quickAlertShowAutocomplete(); _quickAlertUpdateFunctionHelp(); });
    ta.addEventListener('click', () => { _quickAlertShowAutocomplete(); _quickAlertUpdateFunctionHelp(); });
    ta.addEventListener('keydown', e => {
      const panel = document.getElementById('quick-alert-autocomplete');
      const visible = panel && panel.style.display === 'block';
      if (e.shiftKey && e.key === 'Enter') {
        e.preventDefault();
        _quickAlertOpenConditionAutocomplete();
        return;
      }
      if (visible && e.key === 'ArrowDown') { e.preventDefault(); _quickAlertChooseAutocomplete(1); return; }
      if (visible && e.key === 'ArrowUp') { e.preventDefault(); _quickAlertChooseAutocomplete(-1); return; }
      if (visible && e.key === 'Enter') { e.preventDefault(); _quickAlertCommitAutocomplete(); return; }
      if (visible && e.key === 'Escape') { e.preventDefault(); panel.style.display = 'none'; return; }
    });
    ta.addEventListener('blur', () => setTimeout(() => {
      const panel = document.getElementById('quick-alert-autocomplete');
      if (panel) panel.style.display = 'none';
      _quickAlertUpdateFunctionHelp();
    }, 160));
    const wl = document.getElementById('quick-alert-watchlist');
    if (wl && !wl.dataset.quickAlertWired) {
      wl.dataset.quickAlertWired = '1';
      wl.addEventListener('change', _quickAlertLoadPicklists);
    }
  }
  _quickAlertUpdateFunctionHelp();
}

function _quickAlertOpenConditionAutocomplete() {
  const ta = _quickAlertTextArea();
  if (!ta) return;
  _alertLoadScannerCatalog().then(() => {
    ta.focus();
    _quickAlertShowAutocomplete(true);
    _quickAlertUpdateFunctionHelp();
  });
}

async function _saveQuickAlertRule() {
  const kind = (document.getElementById('quick-alert-kind')?.value || 'price').toLowerCase();
  const payload = {
    watchlist_id: document.getElementById('quick-alert-watchlist')?.value || '',
    symbol: document.getElementById('quick-alert-symbol')?.value?.trim().toUpperCase() || '',
    alert_kind: kind,
    trigger_mode: document.getElementById('quick-alert-trigger-mode')?.value || 'daily',
    timeframe: document.getElementById('quick-alert-timeframe')?.value?.trim() || '1d',
    enabled: !!document.getElementById('quick-alert-enabled')?.checked,
    price_operator: document.getElementById('quick-alert-price-op')?.value || '>=',
    price_value: document.getElementById('quick-alert-price-value')?.value || '',
    condition_text: document.getElementById('quick-alert-condition')?.value || '',
    notes: document.getElementById('quick-alert-notes')?.value || '',
  };
  if (!payload.watchlist_id) delete payload.watchlist_id;
  if (!payload.symbol) delete payload.symbol;
  if (!payload.watchlist_id && !payload.symbol) {
    _quickAlertStatus('Select a watchlist or enter a symbol.', 'err');
    addNotif('err', 'Missing alert target', 'Select a watchlist or enter a symbol', 'Alerts');
    return;
  }
  if (kind === 'price' && !payload.price_value) {
    _quickAlertStatus('Set a price threshold.', 'err');
    addNotif('err', 'Missing price', 'Set a price threshold for the quick alert', 'Alerts');
    return;
  }
  if (kind !== 'price' && !String(payload.condition_text || '').trim()) {
    _quickAlertStatus('Enter a primitive/combo condition.', 'err');
    addNotif('err', 'Missing condition', 'Enter a primitive/combo expression', 'Alerts');
    return;
  }
  try {
    _quickAlertStatus('Saving…');
    const d = await api('/watchlists/alerts/rules', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    if (!d || d.error) throw new Error(d && d.error ? d.error : 'Failed to save alert');
    const wlName = payload.watchlist_id ? ((_alertsPicklists.watchlists || []).find(w => String(w.id) === String(payload.watchlist_id)) || {}).name || `Watchlist ${payload.watchlist_id}` : '';
    const target = payload.symbol || wlName || 'Alert target';
    _quickAlertStatus('Saved', 'ok');
    addNotif('ok', 'Quick alert saved', target, 'Alerts');
    try { await _loadAlertRulesHub(); } catch {}
    _closeQuickAlertModal();
    _resetQuickAlertForm(false);
  } catch (e) {
    _quickAlertStatus(e.message || String(e), 'err');
    addNotif('err', 'Quick alert failed', e.message || String(e), 'Alerts');
  }
}

async function _loadTradePnrAlerts() {
  var wrap = document.getElementById('pnr-alerts-wrap');
  var st = document.getElementById('pnr-alerts-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    var d = await api('/journal/trade-alerts?status=open');
    var rows = d.alerts || [];
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No open option trades.</div>';
      if (st) st.textContent = '0 alerts';
      return;
    }
    wrap.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="background:rgba(255,255,255,.05)"><th style="padding:8px;text-align:left">Symbol</th><th style="padding:8px;text-align:left">Type</th><th style="padding:8px;text-align:left">Spot</th><th style="padding:8px;text-align:left">PNR</th><th style="padding:8px;text-align:left">Status</th><th style="padding:8px;text-align:left">Mode</th><th style="padding:8px;text-align:left">Last trigger</th><th style="padding:8px;text-align:left">Action</th></tr></thead><tbody>' + rows.map(function(r) {
      return '<tr style="border-top:1px solid var(--border)"><td style="padding:8px;font-weight:700">'+(r.symbol || '—')+'</td><td style="padding:8px">'+(r.trade_type || '—')+'</td><td style="padding:8px">'+fmt(r.spot, 2)+'</td><td style="padding:8px">'+fmt(r.pnr, 2)+(r.pnr_upper ? ' / '+fmt(r.pnr_upper, 2) : '')+'</td><td style="padding:8px;color:'+(r.pnr_breached ? '#ef4444' : '#22c55e')+'">'+(r.pnr_status || (r.pnr_breached ? 'Breached' : 'Safe'))+'</td><td style="padding:8px;color:'+(r.pnr_alert_enabled ? '#22c55e' : '#94a3b8')+';font-weight:700">'+(r.pnr_alert_enabled ? 'Enabled' : 'Disabled')+'</td><td style="padding:8px;color:var(--muted)">'+(r.pnr_alert_last_sent_at || '—')+'</td><td style="padding:8px;color:#22c55e;font-weight:700"><button class="btn btn-ghost btn-sm" onclick="_testTradePnrAlert('+(r.id)+')">Test now</button></td></tr>';
    }).join('') + '</tbody></table>';
    if (st) st.textContent = rows.length + ' open trades';
  } catch (e) {
    wrap.innerHTML = '<div style="color:#ef4444;font-size:12px;padding:16px">' + e.message + '</div>';
    if (st) st.textContent = 'Error';
  }
}

async function _testTradePnrAlert(id) {
  try {
    const d = await api(`/journal/trade/${id}/pnr_alert/test`, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})});
    const tg = d.telegram || {};
    const msg = `${d.status || 'safe'} · ${d.message || ''}${tg.sent ? ` · Telegram sent (${tg.sent})` : (tg.error ? ` · Telegram: ${tg.error}` : '')}`;
    addNotif(d.pnr_breached ? 'warn' : 'info', 'PNR test', msg, 'Journal');
  } catch (e) {
    addNotif('err', 'PNR test failed', e.message || String(e), 'Journal');
  }
}

async function _loadAiTradeAlerts() {
  const wrap = document.getElementById('ai-trade-alerts-wrap');
  const st = document.getElementById('ai-trade-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    const d = await api('/journal/ai_alerts_all');
    const rows = d.alerts || [];
    if (!d.enabled) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">AI alerts are disabled in settings.</div>';
      if (st) st.textContent = 'disabled';
      return;
    }
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No open trades for AI review.</div>';
      if (st) st.textContent = '0 alerts';
      return;
    }
    wrap.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:11px">
      <thead><tr style="background:rgba(255,255,255,.05)">
        <th style="padding:8px;text-align:left">Symbol</th>
        <th style="padding:8px;text-align:left">Type</th>
        <th style="padding:8px;text-align:left">Strikes</th>
        <th style="padding:8px;text-align:left">Score</th>
        <th style="padding:8px;text-align:left">Rec</th>
        <th style="padding:8px;text-align:left">Roll plan</th>
        <th style="padding:8px;text-align:left">Headline</th>
        <th style="padding:8px;text-align:left">Next steps</th>
        <th style="padding:8px;text-align:left">Price alerts</th>
      </tr></thead>
      <tbody>${rows.map(function(r) {
        const sevC = r.severity === 'critical' ? '#dc2626' : r.severity === 'high' ? '#f97316' : r.severity === 'warning' ? '#f59e0b' : '#22c55e';
        const alerts = (r.critical_price_alerts || []).slice(0,2).map(a => `${a.label || 'Level'} ${a.level != null ? '@ $'+Number(a.level).toFixed(2) : ''}`).join(' · ');
        const steps = (r.watch_items || r.next_actions || []).slice(0,2).join(' · ');
        const plan = r.action_mode && /ROLL|EXIT|TRIM|WATCH/i.test(r.action_mode)
          ? `${r.action_mode}${r.roll_side ? ' / ' + r.roll_side : ''}${r.roll_expiry ? ' → ' + r.roll_expiry : ''}${r.roll_strategy ? ' · ' + r.roll_strategy : ''}`
          : (r.action_text || r.explicit_action || '—');
        const headline = r.action_text || r.decision_phrase || r.headline || r.summary || '';
        const recText = r.action_mode || r.recommendation || 'HOLD';
        return `<tr style="border-top:1px solid var(--border)">
          <td style="padding:8px;font-weight:700;color:var(--accent)">${_posAlertEscape(r.symbol || '—')}</td>
          <td style="padding:8px">${_posAlertEscape(r.trade_type || '—')}</td>
          <td style="padding:8px;color:var(--muted)">${_posAlertEscape(r.strike_summary || '—')}</td>
          <td style="padding:8px;font-weight:800;color:${sevC}">${r.score != null ? Number(r.score).toFixed(0) : '—'}${r.confidence != null ? ` <span style="color:var(--muted);font-weight:500">(${Number(r.confidence).toFixed(1)}%)</span>` : ''}</td>
          <td style="padding:8px;font-weight:700;color:${sevC}">${_posAlertEscape(recText)}</td>
          <td style="padding:8px;color:#cbd5e1">${_posAlertEscape(plan)}</td>
          <td style="padding:8px;color:var(--text)">${_posAlertEscape(headline)}</td>
          <td style="padding:8px;color:var(--muted)">${_posAlertEscape(steps || '—')}</td>
          <td style="padding:8px;color:var(--muted)">${_posAlertEscape(alerts || '—')}</td>
        </tr>`;
      }).join('')}</tbody></table>`;
    if (st) st.textContent = rows.length + ' trades';
  } catch (e) {
    wrap.innerHTML = '<div style="color:#ef4444;font-size:12px;padding:16px">' + e.message + '</div>';
    if (st) st.textContent = 'Error';
  }
}

async function _sendAiTradeAlerts() {
  try {
    addNotif('info', 'AI Alerts', 'Scanning open trades and sending AI alerts…', 'Journal');
    const d = await api('/journal/ai_alert/manual_scan', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})});
    addNotif(d.sent > 0 ? 'warn' : 'info', 'AI Alerts', `Sent ${d.sent || 0} alert${(d.sent||0)===1?'':'s'} · suppressed ${(d.suppressed||0)} · skipped ${(d.skipped||0)}`, 'Journal');
    await _loadAiTradeAlerts();
  } catch (e) {
    addNotif('err', 'AI Alerts', e.message || String(e), 'Journal');
  }
}

async function _loadScannerAlertsHub() {
  var wrap = document.getElementById('scanner-alerts-wrap');
  var st = document.getElementById('scanner-alerts-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    var d = await api('/scanner-builder/api/definitions');
    var rows = (d.definitions || []).filter(function(s) { return Number(s.alert_enabled || 0) === 1; });
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No scanner alerts enabled.</div>';
      if (st) st.textContent = '0 alerts';
      return;
    }
    wrap.innerHTML = `
      <table style="width:100%;border-collapse:collapse;font-size:12px">
        <thead><tr style="background:rgba(255,255,255,.05)">
          <th style="padding:8px;text-align:left">Scanner</th>
          <th style="padding:8px;text-align:left">Mode</th>
          <th style="padding:8px;text-align:left">Last Run</th>
          <th style="padding:8px;text-align:left">Matches</th>
          <th style="padding:8px;text-align:left">Mode</th>
          <th style="padding:8px;text-align:left">Action</th>
        </tr></thead>
        <tbody>
          ${rows.map(function(r) {
            return `<tr style="border-top:1px solid var(--border)">
              <td style="padding:8px;font-weight:700">${r.name || '—'}</td>
              <td style="padding:8px">${r.alert_mode || 'enter_exit'}</td>
              <td style="padding:8px;color:var(--muted)">${r.last_run_at || '—'}</td>
              <td style="padding:8px">${r.last_run_count ?? 0}</td>
              <td style="padding:8px"><input type="checkbox" id="scan-en-${r.id}" ${r.alert_enabled ? 'checked' : ''}/></td>
              <td style="padding:8px">
                <button class="btn btn-ghost btn-sm" onclick="_saveScannerAlert(${r.id})">Save</button>
                <button class="btn btn-ghost btn-sm" onclick="_openScannerBuilderForAlert(${JSON.stringify(String(r.name || ''))})">Edit</button>
              </td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>`;
    if (st) st.textContent = rows.length + ' scanners';
  } catch (e) {
    wrap.innerHTML = '<div style="color:#ef4444;font-size:12px;padding:16px">' + e.message + '</div>';
    if (st) st.textContent = 'Error';
  }
}

async function _loadAlertHistoryHub() {
  var wrap = document.getElementById('alert-history-wrap');
  var st = document.getElementById('alert-history-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    var d = await api('/watchlists/alerts/history?limit=30');
    var rows = d.alerts || [];
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No alert history yet.</div>';
      if (st) st.textContent = '0 history';
      return;
    }
    wrap.innerHTML = rows.map(function(r) {
      var c = r.severity === 'warn' ? '#f59e0b' : (r.severity === 'error' ? '#ef4444' : '#818cf8');
      return '<div style="padding:8px 10px;border-top:1px solid var(--border)"><div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start"><div style="min-width:0"><div style="font-size:12px;font-weight:700;color:'+c+'">'+(r.alert_type || 'ALERT')+' · '+(r.title || '')+'</div><div style="font-size:11px;color:var(--muted);white-space:pre-wrap">'+(r.detail || '')+'</div></div><div style="font-size:10px;color:var(--muted);white-space:nowrap">'+(r.created_at || '')+'</div></div></div>';
    }).join('');
    if (st) st.textContent = rows.length + ' recent';
  } catch (e) {
    wrap.innerHTML = '<div style="color:#ef4444;font-size:12px;padding:16px">' + e.message + '</div>';
    if (st) st.textContent = 'Error';
  }
}

async function _saveTradePnrAlert(tid) {
  var el = document.getElementById('pnr-en-' + tid);
  var enabled = !!(el && el.checked);
  await api('/journal/trade/' + tid + '/pnr_alert', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({enabled: enabled})
  });
  addNotif('ok', 'PNR alert saved', enabled ? 'Enabled' : 'Disabled', 'Alerts');
}

async function _saveScannerAlert(defId) {
  var enabledEl = document.getElementById('scan-en-' + defId);
  var payload = { alert_enabled: !!(enabledEl && enabledEl.checked) };
  var d = await api('/scanner-builder/api/definitions/' + defId, {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  });
  addNotif('ok', 'Scanner alert saved', ((d.definition && d.definition.name) || defId) + ' -> ' + (payload.alert_enabled ? 'enabled' : 'disabled'), 'Scanner Builder');
  await _loadScannerAlertsHub();
}

function _jumpToWatchlistAlert(wlId, symbol) {
  _setActiveTab('watchlists');
  setTimeout(async function() {
    try { await _wlLoadSymbolsPanel(wlId, 'Watchlist'); } catch {}
    var panel = document.getElementById('wl-symbol-panel');
    if (panel) panel.scrollIntoView({behavior:'smooth', block:'start'});
    if (symbol) {
      var input = document.querySelector(`#wl-ap-${wlId}-${CSS.escape(symbol)}`);
      if (input && input.focus) input.focus();
    }
  }, 150);
}

async function _openScannerBuilderForAlert(name) {
  _setActiveTab('scanner-builder');
  setTimeout(function() {
    var rows = Array.from(document.querySelectorAll('#savedBody [data-load]'));
    var row = rows.find(function(btn) { return (btn.parentElement && btn.parentElement.parentElement && btn.parentElement.parentElement.innerText || '').indexOf(name) >= 0; });
    if (row) row.click();
  }, 250);
}

function _openAlertsHub() {
  _setActiveTab('alerts');
  setTimeout(function() {
    var el = document.getElementById('alerts-builder-card');
    if (el && 'open' in el) el.open = true;
    if (el) el.scrollIntoView({behavior:'smooth', block:'start'});
    _loadAlertsHub();
  }, 120);
}

// Close panel on outside click
document.addEventListener('click', function(e) {
  var panel = document.getElementById('notif-panel');
  var bell  = document.getElementById('notif-bell');
  if (panel && panel.style.display==='flex' && !panel.contains(e.target) && !bell.contains(e.target))
    panel.style.display = 'none';
});


// ════════════════════════════════════════════════════════════════════════════
// UNIVERSAL SCAN CACHE UI  — showCachedScan(cfg) handles load + fresh-scan
// for every major scan tab so they all behave identically.
// cfg = { statusId, resultId, cacheUrl, scanFn, renderFn, label }
// ════════════════════════════════════════════════════════════════════════════

function _fmtTs(ts) {
  if (!ts) return '';
  // If it's already a datetime string, just return it
  return ts;
}

async function _loadFromCache(cfg) {
  const st  = document.getElementById(cfg.statusId);
  const res = document.getElementById(cfg.resultId);
  if (st) st.innerHTML = '⏳ Loading saved results…';
  try {
    const d = await api(cfg.cacheUrl);
    const items = d.results || d.bulls && [...(d.bulls||[]),...(d.bears||[])] || [];
    if (!items.length && !(d.bulls?.length) && !(d.bears?.length)) {
      if (st) st.innerHTML = _scanStatusBar(cfg.label, null, 0, cfg.statusId);
      if (res) res.innerHTML = '';
      return;
    }
    const ts   = d.date || d.completed_at || '';
    const cnt  = d.count || items.length || (d.bull_count||0)+(d.bear_count||0);
    if (st) st.innerHTML = _scanStatusBar(cfg.label, ts, cnt, cfg.statusId);
    if (res) cfg.renderFn(res, d);
  } catch(e) {
    addNotif('error', 'Load failed: '+cfg.label, e.message, cfg.label);
    if (st) st.innerHTML = `<span style="color:#ef4444">❌ ${e.message}</span>`;
  }
}

function _scanStatusBar(label, ts, cnt, statusId) {
  const tsStr  = ts ? `<span style="color:var(--muted)">Last run: ${ts}</span>` : '<span style="color:#f59e0b">Never run</span>';
  const cntStr = cnt ? `<span style="color:#22c55e;font-weight:700">${cnt} results</span>` : '';
  const loadBtn  = `<button onclick="_loadFromCache(_scanCfgs['${statusId}'])" style="font-size:10px;padding:2px 9px;border-radius:4px;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:#22c55e;cursor:pointer">📥 Load Saved</button>`;
  const freshBtn = `<button onclick="_freshScan('${statusId}')" style="font-size:10px;padding:2px 9px;border-radius:4px;background:rgba(99,102,241,.15);border:1px solid rgba(99,102,241,.3);color:#818cf8;cursor:pointer">🔄 Run Fresh Scan</button>`;
  return `<span style="font-size:11px;display:flex;align-items:center;gap:6px;flex-wrap:wrap">${tsStr}${cntStr?'  ·  '+cntStr:''}${ts?loadBtn:''}${freshBtn}</span>`;
}

// Map statusId → scan config (populated below)
var _scanCfgs = {};

async function _freshScan(statusId) {
  const cfg = _scanCfgs[statusId];
  if (!cfg) return;
  const st   = document.getElementById(statusId);
  const res  = document.getElementById(cfg.resultId);
  const _t0  = Date.now();
  var _ftimer = null;
  if (st) {
    _ftimer = setInterval(function(){
      const sec = Math.round((Date.now()-_t0)/1000);
      if(st) st.innerHTML = `<span style="color:#f59e0b">⏳ Scanning ${cfg.label}… ${sec}s elapsed</span>`;
    }, 1000);
  }
  if (res) res.innerHTML = '';
  try {
    const d = await cfg.scanFn();
    clearInterval(_ftimer);
    const elapsed = ((Date.now()-_t0)/1000).toFixed(1);
    if (d.error) {
      addNotif('error', cfg.label+' scan failed', d.error+(d.trace?'\n'+d.trace:''), cfg.label);
      if(st) st.innerHTML = `<span style="color:#ef4444">❌ ${d.error}</span>`;
      return;
    }
    const cnt = d.count || (d.results||[]).length || (d.bull_count||0)+(d.bear_count||0);
    const ts  = d.completed_at || new Date().toLocaleString();
    if (st) st.innerHTML = _scanStatusBar(cfg.label, ts, cnt, statusId);
    if (res) cfg.renderFn(res, d);
    // Notification with elapsed time
    addNotif('ok', `✅ ${cfg.label} scan complete`,
      `${cnt} results · completed ${ts} · took ${elapsed}s`, cfg.label);
    _updateMetaBar();
  } catch(e) {
    clearInterval(_ftimer);
    addNotif('error', cfg.label+' scan error', e.message, cfg.label);
    if(st) st.innerHTML = `<span style="color:#ef4444">❌ ${e.message}</span>`;
  }
}

// ── Wire up scan configs for each tab ───────────────────────────────────────
function _initScanCaches() {

  // ── OI Buildup ──────────────────────────────────────────────────────────
  _scanCfgs['oib-status'] = {
    label: 'OI Buildup', statusId: 'oib-status', resultId: 'oib-table',
    cacheUrl: '/api/oi_buildup_cached',
    renderFn: function(el, d) { _oibData = d.results||[]; _oibLastScan = d.date; _oibFilterVal = 'ALL'; _oibRender(); },
    scanFn: async function() {
      const st = parseInt(document.getElementById('oib-st-days')?.value||3);
      const mt = parseInt(document.getElementById('oib-mt-days')?.value||10);
      const lt = parseInt(document.getElementById('oib-lt-days')?.value||30);
      const wlId = document.getElementById('oib-watchlist')?.value || '';
      const wlQ = wlId ? `&watchlist_id=${wlId}` : '';
      return await api(`/api/oi_buildup_screener?st=${st}&mt=${mt}&lt=${lt}${wlQ}`);
    }
  };

  // ── Pre Earnings ────────────────────────────────────────────────────────
  _scanCfgs['pre-earn-status'] = {
    label: 'Pre-Earnings', statusId: 'pre-earn-status', resultId: 'pre-earn-result',
    cacheUrl: '/api/pre_earnings_cache',
    renderFn: function(el, d) { el.innerHTML = _renderPreEarningsTable(d.results||[]); },
    scanFn: async function() {
      const days = document.getElementById('pre-earn-days')?.value || 30;
      const wlId = document.getElementById('earn-watchlist')?.value || '';
      return await api(`/earnings/pre_earnings_scan?days=${days}${wlId ? '&watchlist_id='+wlId : ''}`);
    }
  };

  // ── Post Earnings ───────────────────────────────────────────────────────
  _scanCfgs['post-earn-status'] = {
    label: 'Post-Earnings', statusId: 'post-earn-status', resultId: 'post-earn-result',
    cacheUrl: '/api/post_earnings_cache',
    renderFn: function(el, d) { el.innerHTML = _renderPostEarningsTable(d.results||[]); },
    scanFn: async function() {
      const days = document.getElementById('post-earn-days')?.value || 10;
      const wlId = document.getElementById('earn-watchlist')?.value || '';
      return await api(`/earnings/post_earnings_scan?days=${days}&fetch_all=true${wlId ? '&watchlist_id='+wlId : ''}`);
    }
  };

  // ── S/R Breakout ────────────────────────────────────────────────────────
  _scanCfgs['sr-status'] = {
    label: 'S/R Breakout', statusId: 'sr-status', resultId: 'sr-results',
    cacheUrl: '/api/sr_breakout_cache',
    renderFn: function(el, d) { _renderSRResults(d.results||[], el); },
    scanFn: async function() {
      const str  = document.getElementById('sr-min-strength')?.value || 40;
      const mom  = document.getElementById('sr-require-mom')?.checked !== false;
      const wlId = document.getElementById('sr-watchlist')?.value || '';
      const wlQ  = wlId ? `&watchlist_id=${wlId}` : '';
      return await api(`/scanner/sr/scan?min_strength=${str}&require_momentum=${mom}&sector=${encodeURIComponent(sec)}${wlQ}`);
    }
  };

  // ── S/R Proximity ──────────────────────────────────────────────────────
  _scanCfgs['sr-prox-status'] = {
    label: 'S/R Proximity', statusId: 'sr-prox-status', resultId: 'sr-prox-result',
    cacheUrl: '/api/sr_proximity_cache',
    renderFn: function(el, d) { el.innerHTML = _renderSRProximityTable(d.results||[]); },
    scanFn: async function() {
      const prox  = document.getElementById('sr-proximity-pct')?.value || 3;
      const tf    = document.getElementById('sr-timeframe')?.value || 'daily';
      const wlId  = document.getElementById('sr-watchlist')?.value || '';
      const wlQ   = wlId ? `&watchlist_id=${wlId}` : '';
      return await api(`/scanner/sr/proximity?proximity=${prox}&rsi_filter=all&sector=&timeframes=${tf}${wlQ}`);
    }
  };

  // ── RSI MTF ─────────────────────────────────────────────────────────────
  _scanCfgs['rmt-status'] = {
    label: 'RSI MTF', statusId: 'rmt-status', resultId: 'rmt-results',
    cacheUrl: '/api/rsi_mtf_cache',
    renderFn: function(el, d) {
      _rmtData = d;
      if (typeof rsiMtfFilter === 'function') rsiMtfFilter('all');
      else if (typeof _rmtRender === 'function') _rmtRender(d);
    },
    scanFn: async function() {
      const p = typeof _rmtGetUI === 'function' ? _rmtGetUI() : {};
      const rmtWlId = document.getElementById('rmt-watchlist')?.value || '';
      // When a watchlist is selected, clear the symbols field so backend uses watchlist
      if (rmtWlId) {
        p.symbols = '';   // force backend to use watchlist_id instead of saved symbols
      }
      const rmtUrl = '/api/scanner/rsi_mtf' + (rmtWlId ? '?watchlist_id='+rmtWlId : '');
      return await api(rmtUrl, {method:'POST',
        headers:{'Content-Type':'application/json'}, body: JSON.stringify(p)});
    }
  };
}

// Auto-load each tab from cache when switched to
(function _patchTabLoads() {
  // Override the existing tab handlers to use unified cache loading
  var origTabHandler = window._tabSwitchExtras;
  window._onTabSwitch = function(tab) {
    if (tab === 'oibuildup')  _loadFromCache(_scanCfgs['oib-status']);
    if (tab === 'earnings') {
      _loadFromCache(_scanCfgs['pre-earn-status']);
      _loadFromCache(_scanCfgs['post-earn-status']);
    }
    if (tab === 'srbreak') {
      _loadFromCache(_scanCfgs['sr-break-status']);
      _loadFromCache(_scanCfgs['sr-prox-status']);
    }
    if (tab === 'rsi-mtf')  _loadFromCache(_scanCfgs['rmt-status']);
  };
})();

// Call init after DOM ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', _initScanCaches);
} else {
  _initScanCaches();
}

// ── Earnings Calendar fetch ──────────────────────────────────────────────────
async function _fetchEarningsCalendar() {
  const st  = document.getElementById('earn-cal-status');
  const btn = document.getElementById('btn-earn-cal');
  const t0  = Date.now();
  if (btn) btn.disabled = true;

  // Show live timer
  var _ect = setInterval(function() {
    var s = Math.round((Date.now()-t0)/1000);
    if (st) st.innerHTML = '⏳ Fetching… '+s+'s (~1-3 min for full watchlist)';
  }, 2000);

  if (st) st.innerHTML = '⏳ Starting calendar fetch…';
  try {
    const d = await api('/earnings/fetch_calendar?force=true', {method:'POST'});
    clearInterval(_ect);
    const elapsed = ((Date.now()-t0)/1000).toFixed(0);
    if (st) st.innerHTML = `✅ ${d.updated} updated · ${d.skipped} skipped · ${d.failed} failed · ${elapsed}s`;
    addNotif('ok', '📅 Earnings Calendar updated',
      `${d.updated}/${d.total} symbols · ${d.failed} failed · ${elapsed}s`,
      'Earnings Calendar');
  } catch(e) {
    clearInterval(_ect);
    addNotif('error', 'Earnings Calendar fetch failed', e.message, 'Earnings Calendar');
    if (st) st.innerHTML = '❌ '+e.message;
  } finally {
    if (btn) btn.disabled = false;
  }
}

// ════════════════════════════════════════════════════════════════════════════
// WATCHLIST SYMBOL DETAIL PANEL
// ---------------------------------------------------------------------------
async function _wlLoadSymbolsPanel(wlId, wlName) {
  const panel = document.getElementById('wl-symbol-panel');
  if (!panel || !wlId) return;
  panel.style.display = 'block';
  panel.dataset.wlId = String(wlId);
  panel.dataset.wlName = wlName || '';
  panel.innerHTML = '<div style="color:var(--muted);padding:12px">Loading symbols...</div>';
  try {
    const d = await api(`/watchlists/${wlId}/symbols`);
    const rows = d.symbols || [];
    if (!rows.length) {
      panel.innerHTML = '<div style="color:var(--muted);padding:12px">No symbols in this watchlist.</div>';
      return;
    }
    panel.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;gap:10px;flex-wrap:wrap">
        <div><b>${wlName || 'Watchlist'} symbols</b> <span style="color:var(--muted)">(${rows.length})</span></div>
        <div style="font-size:11px;color:var(--muted)">Set an alert price and choose above / below / both.</div>
      </div>
      <div style="overflow:auto;border:1px solid var(--border);border-radius:8px">
        <table style="width:100%;border-collapse:collapse;font-size:12px">
          <thead><tr style="background:rgba(255,255,255,.05)">
            <th style="padding:8px;text-align:left">Symbol</th>
            <th style="padding:8px;text-align:left">Added</th>
            <th style="padding:8px;text-align:left">Alert Price</th>
            <th style="padding:8px;text-align:left">Direction</th>
            <th style="padding:8px;text-align:left">Mode</th>
            <th style="padding:8px;text-align:left">Last Price</th>
            <th style="padding:8px;text-align:left">Last Alert</th>
            <th style="padding:8px;text-align:left">Action</th>
          </tr></thead>
          <tbody>
            ${rows.map(r => `
              <tr data-wl-symbol-row="${_priceAlertRowKey(wlId, r.symbol)}" style="border-top:1px solid var(--border)">
                <td style="padding:8px;font-weight:700">${r.symbol}</td>
                <td style="padding:8px;color:var(--muted)">${r.added_at || '—'}</td>
                <td style="padding:8px"><input id="wl-ap-${wlId}-${r.symbol}" type="number" step="0.01" value="${r.alert_price ?? ''}" style="width:100px;padding:5px;background:var(--bg);border:1px solid var(--border);border-radius:5px;color:var(--text)"/></td>
                <td style="padding:8px">
                  <select id="wl-ad-${wlId}-${r.symbol}" style="padding:5px;background:var(--bg);border:1px solid var(--border);border-radius:5px;color:var(--text)">
                    <option value="both" ${((r.alert_direction||'both')==='both')?'selected':''}>Both</option>
                    <option value="above" ${(r.alert_direction==='above')?'selected':''}>Above</option>
                    <option value="below" ${(r.alert_direction==='below')?'selected':''}>Below</option>
                  </select>
                </td>
                <td style="padding:8px"><input id="wl-ae-${wlId}-${r.symbol}" type="checkbox" ${r.alert_enabled ? 'checked' : ''}/></td>
                <td style="padding:8px;color:var(--muted)">${fmt(r.current_price, 2)}</td>
                <td style="padding:8px;color:var(--muted)">${r.alert_last_sent_at || '—'}</td>
                <td style="padding:8px;display:flex;gap:6px;flex-wrap:wrap"><button type="button" class="btn btn-ghost btn-sm" onclick="_wlSaveAlert(${wlId}, '${r.symbol}')">Save</button><button type="button" class="btn btn-ghost btn-sm" onclick="_deleteSymbolPriceAlert(${wlId}, '${r.symbol}')">Delete</button></td>
              </tr>`).join('')}
          </tbody>
        </table>
      </div>`;
  } catch(e) {
    panel.innerHTML = '<div style="color:#ef4444;padding:12px">' + e.message + '</div>';
  }
}

async function _wlSaveAlert(wlId, sym) {
  const priceEl = document.getElementById(`wl-ap-${wlId}-${sym}`);
  const dirEl   = document.getElementById(`wl-ad-${wlId}-${sym}`);
  const enEl    = document.getElementById(`wl-ae-${wlId}-${sym}`);
  const payload = {
    alert_price: priceEl?.value || '',
    alert_direction: dirEl?.value || 'both',
    alert_enabled: !!enEl?.checked,
  };
  try {
    const d = await api(`/watchlists/${wlId}/symbols/${encodeURIComponent(sym)}/alert`, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    addNotif('ok', 'Alert saved', `${sym} -> ${(d.alert_price ?? payload.alert_price) || 'off'}`, 'Watchlists');
    const panel = document.getElementById('wl-symbol-panel');
    if (panel?.dataset?.wlId) {
      await _wlLoadSymbolsPanel(panel.dataset.wlId, panel.dataset.wlName || 'Watchlist');
    }
    try { await _loadSymbolAlertsHub(); } catch {}
  } catch (e) {
    addNotif('err', 'Alert save failed', e.message || String(e), 'Watchlists');
  }
}

async function _deleteSymbolPriceAlert(wlId, sym) {
  const watchlistId = Number(wlId);
  const symbol = String(sym || '').trim().toUpperCase();
  if (!Number.isFinite(watchlistId) || watchlistId <= 0 || !symbol) {
    addNotif('err', 'Delete failed', 'Invalid symbol alert target', 'Alerts');
    return;
  }
  if (!confirm(`Delete price alert for ${symbol}?`)) return;

  try {
    let d;
    try {
      d = await api(`/watchlists/${watchlistId}/symbols/${encodeURIComponent(symbol)}/alert`, {method:'DELETE'});
    } catch (firstErr) {
      d = await api(`/watchlists/${watchlistId}/symbols/${encodeURIComponent(symbol)}/alert`, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({alert_price:'', alert_direction:'both', alert_enabled:false})
      });
    }
    if (!d || d.ok === false) throw new Error((d && (d.error || d.message)) || 'Delete failed');

    // Optimistically remove/clear visible rows immediately, then force no-cache
    // reloads.  This fixes the stale grid issue after a confirmed delete.
    _removeDeletedSymbolAlertFromGrids(watchlistId, symbol);
    const panel = document.getElementById('wl-symbol-panel');
    const refreshes = [];
    if (panel?.dataset?.wlId) {
      refreshes.push(_wlLoadSymbolsPanel(panel.dataset.wlId, panel.dataset.wlName || 'Watchlist'));
    }
    refreshes.push(_loadSymbolAlertsHub(true));
    if (typeof _loadAlertRulesHub === 'function') refreshes.push(_loadAlertRulesHub());
    await Promise.allSettled(refreshes);
    addNotif('ok', 'Price alert deleted', symbol, 'Alerts');
  } catch (e) {
    addNotif('err', 'Price alert delete failed', e.message || String(e), 'Alerts');
  }
}
// WATCHLIST MANAGER  — form-based create/edit, table display
// ════════════════════════════════════════════════════════════════════════════
var _wlEditingId = null;
var _wlData = [];

async function _wlLoad() {
  const wrap = document.getElementById('wl-table-wrap');
  if (!wrap) return;
  try {
    const d = await api('/watchlists/');
    _wlData = (d && d.watchlists) ? d.watchlists : [];
    _wlRenderTable();
    _loadSchedulerWatchlists();
    _loadWatchlistDropdown('wl-fetch-watchlist', 'wl-fetch-count', 'Default watchlist');
  } catch(e) {
    if (wrap) wrap.innerHTML = '<div style="color:#ef4444;padding:16px">❌ '+e.message+'</div>';
    addNotif('error', 'Watchlist load failed', e.message, 'Watchlists');
  }
}

function _wlRenderTable() {
  const wrap = document.getElementById('wl-table-wrap');
  if (!wrap) return;
  if (!_wlData.length) {
    wrap.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px"><div style="color:var(--muted);font-size:12px">No watchlists yet — click + New Watchlist.</div><button class="btn btn-secondary" onclick="_wlLoad()" style="font-size:11px;padding:4px 9px">⟳ Refresh</button></div>';
    return;
  }

  function _lastRunBadge(wl) {
    if (!wl.last_fetch_at) return '<span style="color:#ef4444;font-size:10px">⚠ Never fetched</span>';
    // Parse timestamp and compute staleness
    const fetchDate = new Date(wl.last_fetch_at.replace(' ', 'T'));
    const hrs = Math.round((Date.now() - fetchDate) / 3600000);
    const label = hrs < 1 ? 'just now' : hrs < 24 ? hrs+'h ago' : Math.round(hrs/24)+'d ago';
    const color = hrs < 12 ? '#22c55e' : hrs < 48 ? '#f59e0b' : '#ef4444';
    return `<span style="color:${color};font-size:10px;font-weight:700" title="${wl.last_fetch_at}">
      ✅ ${label} &nbsp;<span style="color:var(--muted);font-weight:400">${wl.last_fetch_mode||''} · ${wl.last_fetch_count||0} syms</span>
    </span>`;
  }

  const toolbar = `<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
    <div style="color:var(--muted);font-size:12px">Manage watchlists and fetch data.</div>
    <button class="btn btn-secondary" onclick="_wlLoad()" style="font-size:11px;padding:4px 9px">⟳ Refresh</button>
  </div>`;

  const rows = _wlData.map(wl => {
    const oi  = wl.fetch_options_oi
      ? '<span style="font-size:11px;color:#22c55e;font-weight:600">📊 Options OI<br><span style="font-size:9px;font-weight:400;color:var(--muted)">→ options table</span></span>'
      : '<span style="font-size:11px;color:#818cf8;font-weight:600">💰 Price/Vol<br><span style="font-size:9px;font-weight:400;color:var(--muted)">→ price_cache</span></span>';
    const def = wl.is_default
      ? '<span style="color:#f59e0b;font-size:11px;font-weight:700">⭐ Yes</span>'
      : `<button onclick="_wlSetDefault(${wl.id})" style="font-size:10px;padding:2px 7px;border-radius:4px;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);color:#f59e0b;cursor:pointer">Set Default</button>`;
    const nm = wl.name.replace(/'/g, "\'");
    return `<tr style="border-bottom:1px solid var(--border);vertical-align:top">
      <td style="padding:10px 10px">
        <div style="font-weight:700;color:${wl.color||'#818cf8'};font-size:13px">${wl.name}</div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);margin-top:2px">
          ${wl.symbol_count} symbols
          ${wl.sector_coverage > 0
            ? '<span style="color:var(--muted);font-weight:400;margin-left:4px">· '+wl.sector_coverage+' with sector</span>'
            : '<span style="color:#f59e0b;font-size:10px;margin-left:4px">· run 🗂 Sectors</span>'}
        </div>
        ${(wl.sectors||[]).length > 0 ? '<div style="margin-top:4px;display:flex;gap:3px;flex-wrap:wrap">' +
          (wl.sectors||[]).map(s => `<span style="font-size:9px;padding:1px 5px;border-radius:3px;background:rgba(99,102,241,.1);color:#818cf8">${s.sector} ${s.count}</span>`).join('') +
          '</div>' : ''}
      </td>
      <td style="padding:10px 10px;vertical-align:top">${oi}</td>
      <td style="padding:10px 10px;text-align:center;vertical-align:top">${def}</td>
      <td style="padding:10px 10px;vertical-align:top">
        ${_lastRunBadge(wl)}
        <div id="wl-status-${wl.id}" style="font-size:10px;color:var(--muted);margin-top:4px"></div>
      </td>
      <td style="padding:8px 10px;vertical-align:top">
        <div style="display:flex;gap:5px;flex-wrap:wrap">
          <button onclick="_wlRunFetch(${wl.id},'${nm}')" id="wl-run-${wl.id}"
            title="${wl.fetch_options_oi?'Fetch Options OI chain → options table':'Fetch OHLCV → price_cache table'}"
            style="font-size:11px;padding:3px 10px;border-radius:4px;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:#22c55e;cursor:pointer;white-space:nowrap">
            ${wl.fetch_options_oi?'📊 Fetch OI':'💰 Fetch Price'}
          </button>
          <button onclick="_wlRunSectors(${wl.id},'${nm}')"
            style="font-size:11px;padding:3px 10px;border-radius:4px;background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.25);color:#818cf8;cursor:pointer">
            🗂 Sectors
          </button>
          <button onclick="_wlRunEarnings(${wl.id},'${nm}')"
            style="font-size:11px;padding:3px 10px;border-radius:4px;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);color:#f59e0b;cursor:pointer">
            📅 Earnings
          </button>
        </div>
        <div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:5px">
          <button onclick="_wlLoadSymbolsPanel(${wl.id}, '${nm}')"
            style="font-size:10px;padding:2px 8px;border-radius:4px;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.25);color:#22c55e;cursor:pointer">
            Symbols
          </button>
          <button onclick="_wlEdit(${wl.id})"
            style="font-size:10px;padding:2px 8px;border-radius:4px;background:rgba(148,163,184,.08);border:1px solid var(--border);color:var(--text2);cursor:pointer">
            ✏ Edit
          </button>
          <button onclick="_wlDelete(${wl.id},'${nm}')"
            style="font-size:10px;padding:2px 8px;border-radius:4px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:#ef4444;cursor:pointer">
            🗑 Delete
          </button>
        </div>
      </td>
    </tr>`;
  }).join('');

  wrap.innerHTML = toolbar + `<table style="width:100%;border-collapse:collapse;font-size:12px">
    <thead><tr style="background:rgba(255,255,255,.05);border-bottom:2px solid var(--border)">
      <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:600">Watchlist</th>
      <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:600">Data Mode</th>
      <th style="padding:8px 10px;text-align:center;font-size:11px;color:var(--muted);font-weight:600">Default</th>
      <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:600">Last Run</th>
      <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:600">Actions</th>
    </tr></thead>
    <tbody>${rows}</tbody>
  </table>`;
}


async function _wlRunFetch(id, name) {
  const st = document.getElementById('wl-status-'+id);
  const btn = document.getElementById('wl-run-'+id);
  if (btn) btn.disabled = true;
  if (st) st.textContent = '⏳ Starting fetch…';
  try {
    const d = await api(`/watchlists/${id}/fetch_data`, {method:'POST'});
    const msg = `⏳ ${d.mode} running for ${d.symbols} symbols → ${d.table} table`;
    if (st) st.textContent = msg;
    addNotif('ok', `${name}: ${d.mode} started`, `${d.symbols} symbols → ${d.table}`, 'Watchlists');
    // Poll status
    let polls = 0;
    const poll = setInterval(async () => {
      polls++;
      try {
        const s = await api(`/watchlists/${id}/fetch_status`);
        if (st) st.textContent = `📊 ${s.fetched_today}/${s.symbols_total} fetched today → ${s.table}`;
        if (s.fetched_today >= s.symbols_total || polls > 60) {
          clearInterval(poll);
          if (btn) btn.disabled = false;
          addNotif('ok', `${name}: fetch done`, `${s.fetched_today}/${s.symbols_total} → ${s.table}`, 'Watchlists');
          // Reload table to show updated Last Run timestamp
          await _wlLoad();
        }
      } catch { clearInterval(poll); if (btn) btn.disabled = false; }
    }, 5000);
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
    if (btn) btn.disabled = false;
    addNotif('error', name+': fetch failed', e.message, 'Watchlists');
  }
}

async function _wlFetchSelected() {
  const sel = document.getElementById('wl-fetch-watchlist');
  const wlId = sel ? (sel.value || '') : '';
  const st = document.getElementById('wl-fetch-status');
  if (st) st.textContent = '⏳ Starting selected watchlist fetch…';
  try {
    await api(`/api/fetch_now${wlId ? '?watchlist_id='+wlId : ''}`, {method:'POST'});
    if (st) st.textContent = '✅ Fetch started';
    _pollFetchStatus(st, 'selected');
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
  }
}

async function _wlFetchAll() {
  const st = document.getElementById('wl-fetch-status');
  if (st) st.textContent = '⏳ Starting full watchlist sweep…';
  try {
    await api('/api/fetch_now', {method:'POST'});
    if (st) st.textContent = '✅ Full sweep started';
    _pollFetchStatus(st, 'all');
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
  }
}

function _pollFetchStatus(st, label) {
  let ticks = 0;
  const timer = setInterval(async () => {
    ticks++;
    try {
      const s = await api('/api/fetch_status');
      if (st) st.textContent = s.running ? `⏳ ${s.last_msg || 'running'}` : `✅ ${s.last_msg || 'done'}`;
      if (!s.running || ticks > 120) {
        clearInterval(timer);
        if (st) st.textContent = s.last_msg || 'done';
      }
    } catch {
      if (ticks > 10) clearInterval(timer);
    }
  }, 3000);
}

async function _wlRunSectors(id, name) {
  const st  = document.getElementById('wl-status-'+id);
  const btn = document.getElementById('wl-sec-'+id);
  if (btn) btn.disabled = true;
  if (st)  st.textContent = '⏳ Starting sector update…';
  try {
    const d = await api(`/api/update_sectors?force=true&watchlist_id=${id}`, {method:'POST'});
    if (!d.ok) throw new Error(d.error || 'Start failed');
    if (st) st.textContent = `⏳ Updating sectors for ${d.total} symbols (background)…`;
    addNotif('info', name+': sector update started', d.total+' symbols', 'Watchlists');
    // Poll every 5s until done
    let polls = 0;
    const poll = setInterval(async () => {
      polls++;
      try {
        const s = await api('/api/update_sectors_status');
        if (st) st.textContent = `⏳ Sectors: ${s.updated} updated · ${s.skipped} skipped · ${s.failed} failed / ${s.total}`;
        if (s.done || polls > 120) {
          clearInterval(poll);
          if (btn) btn.disabled = false;
          if (st) st.textContent = `✅ Sectors done: ${s.updated} updated · ${s.skipped} skipped · ${s.failed} no-sector`;
          addNotif('ok', name+': sectors updated', `${s.updated}/${s.total} · ${s.failed} ETFs/unknown`, 'Watchlists');
          await _wlLoad(); // refresh to show new sector badges
        }
      } catch { clearInterval(poll); if (btn) btn.disabled = false; }
    }, 5000);
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
    if (btn) btn.disabled = false;
    addNotif('error', name+': sectors failed', e.message, 'Watchlists');
  }
}

async function _wlRunEarnings(id, name) {
  const st = document.getElementById('wl-status-'+id);
  if (st) st.textContent = '⏳ Fetching earnings calendar…';
  try {
    const d = await api(`/earnings/fetch_calendar?force=true&watchlist_id=${id}`, {method:'POST'});
    if (st) st.textContent = `✅ Earnings: ${d.updated} updated · ${d.skipped} skipped · ${d.failed} failed`;
    addNotif('ok', name+': earnings calendar updated', `${d.updated} symbols`, 'Watchlists');
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
    addNotif('error', name+': earnings failed', e.message, 'Watchlists');
  }
}

function _wlParseSymbols(rawSymbols) {
  const allowed = /^[A-Z0-9.$=^_-]{1,40}$/;
  const seen = new Set();
  const symbols = [];
  const rejected = [];
  String(rawSymbols || '')
    .split(/[,\n\r\t ]+/)
    .map(s => String(s || '').trim().toUpperCase().replace(/^[,;]+|[,;]+$/g, ''))
    .filter(Boolean)
    .forEach(sym => {
      if (!allowed.test(sym)) { rejected.push(sym); return; }
      if (!seen.has(sym)) { seen.add(sym); symbols.push(sym); }
    });
  symbols.sort();
  return {symbols, rejected};
}

function _wlShowAddForm() {
  _wlEditingId = null;
  document.getElementById('wl-form-title').textContent = 'New Watchlist';
  document.getElementById('wl-f-id').value = '';
  document.getElementById('wl-f-name').value = '';
  document.getElementById('wl-f-symbols').value = '';
  document.getElementById('wl-f-oi').checked = false;
  document.getElementById('wl-f-default').checked = false;
  document.getElementById('wl-form-status').textContent = '';
  document.getElementById('wl-form-panel').style.display = 'block';
  document.getElementById('wl-f-name').focus();
}

async function _wlEdit(id) {
  _wlEditingId = id;
  const wl = _wlData.find(w => w.id === id);
  if (!wl) return;
  document.getElementById('wl-form-title').textContent = 'Edit: '+wl.name;
  document.getElementById('wl-f-id').value = id;
  document.getElementById('wl-f-name').value = wl.name;
  document.getElementById('wl-f-oi').checked = !!wl.fetch_options_oi;
  document.getElementById('wl-f-default').checked = !!wl.is_default;
  document.getElementById('wl-form-status').textContent = '⏳ Loading symbols…';
  document.getElementById('wl-form-panel').style.display = 'block';
  try {
    const d = await api(`/watchlists/${id}/symbols`);
    document.getElementById('wl-f-symbols').value = (d.symbols||[]).map(s=>s.symbol).join(', ');
    document.getElementById('wl-form-status').textContent = `${d.count} symbols`;
  } catch(e) {
    document.getElementById('wl-form-status').textContent = '❌ '+e.message;
  }
  document.getElementById('wl-form-panel').scrollIntoView({behavior:'smooth',block:'start'});
}

function _wlFormCancel() {
  document.getElementById('wl-form-panel').style.display = 'none';
  _wlEditingId = null;
}

async function _wlFormSave() {
  const st   = document.getElementById('wl-form-status');
  const name = (document.getElementById('wl-f-name')?.value || '').trim();
  const rawSymbols = document.getElementById('wl-f-symbols')?.value || '';
  const fetchOI    = document.getElementById('wl-f-oi')?.checked ? 1 : 0;
  const isDefault  = document.getElementById('wl-f-default')?.checked ? 1 : 0;
  const editId     = document.getElementById('wl-f-id')?.value;

  if (!name) { alert('Watchlist name is required'); return; }

  // Parse symbols. Keep yfinance futures/FX/index suffixes such as GC=F, EURUSD=X, ^VIX.
  const parsed = _wlParseSymbols(rawSymbols);
  const symbols = parsed.symbols;
  const rejected = parsed.rejected;
  if (rejected.length && st) {
    st.textContent = `⚠ Ignoring ${rejected.length} invalid symbol(s): ${rejected.slice(0,8).join(', ')}`;
    await new Promise(r => setTimeout(r, 350));
  }

  if (st) st.textContent = '⏳ Saving…';

  try {
    if (editId) {
      // Update metadata
      await api(`/watchlists/${editId}`, {method:'PUT',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({name, fetch_options_oi:fetchOI, description:''})});
      // Update symbols
      await api(`/watchlists/${editId}/symbols/replace`, {method:'POST',
        headers:{'Content-Type':'application/json'}, body: JSON.stringify({symbols})});
      // Set default
      if (isDefault) await api(`/watchlists/${editId}/set_default`, {method:'POST'});
    } else {
      // Create
      const cr = await api('/watchlists/', {method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({name, fetch_options_oi:fetchOI, description:''})});
      const newId = cr.id;
      if (symbols.length) {
        await api(`/watchlists/${newId}/symbols/replace`, {method:'POST',
          headers:{'Content-Type':'application/json'}, body: JSON.stringify({symbols})});
      }
      if (isDefault) await api(`/watchlists/${newId}/set_default`, {method:'POST'});
    }
    if (st) st.textContent = `✅ Saved: ${symbols.length} symbols${rejected.length ? ` · ${rejected.length} ignored` : ''}`;
    setTimeout(() => { document.getElementById('wl-form-panel').style.display='none'; _wlEditingId=null; }, 800);
    await _wlLoad();
    addNotif('ok', editId ? 'Watchlist updated' : 'Watchlist created', name+' ('+symbols.length+' symbols)', 'Watchlists');
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
    addNotif('error', 'Save failed', e.message, 'Watchlists');
  }
}

async function _wlDelete(id, name) {
  if (!confirm(`Delete watchlist "${name}"?\nAll ${(_wlData.find(w=>w.id===id)||{}).symbol_count||0} symbols will be removed from this list.`)) return;
  try {
    await api(`/watchlists/${id}`, {method:'DELETE'});
    await _wlLoad();
    addNotif('ok', 'Deleted: '+name, '', 'Watchlists');
  } catch(e) { addNotif('error', 'Delete failed', e.message, 'Watchlists'); }
}


async function _tgLoadConfig() {
  const tok = document.getElementById('tg-bot-token');
  const chat = document.getElementById('tg-chat-id');
  const st   = document.getElementById('tg-config-status');
  try {
    const d = await api('/telegram/config');
    if (tok) tok.value = d.telegram_bot_token || '';
    if (chat) chat.value = d.telegram_chat_id || '';
    if (st) st.textContent = d.configured ? `✅ Configured (${d.source})` : '⚠ Not configured yet';
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
  }
}

async function _tgSaveConfig() {
  const tok = document.getElementById('tg-bot-token')?.value || '';
  const chat = document.getElementById('tg-chat-id')?.value || '';
  const st   = document.getElementById('tg-config-status');
  if (st) st.textContent = '⏳ Saving...';
  try {
    await api('/telegram/config', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({telegram_bot_token: tok, telegram_chat_id: chat})
    });
    if (st) st.textContent = '✅ Telegram saved';
    addNotif('ok', 'Telegram configured', 'Bot token and chat ID saved', 'Watchlists');
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
    addNotif('error', 'Telegram save failed', e.message, 'Watchlists');
  }
}

async function _tgTest() {
  const msg = document.getElementById('tg-test-msg')?.value || 'Test alert from the OI app.';
  const st  = document.getElementById('tg-config-status');
  if (st) st.textContent = '⏳ Sending test message...';
  try {
    const d = await api('/telegram/test', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({message: msg})
    });
    if (st) st.textContent = '✅ Test message sent';
    addNotif('ok', 'Telegram test sent', d.ok ? 'Message delivered' : (d.error || 'Not delivered'), 'Watchlists');
  } catch(e) {
    if (st) st.textContent = '❌ '+e.message;
    addNotif('error', 'Telegram test failed', e.message, 'Watchlists');
  }
}

// ── Scheduler watchlist integration ─────────────────────────────────────────
async function _loadSchedulerWatchlists() {
  const sel = document.getElementById('scheduler-watchlist');
  if (!sel) return;
  try {
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    if (!wls.length) {
      sel.innerHTML = '<option value="">No watchlists — create one in 📋 Watchlists tab</option>';
      return;
    }
    sel.innerHTML = wls.map(wl =>
      `<option value="${wl.id}"${wl.is_default?' selected':''}>` +
      `${wl.is_default?'⭐ ':''}${wl.name} (${wl.symbol_count} syms)${wl.fetch_options_oi?' 📊':' 💰'}` +
      `</option>`
    ).join('');
  } catch(e) {
    sel.innerHTML = '<option value="">⚠ Error: '+e.message+'</option>';
  }
}

async function _runSchedulerWithWatchlist() {
  const sel   = document.getElementById('scheduler-watchlist');
  const wlId  = sel ? (sel.value || null) : null;
  const wlName = sel ? sel.options[sel.selectedIndex]?.text : 'Default';
  // Use the existing run-now button flow but pass watchlist_id
  const btn = document.getElementById('run-now');
  if (btn) btn.disabled = true;
  try {
    const d = await api(`/api/fetch_now${wlId ? '?watchlist_id='+wlId : ''}`, {method:'POST'});
    addNotif('ok', 'Scheduler started', `Watchlist: ${wlName}`, 'Scheduler');
    // Start polling status
    let _pt = setInterval(async function() {
      const s = await api('/api/fetch_status');
      if (!s.running) {
        clearInterval(_pt);
        if (btn) btn.disabled = false;
        addNotif('ok', 'Scheduler done', s.last_msg||'', 'Scheduler');
      }
    }, 3000);
  } catch(e) {
    if (btn) btn.disabled = false;
    addNotif('error', 'Scheduler start failed', e.message, 'Scheduler');
  }
}

// Also update sector and earnings calendar fetches to respect watchlist
async function _updateSectorsForWatchlist() {
  const sel  = document.getElementById('scheduler-watchlist');
  const wlId = sel ? (sel.value || null) : null;
  const url  = wlId ? `/api/update_sectors?force=true&watchlist_id=${wlId}` : '/api/update_sectors?force=true';
  const st   = document.getElementById('sector-update-status');
  if (st) st.innerHTML = '⏳ Updating sectors…';
  try {
    const d = await api(url, {method:'POST'});
    if (st) st.innerHTML = `✅ ${d.updated}/${d.total} updated · ${d.failed} failed`;
    addNotif('ok', 'Sectors updated', `${d.updated}/${d.total}`, 'Sectors');
  } catch(e) { if (st) st.innerHTML = '❌ '+e.message; }
}

// Auto-load watchlist picker when scheduler tab opens
(function() {
  var origLoadFuturesCfg = window._loadFuturesConfig;
  document.addEventListener('click', function(e) {
    if (e.target.matches('[data-tab="scheduler"]')) {
      setTimeout(_loadSchedulerWatchlists, 100);
    }
  });
})();

// ════════════════════════════════════════════════════════════════════════════
// INSTITUTIONAL ACCUMULATION BREAKOUT SCANNER
// ════════════════════════════════════════════════════════════════════════════

async function _instLoadWatchlists() {
  const sel = document.getElementById('inst-watchlist');
  if (!sel) return;
  try {
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    sel.innerHTML = '<option value="">⚡ All symbols (symbols table)</option>' +
      wls.map(w => `<option value="${w.id}"${w.is_default?' selected':''}>${w.is_default?'⭐ ':''}${w.name} (${w.symbol_count})</option>`).join('');
  } catch(e) { console.warn('inst watchlist load:', e.message); }
}

function _instRenderTable(results, status) {
  const el = document.getElementById('inst-results');
  if (!el) return;
  if (!results || !results.length) {
    el.innerHTML = '<div style="color:var(--muted);padding:20px;text-align:center">No institutional breakout signals found in this watchlist.</div>';
    return;
  }

  const signalColor = s => s.includes('Strong') ? '#22c55e' : s.includes('Moderate') ? '#818cf8' : '#f59e0b';
  const pct = v => {
    if (v == null || isNaN(v)) return '<span style="color:var(--muted)">—</span>';
    const c = v > 0 ? '#22c55e' : v < 0 ? '#ef4444' : '#94a3b8';
    return `<span style="color:${c};font-weight:600">${v>0?'+':''}${Number(v).toFixed(1)}%</span>`;
  };
  const emaStack = r => {
    const a20 = r.above_ema20, a50 = r.above_ema50, a200 = r.above_ema200;
    // 200 EMA is required (always green if here), 20/50 are optional bonuses
    const d200 = `<span title="Above 200 EMA (required)" style="color:#22c55e">●</span>`;
    const d50  = `<span title="Above 50 EMA (bonus)" style="color:${a50?'#22c55e':'#94a3b8'}">${a50?'●':'○'}</span>`;
    const d20  = `<span title="Above 20 EMA (bonus)" style="color:${a20?'#22c55e':'#94a3b8'}">${a20?'●':'○'}</span>`;
    return `<span style="font-size:11px">${d20}${d50}${d200}</span>`;
  };

  const rows = results.map(r => {
    const sc = signalColor(r.signal);
    const sweepBadge = r.liquidity_sweep
      ? `<span title="Liquidity sweep of ${r.sweep_depth}% before move" style="font-size:9px;padding:1px 5px;border-radius:3px;background:rgba(245,158,11,.15);color:#f59e0b;font-weight:700">💧Sweep</span>`
      : '';
    const oiBar = (r.oi_buildup_pct == null)
      ? '<span style="color:var(--muted);font-size:10px">—</span>'
      : r.oi_buildup_pct > 0
        ? `<span style="color:#818cf8;font-size:10px;font-weight:600">+${r.oi_buildup_pct}%</span>`
        : r.oi_buildup_pct < 0
          ? `<span style="color:#ef4444;font-size:10px">${r.oi_buildup_pct}%</span>`
          : '<span style="color:var(--muted);font-size:10px">0%</span>';
    const bType = ({
      '52W Breakout':    '<span style="color:#22c55e;font-weight:700;font-size:10px">🚀 52W High</span>',
      'Base Breakout':   '<span style="color:#818cf8;font-weight:700;font-size:10px">📦 Base Break</span>',
      'Resistance Break':'<span style="color:#a78bfa;font-weight:700;font-size:10px">⚡ Resistance</span>',
      'EMA50 Reclaim':   '<span style="color:#f59e0b;font-weight:700;font-size:10px">📈 EMA50 Reclaim</span>',
      'EMA20 Reclaim':   '<span style="color:#fb923c;font-weight:700;font-size:10px">📈 EMA20 Reclaim</span>',
      '200 EMA Hold':    '<span style="color:#60a5fa;font-weight:700;font-size:10px">🛡 200 EMA Hold</span>',
      'Vol Momentum':    '<span style="color:#f472b6;font-weight:700;font-size:10px">⚡ Vol Momentum</span>',
    })[r.breakout_type] || `<span style="font-size:10px">${r.breakout_type}</span>`;

    return `<tr style="border-bottom:1px solid var(--border)">
      <td style="padding:8px 10px;font-weight:800;font-size:13px;color:${sc}">${r.symbol}</td>
      <td style="padding:8px 10px;font-size:10px;color:var(--muted);max-width:90px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${r.watchlist||''}">
        ${r.watchlist||'—'}
      </td>
      <td style="padding:8px 10px;text-align:center">
        <span style="font-size:16px;font-weight:900;color:${sc}">${r.score}</span>
        <div style="font-size:9px;color:${sc}">${r.signal.replace(/[🔥✅👀]/g,'').trim()}</div>
      </td>
      <td style="padding:8px 10px">${bType} ${sweepBadge}</td>
      <td style="padding:8px 10px;font-weight:700">$${r.price}</td>
      <td style="padding:8px 6px;text-align:right">${pct(r.price_5d_chg)}</td>
      <td style="padding:8px 6px;text-align:right">${pct(r.price_20d_chg)}</td>
      <td style="padding:8px 10px;text-align:center">
        <div style="font-size:11px;font-weight:700;color:${r.vol_surge>2?'#22c55e':r.vol_surge>1.5?'#f59e0b':'var(--text2)'}">${r.vol_surge}×</div>
        <div style="font-size:9px;color:var(--muted)">${r.vol_peak_pct}% peak</div>
      </td>
      <td style="padding:8px 10px;text-align:center">
        <div style="font-size:11px;font-weight:700;color:${r.rsi>70?'#ef4444':r.rsi>55?'#22c55e':r.rsi>45?'#818cf8':'#f59e0b'}">${r.rsi}</div>
        <div>${emaStack(r)}</div>
      </td>
      <td style="padding:8px 10px;text-align:center">
        ${r.oi_available === false
          ? '<span style="font-size:10px;color:var(--muted)">📵 No OI</span>'
          : oiBar}
      </td>
      <td style="padding:8px 10px;text-align:center">
        <div style="font-size:10px;color:var(--muted)">${r.base_tight_pct}% tight</div>
        <div style="font-size:10px;color:var(--muted)">${r.base_days}D base</div>
      </td>
      <td style="padding:8px 10px;text-align:center;font-size:10px;color:var(--muted)">
        ${r.new_52w_high ? '<span style="color:#f59e0b">🏆 New High</span>' : `${r.pct_from_52wh}% from 52W`}
      </td>
    </tr>`;
  }).join('');

  const hdr = `<tr style="background:rgba(255,255,255,.05);border-bottom:2px solid var(--border)">
    <th style="padding:7px 10px;text-align:left;font-size:10px;color:var(--muted)">Symbol</th>
    <th style="padding:7px 10px;text-align:left;font-size:10px;color:var(--muted)">Watchlist</th>
    <th style="padding:7px 10px;text-align:center;font-size:10px;color:var(--muted)">Score</th>
    <th style="padding:7px 10px;text-align:left;font-size:10px;color:var(--muted)">Breakout</th>
    <th style="padding:7px 10px;text-align:left;font-size:10px;color:var(--muted)">Price</th>
    <th style="padding:7px 10px;text-align:right;font-size:10px;color:var(--muted)">5D%</th>
    <th style="padding:7px 10px;text-align:right;font-size:10px;color:var(--muted)">20D%</th>
    <th style="padding:7px 10px;text-align:center;font-size:10px;color:var(--muted)">Vol Surge</th>
    <th style="padding:7px 10px;text-align:center;font-size:10px;color:var(--muted)">RSI/EMA</th>
    <th style="padding:7px 10px;text-align:center;font-size:10px;color:var(--muted)">OI Buildup</th>
    <th style="padding:7px 10px;text-align:center;font-size:10px;color:var(--muted)">Base</th>
    <th style="padding:7px 10px;text-align:center;font-size:10px;color:var(--muted)">52W</th>
  </tr>`;

  el.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:12px">
    <thead>${hdr}</thead><tbody>${rows}</tbody></table>`;
}

function _instGetParams() {
  const ids = ['min_score','ema200_pct','min_price_5d','min_vol_surge','base_days','base_tight_max','rsi_min','rsi_max'];
  const p = {};
  ids.forEach(id => {
    const el = document.getElementById('inst-p-'+id);
    if (el) p[id] = parseFloat(el.value) || 0;
  });
  const cb = document.getElementById('inst-p-require_above_base');
  p.require_above_base = cb ? cb.checked : false;
  return p;
}

function _instToggleCriteria() {
  const panel = document.getElementById('inst-criteria-panel');
  if (panel) panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
}

function _instResetCriteria() {
  const defaults = {min_score:3.0,ema200_pct:3.0,min_price_5d:1.5,min_vol_surge:1.2,base_days:30,base_tight_max:30,rsi_min:40,rsi_max:80};
  Object.entries(defaults).forEach(([k,v]) => { const el=document.getElementById('inst-p-'+k); if(el) el.value=v; });
  const cb=document.getElementById('inst-p-require_above_base'); if(cb) cb.checked=false;
}

async function _instRunScan() {
  const btn = document.getElementById('btn-inst-run');
  const st  = document.getElementById('inst-status');
  const wlId = document.getElementById('inst-watchlist')?.value || '';
  const params = _instGetParams();
  const t0  = Date.now();
  if (btn) btn.disabled = true;
  if (st)  st.textContent = '⏳ Scanning…';
  document.getElementById('inst-results').innerHTML =
    '<div style="color:var(--muted);padding:20px;text-align:center">⏳ Running institutional scan (parallel, ~30–90s)…</div>';

  var _t = setInterval(() => {
    if(st) st.textContent = `⏳ Scanning… ${Math.round((Date.now()-t0)/1000)}s`;
  }, 2000);

  try {
    const url = `/scanner/institutional/scan${wlId?'?watchlist_id='+wlId:''}`;
    const d = await api(url, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(params)});
    clearInterval(_t);
    const elapsed = ((Date.now()-t0)/1000).toFixed(1);
    const oiNote = d.use_oi ? '📊 OI' : '💰 no OI';
    const errNote = d.errors > 0 ? ` · ⚠ ${d.errors} errors` : '';
    if (st) st.textContent = `✅ ${d.count} signals · ${d.total_scanned} scanned · ${elapsed}s · ${d.watchlist||'All'} · ${oiNote}${errNote}`;
    _instRenderTable(d.results);
    addNotif('ok', `🏦 Inst. Breakout: ${d.count} signals`,
      `${d.count} of ${d.total_scanned} passed · took ${elapsed}s`, 'Inst. Breakout');
  } catch(e) {
    clearInterval(_t);
    if (st) st.textContent = '❌ ' + e.message;
    if (btn) btn.disabled = false;
    addNotif('error', 'Inst. Scan failed', e.message, 'Inst. Breakout');
  } finally {
    if (btn) btn.disabled = false;
  }
}

async function _instLoadCache() {
  const st = document.getElementById('inst-status');
  try {
    const d = await api('/scanner/institutional/scan_cached');
    if (!d.results.length) {
      if (st) st.textContent = 'No cached results — run scanner first';
      return;
    }
    if (st) st.textContent = `📥 Loaded ${d.count} cached results · ${d.completed_at}`;
    _instRenderTable(d.results);
  } catch(e) {
    if (st) st.textContent = '❌ ' + e.message;
  }
}

// inst-scan tab wiring moved to main tab router

// ── Shared scanner watchlist selection ──────────────────────────────────────
const _scannerWlKey = 'options_trader_scanner_watchlist_id';
function _getScannerWatchlistId() {
  try { return localStorage.getItem(_scannerWlKey) || ''; } catch(e) { return ''; }
}
function _setScannerWatchlistId(wlId) {
  try {
    if (wlId) localStorage.setItem(_scannerWlKey, String(wlId));
    else localStorage.removeItem(_scannerWlKey);
  } catch(e) {}
}

// ── RSI MTF Watchlist integration ────────────────────────────────────────────
async function _rmtLoadWatchlists() {
  const sel = document.getElementById('rmt-watchlist');
  if (!sel) return;
  try {
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    const stored = _getScannerWatchlistId();
    sel.innerHTML = '<option value="">Default (symbols table)</option>' +
      wls.map(w => `<option value="${w.id}"${w.is_default?' selected':''}>${w.is_default?'⭐ ':''}${w.name} (${w.symbol_count})</option>`).join('');
    if (stored && [...sel.options].some(o => String(o.value) === String(stored))) sel.value = String(stored);
    _rmtWatchlistChange();
  } catch(e) {}
}

async function _rmtWatchlistChange() {
  const sel   = document.getElementById('rmt-watchlist');
  const cnt   = document.getElementById('rmt-wl-count');
  const wlId  = sel ? sel.value : '';
  _setScannerWatchlistId(wlId);
  if (!wlId) { if (cnt) cnt.textContent = ''; return; }
  try {
    const d = await api(`/watchlists/${wlId}/symbols`);
    if (cnt) cnt.textContent = `→ ${d.count} symbols`;
    if (_scanCfgs && _scanCfgs['rmt-status']) {
      _scanCfgs['rmt-status']._wlId = wlId;
    }
  } catch(e) {}
}

async function _mrLoadWatchlists() {
  const sel = document.getElementById('mr-watchlist');
  if (!sel) return;
  try {
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    const stored = _getScannerWatchlistId();
    sel.innerHTML = '<option value="">Default (symbols table)</option>' +
      wls.map(w => `<option value="${w.id}"${w.is_default?' selected':''}>${w.is_default?'⭐ ':''}${w.name} (${w.symbol_count})</option>`).join('');
    if (stored && [...sel.options].some(o => String(o.value) === String(stored))) sel.value = String(stored);
    _mrWatchlistChange();
  } catch(e) {}
}

async function _mrWatchlistChange() {
  const sel   = document.getElementById('mr-watchlist');
  const cnt   = document.getElementById('mr-wl-count');
  const wlId  = sel ? sel.value : '';
  _setScannerWatchlistId(wlId);
  if (!wlId) { if (cnt) cnt.textContent = ''; return; }
  try {
    const d = await api(`/watchlists/${wlId}/symbols`);
    if (cnt) cnt.textContent = `→ ${d.count} symbols`;
  } catch(e) {}
}

// RSI MTF watchlist: handled directly in scanFn above

// ════════════════════════════════════════════════════════════════════════════
// WATCHLIST DROPDOWNS — SR Breakout, SR Proximity, Regime Scanner
// ════════════════════════════════════════════════════════════════════════════

// Generic watchlist loader for any scanner dropdown
async function _loadWatchlistDropdown(selectId, countId, defaultLabel) {
  const sel = document.getElementById(selectId);
  if (!sel) return;
  try {
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    sel.innerHTML = `<option value="">${defaultLabel||'Default (symbols table)'}</option>` +
      wls.map(w => `<option value="${w.id}"${w.is_default?' selected':''}>${w.is_default?'⭐ ':''}${w.name} (${w.symbol_count})</option>`).join('');
    // Trigger count update
    _updateWlCount(selectId, countId);
  } catch(e) { console.warn('watchlist load:', e.message); }
}

async function _updateWlCount(selectId, countId) {
  const sel = document.getElementById(selectId);
  const cnt = document.getElementById(countId);
  if (!sel || !cnt) return;
  const wlId = sel.value;
  if (!wlId) { cnt.textContent = ''; return; }
  try {
    const d = await api(`/watchlists/${wlId}/symbols`);
    cnt.textContent = `→ ${d.count} symbols`;
  } catch(e) { cnt.textContent = ''; }
}

async function _earnLoadWatchlists() {
  await _loadWatchlistDropdown('earn-watchlist', 'earn-wl-count', 'Default watchlist');
  if (typeof _loadEarnSymbols === 'function') {
    await _loadEarnSymbols();
  }
}
async function _earnWatchlistChange() {
  _updateWlCount('earn-watchlist', 'earn-wl-count');
  if (typeof _loadEarnSymbols === 'function') {
    await _loadEarnSymbols();
  }
}

async function _oibLoadSettings() {
  try {
    const d = await api('/api/oi_buildup_settings');
    const s = d && d.settings ? d.settings : {};
    const st = document.getElementById('oib-st-days');
    const mt = document.getElementById('oib-mt-days');
    const lt = document.getElementById('oib-lt-days');
    if (st) st.value = s.st_days || st.value || 3;
    if (mt) mt.value = s.mt_days || mt.value || 10;
    if (lt) lt.value = s.lt_days || lt.value || 30;
    try { localStorage.setItem('oib_days', JSON.stringify({st_days:s.st_days||3, mt_days:s.mt_days||10, lt_days:s.lt_days||30})); } catch(e) {}
  } catch(e) { console.warn('oib settings load:', e.message); }
}
async function _saveOibSettings() {
  const st = parseInt(document.getElementById('oib-st-days')?.value || 3, 10);
  const mt = parseInt(document.getElementById('oib-mt-days')?.value || 10, 10);
  const lt = parseInt(document.getElementById('oib-lt-days')?.value || 30, 10);
  const payload = { st_days: st, mt_days: mt, lt_days: lt };
  try {
    await api('/api/oi_buildup_settings', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)});
    try { localStorage.setItem('oib_days', JSON.stringify(payload)); } catch(e) {}
    const stEl = document.getElementById('oib-status');
    if (stEl) stEl.innerHTML = `💾 Saved ST ${st} · MT ${mt} · LT ${lt}`;
  } catch(e) {
    const stEl = document.getElementById('oib-status');
    if (stEl) stEl.innerHTML = `❌ ${e.message}`;
  }
}
async function _savedRunSave(scannerKey, runName, payload, summary={}, extras={}) {
  const d = await api('/api/saved_runs', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      scanner_key: scannerKey,
      run_name: runName,
      payload,
      summary,
      ...extras,
    }),
  });
  return d.run;
}

async function _savedRunList(scannerKey) {
  const d = await api(`/api/saved_runs?scanner_key=${encodeURIComponent(scannerKey)}&limit=50`);
  return d.runs || [];
}

async function _savedRunListFiltered(scannerKey, filters={}) {
  const params = new URLSearchParams();
  if (scannerKey) params.set('scanner_key', scannerKey);
  const limit = Number(filters.limit || 50);
  params.set('limit', String(Math.max(1, Math.min(200, limit || 50))));
  if (filters.name) params.set('run_name', filters.name);
  if (filters.dateFrom) params.set('date_from', filters.dateFrom);
  if (filters.dateTo) params.set('date_to', filters.dateTo);
  if (filters.watchlistId) params.set('watchlist_id', filters.watchlistId);
  if (filters.symbol) params.set('symbol', filters.symbol);
  const d = await api(`/api/saved_runs?${params.toString()}`);
  return d.runs || [];
}

async function _savedRunLoad(runId) {
  const d = await api(`/api/saved_runs/${encodeURIComponent(runId)}`);
  return d.run;
}

function _savedRunsQueryPrefix(scannerKey) {
  return String(scannerKey || 'saved').replace(/[^a-z0-9_-]+/gi, '_');
}

function _savedRunsTable(rows, cols, emptyText='No saved runs yet') {
  if (!rows || !rows.length) return `<div style="color:var(--muted);font-size:12px;padding:8px">${_btEsc(emptyText)}</div>`;
  return `<div style="overflow:auto;max-height:320px"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr>${cols.map(c=>`<th style="text-align:left;padding:6px">${_btEsc(c.label)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${cols.map(c=>`<td style="padding:6px;vertical-align:top">${c.render ? c.render(r) : _btEsc(r[c.key] ?? '')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
}

function _savedRunsRenderControls(prefix, refreshFn, {name='', dateFrom='', dateTo='', limit=50}={}) {
  return `<div style="display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;align-items:end;margin-bottom:8px">
    <div style="grid-column:span 2"><label style="font-size:10px;color:var(--muted)">Run name contains</label><input id="${prefix}-filter-name" type="text" value="${_btEsc(name)}" style="width:100%"/></div>
    <div><label style="font-size:10px;color:var(--muted)">From</label><input id="${prefix}-filter-from" type="date" value="${_btEsc(dateFrom)}" style="width:100%"/></div>
    <div><label style="font-size:10px;color:var(--muted)">To</label><input id="${prefix}-filter-to" type="date" value="${_btEsc(dateTo)}" style="width:100%"/></div>
    <div><label style="font-size:10px;color:var(--muted)">Limit</label><input id="${prefix}-filter-limit" type="number" min="1" max="200" value="${_btEsc(limit)}" style="width:100%"/></div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:end;grid-column:span 2">
      <button class="btn btn-secondary" style="font-size:11px;padding:4px 8px" onclick="${refreshFn}()">↻ Refresh</button>
      <button class="btn btn-secondary" style="font-size:11px;padding:4px 8px" onclick="document.getElementById('${prefix}-saved-runs-box').style.display='none'">Hide</button>
    </div>
  </div>`;
}


function _savedRunsRenderControlsForBox(boxId, prefix, refreshFn, {name='', dateFrom='', dateTo='', limit=50}={}) {
  return `<div style="display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;align-items:end;margin-bottom:8px">
    <div><label style="font-size:10px;color:var(--muted);font-weight:800">From date</label><input id="${prefix}-filter-from" type="date" value="${_btEsc(dateFrom)}" style="width:100%"/></div>
    <div><label style="font-size:10px;color:var(--muted)">To</label><input id="${prefix}-filter-to" type="date" value="${_btEsc(dateTo)}" style="width:100%"/></div>
    <div style="grid-column:span 2"><label style="font-size:10px;color:var(--muted)">Run name contains</label><input id="${prefix}-filter-name" type="text" value="${_btEsc(name)}" style="width:100%"/></div>
    <div><label style="font-size:10px;color:var(--muted)">Limit</label><input id="${prefix}-filter-limit" type="number" min="1" max="200" value="${_btEsc(limit)}" style="width:100%"/></div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:end">
      <button class="btn btn-secondary" style="font-size:11px;padding:4px 8px" onclick="${refreshFn}()">Show runs</button>
      <button class="btn btn-secondary" style="font-size:11px;padding:4px 8px" onclick="document.getElementById('${boxId}').style.display='none'">Hide</button>
    </div>
  </div>`;
}
function _savedRunsLoadFromControls(prefix) {
  const name = document.getElementById(`${prefix}-filter-name`)?.value || '';
  const dateFrom = document.getElementById(`${prefix}-filter-from`)?.value || '';
  const dateTo = document.getElementById(`${prefix}-filter-to`)?.value || '';
  const limit = Number(document.getElementById(`${prefix}-filter-limit`)?.value || 50);
  return { name, dateFrom, dateTo, limit };
}

function _savedRunsRenderPicker(prefix, runs, onLoadFn, labelField='run_name') {
  const opts = runs.map(r => `<option value="${_btEsc(r.id || r.run_id || '')}">${_btEsc(r.run_name || r[labelField] || r.run_id || 'Unnamed run')}</option>`).join('');
  return `<div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin:8px 0 10px 0">
    <div style="min-width:280px;flex:1 1 420px"><label style="font-size:10px;color:var(--muted)">Load one saved run</label><select id="${prefix}-run-select" style="width:100%"><option value="">${runs.length ? 'Select a run…' : 'No saved runs'}</option>${opts}</select></div>
    <button class="btn btn-primary" style="padding:6px 10px" onclick="${onLoadFn}(document.getElementById('${prefix}-run-select')?.value)">Load selected</button>
  </div>`;
}

function _savedRunsBox(boxId, emptyText) {
  let box = document.getElementById(boxId);
  const preferredHostId = String(boxId || '').startsWith('wk-') ? 'wk-saved-pane' : (String(boxId || '').startsWith('oib-') ? 'oib-saved-pane' : 'oib-table');
  const preferredHost = document.getElementById(preferredHostId) || document.getElementById('oib-table') || document.getElementById('wk-result');
  if (!box) {
    box = document.createElement('div');
    box.id = boxId;
    box.style.cssText = 'margin-top:10px;border:1px solid var(--border);border-radius:10px;padding:10px;background:rgba(255,255,255,.03)';
  }
  if (preferredHost) {
    if (preferredHostId.endsWith('-saved-pane')) preferredHost.appendChild(box);
    else if (preferredHost.parentElement && box.previousSibling !== preferredHost) preferredHost.parentElement.insertBefore(box, preferredHost.nextSibling);
  }
  box.style.display = 'block';
  if (!box.dataset.emptyText) box.dataset.emptyText = emptyText || 'No saved runs yet.';
  return box;
}


async function _oibLoadWatchlists() {
  const sel = document.getElementById('oib-watchlist');
  if (!sel) return;
  try {
    await _oibLoadSettings();
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    const stored = (() => { try { return localStorage.getItem('oib_watchlist_id') || ''; } catch(e) { return ''; } })();
    sel.innerHTML = '<option value="">Default watchlist</option>' +
      wls.map(w => `<option value="${w.id}"${w.is_default ? ' selected' : ''}>${w.is_default ? '⭐ ' : ''}${esc(w.name)} (${w.symbol_count || 0})</option>`).join('');
    if (stored && [...sel.options].some(o => String(o.value) === String(stored))) sel.value = String(stored);
    _oibWatchlistChange();
  } catch(e) {
    console.warn('oib watchlist load:', e.message);
  }
}

function _oibWatchlistChange() {
  try { localStorage.setItem('oib_watchlist_id', document.getElementById('oib-watchlist')?.value || ''); } catch(e) {}
  _updateWlCount('oib-watchlist', 'oib-wl-count');
}


async function _oibSaveCurrentRun(runName) {
  try {
    const cur = _oibData || [];
    if (!cur.length) { addNotif('error', 'OI Buildup save failed', 'Run a fresh scan first.', 'OI Buildup'); return; }
    const defaultName = `OIBuildUp_${new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'')}`;
    const name = String(runName || document.getElementById('oib-save-name')?.value || defaultName).trim() || defaultName;
    const payload = { results: cur, date: _oibLastScan || null, st_days: parseInt(document.getElementById('oib-st-days')?.value || 3, 10), mt_days: parseInt(document.getElementById('oib-mt-days')?.value || 10, 10), lt_days: parseInt(document.getElementById('oib-lt-days')?.value || 30, 10), watchlist_id: document.getElementById('oib-watchlist')?.value || '', watchlist_name: document.getElementById('oib-watchlist')?.selectedOptions?.[0]?.text || 'Default watchlist' };
    const summary = { count: Array.isArray(cur) ? cur.length : 0, date: _oibLastScan || null, st_days: payload.st_days, mt_days: payload.mt_days, lt_days: payload.lt_days, watchlist: payload.watchlist_name };
    const saved = await _savedRunSave('oi_buildup', name, payload, summary, { watchlist_id: payload.watchlist_id || null });
    const stEl = document.getElementById('oib-status');
    if (stEl) stEl.innerHTML = `💾 Saved OI buildup run <b>${esc(name)}</b> · ${esc(payload.watchlist_name || 'Default watchlist')}`;
    addNotif('ok', 'OI buildup saved', `${name} · ${payload.watchlist_name || 'Default watchlist'}`, 'OI Buildup');
    return saved;
  } catch(e) {
    addNotif('error', 'OI Buildup save failed', e.message, 'OI Buildup');
  }
}

async function _oibViewSavedRuns() {
  const box = _savedRunsBox('oib-saved-runs-box', 'No saved OI buildup runs yet.');
  box.innerHTML = _savedRunsRenderControlsForBox('oib-saved-runs-box', 'oib', '_oibViewSavedRuns') + `<div style="font-size:12px;color:var(--muted)">Loading…</div>`;
  try {
    const f = _savedRunsLoadFromControls('oib');
    const runs = await _savedRunListFiltered('oi_buildup', { name: f.name, dateFrom: f.dateFrom, dateTo: f.dateTo, limit: f.limit });
    if (!runs.length) { box.innerHTML = _savedRunsRenderControlsForBox('oib-saved-runs-box', 'oib', '_oibViewSavedRuns', f) + '<div style="color:var(--muted);font-size:12px">No saved OI buildup runs matched the filters.</div>'; return; }
    box.innerHTML = _savedRunsRenderControlsForBox('oib-saved-runs-box', 'oib', '_oibViewSavedRuns', f) + _savedRunsRenderPicker('oib', runs, '_oibLoadSavedRun') + '<div style="overflow:auto;max-height:320px"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr><th style="text-align:left;padding:6px">Name</th><th style="text-align:left;padding:6px">Saved</th><th style="text-align:left;padding:6px">Watchlist</th><th style="text-align:left;padding:6px">Count</th><th style="text-align:left;padding:6px"></th></tr></thead><tbody>' +
      runs.map(r => `<tr><td style="padding:6px;font-weight:700">${esc(r.run_name || '')}</td><td style="padding:6px">${esc(r.updated_at || r.created_at || '')}</td><td style="padding:6px">${esc((r.summary && r.summary.watchlist) || r.watchlist_id || 'Default')}</td><td style="padding:6px">${esc((r.summary && r.summary.count) || r.result_count || 0)}</td><td style="padding:6px;text-align:right"><button class="btn btn-primary" style="font-size:11px;padding:4px 8px" onclick="_oibLoadSavedRun(${r.id})">Load</button></td></tr>`).join('') +
      '</tbody></table></div>';
  } catch(e) {
    box.innerHTML = `<div style="color:#ef4444;font-size:12px">${esc(e.message)}</div>`;
  }
}

async function _oibLoadSavedRun(runId) {

  try {
    const run = await _savedRunLoad(runId);
    const payload = run.payload || {};
    _oibData = payload.results || payload.items || [];
    _oibLastScan = payload.date || run.updated_at || run.created_at || null;
    if (document.getElementById('oib-st-days') && payload.st_days) document.getElementById('oib-st-days').value = payload.st_days;
    if (document.getElementById('oib-mt-days') && payload.mt_days) document.getElementById('oib-mt-days').value = payload.mt_days;
    if (document.getElementById('oib-lt-days') && payload.lt_days) document.getElementById('oib-lt-days').value = payload.lt_days;
    if (document.getElementById('oib-watchlist') && payload.watchlist_id) document.getElementById('oib-watchlist').value = String(payload.watchlist_id);
    _oibRender();
    const stEl = document.getElementById('oib-status');
    if (stEl) stEl.innerHTML = `📥 Loaded saved run <b>${esc(run.run_name || runId)}</b>`;
    addNotif('ok', 'OI buildup run loaded', run.run_name || String(runId), 'OI Buildup');
  } catch(e) {
    addNotif('error', 'OI buildup load failed', e.message, 'OI Buildup');
  }
}

// ── SR Scanner watchlist ─────────────────────────────────────────────────
function _srWatchlistChange() { _updateWlCount('sr-watchlist', 'sr-wl-count'); }

function _srGetWlId() { return document.getElementById('sr-watchlist')?.value || ''; }

// Patch runSRBreakout to include watchlist_id
var _origRunSRBreakout = typeof runSRBreakout === 'function' ? runSRBreakout : null;
// SR breakout watchlist handled in original function above

// Patch _runSRProximity to include watchlist_id
var _origRunSRProximity = typeof _runSRProximity === 'function' ? _runSRProximity : null;
// SR proximity watchlist handled in original function above

// ── Regime Scanner watchlist ──────────────────────────────────────────────
function _regimeWatchlistChange() { _updateWlCount('regime-watchlist', 'regime-wl-count'); }

var _origRunRegimeScan = typeof runRegimeScan === 'function' ? runRegimeScan : null;
function runRegimeScan() {
  const wlId = document.getElementById('regime-watchlist')?.value || '';
  const wlTxt = document.getElementById('regime-watchlist')?.selectedOptions?.[0]?.text || '';
  const st = document.getElementById('regime-status');
  const t0 = Date.now();
  let _timer = null;
  const regTbl = document.getElementById('regime-table');
  if (st) {
    st.innerHTML = `<span style="color:var(--muted)">⏳ Scanning${wlId?' '+wlTxt:''}…</span>`;
    _timer = setInterval(() => {
      if (st) st.innerHTML = `<span style="color:var(--muted)">⏳ Scanning${wlId?' '+wlTxt:''}… ${Math.round((Date.now()-t0)/1000)}s</span>`;
    }, 2000);
  }
  const scanUrl = '/regime/scan' + (wlId ? '?watchlist_id='+wlId : '');
  api(scanUrl, {method:'POST'}).then(r => {
    clearInterval(_timer);
    const ts = r.completed_at || new Date().toLocaleTimeString();
    const cnt = r.count || (r.results||[]).length || 0;
    if (st) st.innerHTML = `<span style="color:#22c55e">✅ ${cnt} symbols · ${ts}${wlId?' · '+wlTxt:''}</span>`;
    addNotif('ok', `🧭 Regime scan complete`, `${cnt} symbols${wlId?' · '+wlTxt:''}`, 'Regime');
    if (typeof loadRegimeResults === 'function') setTimeout(loadRegimeResults, 500);
  }).catch(e => {
    clearInterval(_timer);
    if (st) st.innerHTML = `<span style="color:#ef4444">❌ ${e.message}</span>`;
  });
}

// ── Wire tab open events ──────────────────────────────────────────────────
// Heatmap/SR/Regime watchlist loading now in main tab router

// ════════════════════════════════════════════════════════════════════════════
// CONVICTION SCORE + TRADE OUTCOME TRACKER
// ════════════════════════════════════════════════════════════════════════════

// ── Conviction widget in Add Trade form ──────────────────────────────────
var _jrnConvTimer = null;
function _jrnSymbolChanged(val) {
  const w = document.getElementById('jrn-conviction-widget');
  if (val && val.length >= 1) { if (w) w.style.display = 'block'; }
  const prevPanel = document.getElementById('entry-score-preview');
  if (prevPanel) prevPanel.innerHTML = '';
  clearTimeout(_jrnConvTimer);
  clearTimeout(_jrnOptCtxTimer);
  if (val && val.length >= 2) {
    _jrnOptCtxTimer = setTimeout(() => _jrnRefreshOptionContext(false), 550);
    _jrnConvTimer = setTimeout(() => _jrnLoadConviction(val.toUpperCase()), 900);
  }
}

async function _jrnLoadConviction(sym) {
  sym = sym || document.getElementById('jrn-add-symbol')?.value?.toUpperCase();
  const body = document.getElementById('jrn-conviction-body');
  if (body) body.innerHTML = `<span style="color:var(--muted)">AI Trade Analyst: combines journal score, regime, RS, IV, PCR, walls, earnings, and strategy selection. Select symbol and expiry to preview the best strategy and strikes.</span>`;
  await _jrnPreviewEntryScore(sym, document.getElementById('jrn-add-type')?.value || 'IC');
}

// ── Auto-snapshot conviction when trade is saved ─────────────────────────
// Hook into the Add Trade submit
var _origJrnSaveTrade = typeof jrnSaveTrade === 'function' ? jrnSaveTrade : null;
async function jrnSaveTrade() {
  // Call the original first
  if (typeof _jrnSaveTradeCore === 'function') {
    const result = await _jrnSaveTradeCore();
    if (result && result.id && window._lastConviction) {
      // Snapshot conviction for this trade
      const conv = window._lastConviction;
      api('/conviction/snapshot', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({trade_id: result.id, symbol: conv.symbol || document.getElementById('jrn-add-symbol')?.value})
      }).catch(()=>{});
      window._lastConviction = null;
    }
    return result;
  }
}

// ── Outcome Analytics Tab ────────────────────────────────────────────────
async function _jrnLoadOutcomeAnalytics() {
  const el = document.getElementById('jrn-outcome-content');
  if (!el) return;
  el.innerHTML = '<div style="color:var(--muted);padding:12px">⏳ Loading outcome data…</div>';
  try {
    const d = await api('/outcome/summary');
    if (d.message) { el.innerHTML = `<div style="color:var(--muted);padding:20px">${d.message}</div>`; return; }

    const _tbl = (title, rows, cols) => {
      if (!rows || !rows.length) return '';
      return `<div style="margin-bottom:18px">
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">${title}</div>
        <table class="data-tbl" style="font-size:11px;width:100%">
          <thead><tr>${cols.map(c=>`<th style="padding:5px 8px;text-align:${c.align||'left'}">${c.label}</th>`).join('')}</tr></thead>
          <tbody>${rows.map((r,i)=>`<tr style="background:${i%2?'var(--surface)':'var(--card)'}">
            ${cols.map(c=>`<td style="padding:5px 8px;text-align:${c.align||'left'}">${r[c.key]??'—'}</td>`).join('')}
          </tr>`).join('')}</tbody>
        </table></div>`;
    };

    // Conviction analysis
    const convRows = Object.entries(d.by_conviction||{}).map(([k,v]) => ({
      bucket: k, count: v.count, wins: v.wins,
      win_rate: v.win_rate != null ? v.win_rate+'%' : '—'
    }));

    // R-Multiple stats
    const rm = d.r_multiple || {};
    const rmHtml = rm.total ? `
      <div style="margin-bottom:18px">
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">R-Multiple Distribution (${rm.total} trades)</div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:12px">
          ${[['Avg R', rm.avg], ['Median R', rm.median], ['Best', rm.max], ['Worst', rm.min],
             ['≥ 1R wins', rm.above_1R], ['≤ -1R losses', rm.below_neg1R]].map(([l,v]) =>
            `<div style="background:var(--card);border:1px solid var(--border);border-radius:5px;padding:6px 10px;text-align:center">
              <div style="font-size:10px;color:var(--muted)">${l}</div>
              <div style="font-weight:700;color:${typeof v==='number'&&v>0?'#22c55e':typeof v==='number'&&v<0?'#ef4444':'var(--text)'}">${v??'—'}</div>
            </div>`
          ).join('')}
        </div>
      </div>` : '';

    // Grade and rules
    const gradeRows = Object.entries(d.by_grade||{}).map(([g,v]) => ({grade:g, count:v.count, win_rate: v.win_rate+'%'}));
    const rulesRows = Object.entries(d.by_rules||{}).map(([k,v]) => ({key:k, count:v.count, win_rate: v.win_rate+'%'}));

    // Top signals
    const sigRows = Object.entries(d.by_signal||{}).map(([sig,v]) => ({signal:sig, count:v.count, win_rate: v.win_rate+'%'}));

    el.innerHTML = rmHtml
      + _tbl('Win Rate by Conviction Score', convRows, [
          {key:'bucket', label:'Conviction Bucket'},
          {key:'count',  label:'Trades',   align:'center'},
          {key:'wins',   label:'Wins',     align:'center'},
          {key:'win_rate',label:'Win Rate',align:'center'},
        ])
      + _tbl('Win Rate by Setup Grade', gradeRows, [
          {key:'grade',    label:'Grade'},
          {key:'count',    label:'Trades', align:'center'},
          {key:'win_rate', label:'Win Rate', align:'center'},
        ])
      + _tbl('Followed Rules vs Broke Rules', rulesRows, [
          {key:'key',      label:''},
          {key:'count',    label:'Trades', align:'center'},
          {key:'win_rate', label:'Win Rate', align:'center'},
        ])
      + _tbl('Performance by Active Signal', sigRows, [
          {key:'signal',   label:'Signal at Entry'},
          {key:'count',    label:'Trades', align:'center'},
          {key:'win_rate', label:'Win Rate', align:'center'},
        ]);
  } catch(e) {
    el.innerHTML = `<div style="color:#ef4444;padding:12px">Error: ${e.message}</div>`;
  }
}

// ════════════════════════════════════════════════════════════════════════════
// TRADE PLANNER — Single-Symbol Deep Scan
// ════════════════════════════════════════════════════════════════════════════

async function _plannerLoadWatchlists() {
  const sel = document.getElementById('planner-watchlist');
  if (!sel) return;
  try {
    const d = await api('/watchlists/');
    const wls = d.watchlists || [];
    sel.innerHTML = '<option value="">Default (symbols table)</option>' +
      wls.map(w => `<option value="${w.id}"${w.is_default?' selected':''}>${w.is_default?'⭐ ':''}${w.name} (${w.symbol_count})</option>`).join('');
    _plannerLoadSymbols();
  } catch(e) {}
}

async function _plannerLoadSymbols() {
  const wlId = document.getElementById('planner-watchlist')?.value || '';
  const sel  = document.getElementById('planner-symbol-select');
  if (!sel) return;
  try {
    const d = await api(`/planner/symbols${wlId ? '?watchlist_id='+wlId : ''}`);
    const syms = d.symbols || [];
    sel.innerHTML = '<option value="">— pick from list —</option>' +
      syms.map(s => `<option value="${s}">${s}</option>`).join('');
  } catch(e) {}
}

async function _plannerRun() {
  const sym = (document.getElementById('planner-symbol')?.value ||
               document.getElementById('planner-symbol-select')?.value || '').trim().toUpperCase();
  if (!sym) { alert('Select or type a symbol first'); return; }

  const btn    = document.getElementById('btn-planner-run');
  const status = document.getElementById('planner-status');
  const res    = document.getElementById('planner-results');
  if (btn) btn.disabled = true;
  if (status) status.textContent = `⏳ Running all scanners for ${sym}…`;
  if (res) res.innerHTML = `<div style="padding:20px;color:var(--muted);text-align:center">
    ⏳ Scanning ${sym} across all 5 scanners in parallel… typically 15–40s</div>`;

  const t0 = Date.now();
  const timer = setInterval(() => {
    if (status) status.textContent = `⏳ Scanning ${sym}… ${Math.round((Date.now()-t0)/1000)}s`;
  }, 2000);

  try {
    const d = await api(`/planner/scan/${sym}`);
    clearInterval(timer);
    if (btn) btn.disabled = false;
    if (status) status.textContent = `✅ ${sym} scanned in ${d.elapsed_s}s`;
    if (res) res.innerHTML = _plannerRenderResult(d);
  } catch(e) {
    clearInterval(timer);
    if (btn) btn.disabled = false;
    if (status) status.textContent = `❌ Error: ${e.message}`;
    if (res) res.innerHTML = `<div style="color:#ef4444;padding:16px">Error: ${e.message}</div>`;
  }
}

function _plannerRenderResult(d) {
  const conv  = d.conviction || {};
  const score = conv.score ?? '—';
  const label = conv.label  || '';
  const scans = d.scanners  || {};

  const scoreColor = score >= 7 ? '#22c55e' : score >= 5 ? '#818cf8' : score >= 3 ? '#f59e0b' : '#94a3b8';

  // ── Conviction hero card ──
  const raw = conv.raw_score ?? score;
  const rawMax = conv.raw_max ?? 50;
  const nScanned = conv.scanners_scored ?? '?';
  const heroHtml = `
    <div style="background:linear-gradient(135deg,rgba(99,102,241,.12),rgba(99,102,241,.04));
                border:2px solid rgba(99,102,241,.25);border-radius:10px;padding:16px 20px;margin-bottom:16px;
                display:flex;align-items:center;gap:20px;flex-wrap:wrap">
      <div style="text-align:center;min-width:70px">
        <div style="font-size:48px;font-weight:900;color:${scoreColor};line-height:1">${score}</div>
        <div style="font-size:11px;color:var(--muted)">/ 10</div>
      </div>
      <div style="flex:1;min-width:200px">
        <div style="font-size:20px;font-weight:700;color:${scoreColor};margin-bottom:4px">${label}</div>
        <div style="font-size:12px;color:var(--text2);margin-bottom:3px">${d.symbol} · scanned at ${d.scanned_at} · ${d.elapsed_s}s</div>
        <div style="font-size:11px;color:var(--muted);margin-bottom:4px">
          Raw: ${raw} / ${rawMax} across ${nScanned} scanners (normalized to /10)
        </div>
        <div style="font-size:11px;color:${scoreColor}">
          ${score >= 7 ? '🔥 Strong multi-signal confirmation — high-quality setup' :
            score >= 5 ? '✅ Good setup — proceed with standard sizing' :
            score >= 3 ? '👀 Moderate — consider waiting for more alignment' :
                         '⚠ Weak signals — high-risk entry, consider passing'}
        </div>
      </div>
      <div>
        <button onclick="_plannerAddToJournal('${d.symbol}')"
          style="padding:9px 18px;background:#22c55e;border:none;border-radius:6px;color:#fff;
                 font-size:13px;font-weight:700;cursor:pointer">➕ Plan Trade</button>
      </div>
    </div>`;

  // ── Scanner result cards ──
  const scannerDefs = [
    { key: 'oi_buildup',    icon: '📈', title: 'OI Buildup',           maxScore: 10 },
    { key: 'regime',        icon: '🧭', title: 'Market Regime',        maxScore: 8  },
    { key: 'rsi_mtf',       icon: '📡', title: 'RSI Multi-Timeframe / interval',  maxScore: 8  },
    { key: 'sr',            icon: '📐', title: 'S/R Breakout',         maxScore: 8  },
    { key: 'trend_exhaustion', icon: '🌡️', title: 'Trend Exhaustion',   maxScore: 10 },
    { key: 'institutional', icon: '🏦', title: 'Institutional Setup',  maxScore: 10 },
    { key: 'earnings',      icon: '📅', title: 'Earnings',             maxScore: 10 },
  ];

  const cards = scannerDefs.map(def => {
    const s = scans[def.key] || {};
    const status = s.status || 'missing';
    const sc = s.score ?? null;
    const detail = s.detail || '';

    const isSkipped = s.skipped || false;
    const statusColor = isSkipped ? '#94a3b8'
                       : status === 'found'      ? '#22c55e'
                       : status === 'no_setup'   ? '#f59e0b'
                       : status === 'no_data'    ? '#94a3b8'
                       : status === 'error'      ? '#ef4444'
                       : status === 'no_db_data' ? '#64748b'
                       : '#94a3b8';

    const statusLabel = isSkipped              ? '⏭ Skipped (not in DB)'
                       : status === 'found'     ? '✅ Signal Found'
                       : status === 'no_setup'  ? '⚪ No Setup Detected'
                       : status === 'no_data'   ? '📭 No Data'
                       : status === 'no_db_data'? '📭 No DB data (fetch OI first)'
                       : status === 'error'     ? '❌ Error'
                       : '— Missing';

    // Build extra detail rows per scanner type
    let extraHtml = '';
    if (def.key === 'oi_buildup' && status === 'found') {
      extraHtml = `<div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap">
        ${[['OI Growth', (s.oi_growth_pct??0) >= 0 ? '+'+s.oi_growth_pct+'%' : s.oi_growth_pct+'%'],
           ['Calls %', s.call_pct+'%'], ['PCR', s.pcr], ['Bias', s.bias],
           ['Days', s.days_of_data+'d']].map(([l,v]) =>
          `<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
            <span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`
        ).join('')}</div>`;
    }
    if (def.key === 'regime' && status === 'found') {
      extraHtml = `<div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap">
        ${[['Regime', s.regime], ['Bias', s.bias], ['Confidence', s.confidence+'%']].map(([l,v]) =>
          `<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
            <span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`
        ).join('')}</div>
        ${(s.signals||[]).length ? `<div style="margin-top:4px;font-size:10px;color:var(--muted)">
          Signals: ${s.signals.join(' · ')}</div>` : ''}`;
    }
    if (def.key === 'regime' && (status === 'found' || status === 'no_setup')) {
      const emaStack = [
        ['200',s.above_ema200,'#22c55e'],['50',s.above_ema50,'#22c55e'],['20',s.above_ema20,'#22c55e']
      ].map(([n,v,c])=>`<span title="Above EMA${n}" style="font-size:11px;color:${v?c:'#94a3b8'}">${v?'●':'○'}</span>`).join('');
      extraHtml = `<div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;align-items:center">
        ${[['Price', '$'+(s.price??'—')], ['RSI', s.rsi??'—'], ['5d Δ', (s.price_5d_chg??0)>=0?'+'+(s.price_5d_chg??0)+'%':(s.price_5d_chg??0)+'%']].map(([l,v]) =>
          `<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
            <span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`).join('')}
        <span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
          <span style="color:var(--muted)">EMA:</span> ${emaStack}</span>
        ${s.ema200?`<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
          <span style="color:var(--muted)">EMA200:</span> <b>$${s.ema200}</b></span>`:''}
      </div>
      ${(s.signals||[]).length ? `<div style="margin-top:4px;font-size:10px;color:var(--muted)">${s.signals.join(' · ')}</div>` : ''}`;
    }
    if (def.key === 'rsi_mtf' && (status === 'found' || status === 'no_setup')) {
      extraHtml = `<div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap">
        ${[['Setup', s.setup], ['Daily RSI Δ', (s.daily_rsi_delta??0) >= 0 ? '+'+s.daily_rsi_delta : s.daily_rsi_delta],
           ['Intra RSI Δ', (s.intra_rsi_delta??0) >= 0 ? '+'+s.intra_rsi_delta : s.intra_rsi_delta]].map(([l,v]) =>
          `<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
            <span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`
        ).join('')}</div>`;
    }
    if (def.key === 'sr' && status === 'found') {
      const nb = s.nearest_level;
      const tb = s.top_breakout;
      extraHtml = `<div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap">
        ${[['Breakouts', s.breakouts], ['Nearby Levels', s.nearby_levels]].map(([l,v]) =>
          `<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
            <span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`
        ).join('')}</div>
        ${nb ? `<div style="margin-top:4px;font-size:10px;color:var(--muted)">
          Nearest: ${nb.sr_type} @ ${nb.mid?.toFixed(2)} (${nb.dist_pct?.toFixed(1)}% away · strength ${nb.strength})</div>` : ''}`;
    }
    if (def.key === 'earnings' && status === 'found') {
      const dte   = s.days_to_earnings;
      const dteStr = dte == null ? '—' : dte >= 0 ? `In ${dte}d` : `${Math.abs(dte)}d ago`;
      const dteColor = (dte != null && dte >= 0 && dte <= 7) ? '#ef4444' : (dte != null && dte <= 21 && dte >=0) ? '#f59e0b' : 'var(--text2)';
      const surprColor = (s.last_surprise_pct??0) > 5 ? '#22c55e' : (s.last_surprise_pct??0) < -5 ? '#ef4444' : 'var(--text2)';
      const rxnColor = Math.abs(s.earn_reaction_pct??0) > 8 ? '#f59e0b' : 'var(--text2)';
      extraHtml = `<div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;align-items:center">
        <span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
          <span style="color:var(--muted)">Next:</span> <b style="color:${dteColor}">${s.next_earn_date||'—'} (${dteStr})</b></span>
        <span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
          <span style="color:var(--muted)">Surprise:</span> <b style="color:${surprColor}">${s.last_surprise_pct != null ? (s.last_surprise_pct > 0 ? '+' : '') + s.last_surprise_pct + '%' : '—'}</b></span>
        <span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
          <span style="color:var(--muted)">Beat streak:</span> <b>${s.surprise_streak||0}×</b></span>
        <span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
          <span style="color:var(--muted)">Avg move:</span> <b style="color:${rxnColor}">${s.earn_reaction_pct != null ? (s.earn_reaction_pct > 0 ? '+' : '') + s.earn_reaction_pct + '%' : '—'}</b></span>
        ${s.eps_actual != null ? `<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
          <span style="color:var(--muted)">Last EPS:</span> <b>$${s.eps_actual}</b> vs est <b>$${s.eps_estimate||'—'}</b></span>` : ''}
      </div>
      ${(s.reasons||[]).length ? `<div style="margin-top:4px;font-size:10px;color:#f59e0b">${s.reasons.join(' · ')}</div>` : ''}`;
    }
    if (def.key === 'institutional' && status === 'found') {
      const ema = s.ema_stack || {};
      const emaDots = ['above200','above50','above20'].map(k =>
        `<span style="color:${ema[k]?'#22c55e':'#94a3b8'}">${ema[k]?'●':'○'}</span>`
      ).join('');
      extraHtml = `<div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;align-items:center">
        ${[['Type', s.breakout_type||'—'], ['Vol Surge', (s.vol_surge||0).toFixed(1)+'×'],
           ['Base Width', (s.base_tight_pct||0).toFixed(1)+'%'], ['RSI', s.rsi?.toFixed(0)||'—']].map(([l,v]) =>
          `<span style="font-size:10px;background:rgba(255,255,255,.06);padding:2px 6px;border-radius:3px">
            <span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`
        ).join('')}
        <span style="font-size:11px" title="Above EMA 200/50/20">${emaDots}</span>
      </div>`;
    }

    const scMax = s.max || def.maxScore;
    const barW = (sc != null && !isSkipped) ? Math.round(sc / scMax * 100) : 0;
    const barColor = sc >= scMax * 0.7 ? '#22c55e' : sc >= scMax * 0.4 ? '#818cf8' : '#f59e0b';
    const cardOpacity = isSkipped ? 'opacity:.5' : '';
    const edgeLine = (s.edge_score != null || s.composite_score != null || s.native_score != null) ? `<div style="margin-top:4px;font-size:10px;color:var(--muted);line-height:1.45">`
      + `Final ${fmt(s.final_score ?? s.score,0)}/100 · Native ${fmt(s.native_score,0)} · Comp ${fmt(s.composite_score ?? s.edge_score,0)} · RS ${fmt(s.rs_score,0)} · Vol ${fmt(s.vol_score,0)} · Sector ${fmt(s.sector_score_raw ?? s.sector_score,0)} · Inst ${fmt(s.institutional_score_raw ?? s.institutional_score,0)} · EM ${fmt(s.expected_move_score_raw ?? s.expected_move_score,0)} · Age ${fmt(s.trend_age,0)}`
      + `</div>` : '';

    return `<div style="background:var(--card);border:1px solid var(--border);border-radius:8px;
                         padding:12px 14px;margin-bottom:10px;${cardOpacity}">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px">
        <span style="font-size:16px">${def.icon}</span>
        <span style="font-weight:700;font-size:13px">${def.title}</span>
        <span style="margin-left:auto;font-size:11px;color:${statusColor};font-weight:600">${statusLabel}</span>
        ${(sc != null && !isSkipped) ? `<span style="font-size:18px;font-weight:800;color:${barColor};min-width:32px;text-align:right">${sc}</span>
          <span style="font-size:10px;color:var(--muted)">/${scMax}</span>` : ''}
      </div>
      ${(sc != null && !isSkipped) ? `<div style="height:4px;background:var(--bg);border-radius:2px;margin-bottom:6px">
        <div style="height:4px;width:${barW}%;background:${barColor};border-radius:2px;transition:width .4s"></div>
      </div>` : ''}
      <div style="font-size:11px;color:var(--text2)">${detail}</div>
      ${extraHtml}
      ${edgeLine}
    </div>`;
  }).join('');

  return heroHtml + `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:10px">${cards}</div>`;
}

function _plannerAddToJournal(sym) {
  // Pre-fill Add Trade form with this symbol and switch to journal
  const symEl = document.getElementById('jrn-add-symbol');
  if (symEl) { symEl.value = sym; _jrnSymbolChanged(sym); }
  // Switch to journal tab
  _setActiveTab('journal');
  jrnTab('add');
}

// ── Tab router entry ──────────────────────────────────────────────────────
// (added to main tab router in the tab wiring section below)

// ════════════════════════════════════════════════════════════════════════════
// CFTC COT + SCHWAB COMBINED FUTURES SENTIMENT
// ════════════════════════════════════════════════════════════════════════════

async function _fetchCOTNow(force) {
  const st = document.getElementById('cot-fetch-status');
  if (st) st.innerHTML = '<span style="color:var(--muted)">⏳ Fetching CFTC COT via public API… (may take 30s for 2 years)</span>';
  try {
    const d = await api('/cot/fetch', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({years: 2, force: !!force})
    });
    if (!d.ok && !d.stored) {
      const debugBtn = `<button onclick="window.open('/cot/test','_blank')" style="margin-left:8px;font-size:10px;padding:2px 6px;border-radius:3px;background:rgba(239,68,68,.2);border:1px solid #ef4444;color:#ef4444;cursor:pointer">🔍 Test Connectivity</button>`;
      if (st) st.innerHTML = `<span style="color:#ef4444">❌ ${d.message}${debugBtn}</span>`;
      return;
    }
    if (d.skipped) {
      if (st) st.innerHTML = `<span style="color:#f59e0b">⏭ ${d.message}
        <button onclick="_fetchCOTNow(true)" style="margin-left:8px;font-size:10px;padding:2px 6px;
          border-radius:3px;background:rgba(99,102,241,.2);border:1px solid #818cf8;color:#818cf8;cursor:pointer">
          Force refresh</button></span>`;
    } else {
      const errs = (d.errors||[]).length > 0 ? ` ⚠ ${d.errors.join(', ')}` : '';
      if (st) st.innerHTML = `<span style="color:#22c55e">✅ ${d.message}${errs}</span>`;
      _loadAllCOTSignals();
    }
  } catch(e) {
    if (st) st.innerHTML = `<span style="color:#ef4444">❌ ${e.message}</span>`;
  }
}

function _cotScoreColor(s) {
  return s >= 7.5 ? '#22c55e' : s >= 6 ? '#86efac' : s >= 4.5 ? '#94a3b8' : s >= 3 ? '#fca5a5' : '#ef4444';
}

function _cotIndexBar(idx) {
  if (idx == null) return '';
  const pct = Math.min(100, Math.max(0, idx));
  // Colored zones: 0-25 red, 25-40 amber, 40-60 grey, 60-75 light green, 75-100 green
  const color = pct >= 75 ? '#22c55e' : pct >= 60 ? '#86efac' : pct <= 25 ? '#ef4444' : pct <= 40 ? '#f59e0b' : '#94a3b8';
  return `<div style="display:flex;align-items:center;gap:6px;margin-top:4px">
    <span style="font-size:9px;color:var(--muted);width:22px;text-align:right">0</span>
    <div style="flex:1;height:8px;background:var(--bg);border-radius:4px;position:relative">
      <div style="position:absolute;left:0;height:100%;width:${pct}%;background:${color};border-radius:4px;transition:width .4s"></div>
      <div style="position:absolute;top:-3px;left:${pct}%;transform:translateX(-50%);
                  width:2px;height:14px;background:${color};border-radius:1px"></div>
    </div>
    <span style="font-size:9px;color:var(--muted);width:22px">100</span>
    <span style="font-size:11px;font-weight:700;color:${color};min-width:35px">${pct.toFixed(1)}</span>
  </div>`;
}

function _renderCOTSignal(d) {
  if (!d || !d.contract) return '<div style="color:var(--muted);font-size:11px">No signal data</div>';

  const sc      = d.combined_score ?? 5;
  const scColor = _cotScoreColor(sc);
  const sw      = d.schwab || {};
  const cot     = d.cot   || {};
  const latest  = cot.latest || {};
  const cotIdx  = cot.cot_index;
  const hasSwab = (sw.data_points ?? 0) > 0;
  const hasCot  = cot.found === true;

  // ── Schwab OI signal ──
  const swHtml = hasSwab ? `
    <div style="background:var(--surface);border-radius:6px;padding:8px 10px">
      <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">
        📊 Schwab Daily OI (last 14d)
      </div>
      <div style="font-size:12px;color:var(--text2);margin-bottom:3px">${sw.signal}</div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        ${[['OI Trend',sw.oi_trend_pct!=null?(sw.oi_trend_pct>=0?'+':'')+sw.oi_trend_pct+'%':'—'],
           ['Price Trend',sw.price_trend_pct!=null?(sw.price_trend_pct>=0?'+':'')+sw.price_trend_pct+'%':'—'],
           ['Data pts',sw.data_points+'d']].map(([l,v]) =>
          `<span style="font-size:10px"><span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`
        ).join('')}
      </div>
    </div>` : `<div style="background:var(--surface);border-radius:6px;padding:8px 10px;color:var(--muted);font-size:11px">
      📭 No Schwab OI data — run ⚡ Fetch OI Now in Scheduler</div>`;

  // ── COT positioning ──
  const cotHtml = hasCot ? `
    <div style="background:var(--surface);border-radius:6px;padding:8px 10px">
      <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">
        📋 CFTC COT Report (week of ${cot.report_date||'—'})
      </div>
      <div style="display:flex;gap:6px;align-items:center;margin-bottom:6px;flex-wrap:wrap">
        <span style="font-size:12px;font-weight:700;color:${_cotScoreColor(cotIdx >= 60 ? 8 : cotIdx <= 40 ? 2 : 5)}">${cot.direction}</span>
        <span style="font-size:11px;color:var(--text2)">${cot.extreme}</span>
        <span style="font-size:10px;color:var(--muted)">${cot.trend_dir} (4w)</span>
      </div>
      <div style="margin-bottom:6px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px">
          <span style="font-size:10px;color:var(--muted)">COT Index (52W) — large spec net vs past year</span>
          <span style="font-size:10px;font-style:italic;color:${cotIdx>=90?'#f59e0b':cotIdx<=10?'#22c55e':cotIdx>=75?'#22c55e':cotIdx<=25?'#ef4444':'#94a3b8'}">
            ${cotIdx>=90?'⚠ Crowded long (fade risk)':cotIdx<=10?'🔥 Extreme short (squeeze risk)':cotIdx>=75?'Bullish positioning':cotIdx<=25?'Bearish positioning':'Neutral'}
          </span>
        </div>
        <div style="display:flex;align-items:center;gap:5px">
          <span style="font-size:9px;color:#ef4444">0 Bear</span>
          ${_cotIndexBar(cotIdx)}
          <span style="font-size:9px;color:#22c55e">Bull 100</span>
        </div>
        <div style="font-size:9px;color:var(--muted);margin-top:2px;font-style:italic">
          Note: COT is a CONTRARIAN indicator at extremes. Below 10 = historically bullish (overcrowded shorts get squeezed).
          Above 90 = crowded long (risk of long liquidation selloff).
        </div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;font-size:10px;margin-top:4px">
        ${[
          ['Large Spec Net', (latest.lspec_net??0)>=0?'+'+(latest.lspec_net??0).toLocaleString():(latest.lspec_net??0).toLocaleString()],
          ['WoW Change', (cot.lspec_chg??0)>=0?'+'+(cot.lspec_chg??0).toLocaleString():(cot.lspec_chg??0).toLocaleString()],
          ['Comm Net (hedgers)', (latest.comm_net??0)>=0?'+'+(latest.comm_net??0).toLocaleString():(latest.comm_net??0).toLocaleString()],
          ['Small Spec Net', (latest.sspec_net??0)>=0?'+'+(latest.sspec_net??0).toLocaleString():(latest.sspec_net??0).toLocaleString()],
          ['Total OI', (latest.open_interest??0).toLocaleString()],
        ].map(([l,v]) =>
          `<span><span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`
        ).join('')}
      </div>
      <div style="font-size:9px;color:var(--muted);margin-top:4px;border-top:1px solid var(--border);padding-top:4px">
        <b>Large Specs</b> = hedge funds/CTAs (trend followers — contrarian at extremes) ·
        <b>Commercials</b> = hedgers (usually opposite to specs, natural contrarian) ·
        <b>Small Specs</b> = retail (weakest signal, often wrong at extremes)
      </div>
    </div>` : `<div style="background:var(--surface);border-radius:6px;padding:8px 10px;color:var(--muted);font-size:11px">
      📭 No COT data — click <b>📊 Fetch CFTC COT</b> in Scheduler tab</div>`;

  // ── Interpretation note ──
  const interpNotes = {
    'ES': '/ES large spec positioning reflects broad equity market sentiment. Extreme longs (>90) historically precede corrections; extreme shorts (<10) often signal bottoms.',
    'NQ': '/NQ tracks tech-heavy NASDAQ. Positioning often mirrors /ES but amplified; watch for divergences.',
    'RTY': '/RTY small-caps lead risk-on cycles. Large spec extremes here are strong contrarian signals.',
    'GC': '/GC gold positioning: extreme commercial shorts (hedgers) at lows = near bullish turning points.',
    'CL': '/CL crude: commercial hedger net flips are historically accurate supply/demand signals.',
    'ZN': '/ZN T-note: spec longs = bond bulls (rate-cut bets). Informs equity market rate sensitivity.',
  };
  const sym = (d.contract||'').replace('/','');
  const note = interpNotes[sym] || '';

  return `
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--border)">
      <div style="text-align:center;min-width:54px">
        <div style="font-size:36px;font-weight:900;color:${scColor};line-height:1">${sc.toFixed(1)}</div>
        <div style="font-size:10px;color:var(--muted)">/10</div>
      </div>
      <div>
        <div style="font-size:18px;font-weight:700;color:${scColor}">${d.label}</div>
        <div style="font-size:11px;color:var(--text2)">${d.contract} · Combined Schwab OI + CFTC COT</div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
      ${swHtml}
      ${cotHtml}
    </div>
    ${note ? `<div style="font-size:10px;color:var(--muted);border-top:1px solid var(--border);padding-top:6px;margin-top:2px">
      💡 ${note}</div>` : ''}`;
}

function _renderAllCOTSignals(data) {
  const signals = data.signals || {};
  const contractNames = {'/ES':'S&P 500','/NQ':'NASDAQ','/RTY':'Russell 2K','/GC':'Gold','/CL':'Crude','/ZN':'T-Note'};
  const cards = Object.entries(signals).map(([sym, d]) => {
    const sc    = d.combined_score ?? 5;
    const color = _cotScoreColor(sc);
    const cot   = d.cot || {};
    const idx   = cot.cot_index;
    const sw    = d.schwab || {};
    const hasSw = (sw.data_points ?? 0) > 0;
    const hasCot = cot.found === true;
    return `<div style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:10px;cursor:pointer"
                 onclick="document.getElementById('dash-cot-symbol').value='${sym.replace('/','')}'">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
        <span style="font-weight:800;font-size:13px">${sym}</span>
        <span style="font-size:10px;color:var(--muted)">${contractNames[sym]||''}</span>
      </div>
      <div style="font-size:22px;font-weight:900;color:${color};line-height:1.1">${sc.toFixed(1)}</div>
      <div style="font-size:11px;color:${color};margin-bottom:4px">${d.label||'—'}</div>
      ${hasSw && sw.oi_trend_pct != null ? `<div style="font-size:10px;color:var(--muted)">OI: <b>${sw.oi_trend_pct>=0?'+':''}${sw.oi_trend_pct}%</b></div>` : ''}
      ${hasCot && idx != null ? `
        <div style="margin-top:4px;height:4px;background:var(--bg);border-radius:2px">
          <div style="height:4px;width:${Math.min(100,idx)}%;background:${color};border-radius:2px"></div>
        </div>
        <div style="font-size:9px;color:var(--muted);margin-top:1px">COT Index ${idx.toFixed(0)}/100 · ${cot.direction||''}</div>` : ''}
    </div>`;
  }).join('');
  return `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px">${cards}</div>
    <div style="font-size:10px;color:var(--muted);margin-top:6px">Click any card for detail · Generated ${(data.generated_at||'').slice(0,16)}</div>`;
}

async function _loadCOTSignal() {
  const sym = document.getElementById('dash-cot-symbol')?.value || 'ES';
  const el  = document.getElementById('dash-cot-result');
  if (!el) return;
  el.innerHTML = '<div style="color:var(--muted);font-size:11px">⏳ Loading…</div>';
  try {
    const d = await api(`/cot/signal/${sym}`);
    el.innerHTML = _renderCOTSignal(d);
  } catch(e) {
    el.innerHTML = `<div style="color:var(--muted);font-size:11px">No COT data — click <b>📊 Fetch CFTC COT</b> in Scheduler tab first.</div>`;
  }
}

async function _loadAllCOTSignals() {
  const el = document.getElementById('dash-cot-result');
  if (!el) return;
  el.innerHTML = '<div style="color:var(--muted);font-size:11px">⏳ Loading all signals…</div>';
  try {
    const d = await api('/cot/all_signals');
    el.innerHTML = _renderAllCOTSignals(d);
  } catch(e) {
    el.innerHTML = `<div style="color:var(--muted);font-size:11px">No COT data — fetch first.</div>`;
  }
}

// Load COT alongside futures on dashboard open
const _origLoadDashFutures = typeof _loadDashFutures === 'function' ? _loadDashFutures : null;

// ════════════════════════════════════════════════════════════════════════════
// MARKET CONTEXT PANEL — enriches GEX Plan + Weekly Plan
// Options OI + Futures COT + Schwab OI holistic view
// ════════════════════════════════════════════════════════════════════════════

function _renderContextPanel(ctx) {
  if (!ctx) return '';
  const esc = (v) => String(v ?? '').replace(/[&<>"]/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[s]));
  const hs     = ctx.holistic_score ?? 5;
  const hsColor= hs >= 7 ? '#22c55e' : hs >= 5.5 ? '#86efac' : hs >= 4 ? '#94a3b8' : hs >= 2.5 ? '#fca5a5' : '#ef4444';
  const hasFut = ctx.has_futures_data;
  const hasCot = ctx.has_cot_data;
  const hasOI  = ctx.has_options_data;
  const opt    = ctx.options || {};
  const fut    = ctx.futures_signal || {};
  const cot    = fut.cot || {};
  const sw     = fut.schwab || {};
  const cotIdx = cot.cot_index;

  // ── Options OI mini-panel ──────────────────────────────────────────────
  const callWalls = (opt.call_walls || []).slice(0,3).map(w =>
    `<span style="background:rgba(34,197,94,.1);color:#22c55e;font-size:10px;padding:1px 5px;border-radius:3px">
      C$${w.strike} (${(w.oi/1000).toFixed(0)}K)</span>`).join(' ');
  const putWalls  = (opt.put_walls  || []).slice(0,3).map(w =>
    `<span style="background:rgba(239,68,68,.1);color:#ef4444;font-size:10px;padding:1px 5px;border-radius:3px">
      P$${w.strike} (${(w.oi/1000).toFixed(0)}K)</span>`).join(' ');

  const optHtml = hasOI ? `
    <div style="background:rgba(99,102,241,.06);border:1px solid rgba(99,102,241,.2);border-radius:6px;padding:8px 10px">
      <div style="font-size:10px;font-weight:700;color:#818cf8;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px">📈 Options OI (${ctx.equity_sym})</div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:4px">
        ${[
          ['PCR', opt.pcr ?? '—'],
          ['Calls%', (opt.call_pct ?? 0) + '%'],
          ['OI 5d Trend', opt.oi_trend_pct != null ? (opt.oi_trend_pct >= 0 ? '+' : '') + opt.oi_trend_pct + '%' : '—'],
          ['Bias', opt.bias || '—'],
          ['Spot', opt.spot_est ? '$' + opt.spot_est : '—'],
        ].map(([l,v]) => `<span style="font-size:10px"><span style="color:var(--muted)">${l}:</span> <b>${v}</b></span>`).join('')}
      </div>
      <div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center">
        <span style="font-size:9px;color:#22c55e;margin-right:2px">🛡 Call walls:</span>${callWalls || '<span style="font-size:10px;color:var(--muted)">none</span>'}
        <span style="font-size:9px;color:#ef4444;margin-left:6px;margin-right:2px">⚡ Put walls:</span>${putWalls || '<span style="font-size:10px;color:var(--muted)">none</span>'}
      </div>
      <div style="font-size:9px;color:var(--dim,#64748b);margin-top:5px">${esc(opt.source || 'weekly aggregate')} · ${esc((opt.expirations||[]).slice(0,5).join(', '))}${opt.target_expiry ? ' → ' + esc(opt.target_expiry) : ''}</div>
    </div>` : `<div style="background:var(--surface);border-radius:6px;padding:8px 10px;color:var(--muted);font-size:10px">📭 No options OI in DB for ${ctx.equity_sym}</div>`;

  // ── Futures mini-panel ─────────────────────────────────────────────────
  const futHtml = (hasFut || hasCot) ? `
    <div style="background:rgba(99,102,241,.06);border:1px solid rgba(99,102,241,.2);border-radius:6px;padding:8px 10px">
      <div style="font-size:10px;font-weight:700;color:#818cf8;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px">🎯 Futures (${ctx.futures_contract})</div>
      ${hasFut ? `<div style="font-size:11px;color:var(--text2);margin-bottom:3px">${sw.signal || '—'}</div>
        <div style="display:flex;gap:8px;font-size:10px">
          <span><span style="color:var(--muted)">OI:</span> <b>${sw.oi_trend_pct != null ? (sw.oi_trend_pct >= 0 ? '+' : '') + sw.oi_trend_pct + '%' : '—'}</b></span>
          <span><span style="color:var(--muted)">Price:</span> <b>${sw.price_trend_pct != null ? (sw.price_trend_pct >= 0 ? '+' : '') + sw.price_trend_pct + '%' : '—'}</b></span>
        </div>` : '<div style="font-size:10px;color:var(--muted)">No Schwab OI data</div>'}
      ${hasCot && cotIdx != null ? (() => {
        // Contrarian interpretation: extremes flip the signal
        const isExtremeLong  = cotIdx >= 90;
        const isExtremeShort = cotIdx <= 10;
        const isBull = cotIdx >= 60;
        const barColor = cotIdx >= 75 ? '#22c55e' : cotIdx <= 25 ? '#ef4444' : '#94a3b8';
        const chg = cot.lspec_chg || 0;
        const contrarian = isExtremeLong
          ? '⚠ Crowded long — fade risk'
          : isExtremeShort
          ? '🔥 Contrarian buy — extreme short squeeze potential'
          : isBull ? 'Institutionally bullish' : 'Institutionally bearish';
        const chgNote = Math.abs(chg) > 20000
          ? ` <b style="color:${chg>0?'#22c55e':'#ef4444'}">${chg>0?'↑ Adding':'↓ Reducing'} ${Math.abs(chg).toLocaleString()}</b> (large move)`
          : '';
        return `<div style="margin-top:5px">
          <div style="font-size:10px;color:var(--muted);margin-bottom:2px">
            COT Index 52W: <b style="color:${barColor}">${cotIdx.toFixed(0)}/100</b>
            — ${contrarian}
          </div>
          <div style="display:flex;align-items:center;gap:5px;margin-bottom:3px">
            <span style="font-size:9px;color:var(--muted)">Bear←</span>
            <div style="flex:1;height:5px;background:var(--bg);border-radius:3px">
              <div style="height:5px;width:${Math.min(100,cotIdx)}%;background:${barColor};border-radius:3px"></div>
            </div>
            <span style="font-size:9px;color:var(--muted)">→Bull</span>
          </div>
          <div style="font-size:10px;color:var(--muted)">
            Net: <b style="color:${(cot.lspec_net||0)>=0?'#22c55e':'#ef4444'}">${(cot.lspec_net||0)>=0?'+':''}${(cot.lspec_net||0).toLocaleString()}</b>
            WoW: ${chgNote || `<b>${chg>=0?'+':''}${chg.toLocaleString()}</b>`}
          </div>
          <div style="font-size:9px;color:var(--muted);margin-top:2px;font-style:italic">
            ${isExtremeShort ? '⚡ <10 = historically high probability of reversal up' :
              isExtremeLong  ? '⚠ >90 = crowded — watch for long liquidation' :
              cotIdx <= 40   ? 'Specs net short — contrarian lean bullish' :
              cotIdx >= 60   ? 'Specs net long — trend following bullish' :
                               'Neutral positioning'}
          </div>
        </div>`;
      })() : hasCot ? '' : '<div style="font-size:10px;color:var(--muted);margin-top:3px">No COT data — fetch in Scheduler</div>'}
    </div>` : `<div style="background:var(--surface);border-radius:6px;padding:8px 10px;color:var(--muted);font-size:10px">No futures data · run Fetch OI Now + Fetch CFTC COT in Scheduler</div>`;

  return `
  <div style="background:var(--card);border:2px solid rgba(99,102,241,.3);border-radius:8px;padding:12px 14px;margin-bottom:10px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:8px">
        <span style="font-size:28px;font-weight:900;color:${hsColor};line-height:1">${hs.toFixed(1)}</span>
        <div>
          <div style="font-size:13px;font-weight:700;color:${hsColor}">${ctx.holistic_label}</div>
          <div style="font-size:10px;color:var(--muted)">Holistic View · Futures COT + Options OI</div>
        </div>
      </div>
      <div style="margin-left:auto;display:flex;gap:4px;flex-wrap:wrap">
        <span style="font-size:10px;padding:2px 7px;border-radius:10px;border:1px solid ${hasOI?'#22c55e':'var(--border)'};color:${hasOI?'#22c55e':'var(--muted)'}">
          ${hasOI?'✅':'📭'} Options OI</span>
        <span style="font-size:10px;padding:2px 7px;border-radius:10px;border:1px solid ${hasFut?'#22c55e':'var(--border)'};color:${hasFut?'#22c55e':'var(--muted)'}">
          ${hasFut?'✅':'📭'} Schwab OI</span>
        <span style="font-size:10px;padding:2px 7px;border-radius:10px;border:1px solid ${hasCot?'#22c55e':'var(--border)'};color:${hasCot?'#22c55e':'var(--muted)'}">
          ${hasCot?'✅':'📭'} CFTC COT</span>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
      ${optHtml}
      ${futHtml}
    </div>
  </div>`;
}

async function _loadContextPanel(sym, targetId, targetExpiry) {
  const el = document.getElementById(targetId);
  if (!el) return;
  try {
    let url = `/cot/context/${encodeURIComponent(sym)}`;
    if (targetExpiry) url += `?target_expiry=${encodeURIComponent(targetExpiry)}&count=5`;
    const d = await api(url);
    el.innerHTML = _renderContextPanel(d);
  } catch(e) {
    el.innerHTML = '';  // silent fail — context is supplementary
  }
}

// ── Patch GEX Plan load ───────────────────────────────────────────────────
var _origGexLoadPlan = typeof _gexLoadPlan === 'function' ? _gexLoadPlan : null;
// Hook into the GEX plan button click
document.addEventListener('click', function(e) {
  if (e.target?.id === 'gex-plan-run-btn' || e.target?.closest('[onclick*="gexLoadPlan"]')) {
    const sym = document.getElementById('gex-plan-symbol')?.value || 'SPY';
    setTimeout(() => _loadContextPanel(sym, 'gex-context-panel'), 200);
  }
});

// ── Patch Weekly Plan load ────────────────────────────────────────────────
const _origLoadWeeklyPlan = loadWeeklyPlan;
loadWeeklyPlan = async function() {
  const sym = document.getElementById('wk-symbol')?.value || 'SPY';
  const exp = document.getElementById('wk-expiry')?.value || '';
  _loadContextPanel(sym, 'wk-context-panel', exp);
  const out = await _origLoadWeeklyPlan.apply(this, arguments);
  const resolvedExp = document.getElementById('wk-expiry')?.value || exp;
  if (resolvedExp) _loadContextPanel(sym, 'wk-context-panel', resolvedExp);
  return out;
};

// ════════════════════════════════════════════════════════════════════════════
// WEEKLY MARKET ANALYSIS
// ════════════════════════════════════════════════════════════════════════════

async function _waLoadWatchlists() {
  const sel = document.getElementById('wa-watchlist');
  if (!sel) return;
  try {
    await _loadWatchlistDropdown('wa-watchlist', 'wa-wl-count', 'Default watchlist');
    _waUpdateWatchlistCount();
  } catch (e) {
    sel.innerHTML = '<option value="">⚠ ' + e.message + '</option>';
  }
}

function _waUpdateWatchlistCount() {
  _updateWlCount('wa-watchlist', 'wa-wl-count');
}

async function _waRunWatchlist() {
  const sel = document.getElementById('wa-watchlist');
  const wlId = sel ? sel.value : '';
  const st  = document.getElementById('wa-status');
  const res = document.getElementById('wa-result');
  if (!res) return;
  if (st) st.textContent = '⏳ Running watchlist flow scan…';
  res.innerHTML = '<div style="padding:20px;text-align:center;color:var(--muted)">⏳ Running weekly flow scan…</div>';
  const t0 = Date.now();
  const timer = setInterval(() => { if (st) st.textContent = `⏳ Watchlist ${Math.round((Date.now()-t0)/1000)}s…`; }, 3000);
  try {
    const url = wlId ? `/weekly_analysis/watchlist?watchlist_id=${wlId}` : '/weekly_analysis/watchlist';
    const d = await api(url);
    clearInterval(timer);
    if (st) st.textContent = `✅ ${d.watchlist_name || 'Watchlist'} — ${d.elapsed_s || 0}s`;
    res.innerHTML = _waRenderWatchlist(d);
    _waApplyBiasFilter();
  } catch (e) {
    clearInterval(timer);
    if (st) st.textContent = `❌ ${e.message}`;
    res.innerHTML = `<div style="color:#ef4444;padding:16px">Error: ${e.message}</div>`;
  }
}


async function _waRun() {
  const sym = document.getElementById('wa-symbol')?.value || 'SPY';
  const st  = document.getElementById('wa-status');
  const res = document.getElementById('wa-result');
  if (!res) return;
  if (st)  st.textContent = `⏳ Analyzing ${sym}…`;
  res.innerHTML = '<div style="padding:24px;text-align:center;color:var(--muted)">⏳ Running 5-factor analysis (30-60s)…</div>';
  const t0 = Date.now();
  const timer = setInterval(() => { if(st) st.textContent = `⏳ ${sym} ${Math.round((Date.now()-t0)/1000)}s…`; }, 3000);
  try {
    const d = await api(`/weekly_analysis/analyze/${sym}`);
    clearInterval(timer);
    if (st) st.textContent = `✅ ${sym} — ${d.elapsed_s}s`;
    res.innerHTML = _waRender(d);
  } catch(e) {
    clearInterval(timer);
    if (st) st.textContent = `❌ ${e.message}`;
    res.innerHTML = `<div style="color:#ef4444;padding:16px">Error: ${e.message}</div>`;
  }
}

async function _waRunAll() {
  const st  = document.getElementById('wa-status');
  const res = document.getElementById('wa-result');
  if (!res) return;
  if (st) st.textContent = '⏳ Analyzing SPY + QQQ + IWM in parallel…';
  res.innerHTML = '<div style="padding:24px;text-align:center;color:var(--muted)">⏳ Running parallel analysis (60-90s)…</div>';
  const t0 = Date.now();
  const timer = setInterval(() => { if(st) st.textContent = `⏳ ${Math.round((Date.now()-t0)/1000)}s…`; }, 3000);
  try {
    const d = await api('/weekly_analysis/multi?symbols=SPY,QQQ,IWM');
    clearInterval(timer);
    if (st) st.textContent = `✅ Done`;
    res.innerHTML = Object.values(d.results||{}).map(r => _waRender(r)).join('<hr style="border:none;border-top:2px solid var(--border);margin:16px 0">');
  } catch(e) {
    clearInterval(timer);
    if (st) st.textContent = `❌ ${e.message}`;
  }
}

function _waScoreBar(score, max=10) {
  const pct   = Math.min(100, score / max * 100);
  const color = score >= 7 ? '#22c55e' : score >= 5.5 ? '#86efac' : score >= 4 ? '#94a3b8' : score >= 2.5 ? '#fca5a5' : '#ef4444';
  return `<div style="display:flex;align-items:center;gap:6px">
    <div style="flex:1;height:6px;background:var(--bg);border-radius:3px">
      <div style="height:6px;width:${pct}%;background:${color};border-radius:3px;transition:width .5s"></div>
    </div>
    <span style="font-size:11px;font-weight:700;color:${color};min-width:28px">${score}</span>
  </div>`;
}

function _waSectionCard(icon, title, r, extraHtml='') {
  if (!r) return '';
  const found = r.found !== false;
  const score = r.score ?? null;
  const sc    = score !== null ? score : null;
  const scColor = sc >= 7 ? '#22c55e' : sc >= 5.5 ? '#86efac' : sc >= 4 ? '#94a3b8' : sc >= 2.5 ? '#fca5a5' : '#ef4444';
  return `<div style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:12px 14px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <span style="font-weight:700;font-size:13px">${icon} ${title}</span>
      ${sc !== null ? `<span style="font-size:20px;font-weight:900;color:${scColor}">${sc}</span>` : ''}
    </div>
    ${sc !== null ? _waScoreBar(sc) + '<div style="height:4px"></div>' : ''}
    <div style="font-size:11px;color:var(--text2);margin-top:4px">${r.detail || (found ? 'Data available' : '📭 No data')}</div>
    ${extraHtml}
  </div>`;
}

function _waRender(d) {
  if (!d || d.error) return `<div style="color:#ef4444;padding:12px">Analysis failed: ${d?.error||'unknown'}</div>`;

  const ws     = d.weekly_score ?? 5;
  const wsC    = ws >= 7 ? '#22c55e' : ws >= 5.5 ? '#86efac' : ws >= 4 ? '#94a3b8' : ws >= 2.5 ? '#fca5a5' : '#ef4444';
  const s      = d.sections || {};
  const cot    = s.cot     || {};
  const fut    = s.futures || {};
  const opt    = s.options || {};
  const vs     = s.vol_skew|| {};
  const vix    = vs.vix    || {};
  const skew   = vs.skew   || {};

  // ── Hero ──
  const heroHtml = `
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;
                background:linear-gradient(135deg,rgba(99,102,241,.1),rgba(0,0,0,0));
                border:2px solid rgba(99,102,241,.25);border-radius:10px;padding:14px 18px;flex-wrap:wrap">
      <div style="text-align:center">
        <div style="font-size:44px;font-weight:900;color:${wsC};line-height:1">${ws.toFixed(1)}</div>
        <div style="font-size:10px;color:var(--muted)">/10</div>
      </div>
      <div style="flex:1;min-width:200px">
        <div style="font-size:20px;font-weight:700;color:${wsC};margin-bottom:3px">${d.bias}</div>
        <div style="font-size:12px;color:var(--text2)">${d.symbol} · ${d.contract} · ${d.generated_at}</div>
      </div>
      <div style="min-width:240px">
        <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px">This Week's Strategies</div>
        ${(d.strategies||[]).map(s => `<div style="font-size:11px;color:var(--text2);margin-bottom:2px">${s}</div>`).join('')}
      </div>
    </div>`;

  // ── COT extra detail ──
  const cotIdx = cot.cot_index;
  const cotExtra = cot.found ? `
    <div style="margin-top:6px">
      <div style="display:flex;align-items:center;gap:5px">
        <span style="font-size:9px;color:#ef4444">Bear 0</span>
        <div style="flex:1;height:5px;background:var(--bg);border-radius:3px">
          <div style="height:5px;width:${Math.min(100,cotIdx||0)}%;background:${(cotIdx||0)>=75?'#22c55e':(cotIdx||0)<=25?'#ef4444':'#94a3b8'};border-radius:3px"></div>
        </div>
        <span style="font-size:9px;color:#22c55e">100 Bull</span>
        <b style="font-size:12px;color:var(--text2);margin-left:4px">${(cotIdx||0).toFixed(0)}/100</b>
      </div>
      <div style="display:flex;gap:8px;margin-top:4px;font-size:10px;flex-wrap:wrap">
        <span><span style="color:var(--muted)">Net:</span> <b>${(cot.net||0)>=0?'+':''}${(cot.net||0).toLocaleString()}</b></span>
        <span><span style="color:var(--muted)">WoW:</span> <b style="color:${(cot.wow_change||0)>=0?'#22c55e':'#ef4444'}">${(cot.wow_change||0)>=0?'+':''}${(cot.wow_change||0).toLocaleString()}</b></span>
        <span><span style="color:var(--muted)">Trend:</span> <b>${cot.trend_dir||'—'}</b></span>
        <span style="font-size:9px;font-style:italic;color:${(cotIdx||0)<=10?'#22c55e':(cotIdx||0)>=90?'#f59e0b':'var(--muted)'}">${(cotIdx||0)<=10?'⚡ Extreme short — contrarian buy':(cotIdx||0)>=90?'⚠ Crowded long — fade risk':'Moderate positioning'}</span>
      </div>
    </div>` : '';

  // ── Options extra detail ──
  const callW = (opt.call_walls||[]).slice(0,3).map(w=>`<span style="background:rgba(34,197,94,.1);color:#22c55e;font-size:10px;padding:1px 5px;border-radius:3px">C$${w.strike} (${(w.oi/1000).toFixed(0)}K)</span>`).join(' ');
  const putW  = (opt.put_walls ||[]).slice(0,3).map(w=>`<span style="background:rgba(239,68,68,.1);color:#ef4444;font-size:10px;padding:1px 5px;border-radius:3px">P$${w.strike} (${(w.oi/1000).toFixed(0)}K)</span>`).join(' ');
  const optExtra = opt.found ? `
    <div style="margin-top:6px;font-size:10px">
      <div style="display:flex;gap:8px;margin-bottom:3px;flex-wrap:wrap">
        <span><span style="color:var(--muted)">PCR:</span> <b>${opt.pcr||'—'}</b></span>
        <span><span style="color:var(--muted)">Trend:</span> <b>${opt.pcr_trend||'—'}</b></span>
        <span><span style="color:var(--muted)">Vol PCR:</span> <b>${opt.vol_pcr||'—'}</b></span>
      </div>
      <div style="display:flex;gap:4px;flex-wrap:wrap;margin-top:2px">
        ${callW ? `<span style="font-size:9px;color:#22c55e">🛡 Calls:</span> ${callW}` : ''}
        ${putW  ? `<span style="font-size:9px;color:#ef4444;margin-left:6px">⚡ Puts:</span> ${putW}` : ''}
      </div>
    </div>` : '';

  // ── Vol + Skew extra ──
  const tsColor = vs.term_structure==='Backwardation'?'#f59e0b':'#94a3b8';
  const skewSpread = skew.spread??null;
  const volExtra = vs.found ? `
    <div style="margin-top:6px;font-size:10px">
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:3px">
        ${vix.current ? `<span><span style="color:var(--muted)">VIX:</span> <b>${vix.current}</b> (${vix.regime||''})</span>` : ''}
        ${vix.rank_52w != null ? `<span><span style="color:var(--muted)">VIX Rank:</span> <b>${vix.rank_52w.toFixed(0)}/100</b></span>` : ''}
        ${vs.atm_iv   != null ? `<span><span style="color:var(--muted)">ATM IV:</span> <b>${vs.atm_iv.toFixed(1)}%</b></span>` : ''}
        ${vs.hv20     != null ? `<span><span style="color:var(--muted)">HV20:</span> <b>${vs.hv20}%</b></span>` : ''}
        ${vs.iv_vs_hv != null ? `<span><span style="color:var(--muted)">IV/HV:</span> <b style="color:${vs.iv_vs_hv>1.3?'#f59e0b':vs.iv_vs_hv<0.8?'#22c55e':'var(--text2)'}">${vs.iv_vs_hv}×</b></span>` : ''}
      </div>
      ${vs.term_structure ? `<div style="margin-bottom:2px"><span style="color:var(--muted)">Term Structure:</span> <b style="color:${tsColor}">${vs.term_structure}</b>${vs.ts_spread!=null?` (${vs.ts_spread>0?'+':''}${vs.ts_spread}%)`:''}</div>` : ''}
      ${skewSpread!=null ? `<div><span style="color:var(--muted)">Put/Call Skew:</span> <b style="color:${skewSpread>6?'#f59e0b':skewSpread<0?'#22c55e':'#94a3b8'}">${skewSpread>0?'+':''}${skewSpread}%</b>
        (Put IV ${skew.put_iv||'—'}% · Call IV ${skew.call_iv||'—'}%) — ${skew.sentiment||''}</div>` : ''}
      ${vs.vix?.chg_5d!=null ? `<div style="font-size:9px;color:${vix.chg_5d>0?'#ef4444':'#22c55e'};margin-top:2px">VIX ${vix.chg_5d>0?'↑ +':'↓ '}${vix.chg_5d} vs 5d ago ${vix.chg_20d!=null?`· ${vix.chg_20d>0?'↑':'↓'}${Math.abs(vix.chg_20d)} vs 20d`:''}</div>` : ''}
    </div>` : '';

  // ── Grid of 4 sections ──
  const gridHtml = `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin-bottom:12px">
    ${_waSectionCard('📋', 'COT Positioning', cot, cotExtra)}
    ${_waSectionCard('📊', 'Futures OI Flow', fut)}
    ${_waSectionCard('📈', 'Options Sentiment', opt, optExtra)}
    ${_waSectionCard('🌡', 'Volatility + Skew', vs, volExtra)}
  </div>`;

  return heroHtml + gridHtml;
}


let __waBiasFilter = 'all';
function _waSetBiasFilter(filter) {
  __waBiasFilter = filter || 'all';
  _waApplyBiasFilter();
}
function _waApplyBiasFilter() {
  const root = document.getElementById('wa-result');
  if (!root) return;
  const rows = root.querySelectorAll('tr.wa-row');
  rows.forEach(row => {
    const b = (row.dataset.bias || 'neutral').toLowerCase();
    const show = (__waBiasFilter === 'all' || __waBiasFilter === b);
    row.style.display = show ? '' : 'none';
  });
  const badges = root.querySelectorAll('[data-wa-filter]');
  badges.forEach(btn => {
    const val = btn.dataset.waFilter || 'all';
    btn.style.opacity = (__waBiasFilter === val) ? '1' : '.72';
    btn.style.transform = (__waBiasFilter === val) ? 'translateY(-1px)' : 'none';
  });
}


function _waRenderWatchlist(d) {
  if (!d || d.error) {
    return `<div style="color:#ef4444;padding:12px">Analysis failed: ${d?.error||'unknown'}</div>`;
  }
  const s = d.summary || {};
  const rows = Array.isArray(d.rows) ? d.rows : [];
  const curFilter = (__waBiasFilter || 'all');
  const badge = (label, value, color) => `<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border:1px solid ${color};border-radius:999px;font-size:11px;color:${color};font-weight:700">${label} ${value}</span>`;
  const btn = (label, value, color, count) => `<button type="button" data-wa-filter="${value}" onclick="_waSetBiasFilter('${value}')" style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border:1px solid ${color};border-radius:999px;font-size:11px;color:${color};font-weight:800;background:${curFilter===value?'rgba(99,102,241,.16)':'transparent'};transition:all .15s">${label} ${count}</button>`;
  const fmt = (v, d='—') => (v === null || v === undefined || v === '' || Number.isNaN(v) ? d : (typeof v === 'number' ? (Math.abs(v) >= 10 || Number.isInteger(v) ? String(v) : v.toFixed(2)) : String(v)));
  const esc = (v) => String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  const biasColor = (b) => {
    const x = String(b||'').toLowerCase();
    if (x.includes('strong bull') || x.includes('bullish')) return '#22c55e';
    if (x.includes('strong bear') || x.includes('bearish')) return '#ef4444';
    return '#94a3b8';
  };
  const rowsHtml = rows.map(r => {
    const b = r.bias || 'Neutral';
    const c = biasColor(b);
    const strat = Array.isArray(r.detail) ? r.detail.slice(0,2).join(' · ') : (r.detail || '');
    const expBlocks = Array.isArray(r.expiry_profile) ? r.expiry_profile : [];
    const expHtml = expBlocks.length ? expBlocks.map(e => {
      const bias = esc(e.bias || 'Neutral');
      const pcr = fmt(e.pcr);
      const oiChg = fmt(e.oi_change_pct);
      const dte = e.dte != null ? `${e.dte}d` : '—';
      const pwall = e.put_wall != null ? fmt(e.put_wall) : '—';
      const cwall = e.call_wall != null ? fmt(e.call_wall) : '—';
      const hint  = esc(e.trade_hint || '');
      return `<div style="line-height:1.35;margin-bottom:6px">
        <div style="font-weight:800;color:var(--text);white-space:nowrap">${esc(e.expiry || '—')} · ${dte} · <span style="color:${bias.toLowerCase().includes('bull') ? '#22c55e' : bias.toLowerCase().includes('bear') ? '#ef4444' : '#94a3b8'}">${bias}</span></div>
        <div style="color:var(--text2)">P/W ${pwall} · C/W ${cwall} · PCR ${pcr} · ΔOI ${oiChg}%</div>
        <div style="color:var(--muted)">${hint}</div>
      </div>`;
    }).join('') : '—';
    const sym = esc(r.symbol || '—');
    const symLink = r.symbol ? `<a href="?tab=aggregate&symbol=${encodeURIComponent(String(r.symbol).trim().toUpperCase())}" style="color:${c};font-weight:900;text-decoration:none" title="Open aggregate view">${sym}</a>` : sym;
    return `<tr class="wa-row wa-row-${String(b).toLowerCase().includes('bull') ? 'bull' : String(b).toLowerCase().includes('bear') ? 'bear' : 'neutral'}" data-bias="${String(b).toLowerCase().includes('bull') ? 'bull' : String(b).toLowerCase().includes('bear') ? 'bear' : 'neutral'}" style="border-top:1px solid var(--border)">
      <td style="padding:8px 10px;font-weight:800;color:${c}">${symLink}</td>
      <td style="padding:8px 10px;font-weight:800">${fmt(r.spot)}</td>
      <td style="padding:8px 10px;color:${c};font-weight:700">${b}</td>
      <td style="padding:8px 10px;font-weight:800">${fmt(r.weekly_score)}</td>
      <td style="padding:8px 10px">${fmt(r.options_score)}</td>
      <td style="padding:8px 10px">${fmt(r.vol_score)}</td>
      <td style="padding:8px 10px">${fmt(r.pcr)}</td>
      <td style="padding:8px 10px">${fmt(r.iv_rank)}</td>
      <td style="padding:8px 10px">${fmt(r.iv_change_pct)}%</td>
      <td style="padding:8px 10px">${fmt(r.vix_chg_5d)}</td>
      <td style="padding:8px 10px;white-space:normal;min-width:340px">${expHtml}</td>
      <td style="padding:8px 10px;font-size:11px;color:var(--text2)">${esc(strat)}</td>
    </tr>`;
  }).join('');
  const summaryHtml = `
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px;padding:12px 14px;border:1px solid var(--border);border-radius:10px;background:linear-gradient(135deg,rgba(99,102,241,.08),rgba(0,0,0,0))">
      <div>
        <div style="font-size:18px;font-weight:900">${d.watchlist_name || 'Watchlist'} <span style="font-size:12px;color:var(--muted)">· ${rows.length} symbols</span></div>
        <div style="font-size:11px;color:var(--muted)">Generated ${d.generated_at || ''}${d.elapsed_s != null ? ` · ${d.elapsed_s}s` : ''}</div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button type="button" data-wa-filter="all" onclick="_waSetBiasFilter('all')" style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border:1px solid #818cf8;border-radius:999px;font-size:11px;color:#818cf8;font-weight:800;background:${curFilter==='all'?'rgba(99,102,241,.16)':'transparent'}">All ${s.symbol_count ?? rows.length}</button>
        ${btn('Bull', 'bull', '#22c55e', s.bull_count ?? 0)}
        ${btn('Bear', 'bear', '#ef4444', s.bear_count ?? 0)}
        ${btn('Neutral', 'neutral', '#94a3b8', s.neutral_count ?? 0)}
      </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px">
      ${badge('Avg Score', fmt(s.avg_score), '#818cf8')}
      ${badge('Avg Price', fmt(s.avg_price_score), '#22c55e')}
      ${badge('Avg PCR', fmt(s.avg_pcr), '#f59e0b')}
      ${badge('Avg IV Rank', fmt(s.avg_iv_rank), '#22d3ee')}
      ${badge('Avg IV Δ%', fmt(s.avg_iv_change_pct), '#fb7185')}
      ${badge('Avg IV vs HV', fmt(s.avg_iv_vs_hv), '#a78bfa')}
      ${badge('Avg VIX Δ5D', fmt(s.avg_vix_chg_5d), '#f97316')}
      ${badge('COT', fmt(s.cot_score), '#34d399')}
      ${badge('Futures', fmt(s.futures_score), '#60a5fa')}
    </div>
    <div style="font-size:11px;color:var(--muted);margin-bottom:12px">${esc(s.cot_signal || '')}${s.cot_signal && s.futures_signal ? ' · ' : ''}${esc(s.futures_signal || '')}</div>`;
  return `${summaryHtml}<div style="overflow:auto;border:1px solid var(--border);border-radius:10px">
    <table style="width:100%;border-collapse:collapse;font-size:12px;min-width:1320px">
      <thead><tr style="background:rgba(255,255,255,.05);border-bottom:2px solid var(--border)">
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Symbol</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Spot</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Bias</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Score</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Options</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Vol</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">PCR</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">IV Rank</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">IV Δ%</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">VIX Δ5D</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Expiries / Walls</th>
        <th style="padding:8px 10px;text-align:left;font-size:11px;color:var(--muted);font-weight:700">Notes</th>
      </tr></thead>
      <tbody>${rowsHtml || '<tr><td colspan="12" style="padding:16px;color:var(--muted)">No results.</td></tr>'}</tbody>
    </table>
  </div>`;
}

// Tab router
document.addEventListener('DOMContentLoaded', function() {
  // handled by main tab router below
});


// ════════════════════════════════════════════════════════════════════════════
// MOMENTUM WATCHLIST BACKTEST V2 — watchlist selector + clearer signal cards
// ════════════════════════════════════════════════════════════════════════════

async function _loadBacktest() {
  const el = document.getElementById('backtest-root');
  if (!el) return;
  if (el.dataset.builtV3) return;
  el.dataset.builtV3 = '1';

  const today = new Date();
  const prevDay = new Date(today.getTime() - 86400000);
  while (prevDay.getDay() === 0 || prevDay.getDay() === 6) prevDay.setDate(prevDay.getDate() - 1);
  const lastTrading = prevDay.toISOString().slice(0, 10);
  const oneYearAgo = new Date(Date.now() - 365 * 86400000).toISOString().slice(0, 10);

  el.innerHTML = `
  <div style="max-width:1320px">
    <div class="card" style="padding:14px;margin-bottom:10px">
      <div style="font-size:13px;font-weight:800;margin-bottom:6px">🎯 Multi-Scanner Backtest</div>
      <div style="font-size:11px;color:var(--muted);margin-bottom:10px;line-height:1.45">
        Choose a scanner, run it across your watchlist, and save the run for later comparison. Momentum uses your abs(%change) + volume rule.
        Maya uses EMA 9/21/50, MACD, ADX/+DI/-DI, RSI health, and the same daily PNR exit tree.
        Maya mode can be Core only or Composite (market / sector / OI / S-R overlays).
        Other scanners use their native setup logic on the same watchlist / backtest controls.
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;align-items:end;margin-bottom:10px">
        <div>
          <label style="font-size:11px;color:var(--muted)">Scanner</label>
          <select id="mb-scanner" style="width:100%">
            <option value="momentum">Momentum backtest</option>
            <option value="maya">Maya scanner</option>
            <option value="rsi_mtf">RSI MTF</option>
            <option value="sr">S/R Breakout</option>
            <option value="momentum_retrace">Momentum Retrace</option>
            <option value="trend_exhaustion">Trend Exhaustion</option>
            <option value="second_pullback">Second Pullback</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Maya mode</label>
          <select id="mb-maya-mode" style="width:100%">
            <option value="core">Core only</option>
            <option value="composite">Composite</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Backtest name</label>
          <input id="mb-name" type="text" placeholder="e.g. momentum_30d_10span" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Watchlist</label>
          <select id="mb-watchlist" style="width:100%"></select>
          <div id="mb-watchlist-count" style="font-size:10px;color:var(--muted);margin-top:4px"></div>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Run date</label>
          <input id="mb-asof" type="date" value="${lastTrading}" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Days back</label>
          <input id="mb-days-back" type="number" value="30" min="1" max="365" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Run span</label>
          <input id="mb-run-span" type="number" value="1" min="1" max="60" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Target DTE</label>
          <input id="mb-dte" type="number" value="30" min="7" max="90" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Min Earn DTE</label>
          <input id="mb-min-earn-days" type="number" value="30" min="0" max="365" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Width</label>
          <select id="mb-width" style="width:100%">
            <option value="auto">Auto</option>
            <option value="1">1-wide</option>
            <option value="5">5-wide</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Min score</label>
          <input id="mb-min-score" type="number" value="0" min="0" max="100" style="width:100%"/>
        </div>
        <div style="grid-column:span 4;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;padding:10px;border:1px solid var(--border);border-radius:10px;background:rgba(255,255,255,.03)">
          <div>
            <label style="font-size:11px;color:var(--muted)">Trade type</label>
            <select id="mb-trade-type" style="width:100%">
              <option value="any">Any</option>
              <option value="call">Call spreads</option>
              <option value="put">Put spreads</option>
            </select>
          </div>
          <div>
            <label style="font-size:11px;color:var(--muted)">Bias</label>
            <select id="mb-bias" style="width:100%">
              <option value="any">Any</option>
              <option value="bullish">Bullish</option>
              <option value="bearish">Bearish</option>
            </select>
          </div>
          <div>
            <label style="font-size:11px;color:var(--muted)">Strictness</label>
            <select id="mb-strictness" style="width:100%">
              <option value="0">Very loose</option>
              <option value="1">Loose</option>
              <option value="2" selected>Normal</option>
              <option value="3">Strict</option>
              <option value="4">Very strict</option>
            </select>
          </div>
          <div>
            <label style="font-size:11px;color:var(--muted)">RSI min / max</label>
            <div style="display:flex;gap:6px"><input id="mb-min-rsi" type="number" min="0" max="100" placeholder="0" style="width:50%"/><input id="mb-max-rsi" type="number" min="0" max="100" placeholder="100" style="width:50%"/></div>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px;justify-content:flex-end;font-size:11px;color:var(--muted)">
            <label><input id="mb-avoid-earnings" type="checkbox"/> Avoid earnings</label>
            <label><input id="mb-use-ema" type="checkbox" checked/> EMA stack</label>
            <label><input id="mb-use-macd" type="checkbox" checked/> MACD</label>
            <label><input id="mb-use-dmi" type="checkbox" checked/> DMI / ADX</label>
            <label><input id="mb-use-rsi" type="checkbox" checked/> RSI</label>
            <label><input id="mb-use-squeeze" type="checkbox"/> Squeeze</label>
          </div>
        </div>
        <div style="display:flex;align-items:flex-end;gap:8px;grid-column:span 2;flex-wrap:wrap">
          <button class="btn btn-primary" style="padding:8px 14px" onclick="_mbtRun()">▶ Run backtest</button>
          <label style="font-size:11px;color:var(--muted)"><input id="mb-save" type="checkbox"/> save run (manual)</label>
          <label style="font-size:11px;color:var(--muted)"><input id="mb-show-all" type="checkbox"/> show non-signal rows</label>
        </div>
      </div>
      <div id="mbt-status" style="font-size:11px;color:var(--muted)"></div>
    </div>

    <div class="card" style="padding:12px;margin-bottom:10px">
      <div style="font-size:12px;font-weight:700;margin-bottom:8px">Saved run analysis</div>
      <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;align-items:end;margin-bottom:10px">
        <div>
          <label style="font-size:11px;color:var(--muted)">Scanner</label>
          <select id="mb-ana-scanner" style="width:100%">
            <option value="">All scanners</option>
            <option value="momentum">Momentum backtest</option>
            <option value="maya">Maya scanner</option>
            <option value="rsi_mtf">RSI MTF</option>
            <option value="sr">S/R Breakout</option>
            <option value="momentum_retrace">Momentum Retrace</option>
            <option value="trend_exhaustion">Trend Exhaustion</option>
            <option value="second_pullback">Second Pullback</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Run date</label>
          <input id="mb-ana-date" type="date" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">Name contains</label>
          <input id="mb-ana-name" type="text" placeholder="partial name" style="width:100%"/>
        </div>
        <div style="display:flex;align-items:flex-end;gap:8px">
          <button class="btn btn-primary" style="padding:8px 14px" onclick="_mbtAnalyzeRuns()">🔎 Analyze saved runs</button>
          <button class="btn" style="padding:8px 14px" onclick="_mbtLoadRuns()">↻ Load runs</button>
        </div>
      </div>
      <div id="mbt-saved-status" style="font-size:11px;color:var(--muted)"></div>
      <div id="mbt-run-list" style="display:grid;gap:8px;margin-top:10px"></div>
      <div id="mbt-saved-analysis" style="display:none;margin-top:12px"></div>
    </div>

    <div id="mbt-results" style="display:none">
      <div id="mbt-stats" class="card" style="padding:12px;margin-bottom:10px"></div>
      <div class="card" style="padding:12px;margin-bottom:10px">
        <div style="font-size:12px;font-weight:700;margin-bottom:8px">Methodology</div>
        <div id="mbt-method" style="font-size:11px;color:var(--muted);line-height:1.5"></div>
      </div>
      <div class="card" style="padding:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
          <div style="font-size:12px;font-weight:700">Signal Log <span id="mbt-trade-count" style="color:var(--muted);font-size:11px"></span></div>
          <div style="font-size:11px;color:var(--muted)">Cards show the exact entry vertical, exit vertical, and P/L.</div>
        </div>
        <div id="mbt-table" style="display:grid;gap:10px"></div>
      </div>
    </div>
  </div>`;

  const scannerSel = document.getElementById('mb-scanner');
  const modeWrap = document.getElementById('mb-maya-mode')?.parentElement;
  const syncMode = () => { if (!scannerSel || !modeWrap) return; modeWrap.style.display = scannerSel.value === 'maya' ? '' : 'none'; };
  if (scannerSel) scannerSel.addEventListener('change', syncMode);
  syncMode();
  try {
    await _loadWatchlistDropdown('mb-watchlist', 'mb-watchlist-count', 'All symbols (symbols table)');
    const sel = document.getElementById('mb-watchlist');
    if (sel) sel.addEventListener('change', () => _updateWlCount('mb-watchlist', 'mb-watchlist-count'));
    await _mbtLoadRuns();
  } catch (e) { console.warn('mbt watchlist load failed', e); }
}

async function _mbtRun() {
  const st = document.getElementById('mbt-status');
  if (st) st.innerHTML = '⏳ Running backtest…';

  const scanner = document.getElementById('mb-scanner')?.value || 'momentum';
  const params = new URLSearchParams({
    scanner,
    backtest_name: document.getElementById('mb-name')?.value || `${scanner}_${document.getElementById('mb-days-back')?.value || 30}d_${document.getElementById('mb-run-span')?.value || 1}span`,
    days_back: document.getElementById('mb-days-back')?.value || 30,
    run_span_days: document.getElementById('mb-run-span')?.value || 1,
    dte: document.getElementById('mb-dte')?.value || 30,
    width: document.getElementById('mb-width')?.value || 'auto',
    min_score: document.getElementById('mb-min-score')?.value || 0,
    as_of: document.getElementById('mb-asof')?.value || '',
    save_run: document.getElementById('mb-save')?.checked ? '1' : '0',
    trade_type: document.getElementById('mb-trade-type')?.value || 'any',
    bias: document.getElementById('mb-bias')?.value || 'any',
    strictness: document.getElementById('mb-strictness')?.value || '2',
    min_rsi: document.getElementById('mb-min-rsi')?.value || '',
    max_rsi: document.getElementById('mb-max-rsi')?.value || '',
    min_earn_days: document.getElementById('mb-min-earn-days')?.value || '',
    avoid_earnings: document.getElementById('mb-avoid-earnings')?.checked ? '1' : '0',
    use_ema: document.getElementById('mb-use-ema')?.checked ? '1' : '0',
    use_macd: document.getElementById('mb-use-macd')?.checked ? '1' : '0',
    use_dmi: document.getElementById('mb-use-dmi')?.checked ? '1' : '0',
    use_rsi: document.getElementById('mb-use-rsi')?.checked ? '1' : '0',
    use_squeeze: document.getElementById('mb-use-squeeze')?.checked ? '1' : '0',
  });
  const mayaMode = document.getElementById('mb-maya-mode')?.value || 'core';
  if (scanner === 'maya') params.set('maya_mode', mayaMode);
  const wlId = document.getElementById('mb-watchlist')?.value || '';
  if (wlId) params.set('watchlist_id', wlId);

  try {
    const d = await api(`/analysis/momentum_backtest?${params.toString()}`);
    if (d.error) { if (st) st.innerHTML = `❌ ${d.error}`; return; }
    if (st) st.innerHTML = `✅ Complete: ${d.stats.processed ?? d.stats.evaluated} symbol-days · ${d.stats.signals} signals · ${d.stats.signal_winners} winners · ${d.stats.signal_losers} losers${d.run_id ? ` · saved run #${d.run_id}` : ''}`;
    _mbtRenderResults(d);
    await _mbtLoadRuns();
  } catch (e) {
    if (st) st.innerHTML = `❌ ${e.message}`;
  }
}

async function _mbtRun() {
  const st = document.getElementById('mbt-status');
  if (st) st.innerHTML = '⏳ Running backtest…';

  const scanner = document.getElementById('mb-scanner')?.value || 'momentum';
  const params = new URLSearchParams({
    scanner,
    backtest_name: document.getElementById('mb-name')?.value || `${scanner}_${document.getElementById('mb-days-back')?.value || 30}d_${document.getElementById('mb-run-span')?.value || 1}span`,
    days_back: document.getElementById('mb-days-back')?.value || 30,
    run_span_days: document.getElementById('mb-run-span')?.value || 1,
    dte: document.getElementById('mb-dte')?.value || 30,
    width: document.getElementById('mb-width')?.value || 'auto',
    min_score: document.getElementById('mb-min-score')?.value || 0,
    as_of: document.getElementById('mb-asof')?.value || '',
    save_run: document.getElementById('mb-save')?.checked ? '1' : '0',
    trade_type: document.getElementById('mb-trade-type')?.value || 'any',
    bias: document.getElementById('mb-bias')?.value || 'any',
    strictness: document.getElementById('mb-strictness')?.value || '2',
    min_rsi: document.getElementById('mb-min-rsi')?.value || '',
    max_rsi: document.getElementById('mb-max-rsi')?.value || '',
    min_earn_days: document.getElementById('mb-min-earn-days')?.value || '',
    avoid_earnings: document.getElementById('mb-avoid-earnings')?.checked ? '1' : '0',
    use_ema: document.getElementById('mb-use-ema')?.checked ? '1' : '0',
    use_macd: document.getElementById('mb-use-macd')?.checked ? '1' : '0',
    use_dmi: document.getElementById('mb-use-dmi')?.checked ? '1' : '0',
    use_rsi: document.getElementById('mb-use-rsi')?.checked ? '1' : '0',
    use_squeeze: document.getElementById('mb-use-squeeze')?.checked ? '1' : '0',
  });
  const mayaMode = document.getElementById('mb-maya-mode')?.value || 'core';
  if (scanner === 'maya') params.set('maya_mode', mayaMode);
  const wlId = document.getElementById('mb-watchlist')?.value || '';
  if (wlId) params.set('watchlist_id', wlId);

  try {
    const d = await api(`/analysis/momentum_backtest?${params.toString()}`);
    if (d.error) { if (st) st.innerHTML = `❌ ${d.error}`; return; }
    if (st) st.innerHTML = `✅ Complete: ${d.stats.processed ?? d.stats.evaluated} symbol-days · ${d.stats.signals} signals · ${d.stats.signal_winners} winners · ${d.stats.signal_losers} losers${d.run_id ? ` · saved run #${d.run_id}` : ''}`;
    _mbtRenderResults(d);
    await _mbtLoadRuns();
  } catch (e) {
    if (st) st.innerHTML = `❌ ${e.message}`;
  }
}

function _mbtRenderResults(d) {
  const res = document.getElementById('mbt-results');
  if (res) res.style.display = '';
  const s = d.stats || {};
  const rows = (d.signal_rows && d.signal_rows.length) ? d.signal_rows : (d.rows || []);
  const showAll = document.getElementById('mb-show-all')?.checked ?? false;
  const visible = showAll ? (d.rows || []) : rows;

  const stats = document.getElementById('mbt-stats');
  if (stats) stats.innerHTML = `
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px">
      ${[
        {l:'Watchlist',v:s.symbols||0,c:'var(--text)'},
        {l:'Runs',v:s.runs||1,c:'var(--text)'},
        {l:'Processed',v:s.processed||0,c:'var(--text)'},
        {l:'Evaluated',v:s.evaluated||0,c:'var(--text)'},
        {l:'Signals',v:s.signals||0,c:'#22c55e'},
        {l:'Signal Winners',v:s.signal_winners||0,c:'#22c55e'},
        {l:'Signal Losers',v:s.signal_losers||0,c:'#ef4444'},
        {l:'Open Signals',v:s.signal_open||0,c:'#f59e0b'},
        {l:'Win Rate',v:(s.win_rate??0)+'%',c:(s.win_rate||0)>=50?'#22c55e':'#ef4444'},
        {l:'Avg Move',v:(s.avg_move??0).toFixed(2)+'%',c:'var(--muted)'},
        {l:'Avg PnL',v:'$'+fmt(s.avg_pnl,2),c:(s.avg_pnl||0)>=0?'#22c55e':'#ef4444'},
        {l:'Red Signals',v:s.red_signals||0,c:'#f59e0b'},
        {l:'1pt hits',v:s.hit_1pt||0,c:'#22c55e'},
        {l:'5pt hits',v:s.hit_5pt||0,c:'#22c55e'},
        {l:'Lookback',v:(s.lookback_days||0)+'d',c:'var(--muted)'},
        {l:'Run span',v:(s.run_span_days||1)+'d',c:'var(--muted)'},
        {l:'Scanner',v:s.scanner||d.scanner||'—',c:'var(--text)'},
        {l:'Maya mode',v:s.maya_mode||d.method?.mode||'core',c:'var(--text)'},
      ].map(x=>`<div style="background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:8px">
        <div style="font-size:9px;color:var(--muted)">${x.l}</div>
        <div style="font-size:14px;font-weight:800;color:${x.c}">${x.v}</div>
      </div>`).join('')}
    </div>`;

  const method = document.getElementById('mbt-method');
  if (method) method.innerHTML = `
    <div><b>Scanner:</b> ${(s.scanner || d.scanner || 'momentum').toUpperCase()}</div>
    <div><b>Maya mode:</b> ${s.maya_mode || d.method?.mode || 'core'}</div>
    <div><b>Signal rule:</b> ${d.method?.momentum || 'see scanner logic'}.</div>
    <div><b>Maya rule:</b> ${d.method?.maya || 'EMA 9/21/50 + MACD + ADX/DMI + RSI health / pullback'}</div>
    <div><b>Red alert:</b> ${d.method?.red_signal || 'RSI extremes / RSI-EMA diff extremes'}</div>
    <div><b>Exit tree:</b> ${d.method?.exit_tree || 'PNR recalc + profit target + expiration risk rules'}</div>
    <div><b>Pricing:</b> ${d.method?.pricing || 'Deterministic historical BS pricing'}</div>
    <div><b>Save:</b> Use the Backtest name field + save toggle to store the run, then filter by scanner/run date in Saved run analysis.</div>`;

  const table = document.getElementById('mbt-table');
  if (!table) return;
  document.getElementById('mbt-trade-count').textContent = `(${visible.length} row${visible.length===1?'':'s'}${showAll ? ' · all rows' : ' · signal rows'})`;

  if (!visible.length) {
    table.innerHTML = `<div style="color:var(--muted);font-size:12px;padding:12px">No matching signal rows for this lookback window.</div>`;
    return;
  }

  table.innerHTML = visible.map(r => {
    const bg = (r.red_signal || r.contrarian) ? 'rgba(239,68,68,.08)' : (r.momentum_hit ? 'rgba(34,197,94,.06)' : 'transparent');
    const border = (r.red_signal || r.contrarian) ? '2px solid rgba(239,68,68,.75)' : (r.momentum_hit ? '1px solid rgba(34,197,94,.35)' : '1px solid var(--border)');
    const resultTxt = r.winner === true ? 'WINNER' : r.winner === false ? 'LOSER' : 'OPEN';
    const resultClr = r.winner === true ? '#22c55e' : r.winner === false ? '#ef4444' : '#f59e0b';
    const redTag = r.red_signal ? `⚠ ${((r.red_reasons||[]).join('; ') || 'red signal')}` : '—';
    const strikeTxt = (r.long_strike != null && r.short_strike != null) ? `${r.long_strike} / ${r.short_strike}` : '—';
    const pnlTxt = (r.pnl === null || r.pnl === undefined) ? '—' : `${r.pnl >= 0 ? '+' : '-'}$${Math.abs(r.pnl).toFixed(2)}`;
    const entryTxt = r.entry_vertical === null || r.entry_vertical === undefined ? '—' : `$${fmt(r.entry_vertical,2)}`;
    const nowTxt = r.current_vertical === null || r.current_vertical === undefined ? '—' : `$${fmt(r.current_vertical,2)}`;
    return `
      <div style="background:${bg};border:${border};border-radius:10px;padding:10px">
        <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;flex-wrap:wrap;margin-bottom:8px">
          <div>
            <div style="font-size:14px;font-weight:800">${r.symbol}</div>
            <div style="font-size:10px;color:var(--muted)">${r.signal_date} → ${r.today_date}${r.run_back_days!=null ? ` · ${r.run_back_days}d back` : ''}</div>
          </div>
          <div style="text-align:right">
            <div style="font-size:12px;font-weight:800;color:${resultClr}">${resultTxt}</div>
            <div style="font-size:10px;color:var(--muted)">score ${r.score ?? 0}</div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;font-size:11px">
          <div><div style="color:var(--muted)">Signal Price</div><div style="font-weight:700">$${fmt(r.signal_price,2)}</div></div>
          <div><div style="color:var(--muted)">Exit Price</div><div style="font-weight:700">$${fmt(r.today_price,2)}</div></div>
          <div><div style="color:var(--muted)">Move / Momentum</div><div style="font-weight:700;color:${r.momentum_hit ? '#22c55e' : '#94a3b8'}">${fmt(r.pct_change,2)}% · ${r.momentum_hit ? 'YES' : 'NO'}</div></div>
          <div><div style="color:var(--muted)">Directional pts</div><div style="font-weight:700;color:${(r.directional_points||0)>=5?'#22c55e':(r.directional_points||0)>=1?'#f59e0b':'#94a3b8'}">${fmt(r.directional_points,2)}</div></div>
          <div><div style="color:var(--muted)">Red Signal</div><div style="font-weight:700;color:${r.red_signal ? '#ef4444' : '#94a3b8'}">${redTag}</div></div>
          <div><div style="color:var(--muted)">Direction</div><div style="font-weight:700">${r.direction || '—'}</div></div>
          <div><div style="color:var(--muted)">Trade</div><div style="font-weight:700">${r.trade_type || '—'} · ${r.width || '—'}w</div></div>
          <div><div style="color:var(--muted)">Expiry</div><div style="font-weight:700">${r.expiry || '—'}</div></div>
          <div><div style="color:var(--muted)">Strikes</div><div style="font-weight:700">${strikeTxt}</div></div>
          <div><div style="color:var(--muted)">Entry Vertical</div><div style="font-weight:700">${entryTxt}</div></div>
          <div><div style="color:var(--muted)">Exit / Current Vertical</div><div style="font-weight:700">${nowTxt}</div></div>
          <div><div style="color:var(--muted)">P/L</div><div style="font-weight:700;color:${r.pnl >= 0 ? '#22c55e' : '#ef4444'}">${pnlTxt}</div></div>
          <div><div style="color:var(--muted)">Outcome</div><div style="font-weight:700;color:${resultClr}">${resultTxt} <span style="color:var(--muted);font-weight:500">${r.value_note || ''}</span></div></div>
        </div>
        <div style="margin-top:8px;font-size:10px;color:var(--muted);line-height:1.4">
          RSI ${r.rsi14 ?? '—'} · RSI-EMA90 diff ${r.rsi_diff ?? '—'} · MACD ${r.macd ?? '—'} / ${r.macd_signal ?? '—'} · ADX ${r.adx ?? '—'} · +DI ${r.pdi ?? '—'} / -DI ${r.ndi ?? '—'}
        </div>
        ${r.mode === 'composite' ? `<div style="margin-top:4px;font-size:10px;color:var(--muted);line-height:1.4">Market ${r.market_bias || '—'} · Sector ${r.sector_bias || '—'} · OI ${r.oi_bias || '—'} · S/R ${r.sr_bias || '—'}</div>` : ''}
      </div>`;
  }).join('');
}

async function _mbtLoadRuns() {
  const st = document.getElementById('mbt-saved-status');
  const scanner = document.getElementById('mb-ana-scanner')?.value || '';
  const runDate = document.getElementById('mb-ana-date')?.value || '';
  const name = document.getElementById('mb-ana-name')?.value || '';
  const params = new URLSearchParams({ limit: '20' });
  if (scanner) params.set('scanner', scanner);
  if (runDate) params.set('run_date', runDate);
  if (name) params.set('backtest_name', name);
  try {
    const d = await api(`/analysis/backtest_runs?${params.toString()}`);
    const runs = d.runs || [];
    if (st) st.innerHTML = `✅ Loaded ${runs.length} saved run${runs.length===1?'':'s'}`;
    const box = document.getElementById('mbt-run-list');
    if (!box) return;
    if (!runs.length) {
      box.innerHTML = `<div style="color:var(--muted);font-size:12px">No saved runs match the current filters.</div>`;
      return;
    }
    box.innerHTML = runs.map(r => `
      <div style="border:1px solid var(--border);border-radius:8px;padding:10px;background:var(--surface)">
        <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">
          <div>
            <div style="font-weight:800">${r.backtest_name || '(unnamed run)'}</div>
            <div style="font-size:10px;color:var(--muted)">${(r.scanner || '').toUpperCase()} · ${r.run_date || '—'} · saved ${r.saved_at || '—'}</div>
          </div>
          <div style="text-align:right;font-size:11px;color:var(--muted)">
            <div>Win rate: <b style="color:${((JSON.parse(r.stats_json||'{}').win_rate||0) >= 50) ? '#22c55e' : '#ef4444'}">${JSON.parse(r.stats_json||'{}').win_rate || 0}%</b></div>
            <div>Signals: <b>${JSON.parse(r.stats_json||'{}').signals || 0}</b></div>
            <div>Avg PnL: <b>${'$' + fmt(JSON.parse(r.stats_json||'{}').avg_pnl || 0, 2)}</b></div>
          </div>
        </div>
      </div>`).join('');
  } catch (e) {
    if (st) st.innerHTML = `❌ ${e.message}`;
  }
}

async function _mbtAnalyzeRuns() {
  const st = document.getElementById('mbt-saved-status');
  const scanner = document.getElementById('mb-ana-scanner')?.value || '';
  const runDate = document.getElementById('mb-ana-date')?.value || '';
  const name = document.getElementById('mb-ana-name')?.value || '';
  const params = new URLSearchParams({ limit: '25' });
  if (scanner) params.set('scanner', scanner);
  if (runDate) params.set('run_date', runDate);
  if (name) params.set('backtest_name', name);
  try {
    const d = await api(`/analysis/backtest_analyze?${params.toString()}`);
    if (st) st.innerHTML = `✅ Analysis ready: ${d.summary?.matched_runs || 0} run(s)`;
    const box = document.getElementById('mbt-saved-analysis');
    if (!box) return;
    const runs = d.runs || [];
    box.style.display = '';
    box.innerHTML = `
      <div class="card" style="padding:12px;margin-top:6px">
        <div style="font-size:12px;font-weight:700;margin-bottom:8px">Saved run analysis</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin-bottom:10px">
          ${[
            {l:'Matched runs',v:d.summary?.matched_runs||0},
            {l:'Signals',v:d.summary?.signals||0},
            {l:'Winners',v:d.summary?.winners||0},
            {l:'Losers',v:d.summary?.losers||0},
            {l:'Win rate',v:(d.summary?.win_rate||0)+'%'},
          ].map(x=>`<div style="background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:8px"><div style="font-size:9px;color:var(--muted)">${x.l}</div><div style="font-size:14px;font-weight:800">${x.v}</div></div>`).join('')}
        </div>
        <div style="margin-bottom:10px"><b>Suggestions</b><div style="font-size:11px;color:var(--muted);line-height:1.5">${(d.suggestions||[]).map(x=>`• ${x}`).join('<br>')}</div></div>
        <div style="font-size:12px;font-weight:700;margin-bottom:8px">Run detail</div>
        <div style="display:grid;gap:8px">${runs.map(r=>`<div style="border:1px solid var(--border);border-radius:6px;padding:8px;background:var(--surface)">
          <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">
            <div><b>${r.run?.backtest_name || '(unnamed)'}</b> <span style="color:var(--muted)">${(r.run?.scanner || '').toUpperCase()} · ${r.run?.run_date || '—'}</span></div>
            <div style="color:${(r.win_rate||0)>=50?'#22c55e':'#ef4444'};font-weight:800">${r.win_rate || 0}% win</div>
          </div>
          <div style="font-size:11px;color:var(--muted);margin-top:4px">Signals ${r.signals} · Winners ${r.winners} · Losers ${r.losers} · Avg PnL $${fmt(r.avg_pnl||0,2)}</div>
        </div>`).join('')}</div>
      </div>`;
  } catch (e) {
    if (st) st.innerHTML = `❌ ${e.message}`;
  }
}


// ── Candidate Board ────────────────────────────────────────────────────────
function _cbNormalizeDir(v) {
  const s = String(v || '').toUpperCase();
  if (/(BULL|LONG|CALL|BUY)/.test(s)) return 'BULLISH';
  if (/(BEAR|SHORT|PUT|SELL)/.test(s)) return 'BEARISH';
  return 'NEUTRAL';
}
function _cbScore(v) {
  const n = Number.parseFloat(v);
  return Number.isFinite(n) ? n : 0;
}
function _cbBestLabel(r) {
  const label = r.setup_type || r.setup || r.source || 'Setup';
  return String(label).replace(/_/g, ' ');
}
function _cbScoreChip(label, value, color) {
  return `<span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:999px;border:1px solid ${color}44;background:${color}18;color:${color};font-size:11px;font-weight:700;white-space:nowrap">${label} ${value}</span>`;
}
function _cbRow(a) {
  const best = a.bestRow || {};
  const dirColor = a.direction === 'BULLISH' ? '#22c55e' : '#ef4444';
  const dirIcon  = a.direction === 'BULLISH' ? '↑' : '↓';
  const setups = [...(a.setups || [])].slice(0, 4).map(s => _cbScoreChip(s, '', '#818cf8')).join(' ');
  const scanners = [...(a.scanners || [])].slice(0, 4).join(' · ');
  const bestSetup = _cbBestLabel(best);
  const age = best.trend_age ?? a.trend_age ?? '—';
  return `<tr>
    <td style="padding:7px 10px;font-weight:800;color:var(--accent)">${a.symbol}</td>
    <td style="padding:7px 10px;white-space:nowrap"><span style="color:${dirColor};font-weight:800">${dirIcon} ${a.direction}</span></td>
    <td style="padding:7px 10px;font-size:12px;font-weight:800;color:${a.conviction>=85?'#22c55e':a.conviction>=70?'#f59e0b':'#ef4444'}">${a.conviction}</td>
    <td style="padding:7px 10px;font-size:12px">${a.consensus}/${a.scanners.size || 0}</td>
    <td style="padding:7px 10px;font-size:11px;white-space:nowrap;max-width:220px;overflow:hidden;text-overflow:ellipsis">${scanners || '—'}</td>
    <td style="padding:7px 10px;font-size:11px;white-space:normal;min-width:220px;line-height:1.45">${setups || '—'}</td>
    <td style="padding:7px 10px;font-size:11px;white-space:nowrap">${best.source || '—'} · ${bestSetup}</td>
    <td style="padding:7px 10px;font-size:11px;min-width:260px">${_edgeScoreCell(best)}</td>
    <td style="padding:7px 10px;font-size:11px;white-space:nowrap">${age ?? '—'}</td>
  </tr>`;
}
function _cbTable(title, rows, emptyText) {
  if (!rows.length) return `<div style="color:var(--muted);font-size:12px;padding:12px">${emptyText || 'No candidates found.'}</div>`;
  return `<div class="tbl-wrap" style="margin-top:0"><table class="data-tbl"><thead><tr>
    <th>Symbol</th><th>Direction</th><th>Conviction</th><th>Consensus</th><th>Scanners</th><th>Setups</th><th>Best Setup</th><th>Edge Scores</th><th>Age</th>
  </tr></thead><tbody>${rows.map(_cbRow).join('')}</tbody></table></div>`;
}
async function _cbLoadWatchlists() {
  const sel = document.getElementById('cb-watchlist');
  if (!sel) return;
  try {
    const d = await api('/watchlists/');
    const wls = (d && d.watchlists) ? d.watchlists : [];
    const stored = _getScannerWatchlistId();
    sel.innerHTML = '<option value="">Default (symbols table)</option>' +
      wls.map(w => `<option value="${w.id}"${w.is_default?' selected':''}>${w.is_default?'⭐ ':''}${w.name} (${w.symbol_count})</option>`).join('');
    if (stored && [...sel.options].some(o => String(o.value) === String(stored))) sel.value = String(stored);
    await _cbWatchlistChange(false);
  } catch (e) { console.warn('candidate board watchlist load:', e.message); }
}
async function _cbWatchlistChange(save=true) {
  const sel = document.getElementById('cb-watchlist');
  const cnt = document.getElementById('cb-wl-count');
  const wlId = sel ? sel.value : '';
  if (save) _setScannerWatchlistId(wlId);
  if (!wlId) { if (cnt) cnt.textContent = ''; return; }
  try {
    const d = await api(`/watchlists/${wlId}/symbols`);
    if (cnt) cnt.textContent = `→ ${d.count} symbols`;
  } catch (e) { if (cnt) cnt.textContent = ''; }
}
async function runCandidateBoard() {
  const st = document.getElementById('cb-status');
  const sumEl = document.getElementById('cb-summary');
  const longsEl = document.getElementById('cb-longs');
  const shortsEl = document.getElementById('cb-shorts');
  const wlId = document.getElementById('cb-watchlist')?.value || _getScannerWatchlistId() || '';
  const minConv = Number.parseFloat(document.getElementById('cb-min-score')?.value || '70') || 70;
  const minCons = Number.parseInt(document.getElementById('cb-min-consensus')?.value || '2', 10) || 2;
  if (st) st.innerHTML = '⏳ Building candidate board…';
  if (sumEl) sumEl.innerHTML = '';
  if (longsEl) longsEl.innerHTML = '<div style="color:var(--muted);padding:12px">Loading…</div>';
  if (shortsEl) shortsEl.innerHTML = '<div style="color:var(--muted);padding:12px">Loading…</div>';
  _setScannerWatchlistId(wlId);
  const mk = (path) => {
    const u = new URL(path, location.origin);
    if (wlId) u.searchParams.set('watchlist_id', wlId);
    return u.pathname + '?' + u.searchParams.toString();
  };
  const fetches = [
    ['Maya', api(mk('/maya/api/scanner') + '&mode=core&min_score=55&trade_type=any&bias=any&strictness=2&use_rsi=1&use_dmi=1&use_ema=1&use_macd=1&use_squeeze=0')],
    ['S/R Breakout', api(mk('/scanner/sr/scan') + '&min_strength=35&require_momentum=true')],
    ['Momentum Retrace', api(mk('/api/scanner/momentum_retrace') + '&lookback=15&move_pct=6&rsi_peak=68&rsi_trough=32&delta_rsi=18&retrace_min=3&retrace_max=8&recovery_days=5')],
    ['RSI MTF', api(mk('/api/scanner/rsi_mtf'))],
    ['Trend Exhaustion', api(mk('/api/scanner/momentum_retrace_exhaustion') + '&lookback_days=20&rsi_hi=68&rsi_lo=32&diff_thr=20&min_bounce_pct=4&min_second_bars=1&exhaust_tf=1d&pullback_tf=1h')],
  ];
  const settled = await Promise.allSettled(fetches.map(x => x[1]));
  const named = settled.map((s, i) => ({ name: fetches[i][0], s }));
  const flat = [];
  const addRows = (rows, source) => {
    (rows || []).forEach(r => {
      const dir = _cbNormalizeDir(r.direction || r.bias || r.trade_side || r.setup || r.signal || '');
      if (dir === 'NEUTRAL') return;
      flat.push({
        symbol: String(r.symbol || '').toUpperCase(),
        direction: dir,
        source,
        setup: r.setup_type || r.setup || source,
        final_score: _cbScore(r.final_score ?? r.score ?? r.native_score ?? r.composite_score),
        native_score: _cbScore(r.native_score ?? r.score),
        composite_score: _cbScore(r.composite_score ?? r.edge_score),
        rs_score: _cbScore(r.rs_score),
        vol_score: _cbScore(r.vol_score),
        sector_score: _cbScore(r.sector_score),
        institutional_score: _cbScore(r.institutional_score),
        expected_move_score: _cbScore(r.expected_move_score),
        trend_age: r.trend_age ?? r.days_ago ?? null,
        raw: r,
      });
    });
  };
  named.forEach(({name,s}) => {
    if (s.status !== 'fulfilled') return;
    const d = s.value || {};
    if (name === 'Maya') addRows(d.results || [], name);
    else if (name === 'S/R Breakout') addRows(d.results || [], name);
    else if (name === 'Momentum Retrace') addRows((d.bulls || []).concat(d.bears || []), name);
    else if (name === 'RSI MTF') addRows((d.bulls || []).concat(d.bears || []), name);
    else if (name === 'Trend Exhaustion') addRows((d.bulls || []).concat(d.bears || []), name);
  });
  const groups = new Map();
  for (const r of flat) {
    const key = `${r.symbol}|${r.direction}`;
    if (!groups.has(key)) groups.set(key, {
      symbol: r.symbol,
      direction: r.direction,
      hits: 0,
      scanners: new Set(),
      setups: new Set(),
      scoreSum: 0,
      scoreMax: 0,
      rsSum: 0,
      volSum: 0,
      secSum: 0,
      instSum: 0,
      emSum: 0,
      ageSum: 0,
      ageCount: 0,
      rows: [],
      bestRow: null,
    });
    const g = groups.get(key);
    g.hits += 1;
    g.scanners.add(r.source);
    g.setups.add(r.setup);
    g.scoreSum += r.final_score;
    g.scoreMax = Math.max(g.scoreMax, r.final_score);
    g.rsSum += r.rs_score || 0;
    g.volSum += r.vol_score || 0;
    g.secSum += r.sector_score || 0;
    g.instSum += r.institutional_score || 0;
    g.emSum += r.expected_move_score || 0;
    if (r.trend_age != null && !Number.isNaN(Number(r.trend_age))) { g.ageSum += Number(r.trend_age); g.ageCount += 1; }
    g.rows.push(r);
    if (!g.bestRow || r.final_score > g.bestRow.final_score) g.bestRow = r;
  }
  const agg = [...groups.values()].map(g => {
    const consensus = g.scanners.size;
    const avg = g.hits ? g.scoreSum / g.hits : 0;
    const conviction = Math.min(100, Math.round(avg + (consensus - 1) * 6 + (g.setups.size - 1) * 2 + Math.min(8, g.hits - 1)));
    return {
      ...g,
      consensus,
      conviction,
      avgScore: avg,
      rs: g.hits ? g.rsSum / g.hits : 0,
      vol: g.hits ? g.volSum / g.hits : 0,
      sector: g.hits ? g.secSum / g.hits : 0,
      inst: g.hits ? g.instSum / g.hits : 0,
      em: g.hits ? g.emSum / g.hits : 0,
      trend_age: g.ageCount ? Math.round(g.ageSum / g.ageCount) : (g.bestRow?.trend_age ?? '—'),
    };
  }).filter(g => g.conviction >= minConv && g.consensus >= minCons && g.symbol);
  const longs = agg.filter(g => g.direction === 'BULLISH').sort((a,b)=>b.conviction-a.conviction || b.consensus-a.consensus || b.avgScore-a.avgScore).slice(0, 20);
  const shorts = agg.filter(g => g.direction === 'BEARISH').sort((a,b)=>b.conviction-a.conviction || b.consensus-a.consensus || b.avgScore-a.avgScore).slice(0, 20);
  const okCount = named.filter(x => x.s.status === 'fulfilled').length;
  const failCount = named.length - okCount;
  if (st) st.innerHTML = `✅ ${longs.length} longs · ${shorts.length} shorts · ${okCount}/${named.length} sources` + (failCount ? ` · ⚠ ${failCount} source(s) failed` : '');
  if (sumEl) {
    const total = agg.length;
    const avgConv = total ? Math.round(agg.reduce((a,b)=>a+b.conviction,0) / total) : 0;
    sumEl.innerHTML = [
      {l:'Candidates', v: total},
      {l:'Longs', v: longs.length},
      {l:'Shorts', v: shorts.length},
      {l:'Avg Conviction', v: avgConv},
      {l:'Consensus ≥'+minCons, v: agg.filter(g => g.consensus >= minCons).length},
    ].map(x => `<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:8px 10px"><div style="font-size:10px;color:var(--muted)">${x.l}</div><div style="font-size:16px;font-weight:800">${x.v}</div></div>`).join('');
  }
  if (longsEl) longsEl.innerHTML = _cbTable('Top Longs', longs, 'No long candidates matched the current filters.');
  if (shortsEl) shortsEl.innerHTML = _cbTable('Top Shorts', shorts, 'No short candidates matched the current filters.');
}

// Explicit global exports for inline handlers
window.jrnAddTrade = jrnAddTrade;
window._jrnAddLeg = _jrnAddLeg;
window._jrnClearLegs = _jrnClearLegs;
window._jrnTemplate = _jrnTemplate;
window._jrnTypeChanged = _jrnTypeChanged;
window._taAddLeg = _taAddLeg;
window._taTemplate = _taTemplate;
window._taAnalyze = _taAnalyze;
window._loadTradeAnalysis = _loadTradeAnalysis;
window.runCandidateBoard = runCandidateBoard;
window._cbLoadWatchlists = _cbLoadWatchlists;
window._cbWatchlistChange = _cbWatchlistChange;


// ════════════════════════════════════════════════════════════════════════════
// ALERT HUB REDESIGN — watchlist / symbol / primitive / combo alerts
// ════════════════════════════════════════════════════════════════════════════

let _alertsPicklists = {watchlists: [], symbols: []};
let _alertsRulesCache = [];

function _alertsRuleScopeText(rule) {
  const wl = (rule.watchlist_name || '').trim();
  const sym = (rule.symbol || '').trim();
  if (wl && sym) return `${wl} · ${sym}`;
  if (wl) return wl;
  if (sym) return sym;
  return 'All symbols';
}

function _alertTriggerModeLabel(mode) {
  const m = String(mode || 'daily').toLowerCase();
  if (m === 'once') return 'One time only';
  if (m === 'on_change') return 'On change + daily cap';
  if (m === 'every_run') return 'Every run';
  return 'Once per symbol per day';
}

function _alertsRuleConditionText(rule) {
  if ((rule.alert_kind || 'price') === 'price') {
    const op = rule.price_operator || '>=';
    const v = rule.price_value == null ? '' : rule.price_value;
    return `Price ${op} ${v}`;
  }
  const q = (rule.condition_text || '').trim();
  return q || '—';
}

function _alertsBuilderMode() {
  return (document.getElementById('alert-rule-kind')?.value || 'price').toLowerCase();
}

function _alertsUpdateBuilderVisibility() {
  const kind = _alertsBuilderMode();
  const priceRow = document.getElementById('alert-rule-price-row');
  const exprRow = document.getElementById('alert-rule-expr-row');
  if (priceRow) priceRow.style.display = kind === 'price' ? 'grid' : 'none';
  if (exprRow) exprRow.style.display = kind === 'price' ? 'none' : 'block';
}


// ── Alert Hub scanner-expression autocomplete and parameter help ───────────
let _alertScannerCatalog = {saved_scanners: [], builtin_scanners: [], functions: [], function_meta: []};
let _alertFunctionCatalog = [];
let _alertAutocompleteItems = [];
let _alertAutocompleteIndex = -1;
let _alertAutocompleteWired = false;
let _alertCatalogPromise = null;

function _alertHtmlEscape(v) {
  return String(v ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function _alertConditionTextArea() {
  return document.getElementById('alert-rule-condition');
}

function _alertSetBuilderStatus(msg) {
  const st = document.getElementById('alerts-builder-status');
  if (st && msg) st.textContent = msg;
}

function _alertScannerSnippet(x) {
  const raw = String(x && x.query_text || '').trim();
  return raw || `scan(${x && x.name ? x.name : ''})`;
}

function _alertAllScannerEntries() {
  const saved = (_alertScannerCatalog.saved_scanners || []).map(s => ({
    name: s.name,
    category: 'Saved',
    description: s.description || s.query_text || '',
    query_text: s.query_text || '',
  }));
  const builtins = (_alertScannerCatalog.builtin_scanners || []).map(s => ({...s, query_text: s.query_text || ''}));
  const seen = new Set();
  return [...saved, ...builtins].filter(x => {
    const k = String(x.name || '').toLowerCase();
    if (!k || seen.has(k)) return false;
    seen.add(k);
    return true;
  });
}

function _alertAllFunctionEntries() {
  const source = _alertFunctionCatalog && _alertFunctionCatalog.length
    ? _alertFunctionCatalog
    : ((_alertScannerCatalog.functions || []).map(s => ({name: String(s).split('(')[0], signature: s, description: 'Built-in primitive'})));
  const seen = new Set();
  return source.map(x => ({
    name: x.name || String(x.signature || '').split('(')[0],
    signature: x.signature || `${x.name || String(x.signature || '').split('(')[0]}()`,
    description: x.description || 'Scanner Builder primitive',
    category: x.category || 'Primitive',
  })).filter(x => {
    const k = String(x.name || '').toLowerCase();
    if (!k || seen.has(k)) return false;
    seen.add(k);
    return true;
  });
}

async function _alertLoadScannerCatalog() {
  if (_alertCatalogPromise) return _alertCatalogPromise;
  _alertCatalogPromise = api('/scanner-builder/api/catalog')
    .then(d => {
      _alertScannerCatalog = d || _alertScannerCatalog;
      _alertFunctionCatalog = _alertScannerCatalog.function_meta || (_alertScannerCatalog.functions || []).map(s => ({name: String(s).split('(')[0], signature: s, description: 'Built-in primitive'}));
      _alertUpdateFunctionHelp();
      return _alertScannerCatalog;
    })
    .catch(e => {
      console.warn('Alert Hub scanner catalog unavailable', e);
      _alertSetBuilderStatus('Scanner autocomplete unavailable');
      return _alertScannerCatalog;
    });
  return _alertCatalogPromise;
}

function _alertCurrentAutocompleteRange(ta) {
  const cursor = ta.selectionStart ?? ta.value.length;
  const end = ta.selectionEnd ?? cursor;
  if (end !== cursor) return {mode:'selection', start: cursor, end};
  const before = ta.value.slice(0, cursor);
  const scanMatch = before.match(/scan\(\s*([A-Za-z0-9_\- ]*)$/i);
  if (scanMatch) return {mode:'scan', start: before.length - scanMatch[0].length, end: cursor};
  const fnParen = before.match(/([A-Za-z_][A-Za-z0-9_]*)\($/);
  if (fnParen) return {mode:'function', start: before.length - fnParen[0].length, end: cursor};
  const token = before.match(/([A-Za-z_][A-Za-z0-9_]*)$/);
  if (token) return {mode:'function', start: before.length - token[0].length, end: cursor};
  return {mode:'insert', start: cursor, end: cursor};
}

function _alertReplaceAutocompleteFragment(text, statusMessage, cursorOffset = null) {
  const ta = _alertConditionTextArea();
  if (!ta) return;
  const range = _alertCurrentAutocompleteRange(ta);
  ta.value = ta.value.slice(0, range.start) + text + ta.value.slice(range.end);
  const pos = range.start + (cursorOffset == null ? text.length : cursorOffset);
  ta.setSelectionRange(pos, pos);
  ta.focus();
  _alertSetBuilderStatus(statusMessage || 'Inserted');
  _alertShowAutocomplete();
  _alertUpdateFunctionHelp();
}

function _alertInsertScannerCall(name) {
  _alertReplaceAutocompleteFragment(`scan(${name})`, `Inserted scan(${name})`);
}

function _alertInsertFunctionCall(name) {
  const call = `${name}()`;
  _alertReplaceAutocompleteFragment(call, `Inserted ${call}`, name.length + 1);
}

function _alertCurrentTokenBeforeCursor(text, cursor) {
  const before = text.slice(0, cursor);
  const scanMatch = before.match(/scan\(\s*([A-Za-z0-9_\- ]*)$/i);
  if (scanMatch) return {mode:'scan', typed:(scanMatch[1] || '').trim().toLowerCase()};
  const fnParen = before.match(/([A-Za-z_][A-Za-z0-9_]*)\($/);
  if (fnParen) return {mode:'function', typed:fnParen[1].toLowerCase()};
  const token = before.match(/([A-Za-z_][A-Za-z0-9_]*)$/);
  if (token) return {mode:'function', typed:token[1].toLowerCase()};
  return {mode:'none', typed:''};
}

function _alertRenderAutocompleteSelection() {
  const panel = document.getElementById('alert-rule-autocomplete');
  if (!panel) return;
  panel.querySelectorAll('.scanner-autocomplete-item').forEach(el => {
    el.classList.toggle('selected', Number(el.dataset.idx || -1) === _alertAutocompleteIndex);
  });
}

function _alertChooseAutocomplete(delta = 0) {
  if (!_alertAutocompleteItems.length) return false;
  _alertAutocompleteIndex = Math.max(0, Math.min(_alertAutocompleteItems.length - 1, _alertAutocompleteIndex + delta));
  _alertRenderAutocompleteSelection();
  return true;
}

function _alertCommitAutocomplete() {
  if (!_alertAutocompleteItems.length) return false;
  const item = _alertAutocompleteItems[Math.max(0, _alertAutocompleteIndex)] || _alertAutocompleteItems[0];
  if (!item) return false;
  if (item.kind === 'function') _alertInsertFunctionCall(item.name);
  else _alertReplaceAutocompleteFragment(_alertScannerSnippet(item), 'Inserted scanner code block');
  const panel = document.getElementById('alert-rule-autocomplete');
  if (panel) panel.style.display = 'none';
  return true;
}

function _alertShowAutocomplete(forceAll = false) {
  const ta = _alertConditionTextArea();
  const panel = document.getElementById('alert-rule-autocomplete');
  if (!ta || !panel) return;
  const token = _alertCurrentTokenBeforeCursor(ta.value, ta.selectionStart ?? ta.value.length);
  const mode = token.mode;
  const typed = token.typed || '';
  if (mode !== 'scan' && mode !== 'function' && !forceAll) {
    panel.style.display = 'none';
    panel.innerHTML = '';
    _alertAutocompleteItems = [];
    _alertAutocompleteIndex = -1;
    _alertUpdateFunctionHelp();
    return;
  }
  let entries = [];
  if (mode === 'scan' || forceAll) {
    entries = _alertAllScannerEntries()
      .filter(x => !typed || String(x.name || '').toLowerCase().includes(typed))
      .slice(0, 20)
      .map(x => ({...x, kind:'scanner'}));
  }
  if (mode === 'function' || (forceAll && !entries.length)) {
    const fnEntries = _alertAllFunctionEntries()
      .filter(x => !typed || String(x.name || '').toLowerCase().startsWith(typed))
      .slice(0, 24)
      .map(x => ({...x, kind:'function'}));
    entries = mode === 'function' ? fnEntries : entries.concat(fnEntries);
  }
  if (!entries.length) {
    panel.style.display = 'none';
    panel.innerHTML = '';
    _alertAutocompleteItems = [];
    _alertAutocompleteIndex = -1;
    _alertUpdateFunctionHelp();
    return;
  }
  _alertAutocompleteItems = entries;
  _alertAutocompleteIndex = 0;
  panel.innerHTML = entries.map((x, idx) => {
    if (x.kind === 'function') {
      return `<div class="scanner-autocomplete-item ${idx === _alertAutocompleteIndex ? 'selected' : ''}" data-idx="${idx}">
        <div style="min-width:0"><b>${_alertHtmlEscape(x.name)}</b> <span style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.signature || '')}</span><div style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.description || 'Primitive')}</div></div>
        <button type="button" class="btn btn-ghost btn-sm" data-action="insert-fn" data-name="${_alertHtmlEscape(x.name)}">fn()</button>
      </div>`;
    }
    return `<div class="scanner-autocomplete-item ${idx === _alertAutocompleteIndex ? 'selected' : ''}" data-idx="${idx}">
      <div style="min-width:0"><b>${_alertHtmlEscape(x.name)}</b><div style="color:var(--muted);font-size:11px">${_alertHtmlEscape(x.category || 'Scanner')}</div><pre class="scanner-code">${_alertHtmlEscape(_alertScannerSnippet(x))}</pre></div>
      <div style="display:flex;gap:6px;flex-shrink:0"><button type="button" class="btn btn-ghost btn-sm" data-action="code" data-name="${_alertHtmlEscape(x.name)}">code</button><button type="button" class="btn btn-ghost btn-sm" data-action="ref" data-name="${_alertHtmlEscape(x.name)}">scan()</button></div>
    </div>`;
  }).join('');
  panel.style.display = 'block';
  panel.querySelectorAll('.scanner-autocomplete-item').forEach(el => {
    el.addEventListener('mouseenter', () => {
      _alertAutocompleteIndex = Number(el.dataset.idx || 0);
      _alertRenderAutocompleteSelection();
    });
    el.addEventListener('mousedown', e => {
      const btn = e.target.closest('button[data-action]');
      if (btn) return;
      e.preventDefault();
      const item = _alertAutocompleteItems[Number(el.dataset.idx || 0)];
      if (!item) return;
      if (item.kind === 'function') _alertInsertFunctionCall(item.name);
      else _alertReplaceAutocompleteFragment(_alertScannerSnippet(item), 'Inserted scanner code block');
      panel.style.display = 'none';
    });
  });
  panel.querySelectorAll('button[data-action]').forEach(btn => btn.addEventListener('mousedown', e => {
    e.preventDefault();
    const item = _alertAutocompleteItems.find(x => String(x.name) === String(btn.dataset.name));
    if (!item) return;
    if (item.kind === 'function' || btn.dataset.action === 'insert-fn') _alertInsertFunctionCall(item.name);
    else if (btn.dataset.action === 'ref') _alertInsertScannerCall(item.name);
    else _alertReplaceAutocompleteFragment(_alertScannerSnippet(item), 'Inserted scanner code block');
    panel.style.display = 'none';
  }));
  _alertUpdateFunctionHelp();
}

function _alertSignatureParams(signature) {
  const sig = String(signature || '');
  const m = sig.match(/^[^(]+\((.*)\)$/);
  if (!m) return [];
  const inside = m[1].replace(/[\[\]]/g, '');
  if (!inside.trim()) return [];
  return inside.split(',').map(p => p.trim()).filter(Boolean);
}

function _alertFindActiveFunction(text, cursor) {
  let depth = 0;
  let quote = null;
  for (let i = cursor - 1; i >= 0; i--) {
    const ch = text[i];
    if (quote) {
      if (ch === quote && text[i - 1] !== '\\') quote = null;
      continue;
    }
    if (ch === '"' || ch === "'") { quote = ch; continue; }
    if (ch === ')') { depth++; continue; }
    if (ch === '(') {
      if (depth > 0) { depth--; continue; }
      let j = i - 1;
      while (j >= 0 && /\s/.test(text[j])) j--;
      const end = j + 1;
      while (j >= 0 && /[A-Za-z0-9_]/.test(text[j])) j--;
      const name = text.slice(j + 1, end);
      if (!name) return null;
      const inner = text.slice(i + 1, cursor);
      let paramIndex = 0, d = 0, q = null;
      for (let k = 0; k < inner.length; k++) {
        const c = inner[k];
        if (q) {
          if (c === q && inner[k - 1] !== '\\') q = null;
          continue;
        }
        if (c === '"' || c === "'") { q = c; continue; }
        if (c === '(' || c === '[') d++;
        else if (c === ')' || c === ']') d = Math.max(0, d - 1);
        else if (c === ',' && d === 0) paramIndex++;
      }
      return {name, paramIndex, inner, start:j + 1, open:i};
    }
  }
  return null;
}

function _alertUpdateFunctionHelp() {
  const hint = document.getElementById('alert-rule-func-hint');
  const ta = _alertConditionTextArea();
  if (!hint || !ta) return;
  const text = ta.value || '';
  const cursor = ta.selectionStart ?? text.length;
  const active = _alertFindActiveFunction(text, cursor);
  let meta = null;
  let paramIndex = 0;
  if (active) {
    paramIndex = active.paramIndex;
    meta = _alertAllFunctionEntries().find(x => String(x.name || '').toLowerCase() === String(active.name || '').toLowerCase());
  } else {
    const tok = _alertCurrentTokenBeforeCursor(text, cursor);
    if (tok.mode === 'function' && tok.typed) {
      meta = _alertAllFunctionEntries().find(x => String(x.name || '').toLowerCase().startsWith(tok.typed));
    }
  }
  if (!meta) {
    hint.innerHTML = 'Type a primitive name, choose one from autocomplete, or place your cursor inside a function to see parameter help.';
    return;
  }
  const params = _alertSignatureParams(meta.signature);
  const current = params.length ? params[Math.min(paramIndex, params.length - 1)] : 'value';
  const paramHtml = params.length ? `<div>${params.map((p, i) => `<span class="param ${active && i === Math.min(paramIndex, params.length - 1) ? 'active' : ''}">${i + 1}. ${_alertHtmlEscape(p)}</span>`).join('')}</div>` : '';
  hint.innerHTML = `<b>${_alertHtmlEscape(meta.name)}</b> <span class="dim">${_alertHtmlEscape(meta.signature || '')}</span><br><span>${_alertHtmlEscape(meta.description || '')}</span>${active ? `<br><span class="warn">Current parameter: ${_alertHtmlEscape(current)}</span>` : ''}${paramHtml}`;
}

function _alertInitConditionAutocomplete() {
  if (_alertAutocompleteWired) {
    _alertUpdateFunctionHelp();
    return;
  }
  const ta = _alertConditionTextArea();
  if (!ta) return;
  _alertAutocompleteWired = true;
  ta.addEventListener('input', () => { _alertShowAutocomplete(); _alertUpdateFunctionHelp(); });
  ta.addEventListener('keyup', () => { _alertShowAutocomplete(); _alertUpdateFunctionHelp(); });
  ta.addEventListener('click', () => { _alertShowAutocomplete(); _alertUpdateFunctionHelp(); });
  ta.addEventListener('keydown', e => {
    const panel = document.getElementById('alert-rule-autocomplete');
    const visible = panel && panel.style.display === 'block';
    if (e.shiftKey && e.key === 'Enter') {
      e.preventDefault();
      _alertOpenConditionAutocomplete();
      return;
    }
    if (visible && e.key === 'ArrowDown') { e.preventDefault(); _alertChooseAutocomplete(1); return; }
    if (visible && e.key === 'ArrowUp') { e.preventDefault(); _alertChooseAutocomplete(-1); return; }
    if (visible && e.key === 'Enter') { e.preventDefault(); _alertCommitAutocomplete(); return; }
    if (visible && e.key === 'Escape') { e.preventDefault(); panel.style.display = 'none'; return; }
  });
  ta.addEventListener('blur', () => setTimeout(() => {
    const panel = document.getElementById('alert-rule-autocomplete');
    if (panel) panel.style.display = 'none';
    _alertUpdateFunctionHelp();
  }, 160));
  _alertUpdateFunctionHelp();
}

function _alertOpenConditionAutocomplete() {
  const ta = _alertConditionTextArea();
  if (!ta) return;
  _alertLoadScannerCatalog().then(() => {
    ta.focus();
    _alertShowAutocomplete(true);
    _alertUpdateFunctionHelp();
  });
}

async function _loadAlertsPicklists() {
  const status = document.getElementById('alerts-builder-status');
  if (status) status.textContent = '⏳ Loading watchlists…';
  try {
    const wlSel = document.getElementById('alert-rule-watchlist');
    const watchlistId = wlSel && wlSel.value ? wlSel.value : '';
    const d = await api(`/watchlists/alerts/picklists${watchlistId ? `?watchlist_id=${encodeURIComponent(watchlistId)}` : ''}`);
    _alertsPicklists = {watchlists: d.watchlists || [], symbols: d.symbols || []};
    if (wlSel) {
      const current = wlSel.value;
      wlSel.innerHTML = '<option value="">Entire watchlist / none</option>' + _alertsPicklists.watchlists.map(w => `<option value="${w.id}">${(w.name || '—')}</option>`).join('');
      if (current) wlSel.value = current;
    }
    const symList = document.getElementById('alerts-symbol-list');
    if (symList) {
      symList.innerHTML = _alertsPicklists.symbols.map(s => `<option value="${s}"></option>`).join('');
    }
    const symInput = document.getElementById('alert-rule-symbol');
    if (symInput) uc(symInput);
    if (status) status.textContent = `${_alertsPicklists.watchlists.length} watchlists · ${_alertsPicklists.symbols.length} symbols`;
  } catch (e) {
    if (status) status.textContent = 'Error loading watchlists';
  }
}

function _alertsResetBuilder() {
  const ids = ['alert-rule-id','alert-rule-symbol','alert-rule-price-value','alert-rule-condition','alert-rule-notes'];
  ids.forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  const wl = document.getElementById('alert-rule-watchlist'); if (wl) wl.value = '';
  const kind = document.getElementById('alert-rule-kind'); if (kind) kind.value = 'price';
  const mode = document.getElementById('alert-rule-trigger-mode'); if (mode) mode.value = 'daily';
  const tf = document.getElementById('alert-rule-timeframe'); if (tf) tf.value = '1d';
  const op = document.getElementById('alert-rule-price-op'); if (op) op.value = '>=';
  const en = document.getElementById('alert-rule-enabled'); if (en) en.checked = true;
  _alertsUpdateBuilderVisibility();
  _alertUpdateFunctionHelp();
}

function _alertsFillBuilder(rule) {
  if (!rule) return;
  const map = {
    'alert-rule-id': rule.id || '',
    'alert-rule-symbol': rule.symbol || '',
    'alert-rule-price-value': rule.price_value ?? '',
    'alert-rule-condition': rule.condition_text || '',
    'alert-rule-notes': rule.notes || '',
    'alert-rule-timeframe': rule.timeframe || '1d',
  };
  Object.entries(map).forEach(([id, val]) => { const el=document.getElementById(id); if (el) el.value = val; });
  const wl = document.getElementById('alert-rule-watchlist'); if (wl) wl.value = rule.watchlist_id || '';
  _loadAlertsPicklists();
  const kind = document.getElementById('alert-rule-kind'); if (kind) kind.value = rule.alert_kind || 'price';
  const mode = document.getElementById('alert-rule-trigger-mode'); if (mode) mode.value = rule.trigger_mode || 'daily';
  const op = document.getElementById('alert-rule-price-op'); if (op) op.value = rule.price_operator || '>=';
  const en = document.getElementById('alert-rule-enabled'); if (en) en.checked = !!Number(rule.enabled ?? 1);
  _alertsUpdateBuilderVisibility();
  _alertUpdateFunctionHelp();
  const root = document.getElementById('alerts-builder-card');
  if (root && 'open' in root) root.open = true;
  if (root) root.scrollIntoView({behavior:'smooth', block:'start'});
}

function _alertsRowHtml(r) {
  const enabled = !!Number(r.enabled ?? 1);
  return `<tr data-alert-rule-row="${r.id}" style="border-top:1px solid var(--border)">
    <td style="padding:8px;white-space:nowrap">
      <label style="display:flex;align-items:center;gap:6px"><input type="checkbox" ${enabled ? 'checked' : ''} onchange="_toggleAlertRule(${r.id}, this.checked)"/> <span>${enabled ? 'On' : 'Off'}</span></label>
    </td>
    <td style="padding:8px;font-weight:700">${_alertsRuleScopeText(r)}</td>
    <td style="padding:8px;text-transform:capitalize">${r.alert_kind || 'price'}</td>
    <td style="padding:8px">${_alertsRuleConditionText(r)}</td>
    <td style="padding:8px;white-space:nowrap">${_alertTriggerModeLabel(r.trigger_mode || 'daily')}</td>
    <td style="padding:8px;color:var(--muted);white-space:nowrap">${r.last_triggered_at || '—'}</td>
    <td style="padding:8px;white-space:nowrap;display:flex;gap:6px;flex-wrap:wrap">
      <button type="button" class="btn btn-ghost btn-sm" onclick="_testAlertRule(${r.id})">Test now</button>
      <button type="button" class="btn btn-ghost btn-sm" onclick="_editAlertRule(${r.id})">Edit</button>
      <button type="button" class="btn btn-ghost btn-sm" onclick="_deleteAlertRule(${r.id})">Delete</button>
    </td>
  </tr>`;
}

async function _loadAlertRulesHub() {
  const wrap = document.getElementById('alert-rules-wrap');
  const st = document.getElementById('alert-rules-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    const d = await api('/watchlists/alerts/rules?_=' + Date.now());
    const rows = d.rules || [];
    _alertsRulesCache = rows;
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No alerts yet.</div>';
      if (st) st.textContent = '0 alerts';
      return;
    }
    wrap.innerHTML = `<table style="width:100%;min-width:1450px;border-collapse:collapse;font-size:12px">
      <thead><tr style="background:rgba(255,255,255,.05)">
        <th style="padding:8px;text-align:left">Mode</th>
        <th style="padding:8px;text-align:left">Target</th>
        <th style="padding:8px;text-align:left">Type</th>
        <th style="padding:8px;text-align:left">Condition / Price</th>
        <th style="padding:8px;text-align:left">Trigger</th>
        <th style="padding:8px;text-align:left">Last Trigger</th>
        <th style="padding:8px;text-align:left">Actions</th>
      </tr></thead>
      <tbody>${rows.map(_alertsRowHtml).join('')}</tbody>
    </table>`;
    if (st) st.textContent = `${rows.length} alerts`;
  } catch (e) {
    wrap.innerHTML = `<div style="color:#ef4444;font-size:12px;padding:16px">${e.message}</div>`;
    if (st) st.textContent = 'Error';
  }
}

async function _testAlertRule(id) {
  try {
    const d = await api(`/watchlists/alerts/rules/${id}/test`, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})});
    const matched = Array.isArray(d.matched) ? d.matched : [];
    const details = Array.isArray(d.results) ? d.results : [];
    const first = details.slice(0, 5).map(r => `${r.symbol}${r.matched ? ' ✓' : ' ✗'}${r.error ? ` (${r.error})` : ''}`).join(', ');
    const telegram = d.telegram || {};
    const telegramTxt = telegram.sent ? ` · Telegram sent (${telegram.sent})` : (telegram.error ? ` · Telegram: ${telegram.error}` : '');
    addNotif(matched.length ? 'ok' : 'info', 'Alert test', `${matched.length ? `${matched.length} match(es)` : 'No matches'}${first ? ` · ${first}` : ''}${telegramTxt}`, 'Alerts');
  } catch (e) {
    addNotif('err', 'Alert test failed', e.message || String(e), 'Alerts');
  }
}

async function _toggleAlertRule(id, enabled) {
  await api(`/watchlists/alerts/rules/${id}/toggle`, {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({enabled: !!enabled})
  });
  await _loadAlertRulesHub();
  addNotif('ok', 'Alert updated', enabled ? 'Enabled' : 'Disabled', 'Alerts');
}

async function _editAlertRule(id) {
  const rule = _alertsRulesCache.find(r => Number(r.id) === Number(id));
  if (!rule) return;
  _alertsFillBuilder(rule);
}

async function _deleteAlertRule(id) {
  const ruleId = Number(id);
  if (!Number.isFinite(ruleId) || ruleId <= 0) {
    addNotif('err', 'Delete failed', 'Invalid alert rule id', 'Alerts');
    return;
  }
  if (!confirm('Delete this alert?')) return;
  try {
    let d;
    try {
      d = await api(`/watchlists/alerts/rules/${ruleId}`, {method:'DELETE'});
    } catch (firstErr) {
      // Some browser/proxy setups reject DELETE.  Backend exposes a POST
      // fallback so the confirmed delete still works.
      d = await api(`/watchlists/alerts/rules/${ruleId}/delete`, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({})
      });
    }
    if (!d || d.ok === false) throw new Error((d && (d.error || d.message)) || 'Delete failed');
    _alertsRulesCache = (_alertsRulesCache || []).filter(r => Number(r.id) !== ruleId);
    document.querySelectorAll(`[data-alert-rule-row="${ruleId}"]`).forEach(row => row.remove());
    _resetAlertRuleForm();
    await Promise.allSettled([_loadAlertRulesHub(), _loadSymbolAlertsHub(true)]);
    addNotif('ok', 'Alert deleted', `Rule #${ruleId}`, 'Alerts');
  } catch (e) {
    addNotif('err', 'Alert delete failed', e.message || String(e), 'Alerts');
  }
}

async function _saveAlertRule() {
  const id = (document.getElementById('alert-rule-id')?.value || '').trim();
  const payload = {
    watchlist_id: document.getElementById('alert-rule-watchlist')?.value || '',
    symbol: document.getElementById('alert-rule-symbol')?.value?.trim() || '',
    alert_kind: document.getElementById('alert-rule-kind')?.value || 'price',
    trigger_mode: document.getElementById('alert-rule-trigger-mode')?.value || 'daily',
    timeframe: document.getElementById('alert-rule-timeframe')?.value?.trim() || '1d',
    enabled: !!document.getElementById('alert-rule-enabled')?.checked,
    price_operator: document.getElementById('alert-rule-price-op')?.value || '>=',
    price_value: document.getElementById('alert-rule-price-value')?.value || '',
    condition_text: document.getElementById('alert-rule-condition')?.value || '',
    notes: document.getElementById('alert-rule-notes')?.value || '',
  };
  if (!payload.watchlist_id) delete payload.watchlist_id;
  if (!payload.symbol) delete payload.symbol;
  if ((payload.alert_kind || 'price') === 'price' && !payload.price_value) {
    addNotif('err', 'Missing price', 'Set a price threshold for price alerts', 'Alerts');
    return;
  }
  if ((payload.alert_kind || 'price') !== 'price' && !String(payload.condition_text || '').trim()) {
    addNotif('err', 'Missing condition', 'Enter a primitive/combo expression', 'Alerts');
    return;
  }
  const method = id ? 'PUT' : 'POST';
  const url = id ? `/watchlists/alerts/rules/${id}` : '/watchlists/alerts/rules';
  const d = await api(url, {
    method,
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  });
  if (!d || d.error) throw new Error(d && d.error ? d.error : 'Failed to save alert');
  _resetAlertRuleForm();
  await _loadAlertRulesHub();
  const wlName = payload.watchlist_id ? ((_alertsPicklists.watchlists || []).find(w => String(w.id) === String(payload.watchlist_id)) || {}).name || `Watchlist ${payload.watchlist_id}` : '';
  const target = payload.symbol || wlName || 'All symbols';
  addNotif('ok', 'Alert saved', target, 'Alerts');
}

async function _loadTradePnrAlerts() {
  const wrap = document.getElementById('pnr-alerts-wrap');
  const st = document.getElementById('pnr-alerts-status');
  if (!wrap) return;
  if (st) st.textContent = '⏳ Loading…';
  try {
    const d = await api('/journal/trade-alerts?status=open');
    const rows = d.alerts || [];
    if (!rows.length) {
      wrap.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:16px;text-align:center">No open option trades.</div>';
      if (st) st.textContent = '0 alerts';
      return;
    }
    wrap.innerHTML = toolbar + `<table style="width:100%;border-collapse:collapse;font-size:12px">
      <thead><tr style="background:rgba(255,255,255,.05)">
        <th style="padding:8px;text-align:left">Mode</th>
        <th style="padding:8px;text-align:left">Symbol</th>
        <th style="padding:8px;text-align:left">Trade</th>
        <th style="padding:8px;text-align:left">PNR</th>
        <th style="padding:8px;text-align:left">Status</th>
        <th style="padding:8px;text-align:left">Last trigger</th>
        <th style="padding:8px;text-align:left">Action</th>
      </tr></thead>
      <tbody>
      ${rows.map(r => `<tr style="border-top:1px solid var(--border)">
        <td style="padding:8px;color:'+(r.pnr_alert_enabled ? '#22c55e' : '#94a3b8')+';font-weight:700">'+(r.pnr_alert_enabled ? 'Enabled' : 'Disabled')+'</td>
        <td style="padding:8px;font-weight:700">${r.symbol || '—'}</td>
        <td style="padding:8px">${r.trade_type || '—'} · ${r.direction || ''}</td>
        <td style="padding:8px">${fmt(r.pnr,2)}${r.pnr_upper!=null ? ` / ${fmt(r.pnr_upper,2)}` : ''}</td>
        <td style="padding:8px">${r.pnr_status || '—'}</td>
        <td style="padding:8px;color:var(--muted);white-space:nowrap">${r.pnr_alert_last_sent_at || '—'}</td>
        <td style="padding:8px;color:#22c55e;font-weight:700"><button class="btn btn-ghost btn-sm" onclick="_testTradePnrAlert(${r.id})">Test now</button></td>
      </tr>`).join('')}
      </tbody>
    </table>`;
    if (st) st.textContent = `${rows.length} open trades`;
  } catch (e) {
    wrap.innerHTML = `<div style="color:#ef4444;font-size:12px;padding:16px">${e.message}</div>`;
    if (st) st.textContent = 'Error';
  }
}

