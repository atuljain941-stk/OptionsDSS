// ════════════════════════════════════════════════════════════════════════════
// SPY STRATEGIES — Daily (0-2 DTE) and Weekly (5-10 DTE)
// ════════════════════════════════════════════════════════════════════════════
async function runSPYStrategy(mode) {
  const sym    = document.getElementById('spy-symbol')?.value || document.getElementById('spy-plan-symbol')?.value || 'SPY';
  const statEl = document.getElementById('spy-status');
  const dailyEl= document.getElementById('spy-strategies-daily');
  const weeklyEl= document.getElementById('spy-strategies-weekly');
  const dailyCont = document.getElementById('spy-strat-daily-cards');
  const weeklyCont= document.getElementById('spy-strat-weekly-cards');

  if (statEl) statEl.innerHTML = '<span style="color:var(--muted)">⏳ Loading strategies…</span>';

  const runDaily  = mode === 'daily'  || mode === 'both';
  const runWeekly = mode === 'weekly' || mode === 'both';

  try {
    const fetches = [];
    if (runDaily)  fetches.push(api('/spy/daily?symbol='  + sym).catch(e => ({error: e.message})));
    if (runWeekly) fetches.push(api('/spy/weekly?symbol=' + sym).catch(e => ({error: e.message})));
    const results = await Promise.all(fetches);

    let statusParts = [];

    if (runDaily && dailyEl && dailyCont) {
      const d = results[0];
      dailyEl.style.display = '';
      if (d.error) {
        dailyCont.innerHTML = '<div style="color:#ef4444;font-size:12px">❌ ' + d.error + '</div>';
      } else {
        dailyCont.innerHTML = _renderSPYStratCards(d);
        statusParts.push('Daily: ' + (d.strategies?.length || 0) + ' strategies · ' + sym + ' @$' + d.spot);
      }
    }

    if (runWeekly && weeklyEl && weeklyCont) {
      const w = results[runDaily ? 1 : 0];
      weeklyEl.style.display = '';
      if (w.error) {
        weeklyCont.innerHTML = '<div style="color:#ef4444;font-size:12px">❌ ' + w.error + '</div>';
      } else {
        weeklyCont.innerHTML = _renderSPYStratCards(w);
        statusParts.push('Weekly: ' + (w.strategies?.length || 0) + ' strategies');
      }
    }

    if (statEl) statEl.innerHTML = '<span style="color:#22c55e">✅ ' + (statusParts.join(' | ') || 'Loaded') + '</span>';
  } catch(e) {
    if (statEl) statEl.innerHTML = '<span style="color:#ef4444">❌ ' + e.message + '</span>';
  }
}

function _renderSPYStratCards(d) {
  const strats = d.strategies || [];
  if (!strats.length) return '<div style="color:var(--muted);font-size:12px;padding:8px">No strategies — run Scheduler to populate OI data.</div>';

  const sc = s => s >= 70 ? '#22c55e' : s >= 50 ? '#f59e0b' : '#ef4444';
  const dc = v => v > 0 ? '#22c55e' : v < 0 ? '#ef4444' : 'var(--muted)';

  return strats.map(s => {
    const pop  = s.pop  || s.confidence || 50;
    const score= s.score || 50;
    const rr   = s.rr   || s.rr_ratio || '—';
    const maxP = s.max_profit != null ? '$' + s.max_profit : (s.credit != null ? '$' + s.credit : '—');
    const maxL = s.max_loss   != null ? '$' + s.max_loss   : '—';
    const entry= s.entry || s.entry_desc || '';
    const legs = (s.legs || []).map(l =>
      '<span style="font-family:monospace;font-size:10px;padding:1px 5px;background:rgba(255,255,255,.06);border-radius:3px;margin-right:3px">' +
      (l.side === 'sell' ? '� SELL ' : '� BUY  ') + (l.qty||1) + ' ' + (l.strike||'') + ' ' + (l.type||l.option_type||'').toUpperCase() +
      '</span>'
    ).join('');

    return '<div style="background:var(--card2);border:1px solid var(--border2);border-radius:6px;padding:10px 12px;margin-bottom:8px">'
      + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;flex-wrap:wrap;gap:4px">'
      + '<div>'
      + '<b style="font-size:13px;color:var(--accent)">' + (s.strategy || s.type || 'Strategy') + '</b>'
      + (s.dte ? '<span style="font-size:10px;color:var(--muted);margin-left:8px">' + s.dte + 'd expiry</span>' : '')
      + '</div>'
      + '<div style="display:flex;gap:8px;font-size:11px">'
      + '<span>Score: <b style="color:' + sc(score) + '">' + score + '</b></span>'
      + '<span>PoP: <b style="color:' + sc(pop) + '">' + pop + '%</b></span>'
      + (rr !== '—' ? '<span>R:R <b style="color:#a5b4fc">' + rr + '</b></span>' : '')
      + '</div>'
      + '</div>'
      + (legs ? '<div style="margin-bottom:6px">' + legs + '</div>' : '')
      + (entry ? '<div style="font-size:11px;color:var(--muted);margin-bottom:4px">� ' + entry + '</div>' : '')
      + '<div style="display:flex;gap:12px;font-size:11px;flex-wrap:wrap">'
      + '<span>Max+: <b style="color:#22c55e">' + maxP + '</b></span>'
      + '<span>Max−: <b style="color:#ef4444">' + maxL + '</b></span>'
      + (s.be || s.breakeven ? '<span>BE: <b style="color:var(--muted)">$' + (s.be || s.breakeven) + '</b></span>' : '')
      + (s.note || s.rationale ? '<span style="color:var(--muted)">' + (s.note || s.rationale || '') + '</span>' : '')
      + '</div>'
      + '</div>';
  }).join('');
}

