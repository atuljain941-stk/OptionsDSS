}

async function _loadTelegramAlertSettings() {
  const sel = document.getElementById('telegram-alert-frequency');
  const st = document.getElementById('telegram-alert-frequency-status');
  if (!sel) return;
  try {
    const d = await api('/telegram/alert_settings');
    if (d && d.frequency) sel.value = d.frequency;
    if (st) st.textContent = `applies to all Telegram alerts · score-only health alerts ${d.score_only_alerts_enabled ? 'on' : 'off'}`;
  } catch(e) {
    if (st) st.textContent = 'frequency status unavailable';
  }
}

async function _saveTelegramAlertSettings() {
  const sel = document.getElementById('telegram-alert-frequency');
  const st = document.getElementById('telegram-alert-frequency-status');
  if (!sel) return;
  try {
    if (st) st.textContent = 'saving…';
    const d = await api('/telegram/alert_settings', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({frequency: sel.value})
    });
    if (d && d.frequency) sel.value = d.frequency;
    if (st) st.textContent = `saved · next checks every ${d.frequency || sel.value}`;
    try { addNotif('info', 'Alert frequency', `Global Telegram alert checks now every ${d.frequency || sel.value}`, 'Alerts'); } catch {}
  } catch(e) {
    if (st) st.textContent = 'save failed';
    try { addNotif('err', 'Alert frequency', e.message || String(e), 'Alerts'); } catch {}
  }
}

async function _loadJournalAlertSettings() {
  const st = document.getElementById('telegram-alert-frequency-status');
  try {
    const d = await api('/journal/alert_global_settings');
    const freqSel = document.getElementById('telegram-alert-frequency');
    if (freqSel && d.frequency) freqSel.value = d.frequency;
    const pnr = document.getElementById('journal-alert-pnr-enabled');
    const ai = document.getElementById('journal-alert-ai-enabled');
    const custom = document.getElementById('journal-alert-custom-enabled');
    if (pnr) pnr.checked = !!d.pnr_alerts_enabled;
    if (ai) ai.checked = !!d.ai_alerts_enabled;
    if (custom) custom.checked = !!(d.custom_position_alerts_enabled ?? d.custom_alerts_enabled);
    if (st) st.textContent = `applies to all Telegram alerts · PNR ${pnr?.checked ? 'on' : 'off'} · AI ${ai?.checked ? 'on' : 'off'} · Custom ${custom?.checked ? 'on' : 'off'}`;
  } catch (e) {
    if (st) st.textContent = 'alert mode status unavailable';
  }
}

async function _saveJournalAlertSettings() {
  const st = document.getElementById('telegram-alert-frequency-status');
  const freqSel = document.getElementById('telegram-alert-frequency');
  const pnr = document.getElementById('journal-alert-pnr-enabled');
  const ai = document.getElementById('journal-alert-ai-enabled');
  const custom = document.getElementById('journal-alert-custom-enabled');
  try {
    if (st) st.textContent = 'saving alert modes…';
    const d = await api('/journal/alert_global_settings', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        frequency: freqSel?.value || '5m',
        pnr_alerts_enabled: !!pnr?.checked,
        ai_alerts_enabled: !!ai?.checked,
        custom_position_alerts_enabled: !!custom?.checked,
      }),
    });
    if (d?.frequency && freqSel) freqSel.value = d.frequency;
    if (pnr) pnr.checked = !!d.pnr_alerts_enabled;
    if (ai) ai.checked = !!d.ai_alerts_enabled;
    if (custom) custom.checked = !!d.custom_position_alerts_enabled;
    if (st) st.textContent = `saved · PNR ${pnr?.checked ? 'on' : 'off'} · AI ${ai?.checked ? 'on' : 'off'} · Custom ${custom?.checked ? 'on' : 'off'}`;
    try { addNotif('info', 'Alert modes', `PNR ${pnr?.checked ? 'on' : 'off'} · AI ${ai?.checked ? 'on' : 'off'} · Custom ${custom?.checked ? 'on' : 'off'}`, 'Alerts'); } catch {}
  } catch (e) {
    if (st) st.textContent = 'save failed';
    try { addNotif('err', 'Alert modes', e.message || String(e), 'Alerts'); } catch {}
  }
}

async function _loadAlertsHub() {
  await Promise.allSettled([
    _loadTelegramAlertSettings(),
    _loadJournalAlertSettings(),
    _loadAlertsPicklists(),
    _loadAlertRulesHub(),
    _loadTradePnrAlerts(),
    _loadAiTradeAlerts(),
    _loadTradeHealthAlerts(),
    _loadPositionAlertRules(),
    _loadAlertHistoryHub(),
    _alertLoadScannerCatalog(),
  ]);
  _alertsUpdateBuilderVisibility();
  _alertInitConditionAutocomplete();
  _alertUpdateFunctionHelp();
  try { _posAlertInitConditionAutocomplete(); _posAlertUpdateFunctionHelp(_posAlertActiveTextAreaId); } catch(e) { console.warn('position alert autocomplete init failed', e); }
}

async function _loadAlertsWatchlists() {
  await _loadAlertsPicklists();
}

function _openAlertsHub() {
  _setActiveTab('alerts');
  setTimeout(function() {
    const el = document.getElementById('alerts-builder-card');
    if (el && 'open' in el) el.open = true;
    if (el) el.scrollIntoView({behavior:'smooth', block:'start'});
    _loadAlertsHub();
  }, 100);
}

function _resetAlertRuleForm() {
  _alertsResetBuilder();
}

// keep visibility synced
['alert-rule-kind'].forEach(function(id) {
  document.addEventListener('change', function(e) {
    if (e.target && e.target.id === id) { _alertsUpdateBuilderVisibility(); _alertUpdateFunctionHelp(); }
  });
});

document.addEventListener('change', function(e) {
  if (e.target && e.target.id === 'alert-rule-watchlist') _loadAlertsPicklists();
});


// ════════════════════════════════════════════════════════════════════════
// UAE TrendVol v3 DTE Sweep Backtest
// ════════════════════════════════════════════════════════════════════════

async function _runUaeBacktest() {
  const sym    = (document.getElementById('uae-bt-sym')?.value   || 'SPY').toUpperCase();
  const strat  = document.getElementById('uae-bt-strat')?.value  || 'BOTH';
  const start  = document.getElementById('uae-bt-start')?.value  || '2022-01-01';
  const dtes   = document.getElementById('uae-bt-dte')?.value    || '7,14,21,28,45';
  const wing   = document.getElementById('uae-bt-wing')?.value   || '3.0';
  const ptgt   = (parseFloat(document.getElementById('uae-bt-ptgt')?.value  || 50) / 100).toFixed(2);
  const stop   = document.getElementById('uae-bt-stop')?.value   || '2.0';
  const adxThr = document.getElementById('uae-bt-adx')?.value    || '20';
  const fast   = document.getElementById('uae-bt-fast')?.value   || '10';
  const slow   = document.getElementById('uae-bt-slow')?.value   || '20';
  const sig    = document.getElementById('uae-bt-sig')?.value    || '5';
  const roc    = document.getElementById('uae-bt-roc')?.value    || '3';
  const volm   = document.getElementById('uae-bt-volm')?.value   || '1.5';

  const st = document.getElementById('uae-bt-status');
  if (st) st.innerHTML = '<span class="spinner" style="display:inline-block;width:14px;height:14px;border:2px solid var(--border);border-top-color:#6366f1;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle"></span> Running sweep...';

  const resultsEl = document.getElementById('uae-bt-results');
  if (resultsEl) resultsEl.style.display = 'none';

  try {
    const url = `/analysis/uae_backtest?symbol=${sym}&strategy=${strat}&start=${start}&dte_list=${encodeURIComponent(dtes)}&wing_pct=${wing}&profit_tgt=${ptgt}&stop_mult=${stop}&adx_thr=${adxThr}&fast=${fast}&slow=${slow}&signal_len=${sig}&roc_len=${roc}&vol_mult=${volm}`;
    const d = await api(url);

    if (!d.ok) {
      if (st) st.textContent = 'Error: ' + (d.error || 'unknown');
      return;
    }

    if (resultsEl) resultsEl.style.display = 'block';
    if (st) st.textContent = `Done — ${d.total_bars} bars (${d.data_start} to ${d.data_end})`;

    _renderUaeRec(d);
    _renderUaeDteTable(d);
    _renderUaeRegime(d);
    _renderUaeSignals(d);
    _renderUaeTradeLog(d);

  } catch(e) {
    if (st) st.textContent = 'Error: ' + e.message;
  }
}

function _renderUaeRec(d) {
  const el = document.getElementById('uae-bt-rec');
  if (!el) return;
  const rec = d.recommendation || {};
  const best = rec.best_dte;
  const sweep = d.dte_sweep || {};
  const bs = sweep[best] || {};
  const sig_count = rec.signal_count || 0;

  el.innerHTML = `
    <div style="display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap">
      <div style="flex:0 0 auto;text-align:center;background:#6366f122;border-radius:8px;padding:12px 20px">
        <div style="font-size:36px;font-weight:900;color:#6366f1">${best}</div>
        <div style="font-size:11px;color:var(--muted)">BEST DTE</div>
      </div>
      <div style="flex:1;min-width:0">
        <div style="font-size:14px;font-weight:800;color:#6366f1;margin-bottom:4px">Optimal Expiry: ${best}-Day (${rec.trade_style || ''})</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.5;margin-bottom:8px">${rec.reason || ''}</div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:12px">
          <span>Win Rate: <b style="color:${bs.win_rate>=60?'#22c55e':bs.win_rate>=50?'#f59e0b':'#ef4444'}">${bs.win_rate||0}%</b></span>
          <span>Expectancy: <b style="color:${(bs.expectancy||0)>=0?'#22c55e':'#ef4444'}">$${bs.expectancy||0}</b></span>
          <span>Profit Factor: <b style="color:${(bs.profit_factor||0)>=1?'#22c55e':'#ef4444'}">${bs.profit_factor||0}</b></span>
          <span>Avg Hold: <b>${bs.avg_days||0}d</b></span>
          <span>Total Trades: <b>${bs.total||0}</b></span>
          <span>Entry Signals: <b>${sig_count}</b></span>
        </div>
      </div>
    </div>`;
}

function _renderUaeDteTable(d) {
  const el = document.getElementById('uae-bt-tbl');
  if (!el) return;
  const sweep = d.dte_sweep || {};
  const ranking = d.dte_ranking || [];
  const best = d.best_dte;

  const hdrs = ['DTE','Trades','Win Rate','Expectancy','Profit Factor','Total P&L','Avg Days','Max DD','% Profit Exit','% Regime Exit','Avg ADX'];
  let html = `<thead><tr>${hdrs.map(h=>`<th style="padding:7px 10px;text-align:left;border-bottom:2px solid var(--border);font-size:11px;color:var(--muted);white-space:nowrap">${h}</th>`).join('')}</tr></thead><tbody>`;

  ranking.forEach((dte, rank) => {
    const s = sweep[dte] || {};
    const isBest = dte === best;
    const wr = s.win_rate || 0;
    const pf = s.profit_factor || 0;
    const exp = s.expectancy || 0;
    const rowBg = isBest ? 'background:rgba(99,102,241,0.08);' : '';
    html += `<tr style="${rowBg}border-bottom:1px solid var(--border)22">
      <td style="padding:8px 10px;font-weight:${isBest?900:700}">
        ${dte}d ${isBest?'<span style="background:#6366f1;color:#fff;font-size:9px;padding:1px 5px;border-radius:3px;margin-left:4px">BEST</span>':''}
        ${rank===1?'<span style="color:#f59e0b;font-size:9px">#2</span>':''}
      </td>
      <td style="padding:8px 10px">${s.total||0}</td>
      <td style="padding:8px 10px;color:${wr>=65?'#22c55e':wr>=50?'#f59e0b':'#ef4444'};font-weight:700">${wr}%</td>
      <td style="padding:8px 10px;color:${exp>=0?'#22c55e':'#ef4444'};font-weight:700">$${exp}</td>
      <td style="padding:8px 10px;color:${pf>=1.5?'#22c55e':pf>=1?'#f59e0b':'#ef4444'};font-weight:700">${pf}</td>
      <td style="padding:8px 10px;color:${(s.total_pnl||0)>=0?'#22c55e':'#ef4444'}">$${s.total_pnl||0}</td>
      <td style="padding:8px 10px">${s.avg_days||0}d</td>
      <td style="padding:8px 10px;color:#ef4444">$${s.max_dd||0}</td>
      <td style="padding:8px 10px">${s.pct_profit_exit||0}%</td>
      <td style="padding:8px 10px">${s.pct_regime_exit||0}%</td>
      <td style="padding:8px 10px">${s.avg_adx_entry||0}</td>
    </tr>`;
  });
  html += '</tbody>';
  el.innerHTML = html;
}

function _renderUaeRegime(d) {
  const el = document.getElementById('uae-bt-regime');
  if (!el) return;
  const rec = d.recommendation || {};
  const pct = rec.regime_time_pct || {};
  const cols = {BULL:'#22c55e',WEAK_BULL:'#4ade80',SIDEWAYS:'#f59e0b',WEAK_BEAR:'#f87171',BEAR:'#ef4444'};
  el.innerHTML = Object.entries(pct).sort((a,b)=>b[1]-a[1]).map(([k,v])=>{
    const c = cols[k]||'#64748b';
    return `<div style="background:${c}22;border:1px solid ${c}44;border-radius:6px;padding:6px 12px;text-align:center;min-width:90px">
      <div style="font-weight:800;color:${c};font-size:14px">${v}%</div>
      <div style="font-size:9px;color:var(--muted);margin-top:2px">${k.replace('_',' ')}</div>
    </div>`;
  }).join('');
}

function _renderUaeSignals(d) {
  const el = document.getElementById('uae-bt-signals');
  if (!el) return;
  const sigs = (d.entry_signals || []).slice().reverse().slice(0, 30);
  if (!sigs.length) { el.innerHTML = '<div style="color:var(--muted);font-size:12px">No signals found</div>'; return; }
  const cols = {BULL:'#22c55e',BEAR:'#ef4444'};
  const tcols = {MACD_CROSS:'#6366f1',REGIME_CHANGE:'#f59e0b'};
  el.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:11px">
    <thead><tr>${['Date','Direction','Trigger','Regime','ADX','MACD','Hist'].map(h=>`<th style="padding:5px 8px;text-align:left;border-bottom:1px solid var(--border);color:var(--muted)">${h}</th>`).join('')}</tr></thead>
    <tbody>${sigs.map(s=>`<tr style="border-bottom:1px solid var(--border)22">
      <td style="padding:5px 8px;font-family:monospace">${s.date}</td>
      <td style="padding:5px 8px;font-weight:700;color:${cols[s.type]||'#64748b'}">${s.type}</td>
      <td style="padding:5px 8px;color:${tcols[s.trigger]||'#64748b'};font-size:10px">${s.trigger}</td>
      <td style="padding:5px 8px;font-size:10px;color:var(--muted)">${s.regime}</td>
      <td style="padding:5px 8px">${(+s.adx).toFixed(1)}</td>
      <td style="padding:5px 8px;color:${s.macd>=0?'#22c55e':'#ef4444'};font-family:monospace">${(+s.macd).toFixed(4)}</td>
      <td style="padding:5px 8px;color:${s.hist>=0?'#22c55e':'#ef4444'};font-family:monospace">${(+s.hist).toFixed(4)}</td>
    </tr>`).join('')}</tbody></table>`;
}

function _renderUaeTradeLog(d) {
  const el = document.getElementById('uae-bt-log');
  const lbl = document.getElementById('uae-bt-log-label');
  if (!el) return;
  const best = d.best_dte;
  const trades = (d.trades_by_dte || {})[String(best)] || [];
  if (lbl) lbl.textContent = `DTE ${best} — ${trades.length} trades`;
  if (!trades.length) { el.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:8px">No trades for this DTE</div>'; return; }
  const hdrs = ['Entry Date','Exit Date','Type','Entry','Short K','Long K','Credit','PnL','Max Gain','Days','Exit Reason','Regime Entry'];
  el.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:11px">
    <thead><tr>${hdrs.map(h=>`<th style="padding:5px 8px;text-align:left;border-bottom:1px solid var(--border);color:var(--muted);white-space:nowrap">${h}</th>`).join('')}</tr></thead>
    <tbody>${trades.slice().reverse().map(t=>{
      const pnlC = t.final_pnl>=0?'#22c55e':'#ef4444';
      const exitC = t.exit_reason&&t.exit_reason.includes('Profit')?'#22c55e':t.exit_reason&&t.exit_reason.includes('Stop')?'#ef4444':t.exit_reason&&t.exit_reason.includes('Regime')?'#f59e0b':'#64748b';
      return `<tr style="border-bottom:1px solid var(--border)22">
        <td style="padding:5px 8px;font-family:monospace">${t.entry_date}</td>
        <td style="padding:5px 8px;font-family:monospace">${t.exit_date||'—'}</td>
        <td style="padding:5px 8px;font-weight:700;color:${t.strategy==='PS'?'#22c55e':'#ef4444'}">${t.strategy}</td>
        <td style="padding:5px 8px">$${t.entry_spot}</td>
        <td style="padding:5px 8px">$${t.short_k}</td>
        <td style="padding:5px 8px">$${t.long_k}</td>
        <td style="padding:5px 8px">$${t.net_credit}</td>
        <td style="padding:5px 8px;font-weight:700;color:${pnlC}">$${t.final_pnl}</td>
        <td style="padding:5px 8px;color:var(--muted)">$${t.max_gain}</td>
        <td style="padding:5px 8px">${t.days_held}d</td>
        <td style="padding:5px 8px;color:${exitC};font-size:10px">${t.exit_reason||'—'}</td>
        <td style="padding:5px 8px;font-size:10px;color:var(--muted)">${t.regime_entry||'—'}</td>
      </tr>`;
    }).join('')}</tbody></table>`;
}

// ════════════════════════════════════════════════════════════════════════
// UAE Watchlist × Period Sweep
// ════════════════════════════════════════════════════════════════════════

var _uaeWlData = null;  // stores last result for re-rendering

function _uaeTab(tab) {
  ['wl','sym'].forEach(function(t) {
    var p = document.getElementById('uae-panel-' + t);
    var b = document.getElementById('uae-tab-' + t);
    if (!p || !b) return;
    var isActive = (t === tab);
    p.style.display = isActive ? 'block' : 'none';
    b.style.borderBottom = isActive ? '2px solid #6366f1' : '2px solid transparent';
    b.style.background   = isActive ? '#6366f122' : 'rgba(255,255,255,0.04)';
    b.style.color        = isActive ? '#818cf8' : 'var(--muted)';
    b.style.fontWeight   = isActive ? '800' : '600';
  });
  // Load watchlists when switching to wl tab
  if (tab === 'wl') _uaeLoadWatchlists();
}

async function _uaeLoadWatchlists() {
  var sel = document.getElementById('uae-wl-id');
  if (!sel || sel.options.length > 1) return;  // already loaded
  try {
    var d = await api('/watchlists/');
    var wls = (d && d.watchlists) ? d.watchlists : [];
    sel.innerHTML = wls.length
      ? wls.map(function(w) { return '<option value="' + w.id + '">' + w.name + ' (' + (w.symbol_count || '?') + ' symbols)</option>'; }).join('')
      : '<option value="">No watchlists found</option>';
  } catch(e) {
    sel.innerHTML = '<option value="">Error loading watchlists</option>';
  }
}

async function _runUaeWlBacktest() {
  var wlId   = document.getElementById('uae-wl-id')?.value;
  var strat  = document.getElementById('uae-wl-strat')?.value  || 'BOTH';
  var periods= document.getElementById('uae-wl-periods')?.value || '3,6,12';
  var dtes   = document.getElementById('uae-wl-dte')?.value    || '7,14,21,28';
  var wing   = document.getElementById('uae-wl-wing')?.value   || '3.0';
  var ptgt   = (parseFloat(document.getElementById('uae-wl-ptgt')?.value || 50) / 100).toFixed(2);
  var stop   = document.getElementById('uae-wl-stop')?.value   || '2.0';
  var maxSym = document.getElementById('uae-wl-maxsym')?.value || '20';

  var st = document.getElementById('uae-wl-status');
  var resultsEl = document.getElementById('uae-wl-results');
  if (st) st.innerHTML = '<span class="spinner" style="display:inline-block;width:14px;height:14px;border:2px solid var(--border);border-top-color:#6366f1;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle"></span> Running sweep (this may take 30-90s)...';
  if (resultsEl) resultsEl.style.display = 'none';

  try {
    var url = '/analysis/uae_watchlist_backtest?strategy=' + strat
            + '&periods=' + encodeURIComponent(periods)
            + '&dte_list=' + encodeURIComponent(dtes)
            + '&wing_pct=' + wing
            + '&profit_tgt=' + ptgt
            + '&stop_mult=' + stop
            + '&max_symbols=' + maxSym;
    if (wlId) url += '&watchlist_id=' + wlId;

    var d = await api(url);
    if (!d.ok) { if (st) st.textContent = 'Error: ' + (d.error || 'unknown'); return; }

    _uaeWlData = d;
    if (resultsEl) resultsEl.style.display = 'block';

    var errored = (d.symbols_errored || []).length;
    if (st) st.textContent = d.watchlist_name + ' — ' + d.symbols_with_results + '/' + (d.symbols_scanned || []).length + ' symbols OK' + (errored ? ', ' + errored + ' failed' : '') + ' — ' + d.run_at;

    _renderUaeWlRec(d);
    _renderUaeWlBest(d);
    _renderUaeWlGrid(d);
    _populateUaeWlDteSelector(d);
    _renderUaeWlSymTable();

  } catch(e) {
    if (st) st.textContent = 'Error: ' + e.message;
  }
}

function _renderUaeWlRec(d) {
  var el = document.getElementById('uae-wl-rec');
  if (!el) return;
  var recs = d.recommendations || [];
  var pcols = {3:'#6366f1', 6:'#22c55e', 12:'#f59e0b'};
  el.innerHTML = recs.map(function(r) {
    var c = pcols[r.period.replace(/[^0-9]/g,'')] || '#6366f1';
    var wrC = r.win_rate >= 65 ? '#22c55e' : r.win_rate >= 50 ? '#f59e0b' : '#ef4444';
    var pfC = r.pf >= 1.5 ? '#22c55e' : r.pf >= 1 ? '#f59e0b' : '#ef4444';
    return '<div class="card" style="border:1px solid ' + c + '44">'
      + '<div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">'
      + '<div style="background:' + c + '22;border-radius:6px;padding:6px 12px;text-align:center;min-width:60px">'
      + '<div style="font-size:22px;font-weight:900;color:' + c + '">' + r.period + '</div>'
      + '</div>'
      + '<div>'
      + '<div style="font-size:12px;font-weight:800">Best DTE: <span style="color:' + c + '">' + r.best_dte + 'd</span></div>'
      + '<div style="font-size:10px;color:var(--muted)">' + r.symbols + ' symbols, ' + r.trades + ' trades total</div>'
      + '</div></div>'
      + '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;font-size:11px">'
      + '<div style="text-align:center"><div style="color:var(--muted);font-size:9px">WIN RATE</div><div style="font-weight:800;color:' + wrC + '">' + r.win_rate + '%</div></div>'
      + '<div style="text-align:center"><div style="color:var(--muted);font-size:9px">EXPECTANCY</div><div style="font-weight:800;color:' + ((r.expectancy||0)>=0?'#22c55e':'#ef4444') + '">$' + r.expectancy + '</div></div>'
      + '<div style="text-align:center"><div style="color:var(--muted);font-size:9px">PROFIT FACTOR</div><div style="font-weight:800;color:' + pfC + '">' + r.pf + '</div></div>'
      + '</div></div>';
  }).join('');
}

function _renderUaeWlBest(d) {
  var el = document.getElementById('uae-wl-best');
  if (!el) return;
  var best = d.overall_best_dte;
  var byP  = d.best_dte_per_period || {};
  var consistent = Object.values(byP).every(function(v) { return v === best; });
  el.innerHTML = '<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">'
    + '<div style="text-align:center;background:#6366f122;border-radius:8px;padding:10px 18px;min-width:80px">'
    + '<div style="font-size:32px;font-weight:900;color:#6366f1">' + best + 'd</div>'
    + '<div style="font-size:10px;color:var(--muted)">OVERALL BEST DTE</div>'
    + '</div>'
    + '<div style="flex:1">'
    + '<div style="font-size:13px;font-weight:800;color:#818cf8;margin-bottom:4px">Recommended expiry across all watchlist symbols</div>'
    + '<div style="font-size:11px;color:var(--muted);line-height:1.5">'
    + (consistent ? 'Consistent winner across all periods — high confidence.' : 'Varies by period: ' + Object.entries(byP).map(function(e){return e[0]+'m→'+e[1]+'d';}).join(', ') + '.')
    + '</div>'
    + '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;font-size:11px">'
    + Object.entries(byP).map(function(e) {
        var c = e[1] === best ? '#22c55e' : '#f59e0b';
        return '<span style="color:' + c + '">' + e[0] + 'm: <b>' + e[1] + 'd</b></span>';
      }).join('  ')
    + '</div></div></div>';
}

function _renderUaeWlGrid(d) {
  var el = document.getElementById('uae-wl-grid');
  if (!el) return;
  var summary = d.period_dte_summary || {};
  var periods  = d.periods_months || [];
  var dtes     = d.dte_list || [];
  var bestP    = d.best_dte_per_period || {};

  // Header
  var hdr = '<thead><tr>'
    + '<th style="padding:7px 10px;border-bottom:2px solid var(--border);font-size:10px;color:var(--muted);text-align:left">Period</th>'
    + dtes.map(function(dte) {
        return '<th style="padding:7px 10px;border-bottom:2px solid var(--border);font-size:10px;color:var(--muted);text-align:center">' + dte + 'd</th>';
      }).join('')
    + '</tr></thead>';

  // Rows: Win Rate, Expectancy, PF, Trades for each period
  var rows = '';
  var metrics = [
    {key:'avg_win_rate',    label:'Win Rate',      fmt:function(v){return v+'%';},  good:65, ok:50},
    {key:'avg_expectancy',  label:'Expectancy',    fmt:function(v){return '$'+v;},  good:15, ok:0},
    {key:'avg_profit_factor',label:'Profit Factor',fmt:function(v){return v+'x';},  good:1.5, ok:1.0},
    {key:'total_trades',    label:'Total Trades',  fmt:function(v){return v;},       good:999, ok:5},
  ];

  periods.forEach(function(mo) {
    var pdata = summary[mo] || {};
    var bestDte = bestP[mo];
    metrics.forEach(function(m, mi) {
      rows += '<tr style="border-bottom:1px solid var(--border)' + (mi===metrics.length-1?'':'22') + '">';
      rows += '<td style="padding:6px 10px;font-size:11px;' + (mi===0?'font-weight:700':'color:var(--muted)') + '">'
            + (mi===0 ? mo + ' Months' : m.label) + '</td>';
      dtes.forEach(function(dte) {
        var s = pdata[dte] || {};
        var val = s[m.key] != null ? s[m.key] : '-';
        var isBest = (dte === bestDte);
        var numVal = parseFloat(val);
        var col = 'var(--text)';
        if (!isNaN(numVal)) {
          col = numVal >= m.good ? '#22c55e' : numVal >= m.ok ? '#f59e0b' : '#ef4444';
        }
        rows += '<td style="padding:6px 10px;text-align:center;font-size:11px;font-weight:' + (isBest?'800':'400') + ';color:' + col + ';background:' + (isBest?'rgba(99,102,241,0.06)':'') + '">'
              + (val !== '-' ? m.fmt(val) : '-') + '</td>';
      });
      rows += '</tr>';
    });
    // spacer row between periods
    rows += '<tr><td colspan="' + (dtes.length+1) + '" style="padding:2px;background:rgba(255,255,255,0.01)"></td></tr>';
  });

  el.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:11px">' + hdr + '<tbody>' + rows + '</tbody></table>';
}

function _populateUaeWlDteSelector(d) {
  var sel = document.getElementById('uae-wl-sym-dte');
  if (!sel) return;
  sel.innerHTML = (d.dte_list || []).map(function(dte) {
    var isBest = dte === d.overall_best_dte;
    return '<option value="' + dte + '"' + (isBest?' selected':'') + '>' + dte + 'd' + (isBest?' (best)':'') + '</option>';
  }).join('');
}

function _renderUaeWlSymTable() {
  var el = document.getElementById('uae-wl-sym-table');
  if (!el || !_uaeWlData) return;
  var mo  = parseInt(document.getElementById('uae-wl-sym-period')?.value || 12);
  var dte = parseInt(document.getElementById('uae-wl-sym-dte')?.value || _uaeWlData.overall_best_dte);

  var rows = (_uaeWlData.symbol_results || []).filter(function(sr) {
    return !sr.error && sr.periods && sr.periods[mo] && !sr.periods[mo].error;
  }).map(function(sr) {
    var pd   = sr.periods[mo] || {};
    var ds   = (pd.dte_stats || {})[dte] || {};
    var best = pd.best_dte;
    return {
      symbol:   sr.symbol,
      total:    ds.total || 0,
      win_rate: ds.win_rate || 0,
      exp:      ds.expectancy || 0,
      pf:       ds.profit_factor || 0,
      pnl:      ds.total_pnl || 0,
      max_dd:   ds.max_dd || 0,
      avg_days: ds.avg_days || 0,
      best_dte: best,
    };
  }).sort(function(a,b) { return b.exp - a.exp; });

  if (!rows.length) {
    el.innerHTML = '<div style="color:var(--muted);font-size:12px;padding:8px">No data for this period/DTE combination.</div>';
    return;
  }

  var hdrs = ['Symbol','Trades','Win Rate','Expectancy','Profit Factor','Total P&L','Max DD','Avg Days','Best DTE'];
  el.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:11px">'
    + '<thead><tr>' + hdrs.map(function(h){return '<th style="padding:6px 8px;text-align:left;border-bottom:1px solid var(--border);font-size:10px;color:var(--muted);white-space:nowrap">'+h+'</th>';}).join('') + '</tr></thead>'
    + '<tbody>' + rows.map(function(r) {
        var wrC  = r.win_rate>=65?'#22c55e':r.win_rate>=50?'#f59e0b':'#ef4444';
        var expC = r.exp>=0?'#22c55e':'#ef4444';
        var pfC  = r.pf>=1.5?'#22c55e':r.pf>=1?'#f59e0b':'#ef4444';
        var pnlC = r.pnl>=0?'#22c55e':'#ef4444';
        var bestC= r.best_dte===dte?'#6366f1':'#64748b';
        return '<tr style="border-bottom:1px solid var(--border)22">'
          + '<td style="padding:6px 8px;font-weight:700;color:var(--accent)">' + r.symbol + '</td>'
          + '<td style="padding:6px 8px">' + r.total + '</td>'
          + '<td style="padding:6px 8px;color:' + wrC + ';font-weight:700">' + r.win_rate + '%</td>'
          + '<td style="padding:6px 8px;color:' + expC + ';font-weight:700">$' + r.exp + '</td>'
          + '<td style="padding:6px 8px;color:' + pfC + '">' + r.pf + '</td>'
          + '<td style="padding:6px 8px;color:' + pnlC + '">$' + r.pnl + '</td>'
          + '<td style="padding:6px 8px;color:#ef4444">$' + r.max_dd + '</td>'
          + '<td style="padding:6px 8px">' + r.avg_days + 'd</td>'
          + '<td style="padding:6px 8px;color:' + bestC + ';font-weight:700">' + r.best_dte + 'd</td>'
          + '</tr>';
      }).join('') + '</tbody></table>';
}


// ════════════════════════════════════════════════════════════════════════════
// GENERIC CHRONOLOGICAL BACKTEST PAGE — SQLite daily bars + simple DTE scoring
// This intentionally overrides older Backtest tab builders above.
// ════════════════════════════════════════════════════════════════════════════
var _btGenericState = window._btGenericState || { scanners: {}, lastResult: null };
window._btGenericState = _btGenericState;
if (!_btGenericState.scanners) _btGenericState.scanners = {};

function _btEsc(v) {
  return String(v ?? '').replace(/[&<>"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
}
function _btFmt(v, dec=2) {
  const n = Number(v);
  if (!Number.isFinite(n)) return v === 0 ? '0' : '—';
  return dec === 0 ? Math.round(n).toLocaleString() : n.toFixed(dec);
}
function _btPctColor(v) {
  const n = Number(v);
  if (!Number.isFinite(n) || n === 0) return 'var(--text)';
  return n > 0 ? '#22c55e' : '#ef4444';
}
function _btDefaultStart() {
  const d = new Date(Date.now() - 365 * 5 * 86400000);
  return d.toISOString().slice(0, 10);
}
function _btTodayName() {
  return `Backtest ${new Date().toISOString().slice(0, 10)}`;
}

function _btSetTab(tab) {
  try {
    const panes = { replay: 'bt-pane-replay', backtest: 'bt-pane-backtest', api: 'bt-pane-api' };
    Object.entries(panes).forEach(([k, id]) => {
      const el = document.getElementById(id); if (el) el.style.display = (k === tab ? '' : 'none');
    });
    document.querySelectorAll('[data-bt-tab]').forEach(btn => {
      const active = btn.dataset.btTab === tab;
      btn.style.background = active ? 'rgba(59,130,246,.2)' : '';
      btn.style.borderColor = active ? '#3b82f6' : '';
      btn.style.color = active ? '#fff' : '';
    });
    try { localStorage.setItem('bt-active-tab', tab); } catch(e) {}
  } catch(e) {}
}

async function _loadBacktest() {
  const el = document.getElementById('backtest-root');
  if (!el) return;
  if (el.dataset.genericBuilt) return;
  el.dataset.genericBuilt = '1';

  el.innerHTML = `
  <div style="width:100%;max-width:none">
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
      <button data-bt-tab="replay" class="btn btn-ghost" style="padding:8px 12px" onclick="_btSetTab('replay')">Replay Lab</button>
      <button data-bt-tab="backtest" class="btn btn-ghost" style="padding:8px 12px" onclick="_btSetTab('backtest')">Backtest</button>
      <button data-bt-tab="api" class="btn btn-ghost" style="padding:8px 12px" onclick="_btSetTab('api')">API Tester</button>
    </div>
    <div id="bt-pane-replay">
    <div class="card" style="padding:16px 18px;margin-bottom:12px;border-radius:12px;border-color:#2f6fed">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px">
        <div>
          <div style="font-size:18px;font-weight:950;letter-spacing:.01em">Replay Lab · Seller Flow / Weekly Plan / GEX Plan</div>
          <div style="font-size:12px;color:var(--muted);line-height:1.45;margin-top:4px;max-width:1120px">
            Replays the app day-by-day, logs every candidate found, blocks overlapping positions if desired, simulates expiry/path-risk outcomes, and saves the run by name so you can revisit it later.
          </div>
        </div>
        <div id="rpl-status" style="font-size:12px;color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:6px 10px;background:var(--surface)">Ready</div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(8,minmax(120px,1fr));gap:10px;align-items:end">
        <div style="grid-column:span 2">
          <label style="font-size:12px;color:var(--muted);font-weight:800">Run name</label>
          <input id="rpl-run-name" type="text" value="Replay Lab ${_btTodayName()}" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:12px;color:var(--muted);font-weight:800">Start</label>
          <input id="rpl-start" type="date" value="${new Date(Date.now() - 31 * 86400000).toISOString().slice(0,10)}" style="width:100%"/>
        </div>
        <div>
          <label style="font-size:12px;color:var(--muted);font-weight:800">End</label>
          <input id="rpl-end" type="date" value="${new Date().toISOString().slice(0,10)}" style="width:100%"/>
        </div>
        <div style="grid-column:span 2">
          <label style="font-size:12px;color:var(--muted);font-weight:800">Watchlist</label>
          <select id="rpl-watchlist" style="width:100%"></select>
        </div>
        <div>
          <label style="font-size:12px;color:var(--muted);font-weight:800">Symbol override</label>
          <input id="rpl-symbol" type="text" placeholder="blank = watchlist" style="width:100%;text-transform:uppercase"/>
        </div>
        <div>
          <label style="font-size:12px;color:var(--muted);font-weight:800">Max symbols</label>
          <input id="rpl-max-symbols" type="number" value="40" min="0" max="500" step="1" style="width:100%"/>
        </div>

        <div style="grid-column:span 8;display:flex;gap:16px;align-items:center;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:10px">
          <label style="font-size:12px;color:var(--text);font-weight:800"><input id="rpl-mod-seller" type="checkbox" checked/> Seller Flow / OI Buildup</label>
          <label style="font-size:12px;color:var(--text);font-weight:800"><input id="rpl-mod-weekly" type="checkbox" checked/> Weekly Plan</label>
          <label style="font-size:12px;color:var(--text);font-weight:800"><input id="rpl-mod-gex" type="checkbox" checked/> GEX Plan</label>
          <label style="font-size:12px;color:var(--muted)">Max trades/day <input id="rpl-max-trades" type="number" value="8" min="1" max="50" step="1" style="width:70px;margin-left:4px"/></label>
          <label style="font-size:12px;color:var(--muted)"><input id="rpl-save" type="checkbox" checked/> Save run</label>
        </div>

        <div style="grid-column:span 8;border:1px solid var(--border);border-radius:10px;padding:10px;background:rgba(15,23,42,.42)">
          <div style="font-size:13px;font-weight:900;margin-bottom:8px;color:var(--accent)">Execution / outcome realism</div>
          <div style="display:grid;grid-template-columns:repeat(6,minmax(110px,1fr));gap:8px;align-items:end">
            <div style="grid-column:span 2"><label style="font-size:11px;color:var(--muted)">Outcome model</label><select id="rpl-outcome-model" style="width:100%"><option value="touch_stop" selected>Conservative: short strike touch = loss</option><option value="balanced">Balanced: expiry result + path warning</option><option value="expiry_only">Expiry-only close check</option></select></div>
            <div><label style="font-size:11px;color:var(--muted)">Breach buffer %</label><input id="rpl-stop-buffer" type="number" value="0" min="0" max="10" step="0.25" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">Overlap rule</label><select id="rpl-overlap-mode" style="width:100%"><option value="symbol" selected>Block same symbol</option><option value="symbol_module">Block symbol+module</option><option value="symbol_strategy">Block symbol+strategy</option><option value="allow">Allow overlaps</option></select></div>
            <div><label style="font-size:11px;color:var(--muted)">Max open</label><input id="rpl-max-open" type="number" value="12" min="1" max="200" step="1" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">Signal log</label><select id="rpl-save-signals" style="width:100%"><option value="1" selected>Save all found</option><option value="0">Trades only</option></select></div>
          </div>
          <div style="font-size:10px;color:var(--muted);margin-top:6px">v102 avoids the old same-day Seller Flow close bias by assigning a real target expiry/DTE, and it can stop daily re-entry while a prior trade is still open.</div>
        </div>

        <div style="grid-column:span 3;border:1px solid var(--border);border-radius:10px;padding:10px;background:rgba(15,23,42,.42)">
          <div style="font-size:13px;font-weight:900;margin-bottom:8px;color:var(--accent)">Seller Flow settings</div>
          <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;align-items:end">
            <div style="grid-column:span 2"><label style="font-size:11px;color:var(--muted)">Quality</label><select id="rpl-oi-quality" style="width:100%"><option value="1">1 All</option><option value="2">2 Watch+</option><option value="3">3 Setup+</option><option value="4" selected>4 Tradable+</option><option value="5">5 Best only</option></select></div>
            <div><label style="font-size:11px;color:var(--muted)">ST</label><input id="rpl-oi-st" type="number" value="5" min="1" max="30" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">MT</label><input id="rpl-oi-mt" type="number" value="15" min="2" max="90" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">LT</label><input id="rpl-oi-lt" type="number" value="30" min="5" max="180" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">DTE</label><input id="rpl-oi-dte" type="number" value="30" min="3" max="90" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">OTM %</label><input id="rpl-otm" type="number" value="2" min="0" max="20" step="0.25" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">Width</label><input id="rpl-width" type="number" value="5" min="0.5" max="100" step="0.5" style="width:100%"/></div>
          </div>
        </div>

        <div style="grid-column:span 3;border:1px solid var(--border);border-radius:10px;padding:10px;background:rgba(15,23,42,.42)">
          <div style="font-size:13px;font-weight:900;margin-bottom:8px;color:var(--accent)">Weekly Plan settings</div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;align-items:end">
            <div style="grid-column:span 2"><label style="font-size:11px;color:var(--muted)">Symbols</label><input id="rpl-weekly-symbols" type="text" value="SPY,QQQ,IWM" style="width:100%;text-transform:uppercase"/></div>
            <div><label style="font-size:11px;color:var(--muted)">Run day</label><select id="rpl-weekly-day" style="width:100%"><option value="0" selected>Mon</option><option value="1">Tue</option><option value="2">Wed</option><option value="3">Thu</option><option value="4">Fri</option></select></div>
            <div><label style="font-size:11px;color:var(--muted)">Min score</label><input id="rpl-weekly-score" type="number" value="55" min="1" max="99" style="width:100%"/></div>
          </div>
          <div style="font-size:10px;color:var(--muted);margin-top:6px">Uses target Friday, weekly OI walls, expected move, and daily/weekly price-action proxy.</div>
        </div>

        <div style="grid-column:span 2;border:1px solid var(--border);border-radius:10px;padding:10px;background:rgba(15,23,42,.42)">
          <div style="font-size:13px;font-weight:900;margin-bottom:8px;color:var(--accent)">GEX Plan settings</div>
          <label style="font-size:11px;color:var(--muted)">Symbols</label><input id="rpl-gex-symbols" type="text" value="SPY" style="width:100%;text-transform:uppercase;margin-bottom:6px"/>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:end">
            <div><label style="font-size:11px;color:var(--muted)">Run time</label><input id="rpl-gex-time" type="time" value="10:00" style="width:100%"/></div>
            <div><label style="font-size:11px;color:var(--muted)">Mode</label><select id="rpl-gex-mode" style="width:100%"><option value="auto" selected>Auto</option><option value="range">Range fade</option><option value="breakout">Breakout</option><option value="breakdown">Breakdown</option></select></div>
            <div><label style="font-size:11px;color:var(--muted)">Min GEX %</label><input id="rpl-gex-strength" type="number" value="8" min="0" max="50" step="1" style="width:100%"/></div>
          </div>
        </div>

        <div style="grid-column:span 8;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <button class="btn btn-primary" style="padding:10px 18px;font-weight:900" onclick="_rplRun()">▶ Run Replay Lab</button>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="_rplLoadRuns()">↻ Saved replay runs</button>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="_rplClear()">Clear replay results</button>
          <div style="font-size:11px;color:var(--muted)">Tip: lower Seller Flow quality from 4→3 to audit conditional WAIT/setup rows.</div>
        </div>
      </div>
    </div>

    <div id="rpl-results" style="display:none;margin-bottom:12px">
      <div id="rpl-stats" class="stat-row"></div>
      <div class="row" style="align-items:stretch;flex-wrap:wrap">
        <div class="card" style="flex:1 1 420px;padding:12px"><div class="card-title">Module summary</div><div id="rpl-module-summary"></div></div>
        <div class="card" style="flex:1 1 420px;padding:12px"><div class="card-title">Symbol performance</div><div id="rpl-symbol-summary"></div></div>
      </div>
      <div class="card" style="padding:12px"><div class="card-title">Replay trade log <span id="rpl-trade-count" style="color:var(--muted);font-weight:500"></span></div><div id="rpl-trade-log"></div></div>
      <details class="card" style="padding:12px"><summary style="cursor:pointer;font-weight:800;list-style:none">Daily signals / candidate log / notes</summary><div id="rpl-daily-log" style="margin-top:8px"></div><div id="rpl-skipped-log" style="margin-top:10px"></div><div id="rpl-signal-log" style="margin-top:10px"></div><div id="rpl-notes" style="margin-top:8px;font-size:11px;color:var(--muted);line-height:1.5"></div></details>
    </div>

    <details class="card" style="padding:12px;margin-bottom:12px">
      <summary style="cursor:pointer;font-weight:800;list-style:none;display:flex;justify-content:space-between;align-items:center"><span>Saved Replay / Backtest runs</span><button class="btn btn-ghost" style="padding:5px 8px" onclick="event.preventDefault();event.stopPropagation();_rplLoadRuns()">Refresh</button></summary>
      <div id="rpl-runs" style="margin-top:8px"></div>
    </details>

    <div class="card" style="padding:16px 18px;margin-bottom:12px;border-radius:12px">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px">
        <div>
          <div style="font-size:17px;font-weight:900;letter-spacing:.01em">Backtest</div>
          <div style="font-size:11px;color:var(--muted);line-height:1.45;margin-top:4px;max-width:980px">
            Simple chronological simulator. Choose a watchlist or one symbol, pick any saved scanner or type any Scanner Builder query, then replay daily bars from the SQLite cache/yfinance one trading day at a time.
          </div>
        </div>
        <div id="btg-store-pill" style="font-size:10px;color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:5px 10px;background:var(--surface)">SQLite cache status loading...</div>
      </div>
      <div id="btg-store-help" style="display:none;margin:8px 0 12px 0;font-size:11px;color:var(--muted);line-height:1.45;border:1px solid var(--border);border-radius:8px;padding:8px;background:var(--surface)"></div>

      <div style="display:grid;grid-template-columns:repeat(6,minmax(130px,1fr));gap:10px;align-items:end">
        <div style="grid-column:span 2">
          <label style="font-size:11px;color:var(--muted);font-weight:700">Watchlist</label>
          <select id="btg-watchlist" style="width:100%"></select>
          <div id="btg-watchlist-count" style="font-size:10px;color:var(--muted);margin-top:3px"></div>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted);font-weight:700">Symbol optional</label>
          <input id="btg-symbol" type="text" placeholder="blank = watchlist" style="width:100%;text-transform:uppercase"/>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted);font-weight:700">DTE</label>
          <select id="btg-dte" style="width:100%">
            <option>7</option><option>14</option><option>21</option><option>28</option><option selected>30</option><option>35</option><option>45</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted);font-weight:700">Strategy</label>
          <select id="btg-trade-type" style="width:100%">
            <option value="PS" selected>PS — Bull Put Spread</option>
            <option value="CS">CS — Bear Call Spread</option>
            <option value="IC">IC — Iron Condor</option>
            <option value="CB">CB — Call Buy / Debit</option>
            <option value="PB">PB — Put Buy / Debit</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted);font-weight:700">Start date</label>
          <input id="btg-start" type="date" value="${_btDefaultStart()}" style="width:100%"/>
        </div>

        <div>
          <label style="font-size:11px;color:var(--muted);font-weight:700">Avoid earnings</label>
          <input id="btg-earnings-avoid" type="number" value="35" min="0" max="365" step="1" style="width:100%"/>
          <div style="font-size:10px;color:var(--muted);margin-top:3px">days ahead; 0 = off</div>
        </div>
        <div style="grid-column:span 2">
          <label style="font-size:11px;color:var(--muted);font-weight:700">Saved scanner</label>
          <select id="btg-scanner" style="width:100%"><option value="">Custom query below</option></select>
        </div>
        <div style="grid-column:span 2">
          <label style="font-size:11px;color:var(--muted);font-weight:700">Backtest name</label>
          <input id="btg-run-name" type="text" value="${_btEsc(_btTodayName())}" style="width:100%"/>
        </div>
        <div style="display:flex;align-items:center;gap:12px;padding-bottom:7px;font-size:11px;color:var(--muted);flex-wrap:wrap">
          <label title="Save this run to the local SQLite backtest store after it completes."><input id="btg-save-run" type="checkbox"/> save</label>
          <label title="When off, only one open trade per symbol is allowed at a time."><input id="btg-overlap" type="checkbox"/> overlap</label>
        </div>

        <div style="grid-column:span 6">
          <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:4px">
            <label style="font-size:11px;color:var(--muted);font-weight:700">Scanner query / strategy expression</label>
            <div style="font-size:10px;color:var(--muted)">Runs against any saved scanner or custom Scanner Builder query.</div>
          </div>
          <textarea id="btg-query" rows="4" style="width:100%;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.45" spellcheck="false">rsidiff90() &gt; 20</textarea>
          <div style="font-size:10px;color:var(--muted);margin-top:4px">Examples: <code>scan(&quot;Saved Scanner Name&quot;)</code>, <code>TouchStrongCandleLevel(&quot;bull&quot;, 50, 40, 1.0, &quot;1d&quot;)</code>, <code>RSIDiff90(&quot;1w&quot;) &gt; 20 AND ChangePct(close, 5, &quot;1d&quot;) &lt; -4</code></div>
        </div>

        <div style="grid-column:span 6;display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding-top:2px">
          <button class="btn btn-primary" style="padding:9px 18px;font-weight:800" onclick="_btRunChronological()">▶ Run backtest</button>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="_btSaveLastRun()">💾 Save current result</button>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="_btResetGenericBacktest()">Clear results</button>
          <details style="position:relative">
            <summary class="btn btn-ghost" style="padding:8px 12px;list-style:none;cursor:pointer;display:inline-block">Data/cache</summary>
            <div style="position:absolute;z-index:30;top:34px;left:0;min-width:420px;max-width:min(640px,92vw);padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--surface);box-shadow:0 14px 40px rgba(0,0,0,.35)">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:end">
                <div>
                  <label style="font-size:10px;color:var(--muted);display:block;margin-bottom:3px">Benchmark</label>
                  <input id="btg-benchmark" type="text" value="SPY" style="width:100%;text-transform:uppercase"/>
                </div>
                <div>
                  <label style="font-size:10px;color:var(--muted);display:block;margin-bottom:3px">Market data source</label>
                  <select id="btg-data-provider" style="width:100%">
                    <option value="auto" selected>Auto — SQLite then yfinance fill</option>
                    <option value="sqlite">SQLite cache only</option>
                    <option value="yfinance">yfinance only</option>
                  </select>
                </div>
                <label style="font-size:11px;color:var(--muted)"><input id="btg-auto-fetch" type="checkbox" checked/> fill missing SQLite data from yfinance</label>
                <button class="btn btn-ghost" style="padding:8px 12px" onclick="_btSyncMarketData()">⬇ Sync 5y daily data</button>
              </div>
            </div>
          </details>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="_btLoadRuns()">↻ Historical runs</button>
          <div id="btg-status" style="font-size:11px;color:var(--muted)"></div>
        </div>
      </div>
    </div>
    </div>

    <div id="bt-pane-backtest" style="display:none">
    <div id="btg-results" style="display:none">
      <div id="btg-stats" class="stat-row"></div>
      <div class="row" style="align-items:stretch;flex-wrap:wrap">
        <div class="card" style="flex:1 1 420px;padding:12px">
          <div class="card-title">Symbol-level performance</div>
          <div id="btg-symbol-summary"></div>
        </div>
        <div class="card" style="flex:1 1 420px;padding:12px">
          <div class="card-title">Summary by strategy</div>
          <div id="btg-strategy-summary"></div>
        </div>
      </div>
      <div class="card" style="padding:12px">
        <div class="card-title">Summary grouped by strategy and symbol</div>
        <div id="btg-strategy-symbol-summary"></div>
      </div>
      <div class="card" style="padding:12px">
        <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
          <div class="card-title" style="margin:0">Trade log <span id="btg-trade-count" style="color:var(--muted);font-weight:500"></span></div>
          <div id="btg-run-meta" style="font-size:10px;color:var(--muted)"></div>
        </div>
        <div id="btg-trade-log"></div>
      </div>
      <div class="card" style="padding:12px">
        <div class="card-title">Engine notes</div>
        <div id="btg-notes" style="font-size:11px;color:var(--muted);line-height:1.55"></div>
        <div id="btg-skipped" style="margin-top:10px"></div>
      </div>
    </div>

    <details class="card" style="padding:12px;margin-top:12px">
      <summary style="cursor:pointer;font-weight:800;color:var(--text);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
        <span>Historical backtest runs</span>
        <button type="button" class="btn btn-ghost" style="padding:6px 10px" onclick="event.preventDefault();event.stopPropagation();_btLoadRuns()">Refresh</button>
      </summary>
      <div style="font-size:10px;color:var(--muted);margin-top:8px;margin-bottom:8px">Saved runs are stored in the local SQLite backtest store. Click a run to reload its trade log and summaries.</div>
      <div id="btg-runs-status" style="font-size:11px;color:var(--muted);margin-bottom:6px"></div>
      <div id="btg-runs"></div>
    </details>
    </div>
    </div>
  </div>`;

  document.getElementById('btg-scanner')?.addEventListener('change', _btApplyScannerSelection);
  document.getElementById('btg-symbol')?.addEventListener('input', e => { e.target.value = e.target.value.toUpperCase(); });
  document.getElementById('btg-benchmark')?.addEventListener('input', e => { e.target.value = e.target.value.toUpperCase(); });
  await _rplLoadWatchlists();
  await _rplLoadRuns();
  await _btLoadSelectors();
  await _btMountApiTesterPanel();
  await _btLoadMarketDataStatus();
  await _btLoadRuns();
  const active = (() => { try { return localStorage.getItem('bt-active-tab') || 'replay'; } catch(e) { return 'replay'; } })();
  _btSetTab(active);
}

function _btApiDefaultTargetsText() {
  return [
    'GET /api/fetch_status | Fetch status',
    'GET /watchlists/ | Watchlists',
    'GET /telegram/config | Telegram config',
    'GET /agentic-ai-scanner/api/status | Agentic AI scanner status',
    'GET /backtest/api/market-data/status | Backtest cache status',
    'GET /backtest/api/runs?limit=5 | Saved backtest runs',
    'GET /api/topbar_context?symbol=SPY&days_back=0&days_ahead=3&news_refresh_min=60 | Topbar context',
  ].join('\n');
}

async function _btApiLoadDiscoveredEndpoints() {
  try {
    const resp = await fetch('/backtest/api/api-tester/endpoints');
    const data = await resp.json().catch(() => ({}));
    const rows = Array.isArray(data.endpoints) ? data.endpoints : [];
    if (!rows.length) return;
    const txt = rows.map(r => `${(r.method || 'GET').toUpperCase()} ${r.path || ''} | ${r.label || r.path || ''}`).join('\n');
    const ta = document.getElementById('apit-endpoints');
    if (ta && (!ta.value || ta.value === _btApiDefaultTargetsText() || ta.value.split('\n').length <= 7)) ta.value = txt;
    const st = document.getElementById('apit-status');
    if (st) st.innerHTML = `Loaded ${rows.length} discovered endpoint${rows.length===1?'':'s'}`;
  } catch(e) {
    console.warn('api tester endpoint discovery failed:', e.message);
  }
}

function _btApiStatus(msg, good=false) {
  const el = document.getElementById('apit-status');
  if (!el) return;
  el.innerHTML = msg || '';
  el.style.color = good ? '#22c55e' : 'var(--muted)';
}

function _btApiPayload() {
  return {
    run_name: document.getElementById('apit-run-name')?.value || `API Test ${new Date().toISOString().slice(0,10)}`,
    top_n: Number(document.getElementById('apit-top-n')?.value || 10),
    timeout_secs: Number(document.getElementById('apit-timeout')?.value || 20),
    base_url: document.getElementById('apit-base-url')?.value || window.location.origin,
    endpoints_text: document.getElementById('apit-endpoints')?.value || _btApiDefaultTargetsText(),
    save_run: document.getElementById('apit-save')?.checked !== false,
  };
}

function _btApiRenderTable(rows, emptyText='No results') {
  return _btSummaryTable(rows, [
    {label:'Rank', render:r => _btFmt(r.endpoint_no || 0, 0)},
    {label:'Method', render:r => _btEsc(r.method || '')},
    {label:'Label', render:r => `<b>${_btEsc(r.label || r.path || '')}</b><div style="font-size:10px;color:var(--muted);word-break:break-all">${_btEsc(r.path || '')}</div>`},
    {label:'Status', render:r => `<span class="badge ${r.ok ? 'badge-green' : 'badge-red'}">${_btEsc(r.status_code ?? 'ERR')}</span>`},
    {label:'Elapsed ms', render:r => `<span style="font-weight:800">${_btFmt(r.elapsed_ms, 2)}</span>`},
    {label:'OK', render:r => r.ok ? 'Yes' : 'No'},
    {label:'Error', render:r => `<div style="max-width:280px;font-size:10px;color:var(--muted);line-height:1.35">${_btEsc(r.error || '')}</div>`},
  ], emptyText);
}

async function _btMountApiTesterPanel() {
  const root = document.getElementById('backtest-root');
  if (!root || document.getElementById('apit-card')) return;
  const node = document.createElement('div');
  node.innerHTML = `
    <div id="bt-pane-api" style="display:none">
    <div id="apit-card" class="card" style="padding:16px 18px;margin:12px 0;border-radius:12px;border-color:#f59e0b">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px">
        <div>
          <div style="font-size:18px;font-weight:950;letter-spacing:.01em">API Tester</div>
          <div style="font-size:12px;color:var(--muted);line-height:1.45;margin-top:4px;max-width:1120px">Runs a named endpoint sweep, stores each response time in SQLite with the run timestamp, and highlights the slowest APIs first.</div>
        </div>
        <div id="apit-status" style="font-size:12px;color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:6px 10px;background:var(--surface)">Ready</div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:10px;align-items:end">
        <div style="grid-column:span 2"><label style="font-size:11px;color:var(--muted);font-weight:700">Run name</label><input id="apit-run-name" type="text" value="API Test ${new Date().toISOString().slice(0,10)}" style="width:100%"/></div>
        <div><label style="font-size:11px;color:var(--muted);font-weight:700">Top X</label><input id="apit-top-n" type="number" min="1" max="100" value="10" style="width:100%"/></div>
        <div><label style="font-size:11px;color:var(--muted);font-weight:700">Timeout (s)</label><input id="apit-timeout" type="number" min="1" max="120" step="1" value="20" style="width:100%"/></div>
        <div style="grid-column:span 2"><label style="font-size:11px;color:var(--muted);font-weight:700">Base URL</label><input id="apit-base-url" type="text" value="${_btEsc(window.location.origin)}" style="width:100%"/></div>
        <div style="grid-column:span 6">
          <label style="font-size:11px;color:var(--muted);font-weight:700">Endpoints (METHOD path | label, one per line)</label>
          <textarea id="apit-endpoints" rows="7" style="width:100%;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.45" spellcheck="false">${_btEsc(_btApiDefaultTargetsText())}</textarea>
        </div>
        <div style="grid-column:span 6;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <button class="btn btn-primary" style="padding:9px 18px;font-weight:800" onclick="_btApiRun()">▶ Run API test</button>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="_btApiLoadRuns()">↻ Saved API runs</button>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="document.getElementById('apit-endpoints').value=_btApiDefaultTargetsText();_btApiStatus('Restored default endpoint list.')">Reset defaults</button>
          <button class="btn btn-ghost" style="padding:8px 12px" onclick="_btApiLoadDiscoveredEndpoints()">Load discovered endpoints</button>
          <label style="font-size:11px;color:var(--muted)"><input id="apit-save" type="checkbox" checked/> save run to DB</label>
        </div>
      </div>
      <div id="apit-results" style="display:none;margin-top:12px">
        <div id="apit-stats" class="stat-row"></div>
        <div class="row" style="align-items:stretch;flex-wrap:wrap">
          <div class="card" style="flex:1 1 420px;padding:12px"><div class="card-title">Top slow APIs</div><div id="apit-top"></div></div>
          <div class="card" style="flex:1 1 420px;padding:12px"><div class="card-title">All endpoints</div><div id="apit-all"></div></div>
        </div>
        <div class="card" style="padding:12px;margin-top:12px"><div class="card-title">Notes</div><div id="apit-notes" style="font-size:11px;color:var(--muted);line-height:1.55"></div></div>
      </div>
      <details class="card" style="padding:12px;margin-top:12px">
        <summary style="cursor:pointer;font-weight:800;color:var(--text);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
          <span>Saved API test runs</span>
          <button type="button" class="btn btn-ghost" style="padding:6px 10px" onclick="event.preventDefault();event.stopPropagation();_btApiLoadRuns()">Refresh</button>
        </summary>
        <div id="apit-runs-status" style="font-size:11px;color:var(--muted);margin-top:8px;margin-bottom:6px"></div>
        <div id="apit-runs"></div>
      </details>
    </div>
    </div>`;
  root.appendChild(node.firstElementChild);
  await _btApiLoadRuns();
  await _btApiLoadDiscoveredEndpoints();
}

async function _btApiLoadRuns() {
  const box = document.getElementById('apit-runs');
  const st = document.getElementById('apit-runs-status');
  if (!box) return;
  if (st) st.textContent = 'Loading saved API runs...';
  try {
    const resp = await fetch('/backtest/api/api-tester/runs?limit=50');
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      box.innerHTML = `<div style="font-size:12px;color:var(--muted);padding:10px">API test runs unavailable: ${_btEsc(data.error || resp.statusText)}.</div>`;
      if (st) st.textContent = '';
      return;
    }
    const rows = data.runs || [];
    if (st) st.textContent = rows.length ? `${rows.length} saved run${rows.length===1?'':'s'}` : 'No saved API runs yet';
    box.innerHTML = _btSummaryTable(rows, [
      {label:'Saved', render:r=>_btEsc(String(r.created_at || '').replace('T',' '))},
      {label:'Name', render:r=>`<button class="btn btn-ghost" style="padding:3px 6px" onclick="_btApiOpenRun('${_btEsc(r.run_id)}')">${_btEsc(r.run_name || r.run_id)}</button>`},
      {label:'Requests', render:r=>_btFmt(r.request_count,0)},
      {label:'OK', render:r=>_btFmt(r.ok_count,0)},
      {label:'Failed', render:r=>_btFmt(r.failed_count,0)},
      {label:'Avg ms', render:r=>_btFmt(r.avg_ms,2)},
      {label:'Max ms', render:r=>_btFmt(r.max_ms,2)},
    ], 'No saved API runs yet');
  } catch(e) {
    box.innerHTML = `<div style="font-size:12px;color:var(--muted);padding:10px">API test runs unavailable: ${_btEsc(e.message)}</div>`;
    if (st) st.textContent = '';
  }
}

async function _btApiOpenRun(runId) {
  const st = document.getElementById('apit-status');
  if (st) st.innerHTML = `Loading saved API run ${_btEsc(runId)}...`;
  try {
    const resp = await fetch(`/backtest/api/api-tester/runs/${encodeURIComponent(runId)}`);
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      if (st) st.innerHTML = `❌ ${_btEsc(data.error || resp.statusText)}`;
      return;
    }
    _btApiRender(data.run || {});
    if (st) st.innerHTML = `✅ Loaded saved API run ${_btEsc((data.run || {}).run_name || runId)}`;
  } catch(e) {
    if (st) st.innerHTML = `❌ ${_btEsc(e.message)}`;
  }
}

function _btApiRender(run) {
  const res = document.getElementById('apit-results');
  if (res) res.style.display = '';
  const stats = document.getElementById('apit-stats');
  if (stats) {
    stats.innerHTML = [
      _btStatChip('Requests', _btFmt(run.request_count, 0)),
      _btStatChip('OK', _btFmt(run.ok_count, 0), '#22c55e'),
      _btStatChip('Failed', _btFmt(run.failed_count, 0), run.failed_count > 0 ? '#ef4444' : 'var(--text)'),
      _btStatChip('Avg ms', _btFmt(run.avg_ms, 2)),
      _btStatChip('Min ms', _btFmt(run.min_ms, 2)),
      _btStatChip('Max ms', _btFmt(run.max_ms, 2)),
    ].join('');
  }
  const top = document.getElementById('apit-top');
  if (top) top.innerHTML = _btApiRenderTable((run.slowest || run.results || []).slice(0, Number(run.top_n || 10)), 'No slow APIs yet');
  const all = document.getElementById('apit-all');
  if (all) all.innerHTML = _btApiRenderTable(run.results || [], 'No API results yet');
  const notes = document.getElementById('apit-notes');
  if (notes) notes.innerHTML = (run.notes || []).map(x => `• ${_btEsc(x)}`).join('<br>');
}

async function _btApiRun() {
  const st = document.getElementById('apit-status');
  const payload = _btApiPayload();
  if (!payload.endpoints_text.trim()) {
    if (st) st.innerHTML = '❌ Add at least one endpoint.';
    return;
  }
  if (st) st.innerHTML = '⏳ Running API sweep...';
  try {
    const resp = await fetch('/backtest/api/api-tester/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      if (st) st.innerHTML = `❌ ${_btEsc(data.error || (resp.status + ' ' + resp.statusText))}`;
      return;
    }
    _btApiRender(data);
    const saveMsg = data.saved ? ` · saved as ${_btEsc(data.run_id)}` : data.save_result && data.save_result.error ? ` · save failed: ${_btEsc(data.save_result.error)}` : '';
    if (st) st.innerHTML = `✅ Complete: ${_btFmt(data.ok_count,0)} ok, ${_btFmt(data.failed_count,0)} failed${saveMsg}`;
    if (data.saved) await _btApiLoadRuns();
  } catch(e) {
    if (st) st.innerHTML = `❌ ${_btEsc(e.message)}`;
  }
}

async function _btLoadMarketDataStatus() {
  const pill = document.getElementById('btg-store-pill');
  const help = document.getElementById('btg-store-help');
  try {
    const st = await api('/backtest/api/market-data/status');
    if (pill) {
      if (st.available) {
        pill.innerHTML = `SQLite cache ready · ${_btFmt(st.market_bars,0)} bars · ${_btFmt(st.backtest_runs,0)} runs`;
        pill.style.color = '#22c55e';
        pill.title = `Using ${st.path || 'data/market_data.db'}`;
      } else {
        pill.innerHTML = `SQLite cache unavailable · using yfinance fallback`;
        pill.style.color = '#f59e0b';
        pill.title = st.error || 'SQLite market-data cache is not reachable';
      }
    }
    if (help) {
      if (st.available) {
        help.style.display = 'none';
        help.innerHTML = '';
      } else {
        help.style.display = '';
        help.innerHTML = `
          <div style="font-weight:800;color:#f59e0b;margin-bottom:4px">SQLite market-data cache is not available, so backtests can still run from yfinance but caching, saved runs, and historical run views may be unavailable.</div>
          <div><b>SQLite DB:</b> <code>${_btEsc(st.path || 'data/market_data.db')}</code></div>
          ${st.error ? `<div style="margin-top:3px"><b>Error:</b> ${_btEsc(st.error)}</div>` : ''}
          <div style="margin-top:3px"><b>Fix:</b> ${_btEsc(st.fix_hint || 'Make sure the data folder is writable or set MARKET_DATA_DB to a writable path, then retry status.')}</div>
          <div style="margin-top:6px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <button class="btn btn-ghost" style="padding:4px 8px" onclick="_btLoadMarketDataStatus()">Retry SQLite status</button>
            <span>Windows check: use a writable app folder or set <code>MARKET_DATA_DB=C:\\path\\market_data.db</code>. No database service is required.</span>
          </div>`;
      }
    }
  } catch(e) {
    if (pill) {
      pill.innerHTML = `SQLite cache status unavailable`;
      pill.style.color = '#f59e0b';
      pill.title = e.message || '';
    }
    if (help) {
      help.style.display = '';
      help.innerHTML = `<b>SQLite cache status endpoint failed:</b> ${_btEsc(e.message)}. Confirm the Flask backtest blueprint loaded and the data folder is writable.`;
    }
  }
}

async function _btLoadSelectors() {
  const st = document.getElementById('btg-status');
  try {
    const wl = await api('/backtest/api/watchlists');
    const sel = document.getElementById('btg-watchlist');
    if (sel) {
      const rows = wl.watchlists || [];
      sel.innerHTML = rows.map(w => `<option value="${_btEsc(w.id)}" ${Number(w.id)===Number(wl.preferred_watchlist_id)?'selected':''}>${_btEsc(w.name)} (${w.symbol_count || 0})</option>`).join('') || '<option value="">No watchlists</option>';
      const upd = () => {
        const cur = rows.find(x => String(x.id) === String(sel.value));
        const cnt = document.getElementById('btg-watchlist-count');
        if (cnt) cnt.textContent = cur ? `${cur.symbol_count || 0} symbols` : '';
      };
      sel.addEventListener('change', upd); upd();
    }
  } catch(e) {
    if (st) st.innerHTML = `⚠️ Watchlists unavailable: ${_btEsc(e.message)}`;
  }
  try {
    let sc;
    try {
      sc = await api('/backtest/api/scanners');
    } catch (primaryErr) {
      const cat = await api('/scanner-builder/api/catalog');
      sc = {
        saved_scanners: cat.saved_scanners || cat.definitions || [],
        builtin_scanners: cat.builtin_scanners || [],
        used_fallback: true,
      };
    }
    const sel = document.getElementById('btg-scanner');
    if (!sel) return;
    if (!_btGenericState || typeof _btGenericState !== 'object') _btGenericState = { scanners: {} };
    if (!_btGenericState.scanners) _btGenericState.scanners = {};
    window._btGenericState = _btGenericState;

    _btGenericState.scanners = {};
    const opts = ['<option value="">Custom query below</option>'];
    const seenNames = new Set();
    let savedCount = 0;
    let builtinCount = 0;

    (sc.saved_scanners || []).forEach(s => {
      const name = String(s.name || '').trim();
      if (!name) return;
      const key = `saved:${s.id || name}`;
      const q = s.query_text || s.expression || '';
      _btGenericState.scanners[key] = { name, query_text: q, benchmark: s.benchmark || 'SPY' };
      opts.push(`<option value="${_btEsc(key)}">${_btEsc(name)}</option>`);
      seenNames.add(name.toLowerCase());
      savedCount += 1;
    });

    (sc.builtin_scanners || []).forEach((s, i) => {
      const name = String(s.name || '').trim();
      if (!name || seenNames.has(name.toLowerCase())) return;
      const key = `builtin:${i}`;
      _btGenericState.scanners[key] = { name, query_text: s.query_text || '', benchmark: s.benchmark || 'SPY' };
      opts.push(`<option value="${_btEsc(key)}">Built-in: ${_btEsc(name)}</option>`);
      builtinCount += 1;
    });

    sel.innerHTML = opts.join('');
    if (st && (savedCount || builtinCount)) {
      st.innerHTML = `✅ Loaded ${savedCount} saved scanner${savedCount === 1 ? '' : 's'}${builtinCount ? ` + ${builtinCount} built-in` : ''}. Or use the custom expression box.`;
    }
  } catch(e) {
    const sel = document.getElementById('btg-scanner');
    if (sel) sel.innerHTML = '<option value="">Custom query below</option>';
    if (!_btGenericState || typeof _btGenericState !== 'object') _btGenericState = { scanners: {} };
    _btGenericState.scanners = {};
    window._btGenericState = _btGenericState;
    if (st) st.innerHTML = `⚠️ Saved scanners unavailable: ${_btEsc(e.message)}. You can still run the strategy expression below.`;
  }
}

function _btApplyScannerSelection() {
  const key = document.getElementById('btg-scanner')?.value || '';
  const sc = (_btGenericState && _btGenericState.scanners) ? _btGenericState.scanners[key] : null;
  const st = document.getElementById('btg-status');
  if (!sc) {
    if (st) st.innerHTML = 'Custom expression mode. Edit the strategy expression and run the backtest.';
    return;
  }
  const q = document.getElementById('btg-query');
  if (q && sc.query_text) q.value = sc.query_text;
  const b = document.getElementById('btg-benchmark');
  if (b && sc.benchmark) b.value = String(sc.benchmark).toUpperCase();
  const rn = document.getElementById('btg-run-name');
  if (rn && !rn.value) rn.value = sc.name;
  if (st) st.innerHTML = `Loaded scanner: ${_btEsc(sc.name)}. You may edit the expression before running.`;
}

function _btPayload() {
  const scannerKey = document.getElementById('btg-scanner')?.value || '';
  const scanner = ((_btGenericState && _btGenericState.scanners) ? _btGenericState.scanners[scannerKey] : null) || null;
  const autoFetchEl = document.getElementById('btg-auto-fetch');
  return {
    scanner_name: scanner ? scanner.name : '',
    query_text: (document.getElementById('btg-query')?.value || '').trim(),
    watchlist_id: document.getElementById('btg-watchlist')?.value || null,
    symbol: document.getElementById('btg-symbol')?.value || '',
    start_date: document.getElementById('btg-start')?.value || _btDefaultStart(),
    trade_type: document.getElementById('btg-trade-type')?.value || 'PS',
    dte: Number(document.getElementById('btg-dte')?.value || 30),
    strike_mode: 'entry_spot',
    short_delta: 0.20,
    strike_width: 5,
    otm_pct: 2,
    benchmark: document.getElementById('btg-benchmark')?.value || 'SPY',
    earnings_avoid_days: Number(document.getElementById('btg-earnings-avoid')?.value || 35),
    allow_overlap: !!document.getElementById('btg-overlap')?.checked,
    data_provider: document.getElementById('btg-data-provider')?.value || 'auto',
    auto_fetch: autoFetchEl ? !!autoFetchEl.checked : true,
    save_run: !!document.getElementById('btg-save-run')?.checked,
    run_name: document.getElementById('btg-run-name')?.value || _btTodayName(),
  };
}

function _btResetGenericBacktest() {
  const res = document.getElementById('btg-results');
  if (res) res.style.display = 'none';
  const st = document.getElementById('btg-status');
  if (st) st.innerHTML = '';
}

async function _btRunChronological() {
  const st = document.getElementById('btg-status');
  const payload = _btPayload();
  if (!payload.query_text && !payload.scanner_name) {
    if (st) st.innerHTML = '❌ Enter a strategy expression or choose a saved scanner.';
    return;
  }
  if (st) st.innerHTML = '⏳ Running chronological backtest from SQLite/yfinance daily bars…';
  try {
    const resp = await fetch('/backtest/api/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      if (st) st.innerHTML = `❌ ${_btEsc(data.error || (resp.status + ' ' + resp.statusText))}`;
      return;
    }
    _btGenericState.lastResult = data;
    window._btGenericState = _btGenericState;
    const saveMsg = data.saved ? ` · saved as ${_btEsc(data.run_id)}` : data.save_result && data.save_result.error ? ` · save failed: ${_btEsc(data.save_result.error)}` : '';
    if (st) st.innerHTML = `✅ Complete: ${data.stats?.closed_trades || 0} closed trades, ${data.stats?.open_trades || 0} still open${saveMsg}`;
    _btRenderChronologicalResults(data);
    await _btLoadMarketDataStatus();
    if (data.saved) await _btLoadRuns();
  } catch(e) {
    if (st) st.innerHTML = `❌ ${_btEsc(e.message)}`;
  }
}

async function _btSyncMarketData() {
  const st = document.getElementById('btg-status');
  const payload = _btPayload();
  payload.years = 5;
  if (st) st.innerHTML = '⏳ Syncing five years of daily OHLCV from yfinance into the local SQLite cache…';
  try {
    const resp = await fetch('/backtest/api/market-data/sync', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      if (st) st.innerHTML = `❌ Sync failed: ${_btEsc(data.error || (resp.status + ' ' + resp.statusText))}`;
      return;
    }
    if (st) st.innerHTML = `✅ Synced ${data.symbols_ok || 0}/${data.symbols_requested || 0} symbols, saved ${_btFmt(data.total_saved_bars,0)} daily bars.`;
    await _btLoadMarketDataStatus();
  } catch(e) {
    if (st) st.innerHTML = `❌ ${_btEsc(e.message)}`;
  }
}

async function _btSaveLastRun() {
  const st = document.getElementById('btg-status');
  const last = _btGenericState?.lastResult;
  if (!last || !last.stats) {
    if (st) st.innerHTML = '❌ Run a backtest first, then save it.';
    return;
  }
  try {
    const resp = await fetch('/backtest/api/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ result: last, run_name: document.getElementById('btg-run-name')?.value || last.run_name }),
    });
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      if (st) st.innerHTML = `❌ Save failed: ${_btEsc(data.error || (resp.status + ' ' + resp.statusText))}`;
      return;
    }
    last.saved = true;
    last.save_result = data;
    if (st) st.innerHTML = `✅ Saved run ${_btEsc(data.run_id)} with ${_btFmt(data.trades_saved,0)} trades.`;
    await _btLoadMarketDataStatus();
    await _btLoadRuns();
  } catch(e) {
    if (st) st.innerHTML = `❌ ${_btEsc(e.message)}`;
  }
}

function _btStatChip(label, value, color='var(--text)') {
  return `<div class="stat-chip"><div class="s-label">${_btEsc(label)}</div><div class="s-val" style="color:${color}">${value}</div></div>`;
}

function _btSummaryTable(rows, columns, emptyText='No rows') {
  if (!rows || !rows.length) return `<div style="font-size:12px;color:var(--muted);padding:10px">${_btEsc(emptyText)}</div>`;
  return `<div class="tbl-wrap" style="max-height:360px"><table class="data-tbl"><thead><tr>${columns.map(c=>`<th>${_btEsc(c.label)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${columns.map(c=>`<td>${c.render ? c.render(r) : _btEsc(r[c.key])}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
}

function _btTradeDeltaText(t) {
  const type = String(t.trade_type || '').toUpperCase();
  if (type === 'CS') return t.actual_short_call_delta != null ? _btFmt(t.actual_short_call_delta, 3) : _btFmt(t.target_short_delta ?? t.short_delta, 2);
  if (type === 'PS') return t.actual_short_put_delta != null ? _btFmt(Math.abs(Number(t.actual_short_put_delta)), 3) : _btFmt(t.target_short_delta ?? t.short_delta, 2);
  if (type === 'IC') {
    const p = t.actual_short_put_delta != null ? Math.abs(Number(t.actual_short_put_delta)) : (t.target_short_delta ?? t.short_delta);
    const c = t.actual_short_call_delta != null ? t.actual_short_call_delta : (t.target_short_delta ?? t.short_delta);
    return `${_btFmt(p,3)}P / ${_btFmt(c,3)}C`;
  }
  return '—';
}

function _btRenderChronologicalResults(d) {
  const res = document.getElementById('btg-results');
  if (res) res.style.display = '';
  const s = d.stats || {};
  const stats = document.getElementById('btg-stats');
  if (stats) {
    stats.innerHTML = [
      _btStatChip('Trades taken', _btFmt(s.total_trades, 0)),
      _btStatChip('Closed', _btFmt(s.closed_trades, 0), 'var(--muted)'),
      _btStatChip('Winners', _btFmt(s.winners, 0), '#22c55e'),
      _btStatChip('Losers', _btFmt(s.losers, 0), '#ef4444'),
      _btStatChip('Win rate', `${_btFmt(s.win_rate, 2)}%`, Number(s.win_rate) >= 50 ? '#22c55e' : '#ef4444'),
      _btStatChip('Avg move', `${_btFmt(s.avg_price_change_pct, 2)}%`, _btPctColor(s.avg_price_change_pct)),
      _btStatChip('Best move', `${_btFmt(s.best_price_change_pct, 2)}%`, _btPctColor(s.best_price_change_pct)),
      _btStatChip('Worst move', `${_btFmt(s.worst_price_change_pct, 2)}%`, _btPctColor(s.worst_price_change_pct)),
      _btStatChip('Open', _btFmt(s.open_trades, 0), 'var(--muted)'),
      _btStatChip('Days processed', _btFmt(s.days_processed, 0), 'var(--muted)'),
    ].join('');
  }

  const commonCols = [
    {key:'trades', label:'Trades', render:r=>_btFmt(r.trades,0)},
    {key:'winners', label:'Wins', render:r=>`<span style="color:#22c55e;font-weight:700">${_btFmt(r.winners,0)}</span>`},
    {key:'losers', label:'Losses', render:r=>`<span style="color:#ef4444;font-weight:700">${_btFmt(r.losers,0)}</span>`},
    {key:'win_rate', label:'Win %', render:r=>`<span style="color:${Number(r.win_rate)>=50?'#22c55e':'#ef4444'};font-weight:700">${_btFmt(r.win_rate,2)}%</span>`},
    {key:'avg_price_change_pct', label:'Avg move %', render:r=>`<span style="color:${_btPctColor(r.avg_price_change_pct)}">${_btFmt(r.avg_price_change_pct,2)}%</span>`},
    {key:'best_price_change_pct', label:'Best %', render:r=>`<span style="color:${_btPctColor(r.best_price_change_pct)}">${_btFmt(r.best_price_change_pct,2)}%</span>`},
    {key:'worst_price_change_pct', label:'Worst %', render:r=>`<span style="color:${_btPctColor(r.worst_price_change_pct)}">${_btFmt(r.worst_price_change_pct,2)}%</span>`},
  ];
  const symBox = document.getElementById('btg-symbol-summary');
  if (symBox) symBox.innerHTML = _btSummaryTable(d.symbol_performance || [], [{key:'symbol', label:'Symbol', render:r=>`<b style="color:var(--accent)">${_btEsc(r.symbol)}</b>`}, ...commonCols], 'No symbol performance yet');
  const stratBox = document.getElementById('btg-strategy-summary');
  if (stratBox) stratBox.innerHTML = _btSummaryTable(d.strategy_summary || [], [{key:'strategy', label:'Strategy', render:r=>`<b>${_btEsc(r.strategy)}</b>`}, ...commonCols], 'No strategy summary yet');
  const stratSymBox = document.getElementById('btg-strategy-symbol-summary');
  if (stratSymBox) stratSymBox.innerHTML = _btSummaryTable(d.strategy_symbol_summary || [], [{key:'strategy', label:'Strategy'}, {key:'symbol', label:'Symbol', render:r=>`<b style="color:var(--accent)">${_btEsc(r.symbol)}</b>`}, ...commonCols], 'No grouped summary yet');

  const trades = d.trades || [];
  const cnt = document.getElementById('btg-trade-count');
  if (cnt) cnt.textContent = `(${trades.length} closed)`;
  const meta = document.getElementById('btg-run-meta');
  if (meta) {
    const c = d.config || {};
    const saved = d.saved || d.save_result?.ok ? ` · saved ${d.run_id || d.save_result?.run_id || ''}` : '';
    const earnTxt = Number(c.earnings_avoid_days || 0) > 0 ? ` · avoid earnings ≤${_btFmt(c.earnings_avoid_days,0)}d` : '';
    meta.textContent = `${c.start_date || '—'} → ${c.end_date || '—'} · ${c.universe_count || 0} symbols · ${c.trade_type || '—'} ${c.dte || ''}DTE${earnTxt} · ${c.data_provider || 'auto'}${saved}`;
  }
  const log = document.getElementById('btg-trade-log');
  if (log) {
    const cols = [
      {label:'Symbol', render:t=>`<b style="color:var(--accent)">${_btEsc(t.symbol)}</b>`},
      {label:'Entry', render:t=>_btEsc(t.entry_date)},
      {label:'Exit', render:t=>_btEsc(t.exit_date || t.expiry_date)},
      {label:'Type', render:t=>_btEsc(t.trade_type)},
      {label:'DTE', render:t=>_btFmt(t.dte,0)},
      {label:'Entry Px', render:t=>`$${_btFmt(t.entry_price,2)}`},
      {label:'Exit Px', render:t=>`$${_btFmt(t.exit_price,2)}`},
      {label:'Move', render:t=>`<span style="color:${_btPctColor(t.price_change_pct)};font-weight:700">${_btFmt(t.price_change_pct,2)}%</span>`},
      {label:'Outcome', render:t=>`<span class="badge ${t.winner?'badge-green':'badge-red'}">${_btEsc(t.outcome)}</span>`},
      {label:'DTE rule', render:t=>`<div style="max-width:360px;font-size:10px;color:var(--muted);line-height:1.35">${_btEsc(t.exit_check || t.favorable_rule || '')}</div>`},
      {label:'Reason', render:t=>`<div style="max-width:340px;font-size:10px;color:var(--muted);line-height:1.35">${(t.reason||[]).slice(0,4).map(_btEsc).join('<br>')}</div>`},
    ];
    log.innerHTML = _btSummaryTable(trades, cols, 'No trades were taken. Try a wider date range, a different watchlist, or a looser scanner expression.');
  }

  const notes = document.getElementById('btg-notes');
  if (notes) notes.innerHTML = (d.notes || []).map(x => `• ${_btEsc(x)}`).join('<br>');
  const skipped = document.getElementById('btg-skipped');
  if (skipped) {
    const rows = (d.skipped || []).slice(0, 60);
    const errs = (d.errors || []).slice(0, 30);
    skipped.innerHTML = `
      ${rows.length ? `<details><summary style="cursor:pointer;color:var(--muted);font-size:11px">Skipped signals / evaluation notes (${d.skipped.length})</summary>${_btSummaryTable(rows, [{key:'date',label:'Date'}, {key:'symbol',label:'Symbol'}, {key:'reason',label:'Reason'}], '')}</details>` : ''}
      ${errs.length ? `<details style="margin-top:8px"><summary style="cursor:pointer;color:var(--muted);font-size:11px">Data errors (${d.errors.length})</summary>${_btSummaryTable(errs, [{key:'symbol',label:'Symbol'}, {key:'error',label:'Error'}], '')}</details>` : ''}`;
  }
}

async function _btLoadRuns() {
  const box = document.getElementById('btg-runs');
  const st = document.getElementById('btg-runs-status');
  if (!box) return;
  const controls = _savedRunsRenderControlsForBox('btg-runs', 'btg', '_btLoadRuns', _savedRunsLoadFromControls('btg'));
  if (st) st.textContent = 'Loading saved runs...';
  try {
    const f = _savedRunsLoadFromControls('btg');
    const qs = new URLSearchParams();
    qs.set('limit', String(Math.max(1, Math.min(200, Number(f.limit || 50)))));
    if (f.name) qs.set('run_name', f.name);
    if (f.dateFrom) qs.set('date_from', f.dateFrom);
    if (f.dateTo) qs.set('date_to', f.dateTo);
    const resp = await fetch('/backtest/api/runs?' + qs.toString());
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      box.innerHTML = controls + `<div style="font-size:12px;color:var(--muted);padding:10px">Historical runs unavailable: ${_btEsc(data.error || resp.statusText)}.</div>`;
      if (st) st.textContent = '';
      return;
    }
    const rows = data.runs || [];
    if (st) st.textContent = rows.length ? `${rows.length} saved run${rows.length===1?'':'s'}` : 'No saved runs yet';
    const cols = [
      {label:'Saved', render:r=>_btEsc(String(r.created_at || '').replace('T',' '))},
      {label:'Name', render:r=>`<button class="btn btn-ghost" style="padding:3px 6px" onclick="_btOpenRun('${_btEsc(r.run_id)}')">${_btEsc(r.run_name || r.run_id)}</button>`},
      {label:'Strategy', render:r=>_btEsc(r.config?.strategy_label || r.config?.scanner_name || 'Custom')},
      {label:'Symbol/Universe', render:r=>_btEsc(r.config?.symbol || `${r.config?.universe_count || 0} symbols`)},
      {label:'Type', render:r=>`${_btEsc(r.config?.trade_type || '')} ${_btFmt(r.config?.dte,0)}DTE${Number(r.config?.earnings_avoid_days || 0) > 0 ? ' · avoid earn ≤' + _btFmt(r.config?.earnings_avoid_days,0) + 'd' : ''}`},
      {label:'Trades', render:r=>_btFmt(r.stats?.closed_trades || r.stats?.total_trades,0)},
      {label:'Win %', render:r=>`<span style="color:${Number(r.stats?.win_rate)>=50?'#22c55e':'#ef4444'};font-weight:700">${_btFmt(r.stats?.win_rate,2)}%</span>`},
    ];
    box.innerHTML = controls + _savedRunsRenderPicker('btg', rows, '_btOpenRun') + _btSummaryTable(rows, cols, 'No saved runs yet. Run a backtest with save enabled or use Save current result.');
  } catch(e) {
    box.innerHTML = controls + `<div style="font-size:12px;color:var(--muted);padding:10px">Historical runs unavailable: ${_btEsc(e.message)}</div>`;
    if (st) st.textContent = '';
  }
}

async function _btOpenRun(runId) {
  const st = document.getElementById('btg-status');
  if (st) st.innerHTML = `Loading saved run ${_btEsc(runId)}...`;
  try {
    const resp = await fetch(`/backtest/api/runs/${encodeURIComponent(runId)}`);
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      if (st) st.innerHTML = `❌ ${_btEsc(data.error || resp.statusText)}`;
      return;
    }
    const run = data.run || {};
    const result = {
      ok: true,
      saved: true,
      run_id: run.run_id,
      run_name: run.run_name,
      created_at: run.created_at,
      engine: run.engine,
      config: run.config || {},
      stats: run.stats || {},
      trades: run.trades || [],
      open_trades: run.open_trades || [],
      symbol_performance: run.symbol_performance || [],
      strategy_summary: run.strategy_summary || [],
      strategy_symbol_summary: run.strategy_symbol_summary || [],
      daily_log: run.daily_log || [],
      skipped: run.skipped_sample || [],
      errors: run.errors || [],
      notes: run.notes || [],
    };
    _btGenericState.lastResult = result;
    window._btGenericState = _btGenericState;
    _btRenderChronologicalResults(result);
    if (st) st.innerHTML = `✅ Loaded saved run ${_btEsc(run.run_name || run.run_id)}`;
  } catch(e) {
    if (st) st.innerHTML = `❌ ${_btEsc(e.message)}`;
  }
}


// ── Replay Lab: module replay for Seller Flow, Weekly Plan, and GEX Plan ──
let _rplLastResult = null;

function _rplVal(id, fallback='') { return document.getElementById(id)?.value ?? fallback; }
function _rplChecked(id) { return !!document.getElementById(id)?.checked; }
function _rplStatus(msg, good=false) {
  const el = document.getElementById('rpl-status');
  if (!el) return;
  el.innerHTML = msg || '';
  el.style.color = good ? '#22c55e' : 'var(--muted)';
}
function _rplModules() {
  const mods = [];
  if (_rplChecked('rpl-mod-seller')) mods.push('seller_flow');
  if (_rplChecked('rpl-mod-weekly')) mods.push('weekly_plan');
  if (_rplChecked('rpl-mod-gex')) mods.push('gex_plan');
  return mods;
}
function _rplPayload() {
  return {
    run_name: _rplVal('rpl-run-name') || `Replay Lab ${new Date().toISOString().slice(0,10)}`,
    start_date: _rplVal('rpl-start'),
    end_date: _rplVal('rpl-end'),
    watchlist_id: _rplVal('rpl-watchlist'),
    symbol: String(_rplVal('rpl-symbol') || '').trim().toUpperCase(),
    max_symbols: Number(_rplVal('rpl-max-symbols') || 0),
    modules: _rplModules(),
    max_trades_per_day: Number(_rplVal('rpl-max-trades') || 8),
    save_run: _rplChecked('rpl-save'),
    outcome_model: _rplVal('rpl-outcome-model') || 'touch_stop',
    stop_buffer_pct: Number(_rplVal('rpl-stop-buffer') || 0),
    overlap_mode: _rplVal('rpl-overlap-mode') || 'symbol',
    max_open_positions: Number(_rplVal('rpl-max-open') || 12),
    save_all_signals: String(_rplVal('rpl-save-signals') || '1') !== '0',
    oi_quality_min: Number(_rplVal('rpl-oi-quality') || 4),
    oi_st_days: Number(_rplVal('rpl-oi-st') || 5),
    oi_mt_days: Number(_rplVal('rpl-oi-mt') || 15),
    oi_lt_days: Number(_rplVal('rpl-oi-lt') || 30),
    oi_dte: Number(_rplVal('rpl-oi-dte') || 30),
    otm_pct: Number(_rplVal('rpl-otm') || 2),
    strike_width: Number(_rplVal('rpl-width') || 5),
    weekly_symbols: _rplVal('rpl-weekly-symbols') || 'SPY,QQQ,IWM',
    weekly_run_weekday: Number(_rplVal('rpl-weekly-day') || 0),
    weekly_min_score: Number(_rplVal('rpl-weekly-score') || 55),
    gex_symbols: _rplVal('rpl-gex-symbols') || 'SPY',
    gex_run_time: _rplVal('rpl-gex-time') || '10:00',
    gex_trade_mode: _rplVal('rpl-gex-mode') || 'auto',
    gex_min_strength_pct: Number(_rplVal('rpl-gex-strength') || 8),
    data_provider: document.getElementById('btg-data-provider')?.value || 'auto',
    auto_fetch: document.getElementById('btg-auto-fetch')?.checked !== false,
  };
}
async function _rplLoadWatchlists() {
  const sel = document.getElementById('rpl-watchlist');
  if (!sel) return;
  try {
    const data = await api('/replay-lab/api/watchlists');
    const rows = data.watchlists || [];
    sel.innerHTML = rows.map(w => `<option value="${_btEsc(w.id)}" ${Number(w.id)===Number(data.preferred_watchlist_id)?'selected':''}>${_btEsc(w.name)} (${w.symbol_count || 0})</option>`).join('') || '<option value="">No watchlists</option>';
  } catch(e) {
    sel.innerHTML = '<option value="">Watchlists unavailable</option>';
  }
}
async function _rplRun() {
  const payload = _rplPayload();
  if (!payload.modules.length) { _rplStatus('❌ Select at least one module.'); return; }
  _rplStatus('⏳ Running Replay Lab… this may take a few minutes for large watchlists.');
  const btns = [...document.querySelectorAll('button')].filter(b => /Replay Lab/.test(b.textContent || ''));
  btns.forEach(b => b.disabled = true);
  try {
    const resp = await fetch('/replay-lab/api/run', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)});
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error || data.ok === false) {
      _rplStatus(`❌ ${_btEsc(data.error || resp.statusText || 'Replay failed')}`);
      return;
    }
    _rplLastResult = data;
    _rplRender(data);
    _rplStatus(`✅ Replay complete · ${_btFmt(data.stats?.closed_trades || data.trades?.length || 0,0)} trades${data.saved ? ' · saved' : ''}`, true);
    _rplLoadRuns();
  } catch(e) {
    _rplStatus(`❌ ${_btEsc(e.message || e)}`);
  } finally {
    btns.forEach(b => b.disabled = false);
  }
}
function _rplClear() {
  _rplLastResult = null;
  const box = document.getElementById('rpl-results');
  if (box) box.style.display = 'none';
  _rplStatus('Ready');
}
function _rplRender(d) {
  const root = document.getElementById('rpl-results');
  if (!root) return;
  root.style.display = '';
  const s = d.stats || {};
  const stats = document.getElementById('rpl-stats');
  if (stats) stats.innerHTML = [
    _btStatChip('Trades', _btFmt(s.closed_trades || s.total_trades, 0), 'var(--text)'),
    _btStatChip('Win rate', `${_btFmt(s.win_rate, 2)}%`, Number(s.win_rate)>=50?'#22c55e':'#ef4444'),
    _btStatChip('Winners', _btFmt(s.winners,0), '#22c55e'),
    _btStatChip('Losers', _btFmt(s.losers,0), '#ef4444'),
    _btStatChip('Signals', _btFmt(s.signals_found,0), 'var(--muted)'),
    _btStatChip('No entry', _btFmt(s.signals_not_entered,0), 'var(--muted)'),
    _btStatChip('Path breaches', _btFmt(s.path_breaches,0), Number(s.path_breaches)>0?'#f59e0b':'var(--muted)'),
    _btStatChip('Avg move', `${_btFmt(s.avg_price_change_pct,2)}%`, _btPctColor(s.avg_price_change_pct)),
    _btStatChip('Days', _btFmt(s.days_processed,0), 'var(--muted)'),
  ].join('');
  const perfCols = [
    {key:'strategy', label:'Group', render:r=>`<b>${_btEsc(r.strategy || r.symbol || '')}</b>`},
    {key:'trades', label:'Trades', render:r=>_btFmt(r.trades,0)},
    {key:'winners', label:'Wins', render:r=>`<span style="color:#22c55e;font-weight:800">${_btFmt(r.winners,0)}</span>`},
    {key:'losers', label:'Losses', render:r=>`<span style="color:#ef4444;font-weight:800">${_btFmt(r.losers,0)}</span>`},
    {key:'win_rate', label:'Win %', render:r=>`<span style="color:${Number(r.win_rate)>=50?'#22c55e':'#ef4444'};font-weight:800">${_btFmt(r.win_rate,2)}%</span>`},
    {key:'avg_quality_score', label:'Avg Q', render:r=>_btFmt(r.avg_quality_score,1)},
    {key:'avg_price_change_pct', label:'Avg move', render:r=>`<span style="color:${_btPctColor(r.avg_price_change_pct)}">${_btFmt(r.avg_price_change_pct,2)}%</span>`},
  ];
  const moduleBox = document.getElementById('rpl-module-summary');
  if (moduleBox) moduleBox.innerHTML = _btSummaryTable(d.module_summary || d.strategy_symbol_summary || [], perfCols, 'No module summary yet.');
  const symbolBox = document.getElementById('rpl-symbol-summary');
  if (symbolBox) symbolBox.innerHTML = _btSummaryTable(d.symbol_performance || [], [{key:'symbol', label:'Symbol', render:r=>`<b style="color:var(--accent)">${_btEsc(r.symbol)}</b>`}, ...perfCols.slice(1)], 'No symbol summary yet.');
  const trades = d.trades || [];
  const cnt = document.getElementById('rpl-trade-count');
  if (cnt) cnt.textContent = `(${trades.length})`;
  const log = document.getElementById('rpl-trade-log');
  if (log) {
    const cols = [
      {label:'Found', render:t=>_btEsc(t.entry_date)},
      {label:'Module', render:t=>`<b>${_btEsc(t.module)}</b>`},
      {label:'Symbol', render:t=>`<b style="color:var(--accent)">${_btEsc(t.symbol)}</b>`},
      {label:'Actual trade', render:t=>`<b>${_btEsc(t.trade_description || ((t.symbol||'')+' '+(t.strategy||t.trade_type||'')))}</b><div style="font-size:10px;color:var(--muted)">${_btEsc(t.strikes || '')}</div><div style="font-size:10px;color:var(--muted)">Target ${_btEsc(t.target_expiry_date || t.expiry_date || '')} · held ${_btFmt(t.days_held,0)}d</div>`},
      {label:'Q', render:t=>`<span class="badge">Q${_btFmt(t.quality_level,0)} ${_btEsc(t.quality_label || '')} · ${_btFmt(t.quality_score,1)}</span>`},
      {label:'Underlying', render:t=>`$${_btFmt(t.entry_price,2)} → $${_btFmt(t.exit_price,2)}<div style="font-size:10px;color:${_btPctColor(t.price_change_pct)};font-weight:800">${_btFmt(t.price_change_pct,2)}%</div>`},
      {label:'Path risk', render:t=>`<div style="font-size:11px;color:${t.path_breach?'#f59e0b':'var(--muted)'};font-weight:800">${t.path_breach?'BREACHED':'No breach'}</div><div style="font-size:10px;color:var(--muted)">H ${_btFmt(t.max_underlying_during_hold,2)} / L ${_btFmt(t.min_underlying_during_hold,2)}</div><div style="font-size:10px;color:var(--muted)">MAE ${_btFmt(t.mae_down_pct,2)}% · MFE ${_btFmt(t.mfe_up_pct,2)}%</div>`},
      {label:'Outcome', render:t=>`<span class="badge ${t.winner?'badge-green':'badge-red'}">${_btEsc(t.outcome)}</span><div style="font-size:10px;color:var(--muted)">${_btEsc(t.outcome_model || '')}</div>`},
      {label:'Rationale / exit check', render:t=>`<div style="max-width:620px;font-size:11px;color:var(--muted);line-height:1.35">${(t.reason || []).slice(0,3).map(_btEsc).join('<br>')}<br><span>${_btEsc(t.exit_check || '')}</span></div>`},
    ];
    log.innerHTML = _btSummaryTable(trades, cols, 'No trades selected. Try a lower quality threshold, more symbols, or a wider date range.');
  }
  const dl = document.getElementById('rpl-daily-log');
  if (dl) dl.innerHTML = _btSummaryTable((d.daily_log || []).slice(-120), [
    {key:'date', label:'Date'},
    {key:'signals', label:'Signals', render:r=>_btFmt(r.signals,0)},
    {key:'entries', label:'Entries', render:r=>_btFmt(r.entries,0)},
    {key:'closed_outcomes', label:'Closed', render:r=>_btFmt(r.closed_outcomes,0)},
  ], 'No daily signal log.');
  const skipped = document.getElementById('rpl-skipped-log');
  if (skipped) {
    const rows = (d.skipped || []).slice(0, 120);
    skipped.innerHTML = rows.length ? `<div class="card-title" style="font-size:12px;margin:8px 0">WAIT / blocked / skipped signal log</div>` + _btSummaryTable(rows, [
      {key:'date', label:'Date'},
      {key:'module', label:'Module'},
      {key:'symbol', label:'Symbol'},
      {label:'Reason', render:r=>`<div style="max-width:720px;font-size:11px;color:var(--muted);line-height:1.35">${_btEsc(r.reason || '')}${r.signal ? '<br><b>Signal:</b> '+_btEsc(r.signal.seller_flow_label || r.signal.strategy || '')+' Q'+_btFmt(r.signal.quality_level,0)+' · '+_btFmt(r.signal.quality_score,1) : ''}</div>`},
    ], '') : '';
  }
  const sigBox = document.getElementById('rpl-signal-log');
  if (sigBox) {
    const sigs = (d.signals || []).slice(0, 250);
    sigBox.innerHTML = sigs.length ? `<div class="card-title" style="font-size:12px;margin:8px 0">All candidate signal log <span style="color:var(--muted);font-weight:500">showing ${sigs.length} of ${(d.signals||[]).length}</span></div>` + _btSummaryTable(sigs, [
      {key:'date', label:'Date'},
      {key:'status', label:'Status', render:r=>`<span class="badge ${r.status==='ENTERED'?'badge-green':(r.status==='SKIPPED'?'badge-red':'')}">${_btEsc(r.status)}</span>`},
      {key:'module', label:'Module'},
      {key:'symbol', label:'Symbol', render:r=>`<b style="color:var(--accent)">${_btEsc(r.symbol)}</b>`},
      {label:'Trade found', render:r=>`<div style="min-width:240px">${_btEsc(r.trade_description || '')}</div><div style="font-size:10px;color:var(--muted)">Q${_btFmt(r.quality_level,0)} · ${_btFmt(r.quality_score,1)} · ${_btEsc(r.target_expiry_date || '')}</div>`},
      {label:'Reason', render:r=>`<div style="max-width:520px;font-size:11px;color:var(--muted)">${_btEsc(r.status_reason || '')}</div>`},
    ], '') : '';
  }
  const notes = document.getElementById('rpl-notes');
  if (notes) notes.innerHTML = (d.notes || []).map(n => `• ${_btEsc(n)}`).join('<br>');
}
async function _rplLoadRuns() {
  const box = document.getElementById('rpl-runs');
  if (!box) return;
  box.innerHTML = `<div style="font-size:12px;color:var(--muted);padding:8px">Loading saved runs…</div>`;
  try {
    const resp = await fetch('/replay-lab/api/runs?limit=50');
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) {
      box.innerHTML = `<div style="font-size:12px;color:#ef4444;padding:8px">${_btEsc(data.error || resp.statusText)}</div>`;
      return;
    }
    const rows = data.runs || [];
    const cols = [
      {label:'Saved', render:r=>_btEsc(String(r.created_at || '').replace('T',' '))},
      {label:'Name', render:r=>`<button class="btn btn-ghost" style="padding:3px 6px" onclick="_rplOpenRun('${_btEsc(r.run_id)}')">${_btEsc(r.run_name || r.run_id)}</button>`},
      {label:'Engine', render:r=>_btEsc(r.engine || '')},
      {label:'Modules/Strategy', render:r=>_btEsc((r.config?.modules || []).join(', ') || r.config?.strategy_label || r.config?.scanner_name || '')},
      {label:'Range', render:r=>`${_btEsc(r.config?.start_date || '')} → ${_btEsc(r.config?.end_date || '')}`},
      {label:'Trades', render:r=>_btFmt(r.stats?.closed_trades || r.stats?.total_trades,0)},
      {label:'Win %', render:r=>`<span style="color:${Number(r.stats?.win_rate)>=50?'#22c55e':'#ef4444'};font-weight:800">${_btFmt(r.stats?.win_rate,2)}%</span>`},
    ];
    box.innerHTML = _btSummaryTable(rows, cols, 'No saved runs yet.');
  } catch(e) {
    box.innerHTML = `<div style="font-size:12px;color:#ef4444;padding:8px">${_btEsc(e.message || e)}</div>`;
  }
}
async function _rplOpenRun(runId) {
  _rplStatus(`Loading saved run ${_btEsc(runId)}…`);
  try {
    const resp = await fetch(`/replay-lab/api/runs/${encodeURIComponent(runId)}`);
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) { _rplStatus(`❌ ${_btEsc(data.error || resp.statusText)}`); return; }
    const r = data.run || {};
    const result = {
      ok:true,
      saved:true,
      run_id:r.run_id,
      run_name:r.run_name,
      created_at:r.created_at,
      engine:r.engine,
      config:r.config || {},
      stats:r.stats || {},
      trades:r.trades || [],
      open_trades:r.open_trades || [],
      symbol_performance:r.symbol_performance || [],
      strategy_summary:r.strategy_summary || [],
      strategy_symbol_summary:r.strategy_symbol_summary || [],
      module_summary:r.strategy_symbol_summary || [],
      daily_log:r.daily_log || [],
      skipped:r.skipped_sample || r.skipped || [],
      signals:r.signals || [],
      errors:r.errors || [],
      notes:r.notes || [],
    };
    _rplLastResult = result;
    _rplRender(result);
    _rplStatus(`✅ Loaded ${_btEsc(r.run_name || r.run_id)}`, true);
  } catch(e) {
    _rplStatus(`❌ ${_btEsc(e.message || e)}`);
  }
}

window._jrnRefreshOptionContext = _jrnRefreshOptionContext;

// ── Quick Trade modal: log a Journal trade without leaving current tab ─────
let _quickTradeLegs = [];
let _quickTradeLastFocus = null;
let _quickTradeOptCtxTimer = null;
let _quickTradeScoreTimer = null;
let _quickTradePriceTimer = null;

function _quickTradeModal() { return document.getElementById('quick-trade-modal'); }
function _quickTradeStatus(msg, cls='') {
  const st = document.getElementById('quick-trade-status');
  if (!st) return;
  st.textContent = msg || '';
  st.className = cls || '';
}
function _quickTradeEsc(s) {
  return String(s == null ? '' : s).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
}
function _quickTradeCurrentSymbol() {
  const candidates = [
    document.getElementById('quick-trade-symbol')?.value,
    document.getElementById('quick-alert-symbol')?.value,
    document.getElementById('symbol-input')?.value,
    document.getElementById('agg-symbol')?.value,
    document.getElementById('ta-sym')?.value,
    document.getElementById('wk-symbol')?.value,
    document.getElementById('jrn-add-symbol')?.value,
    typeof currentSymbol !== 'undefined' ? currentSymbol : '',
  ];
  for (const v of candidates) {
    const s = String(v || '').trim().toUpperCase();
    if (s) return s;
  }
  return 'SPY';
}
function _quickTradeDefaultExpiry(days=28) {
  const d = new Date();
  d.setDate(d.getDate() + days);
  return d.toISOString().slice(0, 10);
}
function _quickTradeToday() {
  return new Date().toISOString().slice(0, 10);
}
function _quickTradeFirstOptionExpiry() {
  const leg = (_quickTradeLegs || []).find(l => l.option_type !== 'stock' && l.expiry);
  return leg ? leg.expiry : '';
}
function _quickTradeFirstOptionStrike() {
  const leg = (_quickTradeLegs || []).find(l => l.option_type !== 'stock' && l.strike);
  const v = leg ? parseFloat(leg.strike) : null;
  return Number.isFinite(v) ? v : null;
}
function _quickTradeScheduleOptionContext() {
  clearTimeout(_quickTradeOptCtxTimer);
  _quickTradeOptCtxTimer = setTimeout(() => _quickTradeRefreshOptionContext(false), 450);
}
function _quickTradeScheduleDraftScore() {
  clearTimeout(_quickTradeScoreTimer);
  _quickTradeScoreTimer = setTimeout(() => _quickTradePreviewEntryScore(true), 950);
}
function _quickTradeSymbolChanged() {
  _quickTradeScheduleOptionContext();
  _quickTradeScheduleDraftScore();
}
function _quickTradeTemplates(type) {
  const exp = _quickTradeDefaultExpiry(28);
  return {
    Stock:    [{side:'buy',  option_type:'stock', strike:'', expiry:'',  qty:100, price:''}],
    PS:       [{side:'sell', option_type:'put',   strike:'', expiry:exp, qty:1,   price:''}, {side:'buy', option_type:'put',  strike:'', expiry:exp, qty:1, price:''}],
    CS:       [{side:'sell', option_type:'call',  strike:'', expiry:exp, qty:1,   price:''}, {side:'buy', option_type:'call', strike:'', expiry:exp, qty:1, price:''}],
    IC:       [{side:'sell', option_type:'put',   strike:'', expiry:exp, qty:1,   price:''}, {side:'buy', option_type:'put',  strike:'', expiry:exp, qty:1, price:''}, {side:'sell', option_type:'call', strike:'', expiry:exp, qty:1, price:''}, {side:'buy', option_type:'call', strike:'', expiry:exp, qty:1, price:''}],
    PB:       [{side:'buy',  option_type:'call',  strike:'', expiry:exp, qty:1,   price:''}, {side:'sell', option_type:'call', strike:'', expiry:exp, qty:1, price:''}],
    CB:       [{side:'buy',  option_type:'put',   strike:'', expiry:exp, qty:1,   price:''}, {side:'sell', option_type:'put',  strike:'', expiry:exp, qty:1, price:''}],
    CC:       [{side:'buy',  option_type:'stock', strike:'', expiry:'',  qty:100, price:''}, {side:'sell', option_type:'call', strike:'', expiry:exp, qty:1, price:''}],
    CP:       [{side:'sell', option_type:'stock', strike:'', expiry:'',  qty:100, price:''}, {side:'sell', option_type:'put',  strike:'', expiry:exp, qty:1, price:''}],
    Straddle: [{side:'buy',  option_type:'call',  strike:'', expiry:exp, qty:1,   price:''}, {side:'buy',  option_type:'put',  strike:'', expiry:exp, qty:1, price:''}],
    Strangle: [{side:'sell', option_type:'call',  strike:'', expiry:exp, qty:1,   price:''}, {side:'sell', option_type:'put',  strike:'', expiry:exp, qty:1, price:''}],
    Calendar: [{side:'buy',  option_type:'call',  strike:'', expiry:exp, qty:1,   price:''}, {side:'sell', option_type:'call', strike:'', expiry:'', qty:1, price:''}],
    Butterfly:[{side:'buy',  option_type:'call',  strike:'', expiry:exp, qty:1,   price:''}, {side:'sell', option_type:'call', strike:'', expiry:exp, qty:2, price:''}, {side:'buy', option_type:'call', strike:'', expiry:exp, qty:1, price:''}],
    Custom:   [{side:'buy',  option_type:'call',  strike:'', expiry:exp, qty:1,   price:''}],
  }[type] || [];
}
async function _quickTradeLoadPicklists() {
  try {
    const d = await api('/watchlists/alerts/picklists');
    const list = document.getElementById('quick-trade-symbol-list');
    if (list) list.innerHTML = (d.symbols || []).map(s => `<option value="${_quickTradeEsc(String(s).toUpperCase())}"></option>`).join('');
  } catch (e) {
    // Non-blocking; users can still type a symbol.
  }
}
function _resetQuickTradeForm(preset={}) {
  const sym = document.getElementById('quick-trade-symbol');
  const typ = document.getElementById('quick-trade-type');
  const dt  = document.getElementById('quick-trade-entry-date');
  const px  = document.getElementById('quick-trade-price');
  const rt  = document.getElementById('quick-trade-reason-type');
  const nt  = document.getElementById('quick-trade-notes');
  if (sym) sym.value = String(preset.symbol || _quickTradeCurrentSymbol() || 'SPY').toUpperCase();
  const type = preset.trade_type || preset.type || 'IC';
  if (typ) typ.value = type;
  if (dt) dt.value = preset.entry_date || _quickTradeToday();
  if (px) px.value = preset.entry_price != null ? Number(preset.entry_price).toFixed(2) : '';
  if (rt) rt.value = preset.reason_type || (['PS','CS','IC','Strangle'].includes(type) ? 'INCOME' : 'OTHER');
  if (nt) nt.value = preset.notes || '';
  _quickTradeLegs = Array.isArray(preset.legs) && preset.legs.length
    ? preset.legs.map(l => ({...l}))
    : _quickTradeTemplates(type).map(l => ({...l}));
  _quickTradeRenderLegs();
  const sp = document.getElementById('quick-trade-score-preview');
  if (sp) sp.innerHTML = 'Enter symbol, expiry, strikes, and leg prices, then preview. This reuses the Journal Add Trade health-score endpoint and renderer.';
  _quickTradeStatus('');
  _quickTradeScheduleOptionContext();
}
async function _openQuickTradeModal(preset={}) {
  const modal = _quickTradeModal();
  if (!modal) return;
  _quickTradeLastFocus = document.activeElement;
  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.classList.add('modal-open');
  _resetQuickTradeForm(preset || {});
  await _quickTradeLoadPicklists();
  const sym = document.getElementById('quick-trade-symbol');
  if (sym && !sym.dataset.ucReady && typeof uc === 'function') { uc(sym); sym.dataset.ucReady = '1'; }
  setTimeout(() => { sym?.focus?.(); sym?.select?.(); }, 30);
  setTimeout(() => _quickTradeRefreshOptionContext(false), 120);
}
function _closeQuickTradeModal() {
  const modal = _quickTradeModal();
  if (!modal) return;
  modal.classList.remove('open');
  modal.setAttribute('aria-hidden', 'true');
  document.body.classList.remove('modal-open');
  try { _quickTradeLastFocus?.focus?.(); } catch {}
}
function _quickTradeTypeChanged() {
  const type = document.getElementById('quick-trade-type')?.value || 'IC';
  _quickTradeLegs = _quickTradeTemplates(type).map(l => ({...l}));
  const rt = document.getElementById('quick-trade-reason-type');
  if (rt) rt.value = ['PS','CS','IC','Strangle','CC','CP'].includes(type) ? 'INCOME' : type === 'Stock' ? 'OTHER' : 'TRENDING';
  _quickTradeRenderLegs();
  _quickTradeScheduleOptionContext();
  _quickTradeScheduleDraftScore();
}
function _quickTradeTemplate(type) {
  const typ = document.getElementById('quick-trade-type');
  if (typ) typ.value = type;
  _quickTradeTypeChanged();
}
function _quickTradeAddLeg() {
  const exp = _quickTradeLegs.find(l => l.option_type !== 'stock' && l.expiry)?.expiry || _quickTradeDefaultExpiry(28);
  const qty = _quickTradeLegs.length ? (_quickTradeLegs[0].qty || 1) : 1;
  _quickTradeLegs.push({side:'buy', option_type:'call', strike:'', expiry: exp, qty: qty, price: ''});
  const typ = document.getElementById('quick-trade-type');
  if (typ && !['Custom','IC','Strangle','Straddle','Calendar','Butterfly'].includes(typ.value)) typ.value = 'Custom';
  _quickTradeRenderLegs();
  _quickTradeScheduleOptionContext();
  _quickTradeScheduleDraftScore();
}
function _quickTradeClearLegs() {
  _quickTradeLegs = [];
  _quickTradeRenderLegs();
  _quickTradeScheduleOptionContext();
  _quickTradeScheduleDraftScore();
}
function _quickTradeCascadeFirstLeg(field, val, oldVal) {
  if (!_quickTradeLegs || !_quickTradeLegs.length) return [];
  const typ = document.getElementById('quick-trade-type')?.value || '';
  const changed = [];
  if (field === 'qty') {
    // Match the full Journal Add Trade behavior: normal spreads sync qty; Butterfly and Custom keep row-level ratios.
    if (typ === 'Butterfly' || typ === 'Custom') return changed;
    for (let j = 1; j < _quickTradeLegs.length; j++) {
      if (_quickTradeLegs[j]?.option_type === 'stock') continue;
      _quickTradeLegs[j].qty = val;
      changed.push(j);
    }
  } else if (field === 'expiry') {
    // Match Journal Add Trade: Calendar and Custom can keep row-level expiries.
    if (typ === 'Calendar' || typ === 'Custom') return changed;
    for (let j = 1; j < _quickTradeLegs.length; j++) {
      const l = _quickTradeLegs[j];
      if (!l || l.option_type === 'stock') continue;
      if (!l.expiry || l.expiry === oldVal) {
        l.expiry = val;
        l.price = '';
        changed.push(j);
      }
    }
  }
  return changed;
}
function _quickTradeSchedulePremiumFetch(i=null, all=false) {
  clearTimeout(_quickTradePriceTimer);
  _quickTradePriceTimer = setTimeout(() => {
    if (all) _quickTradeFetchAllPremiums(true);
    else if (i != null) _quickTradeFetchLegPremium(i, true);
  }, 450);
}
async function _quickTradeFetchLegPremium(i, quiet=false) {
  const leg = _quickTradeLegs[i];
  if (!leg || leg.option_type === 'stock' || !leg.expiry || !leg.strike) return null;
  const sym = String(document.getElementById('quick-trade-symbol')?.value || '').trim().toUpperCase();
  if (!sym) return null;
  if (!quiet) _quickTradeStatus(`Fetching live price for leg ${i + 1}…`, 'warn');
  try {
    const q = await _jrnFetchOptionLegPremium(sym, leg);
    if (q && q.price != null) {
      _quickTradeLegs[i].price = Number(q.price).toFixed(2);
      _quickTradeRenderLegs();
      _quickTradeScheduleDraftScore();
      if (!quiet) _quickTradeStatus(`Updated leg ${i + 1} from ${q.source || 'live option chain'}.`, 'ok');
      return q;
    }
    if (!quiet) _quickTradeStatus(`No live option price found for leg ${i + 1}.`, 'warn');
  } catch (e) {
    if (!quiet) _quickTradeStatus(`Live price failed for leg ${i + 1}: ${e.message || e}`, 'err');
  }
  return null;
}
async function _quickTradeFetchAllPremiums(force=true) {
  const sym = String(document.getElementById('quick-trade-symbol')?.value || '').trim().toUpperCase();
  if (!sym) { _quickTradeStatus('Enter a symbol before refreshing prices.', 'err'); return; }
  const idxs = (_quickTradeLegs || [])
    .map((l, i) => ({l, i}))
    .filter(x => x.l && x.l.option_type !== 'stock' && x.l.expiry && x.l.strike)
    .map(x => x.i);
  if (!idxs.length) { _quickTradeStatus('Enter expiry and strike for at least one option leg.', 'warn'); return; }
  _quickTradeStatus(`Fetching live prices for ${idxs.length} leg${idxs.length === 1 ? '' : 's'}…`, 'warn');
  let ok = 0;
  for (const i of idxs) {
    const q = await _jrnFetchOptionLegPremium(sym, _quickTradeLegs[i]);
    if (q && q.price != null) {
      _quickTradeLegs[i].price = Number(q.price).toFixed(2);
      ok++;
    }
  }
  _quickTradeRenderLegs();
  _quickTradeScheduleDraftScore();
  _quickTradeStatus(ok ? `Updated ${ok}/${idxs.length} leg prices from live option chain.` : 'No live prices found for the completed legs.', ok ? 'ok' : 'warn');
}
function _quickTradeUpdateNetDisplay() {
  const netEl = document.getElementById('quick-trade-net');
  const pxEl = document.getElementById('quick-trade-price');
  const net = _quickTradeNet();
  if (netEl) {
    netEl.textContent = (net >= 0 ? '+' : '-') + '$' + Math.abs(net).toFixed(2);
    netEl.style.color = net > 0 ? '#22c55e' : net < 0 ? '#ef4444' : 'var(--muted)';
  }
  if (pxEl) pxEl.value = net.toFixed(2);
}
function _quickTradeChange(i, field, value, rerender=true) {
  if (!_quickTradeLegs[i]) return;
  const oldVal = _quickTradeLegs[i][field];
  _quickTradeLegs[i][field] = value;
  let fetchOne = false;
  let fetchAll = false;

  if (field === 'option_type' && value === 'stock') {
    _quickTradeLegs[i].strike = '';
    _quickTradeLegs[i].expiry = '';
    _quickTradeLegs[i].qty = _quickTradeLegs[i].qty || 100;
    _quickTradeLegs[i].price = '';
    rerender = true;
  }

  if (field === 'qty' && i === 0) {
    const changed = _quickTradeCascadeFirstLeg('qty', value, oldVal);
    if (changed.length) rerender = true;
  }

  if (field === 'expiry') {
    if (_quickTradeLegs[i].option_type !== 'stock') _quickTradeLegs[i].price = '';
    if (i === 0) {
      const changed = _quickTradeCascadeFirstLeg('expiry', value, oldVal);
      if (changed.length) {
        fetchAll = true;
        rerender = true;
      }
    }
    fetchOne = !fetchAll;
  }

  if (field === 'strike' || field === 'option_type') {
    if (_quickTradeLegs[i].option_type !== 'stock') _quickTradeLegs[i].price = '';
    fetchOne = true;
  }

  if (rerender) _quickTradeRenderLegs();
  else _quickTradeUpdateNetDisplay();

  if (['strike','expiry','option_type','side','price','qty'].includes(field)) {
    _quickTradeScheduleOptionContext();
    _quickTradeScheduleDraftScore();
  }
  if (fetchAll) _quickTradeSchedulePremiumFetch(null, true);
  else if (fetchOne) _quickTradeSchedulePremiumFetch(i, false);
}

function _quickTradeDeleteLeg(i) {
  _quickTradeLegs.splice(i, 1);
  _quickTradeRenderLegs();
  _quickTradeScheduleOptionContext();
  _quickTradeScheduleDraftScore();
}
function _quickTradeNet() {
  let net = 0;
  (_quickTradeLegs || []).forEach(l => {
    const px = parseFloat(l.price || 0) || 0;
    const q = Math.max(1, parseInt(l.qty || 1, 10) || 1);
    net += (l.side === 'sell' ? px : -px) * q;
  });
  return net;
}
function _quickTradeRenderLegs() {
  const wrap = document.getElementById('quick-trade-legs');
  const netEl = document.getElementById('quick-trade-net');
  const pxEl = document.getElementById('quick-trade-price');
  if (!wrap) return;
  const header = `<div class="quick-trade-leg-header"><span>Side</span><span>Type</span><span>Strike</span><span>Expiry</span><span>Qty</span><span>Price</span><span></span></div>`;
  const rows = (_quickTradeLegs || []).map((l, i) => {
    const isStock = String(l.option_type || '') === 'stock';
    return `<div class="quick-trade-leg-row" data-idx="${i}">
      <select onchange="_quickTradeChange(${i},'side',this.value,false)">
        <option value="buy" ${l.side === 'buy' ? 'selected' : ''}>BUY</option>
        <option value="sell" ${l.side === 'sell' ? 'selected' : ''}>SELL</option>
      </select>
      <select onchange="_quickTradeChange(${i},'option_type',this.value)">
        <option value="call" ${l.option_type === 'call' ? 'selected' : ''}>CALL</option>
        <option value="put" ${l.option_type === 'put' ? 'selected' : ''}>PUT</option>
        <option value="stock" ${isStock ? 'selected' : ''}>STOCK</option>
      </select>
      <input type="number" step="0.01" placeholder="Strike" value="${_quickTradeEsc(l.strike || '')}" ${isStock ? 'disabled' : ''} oninput="_quickTradeChange(${i},'strike',this.value,false)" />
      <input type="date" value="${_quickTradeEsc(l.expiry || '')}" ${isStock ? 'disabled' : ''} onchange="_quickTradeChange(${i},'expiry',this.value,false)" />
      <input type="number" step="1" min="1" value="${_quickTradeEsc(l.qty || (isStock ? 100 : 1))}" oninput="_quickTradeChange(${i},'qty',this.value,false)" />
      <input type="number" step="0.01" placeholder="0.00" value="${_quickTradeEsc(l.price || '')}" oninput="_quickTradeChange(${i},'price',this.value,false)" />
      <button type="button" class="quick-trade-leg-delete" title="Delete leg" onclick="_quickTradeDeleteLeg(${i})">×</button>
    </div>`;
  }).join('');
  wrap.innerHTML = header + (rows || '<div style="font-size:12px;color:var(--muted);padding:12px;border:1px dashed var(--border);border-radius:9px">No legs yet. Use Quick fill or + Leg.</div>');
  const net = _quickTradeNet();
  if (netEl) {
    netEl.textContent = (net >= 0 ? '+' : '-') + '$' + Math.abs(net).toFixed(2);
    netEl.style.color = net > 0 ? '#22c55e' : net < 0 ? '#ef4444' : 'var(--muted)';
  }
  if (pxEl) pxEl.value = net.toFixed(2);
}
function _quickTradeInferQty(legs) {
  try {
    if (!Array.isArray(legs) || !legs.length) return 1;
    const opts = legs.filter(l => l.option_type !== 'stock').map(l => Math.max(1, parseInt(l.qty || 1, 10) || 1));
    if (!opts.length) return Math.max(1, parseInt(legs[0]?.qty || 1, 10) || 1);
    const gcd = (a, b) => b ? gcd(b, a % b) : a;
    return opts.reduce((a, b) => gcd(a, b), opts[0]) || 1;
  } catch (e) { return 1; }
}
function _quickTradeBuildPayload(opts={}) {
  const sym = String(document.getElementById('quick-trade-symbol')?.value || '').trim().toUpperCase();
  if (!sym) { if (opts.silent) return null; throw new Error('Symbol required'); }
  const type = document.getElementById('quick-trade-type')?.value || 'IC';
  let legs = (_quickTradeLegs || []).map(l => ({
    side: String(l.side || 'buy'),
    option_type: String(l.option_type || 'call'),
    strike: parseFloat(l.strike || 0) || 0,
    expiry: String(l.expiry || ''),
    qty: Math.max(1, parseInt(l.qty || 1, 10) || 1),
    price: parseFloat(l.price || 0) || 0,
  }));
  if (type !== 'Stock' && !legs.filter(l => l.option_type !== 'stock').length) { if (opts.silent) return null; throw new Error('Add at least one option leg'); }
  if (type !== 'Stock') {
    const missingExpiry = legs.some(l => l.option_type !== 'stock' && !l.expiry);
    if (missingExpiry && !opts.allowIncomplete) throw new Error('Expiry is required for each option leg');
  }
  if (type === 'Stock' && !legs.length) legs = [{side:'buy', option_type:'stock', strike:0, expiry:'', qty:100, price: parseFloat(document.getElementById('quick-trade-price')?.value || 0) || 0}];
  const exp = legs.find(l => l.option_type !== 'stock' && l.expiry)?.expiry || '';
  const reasonType = document.getElementById('quick-trade-reason-type')?.value || 'OTHER';
  const notes = document.getElementById('quick-trade-notes')?.value || '';
  const net = _quickTradeNet();
  return {
    symbol: sym,
    trade_type: type,
    expiry: exp,
    entry_date: document.getElementById('quick-trade-entry-date')?.value || _quickTradeToday(),
    entry_price: Math.abs(net),
    quantity: _quickTradeInferQty(legs),
    entry_reason: '[' + String(reasonType).toUpperCase() + '] ' + notes,
    legs: legs,
  };
}
async function _quickTradeRefreshOptionContext(force=true) {
  const sym = String(document.getElementById('quick-trade-symbol')?.value || '').trim().toUpperCase();
  return _renderOptionOiIvContext({
    panelId: 'quick-trade-oi-iv-panel',
    chartId: 'quick-trade-oi-iv-chart',
    statusId: 'quick-trade-oi-iv-status',
    selectId: 'quick-trade-oi-expiry-select',
    symbol: sym,
    force,
    preferredExpiry: force ? document.getElementById('quick-trade-oi-expiry-select')?.value : (_quickTradeFirstOptionExpiry() || document.getElementById('quick-trade-oi-expiry-select')?.value || ''),
    fallbackExpiryFn: _quickTradeFirstOptionExpiry,
    selectedStrikeFn: _quickTradeFirstOptionStrike,
    perSide: 24,
    emptyHeight: 220,
    margin: {l:38, r:42, t:32, b:38},
  });
}
async function _quickTradePreviewEntryScore(silent=false) {
  const panel = document.getElementById('quick-trade-score-preview');
  if (!panel) return;
  let payload = null;
  try { payload = _quickTradeBuildPayload({silent, allowIncomplete:true}); }
  catch(e) { panel.innerHTML = `<div style="color:#ef4444;font-size:11px">${_quickTradeEsc(e.message || e)}</div>`; return; }
  if (!payload || !payload.symbol) { if (!silent) panel.innerHTML = '<div style="color:#f59e0b;font-size:11px">Enter a symbol first.</div>'; return; }
  const hasOptionLeg = (payload.legs || []).some(l => l.option_type !== 'stock');
  if (hasOptionLeg && !payload.expiry && silent) return;
  panel.innerHTML = '<div style="color:var(--muted);font-size:11px;padding:8px 0">⏳ Calculating Journal AI score and recommendations…</div>';
  try {
    const d = await api('/journal/draft_health_score', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    if (d.error) { panel.innerHTML = `<div style="color:#ef4444;font-size:11px">${_quickTradeEsc(d.error)}</div>`; return; }
    window._lastConviction = d;
    if (typeof _jrnRenderEntryScorePreview === 'function') _jrnRenderEntryScorePreview(panel, d);
    else panel.innerHTML = `<pre>${_quickTradeEsc(JSON.stringify(d, null, 2))}</pre>`;
  } catch(e) {
    panel.innerHTML = `<div style="color:#ef4444;font-size:11px">AI score unavailable: ${_quickTradeEsc(e.message || e)}</div>`;
  }
}
async function _quickTradeSave() {
  let payload;
  try { payload = _quickTradeBuildPayload(); }
  catch (e) { _quickTradeStatus(e.message || String(e), 'err'); return; }
  _quickTradeStatus('Saving trade...', 'warn');
  try {
    const r = await api('/journal/trade/add', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)});
    _quickTradeStatus('Trade saved' + (r?.id ? ' #' + r.id : '') + '.', 'ok');
    try { if (typeof addNotif === 'function') addNotif('success', 'Trade saved', `${payload.symbol} ${payload.trade_type} added to Journal`, 'Journal'); } catch {}
    try { if (typeof jrnLoadOpen === 'function') jrnLoadOpen(); } catch {}
    try { if (typeof _loadPortfolioHeader === 'function') _loadPortfolioHeader(); } catch {}
    setTimeout(() => _closeQuickTradeModal(), 700);
  } catch (e) {
    _quickTradeStatus('Save failed: ' + (e.message || e), 'err');
  }
}
function _quickTradeOpenFullJournal() {
  let payload = null;
  try { payload = _quickTradeBuildPayload(); } catch (e) { /* still open journal */ }
  _closeQuickTradeModal();
  try { _setActiveTab('journal'); } catch {}
  setTimeout(() => {
    try { if (typeof jrnTab === 'function') jrnTab('add'); } catch {}
    if (payload) {
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v == null ? '' : v; };
      set('jrn-add-symbol', payload.symbol);
      set('jrn-add-type', payload.trade_type);
      set('jrn-add-entry-date', payload.entry_date);
      set('jrn-add-price', Number(payload.entry_price || 0).toFixed(2));
      set('jrn-add-reason', String(payload.entry_reason || '').replace(/^\[[^\]]+\]\s*/, ''));
      if (typeof _jrnLegs !== 'undefined') {
        _jrnLegs = (payload.legs || []).map(l => ({...l}));
        if (typeof _renderLegs === 'function') _renderLegs();
      }
      try { if (typeof _jrnTypeChanged === 'function') _jrnTypeChanged(); } catch {}
      try { if (typeof _jrnScheduleOptionContext === 'function') _jrnScheduleOptionContext(); } catch {}
    }
  }, 80);
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' && _quickTradeModal()?.classList.contains('open')) _closeQuickTradeModal();
});


// === FINAL STABILITY PATCH: OI/Weekly saved-run UX + Agentic run modes ===
(function(){
  function _esc(v){
    try { return String(v ?? '').replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
    catch(e){ return ''; }
  }
  function _dateDaysAgo(days){
    const d = new Date();
    d.setDate(d.getDate() - Number(days || 30));
    return d.toISOString().slice(0,10);
  }
  function _defaultDateFrom(prefix){
    try { return localStorage.getItem(prefix + '_saved_from') || _dateDaysAgo(30); } catch(e) { return _dateDaysAgo(30); }
  }
  function _rememberSavedFilters(prefix, f){
    try {
      localStorage.setItem(prefix + '_saved_from', f.dateFrom || '');
      localStorage.setItem(prefix + '_saved_to', f.dateTo || '');
      localStorage.setItem(prefix + '_saved_name', f.name || '');
      localStorage.setItem(prefix + '_saved_limit', String(f.limit || 50));
    } catch(e) {}
  }
  function _loadSavedFilters(prefix){
    try {
      return {
        name: localStorage.getItem(prefix + '_saved_name') || '',
        dateFrom: localStorage.getItem(prefix + '_saved_from') || _dateDaysAgo(30),
        dateTo: localStorage.getItem(prefix + '_saved_to') || '',
        limit: Number(localStorage.getItem(prefix + '_saved_limit') || 50)
      };
    } catch(e) { return {name:'', dateFrom:_dateDaysAgo(30), dateTo:'', limit:50}; }
  }
  function _hideBox(id){ const el = document.getElementById(id); if (el) el.style.display = 'none'; }
  function _boxAfter(hostId, boxId, emptyText){
    let box = document.getElementById(boxId);
    const host = document.getElementById(hostId);
    if (!box) {
      box = document.createElement('div');
      box.id = boxId;
      box.style.cssText = 'margin-top:12px;border:1px solid var(--border);border-radius:10px;padding:10px;background:rgba(255,255,255,.03)';
      if (host && host.parentElement) host.parentElement.insertBefore(box, host.nextSibling);
      else document.body.appendChild(box);
    } else if (host && host.parentElement && box.previousSibling !== host) {
      try { host.parentElement.insertBefore(box, host.nextSibling); } catch(e) {}
    }
    box.style.display = 'block';
    if (!box.dataset.emptyText) box.dataset.emptyText = emptyText || 'No saved runs yet.';
    return box;
  }
  function _boxInside(hostId, boxId, emptyText){
    let box = document.getElementById(boxId);
    const host = document.getElementById(hostId);
    if (!box) {
      box = document.createElement('div');
      box.id = boxId;
      box.style.cssText = 'margin-top:12px;border:1px solid var(--border);border-radius:10px;padding:10px;background:rgba(255,255,255,.03)';
    }
    if (host && box.parentElement !== host) host.appendChild(box);
    box.style.display = 'block';
    if (!box.dataset.emptyText) box.dataset.emptyText = emptyText || 'No saved runs yet.';
    return box;
  }
  function _setMiniTab(page, mode){
    const current = document.getElementById(page + '-current-pane');
    const saved = document.getElementById(page + '-saved-pane');
    const curBtn = document.getElementById(page + '-tab-current');
    const savBtn = document.getElementById(page + '-tab-saved');
    const isSaved = mode === 'saved';
    if (current) current.style.display = isSaved ? 'none' : '';
    if (saved) saved.style.display = isSaved ? '' : 'none';
    if (curBtn) { curBtn.classList.toggle('btn-primary', !isSaved); curBtn.classList.toggle('btn-secondary', isSaved); }
    if (savBtn) { savBtn.classList.toggle('btn-primary', isSaved); savBtn.classList.toggle('btn-secondary', !isSaved); }
  }
  window._oibSwitchPane = function(mode){ _setMiniTab('oib', mode === 'saved' ? 'saved' : 'current'); };
  window._weeklySwitchPane = function(mode){ _setMiniTab('wk', mode === 'saved' ? 'saved' : 'current'); };
  function _savedRunControls(boxId, prefix, refreshFn, filters){
    const f = Object.assign({name:'', dateFrom:_defaultDateFrom(prefix), dateTo:'', limit:50}, filters || {});
    return `<div style="display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;align-items:end;margin-bottom:8px">
      <div><label style="font-size:10px;color:var(--muted);font-weight:800">From date</label><input id="${prefix}-filter-from" type="date" value="${_esc(f.dateFrom)}" style="width:100%"/></div>
      <div><label style="font-size:10px;color:var(--muted)">To</label><input id="${prefix}-filter-to" type="date" value="${_esc(f.dateTo)}" style="width:100%"/></div>
      <div style="grid-column:span 2"><label style="font-size:10px;color:var(--muted)">Run name contains</label><input id="${prefix}-filter-name" type="text" value="${_esc(f.name)}" style="width:100%"/></div>
      <div><label style="font-size:10px;color:var(--muted)">Limit</label><input id="${prefix}-filter-limit" type="number" min="1" max="200" value="${_esc(f.limit || 50)}" style="width:100%"/></div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:end">
        <button class="btn btn-secondary" style="font-size:11px;padding:4px 8px" onclick="${refreshFn}()">Show runs</button>
        <button class="btn btn-secondary" style="font-size:11px;padding:4px 8px" onclick="${prefix==='wk' ? '_weeklySwitchPane(\'current\')' : '_oibSwitchPane(\'current\')'}">Hide</button>
      </div>
    </div>`;
  }
  window._savedRunsLoadFromControls = function(prefix) {
    const f = {
      name: document.getElementById(`${prefix}-filter-name`)?.value || '',
      dateFrom: document.getElementById(`${prefix}-filter-from`)?.value || '',
      dateTo: document.getElementById(`${prefix}-filter-to`)?.value || '',
      limit: Number(document.getElementById(`${prefix}-filter-limit`)?.value || 50)
    };
    _rememberSavedFilters(prefix, f);
    return f;
  };
  window._savedRunsRenderPicker = function(prefix, runs, onLoadFn, labelField='run_name') {
    const opts = (runs || []).map(r => {
      const id = r.id || r.run_id || '';
      const when = r.updated_at || r.created_at || '';
      const summary = r.summary || {};
      const extra = summary.symbol || summary.watchlist || r.symbol || r.watchlist_id || '';
      return `<option value="${_esc(id)}">${_esc(r.run_name || r[labelField] || r.run_id || 'Unnamed run')} — ${_esc(when)}${extra ? ' — ' + _esc(extra) : ''}</option>`;
    }).join('');
    return `<div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin:8px 0 10px 0">
      <div style="min-width:320px;flex:1 1 520px"><label style="font-size:10px;color:var(--muted);font-weight:800">Saved run</label><select id="${prefix}-run-select" style="width:100%"><option value="">${(runs||[]).length ? 'Select a saved run to load…' : 'No saved runs found'}</option>${opts}</select></div>
      <button class="btn btn-primary" style="padding:6px 12px" onclick="${onLoadFn}(document.getElementById('${prefix}-run-select')?.value)">Load selected</button>
    </div>`;
  };
  function _savedRunTable(runs, type){
    if (!runs || !runs.length) return '';
    if (type === 'weekly') {
      return '<div style="overflow:auto;max-height:260px"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr><th style="text-align:left;padding:6px">Name</th><th style="text-align:left;padding:6px">Saved</th><th style="text-align:left;padding:6px">Symbol</th><th style="text-align:left;padding:6px">Expiry</th><th style="text-align:left;padding:6px">Bias</th></tr></thead><tbody>' +
        runs.map(r => `<tr><td style="padding:6px;font-weight:700">${_esc(r.run_name || '')}</td><td style="padding:6px">${_esc(r.updated_at || r.created_at || '')}</td><td style="padding:6px">${_esc((r.summary && r.summary.symbol) || r.symbol || 'SPY')}</td><td style="padding:6px">${_esc((r.summary && r.summary.expiry) || '')}</td><td style="padding:6px">${_esc((r.summary && r.summary.bias) || '')}</td></tr>`).join('') + '</tbody></table></div>';
    }
    return '<div style="overflow:auto;max-height:260px"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr><th style="text-align:left;padding:6px">Name</th><th style="text-align:left;padding:6px">Saved</th><th style="text-align:left;padding:6px">Watchlist</th><th style="text-align:left;padding:6px">Count</th></tr></thead><tbody>' +
      runs.map(r => `<tr><td style="padding:6px;font-weight:700">${_esc(r.run_name || '')}</td><td style="padding:6px">${_esc(r.updated_at || r.created_at || '')}</td><td style="padding:6px">${_esc((r.summary && r.summary.watchlist) || r.watchlist_id || 'Default')}</td><td style="padding:6px">${_esc((r.summary && r.summary.count) || r.result_count || 0)}</td></tr>`).join('') + '</tbody></table></div>';
  }

  window._oibParamsChanged = function(){
    const st = document.getElementById('oib-status');
    if (st) st.innerHTML = '<span style="color:var(--muted)">Settings changed. Click Scan to run.</span>';
  };
  window._weeklyPlanInputsChanged = function(){
    const st = document.getElementById('wk-status');
    if (st) st.innerHTML = '<span style="color:var(--muted)">Inputs changed. Click Generate Weekly Plan to run.</span>';
  };

  window._oibLoadWatchlists = async function(){
    const sel = document.getElementById('oib-watchlist');
    if (!sel) return;
    try {
      if (typeof _oibLoadSettings === 'function') await _oibLoadSettings();
      const d = await api('/watchlists/?_=' + Date.now());
      const wls = Array.isArray(d.watchlists) ? d.watchlists : [];
      const stored = (() => { try { return localStorage.getItem('oib_watchlist_id') || ''; } catch(e) { return ''; } })();
      sel.innerHTML = '<option value="">Default watchlist</option>' + wls.map(w => `<option value="${_esc(w.id)}">${w.is_default ? '⭐ ' : ''}${_esc(w.name)} (${_esc(w.symbol_count || 0)})</option>`).join('');
      if (stored && Array.from(sel.options).some(o => String(o.value) === String(stored))) sel.value = String(stored);
      else {
        const def = wls.find(w => w.is_default);
        if (def && Array.from(sel.options).some(o => String(o.value) === String(def.id))) sel.value = String(def.id);
      }
      if (typeof _oibWatchlistChange === 'function') _oibWatchlistChange();
    } catch(e) {
      sel.innerHTML = `<option value="">Could not load watchlists: ${_esc(e.message)}</option>`;
      const st = document.getElementById('oib-status');
      if (st) st.innerHTML = `<span style="color:#ef4444">Watchlists failed to load: ${_esc(e.message)}</span>`;
    }
  };

  window._loadOibScreener = async function(){
    if (typeof window._oibSwitchPane === 'function') window._oibSwitchPane('current');
    _hideBox('oib-saved-runs-box');
    _hideBox('wk-saved-runs-box');
    const stEl = document.getElementById('oib-status');
    const tblEl = document.getElementById('oib-table');
    const wlId = document.getElementById('oib-watchlist')?.value || '';
    if (stEl) stEl.innerHTML = `⏳ Scanning${wlId ? ' selected watchlist' : ' all symbols'}…`;
    if (tblEl) tblEl.innerHTML = '<div style="padding:20px;color:var(--muted)">⏳ Running fresh OI buildup scan…</div>';
    try {
      const d = await api('/api/oi_buildup_screener?st='
        + (document.getElementById('oib-st-days')?.value||3)
        + '&mt=' + (document.getElementById('oib-mt-days')?.value||10)
        + '&lt=' + (document.getElementById('oib-lt-days')?.value||30)
        + (wlId ? '&watchlist_id=' + encodeURIComponent(wlId) : ''));
      window._oibData = _oibData = d.results || [];
      if (window._oibTimer) clearInterval(window._oibTimer);
      if (d.error_count > 0 && typeof addNotif === 'function') addNotif('warn', 'OI Buildup: '+d.error_count+' symbols failed', (d.errors||[]).map(function(e){return e.sym+': '+e.error}).join('\n'), 'OI Buildup');
      if (d.error && typeof addNotif === 'function') addNotif('error', 'OI Buildup failed', (d.error||'')+(d.trace?'\n'+d.trace:''), 'OI Buildup');
      window._oibLastScan = _oibLastScan = Date.now();
      try {
        const secs = await api('/api/scanner/sectors').catch(()=>({}));
        _oibData.forEach(r => { if (!r.sector) r.sector = secs[r.symbol] || ''; });
      } catch(e) {}
      try { localStorage.setItem('oib_cache', JSON.stringify({data:_oibData, ts:_oibLastScan, date:d.date})); } catch(e) {}
      const defaultName = `OIBuildUp_${new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'')}`;
      if (stEl) stEl.innerHTML = `✅ ${_oibData.length} symbols · ${_esc(d.date || '')} · fresh scan` +
        `<div id="oib-fresh-save-panel" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px;padding:8px 10px;border:1px solid rgba(99,102,241,.25);border-radius:10px;background:rgba(99,102,241,.08)"><b>Save fresh scan</b><input id="oib-save-name" type="text" value="${defaultName}" style="min-width:260px;flex:1 1 320px" /><button class="btn btn-primary" style="padding:6px 10px" onclick="_oibSaveCurrentRun(document.getElementById('oib-save-name')?.value)">Save run</button><span style="font-size:11px;color:var(--muted)">Stored in saved_scanner_runs as scanner_key=oi_buildup.</span></div>`;
      if (typeof _updateMetaBar === 'function') _updateMetaBar();
      if (typeof _oibRender === 'function') _oibRender();
    } catch(e) {
      if (stEl) stEl.innerHTML = `❌ ${_esc(e.message)}`;
      if (tblEl) tblEl.innerHTML = `<div style="padding:20px;color:#ef4444">${_esc(e.message)}</div>`;
    }
  };

  window._oibSaveCurrentRun = async function(runName){
    try {
      const cur = window._oibData || _oibData || [];
      if (!cur.length) { if (typeof addNotif === 'function') addNotif('error', 'OI Buildup save failed', 'Run a fresh scan first.', 'OI Buildup'); return; }
      const defaultName = `OIBuildUp_${new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'')}`;
      const name = String(runName || document.getElementById('oib-save-name')?.value || defaultName).trim() || defaultName;
      const wl = document.getElementById('oib-watchlist');
      const payload = { results: cur, date: window._oibLastScan || _oibLastScan || null, st_days: parseInt(document.getElementById('oib-st-days')?.value || 3, 10), mt_days: parseInt(document.getElementById('oib-mt-days')?.value || 10, 10), lt_days: parseInt(document.getElementById('oib-lt-days')?.value || 30, 10), watchlist_id: wl?.value || '', watchlist_name: wl?.selectedOptions?.[0]?.text || 'Default watchlist' };
      const summary = { count: Array.isArray(cur) ? cur.length : 0, date: payload.date, st_days: payload.st_days, mt_days: payload.mt_days, lt_days: payload.lt_days, watchlist: payload.watchlist_name };
      const saved = await _savedRunSave('oi_buildup', name, payload, summary, { watchlist_id: payload.watchlist_id || null });
      if (!saved) throw new Error('Save did not return a saved run id. Check DB write mode.');
      const stEl = document.getElementById('oib-status');
      if (stEl) stEl.innerHTML = `💾 Saved OI buildup run <b>${_esc(name)}</b> · ${_esc(payload.watchlist_name || 'Default watchlist')}`;
      const p = document.getElementById('oib-fresh-save-panel'); if (p) p.style.display = 'none';
      if (typeof addNotif === 'function') addNotif('ok', 'OI buildup saved', `${name} · ${payload.watchlist_name || 'Default watchlist'}`, 'OI Buildup');
    } catch(e) {
      const stEl = document.getElementById('oib-status'); if (stEl) stEl.innerHTML = `❌ Save failed: ${_esc(e.message)}${String(e.message||'').toLowerCase().includes('locked') ? ' · The save API retried the DB lock; try again after the scan/fetch finishes.' : ''}`;
      if (typeof addNotif === 'function') addNotif('error', 'OI Buildup save failed', e.message, 'OI Buildup');
    }
  };

  window._oibViewSavedRuns = async function(){
    if (typeof window._oibSwitchPane === 'function') window._oibSwitchPane('saved');
    const box = _boxInside('oib-saved-pane', 'oib-saved-runs-box', 'No saved OI buildup runs yet.');
    _hideBox('wk-saved-runs-box');
    const old = _loadSavedFilters('oib');
    box.innerHTML = _savedRunControls('oib-saved-runs-box', 'oib', '_oibViewSavedRuns', old) + '<div style="font-size:12px;color:var(--muted)">Loading saved OI buildup runs…</div>';
    try {
      const f = window._savedRunsLoadFromControls('oib');
      const runs = await _savedRunListFiltered('oi_buildup', { name:f.name, dateFrom:f.dateFrom, dateTo:f.dateTo, limit:f.limit });
      if (!runs.length) {
        box.innerHTML = _savedRunControls('oib-saved-runs-box', 'oib', '_oibViewSavedRuns', f) + '<div style="color:var(--muted);font-size:12px">No saved OI buildup runs matched the filters. Clear or move the From date earlier.</div>';
        return;
      }
      box.innerHTML = _savedRunControls('oib-saved-runs-box', 'oib', '_oibViewSavedRuns', f) + window._savedRunsRenderPicker('oib', runs, '_oibLoadSavedRun') + _savedRunTable(runs, 'oib');
    } catch(e) { box.innerHTML = `<div style="color:#ef4444;font-size:12px">${_esc(e.message)}</div>`; }
  };

  window._oibLoadSavedRun = async function(runId){
    if (!runId) { if (typeof addNotif === 'function') addNotif('warn', 'Select a saved OI buildup run first', '', 'OI Buildup'); return; }
    try {
      const run = await _savedRunLoad(runId);
      const payload = run.payload || {};
      window._oibData = _oibData = payload.results || payload.items || [];
      window._oibLastScan = _oibLastScan = payload.date || run.updated_at || run.created_at || null;
      if (document.getElementById('oib-st-days') && payload.st_days) document.getElementById('oib-st-days').value = payload.st_days;
      if (document.getElementById('oib-mt-days') && payload.mt_days) document.getElementById('oib-mt-days').value = payload.mt_days;
      if (document.getElementById('oib-lt-days') && payload.lt_days) document.getElementById('oib-lt-days').value = payload.lt_days;
      if (document.getElementById('oib-watchlist') && payload.watchlist_id) { document.getElementById('oib-watchlist').value = String(payload.watchlist_id); if (typeof _oibWatchlistChange === 'function') _oibWatchlistChange(); }
      if (typeof _oibRender === 'function') _oibRender();
      if (typeof window._oibSwitchPane === 'function') window._oibSwitchPane('current');
      _hideBox('oib-saved-runs-box');
      const stEl = document.getElementById('oib-status');
      if (stEl) stEl.innerHTML = `📥 Loaded saved OI buildup run <b>${_esc(run.run_name || runId)}</b>`;
      if (typeof addNotif === 'function') addNotif('ok', 'OI buildup run loaded', run.run_name || String(runId), 'OI Buildup');
    } catch(e) { if (typeof addNotif === 'function') addNotif('error', 'OI buildup load failed', e.message, 'OI Buildup'); }
  };

  const _baseWeeklyPlan = (typeof _origLoadWeeklyPlan === 'function') ? _origLoadWeeklyPlan : (typeof loadWeeklyPlan === 'function' ? loadWeeklyPlan : null);
  window.loadWeeklyPlan = loadWeeklyPlan = async function(){
    if (typeof window._weeklySwitchPane === 'function') window._weeklySwitchPane('current');
    _hideBox('wk-saved-runs-box');
    const sym = document.getElementById('wk-symbol')?.value || 'SPY';
    const exp = document.getElementById('wk-expiry')?.value || '';
    if (typeof _loadContextPanel === 'function') _loadContextPanel(sym, 'wk-context-panel', exp);
    const out = _baseWeeklyPlan ? await _baseWeeklyPlan.apply(this, arguments) : null;
    const resolvedExp = document.getElementById('wk-expiry')?.value || exp;
    if (resolvedExp && typeof _loadContextPanel === 'function') _loadContextPanel(sym, 'wk-context-panel', resolvedExp);
    return out;
  };

  window._weeklyPlanSaveCurrentRun = async function(runName){
    try {
      const cur = window._weeklyPlanLast || null;
      if (!cur) { if (typeof addNotif === 'function') addNotif('error', 'Weekly Plan save failed', 'Generate a plan first.', 'Weekly Plan'); return; }
      const defaultName = `WeeklyPlan_${new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'')}`;
      const name = String(runName || document.getElementById('wk-save-name')?.value || defaultName).trim() || defaultName;
      const summary = { symbol: cur.symbol, expiry: cur.expiry, dte: cur.dte, spot: cur.spot, bias: (cur.weekly_overlays || {}).weekly_bias || cur.bias, confidence: (cur.weekly_overlays || {}).weekly_confidence || cur.confidence, composite_score: (cur.weekly_plan_score || {}).composite_score };
      const saved = await _savedRunSave('weekly_plan', name, cur, summary, { symbol: cur.symbol || 'SPY' });
      if (!saved) throw new Error('Save did not return a saved run id. Check DB write mode.');
      const st = document.getElementById('wk-status');
      if (st) st.innerHTML = `💾 Saved Weekly Plan <b>${_esc(name)}</b> · ${_esc(cur.symbol || 'SPY')} ${_esc(cur.expiry || '')}`;
      const p = document.getElementById('wk-save-name')?.closest('div'); if (p) p.style.display = 'none';
      if (typeof addNotif === 'function') addNotif('ok', 'Weekly Plan saved', `${name} · ${cur.symbol || 'SPY'} ${cur.expiry || ''}`, 'Weekly Plan');
    } catch(e) {
      const st = document.getElementById('wk-status'); if (st) st.innerHTML = `❌ Save failed: ${_esc(e.message)}`;
      if (typeof addNotif === 'function') addNotif('error', 'Weekly Plan save failed', e.message, 'Weekly Plan');
    }
  };

  window._weeklyPlanViewSavedRuns = async function(){
    if (typeof window._weeklySwitchPane === 'function') window._weeklySwitchPane('saved');
    const box = _boxInside('wk-saved-pane', 'wk-saved-runs-box', 'No saved Weekly Plan runs yet.');
    _hideBox('oib-saved-runs-box');
    const old = _loadSavedFilters('wk');
    box.innerHTML = _savedRunControls('wk-saved-runs-box', 'wk', '_weeklyPlanViewSavedRuns', old) + '<div style="font-size:12px;color:var(--muted)">Loading saved Weekly Plan runs…</div>';
    try {
      const f = window._savedRunsLoadFromControls('wk');
      const runs = await _savedRunListFiltered('weekly_plan', { name:f.name, dateFrom:f.dateFrom, dateTo:f.dateTo, limit:f.limit });
      if (!runs.length) {
        box.innerHTML = _savedRunControls('wk-saved-runs-box', 'wk', '_weeklyPlanViewSavedRuns', f) + '<div style="color:var(--muted);font-size:12px">No saved Weekly Plan runs matched the filters. Clear or move the From date earlier.</div>';
        return;
      }
      box.innerHTML = _savedRunControls('wk-saved-runs-box', 'wk', '_weeklyPlanViewSavedRuns', f) + window._savedRunsRenderPicker('wk', runs, '_weeklyPlanLoadSavedRun') + _savedRunTable(runs, 'weekly');
    } catch(e) { box.innerHTML = `<div style="color:#ef4444;font-size:12px">${_esc(e.message)}</div>`; }
  };

  window._weeklyPlanLoadSavedRun = async function(runId){
    if (!runId) { if (typeof addNotif === 'function') addNotif('warn', 'Select a saved Weekly Plan first', '', 'Weekly Plan'); return; }
    try {
      const run = await _savedRunLoad(runId);
      const payload = run.payload || {};
      window._weeklyPlanLast = payload;
      if (document.getElementById('wk-symbol') && payload.symbol) document.getElementById('wk-symbol').value = payload.symbol;
      if (document.getElementById('wk-expiry') && payload.expiry) document.getElementById('wk-expiry').value = payload.expiry;
      const res = document.getElementById('wk-result');
      if (res && typeof _renderWeeklyPlan === 'function') res.innerHTML = _renderWeeklyPlan(payload);
      if (typeof window._weeklySwitchPane === 'function') window._weeklySwitchPane('current');
      _hideBox('wk-saved-runs-box');
      const st = document.getElementById('wk-status');
      if (st) st.innerHTML = `📥 Loaded saved Weekly Plan <b>${_esc(run.run_name || runId)}</b>`;
      if (typeof addNotif === 'function') addNotif('ok', 'Weekly Plan loaded', run.run_name || String(runId), 'Weekly Plan');
    } catch(e) { if (typeof addNotif === 'function') addNotif('error', 'Weekly Plan load failed', e.message, 'Weekly Plan'); }
  };

  document.addEventListener('DOMContentLoaded', function(){
    setTimeout(function(){ if (typeof window._oibSwitchPane === 'function') window._oibSwitchPane('current'); if (typeof window._weeklySwitchPane === 'function') window._weeklySwitchPane('current'); if (document.getElementById('oib-watchlist')) window._oibLoadWatchlists(); }, 150);
  });
})();

